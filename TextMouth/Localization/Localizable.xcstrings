    "Back" : {
      "comment" : "Title of the button that returns to the address field in the Add Feed sheet."
    },
    "Back 10 Seconds" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Moves back ten seconds."
    },
    "Back Cover" : {
      "comment" : "Title of the chapter of a comic book archive's page that its ComicInfo.xml calls the back cover, made at import. Title case."
    },
    "Back One Second" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Moves back one second."
    },
    "Back a Tenth of a Second" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Moves back a tenth of a second."
    },
    "Back to Book" : {
      "comment" : "Button of the headings sheet that closes it and returns to the book.\nTitle of the button that closes the Search in Book sheet and returns to the book."
    },
    "Backslash" : {
      "comment" : "Name of the punctuation key \"\\\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Backslash\"."
    },
    "Backward navigation unit" : {
      "comment" : "Label of the menu that sets the unit by which this book moves backward."
    },
    "Backward navigation unit: %@" : {
      "comment" : "VoiceOver label of the playback bar's menu that picks the unit the backward button moves by. %@ is the unit now chosen, such as \"Sentence\"."
    },
    "Before heading 1 of %lld" : {
      "comment" : "Where the reader is when it precedes the first heading of a book. %lld is the number of headings in the book."
    },
    "Before page %@" : {
      "comment" : "Where the reader is before the first page of a book that has pages. %@ is the first page's label, an identifier."
    },
    "Before: %@ After: %@" : {
      "comment" : "An example of one change in the Clean Up Transcript sheet. %1$@ is the transcript's text before the change; %2$@ is the text after it.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before: %1$@ After: %2$@"
          }
        }
      }
    },
    "Begin" : {
      "comment" : "Name of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Begin\"."
    },
    "Beginning" : {
      "comment" : "Part of a spoken audio export's file name: the beginning of the book as one end of the range, as in \"Middlemarch - Beginning to Chapter 2\"."
    },
    "Beginning of the book" : {
      "comment" : "The first item of the From pop-up in the Export dialog's spoken audio options: the start of the book, with any text before its first heading."
    },
    "Blocks the spurious play command macOS sends when Bluetooth headphones are removed." : {
      "comment" : "Explanation under the Enable Bluetooth monitoring switch in the Miscellaneous settings. macOS is the name of the operating system."
    },
    "Bluetooth" : {
      "comment" : "Heading of the Bluetooth group in the Miscellaneous settings. Bluetooth is a trademark and stays as written in most languages."
    },
    "Bluetooth disconnect delay" : {
      "comment" : "VoiceOver label of the Bluetooth disconnect delay slider in the Miscellaneous settings."
    },
    "Book" : {
      "comment" : "The object of a removal confirmation's title for one book, in title case, as in \"Move Book to Trash?\".\nThe word that begins the title of a reader window for a book, before its title and author: \"Book: <title> by <author>\".\nTitle of the Book menu in the menu bar, which holds the commands about the open book, such as exporting or editing it. Only a reader window shows it."
    },
    "Book %lld of %lld: “%@”, %@" : {
      "comment" : "Line of the import overlay for one book of a ZIP batch. %1$lld is the book's place in the batch, %2$lld the number of books, %3$@ the book's file name, and %4$@ what is being done to it, such as \"reading its text\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Book %1$lld of %2$lld: “%3$@”, %4$@"
          }
        }
      }
    },
    "Book Imported" : {
      "comment" : "Title of the library's alert as an import that added its book ends with something to tell, such as chapters left out. The book is in the library, so it is no error. Title case."
    },
    "Book Info" : {
      "comment" : "Menu item of a book's row that opens the sheet with the book's information.\nName of a keyboard shortcut action, listed in Settings in the Library group and read by VoiceOver. Opens the selected book's information, such as title and author. Also the title of the menu command of the same name.\nTitle of the reader toolbar's button that opens the book's information sheet."
    },
    "Book Information" : {
      "comment" : "Heading of a book's information sheet, as every Book Information sheet has it. Title case.\nHeading of the sheet in which the user edits a book's information (title, author and so on).\nHeading of the sheet that shows and edits a book's title and author, and lists its other details."
    },
    "Book Reader" : {
      "comment" : "Title of a window in which a book is read, before the window shows its own book's title. Also the name of the window group."
    },
    "Book author" : {
      "comment" : "What VoiceOver says for the book information sheet's field for the book's author."
    },
    "Book content" : {
      "comment" : "What VoiceOver calls the scrolling area that holds the book's text in the reader."
    },
    "Book only in %@: %@." : {
      "comment" : "A difference found by Compare Libraries. %1$@ is a copy of the library (this copy or the other copy), %2$@ is a book's title and, when known, its author.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Book only in %1$@: %2$@."
          }
        }
      }
    },
    "Book title" : {
      "comment" : "What VoiceOver says for the book information sheet's field for the book's title."
    },
    "Bookmark" : {
      "comment" : "A unit a skip or navigation picker moves by: one bookmark."
    },
    "Bookmark %@" : {
      "comment" : "A bookmark's name, by its number: the first line of its row in the Bookmarks list, and what VoiceOver says after a move to it. %@ is the bookmark's number, an identifier written without digit grouping.\nThe name of a bookmark that has no name of its own, written into an exported list of labels. %@ is the bookmark's number, an identifier written without digit grouping.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Marcador %@"
          }
        }
      }
    },
    "Bookmark %@ added" : {
      "comment" : "VoiceOver announcement after a bookmark was added at the reading position. %@ is the new bookmark's number, an identifier written without digit grouping.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Marcador %@ agregado"
          }
        }
      }
    },
    "Bookmark %@ in %@: differs." : {
      "comment" : "First sentence of a bookmark difference found by Compare Libraries. %1$@ is the bookmark's number, an identifier written without digit grouping, and %2$@ is a book's title.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bookmark %1$@ in %2$@: differs."
          }
        }
      }
    },
    "Bookmark %@ in %@: only in %@, %@." : {
      "comment" : "A difference found by Compare Libraries. %1$@ is the bookmark's number, an identifier written without digit grouping; %2$@ is a book's title; %3$@ is the copy of the library that has it; %4$@ is the bookmark's place and note, such as \"chapter 3, with no note\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bookmark %1$@ in %2$@: only in %3$@, %4$@."
          }
        }
      }
    },
    "Bookmark %@ removed" : {
      "comment" : "VoiceOver announcement after the bookmark command removed the bookmark at the reading position. %@ is that bookmark's number, an identifier written without digit grouping.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Marcador %@ eliminado"
          }
        }
      }
    },
    "Bookmark %@, %@, Note: %@, added %@" : {
      "comment" : "VoiceOver label of a bookmark's row in the Bookmarks list and its rotor. %1$@ is the bookmark's number, an identifier written without digit grouping; %2$@ the heading it is under; %3$@ its note, written by the listener; %4$@ the day it was added, such as October 9, 2026.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bookmark %1$@, %2$@, Note: %3$@, added %4$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Marcador %1$@, %2$@, Nota: %3$@, agregado el %4$@"
          }
        }
      }
    },
    "Bookmark %@, %@, added %@" : {
      "comment" : "VoiceOver label of a bookmark's row in the Bookmarks list and its rotor, for a bookmark with no note. %1$@ is the bookmark's number, an identifier written without digit grouping; %2$@ the heading it is under; %3$@ the day it was added, such as October 9, 2026.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bookmark %1$@, %2$@, added %3$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Marcador %1$@, %2$@, agregado el %3$@"
          }
        }
      }
    },
    "Bookmark %@, Note: %@, added %@" : {
      "comment" : "VoiceOver label of a bookmark's row in the Bookmarks list and its rotor, for a bookmark under no heading. %1$@ is the bookmark's number, an identifier written without digit grouping; %2$@ its note, written by the listener; %3$@ the day it was added, such as October 9, 2026.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bookmark %1$@, Note: %2$@, added %3$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Marcador %1$@, Nota: %2$@, agregado el %3$@"
          }
        }
      }
    },
    "Bookmark %@, added %@" : {
      "comment" : "VoiceOver label of a bookmark's row in the Bookmarks list and its rotor, for a bookmark with no note under no heading. %1$@ is the bookmark's number, an identifier written without digit grouping; %2$@ the day it was added, such as October 9, 2026.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bookmark %1$@, added %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Marcador %1$@, agregado el %2$@"
          }
        }
      }
    },
    "Bookmark note" : {
      "comment" : "VoiceOver label of the note field when adding a bookmark or editing its note.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nota del marcador"
          }
        }
      }
    },
    "Bookmarks" : {
      "comment" : "Heading of the group of bookmark keyboard shortcuts in Settings, and the title of the Bookmarks menu.\nThe name of the Bookmarks checkbox in the Export dialog: a list of the book's bookmarks.\nThe name of the bookmarks, wherever it is named: the title of the Bookmarks list over a book's reader (read by VoiceOver as its heading, and the name of its rotor), the reader's Bookmarks toolbar button, and the Bookmarks menu in the menu bar.\nTitle of the Bookmarks menu in the menu bar, which holds the commands that add and move between a book's bookmarks. Only a reader window shows it.\nTitle of the reader toolbar's button that opens the bookmarks sheet.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Marcadores"
          }
        }
      }
    },
    "Books" : {
      "comment" : "Name of the VoiceOver rotor in the Search Library window that moves between the books that hold matches.\nName of the VoiceOver rotor that moves between the books of the Library list.\nText of the Folder Settings sheet, which shows one library folder's facts and its listening options. The label of the books in the folder and every folder below it.\nText of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. A kind of row as its checkbox names it: \"Books\", \"Episodes\", \"Articles\", or \"Feeds\". This is the case .books."
    },
    "Books (%lld)" : {
      "comment" : "The header of a list's books, with their count: \"Books (743)\". %lld is the number of books.\nThe heading of a folder's books, which counts the rows under it. %lld is how many. Title case.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Books (%lld)"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Books (%lld)"
                }
              }
            }
          }
        }
      }
    },
    "Books Imported" : {
      "comment" : "Title of the library's alert as a ZIP batch that added several books ends with something to tell about some of them, such as chapters left out. Title case."
    },
    "Books can be moved only in a folder sorted by %@, and this folder is not." : {
      "comment" : "First sentence of the announcement when Move Book Up or Move Book Down is used in a folder that is not in manual order. %@ is the name of the Manual Order sort."
    },
    "Books can't be added while the library is moving." : {
      "comment" : "What a Library window says when a command that adds a book is chosen while the library is being moved."
    },
    "Books can't be added while the library isn't available." : {
      "comment" : "What the Library window says when a command that adds a book is chosen while the library can't be used."
    },
    "Books can't be moved in this view. Go to a folder in Folders, or to the Reading List, then try again." : {
      "comment" : "VoiceOver announcement when Move Book Up or Move Book Down is used in a view that mixes books from many folders. Folders and Reading List are names of views in the View menu."
    },
    "Books can't be opened while the library is moving." : {
      "comment" : "What a Library window says when a command that opens a book is chosen while the library is being moved."
    },
    "Books can't be opened while the library isn't available." : {
      "comment" : "What the Library window says when a command that opens a book is chosen while the library can't be used."
    },
    "Books stay on this Mac until you remove their downloads or macOS needs space." : {
      "comment" : "Second sentence of what moving the library into a cloud folder means."
    },
    "Books with the same title, regardless of author" : {
      "comment" : "Hint of the Same Title criterion of Find Duplicate Books."
    },
    "Braille" : {
      "comment" : "Name of the book format of a braille file (.brf or .brl), shown in a book's information, the format column, and the duplicate finder.\nThe heading of the Braille tab's only group in Settings.\nThe name of the Braille tab in the Settings window's toolbar."
    },
    "Braille Code" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. The label of Book Information's row that names a braille book's code, and of its pop-up, which reads the book again with another."
    },
    "Braille File Characters" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. The label of Book Information's pop-up that names the braille file characters a BRF or BRL book's file is read with, in title case, as the sheet's \"Braille Code\" and \"Text Encoding\" are; the Settings and Export pop-ups say \"Braille file characters\", in their own sentence case."
    },
    "Braille Ready Format: pages of braille, for braille displays and embossers." : {
      "comment" : "The hint of the Convert to picker in the Export dialog while BRF is chosen. Braille Ready Format is the name of the file format."
    },
    "Braille characters: %@" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. Speak Info's sentence for braille file characters described as description (Book.brailleFileCodeDescription), said right after the braille code's: \"Braille characters: North American Braille ASCII\". Placeholders in order: description."
    },
    "Braille code" : {
      "comment" : "The label of the pop-up that chooses the braille code, in the Braille tab of Settings and in the Export dialog's braille options."
    },
    "Braille code: %@" : {
      "comment" : "Speak Info: the part of a braille book's full summary that names its braille code. %@ is the code's description, such as \"Unified English Braille, contracted (Grade 2)\"."
    },
    "Braille file characters" : {
      "comment" : "The label of the pop-up that chooses which characters a BRF or BRL braille file uses for the braille cells, in the Braille tab of Settings and in the Export dialog's braille options."
    },
    "Braille page numbers" : {
      "comment" : "The label of the switch in the Export dialog's braille options that numbers the braille pages."
    },
    "Break" : {
      "comment" : "Name of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Break\"."
    },
    "But %@ also holds %lld books a newer TextMouth added: they are kept where they are, and so is every folder that holds one." : {
      "comment" : "Last sentence of the second confirmation that deletes a folder, when the folder holds books that a newer TextMouth added. %1$@ is the folder's name in quotation marks and %2$lld is how many books, a count.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "But %@ also holds %lld book a newer TextMouth added: it is kept where it is, and so is every folder that holds it."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "But %@ also holds %lld books a newer TextMouth added: they are kept where they are, and so is every folder that holds one."
                }
              }
            }
          }
        }
      }
    },
    "By %@" : {
      "comment" : "Speak Info: the part of a book's summary that names its author. %@ is the author's name."
    },
    "CR LF suits most braille displays and embossers." : {
      "comment" : "The hint of the Line ends pop-up in the Export dialog's braille options. CR LF is a technical name for a line end."
    },
    "Cancel" : {
      "comment" : "Button of a confirmation in Storage settings that changes nothing.\nButton of a jump panel (Go to Percent, Time or Page) that closes it without jumping.\nButton of the Edit Text explanation alert that stops without opening the editor. Escape presses it.\nButton of the book information sheet that closes it without saving.\nButton of the sheet that shows the library being moved: cancels the move.\nButton that closes a question and changes nothing.\nButton that closes a sheet or answers a question without doing or changing anything.\nButton that closes a sheet or dialog without doing what it offered.\nButton that closes a sheet or dialog without making its change.\nButton that closes an alert or stops waiting, in the reader.\nButton that leaves a sheet, panel, or question without making its change, such as the panel for adding a bookmark or editing its note.\nText of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). The button of either question that changes nothing.\nText of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. The button that closes the sheet, changing nothing.\nThe button in the Export dialog that closes it without exporting.\nTitle and VoiceOver label of the Cancel button of the duplicate-book question.\nTitle of a button that cancels, in the Substitutions settings' question and rule editor.\nTitle of the Cancel button of the Add to Library sheet, which closes it.\nTitle of the button that cancels the removal of the duplicate books selected, in its confirmation.\nTitle of the feed downloads section's button that stops the feed downloads.\nTitle of the question's button that keeps the Record window open; it answers the Escape key.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cancelar"
          }
        }
      }
    },
    "Cancel Download" : {
      "comment" : "Button of the Transcribe Audio sheet that stops a speech model's download.\nTitle of the command that stops a feed item's download. Title case."
    },
    "Cancel Export" : {
      "comment" : "The button of the alert an export shows when a chapter nests too deeply: it stops the whole export."
    },
    "Cancel Feed Downloads" : {
      "comment" : "What VoiceOver calls the Cancel button of the feed downloads section; the import overlay has a Cancel too, so the name says what it cancels. Title case."
    },
    "Cancel Import" : {
      "comment" : "VoiceOver label of the import overlay's Cancel button. Title case."
    },
    "Cancel Move" : {
      "comment" : "VoiceOver label of the button that cancels the move of the library."
    },
    "Cancel New Folder" : {
      "comment" : "Title of the button, in a folder chooser, that closes the new folder's fields without making a folder. It is not named Cancel, so VoiceOver tells it apart from the sheet's own Cancel."
    },
    "Cancel Timer" : {
      "comment" : "Button of the sleep timer sheet that stops the running timer.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cancelar temporizador"
          }
        }
      }
    },
    "Cancelling" : {
      "comment" : "VoiceOver value of the move's progress bar while the move is being cancelled."
    },
    "Cancelling after this book..." : {
      "comment" : "Line of the import overlay once Cancel is pressed while a book is under way: the import stops after that book. Ends with an ellipsis written as three full stops."
    },
    "Cancelling the move." : {
      "comment" : "Announcement when the listener cancels the move of the library."
    },
    "Cancelling the move…" : {
      "comment" : "Status line of the move sheet while the move is being cancelled."
    },
    "Cancelling..." : {
      "comment" : "Line of a progress display once Cancel is pressed: the work stops at its next step. Ends with an ellipsis written as three full stops."
    },
    "Captions in %@ (.%@), which nearly every player reads: one file, timed from the start of the audio." : {
      "comment" : "The hint of the Transcript's Convert to picker in the Export dialog while SubRip is chosen. %1$@ is the format's name, SubRip, and %2$@ its file extension, srt.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Captions in %1$@ (.%2$@), which nearly every player reads: one file, timed from the start of the audio."
          }
        }
      }
    },
    "Captions in %@, which web browsers and most players read: one file, timed from the start of the audio." : {
      "comment" : "The hint of the Transcript's Convert to picker in the Export dialog while WebVTT is chosen. %@ is the format's name, WebVTT."
    },
    "Caret" : {
      "comment" : "Name of the punctuation key \"^\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Caret\"."
    },
    "Case sensitive" : {
      "comment" : "A part of a substitution rule's spoken summary: capital and small letters are told apart.\nTitle of the switch in the substitution rule editor that makes the pattern tell capital and small letters apart."
    },
    "Case sensitive matching" : {
      "comment" : "VoiceOver label of the Case sensitive switch in the substitution rule editor."
    },
    "Cells per line" : {
      "comment" : "The label of the stepper in the Export dialog's braille options that sets how many braille cells each line holds."
    },
    "Chain" : {
      "comment" : "Label of the field that holds a filter preset's chain of filters, and of the line that shows it in the audio editor's Apply Filter."
    },
    "Change Location..." : {
      "comment" : "Button in Storage settings that opens a folder chooser to move the library. The three dots show that a chooser opens."
    },
    "Change Volume by %@" : {
      "comment" : "Name of an edit, as the Undo and Redo menu items say it after \"Undo\" or \"Redo\": changing the volume. %@ is the change with its sign, such as \"+3 dB\"."
    },
    "Change this book's forward and backward navigation unit" : {
      "comment" : "Help text of the playback bar's menu that sets the one unit by which this book moves forward and backward."
    },
    "Change this book's forward and backward navigation units" : {
      "comment" : "Help text of the playback bar's menu that holds separate forward and backward navigation units."
    },
    "Change voice for this book" : {
      "comment" : "What VoiceOver calls the reader toolbar's button that opens a text book's own voice settings."
    },
    "Changes by rule" : {
      "comment" : "Heading and VoiceOver label of the list of changes in the Clean Up Transcript sheet, one group for each rule."
    },
    "Changes not saved" : {
      "comment" : "Storage settings status: some changes could not be saved."
    },
    "Changes the view's name, what it lists, its conditions, its sort, and its limit." : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. Its hint."
    },
    "Changes to %lld other books could not be saved either." : {
      "comment" : "Sentence after a failure notice: more books' records failed to save too. %lld is how many more.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Changes to %lld other book could not be saved either."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Changes to %lld other books could not be saved either."
                }
              }
            }
          }
        }
      }
    },
    "Changes to %lld other feeds could not be saved either." : {
      "comment" : "Sentence after a failure notice: more feeds' records failed to save too. %lld is how many more.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Changes to %lld other feed could not be saved either."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Changes to %lld other feeds could not be saved either."
                }
              }
            }
          }
        }
      }
    },
    "Changes to books saved." : {
      "comment" : "Announcement after a retry saved the changes to books' records that had failed to save."
    },
    "Changes to the feed “%@” could not be saved: %@" : {
      "comment" : "Failure notice: a feed's changes could not be saved. %1$@ is the feed's title; %2$@ is the reason, a sentence from the system.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Changes to the feed “%1$@” could not be saved: %2$@"
          }
        }
      }
    },
    "Changes to “%@” could not be saved: %@" : {
      "comment" : "Failure notice: a book's changes could not be saved. %1$@ is the book's title; %2$@ is the reason, a sentence from the system.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Changes to “%1$@” could not be saved: %2$@"
          }
        }
