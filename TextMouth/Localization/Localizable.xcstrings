    "phoneImport.addToLibraryButtonHint" : {
      "comment" : "Hint of the iPhone Library's Add to Library button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يفتح خيارات لفتح كتاب أو استيراد مجلد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "একটি বই খোলা বা একটি ফোল্ডার আমদানির বিকল্পগুলো খোলে।"
