        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ non contiene parole, quindi il cursore è %@."
          }
        }
      }
    },
    "%@ hasn't arrived on this Mac yet. %@ may still be syncing it." : {
      "comment" : "Shown and spoken when the book's files have not arrived from the sync service. %1$@ is the book's title; %2$@ is the cloud service's name, or \"The cloud service\" when it is unknown.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ hasn't arrived on this Mac yet. %2$@ may still be syncing it."
          }
        },
        "es" : {
          "stringUnit" : {
