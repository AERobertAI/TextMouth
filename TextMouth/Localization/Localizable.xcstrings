          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth บันทึกไลบรารีก่อนลบฟีด “%@” ไม่ได้ จึงไม่มีสิ่งใดถูกลบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth “%@” beslemesini silmeden önce kitaplığı kaydedemedi, bu yüzden hiçbir şey silinmedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
