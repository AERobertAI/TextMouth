    "audioEditor.closeExplanation" : {
      "comment" : "Explains the question asked as the audio editor's window with unsaved edits closes: what Discard does.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "غير موجودة في صوت الكتاب بعد. يتراجع “تجاهل” عنها؛ وفي المرة التالية التي تحرّر فيها هذا الكتاب، تعيدها “إعادة” ما لم تُجرِ تعديلًا آخر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এখনও বইয়ের অডিওতে নেই। “বর্জন করুন” বেছে নিলে সেগুলো পূর্বাবস্থায় ফেরে; পরের বার এই বই সম্পাদনা করলে, আরেকটি সম্পাদনা না করা পর্যন্ত “পুনরায় করুন” বেছে নিলে সেগুলো ফিরে আসে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Noch nicht im Audio des Buchs. „Verwerfen“ widerruft sie; wenn du dieses Buch das nächste Mal bearbeitest, bringt „Wiederholen“ sie zurück, solange du nichts Neues bearbeitest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not in the book's audio yet. Discard undoes them; next time you edit this book, Redo brings them back until you make another edit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aún no están en el audio del libro. Descartar las deshace; la próxima vez que edites este libro, Rehacer las recupera hasta que hagas otra edición."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هنوز در صدای کتاب نیست. «دور انداختن» آن‌ها را واگرد می‌کند؛ دفعه بعد که این کتاب را ویرایش کنید، «انجام مجدد» آن‌ها را برمی‌گرداند، تا وقتی که ویرایش دیگری انجام دهید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pas encore dans l’audio du livre. Abandonner les annule ; la prochaine fois que vous modifiez ce livre, Rétablir les restaure jusqu’à ce que vous fassiez une autre modification."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "עדיין לא בשמע של הספר. “השלך” מבטל אותן; בפעם הבאה שתערוך את הספר, “בצע שוב” יחזיר אותן עד שתבצע עריכה נוספת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "अभी पुस्तक के ऑडियो में नहीं हैं। “त्यागें” उन्हें पूर्ववत करता है; अगली बार इस पुस्तक को संपादित करने पर, कोई दूसरा संपादन करने तक “फिर से करें” उन्हें वापस ले आता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Belum ada di audio buku. Pilih Buang untuk mengurungkannya; saat Anda mengedit buku ini lagi, pilih Ulangi untuk mengembalikannya sebelum Anda melakukan edit lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non sono ancora nell’audio del libro. Con Scarta vengono annullate; la prossima volta che modifichi questo libro, con Ripeti tornano finché non fai un’altra modifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "まだブックのオーディオに含まれていません。「破棄」で取り消します。次回このブックを編集するときは、別の編集をするまで「やり直す」で復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "아직 책의 오디오에 들어 있지 않습니다. 폐기하면 편집이 취소되며, 다음에 이 책을 편집할 때 다른 편집을 하기 전까지 다시 실행으로 되돌릴 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nog niet in de audio van het boek. Gooi weg maakt ze ongedaan; de volgende keer dat je dit boek wijzigt, brengt Herhaal ze terug tot je een nieuwe bewerking maakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dźwięk książki jeszcze ich nie zawiera. Odrzuć cofa je; przy następnej edycji tej książki Ponów przywróci je, dopóki nie wprowadzisz kolejnej edycji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ainda não estão no áudio do livro. Descartar desfaz essas edições; na próxima vez que você editar este livro, Refazer pode trazê-las de volta enquanto você não fizer outra edição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Этих правок ещё нет в аудио книги. «Отбросить» отменяет их; при следующем изменении этой книги «Повторить» вернёт их, пока вы не сделаете другую правку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Finns inte i bokens ljud än. Kassera ångrar dem; nästa gång du redigerar den här boken kan Gör om återställa dem tills du gör en ny redigering."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ยังไม่อยู่ในเสียงของหนังสือ คำสั่ง ทิ้ง จะเลิกทำการแก้ไขเหล่านั้น และเมื่อแก้ไขหนังสือเล่มนี้ครั้งหน้า คำสั่ง ทำซ้ำ จะนำกลับมาได้จนกว่าคุณจะแก้ไขใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Henüz kitabın sesinde değil. At düğmesi bunları geri alır; bu kitabı bir sonraki düzenlediğinizde, başka bir düzenleme yapana kadar Yinele bunları geri getirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ще немає в аудіо книги. «Відхилити» скасовує їх; наступного разу, коли ви редагуватимете цю книгу, «Повторити» поверне їх, доки ви не зробите іншу правку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یہ ابھی کتاب کے آڈیو میں نہیں ہیں۔ “ترک کریں” انہیں کالعدم کرتا ہے؛ اس کتاب میں اگلی بار ترمیم کرتے وقت، دوسری ترمیم کرنے تک “دوبارہ کریں” انہیں واپس لے آتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chưa có trong âm thanh của sách. Nút Bỏ sẽ hoàn tác chúng; lần sau khi bạn sửa sách này, Làm lại sẽ khôi phục chúng cho đến khi bạn sửa lần khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "尚未写入图书的音频。“放弃”会将其撤销；下次编辑此图书时，“重做”可将其恢复，直到你进行另一项编辑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "尚未寫入書籍的音訊。「捨棄」會還原這些編輯；下次編輯這本書時，在你進行其他編輯之前，可用「重做」恢復它們。"
          }
        }
      }
    },
    "audioEditor.closeQuestion" : {
      "comment" : "Question asked as the audio editor's window with unsaved edits closes. %@ is the book's title.",
