          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cancelar temporizador"
          }
        }
      }
    },
    "Caret" : {
      "comment" : "Name of the punctuation key \"^\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Caret\"."
    },
    "Case sensitive" : {
      "comment" : "A part of a substitution rule's spoken summary: capital and small letters are told apart.\nTitle of the switch in the substitution rule editor that makes the pattern tell capital and small letters apart."
    },
    "Case sensitive matching" : {
      "comment" : "VoiceOver label of the Case sensitive switch in the substitution rule editor."
    },
    "Change this book's forward and backward navigation unit" : {
      "comment" : "Help text of the playback bar's menu that sets the one unit by which this book moves forward and backward."
    },
    "Change this book's forward and backward navigation units" : {
      "comment" : "Help text of the playback bar's menu that holds separate forward and backward navigation units."
