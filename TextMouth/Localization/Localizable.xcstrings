    "readingList.keepBooksHint" : {
      "comment" : "VoiceOver hint of the Reading List's Keep these books on this Mac checkbox: a choice of this Mac's alone.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يُبقي كتب القائمة منزّلة على هذا الـ Mac؛ ويختار كل جهاز Mac لنفسه. لا يؤدي إلغاء التحديد إلى إزالة أي تنزيل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "তালিকার বইগুলো এই Mac-এ ডাউনলোড করা অবস্থায় রাখে; প্রতিটি Mac নিজের জন্য বেছে নেয়। চিহ্ন তুলে নিলে কোনো ডাউনলোড সরে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hält die Bücher der Liste auf diesem Mac heruntergeladen; jeder Mac entscheidet für sich. Das Deaktivieren entfernt keinen Download."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps the list's books downloaded on this Mac; each Mac chooses for itself. Clearing it removes no download."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mantiene descargados en esta Mac los libros de la lista; cada Mac elige por su cuenta. Desmarcarlo no elimina ninguna descarga."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب‌های فهرست را در این Mac بارگیری‌شده نگه می‌دارد؛ هر Mac خودش انتخاب می‌کند. برداشتن علامت، هیچ بارگیری‌ای را برنمی‌دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Garde les livres de la liste téléchargés sur ce Mac ; chaque Mac choisit pour lui-même. Décocher la case ne supprime aucun téléchargement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "משאיר את ספרי הרשימה מורדים ב-Mac הזה; כל Mac בוחר בעצמו. ביטול הסימון לא מסיר שום הורדה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सूची की पुस्तकों को इस Mac पर डाउनलोड रखता है; हर Mac अपने लिए चुनता है। इसे बंद करने पर कोई डाउनलोड नहीं हटता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menjaga buku dalam daftar tetap terunduh di Mac ini; setiap Mac memilih sendiri. Menghapus centangnya tidak membuang unduhan apa pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mantiene scaricati su questo Mac i libri dell’elenco; ogni Mac sceglie per sé. Disattivarla non rimuove alcun download."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "リストのブックをこの Mac にダウンロードしたままにします。設定は Mac ごとに別々です。オフにしても、ダウンロード済みのものは削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "목록의 책을 이 Mac에 다운로드된 상태로 유지하며, 각 Mac에서 따로 선택합니다. 선택을 해제해도 다운로드는 제거되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Houdt de boeken van de lijst gedownload op deze Mac; elke Mac kiest voor zichzelf. Als je dit uitschakelt, wordt er geen download verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zachowuje pobrane książki z listy na tym komputerze Mac; każdy komputer Mac wybiera osobno. Odznaczenie nie usuwa pobranych plików."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mantém os livros da lista baixados neste Mac; cada Mac escolhe por si. Desmarcar não remove nenhum item baixado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Хранит книги списка загруженными на этом Mac; каждый Mac выбирает сам. Снятие флажка не удаляет загруженное."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Behåller listans böcker hämtade på den här Mac-datorn; varje Mac väljer själv. Om du avmarkerar alternativet tas ingen nedladdning bort."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ให้หนังสือในรายการนี้ดาวน์โหลดไว้ใน Mac เครื่องนี้ Mac แต่ละเครื่องเลือกได้เอง การยกเลิกการเลือกจะไม่นำรายการดาวน์โหลดออก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Listedeki kitapları bu Mac'te indirilmiş tutar; her Mac kendisi için seçer. Seçimi kaldırmak hiçbir indirmeyi kaldırmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Зберігає завантаженими книги зі списку на цьому Mac; кожен Mac вирішує сам. Зняття позначки не вилучає завантажень."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فہرست کی کتابیں اس Mac پر ڈاؤن لوڈ شدہ رکھتا ہے؛ ہر Mac اپنے لیے منتخب کرتا ہے۔ نشان ہٹانے سے کوئی ڈاؤن لوڈ نہیں ہٹتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Giữ các sách của danh sách ở dạng đã tải về trên máy Mac này; mỗi máy Mac tự chọn cho mình. Bỏ chọn sẽ không gỡ bản tải về nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "让列表中的图书在这台 Mac 上保持下载状态；每台 Mac 各自选择。取消勾选不会移除已有的下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "將列表中的書籍保留下載在這部 Mac 上；每部 Mac 各自選擇。取消勾選不會移除任何下載項目。"
          }
        }
      }
    },
