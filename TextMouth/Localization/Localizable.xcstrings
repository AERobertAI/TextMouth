          }
        },
        "pt-BR" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "O arquivo compactado contém também %lld de outros livros que não foram importados; descompacte-o para importá-los."
