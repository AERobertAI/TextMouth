    },
    "TextMouth moves them back once it has finished moving books between folders." : {
      "comment" : "Why a failed move of files waits: it runs when books have been moved between folders. \"Them\" is the files.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ينقلها TextMouth مرة أخرى بعد انتهاء نقل الكتب بين المجلدات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফোল্ডারের মধ্যে বই সরানো শেষ হলে TextMouth সেগুলো আবার ফিরিয়ে আনবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth verschiebt sie zurück, sobald es das Verschieben von Büchern zwischen Ordnern beendet hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth los devuelve cuando termine de mover libros entre carpetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth les remet en place dès qu’il a fini de déplacer des livres entre des dossiers."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पुस्तकों को फ़ोल्डरों के बीच ले जाना पूरा करने के बाद TextMouth उन्हें वापस ले जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth memindahkannya kembali setelah selesai memindahkan buku antar folder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth li sposta di nuovo quando ha finito di spostare i libri tra le cartelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フォルダ間のブックの移動が終わったら、TextMouth はそれらを元に戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 폴더 간 책 이동을 마치면 그것들을 다시 옮깁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth os move de volta quando terminar de mover livros entre pastas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth вернёт их назад, когда закончит перемещать книги между папками."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth поверне їх на місце, щойно завершить переміщення книг між папками."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 会在完成文件夹之间的图书移动后将它们移回。"
          }
        }
      }
    },
    "TextMouth moves them back once it has finished rebuilding its data directory." : {
      "comment" : "Why a failed move of files waits: it runs when the data directory has been rebuilt. \"Them\" is the files.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ينقلها TextMouth مرة أخرى بعد انتهاء إعادة بناء مجلد بياناته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ডেটা ডিরেক্টরি পুনর্নির্মাণ শেষ হলে TextMouth সেগুলো আবার ফিরিয়ে আনবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth verschiebt sie zurück, sobald es den Datenordner neu aufgebaut hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth los devuelve cuando termine de reconstruir su directorio de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth les remet en place dès qu’il a fini de reconstruire son dossier de données."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "डेटा फ़ोल्डर फिर से बनाना पूरा करने के बाद TextMouth उन्हें वापस ले जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth memindahkannya kembali setelah selesai membangun ulang folder datanya."
