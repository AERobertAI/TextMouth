          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Форматований текст із заголовками на їхніх рівнях структури, для Word, Pages і Мініредактора."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "رچ ٹیکسٹ، ہر سرخی اپنی آؤٹ لائن سطح پر، Word، Pages اور TextEdit کے لیے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Văn bản đa dạng thức, với mỗi đề mục ở đúng cấp đề cương, dành cho Word, Pages và TextEdit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "富文本，每个章节标题按其大纲级别保留，适用于 Word、Pages 文稿和“文本编辑”。"
