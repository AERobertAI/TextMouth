            "value" : "In the spoken text, whose offsets the speech log gives: speech stopped at character %1$@; the refused text runs from character %2$@ to %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En el texto hablado, cuyas posiciones da el registro de voz: la voz se detuvo en el carácter %1$@; el texto rechazado va del carácter %2$@ al %3$@."
