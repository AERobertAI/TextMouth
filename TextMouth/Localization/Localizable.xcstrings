    "bookTextEdit.refused.headingChanged" : {
      "comment" : "Announcement when an edited transcript was refused because the user changed a chapter's heading. %@ is the book's title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يُحدَّث النص: النسخة النصية المحرَّرة لـ %@ تغيّر عنوان فصل، وهو يأتي من صوته. أعده واحفظ مرة أخرى؛ ويحتفظ الكتاب بنصه القديم إلى حينها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "টেক্সট হালনাগাদ হয়নি: %@-এর সম্পাদিত ট্রান্সক্রিপ্ট একটি অধ্যায়ের হেডিং বদলেছে, যা তার অডিও থেকে আসে। এটি আগের অবস্থায় ফিরিয়ে আবার সংরক্ষণ করুন; তার আগে পর্যন্ত বইটি আগের টেক্সট রাখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Text nicht aktualisiert: Das bearbeitete Transkript von %@ ändert die Überschrift eines Kapitels, die aus dem Audio stammt. Setze sie zurück und sichere erneut; bis dahin behält das Buch seinen alten Text."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text not updated: the edited transcript of %@ changes a chapter's heading, which comes from its audio. Put it back and save again; the book keeps its old text until then."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texto no actualizado: la transcripción editada de %@ cambia el encabezado de un capítulo, que viene de su audio. Vuelve a ponerlo y guarda de nuevo; hasta entonces el libro conserva su texto anterior."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "متن به‌روزرسانی نشد: رونوشت ویرایش‌شده %@ سرفصل یک فصل را تغییر می‌دهد، در حالی که سرفصل از صدای آن می‌آید. آن را برگردانید و دوباره ذخیره کنید؛ تا آن زمان کتاب متن قبلی خود را نگه می‌دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texte non mis à jour : la transcription modifiée de %@ change l’en-tête d’un chapitre, qui provient de son audio. Remettez-le comme avant et enregistrez à nouveau ; le livre garde son ancien texte d’ici là."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הטקסט לא עודכן: התמליל הערוך של %@ משנה כותרת של פרק, שנלקחת מהשמע שלו. החזר אותה ושמור שוב; הספר שומר על הטקסט הישן שלו עד אז."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "टेक्स्ट अपडेट नहीं हुआ: %@ की संपादित ट्रांसक्रिप्ट किसी अध्याय की हेडिंग बदलती है, जो उसके ऑडियो से आती है। उसे वापस रखें और फिर से सहेजें; तब तक पुस्तक का पुराना टेक्स्ट बना रहता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Teks tidak diperbarui: transkrip hasil edit %@ mengubah tajuk sebuah bab, yang berasal dari audionya. Kembalikan lalu simpan lagi; buku tetap memakai teks lamanya sampai saat itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Testo non aggiornato: la trascrizione modificata di %@ cambia l’intestazione di un capitolo, che deriva dal suo audio. Rimettila com’era e salva di nuovo; fino ad allora il libro conserva il suo vecchio testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "テキストは更新されませんでした：%@の編集済み文字起こしが、チャプタの見出しを変更しています。見出しはオーディオから作られます。元に戻してもう一度保存してください。それまで、ブックは以前のテキストのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "텍스트가 업데이트되지 않음: %@의 편집한 대본에서 챕터의 표제가 변경되었으며, 표제는 오디오에서 가져옵니다. 원래대로 되돌리고 다시 저장하십시오. 그때까지 책은 이전 텍스트를 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tekst niet bijgewerkt: de bewerkte transcriptie van %@ wijzigt de kop van een hoofdstuk, die uit de audio komt. Zet die terug en bewaar opnieuw; tot die tijd houdt het boek zijn oude tekst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie zaktualizowano tekstu: edytowana transkrypcja książki %@ zmienia nagłówek rozdziału, który pochodzi z jego dźwięku. Przywróć go i zachowaj ponownie; do tego czasu książka zachowuje stary tekst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texto não atualizado: a transcrição editada de %@ altera o cabeçalho de um capítulo, que vem do áudio. Restaure-o e salve de novo; até lá, o livro mantém o texto antigo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Текст не обновлён: в изменённой расшифровке «%@» изменён заголовок главы, который берётся из её аудио. Верните его и сохраните снова; до тех пор книга сохраняет прежний текст."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texten uppdaterades inte: den redigerade transkriptionen för %@ ändrar ett kapitels rubrik, som kommer från dess ljud. Återställ den och spara igen; boken behåller sin gamla text tills dess."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ยังไม่ได้อัปเดตข้อความ: ข้อความถอดเสียงที่แก้ไขของ %@ เปลี่ยนหัวข้อของบท ซึ่งมาจากเสียงของบทนั้น นำกลับเป็นเดิมแล้วบันทึกอีกครั้ง หนังสือจะยังใช้ข้อความเดิมไปก่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Metin güncellenmedi: %@ kitabının düzenlenen transkripti, sesinden gelen bir bölüm başlığını değiştiriyor. Geri koyup yeniden kaydedin; o zamana kadar kitap eski metnini korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Текст не оновлено: відредагована транскрипція «%@» змінює заголовок розділу, який береться з його аудіо. Поверніть його й збережіть знову; до того часу книга зберігає старий текст."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "متن اپ ڈیٹ نہیں ہوا: %@ کے ترمیم شدہ ٹرانسکرپٹ نے کسی باب کی سرخی بدل دی ہے، جو اس کے آڈیو سے آتی ہے۔ اسے واپس کر کے دوبارہ محفوظ کریں؛ تب تک کتاب اپنا پرانا متن رکھتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chưa cập nhật văn bản: bản chép lời đã sửa của %@ đổi đề mục của một chương, vốn lấy từ âm thanh của nó. Hãy đặt lại như cũ rồi lưu lại; sách giữ văn bản cũ cho đến lúc đó."
