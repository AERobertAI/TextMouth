        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile spostare nel Cestino questo libro, che resta nella libreria:"
          }
        }
      }
    },
    "This book could not be removed from the library and remains in it:" : {
      "comment" : "Heading of the error alert's list when Remove from Library Only could not mark one book's package, so it stays in the library. The book's title and the reason follow on the next line.\nHeading over the one book that could not be removed from the library. A line about it follows.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
