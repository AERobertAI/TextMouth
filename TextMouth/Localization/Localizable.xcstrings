          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не удалось проверить, нужно ли переместить его в Корзину."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не вдалося перевірити, чи переміщувати її до Кошика."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 无法检查是否要将它移到废纸篓。"
          }
        }
      }
    },
    "TextMouth could not keep the new copy of “%@”. Choose Cancel to discard the copy, then import the file again." : {
      "comment" : "What the duplicate question says when Keep Both could not take the waiting mark off the new copy. %@ is the new copy's title. \"Cancel\" is the sheet's Cancel button.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth konnte die neue Kopie von „%@“ nicht behalten. Wähle „Abbrechen“, um die Kopie zu verwerfen, und importiere die Datei dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no pudo conservar la copia nueva de “%@”. Elige Cancelar para descartar la copia y luego importa el archivo otra vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth n’a pas pu conserver la nouvelle copie de « %@ ». Choisissez Annuler pour abandonner la copie, puis importez de nouveau le fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non ha potuto conservare la nuova copia di “%@”. Scegli Annulla per scartare la copia, poi importa di nuovo il file."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não conseguiu manter a nova cópia de “%@”. Escolha Cancelar para descartar a cópia e depois importe o arquivo novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не смог сохранить новую копию «%@». Выберите «Отменить», чтобы отбросить копию, затем снова импортируйте файл."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не зміг зберегти нову копію «%@». Виберіть «Скасувати», щоб відкинути копію, а потім імпортуйте файл знову."
          }
        }
      }
    },
    "TextMouth could not make a folder to check it in" : {
      "comment" : "Why the check of a braille table of this Mac could not be made, ending a sentence.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
