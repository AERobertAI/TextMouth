    },
    "audioEditError.historyUnusable" : {
      "comment" : "Said when the book's saved edit history can't be read. A copy of the unreadable file was kept in the book's package.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّرت قراءة سجل التعديلات. تم الاحتفاظ بنسخة في حزمة الكتاب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সম্পাদনার ইতিহাস পড়া যায়নি। বইয়ের প্যাকেজে একটি কপি রাখা হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Bearbeitungsverlauf konnte nicht gelesen werden. Eine Kopie wurde im Paket des Buchs aufbewahrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The edit history couldn't be read. A copy was kept in the book's package."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo leer el historial de ediciones. Se conservó una copia en el paquete del libro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تاریخچه ویرایش خوانده نشد. یک نسخه در بسته‌ی کتاب نگه داشته شد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’historique des modifications n’a pas pu être lu. Une copie a été conservée dans le paquet du livre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא ניתן היה לקרוא את היסטוריית העריכות. עותק נשמר בחבילת הספר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "संपादन इतिहास पढ़ा नहीं जा सका। पुस्तक के पैकेज में एक प्रति रखी गई।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Riwayat edit tidak dapat dibaca. Salinan disimpan di paket buku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile leggere la cronologia delle modifiche. Una copia è stata conservata nel pacchetto del libro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "編集履歴を読み取れませんでした。コピーはブックのパッケージ内に保管されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "편집 기록을 읽을 수 없습니다. 사본이 책 패키지에 보관되어 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
