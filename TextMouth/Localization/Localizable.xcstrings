    "folderRemoval.confirmationMessage.stays" : {
      "comment" : "Sentence of the second confirmation that deletes a folder: one feed stays. %@ is the feed's title in quotation marks. \"Feed Info\" names a sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يبقى الموجز %@ مع تنزيلاته بلا مجلد إلى أن تمنحه “معلومات الموجز” مجلدًا آخر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফিড %@ তার ডাউনলোডসহ থাকে, “ফিডের তথ্য” এটিকে অন্য ফোল্ডার না দেওয়া পর্যন্ত কোনো ফোল্ডার ছাড়াই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Feed %@ bleibt mit seinen Downloads ohne Ordner, bis „Feed-Info“ ihm einen anderen gibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The feed %@ stays, with its downloads, without a folder until Feed Info gives it another."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El canal %@ permanece, con sus descargas, sin carpeta hasta que Información del canal le dé otra."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فید %@ با بارگیری‌شده‌هایش بدون پوشه می‌ماند تا «اطلاعات فید» پوشه‌ی دیگری به آن بدهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le flux %@ reste, avec ses téléchargements, sans dossier jusqu’à ce que vous lui en donniez un autre dans Informations sur le flux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הערוץ %@ נשאר, עם ההורדות שלו, ללא תיקייה עד ש“פרטי הערוץ” נותנים לו תיקייה אחרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ीड %@ अपने डाउनलोड के साथ तब तक बिना फ़ोल्डर के रहती है जब तक “फ़ीड जानकारी” उसे दूसरा फ़ोल्डर न दे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Feed %@ tetap ada, beserta unduhannya, tanpa folder sampai Info Feed memberinya folder lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il feed %@ resta, con i suoi download, senza cartella finché Info feed non gliene assegna un’altra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フィード%@は、「フィード情報」で別のフォルダを指定するまで、ダウンロードと一緒にフォルダなしで残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "피드 %@은(는) 피드 정보에서 다른 폴더를 지정할 때까지 다운로드와 함께 폴더 없이 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De feed %@ blijft met de downloads bewaard, zonder map, totdat je de feed in Feedinformatie een andere map geeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kanał %@ zostaje wraz z pobranymi plikami bez folderu, dopóki w Informacjach o kanale nie przypiszesz mu innego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O feed %@ permanece, com seus downloads, sem pasta até que Informações do feed dê outra a ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Лента %@ остаётся вместе с загрузками без папки, пока «Сведения о ленте» не назначат ей другую."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Flödet %@ finns kvar, med sina nedladdningar, utan mapp tills Flödesinformation ger det en ny."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ฟีด %@ จะยังอยู่ พร้อมรายการดาวน์โหลด โดยไม่อยู่ในโฟลเดอร์ใดจนกว่า ข้อมูลฟีด จะกำหนดโฟลเดอร์อื่นให้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ beslemesi, Besleme Bilgileri ona başka bir klasör verene kadar indirmeleriyle birlikte klasörsüz kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Стрічка %@ залишається разом із завантаженнями без папки, доки «Інформація про стрічку» не призначить їй іншу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فیڈ %@ اپنے ڈاؤن لوڈز کے ساتھ بغیر فولڈر کے رہتا ہے، جب تک “فیڈ کی معلومات” میں اسے دوسرا فولڈر نہ دیا جائے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nguồn cấp %@ vẫn còn, cùng các bản tải về của nó, không thuộc thư mục nào cho đến khi bạn gán cho nó thư mục khác trong Thông tin nguồn cấp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "订阅源 %@ 会连同其下载内容保留，且不在任何文件夹中，直到“订阅源信息”为其指定另一个文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "訂閱源 %@ 會連同其下載項目保留，且不在任何檔案夾中，直到「訂閱源資訊」為它指定另一個檔案夾。"
          }
        }
      }
    },
    "folderRemoval.confirmationMessage.subfolders" : {
      "comment" : "First sentence of the second confirmation that deletes an empty folder. %@ is the folder's name in quotation marks.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ستتم إزالة %@ وأي مجلدات فرعية من المكتبة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ এবং এর সব সাবফোল্ডার লাইব্রেরি থেকে সরানো হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ und alle Unterordner werden aus der Bibliothek entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ and any subfolders will be removed from the library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ y sus subcarpetas se quitarán de la biblioteca."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ و هر زیرپوشه‌ای که دارد از کتابخانه برداشته می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ et ses sous-dossiers seront retirés de la bibliothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ וכל תיקיות המשנה יוסרו מהספרייה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ और उसके सभी सबफ़ोल्डर लाइब्रेरी से हटा दिए जाएँगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ dan semua subfolder akan dibuang dari pustaka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ e le eventuali sottocartelle verranno rimosse dalla libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@とそのサブフォルダはライブラリから取り除かれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 및 모든 하위 폴더가 보관함에서 제거됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ en alle submappen worden uit de bibliotheek weggehaald."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Z biblioteki zostaną usunięte: %@ i wszystkie podfoldery."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A pasta %@ e as subpastas serão removidas da biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ и все вложенные папки будут убраны из библиотеки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ och eventuella undermappar tas bort från biblioteket."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ และโฟลเดอร์ย่อยทั้งหมดจะถูกนำออกจากไลบรารี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ve tüm alt klasörleri kitaplıktan kaldırılacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ і всі підпапки буде вилучено з бібліотеки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ اور اس کے تمام ذیلی فولڈر لائبریری سے ہٹا دیے جائیں گے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ và mọi thư mục con sẽ bị gỡ khỏi thư viện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 及其所有子文件夹都将从资料库中移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 與所有子檔案夾都將從書庫中移除。"
          }
        }
      }
    },
    "folderRemoval.feedsChoiceSentences.contents" : {
      "comment" : "Sentence of the dialog that asks how to delete a folder that holds several feeds' folders. \"Move Contents Out\" is the name of one of its buttons.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عند اختيار “نقل المحتويات إلى الخارج”، تنتقل مجلداتها مع البقية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“বিষয়বস্তু বাইরে স্থানান্তর করুন” দিয়ে ফিডগুলোর ফোল্ডারও বাকি সবকিছুর সঙ্গে সরে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mit „Inhalt herausverschieben“ werden ihre Ordner mit dem Rest verschoben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Move Contents Out, their folders move with the rest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con Mover el contenido fuera, sus carpetas se mueven con el resto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "با «انتقال محتوا به بیرون»، پوشه‌های آن‌ها هم با بقیه منتقل می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si vous choisissez Déplacer le contenu hors du dossier, leurs dossiers sont déplacés avec le reste."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בבחירה ב“הוצא את התוכן”, תיקיות הערוצים עוברות יחד עם השאר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“सामग्री बाहर ले जाएँ” चुनने पर, उनके फ़ोल्डर बाकी के साथ चले जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dengan Pindahkan Isi ke Luar, folder feed tersebut ikut dipindahkan bersama yang lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con “Sposta fuori il contenuto”, le loro cartelle vengono spostate insieme al resto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「中身を移動」では、それらのフォルダも一緒に移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "내용 이동을 선택하면 해당 피드의 폴더도 나머지 항목과 함께 이동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Met Verplaats inhoud eruit verhuizen hun mappen mee met de rest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Po wybraniu Przenieś zawartość na zewnątrz foldery kanałów są przenoszone razem z resztą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Com Mover conteúdo para fora, as pastas deles são movidas com o resto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«Переместить содержимое»: их папки перемещаются вместе с остальным."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Med ”Flytta ut innehållet” flyttas deras mappar med resten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เมื่อเลือก ย้ายเนื้อหาออก โฟลเดอร์ของฟีดเหล่านั้นจะย้ายไปพร้อมรายการอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“İçeriği Dışarı Taşı” ile beslemelerin klasörleri de diğerleriyle birlikte taşınır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо вибрати «Перемістити вміст», їхні папки переміщуються разом з рештою."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“مندرجات باہر منتقل کریں” منتخب کرنے پر، ان کے فولڈر باقی کے ساتھ منتقل ہو جاتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nếu chọn Di chuyển nội dung ra ngoài, các thư mục của chúng được di chuyển cùng phần còn lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "使用“移出内容”时，它们的文件夹会随其余内容一起移动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "使用「移出內容」時，它們的檔案夾會與其餘內容一併移動。"
          }
        }
      }
    },
    "folderRemoval.feedsChoiceSentences.downloads" : {
      "comment" : "Sentence of the dialog that asks how to delete a folder that holds one feed's folder. %@ is the title of the button that deletes everything, such as \"Move Everything to Trash\". \"Feed Info\" and \"Delete Feed…\" name a sheet and a command.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عند اختيار %@، يبقى الموجز وتنزيلاته غير مدرجين في أي مجلد إلى أن تمنحه “معلومات الموجز” مجلدًا آخر؛ ويحذفه “حذف الموجز…” في صفه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” দিয়ে ফিড ও তার ডাউনলোড থেকে যায়, আর “ফিডের তথ্য” ফিডটিকে অন্য একটি ফোল্ডার না দেওয়া পর্যন্ত কোনো ফোল্ডারে তালিকাভুক্ত থাকে না; এর সারিতে “ফিড মুছুন…” ফিডটি মুছে ফেলে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mit %@ bleiben der Feed und seine Downloads erhalten, in keinem Ordner aufgelistet, bis „Feed-Info“ dem Feed einen anderen gibt; „Feed löschen…“ in seiner Zeile löscht ihn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With %@, the feed and its downloads stay, listed in no folder until Feed Info gives the feed another; Delete Feed… on its row deletes it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con %@, el canal y sus descargas permanecen, sin carpeta, hasta que Información del canal le dé otra; Eliminar canal… en su fila lo elimina."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "با %@، فید و بارگیری‌شده‌هایش می‌مانند و در هیچ پوشه‌ای فهرست نمی‌شوند تا «اطلاعات فید» پوشه‌ی دیگری به فید بدهد؛ «حذف فید…» در ردیف آن، فید را حذف می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si vous choisissez %@, le flux et ses téléchargements restent, sans dossier jusqu’à ce que vous lui en donniez un autre dans Informations sur le flux ; la commande Supprimer le flux… de sa ligne le supprime."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בבחירה ב“%@”, הערוץ וההורדות שלו נשארים, ללא תיקייה, עד ש“פרטי הערוץ” נותנים לו תיקייה אחרת; “מחק ערוץ…” בשורה שלו מוחק אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” चुनने पर, फ़ीड और उसके डाउनलोड बने रहते हैं, और तब तक किसी फ़ोल्डर में सूचीबद्ध नहीं होते जब तक “फ़ीड जानकारी” उसे दूसरा फ़ोल्डर न दे; उसकी पंक्ति पर “फ़ीड मिटाएँ…” उसे मिटा देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dengan %@, feed dan unduhannya tetap ada, tidak dicantumkan di folder mana pun sampai Info Feed memberinya folder lain; Hapus Feed… pada barisnya menghapusnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con “%@”, il feed e i suoi download restano, senza cartella, finché Info feed non gli assegna un’altra cartella; Elimina feed… sulla sua riga lo elimina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」では、フィードとそのダウンロードは残り、「フィード情報」で別のフォルダを指定するまでどのフォルダにも入りません。フィードを削除するには、その行の「フィードを削除…」を実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@을(를) 선택하면 피드와 다운로드는 그대로 남으며, 피드 정보에서 다른 폴더를 지정할 때까지 어떤 폴더에도 나열되지 않습니다. 피드를 삭제하려면 해당 행의 피드 삭제…를 사용하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Met %@ blijven de feed en de downloads ervan bewaard, zonder map, totdat je de feed in Feedinformatie een andere map geeft; met Verwijder feed… op de rij van de feed verwijder je die."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Po wybraniu %@ kanał i jego pobrane pliki zostają, bez folderu, dopóki w Informacjach o kanale nie przypiszesz mu innego; polecenie Usuń kanał… w jego wierszu go usuwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Com %@, o feed e seus downloads permanecem, sem pasta, até que Informações do feed dê outra a ele; Excluir feed… na linha dele o exclui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%@»: лента и её загрузки остаются без папки, пока «Сведения о ленте» не назначат ей другую; «Удалить ленту…» в её строке удаляет её."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Med ”%@” finns flödet och dess nedladdningar kvar, utan mapp tills Flödesinformation ger flödet en ny; ”Radera flöde…” på dess rad raderar det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เมื่อเลือก %@ ฟีดและรายการดาวน์โหลดจะยังอยู่ โดยไม่อยู่ในโฟลเดอร์ใดจนกว่า ข้อมูลฟีด จะกำหนดโฟลเดอร์อื่นให้ ส่วน ลบฟีด… ในแถวของฟีดจะลบฟีดนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” ile besleme ve indirmeleri kalır; Besleme Bilgileri ona başka bir klasör verene kadar hiçbir klasörde listelenmez; satırındaki Beslemeyi Sil… onu siler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо вибрати «%@», стрічка та її завантаження залишаються й не належать до жодної папки, доки «Інформація про стрічку» не призначить їй іншу; «Видалити стрічку…» у її рядку видаляє її."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” منتخب کرنے پر فیڈ اور اس کے ڈاؤن لوڈز رہتے ہیں، اور کسی فولڈر میں درج نہیں ہوتے جب تک “فیڈ کی معلومات” میں اسے دوسرا فولڈر نہ دیا جائے؛ اس کی صف پر “فیڈ حذف کریں…” اسے حذف کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nếu chọn %@, nguồn cấp và các bản tải về của nó vẫn còn, không thuộc thư mục nào cho đến khi bạn gán cho nó thư mục khác trong Thông tin nguồn cấp; lệnh Xóa nguồn cấp… trên hàng của nó sẽ xóa nguồn cấp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "使用“%@”时，订阅源及其下载内容会保留，且不在任何文件夹中，直到“订阅源信息”为其指定另一个文件夹；其所在行上的“删除订阅源…”可将其删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "使用「%@」時，訂閱源及其下載項目會保留，且不在任何檔案夾中，直到「訂閱源資訊」為訂閱源指定另一個檔案夾；也可以在其列上使用「刪除訂閱源…」來刪除。"
          }
        }
      }
    },
    "folderRemoval.feedsChoiceSentences.each" : {
      "comment" : "Sentence of the dialog that asks how to delete a folder that holds several feeds' folders. %@ is the title of the button that deletes everything, such as \"Move Everything to Trash\". \"Feed Info\" and \"Delete Feed…\" name a sheet and a command.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عند اختيار %@، تبقى الموجزات وتنزيلاتها غير مدرجة في أي مجلد إلى أن تمنح “معلومات الموجز” كلًا منها مجلدًا آخر؛ ويحذف “حذف الموجز…” في صف أي موجز ذلك الموجز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” দিয়ে ফিডগুলো ও সেগুলোর ডাউনলোড থেকে যায়, আর “ফিডের তথ্য” প্রতিটিকে অন্য একটি ফোল্ডার না দেওয়া পর্যন্ত সেগুলো কোনো ফোল্ডারে তালিকাভুক্ত থাকে না; একটি ফিডের সারিতে “ফিড মুছুন…” সেটি মুছে ফেলে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mit %@ bleiben die Feeds und ihre Downloads erhalten, in keinem Ordner aufgelistet, bis „Feed-Info“ jedem einen anderen gibt; „Feed löschen…“ in der Zeile eines Feeds löscht ihn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With %@, the feeds and their downloads stay, listed in no folder until Feed Info gives each another; Delete Feed… on a feed's row deletes it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con %@, los canales y sus descargas permanecen, sin carpeta, hasta que Información del canal dé una a cada uno; Eliminar canal… en la fila de un canal lo elimina."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "با %@، فیدها و بارگیری‌شده‌های آن‌ها می‌مانند و در هیچ پوشه‌ای فهرست نمی‌شوند تا «اطلاعات فید» به هر کدام پوشه‌ی دیگری بدهد؛ «حذف فید…» در ردیف هر فید، آن را حذف می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si vous choisissez %@, les flux et leurs téléchargements restent, sans dossier jusqu’à ce que vous en donniez un autre à chacun dans Informations sur le flux ; la commande Supprimer le flux… de la ligne d’un flux le supprime."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בבחירה ב“%@”, הערוצים וההורדות שלהם נשארים, ללא תיקיות, עד ש“פרטי הערוץ” נותנים לכל אחד תיקייה אחרת; “מחק ערוץ…” בשורה של ערוץ מוחק אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” चुनने पर, फ़ीड और उनके डाउनलोड बने रहते हैं, और तब तक किसी फ़ोल्डर में सूचीबद्ध नहीं होते जब तक “फ़ीड जानकारी” हर एक को दूसरा फ़ोल्डर न दे; किसी फ़ीड की पंक्ति पर “फ़ीड मिटाएँ…” उसे मिटा देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dengan %@, feed dan unduhannya tetap ada, tidak dicantumkan di folder mana pun sampai Info Feed memberi masing-masing folder lain; Hapus Feed… pada baris sebuah feed menghapusnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con “%@”, i feed e i loro download restano, senza cartella, finché Info feed non assegna a ciascuno un’altra cartella; Elimina feed… sulla riga di un feed lo elimina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」では、フィードとそのダウンロードは残り、「フィード情報」で各フィードに別のフォルダを指定するまでどのフォルダにも入りません。フィードを削除するには、そのフィードの行の「フィードを削除…」を実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@을(를) 선택하면 피드와 다운로드는 그대로 남으며, 피드 정보에서 각각에 다른 폴더를 지정할 때까지 어떤 폴더에도 나열되지 않습니다. 피드를 삭제하려면 해당 피드 행의 피드 삭제…를 사용하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Met %@ blijven de feeds en hun downloads bewaard, zonder map, totdat je elke feed in Feedinformatie een andere map geeft; met Verwijder feed… op de rij van een feed verwijder je die."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Po wybraniu %@ kanały i ich pobrane pliki zostają, bez folderu, dopóki w Informacjach o kanale nie przypiszesz każdemu innego; polecenie Usuń kanał… w wierszu kanału go usuwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Com %@, os feeds e seus downloads permanecem, sem pasta, até que Informações do feed dê uma a cada um; Excluir feed… na linha de um feed o exclui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%@»: ленты и их загрузки остаются без папки, пока «Сведения о ленте» не назначат каждой другую; «Удалить ленту…» в строке ленты удаляет её."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Med ”%@” finns flödena och deras nedladdningar kvar, utan mapp tills Flödesinformation ger vart och ett en ny; ”Radera flöde…” på ett flödes rad raderar det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เมื่อเลือก %@ ฟีดและรายการดาวน์โหลดของแต่ละฟีดจะยังอยู่ โดยไม่อยู่ในโฟลเดอร์ใดจนกว่า ข้อมูลฟีด จะกำหนดโฟลเดอร์อื่นให้ ส่วน ลบฟีด… ในแถวของฟีดจะลบฟีดนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” ile beslemeler ve indirmeleri kalır; Besleme Bilgileri her birine başka bir klasör verene kadar hiçbir klasörde listelenmez; bir beslemenin satırındaki Beslemeyi Sil… onu siler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо вибрати «%@», стрічки та їхні завантаження залишаються й не належать до жодної папки, доки «Інформація про стрічку» не призначить кожній іншу; «Видалити стрічку…» у рядку стрічки видаляє її."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” منتخب کرنے پر فیڈز اور ان کے ڈاؤن لوڈز رہتے ہیں، اور کسی فولڈر میں درج نہیں ہوتے جب تک “فیڈ کی معلومات” میں ہر ایک کو دوسرا فولڈر نہ دیا جائے؛ فیڈ کی صف پر “فیڈ حذف کریں…” اسے حذف کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nếu chọn %@, các nguồn cấp và bản tải về của chúng vẫn còn, không thuộc thư mục nào cho đến khi bạn gán cho mỗi nguồn cấp một thư mục khác trong Thông tin nguồn cấp; lệnh Xóa nguồn cấp… trên hàng của một nguồn cấp sẽ xóa nguồn cấp đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "使用“%@”时，这些订阅源及其下载内容会保留，且不在任何文件夹中，直到“订阅源信息”为每个订阅源指定另一个文件夹；订阅源所在行上的“删除订阅源…”可将其删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "使用「%@」時，這些訂閱源及其下載項目會保留，且不在任何檔案夾中，直到「訂閱源資訊」為每個訂閱源指定另一個檔案夾；也可以在訂閱源的列上使用「刪除訂閱源…」來刪除。"
          }
        }
      }
    },
    "folderRemoval.feedsChoiceSentences.folders" : {
      "comment" : "Sentence of the dialog that asks how to delete a folder that holds several feeds' folders. %@ is a list of the feeds' titles in quotation marks.",
      "extractionState" : "manual",
      "localizations" : {
