    "unsavedChangesPrompt.choices" : {
      "comment" : "Last line of the alert's message, saying what each button does. %1$@ is the name of the first button, which tries saving again, %2$@ the name of the second, which quits without saving, and %3$@ the name of the third, which keeps TextMouth open. Keep each name exactly as the buttons show it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” لإعادة المحاولة، و“%2$@” للإنهاء دون حفظ، و“%3$@” لإبقاء TextMouth مفتوحًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ আবার চেষ্টা করে, %2$@ সংরক্ষণ না করেই প্রস্থান করে, %3$@ TextMouth খোলা রাখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ versucht es erneut, %2$@ beendet ohne Sichern, %3$@ lässt TextMouth geöffnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tries again, %@ quits without saving, %@ keeps TextMouth open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ vuelve a intentarlo, %2$@ sale sin guardar, %3$@ mantiene TextMouth abierto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ دوباره تلاش می‌کند، %2$@ بدون ذخیره خارج می‌شود و %3$@ TextMouth را باز نگه می‌دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ pour réessayer, %@ pour quitter sans enregistrer, %@ pour laisser TextMouth ouvert."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ - ניסיון חוזר; %2$@ - יציאה ללא שמירה; %3$@ - השארת TextMouth פתוח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” फिर से प्रयास करता है, “%2$@” बिना सहेजे छोड़ देता है, “%3$@” TextMouth को खुला रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ mencoba lagi, %2$@ keluar tanpa menyimpan, %3$@ membiarkan TextMouth tetap terbuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ riprova, %@ esce senza salvare, %@ lascia TextMouth aperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%1$@」で再試行、「%2$@」で保存せずに終了、「%3$@」で TextMouth を開いたままにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 버튼은 다시 시도하고, %2$@ 버튼은 저장하지 않고 종료하며, %3$@ 버튼은 TextMouth를 열어 둡니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ probeert het opnieuw, %@ sluit af zonder te bewaren, %@ houdt TextMouth open."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ponawia próbę zapisu, %2$@ kończy bez zapisywania, %3$@ pozostawia TextMouth otwarty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ tenta novamente, %2$@ encerra sem salvar, %3$@ mantém o TextMouth aberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ — повторить попытку, %2$@ — выйти без сохранения, %3$@ — оставить TextMouth открытым."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "”%@” försöker igen, ”%@” avslutar utan att spara, ”%@” låter TextMouth vara öppet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ จะลองบันทึกอีกครั้ง %2$@ จะออกโดยไม่บันทึก %3$@ จะให้ TextMouth เปิดอยู่ต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ tekrar dener, %2$@ kaydetmeden çıkar, %3$@ TextMouth'u açık tutar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ — повторити спробу, %2$@ — завершити без збереження, %3$@ — залишити TextMouth відкритим."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” سے دوبارہ کوشش ہوتی ہے، “%2$@” سے TextMouth محفوظ کیے بغیر بند ہو جاتا ہے، اور “%3$@” سے TextMouth کھلا رہتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chọn %1$@ để thử lại, %2$@ để thoát mà không lưu, hoặc %3$@ để giữ TextMouth mở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@”会再次尝试存储，“%2$@”会退出且不存储，“%3$@”会让 TextMouth 保持打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%1$@」會重試儲存，「%2$@」會結束且不儲存，「%3$@」會讓 TextMouth 保持打開。"
          }
        }
      }
    },
