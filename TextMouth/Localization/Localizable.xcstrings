          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "স্থানান্তর বাতিল করা হয়েছিল, তাই কিছুই বদলায়নি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
