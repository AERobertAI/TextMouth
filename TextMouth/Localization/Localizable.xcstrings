    "The recording window" : {
      "comment" : "Choice of the Works in pop-up of a keyboard shortcut: the shortcut works only in the Record window.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La ventana de grabación"
          }
        }
      }
    },
    "The recording's audio couldn't be read." : {
      "comment" : "Error in the Record window when saving: the recorded take holds no audio that can be read.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo leer el audio de la grabación."
          }
        }
      }
    },
    "The refresh of %@ was stopped." : {
      "comment" : "Why a feed's refresh ended: it was stopped. %@ is the feed's title or server.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se detuvo la actualización de %@."
          }
