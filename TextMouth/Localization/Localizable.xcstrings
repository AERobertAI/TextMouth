    "libraryIndexRecovery.settings.rebuilding" : {
      "comment" : "Last sentence of the Storage settings explanation while the library index can't be read.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "إلى ذلك الحين، يتعذّر تغيير الموقع وإعادة بناء الدليل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ততক্ষণ অবস্থান পরিবর্তন এবং ডিরেক্টরি পুনর্নির্মাণ করা যাবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bis dahin sind das Ändern des Orts und das Neuaufbauen des Datenordners nicht verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Until then, changing the location and rebuilding the directory are unavailable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hasta entonces, no se puede cambiar la ubicación ni reconstruir el directorio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تا آن زمان، تغییر مکان و بازسازی دایرکتوری در دسترس نیستند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "D’ici là, le changement d’emplacement et la reconstruction du dossier de données sont indisponibles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "עד אז, שינוי המיקום ובנייה מחדש של התיקייה אינם זמינים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "तब तक स्थान बदलना और डायरेक्टरी फिर से बनाना उपलब्ध नहीं हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sampai saat itu, mengubah lokasi dan membangun ulang direktori tidak tersedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fino ad allora, il cambio di posizione e la ricostruzione della cartella dei dati non sono disponibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "それまでは、場所の変更とディレクトリの再構築は利用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "그때까지는 위치 변경과 디렉터리 다시 만들기를 사용할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tot die tijd kun je de locatie niet wijzigen en de directory niet opnieuw opbouwen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Do tego czasu zmiana lokalizacji i odbudowa folderu danych są niedostępne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Até lá, alterar a localização e reconstruir a pasta de dados ficam indisponíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "До тех пор изменение расположения и перестройка каталога недоступны."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tills dess är det inte möjligt att ändra platsen eller bygga om katalogen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "จนกว่าจะถึงตอนนั้น การเปลี่ยนตำแหน่งที่ตั้งและการสร้างไดเรกทอรีใหม่จะใช้ไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O zamana kadar konumu değiştirme ve dizini yeniden oluşturma kullanılamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "До того часу змінити розташування й перебудувати каталог неможливо."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تب تک مقام تبدیل کرنا اور ڈائریکٹری دوبارہ بنانا دستیاب نہیں ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cho đến lúc đó, không thể đổi vị trí và xây dựng lại thư mục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在此之前，无法更改位置和重建目录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在此之前，無法更改位置與重建目錄。"
          }
        }
      }
    },
    "libraryIndexRecovery.settingsExplanation.changes" : {
      "comment" : "First sentence of the Storage settings explanation while the library index can't be read.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّرت قراءة فهرس المكتبة، لذا لا يتم حفظ تغييرات المكتبة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "লাইব্রেরি সূচক পড়া যায়নি, তাই লাইব্রেরির পরিবর্তন সংরক্ষিত হচ্ছে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Bibliotheksindex konnte nicht gelesen werden, daher werden Änderungen an der Bibliothek nicht gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The library index could not be read, so library changes are not being saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo leer el índice de la biblioteca, así que los cambios de la biblioteca no se están guardando."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نمایه‌ی کتابخانه خوانده نشد، بنابراین تغییرات کتابخانه ذخیره نمی‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’index de la bibliothèque n’a pas pu être lu ; les modifications de la bibliothèque ne sont donc pas enregistrées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא ניתן היה לקרוא את אינדקס הספרייה, ולכן שינויים בספרייה אינם נשמרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लाइब्रेरी इंडेक्स पढ़ा नहीं जा सका, इसलिए लाइब्रेरी में हुए बदलाव सहेजे नहीं जा रहे हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Indeks pustaka tidak dapat dibaca, jadi perubahan pustaka tidak disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non è stato possibile leggere l’indice della libreria, quindi le modifiche alla libreria non vengono salvate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ライブラリインデックスを読み取れなかったため、ライブラリの変更は保存されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관함 색인을 읽을 수 없어 보관함 변경 사항이 저장되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De bibliotheekindex kon niet worden gelezen, dus wijzigingen in de bibliotheek worden niet bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie można odczytać indeksu biblioteki, więc zmiany w bibliotece nie są zapisywane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O índice da biblioteca não pôde ser lido, então as alterações da biblioteca não estão sendo salvas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Индекс библиотеки не удалось прочитать, поэтому изменения библиотеки не сохраняются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Biblioteksindexet kunde inte läsas, så bibliotekets ändringar sparas inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "อ่านดัชนีไลบรารีไม่ได้ จึงไม่ได้บันทึกการเปลี่ยนแปลงของไลบรารี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitaplık dizini okunamadı; bu yüzden kitaplık değişiklikleri kaydedilmiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Індекс бібліотеки не вдалося прочитати, тому зміни бібліотеки не зберігаються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لائبریری انڈیکس پڑھا نہیں جا سکا، اس لیے لائبریری کی تبدیلیاں محفوظ نہیں ہو رہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không đọc được chỉ mục thư viện, nên các thay đổi của thư viện không được lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "无法读取资料库索引，因此目前不会存储资料库更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "無法讀取書庫索引，因此未儲存書庫的更改。"
          }
        }
      }
    },
    "libraryIndexRecovery.settingsExplanation.choose" : {
      "comment" : "Second sentence of the Storage settings explanation while the library index can't be read. %1$@ and %2$@ are the names of the Try Again and Rebuild Library Index buttons; %3$@ is the name of the Recovery Options button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اختر %@ أو %@ من %@ أعلى نافذة المكتبة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "লাইব্রেরি উইন্ডোর উপরে “%3$@” থেকে “%1$@” বা “%2$@” বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wähle %1$@ oder %2$@ über %3$@ oben im Bibliotheksfenster."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose %@ or %@ from %@ at the top of the Library window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige %1$@ o %2$@ en %3$@, en la parte superior de la ventana de la biblioteca."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ یا %2$@ را از %3$@ در بالای پنجره‌ی کتابخانه انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisissez %1$@ ou %2$@ dans %3$@, en haut de la fenêtre de la bibliothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בחר “%1$@” או “%2$@” מתוך “%3$@” בראש חלון הספרייה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लाइब्रेरी विंडो के शीर्ष पर “%3$@” से “%1$@” या “%2$@” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pilih %1$@ atau %2$@ dari %3$@ di bagian atas jendela Pustaka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scegli %@ o %@ da %@ nella parte superiore della finestra della libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ライブラリウインドウ上部の「%3$@」から、「%1$@」または「%2$@」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관함 윈도우 상단의 %3$@에서 %1$@ 또는 %2$@을(를) 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kies %1$@ of %2$@ in %3$@ boven in het bibliotheekvenster."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wybierz %1$@ lub %2$@ z menu %3$@ u góry okna biblioteki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escolha %1$@ ou %2$@ em %3$@, na parte superior da janela da biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Выберите «%1$@» или «%2$@» в разделе «%3$@» вверху окна библиотеки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Välj %1$@ eller %2$@ från %3$@ högst upp i biblioteksfönstret."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เลือก %@ หรือ %@ จาก %@ ที่ด้านบนของหน้าต่างไลบรารี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitaplık penceresinin üstündeki “%3$@” düğmesinden “%1$@” veya “%2$@” seçeneğini seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Виберіть «%1$@» або «%2$@» через «%3$@» угорі вікна бібліотеки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لائبریری ونڈو کے اوپر “%3$@” سے “%1$@” یا “%2$@” منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chọn %1$@ hoặc %2$@ từ %3$@ ở đầu cửa sổ Thư viện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "请从资料库窗口顶部的 %3$@ 中选取 %1$@ 或 %2$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "從書庫視窗頂端的 %3$@ 選擇 %1$@ 或 %2$@。"
          }
        }
      }
    },
