        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile leggere la cronologia delle modifiche. Una copia è stata conservata nel pacchetto del libro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não foi possível ler o histórico de edições. Uma cópia foi mantida no pacote do livro."
          }
        }
      }
    },
    "The edit history is only in the cloud, not on this Mac yet." : {
      "comment" : "Said when the audio editor can't open a book: its edit history is only in the cloud. A second sentence says to try again once the book has downloaded.",
      "localizations" : {
