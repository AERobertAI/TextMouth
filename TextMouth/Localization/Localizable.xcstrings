            "value" : "La cartella dei dati attuale non esiste."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A pasta de dados atual não existe."
          }
        }
      }
    },
    "The current directory will be retained as recovery data." : {
      "comment" : "Last sentence of the question asked before moving the library: the old folder is kept.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der aktuelle Ordner wird als Wiederherstellungsdaten behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El directorio actual se conservará como datos de recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le dossier actuel sera conservé comme données de récupération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La cartella attuale verrà conservata come dati di ripristino."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A pasta atual será mantida como dados de recuperação."
          }
        }
      }
    },
    "The cursor is %@." : {
      "comment" : "Announcement after Go to Page when the cursor is not on the page typed and there is no known reason. %@ says where the cursor is, such as \"on page 52\" or \"before page 1\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El cursor está %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le curseur est %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il cursore è %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O cursor está %@."
          }
        }
      }
    },
    "The data directory has no Logs folder, so logs go to %@ until it has one." : {
      "comment" : "The line under the Log location pop-up in the Storage settings while the data directory has no Logs folder. %@ is the folder's full path, which stays as written.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Datenordner hat keinen Ordner „Logs“, daher gehen die Protokolle nach %@, bis er einen hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El directorio de datos no tiene carpeta Logs, así que los registros van a %@ hasta que la tenga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le dossier de données n’a pas de dossier Journaux ; les journaux vont donc dans %@ jusqu’à ce qu’il en ait un."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La cartella dei dati non ha una cartella Registri, quindi i registri vanno in %@ finché non ne avrà una."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A pasta de dados não tem uma pasta Logs, então os registros vão para %@ até que ela exista."
          }
        }
      }
    },
    "The data directory is missing, so logs go to %@ until it is back." : {
      "comment" : "The line under the Log location pop-up in the Storage settings while the data directory is missing. %@ is the folder's full path, which stays as written.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Datenordner fehlt, daher gehen die Protokolle nach %@, bis er wieder da ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Falta el directorio de datos, así que los registros van a %@ hasta que vuelva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le dossier de données est introuvable ; les journaux vont donc dans %@ jusqu’à son retour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La cartella dei dati manca, quindi i registri vanno in %@ finché non torna disponibile."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A pasta de dados está ausente, então os registros vão para %@ até que ela volte."
          }
        }
      }
    },
    "The data directory's Logs folder can't be written (%@), so logs go to %@ until it can." : {
      "comment" : "The line under the Log location pop-up in the Storage settings while the data directory's Logs folder cannot be written. %1$@ is the reason the system gives, which may be in English, and %2$@ is the folder's full path, which stays as written.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "In den Ordner „Logs“ des Datenordners kann nicht geschrieben werden (%1$@), daher gehen die Protokolle nach %2$@, bis es wieder geht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The data directory's Logs folder can't be written (%1$@), so logs go to %2$@ until it can."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se puede escribir en la carpeta Logs del directorio de datos (%1$@), así que los registros van a %2$@ hasta que se pueda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le dossier Journaux du dossier de données n’est pas accessible en écriture (%1$@) ; les journaux vont donc dans %2$@ jusqu’à ce qu’il le soit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non è possibile scrivere nella cartella Registri della cartella dei dati (%@), quindi i registri vanno in %@ finché non sarà possibile."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não é possível gravar na pasta Logs da pasta de dados (%1$@), então os registros vão para %2$@ até que seja possível."
          }
        }
      }
    },
    "The destination folder %@ is no longer in the library." : {
      "comment" : "Error shown when a move is refused because the folder it goes into is gone from the library. %@ is that folder's location, in straight double quotes.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Zielordner %@ ist nicht mehr in der Bibliothek."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La carpeta de destino %@ ya no está en la biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le dossier de destination %@ n’est plus dans la bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La cartella di destinazione %@ non è più nella libreria."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A pasta de destino %@ não está mais na biblioteca."
          }
        }
      }
    },
    "The details could not be copied" : {
      "comment" : "Announcement when Copy Details could not copy the report of a speech refusal to the pasteboard.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Details konnten nicht kopiert werden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudieron copiar los detalles"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les détails n’ont pas pu être copiés"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile copiare i dettagli"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não foi possível copiar os detalhes"
          }
        }
      }
    },
    "The disk is almost full, so recording stopped. What was recorded is kept." : {
      "comment" : "Error in the Record window when the disk filled up while recording.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Speicherplatz ist fast voll, daher wurde die Aufnahme gestoppt. Das Aufgenommene bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El disco está casi lleno, así que la grabación se detuvo. Lo grabado se conserva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le disque est presque plein, donc l’enregistrement s’est arrêté. Ce qui a été enregistré est conservé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il disco è quasi pieno, quindi la registrazione si è interrotta. Quanto registrato è stato conservato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O disco está quase cheio, então a gravação parou. O que foi gravado foi mantido."
          }
        }
      }
    },
    "The disk is too full to keep this audio for pasting." : {
      "comment" : "Said when the disk is too full to keep the audio cut or copied in the audio editor for Paste.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Speicherplatz reicht nicht, um dieses Audio zum Einsetzen aufzubewahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El disco está demasiado lleno para conservar este audio y pegarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le disque est trop plein pour garder cet audio en vue de le coller."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il disco è troppo pieno per conservare questo audio per Incolla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O disco está cheio demais para guardar este áudio para colar."
          }
        }
      }
    },
    "The disk lacks room: this needs about %@, and TextMouth keeps %@ free. Free some space, then export again." : {
      "comment" : "Why a spoken audio export was refused: the disk is too full. %1$@ is the space the export needs and %2$@ the space TextMouth always keeps free, each a size such as 1 GB.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Datenträger hat nicht genug Platz: Dafür werden etwa %1$@ benötigt, und TextMouth hält %2$@ frei. Gib etwas Speicherplatz frei und exportiere dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The disk lacks room: this needs about %1$@, and TextMouth keeps %2$@ free. Free some space, then export again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay espacio suficiente en el disco: esto necesita unos %1$@, y TextMouth mantiene libres %2$@. Libera espacio y vuelve a exportar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le disque manque de place : il faut environ %1$@, et TextMouth garde %2$@ de libre. Libérez de l’espace, puis exportez de nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Spazio insufficiente sul disco: servono circa %1$@ e TextMouth ne mantiene %2$@ liberi. Libera dello spazio, poi esporta di nuovo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
