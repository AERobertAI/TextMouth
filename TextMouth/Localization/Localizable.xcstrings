    },
    "Question Mark" : {
      "comment" : "Name of the punctuation key \"?\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Question Mark\"."
    },
    "Quit Anyway" : {
      "comment" : "Button of the unsaved-changes alert that quits TextMouth and leaves the changes unsaved."
    },
    "Quit TextMouth" : {
      "comment" : "Name of the application menu's Quit command, in a sentence saying why a keyboard shortcut cannot take its key."
