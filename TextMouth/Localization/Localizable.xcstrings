    "speechRefusal.spokenPassageHeading" : {
      "comment" : "A line of the speech refusal report that introduces the text the speech engine was handed, after the user's substitution rules and the markup guard. %1$@ and %2$@ are the first and last character offsets in the spoken text, written without digit grouping.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "النص الذي سُلّم إلى محرك النطق، بعد البدائل وحارس الترميز، من الحرف %1$@ إلى %2$@ من النص المنطوق:"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "স্পিচ ইঞ্জিনকে দেওয়া টেক্সট, প্রতিস্থাপন ও মার্কআপ গার্ডের পরে, পড়ে শোনানো টেক্সটের %1$@ থেকে %2$@ নম্বর অক্ষর:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der der Sprachausgabe übergebene Text, nach den Ersetzungen und dem Markup-Schutz, Zeichen %1$@ bis %2$@ des gesprochenen Textes:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The text handed to the speech engine, after the substitutions and the markup guard, characters %@ to %@ of the spoken text:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto entregado al motor de voz, después de las sustituciones y de la protección de marcado, caracteres %1$@ a %2$@ del texto hablado:"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "متنی که به موتور گفتار داده شد، پس از جایگزینی‌ها و محافظ نشانه‌گذاری، نویسه‌های %1$@ تا %2$@ از متن گفته‌شده:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le texte remis au moteur vocal, après les substitutions et le garde-fou du balisage, caractères %1$@ à %2$@ du texte lu :"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הטקסט שנמסר למנוע הדיבור, אחרי ההחלפות והגנת הסימון, תווים %1$@ עד %2$@ בטקסט המוקרא:"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "स्पीच इंजन को दिया गया टेक्स्ट, प्रतिस्थापनों और मार्कअप गार्ड के बाद, बोले गए टेक्स्ट के वर्ण %1$@ से %2$@ तक:"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Teks yang diberikan ke mesin ucapan, setelah substitusi dan pelindung markup, karakter %1$@ hingga %2$@ dari teks yang diucapkan:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo passato al motore vocale, dopo le sostituzioni e la protezione del markup, caratteri da %1$@ a %2$@ del testo letto:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "置換とマークアップガードの後に読み上げエンジンへ渡されたテキスト（読み上げテキストの%1$@文字目から%2$@文字目）："
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "대체 규칙과 마크업 보호를 거친 후 음성 엔진에 전달된 텍스트, 음성으로 읽는 텍스트의 문자 %1$@에서 %2$@까지:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De tekst die aan de spraakengine is gegeven, na de vervangingen en de opmaakbeveiliging, tekens %1$@ tot %2$@ van de gesproken tekst:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tekst przekazany mechanizmowi mowy, po podstawieniach i ochronie znaczników, znaki od %1$@ do %2$@ czytanego tekstu:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O texto entregue ao mecanismo de fala, depois das substituições e da proteção de marcação, caracteres %1$@ a %2$@ do texto falado:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Текст, переданный речевому движку после замен и защиты разметки, символы с %1$@ по %2$@ озвучиваемого текста:"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texten som lämnades till talmotorn, efter ersättningarna och märkningsskyddet, tecken %1$@ till %2$@ i den upplästa texten:"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ข้อความที่ส่งให้เครื่องมืออ่านออกเสียง หลังการแทนที่และตัวป้องกันมาร์กอัป อักขระ %1$@ ถึง %2$@ ของข้อความที่อ่านออกเสียง:"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Konuşma motoruna verilen metin, değiştirmelerden ve işaretleme korumasından sonra, konuşulan metnin %1$@. ile %2$@. karakterleri:"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Текст, переданий системі озвучення, після замін і захисту розмітки, символи від %1$@ до %2$@ озвученого тексту:"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اسپیچ انجن کو دیا گیا متن، تبدیلی کے اصولوں اور مارک اپ گارڈ کے بعد، بولے گئے متن کے حرف %1$@ سے %2$@ تک:"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Văn bản được chuyển cho bộ máy đọc, sau các quy tắc thay thế và bảo vệ đánh dấu, ký tự %1$@ đến %2$@ của văn bản được đọc:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "交给朗读引擎的文本（经过替换和标记防护之后），朗读文本的第 %1$@ 到 %2$@ 个字符："
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "經取代規則和標記防護處理後交給語音引擎的文字，為朗讀文字的第 %1$@ 到 %2$@ 個字元："
          }
        }
      }
    },
    "speechRefusal.stoppedInChapter" : {
