            "value" : "%1$@ için, bir Mac'in kendi braille tablolarından biri olan “%2$@” gerekiyor; iPhone'daki TextMouth'ta bu tablo yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Для %1$@ потрібна «%2$@» — одна з власних брайлівських таблиць Mac, якої немає в TextMouth на iPhone."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ کو “%2$@” درکار ہے، جو Mac کے اپنے بریل جدولوں میں سے ایک ہے، اور iPhone پر TextMouth میں موجود نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ cần “%2$@”, một trong các bảng braille riêng của máy Mac, mà TextMouth trên iPhone không có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 需要“%2$@”（Mac 自带的盲文表之一），而 iPhone 版 TextMouth 没有这张表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
