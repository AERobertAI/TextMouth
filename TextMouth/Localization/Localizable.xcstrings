        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "兩者的書籍、位置、書籤、閱讀列表和檔案夾都相同。"
          }
        }
      }
    },
    "libraryComparison.newerCopySentence.changes" : {
      "comment" : "Sentence of Use This Library's account: each copy has changes the other lacks.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ليست أي منهما أحدث: لدى كل منهما تغييرات ليست لدى الأخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "কোনোটিই নতুন নয়: প্রতিটিতে এমন পরিবর্তন আছে, যা অন্যটিতে নেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Keine ist neuer: Jede hat Änderungen, die der anderen fehlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neither is newer: each has changes the other lacks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ninguna es más reciente: cada una tiene cambios que la otra no tiene."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هیچ‌کدام جدیدتر نیست: هر کدام تغییراتی دارد که در دیگری نیست."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucune n’est plus récente : chacune a des changements que l’autre n’a pas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אף אחד מהם אינו חדש יותר: לכל אחד יש שינויים שחסרים בשני."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कोई भी नई नहीं है: हर एक में ऐसे बदलाव हैं जो दूसरी में नहीं हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tidak ada yang lebih baru: masing-masing memiliki perubahan yang tidak dimiliki yang lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nessuna è più recente: ognuna ha modifiche che l’altra non ha."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "どちらが新しいとも言えません。それぞれに、もう一方にない変更があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "어느 쪽도 더 최신이 아닙니다. 각각 상대에 없는 변경 사항이 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Geen van beide is nieuwer: elk heeft wijzigingen die de andere mist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Żadna nie jest nowsza: każda ma zmiany, których brakuje drugiej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nenhuma é mais recente: cada uma tem alterações que a outra não tem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ни одна не новее: в каждой есть изменения, которых нет в другой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ingen av dem är nyare: var och en har ändringar som den andra saknar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไม่มีสำเนาใดใหม่กว่า: แต่ละสำเนามีการเปลี่ยนแปลงที่อีกสำเนาไม่มี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hiçbiri daha yeni değil: her birinde diğerinde olmayan değişiklikler var."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Жодна не новіша: у кожної є зміни, яких немає в іншої."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کوئی بھی کاپی زیادہ نئی نہیں: ہر ایک میں ایسی تبدیلیاں ہیں جو دوسری میں نہیں ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không bên nào mới hơn: mỗi bên có các thay đổi mà bên kia không có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "两者都不比对方新：各自都有对方没有的更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "兩者都不算較新：各自都有對方沒有的更改。"
          }
        }
      }
    },
    "libraryComparison.newerCopySentence.couldnt" : {
      "comment" : "Second sentence of Use This Library's account when the comparison could not be made and no reason is known.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يتمكن TextMouth من تحديد أي النسختين أحدث."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth বলতে পারেনি কোন কপিটি নতুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth konnte nicht feststellen, welche Kopie neuer ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth couldn't tell which copy is newer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no pudo determinar qué copia es más reciente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth نتوانست تشخیص دهد کدام نسخه جدیدتر است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth n’a pas pu déterminer quelle copie est la plus récente."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth לא הצליח לקבוע איזה עותק חדש יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth यह नहीं बता सका कि कौन-सी कॉपी नई है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tidak dapat menentukan salinan mana yang lebih baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non è riuscito a stabilire quale copia sia più recente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は、どちらのコピーが新しいかを判断できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 어느 사본이 더 최신인지 확인하지 못했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kon niet bepalen welke kopie nieuwer is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth nie mógł ustalić, która kopia jest nowsza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não conseguiu determinar qual cópia é mais recente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не удалось определить, какая копия новее."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kunde inte avgöra vilken kopia som är nyare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth บอกไม่ได้ว่าสำเนาใดใหม่กว่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth hangi kopyanın daha yeni olduğunu belirleyemedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не вдалося визначити, яка копія новіша."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth یہ نہیں بتا سکا کہ کون سی کاپی نئی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth không thể xác định bản nào mới hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 无法判断哪个副本较新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 無法判斷哪一份副本較新。"
          }
        }
      }
    },
