      }
    },
    "This book keeps no original audio: saved edits change its audio in place, and can't be undone after." : {
      "comment" : "Said as a book's original audio policy is set to keep no original.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieses Buch bewahrt kein Originalaudio auf: Gesicherte Bearbeitungen ändern sein Audio direkt und können danach nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este libro no conserva audio original: las ediciones guardadas cambian su audio directamente y no se pueden deshacer después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce livre ne conserve aucun audio original : les modifications enregistrées changent son audio sur place, et ne peuvent pas être annulées ensuite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo libro non conserva alcun audio originale: le modifiche salvate cambiano direttamente il suo audio e poi non si possono annullare."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este livro não mantém áudio original: as edições salvas alteram o áudio no próprio arquivo e não podem ser desfeitas depois."
          }
        }
      }
    },
    "This book was exported from TextMouth as text only." : {
