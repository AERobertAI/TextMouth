    "Choose no per-book control, one shared picker, or a menu with separate forward and backward pickers" : {
      "comment" : "VoiceOver hint of the Navigation unit controls pop-up in the Playback settings.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
