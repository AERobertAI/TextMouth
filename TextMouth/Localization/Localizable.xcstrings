    "Adds an Export button to each reader's toolbar. File, Export works either way." : {
      "comment" : "The hint of the Playback settings checkbox that shows the Export button in the reader's toolbar. \"File, Export\" is the menu command.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fügt der Symbolleiste jeder Leseansicht eine Taste „Exportieren“ hinzu. „Ablage“ > „Exportieren“ funktioniert in beiden Fällen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Agrega un botón Exportar a la barra de herramientas de cada lector. Archivo, Exportar funciona de las dos maneras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ajoute un bouton Exporter à la barre d’outils de chaque lecteur. La commande Fichier, Exporter fonctionne dans les deux cas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "हर रीडर के टूलबार में एक निर्यात बटन जोड़ता है। फ़ाइल, निर्यात करें दोनों तरह से काम करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menambahkan tombol Ekspor ke bilah alat setiap pembaca. File, Ekspor berfungsi dengan kedua cara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aggiunge un pulsante Esporta alla barra degli strumenti di ogni lettore. File, Esporta funziona in entrambi i casi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "各リーダのツールバーに「書き出す」ボタンを追加します。「ファイル」メニューの「書き出す」は、どちらの場合も使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "각 리더의 도구 막대에 내보내기 버튼을 추가합니다. 파일 > 내보내기는 어느 쪽이든 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Adiciona um botão Exportar à barra de ferramentas de cada leitor. Arquivo, Exportar funciona de qualquer forma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Добавляет кнопку «Экспортировать» на панель инструментов каждого окна чтения. Команда меню «Файл», «Экспортировать» работает и без неё."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Додає кнопку «Експортувати» на панель інструментів кожного вікна читання. Команда «Файл» > «Експортувати» працює в обох випадках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在每个阅读器的工具栏中添加“导出”按钮。使用“文件”>“导出”同样可以导出。"
          }
        }
      }
    },
    "Adds or removes a bookmark at the current position" : {
      "comment" : "VoiceOver hint of the Show bookmark button checkbox in the Playback settings.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يضيف إشارة مرجعية عند الموضع الحالي أو يزيلها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বর্তমান অবস্থানে একটি বুকমার্ক যোগ করে বা সরায়"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
