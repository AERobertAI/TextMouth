          }
        }
      }
    },
    "TextMouth can't use the braille table chosen in Settings, “%@”, so this export starts from %@." : {
      "comment" : "Shown in the Export dialog's braille options when the table chosen in Settings can't be used. %1$@ is that table's name as macOS gives it and %2$@ the table the export starts from, in words such as \"Unified English Braille, uncontracted\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kann die in den Einstellungen gewählte Brailletabelle „%1$@“ nicht verwenden, daher beginnt dieser Export mit %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TextMouth can't use the braille table chosen in Settings, “%1$@”, so this export starts from %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede usar la tabla de braille elegida en Ajustes, «%1$@», así que esta exportación empieza con %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ne peut pas utiliser la table braille choisie dans Réglages, « %1$@ », donc cette exportation part de %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non può usare la tabella braille scelta in Impostazioni, “%1$@”, quindi questa esportazione parte da %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não pode usar a tabela braille escolhida nos Ajustes, “%1$@”, então esta exportação começa com %2$@."
          }
        }
      }
    },
    "TextMouth can't use this Mac's table “%@”: %@." : {
      "comment" : "Announced when one of this Mac's braille tables, just chosen, was refused by its check. %1$@ is the table's name as macOS gives it and %2$@ the reason, a clause.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kann die Tabelle „%1$@“ dieses Mac nicht verwenden: %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TextMouth can't use this Mac's table “%1$@”: %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede usar la tabla «%1$@» de esta Mac: %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ne peut pas utiliser la table « %1$@ » de ce Mac : %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non può usare la tabella “%1$@” di questo Mac: %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não pode usar a tabela “%1$@” deste Mac: %2$@."
          }
        }
      }
    },
    "TextMouth cannot open copy-protected files." : {
      "comment" : "Advice after the refusal of audio that is locked to a store's own player, such as Audible's .aa and .aax files.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kann kopiergeschützte Dateien nicht öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede abrir archivos con protección contra copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ne peut pas ouvrir les fichiers protégés contre la copie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non può aprire file protetti da copia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não consegue abrir arquivos protegidos contra cópia."
          }
        }
      }
    },
    "TextMouth closed while opening %@, so it wasn't reopened." : {
      "comment" : "Announced at launch after the app closed while it was opening a book. %@ is the book's title, which is not opened again.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth wurde beim Öffnen von %@ beendet und öffnete es daher nicht erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth se cerró al abrir %@, así que no se volvió a abrir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth s’est fermé pendant l’ouverture de %@ ; ce livre n’a donc pas été rouvert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth si è chiuso durante l’apertura di %@, quindi non è stato riaperto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth fechou ao abrir %@, então ele não foi reaberto."
          }
        }
      }
    },
    "TextMouth could not check this Mac's braille table “%@”: %@. Try again." : {
      "comment" : "Why a braille translation was refused: one of this Mac's braille tables could not be checked. %1$@ is the table's name as macOS gives it and %2$@ the reason, which stays English.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
