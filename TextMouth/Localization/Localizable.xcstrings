    "Part of %@ could not be decoded and is kept as silence." : {
      "comment" : "Notice that part of one file's sound could not be decoded and the book keeps it as silence. %@ is the file's name in curly quotes.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Teil von %@ konnte nicht decodiert werden und bleibt als Stille erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una parte de %@ no se pudo decodificar y se conserva como silencio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une partie de %@ n’a pas pu être décodée et est conservée en silence."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ का एक हिस्सा डीकोड नहीं हो सका और मौन के रूप में रखा गया है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sebagian dari %@ tidak dapat didekode dan dibiarkan senyap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una parte di %@ non ha potuto essere decodificata ed è mantenuta come silenzio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@の一部をデコードできなかったため、無音のままにしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@의 일부를 디코딩할 수 없어 무음으로 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Parte de %@ não pôde ser decodificada e foi mantida como silêncio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Часть %@ не удалось декодировать, она сохранена как тишина."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Частину %@ не вдалося декодувати, її збережено як тишу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@的一部分无法解码，已保留为静音。"
          }
        }
      }
    },
    "Part of %@ isn't on this Mac." : {
