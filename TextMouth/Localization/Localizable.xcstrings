          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نسخه‌ای جدیدتر از TextMouth این صدا را ویرایش کرده است، بنابراین این نسخه ویرایش‌های آن را دست‌نخورده می‌گذارد."
