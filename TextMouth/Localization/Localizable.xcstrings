            "value" : "录入新的快捷键。"
          }
        }
      }
    },
    "Records from a microphone into a new audiobook." : {
      "comment" : "One-line summary and VoiceOver hint of the Record choice of the Add to Library sheet.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nimmt mit einem Mikrofon in ein neues Hörbuch auf."
          }
