    },
    "Front Cover" : {
      "comment" : "Title of the chapter of a comic book archive's page that its ComicInfo.xml calls the front cover, made at import. Title case."
    },
    "Genre" : {
      "comment" : "Name of the book information sheet's field for an audiobook's genre; VoiceOver reads it as the field's label."
    },
    "Gesture pattern" : {
      "comment" : "Heading of the list of steps that make up the restart gesture, in the Miscellaneous settings."
    },
    "Gesture time window" : {
      "comment" : "VoiceOver label of the restart gesture's time window slider in the Miscellaneous settings."
    },
    "Get a fresh copy of the archive, then import it again." : {
      "comment" : "Last sentence of why an import's archive stopped extracting: what to do."
    },
    "Getting Your Library" : {
      "comment" : "Heading of the screen shown while TextMouth gets the library's files from the cloud; the library opens by itself when they arrive."
