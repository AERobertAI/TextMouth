        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo comprimido se expande a %1$@, pero el disco que contiene la biblioteca de TextMouth solo tiene %2$@ libres, y TextMouth mantiene %3$@ libres."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آرشیو به %1$@ گسترش می‌یابد، اما دیسکی که کتابخانه‌ی TextMouth در آن است فقط %2$@ فضای خالی دارد و TextMouth %3$@ از آن را خالی نگه می‌دارد."
