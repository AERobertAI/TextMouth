        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आपने इस ट्रांसक्रिप्ट को %@ को संपादित किया। फिर से ट्रांसक्राइब करने पर आपके संपादन बदल जाते हैं।"
