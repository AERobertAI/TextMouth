    "This audio has no chapter markers." : {
      "comment" : "Said by the audio editor's chapter commands when the audio has no chapter markers."
    },
    "This book follows the global setting now." : {
      "comment" : "Said as a book's original audio policy is set to follow the global setting. A sentence saying what that setting does follows."
    },
    "This book keeps its original audio for %lld days after it was saved or last edited." : {
      "comment" : "Said as a book's original audio policy is set to keep the original for a number of days. %lld is the number of days.",
      "localizations" : {
