            "value" : "“%1$@” necesita %2$@ libres"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%1$@» به %2$@ فضای آزاد نیاز دارد"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "« %1$@ » nécessite %2$@ d’espace libre"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” זקוק ל-%2$@ פנויים"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” को %2$@ खाली जगह चाहिए"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” memerlukan %2$@ ruang kosong"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” richiede %2$@ liberi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%1$@」は%2$@の空き容量が必要です"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@”: 여유 공간 %2$@ 필요"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” heeft %2$@ vrije ruimte nodig"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%1$@” wymaga %2$@ wolnego miejsca"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” precisa de %2$@ livres"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Для «%1$@» нужно %2$@ свободного места"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "”%1$@” behöver %2$@ ledigt"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” ต้องมีพื้นที่ว่าง %2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
