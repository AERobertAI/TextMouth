            "value" : "Inserted %@ of new recording, which is selected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se insertó una grabación nueva de %@, que queda seleccionada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ضبط جدید درج شد و انتخاب شده است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Inséré : %@ du nouvel enregistrement, sélectionné."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "נוספה הקלטה חדשה באורך %@, והיא נבחרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ की नई रिकॉर्डिंग डाली गई, जो चयनित है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rekaman baru berdurasi %@ disisipkan dan kini terpilih."
          }
        },
        "it" : {
