    "archiveBudgetError.expandsPastLimit.holding" : {
      "comment" : "Why an import's archive was refused. %1$@ is the size the archive expands to, such as \"2 GB\"; %2$@ is the limit for archives that hold audio or other archives.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يتوسع الأرشيف إلى %@، وهو أكثر من %@ التي يستخرجها TextMouth من الأرشيفات التي تحتوي على صوت أو على أرشيفات أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আর্কাইভটি %1$@ পর্যন্ত বড় হয়, যা অডিও বা অন্য আর্কাইভ থাকা আর্কাইভ থেকে TextMouth যে %2$@ বের করে তার চেয়ে বেশি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Archiv wird auf %1$@ entpackt, mehr als die %2$@, die TextMouth aus Archiven mit Audio oder anderen Archiven extrahiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archive expands to %@, more than the %@ TextMouth extracts from archives holding audio or other archives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo comprimido se expande a %1$@, más de los %2$@ que TextMouth extrae de archivos comprimidos con audio u otros archivos comprimidos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آرشیو به %1$@ گسترش می‌یابد، بیش از %2$@ که TextMouth از آرشیوهای حاوی صدا یا آرشیوهای دیگر استخراج می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une fois décompressée, l’archive occupe %1$@, soit plus que les %2$@ que TextMouth extrait des archives contenant de l’audio ou d’autres archives."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הארכיון מתרחב ל-%1$@, יותר מה-%2$@ ש-TextMouth מחלץ מארכיונים שמכילים שמע או ארכיונים אחרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आर्काइव %1$@ तक फैलता है, जो ऑडियो या अन्य आर्काइव वाले आर्काइव से TextMouth द्वारा निकाले जाने वाले %2$@ से अधिक है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arsip mengembang menjadi %1$@, lebih dari %2$@ yang diekstrak TextMouth dari arsip berisi audio atau arsip lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’archivio si espande a %@, più dei %@ che TextMouth estrae da archivi contenenti audio o altri archivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "アーカイブは%1$@に展開されますが、TextMouth が音声やほかのアーカイブを含むアーカイブから展開する上限は%2$@です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "압축 파일을 풀면 %1$@이(가) 되며, 이는 오디오 또는 다른 압축 파일이 들어 있는 압축 파일에서 TextMouth가 추출하는 한도인 %2$@을(를) 초과합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Het archief wordt uitgepakt tot %1$@, meer dan de %2$@ die TextMouth uitpakt uit archieven met audio of andere archieven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Archiwum po rozpakowaniu zajmie %1$@, więcej niż %2$@, które TextMouth wyodrębnia z archiwów zawierających dźwięk lub inne archiwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo compactado se expande para %1$@, mais do que os %2$@ que o TextMouth extrai de arquivos compactados com áudio ou com outros arquivos compactados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Архив распаковывается до %1$@, что больше %2$@ — предела, до которого TextMouth распаковывает архивы с аудио или другими архивами."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arkivet expanderar till %1$@, mer än de %2$@ som TextMouth extraherar från arkiv som innehåller ljud eller andra arkiv."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไฟล์เก็บถาวรขยายเป็น %@ ซึ่งมากกว่า %@ ที่ TextMouth แตกจากไฟล์เก็บถาวรที่มีเสียงหรือไฟล์เก็บถาวรอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arşiv %1$@ boyutuna açılıyor; bu, TextMouth'un ses veya başka arşivler içeren arşivlerden çıkardığı %2$@ sınırından fazla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Після розпакування архів займе %1$@, що більше за ліміт TextMouth для архівів з аудіо чи іншими архівами: %2$@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آرکائیو پھیل کر %1$@ ہو جاتا ہے، جو اس %2$@ سے زیادہ ہے جو TextMouth آڈیو یا دوسرے آرکائیو والے آرکائیو سے نکالتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tệp lưu trữ giải nén thành %1$@, vượt quá %2$@ mà TextMouth giải nén từ các tệp lưu trữ chứa âm thanh hoặc tệp lưu trữ khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "该归档展开后为 %1$@，超过了 TextMouth 从含有音频或其他归档的归档中提取的 %2$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "封存檔會展開為 %1$@，超過 TextMouth 從含有音訊或其他封存檔的封存檔中擷取的 %2$@ 上限。"
          }
        }
      }
    },
    "archiveBudgetError.expandsPastLimit.innerHolding" : {
      "comment" : "Why an import's archive was refused when it holds other archives. %1$@ is the total size they expand to, such as \"2 GB\"; %2$@ is the limit for archives that hold audio or other archives.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يتوسع الأرشيف مع الأرشيفات الموجودة بداخله إلى %@، وهو أكثر من %@ التي يستخرجها TextMouth من الأرشيفات التي تحتوي على صوت أو على أرشيفات أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ভেতরের আর্কাইভ সহ আর্কাইভটি %1$@ পর্যন্ত বড় হয়, যা অডিও বা অন্য আর্কাইভ থাকা আর্কাইভ থেকে TextMouth যে %2$@ বের করে তার চেয়ে বেশি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zusammen mit den darin enthaltenen Archiven wird das Archiv auf %1$@ entpackt, mehr als die %2$@, die TextMouth aus Archiven mit Audio oder anderen Archiven extrahiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Together with the archives inside it, the archive expands to %@, more than the %@ TextMouth extracts from archives holding audio or other archives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Junto con los archivos comprimidos de su interior, el archivo comprimido se expande a %1$@, más de los %2$@ que TextMouth extrae de archivos comprimidos con audio u otros archivos comprimidos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آرشیو همراه با آرشیوهای درون آن به %1$@ گسترش می‌یابد، بیش از %2$@ که TextMouth از آرشیوهای حاوی صدا یا آرشیوهای دیگر استخراج می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Avec les archives qu’elle contient, l’archive occupe %1$@ une fois décompressée, soit plus que les %2$@ que TextMouth extrait des archives contenant de l’audio ou d’autres archives."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "יחד עם הארכיונים שבתוכו, הארכיון מתרחב ל-%1$@, יותר מה-%2$@ ש-TextMouth מחלץ מארכיונים שמכילים שמע או ארכיונים אחרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "अंदर के आर्काइव सहित यह आर्काइव %1$@ तक फैलता है, जो ऑडियो या अन्य आर्काइव वाले आर्काइव से TextMouth द्वारा निकाले जाने वाले %2$@ से अधिक है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bersama arsip di dalamnya, arsip mengembang menjadi %1$@, lebih dari %2$@ yang diekstrak TextMouth dari arsip berisi audio atau arsip lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Insieme agli archivi al suo interno, l’archivio si espande a %@, più dei %@ che TextMouth estrae da archivi contenenti audio o altri archivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "内側のアーカイブと合わせて、アーカイブは%1$@に展開されますが、TextMouth が音声やほかのアーカイブを含むアーカイブから展開する上限は%2$@です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "그 안의 압축 파일까지 합치면 압축 파일을 풀 때 %1$@이(가) 되며, 이는 오디오 또는 다른 압축 파일이 들어 있는 압축 파일에서 TextMouth가 추출하는 한도인 %2$@을(를) 초과합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Samen met de archieven erin wordt het archief uitgepakt tot %1$@, meer dan de %2$@ die TextMouth uitpakt uit archieven met audio of andere archieven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Archiwum wraz z zawartymi w nim archiwami zajmie po rozpakowaniu %1$@, więcej niż %2$@, które TextMouth wyodrębnia z archiwów zawierających dźwięk lub inne archiwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Junto com os arquivos compactados dentro dele, o arquivo compactado se expande para %1$@, mais do que os %2$@ que o TextMouth extrai de arquivos compactados com áudio ou com outros arquivos compactados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вместе с вложенными архивами архив распаковывается до %1$@, что больше %2$@ — предела, до которого TextMouth распаковывает архивы с аудио или другими архивами."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tillsammans med arkiven inuti expanderar arkivet till %1$@, mer än de %2$@ som TextMouth extraherar från arkiv som innehåller ljud eller andra arkiv."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เมื่อรวมกับไฟล์เก็บถาวรที่อยู่ข้างใน ไฟล์เก็บถาวรขยายเป็น %@ ซึ่งมากกว่า %@ ที่ TextMouth แตกจากไฟล์เก็บถาวรที่มีเสียงหรือไฟล์เก็บถาวรอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "İçindeki arşivlerle birlikte arşiv %1$@ boyutuna açılıyor; bu, TextMouth'un ses veya başka arşivler içeren arşivlerden çıkardığı %2$@ sınırından fazla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Разом з архівами всередині нього архів після розпакування займе %1$@, що більше за ліміт TextMouth для архівів з аудіо чи іншими архівами: %2$@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
