    "This book could not be moved to the Trash and remains in the library:" : {
      "comment" : "Heading over the one book that could not be moved to the Trash. A line about it follows."
    },
    "This book could not be removed from the library and remains in it:" : {
      "comment" : "Heading over the one book that could not be removed from the library. A line about it follows."
    },
    "This book was not opened from the reading list." : {
      "comment" : "VoiceOver announcement when Next in Reading List or Previous in Reading List is used in a reader whose book was not opened from the reading list.",
      "localizations" : {
