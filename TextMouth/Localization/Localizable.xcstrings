    "substitutions.wholeWordHint" : {
      "comment" : "VoiceOver hint of the Match whole word only switch in the substitution rule editor.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يتخطى المطابقات المجاورة لحروف أو أرقام أو شرطات سفلية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "অক্ষর, অঙ্ক বা আন্ডারস্কোরের পাশের মিল এড়িয়ে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Überspringt Treffer neben Buchstaben, Ziffern oder Unterstrichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skips matches next to letters, digits, or underscores"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Omite coincidencias junto a letras, dígitos o guiones bajos"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تطابق‌های مجاور حروف، ارقام یا زیرخط را رد می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ignore les correspondances situées à côté de lettres, de chiffres ou de traits de soulignement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מדלג על התאמות הצמודות לאותיות, לספרות או לקווים תחתונים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "अक्षरों, अंकों या अंडरस्कोर से सटे मिलान छोड़ देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Melewati kecocokan di samping huruf, angka, atau garis bawah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Salta le corrispondenze accanto a lettere, cifre o trattini bassi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文字、数字、アンダースコアに隣接する一致をスキップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "문자, 숫자 또는 밑줄 옆에 있는 일치 항목을 건너뜁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Slaat treffers naast letters, cijfers of liggende streepjes over."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pomija dopasowania obok liter, cyfr lub podkreślników."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ignora correspondências ao lado de letras, dígitos ou sublinhados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Пропускает совпадения рядом с буквами, цифрами или подчёркиваниями."
          }
