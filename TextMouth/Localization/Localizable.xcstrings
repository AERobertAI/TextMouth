      }
    },
    "shortcutsSettings.doublePressTimeHint" : {
      "comment" : "Hint of the double press time stepper in Settings: what the time is, and that a key that has one action for a single press and another for a double press waits for that time before acting on a single press.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "المدة التي يجب أن تفصل الضغطة الثانية عن الأولى. المفتاح الذي له إجراءان مختلفان للضغطة الواحدة والضغطة المزدوجة ينتظر هذه المدة قبل أن ينفّذ إجراء الضغطة الواحدة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "প্রথম চাপের পর দ্বিতীয় চাপ কত তাড়াতাড়ি আসতে হবে। যে কী-এর একবার চাপা ও দুইবার চাপার কাজ আলাদা, তার একবার চাপার কাজ এতক্ষণ অপেক্ষা করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wie schnell ein zweiter Tastendruck auf den ersten folgen muss. Eine Taste mit unterschiedlichen Aktionen für einfachen und doppelten Druck wartet so lange, bevor ihr einfacher Druck wirkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How soon a second press must follow the first. A key with different single and double press actions waits this long before its single press acts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cuánto puede tardar la segunda pulsación tras la primera. Una tecla con acciones distintas para la pulsación simple y la doble espera este tiempo antes de ejecutar la simple."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مشخص می‌کند فشردن دوم چقدر زود باید پس از اولی بیاید. کلیدی که فشردن تکی و دوبار فشردنش کنش‌های متفاوتی دارند، پیش از اجرای کنش فشردن تکی به همین اندازه صبر می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Délai maximal entre deux appuis. Une touche dont l’appui simple et le double appui ont des actions différentes attend ce délai avant d’agir sur l’appui simple."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "תוך כמה זמן חייבת לבוא לחיצה שנייה אחרי הראשונה. מקש שיש לו פעולות שונות ללחיצה בודדת ולחיצה כפולה ממתין זמן זה לפני שהלחיצה הבודדת פועלת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "दूसरी बार दबाना पहली बार के कितनी जल्दी बाद होना चाहिए। जिस कुंजी की एक बार और दो बार दबाने की क्रियाएँ अलग हों, वह एक बार दबाने की क्रिया करने से पहले इतनी देर रुकती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Seberapa cepat penekanan kedua harus menyusul yang pertama. Tombol dengan aksi tekan tunggal dan tekan ganda yang berbeda menunggu selama itu sebelum aksi tekan tunggalnya berjalan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Entro quanto tempo la seconda pressione deve seguire la prima. Un tasto con azioni diverse per la pressione singola e la doppia attende questo tempo prima di eseguire quella singola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "2回目の押下が、1回目からどのくらい以内に続く必要があるかを設定します。1回押しと2回押しで別の操作があるキーは、この時間だけ待ってから1回押しの操作を実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "두 번째 누름이 첫 번째 누름 뒤에 이어져야 하는 시간입니다. 한 번 누르기와 두 번 누르기의 동작이 다른 키는 한 번 누르기를 실행하기 전에 이 시간만큼 기다립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hoe snel een tweede druk op de eerste moet volgen. Een toets met verschillende acties voor enkel en dubbel indrukken wacht zo lang voordat de actie voor enkel indrukken wordt uitgevoerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jak szybko po pierwszym naciśnięciu musi nastąpić drugie. Klawisz z różnymi działaniami dla pojedynczego i podwójnego naciśnięcia czeka tyle czasu, zanim wykona działanie pojedynczego naciśnięcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O tempo máximo entre o primeiro e o segundo pressionamento. Uma tecla com ações diferentes para pressionamento simples e duplo espera esse tempo antes de executar a ação do pressionamento simples."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Как быстро должно последовать второе нажатие после первого. Клавиша с разными действиями для одиночного и двойного нажатия ждёт столько времени, прежде чем сработает одиночное."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hur snabbt ett andra tryck måste följa det första. En tangent med olika åtgärder för enkeltryck och dubbeltryck väntar så länge innan enkeltrycket utförs."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ระยะเวลาที่การกดครั้งที่สองต้องตามหลังครั้งแรก แป้นที่มีการทำงานต่างกันระหว่างกดครั้งเดียวและกดสองครั้งจะรอตามเวลานี้ก่อนทำงานเมื่อกดครั้งเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "İkinci basışın ilkini ne kadar çabuk izlemesi gerektiği. Tek ve çift basışta farklı eylemleri olan bir tuş, tek basışı işlemeden önce bu kadar bekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Скільки часу може минути між першим і другим натисканням. Клавіша з різними діями для одинарного й подвійного натискання чекає стільки ж, перш ніж виконати одинарне."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "وہ وقت جس کے اندر پہلی بار کے بعد دوسری بار دبانا ضروری ہے۔ جس کلید کے ایک بار اور دو بار دبانے کے عمل الگ ہوں وہ ایک بار دبانے پر عمل کرنے سے پہلے اتنی دیر انتظار کرتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lần nhấn thứ hai phải đến trong khoảng thời gian này sau lần nhấn đầu. Phím có hành động khác nhau cho một lần nhấn và nhấn đúp sẽ đợi chừng này thời gian trước khi thực hiện hành động của một lần nhấn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "两次按键之间允许的最长间隔。单按和连按操作不同的键，会等待这段时间后再执行单按操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "第二次按鍵必須在第一次之後多久內按下。單按與連按兩次動作不同的按鍵，會先等候這段時間才執行單按動作。"
          }
        }
      }
    },
