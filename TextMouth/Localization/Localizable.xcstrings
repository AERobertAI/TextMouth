        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth cannot open copy-protected files."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede abrir archivos con protección contra copia."
          }
        },
        "fa" : {
          "stringUnit" : {
