            "value" : "Parado. De volta a %@."
          }
        }
      }
    },
    "Stopping the library move before quitting." : {
      "comment" : "Announcement when TextMouth is asked to quit during a move of the library.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
