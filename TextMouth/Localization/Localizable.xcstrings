          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ленты %@ остаются вместе с загрузками без папки, пока «Сведения о ленте» не назначат каждой другую."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Стрічки %@ залишаються разом із завантаженнями без папок, доки «Відомості про стрічку» не призначить кожній іншу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
