        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चेतावनी: इससे लाइब्रेरी की EPUB फ़ाइल की प्रति फिर से लिखी जाएगी और उसका MD5 हैश दोबारा निकाला जाएगा।"
