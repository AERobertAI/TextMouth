    "No voice is installed. Add one in System Settings, Accessibility, Spoken Content, then export again." : {
      "comment" : "Why a spoken audio export was refused: no voice is installed. System Settings, Accessibility, and Spoken Content are the names of macOS settings.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es ist keine Stimme installiert. Füge in den Systemeinstellungen unter „Bedienungshilfen“ > „Gesprochene Inhalte“ eine hinzu und exportiere dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay ninguna voz instalada. Agrega una en Ajustes del Sistema, Accesibilidad, Contenido hablado, y vuelve a exportar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucune voix n’est installée. Ajoutez-en une dans Réglages Système, Accessibilité, Contenu énoncé, puis exportez de nouveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कोई आवाज़ इंस्टॉल नहीं है। सिस्टम सेटिंग, एक्सेसिबिलिटी, बोली जाने वाली सामग्री में एक जोड़ें, फिर दोबारा निर्यात करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tidak ada suara yang terpasang. Tambahkan satu di Pengaturan Sistem, Aksesibilitas, Konten Ucapan, lalu ekspor lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nessuna voce installata. Aggiungine una in Impostazioni di Sistema, Accessibilità, Contenuto parlato, poi esporta di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "インストールされている声がありません。「システム設定」の「アクセシビリティ」>「読み上げコンテンツ」で追加してから、もう一度書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "설치된 음성이 없습니다. 시스템 설정, 손쉬운 사용, 말하기 콘텐츠에서 음성을 추가한 다음 다시 내보내십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nenhuma voz está instalada. Adicione uma em Ajustes do Sistema, Acessibilidade, Conteúdo falado e exporte novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Голос не установлен. Добавьте его в «Системные настройки», «Универсальный доступ», «Речь», затем экспортируйте снова."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Жодного голосу не встановлено. Додайте голос: Системні налаштування, Універсальний доступ, Вимовлений вміст, а потім експортуйте знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "未安装语音。请在“系统设置”>“辅助功能”>“朗读内容”中添加，然后再次导出。"
          }
        }
      }
    },
    "No voices are installed. Add voices in Settings, Accessibility, Read & Speak." : {
      "comment" : "What the iPhone's voice list says once the voices have loaded and none is installed. \"Settings, Accessibility, Read & Speak\" is the path in iOS's own Settings app, so keep those names as iOS shows them in the language.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es sind keine Stimmen installiert. Füge in „Einstellungen“ > „Bedienungshilfen“ > „Gesprochene Inhalte“ Stimmen hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay voces instaladas. Agrega voces en Ajustes, Accesibilidad, Contenido hablado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucune voix n’est installée. Ajoutez des voix dans Réglages, Accessibilité, Contenu énoncé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कोई आवाज़ इंस्टॉल नहीं है। सेटिंग, एक्सेसिबिलिटी, पढ़ें और बोलें में आवाज़ें जोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tidak ada suara yang terpasang. Tambahkan suara di Pengaturan, Aksesibilitas, Baca & Ucapkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nessuna voce installata. Aggiungi delle voci in Impostazioni, Accessibilità, Leggi e pronuncia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "インストールされている声がありません。「設定」の「アクセシビリティ」>「読み上げコンテンツ」で声を追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "설치된 음성이 없습니다. 설정, 손쉬운 사용, 읽기 및 말하기에서 음성을 추가하십시오."
