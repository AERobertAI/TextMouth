      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ربما تغيّر جدول برايل “%1$@” الخاص بهذا الـ Mac منذ أن قرأ liblouis %2$@ الكتاب، لذا يحتفظ TextMouth بنص الكتاب كما كان."
          }
        },
