          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ không gửi được tệp (lỗi %2$@). Hãy thử lại sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
