    "Undo Cleanup puts back the transcript from before." : {
      "comment" : "Last sentence of the Clean Up Transcript sheet's line about a transcript cleaned up already. Undo Cleanup is the name of a button of the sheet.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„Bereinigung widerrufen“ stellt das Transkript von vorher wieder her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deshacer limpieza restaura la transcripción anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Annuler le nettoyage remet la transcription d’avant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Annulla pulizia ripristina la trascrizione precedente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Desfazer limpeza recoloca a transcrição de antes."
          }
        }
      }
    },
    "Undo or redo back to the audio as last saved." : {
      "comment" : "Ends a message saying the edits need an original audio that is gone: only undoing or redoing back to the audio as last saved helps.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Widerrufe oder wiederhole, bis das Audio so ist, wie es zuletzt gesichert wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deshaz o rehaz hasta volver al audio como se guardó por última vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Annulez ou rétablissez pour revenir à l’audio tel qu’il a été enregistré en dernier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Annulla o ripeti fino all’audio come salvato l’ultima volta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Desfaça ou refaça até voltar ao áudio como foi salvo por último."
          }
        }
      }
    },
    "Undoes every edit, back to the original; Redo brings them back." : {
      "comment" : "Hint of the audio editor's Revert to Original button. \"Redo\" is the name of a command.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Widerruft jede Bearbeitung bis zum Original; „Wiederholen“ bringt sie zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deshace todas las ediciones, hasta el original; Rehacer las recupera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Annule toutes les modifications, jusqu’à l’original ; Rétablir les ramène."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Annulla ogni modifica, fino all’originale; Ripeti le riporta indietro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Desfaz todas as edições, de volta ao original; Refazer as traz de volta."
          }
        }
      }
    },
