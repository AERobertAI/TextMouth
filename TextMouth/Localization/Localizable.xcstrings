    "libraryViewModel.openNextTime" : {
      "comment" : "First part of the message when Use This Library could not open TextMouth again. %1$@ is the library's folder; %2$@ is the system's reason, a sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سيفتح TextMouth المكتبة في %@ في المرة التالية التي يُفتح فيها، لكن تعذّر عليه إعادة الفتح بنفسه: %@"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth পরের বার খোলার সময় %1$@-এর লাইব্রেরি খুলবে, কিন্তু নিজে থেকে আবার খুলতে পারেনি: %2$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth öffnet beim nächsten Start die Bibliothek in %1$@, konnte sich aber nicht selbst neu starten: %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth will open the library in %@ the next time it opens, but it couldn't open again by itself: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth abrirá la biblioteca de %1$@ la próxima vez que se abra, pero no pudo abrirse de nuevo por sí mismo: %2$@"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth دفعه بعد که باز شود، کتابخانه در %1$@ را باز می‌کند، اما نتوانست خودش دوباره باز شود: %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ouvrira la bibliothèque dans %1$@ à sa prochaine ouverture, mais il n’a pas pu se rouvrir de lui-même : %2$@"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth יפתח את הספרייה שבתיקייה %1$@ בפעם הבאה שייפתח, אך לא הצליח להיפתח שוב מעצמו: %2$@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth अगली बार खुलने पर %1$@ की लाइब्रेरी खोलेगा, लेकिन वह अपने आप फिर से नहीं खुल सका: %2$@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth akan membuka pustaka di %1$@ saat dibuka berikutnya, tetapi tidak dapat terbuka lagi sendiri: %2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth aprirà la libreria in %@ alla prossima apertura, ma non è riuscito a riaprirsi da solo: %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "次に TextMouth を開いたときに%1$@のライブラリを開きますが、自動では開き直せませんでした：%2$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth는 다음에 열릴 때 %1$@의 보관함을 열지만, 스스로 다시 열리지 못했습니다: %2$@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth opent de bibliotheek in %1$@ de volgende keer dat het start, maar kon niet zelf opnieuw starten: %2$@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth otworzy bibliotekę w %1$@ przy następnym uruchomieniu, ale nie mógł otworzyć się ponownie samodzielnie: %2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth vai abrir a biblioteca em %1$@ na próxima vez que abrir, mas não conseguiu abrir de novo sozinho: %2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "При следующем запуске TextMouth откроет библиотеку в %1$@, но сам заново открыться не смог: %2$@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth öppnar biblioteket i %1$@ nästa gång det öppnas, men kunde inte öppnas igen av sig självt: %2$@"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth จะเปิดไลบรารีใน %@ ในครั้งถัดไปที่เปิด แต่เปิดใหม่เองไม่ได้: %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth bir sonraki açılışında %1$@ içindeki kitaplığı açacak, ancak kendi kendine yeniden açılamadı: %2$@"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth відкриє бібліотеку в %1$@ під час наступного запуску, але не зміг відкритися знову сам: %2$@"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth اگلی بار کھلنے پر %1$@ میں موجود لائبریری کھولے گا، لیکن وہ خود دوبارہ نہیں کھل سکا: %2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth sẽ mở thư viện trong %1$@ vào lần mở tiếp theo, nhưng không thể tự mở lại: %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 下次打开时会打开 %1$@ 中的资料库，但无法自行重新打开：%2$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 下次打開時會打開位於 %1$@ 的書庫，但它無法自行重新打開：%2$@"
          }
        }
      }
    },
