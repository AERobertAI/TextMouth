    "importDecisionChoice.cancelDuplicate" : {
      "comment" : "VoiceOver hint of the Cancel button of the duplicate-book question.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يتجاهل النسخة الجديدة. تبقى المكتبة كما كانت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "নতুন কপিটি বাতিল করে। লাইব্রেরি আগের মতোই থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
