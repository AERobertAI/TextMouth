        }
      }
    },
    "Puts back the transcript as it was before the last cleanup." : {
      "comment" : "VoiceOver hint of the Undo Cleanup button of the Clean Up Transcript sheet.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعيد النسخة النصية كما كانت قبل آخر تنظيف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stellt das Transkript so wieder her, wie es vor der letzten Bereinigung war."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Restaura la transcripción como estaba antes de la última limpieza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Remet la transcription telle qu’elle était avant le dernier nettoyage."
          }
