    "fileImportService.bookNoValid" : {
      "comment" : "Why a book's files were not deleted: it has no package inside the library. Follows \"Import failed: \". \"Remove it from the library only\" is a choice of the removal commands.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ليس لهذا الكتاب حزمة مُدارة صالحة. أزله من المكتبة فقط، أو أصلح تخزينه قبل حذفه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই বইয়ের কোনো বৈধ পরিচালিত প্যাকেজ নেই। এটি শুধু লাইব্রেরি থেকে সরান, অথবা মোছার আগে এর স্টোরেজ মেরামত করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
