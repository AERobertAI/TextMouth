    "speechExportError.notEnoughSpace" : {
      "comment" : "Why a spoken audio export was refused: the disk is too full. %1$@ is the space the export needs and %2$@ the space TextMouth always keeps free, each a size such as 1 GB.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا توجد مساحة كافية على القرص: يحتاج هذا إلى نحو %1$@، ويُبقي TextMouth %2$@ خالية. حرّر بعض المساحة، ثم صدّر مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ডিস্কে জায়গা কম: এর জন্য প্রায় %1$@ লাগবে, আর TextMouth %2$@ খালি রাখে। কিছু জায়গা খালি করুন, তারপর আবার রপ্তানি করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Datenträger hat nicht genug Platz: Dafür werden etwa %1$@ benötigt, und TextMouth hält %2$@ frei. Gib etwas Speicherplatz frei und exportiere dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The disk lacks room: this needs about %@, and TextMouth keeps %@ free. Free some space, then export again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay espacio suficiente en el disco: esto necesita unos %1$@, y TextMouth mantiene libres %2$@. Libera espacio y vuelve a exportar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "دیسک جا ندارد: این کار حدود %1$@ نیاز دارد و TextMouth %2$@ را آزاد نگه می‌دارد. مقداری فضا آزاد کنید، سپس دوباره صادر کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le disque manque de place : il faut environ %1$@, et TextMouth garde %2$@ de libre. Libérez de l’espace, puis exportez de nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אין בדיסק מספיק מקום: הפעולה דורשת בערך %1$@, ו-TextMouth משאיר %2$@ פנויים. פנה מקום ואז ייצא שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "डिस्क में जगह कम है: इसके लिए लगभग %1$@ चाहिए, और TextMouth %2$@ ख़ाली रखता है। कुछ जगह ख़ाली करें, फिर दोबारा निर्यात करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ruang disk tidak cukup: ini memerlukan sekitar %1$@, dan TextMouth menyisakan %2$@ kosong. Kosongkan sebagian ruang, lalu ekspor lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Spazio insufficiente sul disco: servono circa %1$@ e TextMouth ne mantiene %2$@ liberi. Libera dello spazio, poi esporta di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ディスクの空き容量が足りません：これには約%1$@が必要で、TextMouth は%2$@を空けておきます。容量を空けてから、もう一度書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "디스크 공간이 부족합니다. 약 %1$@이(가) 필요하며 TextMouth는 %2$@을(를) 여유 공간으로 유지합니다. 공간을 확보한 다음 다시 내보내십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De schijf heeft te weinig ruimte: dit heeft ongeveer %1$@ nodig, en TextMouth houdt %2$@ vrij. Maak ruimte vrij en exporteer daarna opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Na dysku brakuje miejsca: potrzeba około %1$@, a TextMouth zawsze zostawia wolne %2$@. Zwolnij miejsce, a potem wyeksportuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O disco não tem espaço: isto precisa de cerca de %1$@, e o TextMouth mantém %2$@ livres. Libere espaço e exporte de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "На диске не хватает места: нужно около %1$@, а TextMouth оставляет свободными %2$@. Освободите место и экспортируйте снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disken har inte tillräckligt med utrymme: det här behöver ungefär %1$@, och TextMouth håller %2$@ ledigt. Frigör utrymme och exportera sedan igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ดิสก์มีพื้นที่ไม่พอ: ต้องใช้ประมาณ %1$@ และ TextMouth เก็บพื้นที่ว่างไว้ %2$@ เพิ่มพื้นที่ว่าง แล้วส่งออกอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Diskte yeterli yer yok: bunun için yaklaşık %1$@ gerekiyor ve TextMouth %2$@ boş tutuyor. Biraz yer açın, sonra yeniden dışa aktarın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "На диску бракує місця: потрібно близько %1$@, а TextMouth залишає вільними %2$@. Звільніть місце, а потім експортуйте знову."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ڈسک میں جگہ کم ہے: اس کے لیے تقریباً %1$@ درکار ہے، اور TextMouth %2$@ جگہ خالی رکھتا ہے۔ کچھ جگہ خالی کریں، پھر دوبارہ برآمد کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ổ đĩa không đủ chỗ: việc này cần khoảng %1$@, và TextMouth luôn giữ trống %2$@. Hãy giải phóng bớt dung lượng, rồi xuất lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "磁盘空间不足：这需要约 %1$@，而 TextMouth 会保持 %2$@ 可用。请释放一些空间，然后再次导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "磁碟空間不足：這需要約 %1$@，而 TextMouth 會保留 %2$@ 的可用空間。請釋出一些空間，然後再次輸出。"
          }
        }
      }
    },
    "speechExportError.nothingToSpeak" : {
      "comment" : "Why a spoken audio export was refused: the chosen part of the book has no words.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
