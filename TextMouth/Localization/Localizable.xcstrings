    "listeningOptions.skipFinishedHint.article" : {
      "comment" : "VoiceOver hint of the Skip finished articles switch in a news feed's Feed Info.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يسري عندما ينتقل الاستماع إلى مقالة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "শোনা অন্য একটি নিবন্ধে এগিয়ে গেলে প্রযোজ্য হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gilt, wenn die Wiedergabe zu einem anderen Artikel weitergeht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies when listening goes on to another article"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se aplica cuando la escucha continúa con otro artículo"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "وقتی گوش دادن به مقاله‌ای دیگر ادامه می‌یابد اعمال می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "S’applique quand la lecture passe à un autre article."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "חל כשההאזנה ממשיכה לכתבה אחרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "तब लागू होता है जब सुनना किसी दूसरे लेख पर आगे बढ़ता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Berlaku saat pemutaran dilanjutkan ke artikel lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vale quando l’ascolto prosegue con un altro articolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "続けて別の記事を聴くときに適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "다른 기사로 이어서 들을 때 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Geldt wanneer het luisteren doorgaat naar een ander artikel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Działa, gdy słuchanie przechodzi do kolejnego artykułu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vale quando a reprodução continua em outro artigo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Действует при переходе к другой статье."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gäller när lyssningen fortsätter till en annan artikel."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "มีผลเมื่อการฟังไปต่อที่บทความอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dinleme başka bir makaleye geçtiğinde uygulanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Діє, коли прослуховування переходить до іншої статті."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس وقت لاگو ہوتا ہے جب پلے بیک کسی دوسرے مضمون پر جاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Áp dụng khi việc nghe tiếp tục sang bài viết khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "适用于继续收听下一篇文章时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "當聆聽接續到另一篇文章時適用。"
          }
        }
      }
    },
