          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "テキストをまだ読み上げ用に準備できませんでした。TextMouth はあとでもう一度試します。"
          }
        },
        "ko" : {
          "stringUnit" : {
