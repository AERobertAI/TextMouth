    "feed.deletesSentence.goes" : {
      "comment" : "A sentence of the confirmation before Delete Feed, when files go to the Trash: what the feed deletes, one thing. %@ is what is deleted.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحذف %@: ينتقل إلى سلة المهملات، حيث يمكنك استرجاعه إلى أن تُفرَّغ السلة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এটি %@ মুছে ফেলে: তা ট্র্যাশে যায়, ট্র্যাশ খালি না করা পর্যন্ত সেখান থেকে ফিরিয়ে আনা যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gelöscht wird %@ und kommt in den Papierkorb; bis er geleert wird, lässt sich das rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It deletes %@: it goes to the Trash, where you can recover it until the Trash is emptied."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elimina %@: se mueve a la Papelera, donde se puede recuperar hasta que la vacíes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ را حذف می‌کند: به سطل زباله می‌رود و تا خالی شدن سطل می‌توانید آن را بازیابی کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cela supprime %@ : il est placé dans la corbeille, où vous pouvez le récupérer jusqu’à ce que la corbeille soit vidée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הפעולה מוחקת: %@. הקבצים עוברים לאשפה, ואפשר לשחזר אותם משם עד לריקון האשפה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "यह %@ मिटाता है: वह ट्रैश में जाता है, जहाँ से आप उसे ट्रैश खाली होने तक वापस पा सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ini menghapus %@: dipindahkan ke Tempat Sampah, tempat Anda dapat memulihkannya sampai Tempat Sampah dikosongkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elimina %@: va nel Cestino, da cui puoi recuperarlo finché non lo svuoti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@を削除します。ゴミ箱に移動され、ゴミ箱を空にするまで復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@을(를) 삭제합니다. 휴지통으로 이동하며, 휴지통을 비우기 전에는 복구할 수 있습니다."
          }
