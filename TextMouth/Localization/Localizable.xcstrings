    "recording.recoveredDiscarded.which" : {
      "comment" : "Said by the Record window after a recording left behind that held no sound was discarded. %@ is when it was recorded, a date and time.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم تجاهل التسجيل الخاص بـ%@، وهو لا يحتوي على صوت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@-এর রেকর্ডিং বর্জন করা হয়েছে, যাতে কোনো শব্দ ছিল না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aufnahme vom %@ ohne Ton verworfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discarded the recording of %@, which holds no sound."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se descartó la grabación del %@, que no tiene sonido."
