      }
    },
    "storageWorkWait.sentence.movesMoveEnds" : {
      "comment" : "Why a failed move of files waits: it runs when the move of the data directory ends. \"Them\" is the files.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعيدها TextMouth إلى مكانها بمجرد انتهاء نقل مجلد بياناته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ডেটা ডিরেক্টরির স্থানান্তর শেষ হলে TextMouth সেগুলো আবার ফিরিয়ে আনবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth verschiebt sie zurück, sobald das Verschieben seines Datenordners endet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth moves them back once the move of its data directory ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth los devuelve cuando termine el traslado de su directorio de datos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth پس از پایان انتقال دایرکتوری داده خود، آن‌ها را برمی‌گرداند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth les remet en place dès que le déplacement de son dossier de données est terminé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth מחזיר אותם למקומם כשהעברת תיקיית הנתונים שלו תסתיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "डेटा फ़ोल्डर का स्थानांतरण समाप्त होने पर TextMouth उन्हें वापस ले जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth memindahkannya kembali setelah pemindahan folder datanya berakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth li riporta al loro posto quando lo spostamento della sua cartella dei dati termina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "データディレクトリの移動が終わったら、TextMouth はそれらを元に戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 데이터 디렉터리 이동이 끝나면 그것들을 다시 옮깁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth zet ze terug zodra het verplaatsen van de gegevensmap eindigt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth przeniesie je z powrotem po zakończeniu przenoszenia folderu danych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth os move de volta quando a movimentação da pasta de dados terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth вернёт их назад, когда закончится перемещение его каталога данных."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth flyttar tillbaka dem när flytten av datamappen är klar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth จะย้ายกลับเมื่อการย้ายโฟลเดอร์ข้อมูลสิ้นสุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth, veri klasörünün taşınması bittiğinde bunları geri taşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth поверне їх на місце, щойно завершиться переміщення його каталогу даних."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ڈیٹا ڈائریکٹری کی منتقلی ختم ہونے پر TextMouth انہیں واپس منتقل کر دے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth sẽ chuyển chúng về chỗ cũ khi việc di chuyển thư mục dữ liệu kết thúc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 会在其数据目录的移动结束后将它们移回。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 會在資料目錄的移動結束後將它們移回。"
          }
        }
      }
    },
