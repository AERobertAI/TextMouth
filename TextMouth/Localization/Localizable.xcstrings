    "feed.keepArticleChoose" : {
      "comment" : "The last sentence of the confirmation before Delete Feed, for a feed of articles. %@ is the name of the Move to Library command.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "للاحتفاظ بمقالة، اختر %@ في صفها أولًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "একটি নিবন্ধ রাখতে আগে এর সারিতে %@ বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um einen Artikel zu behalten, wähle zuerst %@ in seiner Zeile."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To keep an article, choose %@ on its row first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para conservar un artículo, elige primero %@ en su fila."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "برای نگه داشتن مقاله، ابتدا %@ را در ردیف آن انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pour conserver un article, choisissez d’abord %@ sur sa ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כדי לשמור כתבה, בחר תחילה “%@” בשורה שלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लेख को रखने के लिए पहले उसकी पंक्ति पर “%@” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Untuk mempertahankan artikel, pilih %@ pada barisnya terlebih dahulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Per conservare un articolo, scegli prima %@ nella sua riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "記事を残すには、先にその行で「%@」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "기사를 유지하려면 먼저 해당 행에서 %@을(를) 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kies eerst %@ in de rij van een artikel om het te bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aby zachować artykuł, najpierw wybierz %@ w jego wierszu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para manter um artigo, escolha antes %@ na linha dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Чтобы сохранить статью, сначала выберите %@ в её строке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Om du vill behålla en artikel väljer du först %@ på dess rad."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หากต้องการเก็บบทความไว้ ให้เลือก %@ ที่แถวของบทความก่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bir makaleyi saklamak için önce satırında şunu seçin: %@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Щоб зберегти статтю, спершу виберіть «%@» у її рядку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مضمون کو رکھنے کے لیے پہلے اس کی صف پر %@ منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Để giữ một bài viết, hãy chọn trước %@ trên hàng của nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "要保留某篇文章，请先在其所在行选取“%@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "若要保留文章，請先在其列上選擇「%@」。"
          }
        }
      }
    },
