    "Select one audiobook, then choose Transcribe Audio again." : {
      "comment" : "Second sentence of the alert shown when Transcribe Audio is chosen with several books selected. Transcribe Audio is the command's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "حدّد كتابًا صوتيًا واحدًا، ثم اختر “تفريغ الصوت” مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wähle ein Hörbuch aus und wähle dann erneut „Audio transkribieren“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Selecciona un audiolibro y elige Transcribir audio de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sélectionnez un livre audio, puis choisissez à nouveau Transcrire l’audio."
