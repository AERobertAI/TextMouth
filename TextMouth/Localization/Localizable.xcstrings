    "libraryIndexRecovery.continueReading.available" : {
      "comment" : "Last sentence of what Continue Reading does. %1$@ and %2$@ are the names of the Try Again and Rebuild Library Index buttons; %3$@ is the name of the Recovery Options button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يتغير الفهرس إلى أن تختار %@ أو %@، وهما متاحان من %@ في أعلى المكتبة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আপনি “%1$@” বা “%2$@” বেছে না নেওয়া পর্যন্ত সূচক বদলাবে না; এগুলো লাইব্রেরির উপরে “%3$@” থেকে পাওয়া যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Index wird erst geändert, wenn du %1$@ oder %2$@ wählst; beides bleibt über %3$@ oben in der Bibliothek verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The index is not changed until you choose %@ or %@, which stay available from %@ at the top of the library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El índice no cambia hasta que elijas %1$@ o %2$@, que siguen disponibles en %3$@, en la parte superior de la biblioteca."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نمایه تا وقتی %1$@ یا %2$@ را انتخاب نکنید تغییر نمی‌کند؛ این دو از %3$@ در بالای کتابخانه در دسترس می‌مانند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’index n’est pas modifié tant que vous ne choisissez pas %1$@ ou %2$@, qui restent disponibles depuis %3$@ en haut de la bibliothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "האינדקס לא משתנה עד לבחירת “%1$@” או “%2$@”, שנשארים זמינים מתוך “%3$@” בראש הספרייה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इंडेक्स तब तक नहीं बदलता जब तक आप “%1$@” या “%2$@” नहीं चुनते, जो लाइब्रेरी के ऊपर “%3$@” से उपलब्ध रहते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Indeks tidak diubah sampai Anda memilih %1$@ atau %2$@, yang tetap tersedia dari %3$@ di bagian atas pustaka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’indice non cambia finché non scegli %@ o %@, che restano disponibili da %@ nella parte superiore della libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%1$@」または「%2$@」を選択するまで、インデックスは変更されません。どちらもライブラリ上部の「%3$@」から使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 또는 %2$@을(를) 선택하기 전까지 색인은 변경되지 않으며, 두 항목은 보관함 상단의 %3$@에서 계속 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De index wordt pas gewijzigd als je %1$@ of %2$@ kiest, die beschikbaar blijven via %3$@ boven in de bibliotheek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Indeks nie zostanie zmieniony, dopóki nie wybierzesz %1$@ lub %2$@, które pozostają dostępne po wybraniu %3$@ u góry biblioteki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O índice não é alterado até você escolher %1$@ ou %2$@, que continuam disponíveis em %3$@, na parte superior da biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Индекс не изменится, пока вы не выберете «%1$@» или «%2$@»; они остаются доступными в «%3$@» вверху библиотеки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Indexet ändras inte förrän du väljer %1$@ eller %2$@, som förblir tillgängliga från %3$@ högst upp i biblioteket."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ดัชนีจะไม่เปลี่ยนจนกว่าจะเลือก %@ หรือ %@ ซึ่งยังใช้ได้จาก %@ ที่ด้านบนของไลบรารี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dizin, “%1$@” veya “%2$@” seçeneğini seçene kadar değişmez; bunlar kitaplığın üstündeki “%3$@” düğmesinden kullanılabilir kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Індекс не змінюється, доки ви не виберете «%1$@» або «%2$@», які залишаються доступними через «%3$@» угорі бібліотеки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "انڈیکس اس وقت تک نہیں بدلتا جب تک آپ “%1$@” یا “%2$@” منتخب نہ کریں، جو لائبریری کے اوپر “%3$@” سے دستیاب رہتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chỉ mục không thay đổi cho đến khi bạn chọn %1$@ hoặc %2$@; hai nút này vẫn có sẵn khi bạn chọn %3$@ ở đầu thư viện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在你选取 %1$@ 或 %2$@ 之前，索引不会更改，它们仍可从资料库顶部的 %3$@ 中选取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在你選擇 %1$@ 或 %2$@ 之前不會更改索引，這兩個選項會保留在書庫頂端的 %3$@ 中。"
          }
        }
      }
    },
    "libraryIndexRecovery.continueReading.options" : {
      "comment" : "First sentence of what Continue Reading does on the library index recovery sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يغلق هذه الخيارات لتتمكن من مواصلة القراءة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই বিকল্পগুলো বন্ধ করে, যাতে আপনি পড়া চালিয়ে যেতে পারেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Schließt diese Optionen, damit du weiterlesen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closes these options so you can keep reading."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cierra estas opciones para que sigas leyendo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "این گزینه‌ها را می‌بندد تا بتوانید به مطالعه ادامه دهید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ferme ces options pour que vous puissiez continuer à lire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "סוגר את האפשרויות האלה כדי להמשיך בקריאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इन विकल्पों को बंद करता है ताकि आप पढ़ना जारी रख सकें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menutup opsi ini agar Anda dapat terus membaca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chiude queste opzioni per continuare a leggere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "これらのオプションを閉じて、読書を続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 옵션을 닫고 계속 읽을 수 있게 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sluit deze opties zodat je verder kunt lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zamyka te opcje, aby można było czytać dalej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fecha estas opções para você continuar lendo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Закрывает эти параметры, чтобы можно было продолжить чтение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stänger de här alternativen så att du kan fortsätta läsa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ปิดตัวเลือกเหล่านี้เพื่อให้อ่านต่อได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Okumaya devam edebilmeniz için bu seçenekleri kapatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Закриває ці варіанти, щоб ви могли продовжити читання."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ان اختیارات کو بند کرتا ہے تاکہ آپ پڑھنا جاری رکھ سکیں۔"
          }
