        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ خود بخود ریفریش ہونے کے لیے ایسے نیٹ ورک کا انتظار کرتا ہے جس پر ڈیٹا کی حد نہ ہو۔"
