    },
    "This braille looks like English Braille, American Edition. Choose its Braille Code in Book Information." : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. What Book Information says under the pop-up of a braille book that is read as UEB but whose braille shows English Braille, American Edition's signs (BrailleCodeDetector): which code it looks like and where to choose it. Plain, so that VoiceOver and a braille display read it as it is."
    },
    "This explanation appears only once." : {
      "comment" : "Last sentence of the Edit Manifest explanation: it is shown only the first time.\nLast sentence of the Edit Text explanation: it is shown only the first time."
    },
    "This folder holds another copy of the library TextMouth is using." : {
      "comment" : "First sentence of Use This Library's account of the folder the listener chose."
    },
    "This folder is no longer in the library." : {
      "comment" : "Text of the Folder Settings sheet, which shows one library folder's facts and its listening options. What the sheet says in place of the folder, when the folder was deleted in another window while the sheet was open."
    },
    "This item could not be deleted and remains in the library:" : {
      "comment" : "Heading over the one item of a folder that could not be deleted permanently. A line about it follows."
    },
    "This item could not be moved to the Trash and remains in the library:" : {
      "comment" : "Heading over the one item of a folder that could not be moved to the Trash. A line about it follows."
    },
    "This item could not be removed from the library and remains in it:" : {
      "comment" : "Heading over the one item of a folder that could not be removed from the library. A line about it follows."
    },
    "This recording isn't saved. %@ tries again, %@ deletes it, and %@ keeps the window open." : {
      "comment" : "Explanation under the question asked when the Record window is closed with a recording that could not be saved. %1$@, %2$@, and %3$@ are the titles of the question's three buttons: the one that saves, the one that deletes the recording, and the one that keeps the window open.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This recording isn't saved. %1$@ tries again, %2$@ deletes it, and %3$@ keeps the window open."
          }
        }
      }
    },
    "This view is as TextMouth made it." : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). Restore Default…'s hint for a built-in view as TextMouth made it, or Folders or the Reading List, when it is dimmed."
    },
    "Tilde" : {
      "comment" : "Name of the punctuation key \"~\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Tilde\"."
    },
    "Time" : {
      "comment" : "A segment of the display picker in Search in Book: each result's position is shown as an estimated time into the book."
    },
    "Time In" : {
      "comment" : "Choice of the headings sheet's display picker: each heading shows the time into the book at which it begins."
    },
    "Time at %@" : {
      "comment" : "Label of the Go to Time field for a text book. %@ is the reading speed the times count at, such as \"500 words a minute\"."
    },
    "Time exceeds book length." : {
      "comment" : "First sentence of the refusal when the time typed in Go to Time is after the end of a text book."
    },
    "Time exceeds the recording's length." : {
      "comment" : "First sentence of the refusal when the time typed in Go to Time is after the end of an audiobook."
    },
    "Time in the recording" : {
      "comment" : "Label of the Go to Time field for an audiobook: the time is counted in the recording itself."
    },
    "Time remaining" : {
      "comment" : "Text of the Folder Settings sheet, which shows one library folder's facts and its listening options. The label of the time left in all the folder's books, shown only when it is known."
    },
    "Time window" : {
      "comment" : "Title of the slider in the Miscellaneous settings that sets how long the restart gesture's sequence may take."
    },
    "Time window: %@" : {
      "comment" : "The restart gesture's time window shown above its slider in the Miscellaneous settings. %@ is the window in seconds, such as \"2 seconds\"."
    },
    "Timer reset." : {
      "comment" : "VoiceOver announcement after the Restart Sleep Timer command started the running sleep timer again.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Temporizador reiniciado."
          }
        }
      }
    },
    "Timer reset: %@." : {
      "comment" : "VoiceOver announcement after Reset Timer started the sleep timer again. %@ is the timer's state, such as \"15:00 remaining\" or \"stops at the end of the book\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Temporizador reiniciado: %@."
          }
        }
      }
    },
    "Timer restarted: %@." : {
      "comment" : "VoiceOver announcement after the Restart Sleep Timer command set the last timer used again. %@ is that timer's name, such as 30 minutes or End of heading.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Temporizador activado de nuevo: %@."
          }
        }
      }
    },
    "Timer set for %lld minutes." : {
      "comment" : "VoiceOver announcement after a sleep timer of so many minutes was set. %lld is the number of minutes.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
