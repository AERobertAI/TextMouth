        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ é mantido neste Mac para a lista de leitura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Книга «%@» хранится на этом Mac, потому что она в списке для чтения."
          }
        },
