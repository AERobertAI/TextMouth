    },
    "Opens %@, the folder the logs are written to now, in Finder." : {
      "comment" : "VoiceOver hint and tooltip of the Show Logs in Finder button. %@ is the folder's full path, which stays as written."
    },
    "Opens jump to page controls" : {
      "comment" : "Hint of the status row's page button while no jump panel is open."
    },
    "Opens jump to percent controls" : {
      "comment" : "Hint of the reader's percent button while no jump panel is open."
    },
    "Opens jump to time controls" : {
      "comment" : "Hint of the reader's time button while no jump panel is open."
    },
    "Opens the Microphone privacy settings in System Settings." : {
      "comment" : "VoiceOver hint of the Open Privacy Settings button of the Record window. Privacy & Security and Microphone are the names of places in macOS's System Settings, as macOS words them in the language."
    },
    "Opens the book at this match" : {
      "comment" : "VoiceOver hint of a search match's row in the Search Library window."
    },
    "Option" : {
      "comment" : "Name of the Option modifier key, spoken or brailled in a keyboard shortcut such as \"Option + Command + G\"."
    },
    "Order" : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. The direction pop-up's label."
    },
    "Page" : {
      "comment" : "A unit a skip or navigation picker moves by: one page of the book, as the book numbers its pages.\nLabel of the Go to Page field, where the user types a page of the book."
    },
    "Page %@" : {
      "comment" : "Announcement on reaching a page of a book that has pages, and the start of a sentence naming a page. %@ is the page's label as the book names it, such as 13 or xii, an identifier written without digit grouping."
    },
    "Page %@ of %@" : {
      "comment" : "Where the reader is in a book that has pages. %1$@ is the page's label (a number or a roman numeral, an identifier written without digit grouping); %2$@ is the number of pages, written without digit grouping.",
