    "phoneSync.stopQuestion" : {
      "comment" : "The confirmation asked on an iPhone before syncing stops. Nothing is deleted from the iPhone or from iCloud Drive.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هل تريد إيقاف مزامنة هذه المكتبة؟ لن يُحذف شيء، لا على هذا الـ iPhone ولا في iCloud Drive."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই লাইব্রেরির সিঙ্ক কি বন্ধ করবেন? এই iPhone-এ বা iCloud Drive-এ কিছুই মোছা হবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Synchronisierung dieser Bibliothek beenden? Es wird nichts gelöscht, weder auf diesem iPhone noch in iCloud Drive."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop syncing this library? Nothing is deleted, on this iPhone or in iCloud Drive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "¿Detener la sincronización de esta biblioteca? No se elimina nada, ni en este iPhone ni en iCloud Drive."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "همگام‌سازی این کتابخانه متوقف شود؟ هیچ چیزی حذف نمی‌شود، نه در این iPhone و نه در iCloud Drive."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrêter la synchronisation de cette bibliothèque ? Rien n’est supprimé, ni sur cet iPhone ni dans iCloud Drive."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "להפסיק לסנכרן את הספרייה הזו? שום דבר לא יימחק, לא ב-iPhone הזה ולא ב-iCloud Drive."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "क्या इस लाइब्रेरी का सिंक रोकें? इस iPhone पर या iCloud Drive में कुछ भी नहीं हटाया जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hentikan sinkronisasi pustaka ini? Tidak ada yang dihapus, baik di iPhone ini maupun di iCloud Drive."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vuoi interrompere la sincronizzazione di questa libreria? Non viene eliminato nulla, né su questo iPhone né in iCloud Drive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このライブラリの同期を停止しますか？ この iPhone でも iCloud Drive でも、何も削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 보관함의 동기화를 중단하시겠습니까? 이 iPhone과 iCloud Drive 모두 아무것도 삭제되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Synchronisatie van deze bibliotheek stoppen? Er wordt niets verwijderd, niet op deze iPhone en niet in iCloud Drive."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zatrzymać synchronizację tej biblioteki? Nic nie zostanie usunięte, ani na tym urządzeniu iPhone, ani w iCloud Drive."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Parar a sincronização desta biblioteca? Nada será apagado, nem neste iPhone nem no iCloud Drive."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Остановить синхронизацию этой библиотеки? Ничего не будет удалено ни на этом iPhone, ни в iCloud Drive."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vill du stoppa synkroniseringen av det här biblioteket? Ingenting raderas, varken på den här iPhone eller i iCloud Drive."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หยุดซิงค์ไลบรารีนี้ไหม จะไม่มีอะไรถูกลบ ทั้งใน iPhone เครื่องนี้และใน iCloud Drive"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu kitaplığın eşzamanlaması durdurulsun mu? Ne bu iPhone'da ne de iCloud Drive'da hiçbir şey silinmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Зупинити синхронізацію цієї бібліотеки? Нічого не буде видалено ні на цьому iPhone, ні в iCloud Drive."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کیا اس لائبریری کا سنک روک دیا جائے؟ اس iPhone پر یا iCloud Drive میں کچھ بھی حذف نہیں ہوگا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dừng đồng bộ thư viện này? Sẽ không có gì bị xóa, cả trên iPhone này lẫn trong iCloud Drive."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "要停止同步这个资料库吗？这部 iPhone 和 iCloud Drive 中都不会删除任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "要停止同步這個資料庫嗎？這部 iPhone 和 iCloud Drive 上都不會刪除任何內容。"
          }
        }
      }
    },
    "phoneVoice.noVoices" : {
      "comment" : "What the iPhone's voice list says once the voices have loaded and none is installed. \"Settings, Accessibility, Read & Speak\" is the path in iOS's own Settings app, so keep those names as iOS shows them in the language.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا توجد أصوات مثبّتة. أضف أصواتًا في الإعدادات، تسهيلات الاستخدام، القراءة والنطق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "কোনো ভয়েস ইনস্টল করা নেই। সেটিংস, অ্যাক্সেসিবিলিটি, পড়া ও বলায় ভয়েস যোগ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es sind keine Stimmen installiert. Füge in „Einstellungen“, „Bedienungshilfen“, „Gesprochene Inhalte“ Stimmen hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No voices are installed. Add voices in Settings, Accessibility, Read & Speak."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay voces instaladas. Agrega voces en Ajustes, Accesibilidad, Lectura y voz."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هیچ صدایی نصب نشده است. صداها را در Settings، Accessibility، Read & Speak اضافه کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucune voix n’est installée. Ajoutez des voix dans Réglages, Accessibilité, Contenu énoncé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אין קולות מותקנים. הוסף קולות בהגדרות, “נגישות”, “קריאה ודיבור”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कोई आवाज़ इंस्टॉल नहीं है। सेटिंग, एक्सेसिबिलिटी, पढ़ें और बोलें में आवाज़ें जोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tidak ada suara yang terpasang. Tambahkan suara di Pengaturan, Aksesibilitas, Baca & Ucapkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nessuna voce installata. Aggiungi delle voci in Impostazioni, Accessibilità, Leggi e pronuncia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "インストールされている声がありません。「設定」の「アクセシビリティ」の「読み上げコンテンツ」で声を追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "설치된 음성이 없습니다. 설정, 손쉬운 사용, 읽기 및 말하기에서 음성을 추가하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Er zijn geen stemmen geïnstalleerd. Voeg stemmen toe in Instellingen, Toegankelijkheid, Gesproken content."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie zainstalowano żadnych głosów. Dodaj głosy w: Ustawienia, Dostępność, Treść mówiona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nenhuma voz está instalada. Adicione vozes em Ajustes, Acessibilidade, Ler e Falar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Голоса не установлены. Добавьте голоса в «Настройки», «Универсальный доступ», «Речь»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Inga röster är installerade. Lägg till röster i ”Inställningar”, ”Hjälpmedel”, ”Uppläst innehåll”."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไม่ได้ติดตั้งเสียงใด เพิ่มเสียงในการตั้งค่า การช่วยการเข้าถึง อ่านและพูด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yüklü ses yok. Ayarlar, Erişilebilirlik, Konuşulan İçerik bölümünden ses ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Голосів не встановлено. Додайте голоси: Налаштування, Універсальний доступ, Читання та мовлення."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کوئی آواز انسٹال نہیں ہے۔ ترتیبات، رسائی، پڑھیں اور بولیں میں آوازیں شامل کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chưa cài đặt giọng nói nào. Hãy thêm giọng nói trong Cài đặt, Trợ năng, Đọc và nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "未安装语音。请在“设置”的“辅助功能”中，于“朗读内容”添加语音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "尚未安裝語音。請在「設定」的「輔助使用」中，於「閱讀與朗讀」加入語音。"
          }
        }
      }
    },
