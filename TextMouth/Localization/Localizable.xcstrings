          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Если флажок установлен, эта лента следует общей настройке в Настройках, %@; снимите его, чтобы задать ленте собственную."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Коли позначено, ця стрічка дотримується налаштування в «Налаштуваннях», %@; зніміть позначку, щоб дати стрічці власне."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
