    "outsideTranscriptError.runsPastTheEnd" : {
      "comment" : "Error shown when an attached transcript file's times run past the end of the book's audio. %1$@ is where the transcript ends and %2$@ where the audio ends, each a length of time in words such as \"1 hour, 2 minutes, 5 seconds\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تمتد النسخة النصية إلى %1$@، متجاوزةً نهاية الصوت عند %2$@، لذا فهي لصوت آخر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ট্রান্সক্রিপ্ট %1$@ পর্যন্ত চলে, যা অডিওর শেষ %2$@ ছাড়িয়ে গেছে, তাই এটি অন্য অডিওর জন্য।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript reicht bis %1$@, über das Ende des Audios bei %2$@ hinaus, gehört also zu anderem Audio."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The transcript runs to %@, past the audio's end at %@, so it is for other audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcripción llega hasta %1$@, más allá del final del audio en %2$@, así que es de otro audio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "رونوشت تا %1$@ ادامه دارد، فراتر از پایان صدا در %2$@، پس برای صدای دیگری است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcription va jusqu’à %1$@, au-delà de la fin de l’audio à %2$@, donc elle correspond à un autre audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "התמליל נמשך עד %1$@, אחרי סוף השמע ב-%2$@, ולכן הוא מיועד לשמע אחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ट्रांसक्रिप्ट %1$@ तक चलती है, जो %2$@ पर ऑडियो के अंत से आगे है, इसलिए यह किसी दूसरे ऑडियो की है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transkrip berlangsung hingga %1$@, melewati akhir audio pada %2$@, jadi transkrip ini untuk audio lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La trascrizione arriva a %1$@, oltre la fine dell’audio a %2$@, quindi è per un altro audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文字起こしは%1$@まで続いており、オーディオの末尾（%2$@）を超えているため、別のオーディオ用です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "대본이 %1$@까지 이어져 오디오의 끝(%2$@)을 넘으므로 다른 오디오의 대본입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De transcriptie loopt tot %1$@, voorbij het einde van de audio bij %2$@, dus hoort die bij andere audio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Koniec transkrypcji (%1$@) wypada po końcu dźwięku (%2$@), więc dotyczy ona innego dźwięku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A transcrição vai até %1$@, além do fim do áudio em %2$@, então é de outro áudio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
