          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "書き出しを停止します。作成中のファイルは保持されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "내보내기를 중지합니다. 만드는 중인 파일은 보관되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe a exportação. O arquivo que está sendo criado não é mantido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Останавливает экспорт. Создаваемый файл не сохраняется."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Зупиняє експорт. Файл, який створюється, не зберігається."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止导出。正在制作的文件不会保留。"
          }
        }
      }
    },
    "Stops the import under way and those waiting. Books already imported stay." : {
      "comment" : "VoiceOver hint of the import overlay's Cancel button.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppt den laufenden und die wartenden Importe. Bereits importierte Bücher bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detiene la importación en curso y las que esperan. Los libros ya importados se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrête l’importation en cours et celles en attente. Les livres déjà importés restent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "जारी आयात और प्रतीक्षा में रखे आयात रोक देता है। जो पुस्तकें आयात हो चुकी हैं, वे बनी रहती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menghentikan impor yang sedang berjalan dan yang menunggu. Buku yang sudah diimpor tetap ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe l’importazione in corso e quelle in attesa. I libri già importati restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "処理中の読み込みと待機中の読み込みを停止します。すでに読み込んだブックは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "진행 중인 가져오기와 대기 중인 가져오기를 중지합니다. 이미 가져온 책은 그대로 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe a importação em andamento e as que aguardam. Os livros já importados permanecem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Останавливает выполняемый импорт и ожидающие. Уже импортированные книги остаются."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Зупиняє поточний імпорт і ті, що очікують. Уже імпортовані книги залишаються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止正在进行和正在等待的导入。已导入的图书会保留。"
          }
        }
      }
    },
    "Stops the search, keeping the matches found so far" : {
      "comment" : "VoiceOver hint of the Stop button of the Search Library window.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يوقف البحث مع الإبقاء على المطابقات التي وُجدت حتى الآن"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppt die Suche und behält die bisher gefundenen Treffer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detiene la búsqueda y conserva las coincidencias encontradas hasta ahora"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrête la recherche en gardant les correspondances trouvées jusqu’ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
