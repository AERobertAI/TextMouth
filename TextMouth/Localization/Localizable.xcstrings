            "state" : "machine_translated",
            "value" : "Contiene %@, que TextMouth no importa."
          }
        }
      }
    },
    "It holds %@." : {
      "comment" : "Sentence of the alert about a folder that holds no book: what it holds instead. %@ is the kinds of files it holds with their counts, such as \"1 .txt file\" or \"10 .jpg files, 3 .png files, and 4 other files\".\nWhat a conflicting copy of a feed's index holds. %@ is a count of episodes, such as \"12 episodes\".\nWhat a conflicting copy of the library index holds. %@ is its counts as a list, such as \"3 books, 1 folder, and 2 books on the reading list\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Contiene %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Contiene %@."
          }
        }
      }
    },
    "It holds %@; library.json holds %@." : {
      "comment" : "What a conflicting copy of the library index holds, set against the index itself. %1$@ and %2$@ are counts as a list, such as \"3 books, 1 folder, and 2 books on the reading list\". library.json is a file name and stays as written.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It holds %1$@; library.json holds %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Contiene %1$@; library.json contiene %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Contiene %@; library.json contiene %@."
          }
        }
      }
    },
    "It holds %@; the index holds %@." : {
      "comment" : "What a conflicting copy of a feed's index holds, set against the index itself. %1$@ and %2$@ are counts of episodes, such as \"12 episodes\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
