    "feed.deleteFeedHint" : {
      "comment" : "VoiceOver hint of the Delete Feed button in Feed Info.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يسأل أولًا، ثم يحذف هذا الموجز وتنزيلاته وما احتفظ به من تنزيلات أزلتها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আগে জিজ্ঞাসা করে, তারপর এই ফিড, এর ডাউনলোড এবং আপনার সরানো ডাউনলোডের যা রেখেছিল তা মুছে ফেলে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fragt zuerst nach und löscht dann diesen Feed, seine Downloads und das, was er von entfernten Downloads behalten hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asks first, then deletes this feed, its downloads, and what it kept of downloads you removed"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pregunta antes de eliminar este canal, sus descargas y lo que conservó de las descargas que quitaste"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ابتدا می‌پرسد، سپس این فید، بارگیری‌هایش و آنچه از بارگیری‌های برداشته‌شده نگه داشته را حذف می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Demande confirmation, puis supprime ce flux, ses téléchargements et ce qu’il a conservé des téléchargements retirés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "שואל תחילה, ואז מוחק את הערוץ הזה, את ההורדות שלו ואת מה ששמר מהורדות שהסרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पहले पूछता है, फिर इस फ़ीड, उसके डाउनलोड, और आपके हटाए डाउनलोड में से बची चीज़ों को मिटा देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bertanya dulu, lalu menghapus feed ini, unduhannya, dan apa yang tersisa dari unduhan yang Anda buang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chiede conferma, poi elimina questo feed, i suoi download e ciò che ha conservato dei download rimossi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "確認してから、このフィード、そのダウンロード、および削除したダウンロードの保持データを削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "먼저 확인한 다음 이 피드와 다운로드, 제거한 다운로드에서 남긴 항목을 삭제합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vraagt eerst om bevestiging en verwijdert dan deze feed, de downloads ervan en wat is bewaard van downloads die je hebt verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Najpierw pyta, potem usuwa ten kanał, jego pobrane pliki i to, co zachował po usuniętych pobraniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pergunta primeiro e depois exclui este feed, os downloads dele e o que guardou de downloads removidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сначала спрашивает, затем удаляет эту ленту, её загрузки и то, что осталось от удалённых вами загрузок."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Frågar först och raderar sedan det här flödet, dess nedladdningar och det som finns kvar av nedladdningar du har tagit bort."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ถามก่อน แล้วลบฟีดนี้ รายการดาวน์โหลดของฟีด และสิ่งที่เก็บไว้จากรายการดาวน์โหลดที่คุณนำออก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Önce sorar, sonra bu beslemeyi, indirmelerini ve kaldırdığınız indirmelerden sakladıklarını siler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Спочатку запитує, потім видаляє цю стрічку, її завантаження і те, що вона зберегла із вилучених вами завантажень."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پہلے پوچھتا ہے، پھر اس فیڈ کو، اس کے ڈاؤن لوڈز کو، اور ہٹائے گئے ڈاؤن لوڈز سے جو کچھ اس نے رکھا تھا اسے حذف کر دیتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hỏi trước, rồi xóa nguồn cấp này, các bản tải về của nó và những gì nó giữ lại từ bản tải về bạn đã gỡ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "先询问，然后删除此订阅源、其下载内容，以及你已移除的下载内容中保留的部分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "先詢問，然後刪除此訂閱源、其下載項目，以及你移除下載項目後所保留的內容。"
          }
        }
      }
    },
