          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "保存在此设备的钥匙串中，TextMouth 就不会再为此图书询问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "儲存在此裝置的鑰匙圈中，TextMouth 就不會再為這本書詢問。"
          }
