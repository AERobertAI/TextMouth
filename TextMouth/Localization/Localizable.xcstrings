        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I libri restano su questo Mac finché non rimuovi i loro download o macOS non ha bisogno di spazio."
          }
        }
      }
    },
    "Books with the same title, regardless of author" : {
