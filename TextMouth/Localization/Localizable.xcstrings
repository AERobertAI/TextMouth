    "feedItemMoveError.packageInBothPlaces" : {
      "comment" : "Why a downloaded feed item could not be moved between its feed's folder and the library: its files are in both folders. Lower case, without a full stop.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "توجد حزمة بالاسم نفسه في كل من مجلد المكتبة ومجلد الموجز"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এর নামের একটি প্যাকেজ লাইব্রেরি ফোল্ডার ও এর ফিডের ফোল্ডার, দুটিতেই আছে"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ein Paket mit seinem Namen liegt sowohl im Bibliotheksordner als auch im Ordner seines Feeds"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "a package of its name is in both its library folder and its feed's"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "hay un paquete con su nombre tanto en su carpeta de la biblioteca como en la de su canal"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بسته‌ای با نام آن هم در پوشه‌ی کتابخانه آن و هم در پوشه‌ی فید آن هست"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "un paquet de ce nom se trouve à la fois dans son dossier de la bibliothèque et dans celui de son flux"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "חבילה בשם שלו נמצאת גם בתיקיית הספרייה שלו וגם בתיקיית הערוץ שלו"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसके नाम का पैकेज इसके लाइब्रेरी फ़ोल्डर और इसके फ़ीड के फ़ोल्डर, दोनों में है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "paket dengan namanya ada di folder pustakanya maupun di folder feed-nya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "un pacchetto con il suo nome è sia nella sua cartella della libreria sia in quella del suo feed"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "同じ名前のパッケージが、ライブラリのフォルダとフィードのフォルダの両方にあります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "해당 이름의 패키지가 보관함 폴더와 피드 폴더 모두에 있음"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "een pakket met zijn naam staat zowel in de bibliotheekmap als in de map van de feed"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "pakiet o jego nazwie jest zarówno w folderze biblioteki, jak i w folderze jego kanału"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "há um pacote com o nome dele tanto na pasta da biblioteca quanto na do feed"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "пакет с таким именем есть и в папке библиотеки, и в папке ленты"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ett paket med dess namn finns i både dess biblioteksmapp och flödets"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "มีแพ็กเกจชื่อเดียวกันทั้งในโฟลเดอร์ไลบรารีและในโฟลเดอร์ของฟีด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "aynı adlı bir paket hem kitaplık klasöründe hem de beslemesinin klasöründe var"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "пакет з його назвою є і в папці бібліотеки, і в папці його стрічки"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس کے نام کا ایک پیکیج اس کے لائبریری فولڈر اور اس کی فیڈ کے فولڈر، دونوں میں ہے"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "một gói có tên của nó nằm trong cả thư mục thư viện của nó lẫn thư mục của nguồn cấp"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "资料库文件夹和订阅源的文件夹中都有同名的包"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "其書庫檔案夾與其訂閱源的檔案夾中都有同名的套件"
          }
        }
      }
    },
