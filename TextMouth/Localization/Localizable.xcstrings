    "Lists every article; nothing downloads by itself, and a download stays until you delete it or its days after playing pass." : {
      "comment" : "VoiceOver hint of the List and download choice for a feed of articles when the listener downloads by hand.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Listet jeden Artikel auf; nichts wird von selbst heruntergeladen, und ein Download bleibt, bis du ihn löschst oder die Tage nach der Wiedergabe vergangen sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Enumera todos los artículos; nada se descarga solo, y una descarga permanece hasta que la elimines o pasen sus días tras reproducirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Répertorie tous les articles ; rien ne se télécharge tout seul, et un téléchargement reste jusqu’à ce que vous le supprimiez ou que son délai après lecture soit écoulé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elenca ogni articolo; nulla viene scaricato da solo, e un download resta finché non lo elimini o non passano i giorni previsti dopo la riproduzione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lista todos os artigos; nada é baixado sozinho, e um download permanece até você excluí-lo ou os dias após a reprodução passarem."
          }
        }
      }
    },
