    "valueReader.amplitude" : {
      "comment" : "What a volume option of a filter accepts, said at the end of a refusal such as \"The volume filter's volume can't be “x”: <this>.\" Written without its full stop. The examples are filter syntax.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أدخل رقمًا، مثل 0.5، أو ديسيبل، مثل -6dB"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "একটি সংখ্যা দিন, যেমন 0.5, অথবা ডেসিবেল, যেমন -6dB"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "gib eine Zahl an, etwa 0.5, oder Dezibel, etwa -6dB"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "give a number, such as 0.5, or decibels, such as -6dB"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "indica un número, como 0.5, o decibelios, como -6dB"
          }
        },
