        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ برای تازه‌سازی خودکار منتظر شبکه‌ای بدون محدودیت داده می‌ماند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
