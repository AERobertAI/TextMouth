    "Books can be moved only in a folder sorted by %@, and this folder is not." : {
      "comment" : "First sentence of the announcement when Move Book Up or Move Book Down is used in a folder that is not in manual order. %@ is the name of the Manual Order sort.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يمكن نقل الكتب فقط في مجلد مرتب حسب %@، وهذا المجلد ليس كذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bücher lassen sich nur in einem Ordner verschieben, der nach %@ sortiert ist, und dieser Ordner ist es nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los libros solo se pueden mover en una carpeta ordenada por %@, y esta no lo está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les livres ne peuvent être déplacés que dans un dossier trié par %@, et ce dossier ne l’est pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पुस्तकें केवल %@ के अनुसार क्रमबद्ध फ़ोल्डर में ही ले जाई जा सकती हैं, और यह फ़ोल्डर वैसा नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Buku hanya dapat dipindahkan di folder yang diurutkan menurut %@, dan folder ini tidak demikian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I libri possono essere spostati solo in una cartella ordinata per %@, e questa cartella non lo è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブックを移動できるのは%@で並べ替えたフォルダのみで、このフォルダは該当しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책은 %@ 기준으로 정렬된 폴더에서만 이동할 수 있으며, 이 폴더는 그렇지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Os livros só podem ser movidos em uma pasta ordenada por %@, e esta não é."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Книги можно перемещать только в папке с сортировкой «%@», а эта папка отсортирована иначе."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Книги можна переміщувати лише в папці, відсортованій за критерієм «%@», а ця папка так не відсортована."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "仅当文件夹按 %@ 排序时才能移动图书，而此文件夹并非如此。"
          }
        }
      }
    },
    "Books can't be added while the library is moving." : {
      "comment" : "What a Library window says when a command that adds a book is chosen while the library is being moved.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يمكن إضافة كتب أثناء نقل المكتبة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "লাইব্রেরি স্থানান্তরের সময় বই যোগ করা যাবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bücher können nicht hinzugefügt werden, während die Bibliothek verschoben wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pueden agregar libros mientras se mueve la biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossible d’ajouter des livres pendant le déplacement de la bibliothèque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लाइब्रेरी स्थानांतरित होने के दौरान पुस्तकें नहीं जोड़ी जा सकतीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Buku tidak dapat ditambahkan saat pustaka sedang dipindahkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non è possibile aggiungere libri mentre la libreria viene spostata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ライブラリの移動中は、ブックを追加できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관함을 이동하는 중에는 책을 추가할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não é possível adicionar livros enquanto a biblioteca está sendo movida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Книги нельзя добавлять, пока библиотека перемещается."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Книги не можна додавати, поки бібліотеку переміщують."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "资料库正在移动时无法添加图书。"
          }
        }
      }
    },
    "Books can't be added while the library isn't available." : {
