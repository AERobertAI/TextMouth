        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইটির ফাইল এখনো এই Mac-এ আসেনি। %@ হয়তো এখনো সেগুলো সিঙ্ক করছে।"
          }
        },
        "de" : {
          "stringUnit" : {
