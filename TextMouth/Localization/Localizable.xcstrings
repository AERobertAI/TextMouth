    "refusedFormatAdvice.copyProtected" : {
      "comment" : "Advice after the refusal of audio that is locked to a store's own player, such as Audible's .aa and .aax files.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يستطيع TextMouth فتح الملفات المحمية من النسخ."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth কপি-সুরক্ষিত ফাইল খুলতে পারে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kann kopiergeschützte Dateien nicht öffnen."
          }
