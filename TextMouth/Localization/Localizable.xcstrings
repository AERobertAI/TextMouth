        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Удаляется %@: удалённое перемещается в Корзину, откуда его можно восстановить, пока Корзина не очищена."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
