    "Its %@ are kept for when you download it again." : {
      "comment" : "What VoiceOver says after Delete Download deleted a download whose package kept parts of the listener's. %@ is a list of what is kept, such as \"place and bookmarks\". The verb agrees with a list of several parts.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Für den Fall eines erneuten Downloads bleibt erhalten: %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para cuando la descargues de nuevo, se conservan: %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Conservés pour quand vous le téléchargerez de nouveau : %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फिर से डाउनलोड करने के लिए इसके ये अंश रखे गए हैं: %@।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ disimpan untuk saat Anda mengunduhnya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Conservati per quando lo scarichi di nuovo: %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "もう一度ダウンロードするときのために、%@が保持されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@은(는) 다시 다운로드할 때를 위해 유지됩니다."
          }
        },
        "pt-BR" : {
