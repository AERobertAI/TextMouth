    "Could not add the bookmark: “%@” is no longer in the library." : {
      "comment" : "VoiceOver announcement when a bookmark could not be added because the book left the library while its reader was open. %@ is the book's title, in quotation marks.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lesezeichen konnte nicht hinzugefügt werden: „%@“ ist nicht mehr in der Bibliothek."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo agregar el marcador: “%@” ya no está en la biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossible d’ajouter le signet : « %@ » n’est plus dans la bibliothèque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "बुकमार्क जोड़ा नहीं जा सका: “%@” अब लाइब्रेरी में नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tidak dapat menambahkan markah: “%@” tidak lagi ada di pustaka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile aggiungere il segnalibro: “%@” non è più nella libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブックマークを追加できませんでした：「%@」はライブラリにありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "북마크를 추가하지 못했습니다. “%@”이(가) 더 이상 보관함에 없습니다."
          }
