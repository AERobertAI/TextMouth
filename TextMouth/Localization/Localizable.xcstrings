    "in the reading list" : {
      "comment" : "Library view editor: a condition inside a filter's description: the item is in the Reading List.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "en la lista de lectura"
          }
        }
