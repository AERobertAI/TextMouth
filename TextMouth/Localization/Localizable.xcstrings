      }
    },
    "The refused text began before this passage, at character %@." : {
      "comment" : "A line of the speech refusal report: the refused text began before the passage shown. %@ is the character offset where it began, written without digit grouping.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto rechazado empezó antes de este pasaje, en el carácter %@."
