    "libraryViewsSettings.deleteBuiltInHint" : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). Delete…'s hint for a built-in view, when it is dimmed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يمكن إخفاء العرض المدمج، لكن لا يمكن حذفه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "অন্তর্নির্মিত ভিউ লুকানো যায়, মুছে ফেলা যায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eine integrierte Ansicht lässt sich ausblenden, aber nicht löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A built-in view can be hidden, not deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una vista integrada se puede ocultar, no eliminar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نمای داخلی را می‌توان پنهان کرد، اما نمی‌توان حذف کرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une vue intégrée peut être masquée, mais pas supprimée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אפשר להסתיר תצוגה מובנית, אבל לא למחוק אותה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "अंतर्निर्मित दृश्य को छिपाया जा सकता है, मिटाया नहीं जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tampilan bawaan dapat disembunyikan, tetapi tidak dapat dihapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una vista integrata può essere nascosta, non eliminata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "組み込みのビューは、非表示にできますが、削除はできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "기본 제공 보기는 숨길 수 있지만 삭제할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Een ingebouwde weergave kan worden verborgen, niet verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Widok wbudowany można ukryć, ale nie można go usunąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uma visualização integrada pode ser ocultada, mas não excluída."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Встроенное представление можно скрыть, но нельзя удалить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En inbyggd vy kan döljas men inte raderas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "มุมมองในตัวซ่อนได้ แต่ลบไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yerleşik bir görünüm gizlenebilir, silinemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вбудований вигляд можна приховати, але не видалити."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بلٹ ان منظر کو چھپایا جا سکتا ہے، حذف نہیں کیا جا سکتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Có thể ẩn chế độ xem tích hợp sẵn, nhưng không thể xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "内置视图可以隐藏，但无法删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "內建的顯示方式可以隱藏，但不能刪除。"
          }
        }
      }
    },
    "libraryViewsSettings.deleteHint" : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). Delete…'s hint.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحذف العرض. يبقى ما يسرده في المكتبة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ভিউ মুছে ফেলে। এটি যা তালিকাভুক্ত করত তা লাইব্রেরিতেই থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Löscht die Ansicht. Was sie auflistet, bleibt in der Bibliothek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes the view. What it lists stays in the library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elimina la vista. Lo que muestra permanece en la biblioteca."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نما را حذف می‌کند. آنچه فهرست می‌کند در کتابخانه می‌ماند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Supprime la vue. Ce qu’elle liste reste dans la bibliothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מוחק את התצוגה. מה שהיא מציגה נשאר בספרייה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "दृश्य को मिटाता है। वह जो सूचीबद्ध करता है, लाइब्रेरी में रहता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menghapus tampilan. Isinya tetap ada di pustaka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elimina la vista. Ciò che elenca resta nella libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ビューを削除します。ビューに表示されていた内容はライブラリに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보기를 삭제합니다. 보기에 나열되던 항목은 보관함에 그대로 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Verwijdert de weergave. Wat erin staat, blijft in de bibliotheek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usuwa widok. To, co wyświetlał, zostaje w bibliotece."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Exclui a visualização. O que ela lista permanece na biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Удаляет представление. То, что оно показывает, остаётся в библиотеке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Raderar vyn. Det den listar finns kvar i biblioteket."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ลบมุมมอง สิ่งที่มุมมองแสดงจะยังอยู่ในไลบรารี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Görünümü siler. Listelediği öğeler kitaplıkta kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Видаляє вигляд. Те, що він показує, залишається в бібліотеці."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "منظر کو حذف کرتا ہے۔ جو کچھ یہ دکھاتا ہے، وہ لائبریری میں رہتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Xóa chế độ xem. Nội dung nó liệt kê vẫn còn trong thư viện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "删除此视图。其列出的内容仍保留在资料库中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "刪除這個顯示方式。它所列出的內容仍會留在書庫中。"
          }
        }
      }
    },
    "libraryViewsSettings.deleteMessage" : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). What the question says Delete does, and what it keeps.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تُحذف شروطه وترتيبه. تبقى الكتب والحلقات والمقالات والموجزات التي يسردها في المكتبة، وتعرض نافذة المكتبة التي تعرضه عرضًا آخر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এর শর্ত ও সাজানো মুছে ফেলা হয়। এটি যে বই, পর্ব, নিবন্ধ ও ফিড তালিকাভুক্ত করত তা লাইব্রেরিতেই থাকে, আর এটি দেখাচ্ছে এমন লাইব্রেরি উইন্ডো অন্য একটি ভিউ দেখায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ihre Bedingungen und ihre Sortierung werden gelöscht. Die Bücher, Folgen, Artikel und Feeds, die sie auflistet, bleiben in der Bibliothek, und ein Bibliotheksfenster, das sie zeigt, zeigt eine andere Ansicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its conditions and sort are deleted. The books, episodes, articles, and feeds it lists stay in the library, and a Library window showing it shows another view."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se eliminan sus condiciones y su orden. Los libros, episodios, artículos y canales que muestra permanecen en la biblioteca, y una ventana de la biblioteca que la muestre pasa a mostrar otra vista."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "شرط‌ها و مرتب‌سازی آن حذف می‌شوند. کتاب‌ها، قسمت‌ها، مقاله‌ها و فیدهایی که فهرست می‌کند در کتابخانه می‌مانند و پنجره‌ی کتابخانه‌ای که آن را نشان می‌دهد، نمای دیگری نشان می‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ses conditions et son tri sont supprimés. Les livres, épisodes, articles et flux qu’elle liste restent dans la bibliothèque, et une fenêtre de bibliothèque qui l’affiche passe à une autre vue."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "התנאים והמיון שלה נמחקים. הספרים, האפיזודות, הכתבות והערוצים שהיא מציגה נשארים בספרייה, וחלון ספרייה שמציג אותה יציג תצוגה אחרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसकी शर्तें और क्रम मिटा दिए जाते हैं। जो पुस्तकें, एपिसोड, लेख और फ़ीड यह सूचीबद्ध करता है वे लाइब्रेरी में रहते हैं, और इसे दिखाने वाली लाइब्रेरी विंडो दूसरा दृश्य दिखाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kondisi dan urutannya dihapus. Buku, episode, artikel, dan feed yang dicantumkannya tetap ada di pustaka, dan jendela Pustaka yang menampilkannya akan menampilkan tampilan lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le sue condizioni e il suo ordinamento vengono eliminati. I libri, gli episodi, gli articoli e i feed che elenca restano nella libreria, e una finestra della libreria che la mostra ne mostra un’altra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "条件と並べ替えは削除されます。ビューに表示されていたブック、エピソード、記事、フィードはライブラリに残り、このビューを表示していたライブラリウインドウには別のビューが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "조건과 정렬이 삭제됩니다. 보기에 나열된 책, 에피소드, 기사, 피드는 보관함에 그대로 남으며, 이 보기를 표시하던 보관함 윈도우는 다른 보기를 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De voorwaarden en sortering ervan worden verwijderd. De boeken, afleveringen, artikelen en feeds die erin staan, blijven in de bibliotheek, en een bibliotheekvenster met deze weergave toont dan een andere."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jego warunki i sortowanie zostaną usunięte. Książki, odcinki, artykuły i kanały, które wyświetla, zostają w bibliotece, a okno biblioteki, które go pokazuje, pokaże inny widok."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Suas condições e ordem são excluídas. Os livros, episódios, artigos e feeds que ela lista permanecem na biblioteca, e uma janela da biblioteca que a exibe passa a exibir outra visualização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Его условия и сортировка удаляются. Книги, выпуски, статьи и ленты, которые оно показывает, остаются в библиотеке, а окно библиотеки, показывающее его, покажет другое представление."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dess villkor och sortering raderas. Böckerna, avsnitten, artiklarna och flödena som den listar finns kvar i biblioteket, och ett biblioteksfönster som visar den visar i stället en annan vy."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เงื่อนไขและการเรียงลำดับของมุมมองจะถูกลบ หนังสือ ตอน บทความ และฟีดที่มุมมองแสดงจะยังอยู่ในไลบรารี และหน้าต่างไลบรารีที่แสดงมุมมองนี้จะแสดงมุมมองอื่นแทน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Koşulları ve sıralaması silinir. Listelediği kitaplar, podcast bölümleri, makaleler ve beslemeler kitaplıkta kalır; onu gösteren bir Kitaplık penceresi başka bir görünüm gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Його умови та сортування видаляються. Книги, епізоди, статті та стрічки, які він показує, залишаються в бібліотеці, а вікно бібліотеки, що його показувало, покаже інший вигляд."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس کی شرائط اور ترتیب حذف ہو جاتی ہیں۔ جن کتابوں، ایپی سوڈز، مضامین اور فیڈز کی یہ فہرست دیتا ہے وہ لائبریری میں رہتی ہیں، اور اسے دکھانے والی لائبریری ونڈو کوئی دوسرا منظر دکھاتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Các điều kiện và cách sắp xếp của nó sẽ bị xóa. Sách, tập, bài viết và nguồn cấp mà nó liệt kê vẫn còn trong thư viện, và cửa sổ Thư viện đang hiển thị nó sẽ chuyển sang chế độ xem khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "其条件和排序会被删除。它列出的图书、单集、文章和订阅源仍保留在资料库中，显示它的资料库窗口会改为显示另一个视图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "它的條件和排序會被刪除。它所列出的書籍、單集、文章和訂閱源仍會留在書庫中，顯示它的書庫視窗會改為顯示另一個顯示方式。"
          }
        }
      }
    },
