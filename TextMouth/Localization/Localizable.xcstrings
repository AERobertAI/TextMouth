          "stringUnit" : {
            "state" : "new",
            "value" : "Skipped, %1$@ (current heading) - level %2$lld"
          }
        }
      }
    },
    "Skipped, %@ - level %lld" : {
      "comment" : "What VoiceOver says for a heading the user skipped, in the headings list. %1$@ is the heading's text; %2$lld is its level, 1 for the biggest heading.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Skipped, %1$@ - level %2$lld"
          }
        }
      }
    },
    "Skips matches next to letters, digits, or underscores" : {
      "comment" : "VoiceOver hint of the Match whole word only switch in the substitution rule editor."
    },
    "Slash" : {
      "comment" : "Name of the punctuation key \"/\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Slash\"."
    },
    "Sleep Timer" : {
      "comment" : "Heading of the sleep timer group in the Playback settings.\nThe name of the sleep timer, wherever it is named: the title of its sheet over a book's reader (read by VoiceOver as its heading), the reader's Sleep Timer toolbar button, and the heading of its defaults in Settings.\nTitle of the reader toolbar's button that opens the sleep timer sheet.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Temporizador de apagado"
          }
        }
      }
    },
    "Sleep timer" : {
      "comment" : "What VoiceOver calls the reader toolbar's button that opens the sleep timer sheet."
    },
    "Sleep timer cancelled, because the next book could not be opened." : {
      "comment" : "VoiceOver announcement, after the reason a book failed to open: the sleep timer that was to go on with that book has stopped.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Temporizador de apagado cancelado, porque no se pudo abrir el siguiente libro."
          }
        }
      }
    },
    "Sleep timer cancelled, because you moved to another book while it faded out." : {
      "comment" : "VoiceOver announcement after \"Starting: <title>\": moving to another book while the sleep timer was fading the sound out ended the timer.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Temporizador de apagado cancelado, porque pasaste a otro libro mientras bajaba el volumen."
          }
        }
      }
    },
    "Sleep timer cancelled." : {
      "comment" : "VoiceOver announcement after the Cancel Timer button stopped the sleep timer.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Temporizador de apagado cancelado."
          }
        }
      }
    },
    "Sleep timer expired" : {
      "comment" : "A sentence of the announcement as a book ends, after \"Finished: <title>.\": the sleep timer stopped playback there. Written without its full stop, which is added after it.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El temporizador de apagado terminó"
          }
        }
      }
    },
    "Sleep timer expired at the end of the heading. Playback paused." : {
      "comment" : "VoiceOver announcement as a sleep timer set to End of heading pauses the book where the heading ends.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El temporizador de apagado terminó al final del encabezado. Reproducción en pausa."
          }
        }
      }
    },
    "Sleep timer expired. Playback paused." : {
      "comment" : "VoiceOver announcement as a sleep timer of so many minutes runs out and pauses the book.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El temporizador de apagado terminó. Reproducción en pausa."
          }
        }
      }
    },
    "Sleep timer: %@" : {
      "comment" : "VoiceOver label of the sleep timer's status in the reader and the sleep timer sheet. %@ is the timer's state, such as \"4:59 remaining\" or \"stops at the end of this heading\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Temporizador de apagado: %@"
          }
        }
      }
    },
    "Sleep timer: %@." : {
      "comment" : "VoiceOver announcement after a sleep timer that stops at a place was set. %@ says where it stops, such as \"stops at the end of this heading\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Temporizador de apagado: %@."
          }
        }
      }
    },
    "Sleep timer: %lld minutes remaining" : {
      "comment" : "VoiceOver announcement as the sleep timer's countdown passes a milestone. %lld is the whole minutes left (5 or 1).",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
