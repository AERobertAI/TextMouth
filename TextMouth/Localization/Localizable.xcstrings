    "recording.discardHint" : {
      "comment" : "VoiceOver hint of the Discard Recording button of the Record window.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحذف التسجيل دون حفظه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সংরক্ষণ না করেই রেকর্ডিং মুছে ফেলে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
