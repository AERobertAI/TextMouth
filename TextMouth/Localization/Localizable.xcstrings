    "The original at %@ is a folder or link, so a copy of it cannot be checked." : {
      "comment" : "Why a book could not move into the current library format. %@ is the path of the original.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "الأصل في %@ مجلد أو رابط، لذا لا يمكن التحقق من نسخة منه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@-এর আসলটি একটি ফোল্ডার বা লিঙ্ক, তাই এর কপি যাচাই করা যায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Original unter %@ ist ein Ordner oder eine Verknüpfung, daher kann keine Kopie davon geprüft werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El original de %@ es una carpeta o un enlace, así que no se puede comprobar una copia suya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’original dans %@ est un dossier ou un lien ; une copie ne peut donc pas être vérifiée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ पर मूल एक फ़ोल्डर या लिंक है, इसलिए उसकी प्रति की जाँच नहीं की जा सकती।"
          }
        },
        "id" : {
          "stringUnit" : {
