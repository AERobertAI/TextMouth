    "bookExportDeepChapter.exportAllAsWrittenHint" : {
      "comment" : "The hint of the Export Every Such Chapter as Written button in the alert an export shows when a chapter nests too deeply.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يكتب هذا الفصل وكل فصل آخر متداخل بعمق مفرط في هذا التصدير فقرات عادية من أسطره، دون أن يسأل مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই রপ্তানির এই অধ্যায় এবং অতিরিক্ত গভীরে নেস্ট করা অন্য প্রতিটি অধ্যায় লাইনগুলোর সাধারণ অনুচ্ছেদ হিসেবে লেখে, আবার জিজ্ঞেস না করেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Schreibt dieses und jedes andere zu tief verschachtelte Kapitel dieses Exports als einfache Absätze aus Zeilen, ohne erneut zu fragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writes this and every other too-deeply nested chapter of this export as plain paragraphs of lines, without asking again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escribe este y cualquier otro capítulo de esta exportación con un anidamiento demasiado profundo como párrafos simples de líneas, sin volver a preguntar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "این فصل و هر فصل تو در توی بیش‌ازحد دیگر این صادر کردن را بدون پرسش دوباره، به‌صورت پاراگراف‌های ساده از خطوط می‌نویسد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Écrit ce chapitre et tous les autres chapitres trop imbriqués de cette exportation en paragraphes simples de lignes, sans redemander."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כותב את הפרק הזה ואת כל פרק אחר שמקונן עמוק מדי בייצוא הזה כפסקאות פשוטות של שורות, בלי לשאול שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस निर्यात के इस और हर दूसरे बहुत गहराई तक नेस्टेड अध्याय को बिना दोबारा पूछे पंक्तियों के सादे अनुच्छेदों के रूप में लिखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menulis bab ini dan setiap bab lain dalam ekspor ini yang bertingkat terlalu dalam sebagai paragraf biasa dari baris, tanpa bertanya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scrive questo e ogni altro capitolo troppo annidato di questa esportazione come semplici paragrafi di righe, senza chiedere di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "この章と、この書き出しの入れ子が深すぎる他のすべての章を、行ごとの通常の段落として、あらためて確認せずに書き出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 챕터를 포함해 너무 깊게 중첩된 이번 내보내기의 모든 챕터를 다시 묻지 않고 줄 단위의 일반 단락으로 작성합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Schrijft de regels van dit en elk ander te diep genest hoofdstuk van deze export als gewone alinea's, zonder opnieuw te vragen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zapisuje ten i każdy inny zbyt głęboko zagnieżdżony rozdział tego eksportu jako zwykłe akapity z wierszy, bez ponownego pytania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Grava este e todos os outros capítulos com aninhamento profundo demais desta exportação como parágrafos simples de linhas, sem perguntar de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Записывает эту и каждую другую слишком глубоко вложенную главу этого экспорта обычными абзацами из строк, не спрашивая снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Skriver det här och alla andra för djupt nästlade kapitel i den här exporten som vanliga stycken av rader, utan att fråga igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เขียนบทนี้และบทอื่น ๆ ทุกบทที่ซ้อนกันลึกเกินไปในการส่งออกนี้เป็นย่อหน้าธรรมดาตามบรรทัด โดยไม่ถามอีก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu dışa aktarmadaki bu ve çok derin iç içe geçen diğer her bölümü, tekrar sormadan satırlarından oluşan düz paragraflar olarak yazar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Записує цей і кожен інший надто вкладений розділ цього експорту звичайними абзацами з рядків без повторних запитів."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس برآمد کے اس باب اور ہر دوسرے حد سے زیادہ تہہ دار باب کو سطروں کے سادہ پیراگرافوں کی صورت میں لکھتا ہے، دوبارہ پوچھے بغیر۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ghi chương này và mọi chương lồng ghép quá sâu khác của lần xuất này thành các đoạn văn thường gồm các dòng, không hỏi lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "将此章节和此次导出中其他所有嵌套过深的章节都写成由各行组成的普通段落，不再询问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
