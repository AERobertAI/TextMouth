        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quitar %@ de la biblioteca"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "برداشتن %@ از کتابخانه"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Retirer %@ de la bibliothèque"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הסר %@ מהספרייה"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ लाइब्रेरी से हटाएँ"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Buang %@ dari pustaka"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
