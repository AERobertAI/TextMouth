    "endOfBook.nextEpisodeDownloadCancelled" : {
      "comment" : "VoiceOver announcement when the listener cancelled the download of a feed's next episode or article, which playback was waiting for.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أُلغي التنزيل، لذا توقف التشغيل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ডাউনলোড বাতিল হয়েছে, তাই প্লেব্যাক থেমে গেছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Download abgebrochen, daher wurde die Wiedergabe gestoppt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download cancelled, so playback stopped."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Descarga cancelada, así que la reproducción se detuvo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بارگیری لغو شد، بنابراین پخش متوقف شد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Téléchargement annulé, la lecture s’est donc arrêtée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ההורדה בוטלה, ולכן הניגון נעצר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "डाउनलोड रद्द किया गया, इसलिए प्लेबैक रुक गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pengunduhan dibatalkan, jadi pemutaran berhenti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Download annullato, quindi la riproduzione si è interrotta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ダウンロードをキャンセルしたため、再生を停止しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "다운로드가 취소되어 재생이 중지되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Download geannuleerd, dus het afspelen is gestopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pobieranie anulowano, więc odtwarzanie zatrzymano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O download foi cancelado, então a reprodução parou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Загрузка отменена, воспроизведение остановлено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nedladdningen avbröts, så uppspelningen stoppades."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ยกเลิกการดาวน์โหลดแล้ว การเล่นจึงหยุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "İndirme iptal edildi, bu yüzden oynatma durdu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Завантаження скасовано, тому відтворення зупинено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ڈاؤن لوڈ منسوخ ہو گیا، اس لیے پلے بیک رک گیا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đã hủy tải về nên quá trình phát đã dừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "下载已取消，播放已停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "下載已取消，因此播放已停止。"
          }
        }
      }
    },
    "endOfBook.nextEpisodeNotDownloaded.article" : {
      "comment" : "VoiceOver announcement when the download of a feed's next article failed. %@ is the download's own sentence saying why.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّر تنزيل المقالة التالية، لذا توقف التشغيل. %@"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
