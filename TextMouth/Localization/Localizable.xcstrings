    "transcriptCleanupError.transcriptUnavailable" : {
      "comment" : "Error shown when Clean Up Transcript cannot read the transcript.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّرت قراءة النسخة النصية. إذا كان الكتاب في السحابة فقط، فنزّله وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ট্রান্সক্রিপ্ট পড়া যাচ্ছে না। বইটি শুধু ক্লাউডে থাকলে ডাউনলোড করুন এবং আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript kann nicht gelesen werden. Wenn das Buch nur in der Cloud ist, lade es herunter und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
