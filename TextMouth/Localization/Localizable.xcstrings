    "The %@ starts %@ into “%@”, before the earlier %@, which starts %@ in." : {
      "comment" : "First sentence of why an audiobook could not be imported: a section starts before another section that comes earlier in the book and is in the same audio file. %1$@ and %4$@ are sections, such as \"heading “Tide Tables”\" or \"untitled heading 3\" (masculine noun phrases in English, without their article); %2$@ and %5$@ are how far into the file each starts, spoken times; %3$@ is the file's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يبدأ %1$@ عند %2$@ من “%3$@”، قبل %4$@ الأسبق الذي يبدأ عند %5$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die %1$@ beginnt bei %2$@ in der Datei „%3$@“, vor der früheren %4$@, die bei %5$@ beginnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The %1$@ starts %2$@ into “%3$@”, before the earlier %4$@, which starts %5$@ in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El %1$@ empieza %2$@ después del inicio de “%3$@”, antes del %4$@ anterior, que empieza %5$@ después del inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pour la section (%1$@), le début se situe à %2$@ dans « %3$@ », avant la section précédente (%4$@), qui commence à %5$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ की शुरुआत “%3$@” में %2$@ पर है, जो पहले आने वाले %4$@ से पहले है; उसकी शुरुआत %5$@ पर है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bagian dengan %1$@ dimulai %2$@ setelah awal “%3$@”, sebelum %4$@ yang lebih awal, yang dimulai %5$@ setelah awal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’%@ inizia a %@ dall’inizio di “%@”, prima dell’%@ precedente, che inizia a %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@は「%3$@」の%2$@の位置から始まっていますが、それより前にある%4$@（%5$@の位置から始まる）より前になっています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@은(는) “%3$@”의 %2$@ 지점에서 시작하는데, 그보다 앞에 있는 %4$@은(는) %5$@ 지점에서 시작합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O %1$@ começa aos %2$@ de “%3$@”, antes do %4$@ anterior, que começa aos %5$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В аудиокниге %1$@ начинается на отметке %2$@ файла «%3$@», то есть раньше, чем %4$@, который идёт в книге раньше и начинается на отметке %5$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ починається через %2$@ від початку файлу «%3$@», хоча раніше в книзі йде %4$@, що починається через %5$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
