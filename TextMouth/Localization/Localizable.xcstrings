      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Navigation group and read by VoiceOver. Goes to the previous book in the same folder or feed. Also the title of the menu command of the same name."
    },
    "Previous in Reading List" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Navigation group and read by VoiceOver. Opens the previous book in the reading list. Also the title of the menu command of the same name."
    },
    "Previous paragraph" : {
      "comment" : "Announcement after the reader moved to the previous paragraph."
    },
    "Previous section" : {
      "comment" : "Announcement after a sentence or paragraph move crossed into the previous section of the book, when no heading names it."
    },
    "Previous sentence" : {
      "comment" : "Announcement after the reader moved to the previous sentence."
