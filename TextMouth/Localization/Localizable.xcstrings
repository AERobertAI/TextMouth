    "Add to Reading List" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Library group and read by VoiceOver. Adds the selected books to the end of the reading list. Also the title of the menu command of the same name."
    },
    "Added %@" : {
      "comment" : "Speak Info: the part of a book's full summary that says when it was added. %@ is a date or time, such as \"today\" or \"3 days ago\"."
    },
    "Added %@, %lld of %lld." : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. What VoiceOver says once a new view is added, with its place. Placeholders in order: name, number, count.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Added %1$@, %2$lld of %3$lld."
          }
        }
      }
    },
    "Added %lld books to the reading list." : {
      "comment" : "VoiceOver announcement after several books were added to the reading list. %lld is the number of books added.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se agregaron %lld libros a la lista de lectura."
          }
        }
      }
    },
    "Added Last" : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. A limit's order as its pop-up names it. This is the case .dateAdded."
    },
    "Added to reading list: %@" : {
      "comment" : "VoiceOver announcement after one book was added to the reading list. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Agregado a la lista de lectura: %@"
          }
        }
      }
    },
    "Address %@" : {
      "comment" : "Speak Info: the part of a feed's full summary that gives its web address. %@ is the address."
    },
    "Adds or removes a bookmark at the current position" : {
      "comment" : "VoiceOver hint of the Show bookmark button checkbox in the Playback settings."
    },
    "Adds speed buttons and the current speed" : {
      "comment" : "VoiceOver hint of the Show speed controls checkbox in the Playback settings."
    },
    "Adds the page, such as Page 12 of 300, to Where Am I?'s summaries, for books of more than one page." : {
      "comment" : "Hint and caption of the Playback setting that adds the page to Where Am I?, a command that says where the reader is. \"Page 12 of 300\" is an example of how the page is said."
    },
    "Adds the selected books to the end of the reading list." : {
      "comment" : "VoiceOver hint of the Library's edit-mode bar button Add to Reading List.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Agrega los libros seleccionados al final de la lista de lectura."
          }
        }
      }
    },
    "Adds the speed they count at, such as 2.0x for an audiobook not at 1x, or 500 words a minute for a text book, in the reader, Where Am I?, Copy Reading Position, and the Headings sheet's durations." : {
      "comment" : "Hint and caption of the Playback setting that names the speed beside times. 2.0x and 500 are examples; Where Am I?, Copy Reading Position and the Headings sheet are names of commands and a sheet in the app."
    },
    "Adjust minutes" : {
      "comment" : "VoiceOver label of the stepper beside the sleep timer sheet's custom minutes field.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ajustar minutos"
          }
        }
      }
    },
    "Album" : {
      "comment" : "Name of the book information sheet's field for an audiobook's album."
    },
    "Album name" : {
      "comment" : "What VoiceOver says for the book information sheet's field for an audiobook's album."
    },
    "All" : {
      "comment" : "A choice of the Language pop-up in the Voice settings: voices of every language are offered.\nChoice of the voice sheet's language menu that lists the voices of every language."
    },
    "All Conditions" : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. A match as its pop-up names it. This is the form for the first case of the condition."
    },
    "All books by the same author" : {
      "comment" : "Hint of the Same Author criterion of Find Duplicate Books."
    },
    "All levels" : {
      "comment" : "Choice of the headings sheet's level filter that shows every level."
    },
    "Also write to the library's copy of the EPUB file" : {
      "comment" : "Label of the metadata editor's switch that also writes the edited title, author, publisher and date into the library's own copy of the book's EPUB file."
    },
    "Always" : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). A visibility as the Visibility pop-up names it: \"Always\", \"When Applicable\", or \"Hidden\". This is the case .always."
    },
    "Always offers a view all the time. When Applicable offers it only while it lists something: the Reading List while it holds a book, an episode, or an article, and Feeds while there is a feed. Hidden leaves it out. A window showing a view keeps it until you choose another." : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). What the three visibilities do, and that a window keeps its view."
    },
    "Ampersand" : {
      "comment" : "Name of the punctuation key \"&\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Ampersand\"."
    },
    "An edit of its text is kept beside the new reading, as a copy in the book's package." : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. What a re-read does to text TextMouth did not write, said only for a book whose content.md holds such text: an edit made with Edit Text, or a save no edit took, either kept as Replace Existing keeps it (ImportDecisionWording.replacingKeepsTextSentence)."
    },
    "An unknown error occurred." : {
      "comment" : "Message of an alert about a problem, when nothing more is known about it."
    },
    "And %lld more files couldn't be read." : {
      "comment" : "Last line of the list of unread files in Compare Libraries when the list is cut short. %lld is how many more files could not be read, a count.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "And %lld more file couldn't be read."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "And %lld more files couldn't be read."
                }
              }
            }
          }
        }
      }
    },
    "Announce level every %lld seconds" : {
      "comment" : "Title of the switch in the Record window that makes VoiceOver speak the microphone level while recording. %lld is how many seconds pass between announcements.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Announce level every %lld second"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Announce level every %lld seconds"
                }
              }
            }
          }
        }
      }
    },
    "Another view is already named %@. Choose another name." : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. Save's problem with a name another view has. Placeholders in order: name."
    },
    "Another view is named %@. Rename it first, then restore this view." : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). What Restore Default says, changing nothing, when another view has the shipped name name (finding 5). Placeholders in order: name."
    },
    "Any Condition" : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. A match as its pop-up names it. This is the form for the other case of the condition."
    },
    "Any other book passes over The, A, and An." : {
      "comment" : "Second sentence of the note under the Leading Articles pop-up: the articles skipped for a book in any other language. The, A, and An are the English articles and stay as written."
    },
    "Apostrophe" : {
      "comment" : "Name of the punctuation key \"'\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Apostrophe\"."
    },
    "Appends a new step to the gesture sequence" : {
      "comment" : "VoiceOver hint of the Add gesture step button in the Miscellaneous settings."
    },
    "Applies only to a view that lists episodes or articles." : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. Its hint while the view lists no episodes or articles, when it is dimmed (review of October 31, 2026, finding 6)."
    },
    "Applies the rules to text before it is spoken" : {
      "comment" : "VoiceOver hint of the Enable text substitutions switch in the Substitutions settings."
    },
    "Apply Filter…" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Opens the choice of audio filters to apply to the selection."
    },
    "Articles" : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. A kind of row as its checkbox names it: \"Books\", \"Episodes\", \"Articles\", or \"Feeds\". This is the case .articles."
    },
    "Articles (%lld)" : {
      "comment" : "The header of a list's news articles, with their count: \"Articles (3)\". %lld is the number of articles.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
