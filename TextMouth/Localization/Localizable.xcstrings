    "These books could not be deleted and remain in the library:" : {
      "comment" : "Heading over the books that could not be deleted permanently, several of them. One line for each book follows.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذر حذف هذه الكتب وهي باقية في المكتبة:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Diese Bücher konnten nicht gelöscht werden und bleiben in der Bibliothek:"
          }
