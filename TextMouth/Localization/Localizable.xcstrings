    "pageImage.unreadableKind" : {
      "comment" : "Why a picture was refused at import: a kind of picture the system knows but TextMouth does not decode. %@ is the system's description of the kind, such as \"DNG image\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يستطيع TextMouth قراءة هذا النوع من الصور (%@). احفظها بصيغة PNG أو JPEG، ثم استورد تلك النسخة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth এই ধরনের ছবি পড়তে পারে না (%@)। এটি PNG বা JPEG হিসেবে সংরক্ষণ করুন, তারপর সেই কপি আমদানি করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kann diese Bildart nicht lesen (%@). Sichere das Bild als PNG oder JPEG und importiere dann diese Kopie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth can't read this kind of picture (%@). Save it as a PNG or JPEG, then import that copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede leer este tipo de imagen (%@). Guárdala como PNG o JPEG y luego importa esa copia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth نمی‌تواند این نوع تصویر (%@) را بخواند. آن را به‌صورت PNG یا JPEG ذخیره کنید، سپس آن نسخه را وارد کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ne peut pas lire ce type d’image (%@). Enregistrez-la en PNG ou JPEG, puis importez cette copie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth לא יכול לקרוא סוג תמונה זה (%@). שמור אותה כ-PNG או JPEG, ואז ייבא את העותק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth इस प्रकार का चित्र नहीं पढ़ सकता (%@)। उसे PNG या JPEG के रूप में सहेजें, फिर उस प्रति को आयात करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tidak dapat membaca jenis gambar ini (%@). Simpan sebagai PNG atau JPEG, lalu impor salinan itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non può leggere questo tipo di immagine (%@). Salvala come PNG o JPEG, poi importa quella copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は、この種類の画像（%@）を読み取れません。PNG または JPEG として保存してから、そのコピーを読み込んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 이 종류의 이미지(%@)를 읽을 수 없습니다. PNG 또는 JPEG으로 저장한 다음 그 사본을 가져오십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kan dit soort afbeelding niet lezen (%@). Bewaar de afbeelding als PNG of JPEG en importeer die kopie dan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth nie może odczytać tego rodzaju obrazu (%@). Zachowaj go jako PNG lub JPEG, a potem zaimportuj tę kopię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não consegue ler este tipo de imagem (%@). Salve-a como PNG ou JPEG e depois importe essa cópia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не может прочитать такое изображение (%@). Сохраните его как PNG или JPEG и импортируйте эту копию."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kan inte läsa den här typen av bild (%@). Spara den som PNG eller JPEG och importera sedan den kopian."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth อ่านรูปภาพชนิดนี้ไม่ได้ (%@) บันทึกเป็น PNG หรือ JPEG แล้วนำเข้าสำเนานั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth bu tür resmi okuyamıyor (%@). PNG veya JPEG olarak kaydedin, sonra o kopyayı içe aktarın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не може прочитати цей тип зображення (%@). Збережіть його як PNG або JPEG, а потім імпортуйте цю копію."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth اس قسم کی تصویر (%@) نہیں پڑھ سکتا۔ اسے PNG یا JPEG کے طور پر محفوظ کریں، پھر اس کاپی کو درآمد کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth không đọc được loại ảnh này (%@). Hãy lưu nó thành PNG hoặc JPEG, rồi nhập bản sao đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 无法读取这种图片（%@）。请将其存储为 PNG 或 JPEG，然后导入该副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 無法讀取這種圖片（%@）。請將其儲存為 PNG 或 JPEG，然後輸入該副本。"
          }
        }
      }
    },
