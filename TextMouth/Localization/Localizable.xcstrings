          }
        }
      }
    },
    "TextMouth's converter could not make itself safe before reading “%@”, so it did not read the file." : {
      "comment" : "Why a file was not imported: TextMouth's converter could not confine itself before reading it, so it did not read the file. %@ is the file's name. Advice to install the app again follows.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Umwandlungsprogramm von TextMouth konnte sich vor dem Lesen von „%@“ nicht absichern und hat die Datei daher nicht gelesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El conversor de TextMouth no pudo protegerse antes de leer “%@”, así que no leyó el archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le convertisseur de TextMouth n’a pas pu se sécuriser avant de lire « %@ », donc il n’a pas lu le fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il convertitore di TextMouth non ha potuto proteggersi prima di leggere «%@», quindi non ha letto il file."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O conversor do TextMouth não conseguiu se proteger antes de ler “%@”, então não leu o arquivo."
          }
        }
      }
    },
    "TextMouth's converter gave back audio of “%@” that TextMouth could not read." : {
      "comment" : "Why a file was not imported: what TextMouth's converter gave back was not audio TextMouth reads, which only a damaged copy of the app could make. %@ is the file's name. Advice to install the app again follows.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
