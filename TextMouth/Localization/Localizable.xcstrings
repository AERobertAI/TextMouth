    },
    "Skip forward unit" : {
      "comment" : "VoiceOver label of the Skip Forward pop-up in the Playback settings."
    },
    "Skip forward: %@" : {
      "comment" : "What VoiceOver says for the playback bar's skip forward button. %@ is the unit it skips by, such as \"15 seconds\" or \"Sentence\"."
    },
    "Skipped" : {
      "comment" : "What VoiceOver says for the mark on a heading the user skipped."
    },
    "Skipped, %@ (current heading) - level %lld" : {
      "comment" : "What VoiceOver says for the heading being read when the user skipped it, in the headings list. %1$@ is the heading's text; %2$lld is its level, 1 for the biggest heading.",
      "localizations" : {
