{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ adds a bookmark at the current position." : {
      "comment" : "Help under \"No bookmarks yet.\" in the Bookmarks list. %@ is the keyboard shortcut that adds a bookmark, spelled out in words, such as Command + B.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ agrega un marcador en la posición actual."
          }
        }
      }
    },
    "%@ adds one at the current position." : {
      "comment" : "Help under \"No bookmarks yet.\" in the Bookmarks list, when the add command has no keyboard shortcut. %@ is the name of the Add Bookmark button above the list.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ agrega uno en la posición actual."
          }
        }
      }
    },
    "%@ is already in the reading list." : {
      "comment" : "VoiceOver announcement when Add to Reading List added nothing: the one book selected is on the list already. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ya está en la lista de lectura."
          }
        }
      }
    },
    "%@ isn't in the reading list." : {
      "comment" : "VoiceOver announcement when Remove from Reading List took nothing off: the one book selected is not on the list. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no está en la lista de lectura."
          }
        }
      }
    },
    "%@ remaining" : {
      "comment" : "The sleep timer's state as VoiceOver reads it after \"Sleep timer:\" while it counts down. %@ is the time left in minutes and seconds, such as 4:59.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "quedan %@"
          }
        }
      }
    },
    "%lld books were already in it." : {
      "comment" : "Second sentence of the announcement after books were added to the reading list: some chosen were on it already. %lld is how many.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld book was already in it."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld books were already in it."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "%lld de libros ya estaban en ella."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "%lld libro ya estaba en ella."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "%lld libros ya estaban en ella."
                }
              }
            }
          }
        }
      }
    },
    "%lld books were not in it." : {
      "comment" : "Second sentence of the announcement after books were taken off the reading list: some chosen were not on it. %lld is how many.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld book was not in it."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld books were not in it."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "%lld de libros no estaban en ella."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "%lld libro no estaba en ella."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "%lld libros no estaban en ella."
                }
              }
            }
          }
        }
      }
    },
    "%lld minutes" : {
      "comment" : "A sleep timer's length, as its preset button and the custom minutes' value say it, such as \"10 minutes\". %lld is the number of minutes.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld minute"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld minutes"
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "%lld de minutos"
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "%lld minuto"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "%lld minutos"
                }
              }
            }
          }
        }
      }
    },
    "A New Window" : {
      "comment" : "A choice of the Open the next book in pop-up button (Settings, Playback; Feed Info; Folder Settings): the next book opens in a window of its own, and this one stays.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una ventana nueva"
          }
        }
      }
    },
    "A new timer replaces the one running." : {
      "comment" : "Note under the sleep timer sheet's New Timer heading while a timer runs: setting one of the timers below stops it.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un temporizador nuevo reemplaza al que está en curso."
          }
        }
      }
    },
    "Add" : {
      "comment" : "Button of the panel for adding a bookmark: adds it, with the note written.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Agregar"
          }
        }
      }
    },
    "Add %lld Books to Reading List" : {
      "comment" : "Context menu item for the books selected in the Library: adds them to the reading list. Title case. %lld is the number of books selected.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Add %lld Book to Reading List"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Add %lld Books to Reading List"
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Agregar %lld de libros a la lista de lectura"
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Agregar %lld libro a la lista de lectura"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Agregar %lld libros a la lista de lectura"
                }
              }
            }
          }
        }
      }
    },
    "Add %lld books to the reading list" : {
      "comment" : "VoiceOver label of the Library's edit-mode bar button that adds the selected books to the reading list. %lld is the number of books selected.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Add %lld book to the reading list"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Add %lld books to the reading list"
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Agregar %lld de libros a la lista de lectura"
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Agregar %lld libro a la lista de lectura"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Agregar %lld libros a la lista de lectura"
                }
              }
            }
          }
        }
      }
    },
    "Add Bookmark" : {
      "comment" : "Button of the Bookmarks list that adds a bookmark at the reading position, and the heading of the panel where its note is written.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Agregar marcador"
          }
        }
      }
    },
    "Added %lld books to the reading list." : {
      "comment" : "VoiceOver announcement after several books were added to the reading list. %lld is the number of books added.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se agregaron %lld libros a la lista de lectura."
          }
        }
      }
    },
    "Added to reading list: %@" : {
      "comment" : "VoiceOver announcement after one book was added to the reading list. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Agregado a la lista de lectura: %@"
          }
        }
      }
    },
    "Adds the selected books to the end of the reading list." : {
      "comment" : "VoiceOver hint of the Library's edit-mode bar button Add to Reading List.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Agrega los libros seleccionados al final de la lista de lectura."
          }
        }
      }
    },
    "Adjust minutes" : {
      "comment" : "VoiceOver label of the stepper beside the sleep timer sheet's custom minutes field.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ajustar minutos"
          }
        }
      }
    },
    "Asks for an optional note, then marks the reading position." : {
      "comment" : "VoiceOver hint of the Bookmarks list's Add Bookmark button: it opens the step where an optional note is written, then the bookmark is added where the book is being read.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pide una nota opcional y luego marca la posición de lectura."
          }
        }
      }
    },
    "Available only while this feed's articles go on to another article when one ends" : {
      "comment" : "VoiceOver hint of the dimmed Open the next article in pop-up button in a news feed's Feed Info: when it can be used.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disponible solo mientras los artículos de este canal pasan a otro artículo al terminar uno"
          }
        }
      }
    },
    "Available only while this feed's episodes go on to another episode when one ends" : {
      "comment" : "VoiceOver hint of the dimmed Open the next episode in pop-up button in a podcast feed's Feed Info: when it can be used.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disponible solo mientras los episodios de este canal pasan a otro episodio al terminar uno"
          }
        }
      }
    },
    "Available only while this feed's items go on to another item when one ends" : {
      "comment" : "VoiceOver hint of the dimmed Open the next item in pop-up button in a feed's Feed Info: when it can be used.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disponible solo mientras los elementos de este canal pasan a otro elemento al terminar uno"
          }
        }
      }
    },
    "Available only while this folder's books go on to another book when one ends" : {
      "comment" : "VoiceOver hint of the dimmed Open the next book in pop-up button in a folder's settings: when it can be used.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disponible solo mientras los libros de esta carpeta pasan a otro libro al terminar uno"
          }
        }
      }
    },
    "Bookmark %@" : {
      "comment" : "A bookmark's name, by its number: the first line of its row in the Bookmarks list, and what VoiceOver says after a move to it. %@ is the bookmark's number, an identifier written without digit grouping.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Marcador %@"
          }
        }
      }
    },
    "Bookmark %@ added" : {
      "comment" : "VoiceOver announcement after a bookmark was added at the reading position. %@ is the new bookmark's number, an identifier written without digit grouping.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Marcador %@ agregado"
          }
        }
      }
    },
    "Bookmark %@ removed" : {
      "comment" : "VoiceOver announcement after the bookmark command removed the bookmark at the reading position. %@ is that bookmark's number, an identifier written without digit grouping.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Marcador %@ eliminado"
          }
        }
      }
    },
    "Bookmark %@, %@, Note: %@, added %@" : {
      "comment" : "VoiceOver label of a bookmark's row in the Bookmarks list and its rotor. %1$@ is the bookmark's number, an identifier written without digit grouping; %2$@ the heading it is under; %3$@ its note, written by the listener; %4$@ the day it was added, such as October 9, 2026.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bookmark %1$@, %2$@, Note: %3$@, added %4$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Marcador %1$@, %2$@, Nota: %3$@, agregado el %4$@"
          }
        }
      }
    },
    "Bookmark %@, %@, added %@" : {
      "comment" : "VoiceOver label of a bookmark's row in the Bookmarks list and its rotor, for a bookmark with no note. %1$@ is the bookmark's number, an identifier written without digit grouping; %2$@ the heading it is under; %3$@ the day it was added, such as October 9, 2026.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bookmark %1$@, %2$@, added %3$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Marcador %1$@, %2$@, agregado el %3$@"
          }
        }
      }
    },
    "Bookmark %@, Note: %@, added %@" : {
      "comment" : "VoiceOver label of a bookmark's row in the Bookmarks list and its rotor, for a bookmark under no heading. %1$@ is the bookmark's number, an identifier written without digit grouping; %2$@ its note, written by the listener; %3$@ the day it was added, such as October 9, 2026.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bookmark %1$@, Note: %2$@, added %3$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Marcador %1$@, Nota: %2$@, agregado el %3$@"
          }
        }
      }
    },
    "Bookmark %@, added %@" : {
      "comment" : "VoiceOver label of a bookmark's row in the Bookmarks list and its rotor, for a bookmark with no note under no heading. %1$@ is the bookmark's number, an identifier written without digit grouping; %2$@ the day it was added, such as October 9, 2026.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bookmark %1$@, added %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Marcador %1$@, agregado el %2$@"
          }
        }
      }
    },
    "Bookmark note" : {
      "comment" : "VoiceOver label of the note field when adding a bookmark or editing its note.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nota del marcador"
          }
        }
      }
    },
    "Bookmarks" : {
      "comment" : "The name of the bookmarks, wherever it is named: the title of the Bookmarks list over a book's reader (read by VoiceOver as its heading, and the name of its rotor), the reader's Bookmarks toolbar button, and the Bookmarks menu in the menu bar.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Marcadores"
          }
        }
      }
    },
    "Cancel" : {
      "comment" : "Button that leaves a sheet, panel, or question without making its change, such as the panel for adding a bookmark or editing its note.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cancelar"
          }
        }
      }
    },
    "Cancel Timer" : {
      "comment" : "Button of the sleep timer sheet that stops the running timer.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cancelar temporizador"
          }
        }
      }
    },
    "Chooses what a book opened from the list does when it ends." : {
      "comment" : "VoiceOver hint of the Reading List's When a book ends pop-up button.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige qué hace un libro abierto desde la lista al terminar."
          }
        }
      }
    },
    "Chooses where the next book opens: in this window or a new one. A book open in another window comes forward, and with %@ chosen, this window closes." : {
      "comment" : "VoiceOver hint of the Open the next book in pop-up button in Settings, Playback, also shown under it. %@ is the name of its choice This Window.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige dónde se abre el siguiente libro: en esta ventana o en una nueva. Un libro abierto en otra ventana pasa al frente y, si eliges %@, esta ventana se cierra."
          }
        }
      }
    },
    "Chooses where this feed's next article opens." : {
      "comment" : "VoiceOver hint of the Open the next article in pop-up button in a news feed's Feed Info.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige dónde se abre el siguiente artículo de este canal."
          }
        }
      }
    },
    "Chooses where this feed's next episode opens." : {
      "comment" : "VoiceOver hint of the Open the next episode in pop-up button in a podcast feed's Feed Info.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige dónde se abre el siguiente episodio de este canal."
          }
        }
      }
    },
    "Chooses where this feed's next item opens." : {
      "comment" : "VoiceOver hint of the Open the next item in pop-up button in a feed's Feed Info.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige dónde se abre el siguiente elemento de este canal."
          }
        }
      }
    },
    "Chooses where this folder's next book opens." : {
      "comment" : "VoiceOver hint of the Open the next book in pop-up button in a folder's settings.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige dónde se abre el siguiente libro de esta carpeta."
          }
        }
      }
    },
    "Close" : {
      "comment" : "Button that closes a sheet or window and returns to what is under it, such as the sleep timer sheet over a book's reader, a feed's information sheet, or the reader's own sheets.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cerrar"
          }
        }
      }
    },
    "Could not add the bookmark: “%@” is no longer in the library." : {
      "comment" : "VoiceOver announcement when a bookmark could not be added because the book left the library while its reader was open. %@ is the book's title, in quotation marks.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo agregar el marcador: “%@” ya no está en la biblioteca."
          }
        }
      }
    },
    "Could not remove the bookmark: “%@” is no longer in the library." : {
      "comment" : "VoiceOver announcement when a bookmark could not be removed because the book left the library while its reader was open. %@ is the book's title, in quotation marks.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo eliminar el marcador: “%@” ya no está en la biblioteca."
          }
        }
      }
    },
    "Current Timer" : {
      "comment" : "Heading of the sleep timer sheet's section about the timer running now.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Temporizador actual"
          }
        }
      }
    },
    "Custom minutes" : {
      "comment" : "VoiceOver label of the sleep timer sheet's field of a custom number of minutes.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Minutos personalizados"
          }
        }
      }
    },
    "Custom:" : {
      "comment" : "Shown before the sleep timer sheet's field of a custom number of minutes. Hidden from VoiceOver, which reads the field's label.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Personalizado:"
          }
        }
      }
    },
    "Delete" : {
      "comment" : "A command on a bookmark of the Bookmarks list, as a button beside its row, a VoiceOver action, and a context menu item: deletes the bookmark.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eliminar"
          }
        }
      }
    },
    "Delete bookmark %@" : {
      "comment" : "VoiceOver label of the button beside a bookmark's row that deletes it. %@ is the bookmark's number, an identifier written without digit grouping.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eliminar marcador %@"
          }
        }
      }
    },
    "Done" : {
      "comment" : "Button that finishes with a sheet or list and closes it, keeping what was done, such as the Bookmarks list over a book's reader, a feed's information, the OPML import, or the duplicate finder.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "OK"
          }
        }
      }
    },
