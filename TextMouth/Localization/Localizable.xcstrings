    "playbackControls.unitsHelp" : {
      "comment" : "Help text of the playback bar's menu that holds separate forward and backward navigation units.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تغيير وحدتي التنقل للأمام وللخلف لهذا الكتاب"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই বইয়ের এগিয়ে ও পিছিয়ে যাওয়ার নেভিগেশন ইউনিট আলাদাভাবে পরিবর্তন করুন"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Navigationseinheiten dieses Buchs für Vorwärts und Rückwärts ändern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change this book's forward and backward navigation units"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cambia las unidades de navegación de este libro, hacia adelante y hacia atrás"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تغییر واحدهای پیمایش به جلو و به عقب این کتاب"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Modifie les unités de navigation avant et arrière de ce livre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "שנה את יחידות הניווט קדימה ואחורה של ספר זה"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस पुस्तक की आगे और पीछे जाने की नेविगेशन इकाइयाँ बदलें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ubah unit navigasi maju dan mundur buku ini"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cambia le unità di navigazione avanti e indietro di questo libro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このブックの前方と後方の移動単位を変更します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 책의 앞으로 탐색 단위와 뒤로 탐색 단위를 각각 변경합니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wijzigt de navigatie-eenheden voor vooruit en achteruit van dit boek"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zmień jednostki nawigacji do przodu i do tyłu dla tej książki"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Altera as unidades de navegação para frente e para trás deste livro"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Меняет единицы навигации вперёд и назад для этой книги."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ändra navigeringsenheter framåt och bakåt för den här boken"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เปลี่ยนหน่วยการนำทางไปข้างหน้าและย้อนกลับของหนังสือเล่มนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu kitabın ileri ve geri gezinme birimlerini değiştir"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Змінює одиниці навігації вперед і назад для цієї книги"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس کتاب کے آگے اور پیچھے جانے کے نیویگیشن یونٹس تبدیل کریں"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đổi các đơn vị điều hướng tiến và lùi của sách này"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "更改此图书的前进和后退导航单位"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "更改此書向前與向後各自的導覽單位"
          }
        }
      }
    },
