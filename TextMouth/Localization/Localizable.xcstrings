    "ffmpeg couldn't be started. Check it is installed, or turn off Use ffmpeg in Storage settings." : {
      "comment" : "Problem said when the ffmpeg program can't be started. \"Use ffmpeg\" is the name of a switch in the Storage settings.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ffmpeg konnte nicht gestartet werden. Prüfe, ob es installiert ist, oder schalte „ffmpeg für Filter verwenden“ in den Speichereinstellungen aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo iniciar ffmpeg. Comprueba que esté instalado o desactiva Usar ffmpeg para los filtros en los ajustes de Almacenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ffmpeg n’a pas pu être démarré. Vérifiez qu’il est installé, ou désactivez Utiliser ffmpeg dans les réglages Stockage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile avviare ffmpeg. Controlla che sia installato oppure disattiva Usa ffmpeg per i filtri nelle impostazioni di Archiviazione."
          }
