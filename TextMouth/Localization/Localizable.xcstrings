        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ อยู่ในไลบรารีของคุณแต่เลิกติดตามแล้ว เลือก %2$@ ที่แถวของฟีดนี้ หรือใน %3$@ เพื่อตรวจสอบอีกครั้ง"
