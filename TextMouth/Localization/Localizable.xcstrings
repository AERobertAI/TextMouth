    "phoneExport.shareHint" : {
      "comment" : "The hint of the Share button on the iPhone's Export sheet, after an export.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يرسل الملفات التي صُدّرت للتو إلى تطبيق آخر أو شخص آخر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এইমাত্র রপ্তানি করা ফাইলগুলো অন্য কোনো অ্যাপ বা ব্যক্তির কাছে পাঠায়।"
          }
        },
        "de" : {
          "stringUnit" : {
