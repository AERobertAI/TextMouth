            "value" : "O TextMouth anexa arquivos WebVTT (.vtt) e SubRip (.srt)."
          }
        }
      }
    },
    "TextMouth can't convert %@ files because its converter is missing from the app." : {
      "comment" : "Why a file was not imported: the converter TextMouth carries is missing from the app, which only a damaged copy is. %@ is the name of the file's format, such as WMA or Matroska. Advice to install the app again follows.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kann %@-Dateien nicht umwandeln, weil das Umwandlungsprogramm in der App fehlt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede convertir archivos %@ porque falta su conversor en la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ne peut pas convertir les fichiers %@, car son convertisseur est absent de l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non può convertire i file %@ perché il suo convertitore manca nell’app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não consegue converter arquivos %@ porque o conversor dele está ausente do app."
          }
        }
      }
    },
    "TextMouth can't convert the sound of “%@”: it is in a kind of audio it does not read." : {
      "comment" : "Why a file was not imported: its sound is in a codec TextMouth does not decode. %@ is the file's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kann den Ton von „%@“ nicht umwandeln: Er liegt in einer Audioart vor, die TextMouth nicht liest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
