    "sync.setUpHint" : {
      "comment" : "VoiceOver hint of the Set Up Sync button. TextMouth Sync is the folder's name and is not translated.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تنشئ مجلدًا باسم TextMouth Sync في مجلد iCloud Drive الذي تختاره، وتنسخ كتبك إليه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আপনার বেছে নেওয়া iCloud Drive ফোল্ডারে TextMouth Sync নামে একটি ফোল্ডার তৈরি করে এবং আপনার বই সেখানে কপি করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Erstellt in dem iCloud-Drive-Ordner, den du wählst, einen Ordner namens TextMouth Sync und kopiert deine Bücher hinein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makes a folder named TextMouth Sync in the iCloud Drive folder you choose, and copies your books into it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Crea una carpeta llamada TextMouth Sync en la carpeta de iCloud Drive que elijas y copia tus libros en ella."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "در پوشهٔ iCloud Drive که انتخاب می‌کنید پوشه‌ای به نام TextMouth Sync می‌سازد و کتاب‌های شما را در آن کپی می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Crée un dossier nommé TextMouth Sync dans le dossier iCloud Drive que vous choisissez, et y copie vos livres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "יוצר תיקייה בשם TextMouth Sync בתיקיית iCloud Drive שתבחר, ומעתיק אליה את הספרים שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आपके चुने हुए iCloud Drive फ़ोल्डर में TextMouth Sync नाम का फ़ोल्डर बनाता है और आपकी पुस्तकें उसमें कॉपी करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuat folder bernama TextMouth Sync di folder iCloud Drive yang Anda pilih, lalu menyalin buku Anda ke dalamnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Crea una cartella chiamata TextMouth Sync nella cartella di iCloud Drive che scegli e vi copia i tuoi libri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選択した iCloud Drive のフォルダ内に TextMouth Sync という名前のフォルダを作成し、ブックをコピーします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "선택한 iCloud Drive 폴더 안에 TextMouth Sync라는 폴더를 만들고 책을 복사합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Maakt een map met de naam TextMouth Sync in de iCloud Drive-map die je kiest en kopieert je boeken erin."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tworzy folder o nazwie TextMouth Sync w wybranym folderze iCloud Drive i kopiuje do niego książki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cria uma pasta chamada TextMouth Sync na pasta do iCloud Drive que você escolher e copia seus livros para ela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Создаёт папку TextMouth Sync в выбранной вами папке iCloud Drive и копирует в неё ваши книги."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Skapar en mapp som heter TextMouth Sync i den iCloud Drive-mapp du väljer och kopierar dina böcker dit."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "สร้างโฟลเดอร์ชื่อ TextMouth Sync ในโฟลเดอร์ iCloud Drive ที่คุณเลือก และคัดลอกหนังสือของคุณลงไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Seçtiğiniz iCloud Drive klasöründe TextMouth Sync adlı bir klasör oluşturur ve kitaplarınızı içine kopyalar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Створює папку TextMouth Sync у вибраній вами папці iCloud Drive та копіює до неї ваші книги."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آپ کے منتخب کردہ iCloud Drive فولڈر میں TextMouth Sync نام کا فولڈر بناتا ہے اور آپ کی کتابیں اس میں کاپی کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tạo thư mục tên TextMouth Sync trong thư mục iCloud Drive mà bạn chọn, rồi sao chép sách của bạn vào đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在你选取的 iCloud 云盘文件夹中创建名为 TextMouth Sync 的文件夹，并将你的图书复制进去。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在你選擇的 iCloud Drive 檔案夾中建立名為 TextMouth Sync 的檔案夾，並將你的書籍複製進去。"
          }
        }
      }
    },
