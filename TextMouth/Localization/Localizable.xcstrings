    "feed.itemPolicyHint.onlyNewestListed.played" : {
      "comment" : "VoiceOver hint of the List and download choice for a feed of episodes, in Settings, or for a feed of both kinds when only the newest are listed. %lld is how many of the newest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "يعرض أحدث %lld مما لم تشغّله، وكل تنزيل. لا ينزّل إلا ما تطلبه؛ وتحتفظ الباقية بسجلاتها وتعود عندما تعرض المزيد."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "يعرض أحدث %lld مما لم تشغّله، وكل تنزيل. لا ينزّل إلا ما تطلبه؛ وتحتفظ الباقية بسجلاتها وتعود عندما تعرض المزيد."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "يعرض أحدث %lld مما لم تشغّله، وكل تنزيل. لا ينزّل إلا ما تطلبه؛ وتحتفظ الباقية بسجلاتها وتعود عندما تعرض المزيد."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "يعرض أحدث %lld مما لم تشغّله، وكل تنزيل. لا ينزّل إلا ما تطلبه؛ وتحتفظ الباقية بسجلاتها وتعود عندما تعرض المزيد."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "يعرض أحدث %lld مما لم تشغّله، وكل تنزيل. لا ينزّل إلا ما تطلبه؛ وتحتفظ الباقية بسجلاتها وتعود عندما تعرض المزيد."
                }
