    "The text changed since the search; moved to the nearest match." : {
      "comment" : "Announcement when the book's text changed since the search and the reader moved to the nearest match.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تغيّر النص منذ البحث؛ تم الانتقال إلى أقرب مطابقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Text hat sich seit der Suche geändert; es wurde zum nächstgelegenen Treffer gesprungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto cambió desde la búsqueda; se pasó a la coincidencia más cercana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le texte a changé depuis la recherche ; déplacé à la correspondance la plus proche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "खोज के बाद टेक्स्ट बदल गया; निकटतम मिलान पर ले जाया गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Teks berubah sejak pencarian; berpindah ke kecocokan terdekat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo è cambiato dopo la ricerca; spostato alla corrispondenza più vicina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "検索後にテキストが変更されたため、最も近い一致に移動しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "검색 이후 텍스트가 변경되어 가장 가까운 일치 항목으로 이동했습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O texto mudou desde a busca; movido para a correspondência mais próxima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Текст изменился после поиска; выполнен переход к ближайшему совпадению."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Текст змінився після пошуку; перехід до найближчого збігу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文本自搜索后已更改；已移到最近的匹配项。"
          }
        }
      }
    },
    "The text content.md held before was kept as %@, in the book's package." : {
      "comment" : "Second sentence of that message. content.md is the file name of the book's text and stays as written; %@ is the backup's file name such as content.md.edited-20261004T123012Z, which stays as written.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "حُفظ النص الذي كان في content.md باسم %@ في حزمة الكتاب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Text, den content.md zuvor enthielt, wurde als %@ im Paket des Buchs behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto que content.md tenía antes se conservó como %@, en el paquete del libro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le texte que contenait content.md a été conservé sous le nom %@, dans le paquet du livre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "content.md में पहले जो टेक्स्ट था, वह पुस्तक के पैकेज में %@ के रूप में रखा गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Teks content.md sebelumnya disimpan sebagai %@, di paket buku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo che content.md conteneva prima è stato conservato come %@, nel pacchetto del libro."
          }
