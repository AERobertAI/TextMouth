          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "データディレクトリの移動が終わったら、TextMouth はそれらを保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 데이터 디렉터리 이동이 끝나면 그것들을 저장합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
