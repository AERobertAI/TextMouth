    "audioEditor.closeWhileRecording" : {
      "comment" : "Said when the audio editor's window can't close because a punch-in records. \"Clear Selection\" is the name of a command.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جارٍ التسجيل. أوقفه أو تجاهله باستخدام “إلغاء التحديد”، ثم أغلق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "রেকর্ড হচ্ছে। এটি থামান, অথবা “নির্বাচন সাফ করুন” দিয়ে বর্জন করুন, তারপর বন্ধ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aufnahme läuft. Stoppe oder verwirf sie mit „Auswahl aufheben“ und schließe dann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recording. Stop or discard it with Clear Selection, then close."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Grabando. Detén la grabación o descártala con Quitar selección y luego cierra."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "در حال ضبط. آن را متوقف کنید، یا با «لغو انتخاب» دور بیندازید، سپس ببندید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Enregistrement en cours. Arrêtez-le ou abandonnez-le avec Désélectionner, puis fermez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מקליט. עצור או השלך את ההקלטה באמצעות “נקה בחירה”, ואז סגור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "रिकॉर्डिंग हो रही है। “रोकें” से इसे रोकें या “चयन हटाएँ” से त्याग दें, फिर बंद करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sedang merekam. Hentikan atau buang dengan Kosongkan Pilihan, lalu tutup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Registrazione in corso. Interrompila o scartala con Deseleziona, poi chiudi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "録音中です。停止するか、「選択解除」で破棄してから、閉じてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "녹음 중입니다. 중지하거나 선택 해제로 폐기한 다음 닫으십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Opnemen. Stop de opname of gooi die weg met Deselecteer en sluit daarna."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trwa nagrywanie. Zatrzymaj je albo odrzuć poleceniem Odznacz, a potem zamknij."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gravando. Pare ou descarte com Desmarcar seleção e depois feche."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Идёт запись. Остановите её или отбросьте командой «Снять выделение», затем закройте окно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Spelar in. Stoppa eller kassera inspelningen med Rensa markering och stäng sedan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "กำลังบันทึกเสียง ให้หยุด หรือทิ้งโดยใช้คำสั่ง ล้างส่วนที่เลือก แล้วจึงปิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kayıt yapılıyor. Durdurun veya Seçimi Kaldır ile atın, sonra kapatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Іде запис. Зупиніть його або відхиліть командою «Зняти виділення», потім закрийте."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ریکارڈنگ ہو رہی ہے۔ اسے روکیں یا “انتخاب صاف کریں” سے ترک کریں، پھر بند کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đang ghi âm. Hãy dừng hoặc bỏ bản ghi bằng Bỏ chọn, rồi đóng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "正在录音。请先停止录音，或用“取消选择”放弃录音，然后再关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "正在錄音。請先停止，或用「取消選取」捨棄錄音，然後再關閉。"
          }
        }
      }
    },
    "audioEditor.closeWhileWorking" : {
      "comment" : "Said when the audio editor's window can't close because a change, save, or export is under way.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يزال العمل جاريًا. أغلق بعد اكتمال التغيير."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এখনও কাজ চলছে। পরিবর্তন শেষ হলে বন্ধ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wird noch bearbeitet. Schließe das Fenster, sobald die Änderung abgeschlossen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still working. Close once the change is done."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aún en proceso. Cierra cuando termine el cambio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هنوز در حال کار است. پس از پایان تغییر ببندید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Traitement en cours. Fermez une fois la modification terminée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "עדיין עובד. סגור לאחר שהשינוי יסתיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "अभी काम चल रहा है। बदलाव पूरा होने पर बंद करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Masih memproses. Tutup setelah perubahan selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elaborazione in corso. Chiudi quando la modifica è finita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "処理中です。変更が終わってから閉じてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "작업 중입니다. 변경이 끝난 후에 닫으십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nog bezig. Sluit het zodra de wijziging klaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wciąż trwa praca. Zamknij po zakończeniu zmiany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ainda processando. Feche quando a alteração terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ещё выполняется. Закройте окно, когда изменение завершится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arbetar fortfarande. Stäng när ändringen är klar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ยังทำงานอยู่ ให้ปิดหลังจากเปลี่ยนแปลงเสร็จแล้ว"
