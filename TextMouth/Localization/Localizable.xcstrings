          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elimina %@: viene eliminato definitivamente e non può essere recuperato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@を削除します。完全に削除され、復元できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@을(를) 삭제합니다. 영구적으로 삭제되며 복구할 수 없습니다."
          }
        },
        "nl" : {
