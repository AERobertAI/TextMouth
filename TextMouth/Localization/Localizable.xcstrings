    "Adds the lexicon's entries after your rules; entries with only a phonetic spelling are set aside" : {
      "comment" : "VoiceOver hint of the Import Rules button in Settings, Text, Substitutions: what is added and what is left out.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fügt die Einträge des Lexikons nach deinen Regeln hinzu; Einträge nur mit phonetischer Schreibweise werden übergangen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Agrega las entradas del léxico después de tus reglas; las entradas con solo una ortografía fonética se dejan aparte"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ajoute les entrées du lexique après vos règles ; les entrées qui ne donnent qu’une orthographe phonétique sont écartées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लेक्सिकन की प्रविष्टियों को आपके नियमों के बाद जोड़ता है; केवल ध्वन्यात्मक वर्तनी वाली प्रविष्टियाँ अलग रखी जाती हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menambahkan entri leksikon setelah aturan Anda; entri yang hanya berisi ejaan fonetik dikesampingkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aggiunge le voci del lessico dopo le tue regole; le voci con la sola ortografia fonetica vengono messe da parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "あなたのルールの後に辞書のエントリを追加します。発音の表記だけのエントリは除外されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "내 규칙 뒤에 어휘집의 항목을 추가하며, 음성 표기만 있는 항목은 제외됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Adiciona as entradas do léxico depois das suas regras; entradas só com grafia fonética são ignoradas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Добавляет элементы лексикона после ваших правил; элементы только с фонетическим написанием пропускаются."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Додає записи словника після ваших правил; записи лише з фонетичним написанням пропускаються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在你的规则之后添加词典中的词条；只有音标拼写的词条会被略过。"
          }
        }
      }
    },
    "Adds the new copy to the library as a separate book." : {
      "comment" : "VoiceOver hint of the Keep Both button of the duplicate-book question.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fügt die neue Kopie der Bibliothek als eigenes Buch hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Agrega la copia nueva a la biblioteca como un libro aparte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ajoute la nouvelle copie à la bibliothèque comme livre distinct."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "नई प्रति को अलग पुस्तक के रूप में लाइब्रेरी में जोड़ता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menambahkan salinan baru ke pustaka sebagai buku terpisah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aggiunge la nuova copia alla libreria come libro separato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "新しいコピーを別のブックとしてライブラリに追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "새 사본을 별도의 책으로 보관함에 추가합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Adiciona a nova cópia à biblioteca como um livro separado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Добавляет новую копию в библиотеку как отдельную книгу."
          }
        },
        "uk" : {
          "stringUnit" : {
