            "value" : "La voix s’est arrêtée au caractère %1$@ sur %2$@ dans le chapitre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lettura interrotta al carattere %1$@ di %2$@ nel capitolo."
          }
        },
