    "sync.libraryNotLocal" : {
      "comment" : "Shown when syncing is refused because the library is kept in a cloud folder. Change Location is a button of the Storage settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "المزامنة مخصّصة لمكتبة محفوظة على هذا الـ Mac. انقل هذه المكتبة إلى هنا أولًا باستخدام «تغيير الموقع»."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সিঙ্ক এমন লাইব্রেরির জন্য, যা এই Mac-এ রাখা আছে। আগে “অবস্থান পরিবর্তন করুন” দিয়ে এই লাইব্রেরি এখানে সরিয়ে আনুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Synchronisierung ist für eine Bibliothek gedacht, die auf diesem Mac liegt. Verschiebe diese zuerst mit „Ort ändern“ hierher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync is for a library kept on this Mac. Move this one here with Change Location first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La sincronización es para una biblioteca guardada en esta Mac. Primero mueve esta aquí con Cambiar ubicación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "همگام‌سازی برای کتابخانه‌ای است که روی این Mac نگه داشته شده. ابتدا این کتابخانه را با «تغییر مکان» به اینجا منتقل کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La synchronisation est prévue pour une bibliothèque conservée sur ce Mac. Commencez par déplacer celle-ci ici avec Changer l’emplacement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "סנכרון מיועד לספרייה ששמורה ב-Mac הזה. העבר תחילה את הספרייה הזו לכאן באמצעות “שנה מיקום”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सिंक उस लाइब्रेरी के लिए है जो इस Mac पर रखी है। पहले “स्थान बदलें” से इस लाइब्रेरी को यहाँ ले आएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sinkronisasi untuk pustaka yang disimpan di Mac ini. Pindahkan pustaka ini ke sini dulu dengan Ubah Lokasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La sincronizzazione è pensata per una libreria conservata su questo Mac. Sposta prima questa libreria qui con Cambia posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "同期は、この Mac に置かれているライブラリが対象です。先に「場所を変更」で、このライブラリをここに移動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "동기화는 이 Mac에 있는 보관함에서만 사용할 수 있습니다. 먼저 “위치 변경”으로 이 보관함을 여기로 옮기십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Synchronisatie is voor een bibliotheek die op deze Mac staat. Verplaats deze bibliotheek eerst hierheen met Wijzig locatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Synchronizacja dotyczy biblioteki przechowywanej na tym komputerze Mac. Najpierw przenieś tę bibliotekę tutaj za pomocą polecenia Zmień lokalizację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A sincronização é para uma biblioteca mantida neste Mac. Primeiro mova esta para cá com Alterar localização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Синхронизация работает для библиотеки, которая хранится на этом Mac. Сначала перенесите эту библиотеку сюда через «Изменить расположение»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Synkronisering är till för ett bibliotek som finns på den här Mac-datorn. Flytta först hit det här biblioteket med Ändra plats."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "การซิงค์ใช้กับไลบรารีที่เก็บอยู่ใน Mac เครื่องนี้ ให้ย้ายไลบรารีนี้มาที่นี่ก่อนด้วย “เปลี่ยนตำแหน่งที่ตั้ง”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eşzamanlama, bu Mac üzerinde duran bir kitaplık içindir. Önce Konumu Değiştir ile bu kitaplığı buraya taşıyın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Синхронізація працює для бібліотеки, що зберігається на цьому Mac. Спершу перенесіть цю бібліотеку сюди через «Змінити розташування»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سنک اس لائبریری کے لیے ہے جو اس Mac پر رکھی ہے۔ پہلے “مقام تبدیل کریں” سے اس لائبریری کو یہاں منتقل کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đồng bộ dành cho thư viện được lưu trên máy Mac này. Hãy chuyển thư viện này về đây trước bằng Đổi vị trí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "同步仅适用于保存在这台 Mac 上的资料库。请先用“更改位置”把这个资料库移到这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "同步僅適用於儲存在這部 Mac 上的書庫。請先用「更改位置」把這個書庫移到這裡。"
          }
        }
      }
    },
    "sync.notASyncFolder" : {
      "comment" : "Shown when the folder chosen to join is not a TextMouth Sync folder, or its files have not arrived from iCloud Drive yet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هذا ليس مجلد TextMouth Sync، أو أن ملفاته لم تصل بعد من iCloud Drive."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এটি TextMouth Sync ফোল্ডার নয়, অথবা এর ফাইল এখনও iCloud Drive থেকে এসে পৌঁছায়নি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das ist kein TextMouth-Sync-Ordner, oder seine Dateien sind noch nicht aus iCloud Drive angekommen."
