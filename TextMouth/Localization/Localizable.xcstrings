    "Takes each finished book off the list when its window moves on or closes. Books finished before you turn it on stay." : {
      "comment" : "VoiceOver hint of the Reading List's Remove books when finished checkbox.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quita de la lista cada libro terminado cuando su ventana pasa a otro libro o se cierra. Los libros terminados antes de activarlo se quedan."
          }
        }
      }
    },
    "Takes the selected books off the reading list. They stay in the library." : {
      "comment" : "VoiceOver hint of the Library's edit-mode bar button Remove from Reading List.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quita los libros seleccionados de la lista de lectura. Siguen en la biblioteca."
          }
        }
      }
    },
    "TextMouth attaches WebVTT (.vtt) and SubRip (.srt) files." : {
      "comment" : "Alert explaining why a chosen file was not attached as a transcript. WebVTT and SubRip are subtitle file formats, and .vtt and .srt their file extensions."
    },
    "TextMouth closed while opening %@, so it wasn't reopened." : {
      "comment" : "Announced at launch after the app closed while it was opening a book. %@ is the book's title, which is not opened again."
    },
    "TextMouth has no rules of its own: none was right in every book tested. Edit Rules… opens your copy, where you can add rules, such as a name the recognizer always spells another way." : {
      "comment" : "Line of the Clean Up Transcript sheet when the rules that come with the app are empty. Edit Rules… is the name of a button of the sheet."
    },
    "TextMouth is already transcribing %@. Try again when that finishes." : {
      "comment" : "Error shown when a transcription is started while another runs. %@ is the title of the audiobook being transcribed."
    },
    "TextMouth is not downloading right now." : {
      "comment" : "Why the download of a feed's next episode did not start: the app is quitting or the feed is being deleted. Said after \"The next episode could not be downloaded, so playback stopped.\"",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no está descargando en este momento."
          }
        }
      }
    },
    "TextMouth's own rules are newer, version %@. To use them, delete your copy or copy their rules into it." : {
      "comment" : "Line of the Clean Up Transcript sheet when the rules that come with the app are newer than the user's copy. %@ is the new version number, written without digit grouping."
    },
    "That item isn't a plain file TextMouth can read." : {
      "comment" : "Alert explaining why a chosen item was not attached as a transcript: it is not an ordinary file, such as a folder or a pipe."
    },
    "The %@ file holds no timed text TextMouth can use." : {
      "comment" : "Error shown when a chosen transcript file holds no usable timed passage. %@ is the format's name, such as WebVTT or SubRip."
    },
    "The %@ model couldn't be downloaded: %@" : {
      "comment" : "What VoiceOver hears, and the Transcribe Audio sheet shows, when a speech model's download failed. %1$@ is the language's name; %2$@ is the system's reason, a sentence.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The %1$@ model couldn't be downloaded: %2$@"
          }
        }
      }
    },
    "The %@ model is downloaded. The book can be transcribed now." : {
      "comment" : "What VoiceOver hears, and the Transcribe Audio sheet shows, when a speech model has finished downloading. %@ is the language's name."
    },
    "The %@ model's download was cancelled." : {
      "comment" : "What VoiceOver hears, and the Transcribe Audio sheet shows, when a speech model's download was stopped. %@ is the language's name."
    },
    "The %lld selected books are already in the reading list." : {
      "comment" : "VoiceOver announcement when Add to Reading List added nothing: every book selected is on the list already. %lld is the number of books selected (two or more).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los %lld libros seleccionados ya están en la lista de lectura."
          }
        }
      }
    },
    "The audiobook's audio, your place, and your bookmarks stay as they are." : {
      "comment" : "Sentence of the question asked before an audiobook's transcript is deleted or replaced by a file's: what stays."
    },
    "The book can be transcribed again." : {
      "comment" : "Last sentence of the question asked before an audiobook's transcript is deleted, after what stays."
    },
    "The book has a transcript already, so TextMouth kept it." : {
      "comment" : "Notice that a transcript file was not attached because the book already had its own transcript."
    },
    "The book is being transcribed again. Clean up its transcript once that finishes." : {
      "comment" : "Error shown when a cleanup is tried while the book is being transcribed."
    },
    "The book is in %@." : {
      "comment" : "Second sentence of the announcement after an import at the Reading List added one book to it: the library folder the book went to. %@ is the folder's path, such as Essays/Sea, or Library Root.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El libro está en %@."
          }
        }
      }
    },
    "The book left the library during transcription, so its transcript wasn't saved." : {
      "comment" : "Error shown when the book was removed from the library during a transcription."
    },
    "The book's audio changed since it was transcribed (%@), so the transcript no longer fits. Transcribe again." : {
      "comment" : "Error shown when the book's audio files changed since the transcription. %@ is the reason, a short phrase in English."
    },
    "The book's audio changed while it was being transcribed: %@. Transcribe it again." : {
      "comment" : "Error shown when the book's audio files changed during a transcription, so the transcript was not saved. %@ is the reason, a short phrase in English."
    },
    "The book's text has changes TextMouth couldn't copy, so it leaves the text as it is." : {
      "comment" : "Error shown when a transcript could not replace a book's text because the text's unsaved changes could not be copied first."
    },
    "The book's text is only in iCloud, so TextMouth leaves it. Download the book, then try again." : {
      "comment" : "Line of the Transcribe Audio sheet, and an error, when the book's text file has not been downloaded from iCloud to this Mac."
    },
    "The book's transcript couldn't be read, so it wasn't exported." : {
      "comment" : "Error in an export's summary: the audiobook's transcript could not be read, so no captions file was written."
    },
    "The books are in %@." : {
      "comment" : "Second sentence of the announcement after an import at the Reading List added several books to it: the library folder they went to. %@ is the folder's path, such as Essays/Sea, or Library Root.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los libros están en %@."
          }
        }
      }
    },
    "The file is a %@ transcript of version %@, which TextMouth doesn't read." : {
      "comment" : "Error shown when a chosen transcript file is of a version of its format that this app does not read. %1$@ is the format's name, such as Podcasting 2.0 JSON; %2$@ is the version the file gives, written as the file writes it.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The file is a %1$@ transcript of version %2$@, which TextMouth doesn't read."
          }
        }
      }
    },
    "The file is over the %lld MB limit for a transcript." : {
      "comment" : "Error shown when a transcript file chosen to attach is too big. %lld is the size limit in megabytes (MB)."
    },
    "The file isn't a %@ transcript TextMouth can read." : {
      "comment" : "Error shown when a chosen transcript file's content is not in the format its name says. %@ is the format's name, such as WebVTT, SubRip, or Podcasting 2.0 JSON."
    },
    "The library isn't available, so the rules can't be opened now." : {
      "comment" : "Error shown when Edit Rules is pressed while the library's data folder cannot be used."
    },
    "The next article could not be downloaded, so playback stopped. %@" : {
      "comment" : "VoiceOver announcement when the download of a feed's next article failed. %@ is the download's own sentence saying why.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo descargar el siguiente artículo, así que la reproducción se detuvo. %@"
          }
        }
