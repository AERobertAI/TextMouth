          }
        }
      }
    },
    "Your place and bookmarks move with their words." : {
      "comment" : "First sentence of what a re-read does to the listener's place and bookmarks.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ينتقل موضعك وإشاراتك المرجعية مع كلماتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deine Position und deine Lesezeichen wandern mit ihren Wörtern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tu lugar y tus marcadores se mueven con sus palabras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Votre position et vos signets suivent leurs mots."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आपका स्थान और बुकमार्क उनके शब्दों के साथ चलते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Posisi dan markah Anda berpindah bersama kata-katanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La tua posizione e i segnalibri si spostano con le loro parole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "場所とブックマークは、対応する単語に合わせて移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "현재 위치와 북마크는 해당 단어와 함께 이동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sua posição e seus marcadores se movem com as palavras deles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ваша позиция чтения и закладки перемещаются вместе со своими словами."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ваша позиція та закладки переміщуються разом зі своїми словами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "你的位置和书签会随其字词一起移动。"
          }
        }
      }
    },
    "Your rules file can't be used: %@. TextMouth keeps it and a copy, and uses its own rules until you correct it." : {
      "comment" : "Line of the Clean Up Transcript sheet when the user's own rules file is damaged. %@ is the reason, a short technical phrase in English.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يمكن استخدام ملف قواعدك: %@. يحتفظ TextMouth به وبنسخة منه، ويستخدم قواعده الخاصة إلى أن تصحّحه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deine Regeldatei kann nicht verwendet werden: %@. TextMouth behält sie samt einer Kopie und verwendet seine eigenen Regeln, bis du sie korrigierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se puede usar tu archivo de reglas: %@. TextMouth lo conserva junto con una copia, y usa sus propias reglas hasta que lo corrijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Votre fichier de règles ne peut pas être utilisé : %@. TextMouth le garde ainsi qu’une copie, et utilise ses propres règles jusqu’à ce que vous le corrigiez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आपकी नियम फ़ाइल इस्तेमाल नहीं की जा सकती: %@। TextMouth उसे और उसकी एक प्रति रखता है, और जब तक आप उसे ठीक नहीं करते, अपने नियम इस्तेमाल करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "File aturan Anda tidak dapat dipakai: %@. TextMouth menyimpannya beserta salinannya, dan memakai aturan bawaannya sampai Anda memperbaikinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile usare il tuo file di regole: %@. TextMouth lo conserva insieme a una copia e usa le proprie regole finché non lo correggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ルールファイルを使用できません：%@。TextMouth はそのファイルとコピーを保持し、修正されるまで標準のルールを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "규칙 파일을 사용할 수 없습니다: %@. TextMouth는 이 파일과 사본을 보관하며, 수정할 때까지 자체 규칙을 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não é possível usar seu arquivo de regras: %@. O TextMouth o mantém, com uma cópia, e usa as regras próprias até você corrigi-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл с вашими правилами использовать нельзя: %@. TextMouth сохраняет его и копию и использует собственные правила, пока вы не исправите файл."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл ваших правил не можна використати: %@. TextMouth зберігає його та копію й використовує власні правила, доки ви його не виправите."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "无法使用你的规则文件：%@。TextMouth 会保留它及一份副本，并使用自带的规则，直到你改正为止。"
          }
        }
      }
    },
