    "readingListReader.noNeighbor.above" : {
      "comment" : "VoiceOver announcement when Previous in Reading List finds only finished books above this one, which the list passes over.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يوجد كتاب سابق في قائمة القراءة: كل الكتب الواقعة فوق هذا الكتاب منتهية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পড়ার তালিকায় আগের কোনো বই নেই: এর উপরের সব বই শেষ হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kein vorheriges Buch in der Leseliste: Jedes Buch darüber ist beendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No previous book in the reading list: every book above this one is finished."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay ningún libro anterior en la lista de lectura: todos los libros de arriba están terminados."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
