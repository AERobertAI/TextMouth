                  "value" : "%lld word per minute"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld words per minute"
                }
              }
            }
          }
        }
      }
    },
    "%lld words per minute, book-specific speed" : {
      "comment" : "What VoiceOver says for the reader toolbar's speed caption when this book has a speed of its own. %lld is the number of words read in a minute.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld word per minute, book-specific speed"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld words per minute, book-specific speed"
                }
              }
            }
          }
        }
      }
    },
    "%lld%% of %@" : {
      "comment" : "How far a feed download's file has come, when its size is known. %lld is the percent done; %@ is the file's size with its unit, such as 63 MB.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
