    "interfaceTextFile.editHint" : {
      "comment" : "VoiceOver hint of the Edit Interface Text button on the Mac. The file is interface_text.json in the data folder.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يفتح ملف أسطرك الخاصة في محررك. وإن لم يكن فيه أسطر لهذه اللغة، فإنه يملأ أولًا كل سطر كما يُقرأ الآن."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আপনার নিজের লাইনগুলোর ফাইল আপনার সম্পাদকে খোলে। এতে এই ভাষার কোনো লাইন না থাকলে আগে প্রতিটি লাইন এখন যেমন পড়া হয় তেমনই ভরে দেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffnet die Datei mit Ihren eigenen Zeilen in Ihrem Editor. Hat sie noch keine für diese Sprache, trägt sie zuerst jede Zeile so ein, wie sie jetzt lautet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens the file of your own lines in your editor. If it has none for this language, it first fills in every line as it reads now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre en tu editor el archivo con tus propias líneas. Si no tiene ninguna para este idioma, antes rellena todas las líneas tal como se leen ahora."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فایل خط‌های خودتان را در ویرایشگرتان باز می‌کند. اگر برای این زبان خطی در آن نباشد، ابتدا هر خط را همان‌طور که اکنون خوانده می‌شود در آن می‌نویسد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ouvre le fichier de vos propres lignes dans votre éditeur. S’il n’en a aucune pour cette langue, il commence par y inscrire chaque ligne telle qu’elle se lit maintenant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "פותח את קובץ השורות שלך בעורך שלך. אם אין בו שורות לשפה הזאת, הוא ממלא קודם כל שורה כפי שהיא נקראת עכשיו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आपकी अपनी पंक्तियों की फ़ाइल को आपके संपादक में खोलता है। अगर उसमें इस भाषा की कोई पंक्ति न हो, तो पहले हर पंक्ति को वैसे ही भर देता है जैसी वह अभी पढ़ी जाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuka file baris Anda sendiri di editor Anda. Jika belum ada baris untuk bahasa ini, file lebih dulu diisi dengan setiap baris seperti yang terbaca sekarang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apre nel tuo editor il file con le tue righe personali. Se non ne ha per questa lingua, prima inserisce ogni riga così come si legge ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "自分用の行のファイルをエディタで開きます。この言語の行がまだなければ、先にすべての行を現在の表記のまま書き込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "내 줄 파일을 편집기에서 엽니다. 이 언어의 줄이 아직 없으면, 먼저 모든 줄을 현재 표기 그대로 채워 넣습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Opent het bestand met je eigen regels in je editor. Heeft het er nog geen voor deze taal, dan vult het eerst elke regel in zoals die nu luidt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Otwiera w Twoim edytorze plik z Twoimi własnymi wierszami. Jeśli nie ma w nim żadnych dla tego języka, najpierw wpisuje każdy wiersz tak, jak brzmi teraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre no seu editor o arquivo com as suas próprias linhas. Se ele não tiver nenhuma para este idioma, antes preenche todas as linhas como elas são lidas agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Открывает файл с вашими собственными строками в вашем редакторе. Если в нём нет строк для этого языка, сначала вносит каждую строку в том виде, как она звучит сейчас."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öppnar filen med dina egna rader i din redigerare. Har den inga för det här språket fyller den först i varje rad som den lyder nu."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เปิดไฟล์บรรทัดของคุณเองในตัวแก้ไขของคุณ ถ้ายังไม่มีบรรทัดสำหรับภาษานี้ จะเติมทุกบรรทัดตามที่อ่านอยู่ในตอนนี้ก่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kendi satırlarınızın dosyasını düzenleyicinizde açar. Dosyada bu dil için hiç satır yoksa önce her satırı şimdiki haliyle yazar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відкриває файл із вашими власними рядками у вашому редакторі. Якщо в ньому немає рядків для цієї мови, спершу вносить кожен рядок так, як він звучить зараз."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آپ کی اپنی لائنوں کی فائل کو آپ کے ایڈیٹر میں کھولتا ہے۔ اگر اس میں اس زبان کی کوئی لائن نہ ہو تو پہلے ہر لائن اسی طرح بھر دیتا ہے جیسے وہ اب پڑھی جاتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mở tệp chứa các dòng riêng của bạn trong trình soạn thảo của bạn. Nếu tệp chưa có dòng nào cho ngôn ngữ này, trước hết nó điền mọi dòng như hiện đang đọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在您的编辑器中打开存放您自定义行的文件。如果其中还没有这种语言的行，会先按当前的读法填入每一行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在您的編輯器中開啟存放您自訂行的檔案。如果其中還沒有這種語言的行，會先依目前的讀法填入每一行。"
          }
        }
      }
    },
