          }
        }
      }
    },
    "The file %@ is missing." : {
      "comment" : "A sentence telling an audio file is not there. %@ is the file's name, such as 03.mp3.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Falta el archivo %@."
          }
        }
