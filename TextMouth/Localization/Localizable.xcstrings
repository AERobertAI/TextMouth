          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "תמליל מצורף כעת ל-%@. תמלל אותו לאחר שהצירוף יסתיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ में ट्रांसक्रिप्ट संलग्न की जा रही है। इसके पूरा होने पर इसे ट्रांसक्राइब करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
