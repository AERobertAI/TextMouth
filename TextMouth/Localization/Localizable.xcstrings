    "recordingFailure.deviceDisconnected" : {
      "comment" : "Error in the Record window when the microphone was unplugged while recording. %@ is the microphone's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم فصل %@، لذا توقف التسجيل. تم الاحتفاظ بما سُجّل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ সংযোগ বিচ্ছিন্ন হয়েছে, তাই রেকর্ডিং থেমে গেছে। যা রেকর্ড হয়েছে তা রাখা হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ wurde getrennt, daher wurde die Aufnahme gestoppt. Das Aufgenommene bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ was disconnected, so recording stopped. What was recorded is kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ se desconectó, así que la grabación se detuvo. Lo grabado se conserva."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ قطع شد، پس ضبط متوقف شد. آنچه ضبط شده بود نگه داشته می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Microphone déconnecté : %@. L’enregistrement s’est arrêté. Ce qui a été enregistré est conservé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ נותק, ולכן ההקלטה נעצרה. מה שהוקלט נשמר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ को डिस्कनेक्ट किया गया, इसलिए रिकॉर्डिंग रुक गई। जो रिकॉर्ड हुआ वह सुरक्षित है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ terputus, sehingga perekaman berhenti. Hasil rekaman tetap disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Microfono %@ scollegato, quindi la registrazione si è interrotta. Quanto registrato è stato conservato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@の接続が解除されたため、録音を停止しました。録音済みの内容は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 연결이 끊겨 녹음이 중지되었습니다. 녹음된 내용은 보관됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ is losgekoppeld, dus de opname is gestopt. Wat is opgenomen, blijft bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mikrofon %@ został odłączony, więc nagrywanie zatrzymano. To, co nagrano, zostało zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ foi desconectado, então a gravação parou. O que foi gravado foi mantido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Микрофон «%@» отключён, запись остановлена. Записанное сохранено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ kopplades bort, så inspelningen stoppades. Det som spelats in har sparats."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตัดการเชื่อมต่อ %@ แล้ว การบันทึกเสียงจึงหยุด เสียงที่บันทึกไว้แล้วยังอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ bağlantısı kesildi, bu yüzden kayıt durdu. Kaydedilenler saklandı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Мікрофон %@ відключено, тому запис зупинено. Записане збережено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ منقطع ہو گیا، اس لیے ریکارڈنگ رک گئی۔ جو ریکارڈ ہو چکا وہ محفوظ ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đã ngắt kết nối %@, nên việc ghi âm đã dừng. Phần đã ghi được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 已断开连接，录音已停止。已录制的内容会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 已中斷連接，因此錄音已停止。已錄下的內容會保留。"
          }
        }
      }
    },
    "recordingFailure.deviceUnavailable" : {
      "comment" : "Error in the Record window when the chosen microphone is not available. %@ is the microphone's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ غير متاح، لذا لا يستطيع TextMouth التسجيل منه. اختر ميكروفونًا آخر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ পাওয়া যাচ্ছে না, তাই TextMouth এটি থেকে রেকর্ড করতে পারছে না। অন্য একটি মাইক্রোফোন বেছে নিন।"
          }
