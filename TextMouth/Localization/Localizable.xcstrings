        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth không lưu được thư viện trước khi xóa nguồn cấp “%@”, nên không có gì bị xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 在删除订阅源“%@”之前无法存储资料库，因此没有删除任何内容。"
