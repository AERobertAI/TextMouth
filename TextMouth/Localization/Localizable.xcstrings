    "bookSettings.resetToDefaultsHint" : {
      "comment" : "Hint of the button that removes a text book's own voice, speed and pitch.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يزيل صوت هذا الكتاب وسرعته وطبقة صوته الخاصة به، فيستخدم الإعدادات الافتراضية العامة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই বইয়ের নিজস্ব ভয়েস, গতি ও পিচ সরিয়ে দেয়, ফলে এটি গ্লোবাল ডিফল্ট ব্যবহার করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Entfernt Stimme, Geschwindigkeit und Tonhöhe dieses Buchs, sodass die globalen Standardwerte gelten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes this book's own voice, speed, and pitch, so it uses the global defaults."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quita la voz, la velocidad y el tono propios de este libro, para que use los valores globales."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صدا، سرعت و زیر و بمی مخصوص این کتاب را برمی‌دارد تا از پیش‌فرض‌های سراسری استفاده کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Retire la voix, la vitesse et la hauteur propres à ce livre, qui utilise alors les valeurs globales par défaut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מסיר את הקול, המהירות וגובה הצליל של ספר זה, כך שישתמש בברירות המחדל הכלליות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस पुस्तक की अपनी आवाज़, गति और पिच हटाता है, ताकि वह वैश्विक डिफ़ॉल्ट उपयोग करे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuang suara, kecepatan, dan nada khusus buku ini, sehingga memakai default global."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rimuove voce, velocità e tono propri di questo libro, che usa così i valori predefiniti globali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このブック専用の声、速度、ピッチを取り除き、全体のデフォルトを使うようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 책 전용 음성, 속도, 음높이를 제거하여 전역 기본값을 사용하게 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Haalt de eigen stem, snelheid en toonhoogte van dit boek weg, zodat het de algemene standaardwaarden gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usuwa własny głos, prędkość i wysokość głosu tej książki, aby korzystała z ustawień globalnych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Remove a voz, a velocidade e o tom próprios deste livro, para que use os padrões globais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Убирает собственные голос, скорость и высоту тона этой книги, чтобы использовались общие значения по умолчанию."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tar bort den här bokens egen röst, hastighet och tonhöjd så att den använder de globala standardinställningarna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "นำเสียง ความเร็ว และความสูงต่ำของเสียงเฉพาะของหนังสือเล่มนี้ออก เพื่อใช้ค่าเริ่มต้นส่วนกลาง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu kitabın kendi sesini, hızını ve perdesini kaldırır; böylece genel varsayılanları kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вилучає власні голос, швидкість і висоту тону цієї книги, тому вона використовує глобальні типові значення."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس کتاب کی اپنی آواز، رفتار اور پچ ہٹاتا ہے، تاکہ یہ عالمی ڈیفالٹس استعمال کرے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gỡ giọng nói, tốc độ và cao độ riêng của sách này, để nó dùng mặc định chung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "移除此图书专属的语音、速度和音调，使其使用全局默认设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "移除此書專屬的語音、速度與音調，讓它使用全域預設值。"
          }
        }
      }
    },
