    "libraryViewsSettings.duplicateHint" : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). Duplicate's hint.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ينشئ عرضًا خاصًا بك بهذه الشروط والترتيب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই শর্ত ও সাজানো দিয়ে আপনার নিজের ভিউ তৈরি করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Erstellt eine eigene Ansicht mit diesen Bedingungen und dieser Sortierung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makes your own view with these conditions and sort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Crea una vista propia con estas condiciones y este orden."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نمای خودتان را با این شرط‌ها و مرتب‌سازی می‌سازد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Crée votre propre vue avec ces conditions et ce tri."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "יוצר תצוגה משלך עם התנאים והמיון האלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इन शर्तों और क्रम से आपका अपना दृश्य बनाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuat tampilan Anda sendiri dengan kondisi dan urutan ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Crea una tua vista con queste condizioni e questo ordinamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "この条件と並べ替えで、自分用のビューを作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 조건과 정렬로 나만의 보기를 만듭니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Maakt een eigen weergave met deze voorwaarden en sortering."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tworzy własny widok z tymi warunkami i sortowaniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cria sua própria visualização com estas condições e esta ordem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Создаёт ваше представление с этими условиями и сортировкой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Skapar en egen vy med de här villkoren och den här sorteringen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "สร้างมุมมองของคุณเองด้วยเงื่อนไขและการเรียงลำดับเหล่านี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu koşullar ve sıralamayla kendi görünümünüzü oluşturur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
