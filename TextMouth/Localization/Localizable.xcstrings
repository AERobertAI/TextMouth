    "transcriptCleanup.alreadyCleanedUp.before" : {
      "comment" : "Last sentence of the Clean Up Transcript sheet's line about a transcript cleaned up already. Undo Cleanup is the name of a button of the sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعيد “تراجع عن التنظيف” النسخة النصية السابقة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“পরিষ্কার করা পূর্বাবস্থায় ফেরান” বেছে নিলে আগের ট্রান্সক্রিপ্ট ফিরে আসে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„Bereinigung widerrufen“ stellt das Transkript von vorher wieder her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undo Cleanup puts back the transcript from before."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deshacer limpieza restaura la transcripción anterior."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«واگرد پاک‌سازی» رونوشت قبلی را برمی‌گرداند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Annuler le nettoyage rétablit la transcription précédente."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“בטל ניקוי” מחזיר את התמליל מלפני כן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“सफ़ाई पूर्ववत करें” पहले की ट्रांसक्रिप्ट वापस लाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Urungkan Perapian mengembalikan transkrip sebelumnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il comando Annulla pulizia ripristina la trascrizione precedente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「整理を取り消す」で、以前の文字起こしに戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "정리 실행 취소를 선택하면 이전 대본으로 되돌립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Maak opschoning ongedaan zet de eerdere transcriptie terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cofnij oczyszczanie przywraca wcześniejszą transkrypcję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Desfazer limpeza restaura a transcrição de antes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«Отменить исправление» возвращает прежнюю расшифровку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ångra uppstädning återställer den tidigare transkriptionen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "คำสั่ง เลิกทำการตรวจแก้ จะนำข้อความถอดเสียงเดิมกลับคืน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Temizlemeyi Geri Al, önceki transkripti geri getirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«Відмінити очищення» повертає транскрипцію, яка була раніше."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
