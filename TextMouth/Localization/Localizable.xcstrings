          }
        }
      }
    },
    "Your Mac's library isn't touched." : {
      "comment" : "Last sentence of the message of the iPhone's question before a book is removed: a copy of the book in a Mac's library stays.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
