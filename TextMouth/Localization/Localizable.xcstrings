    "interfaceTextFile.reason.unsupportedSpecifier" : {
      "comment" : "The reason a line of the person's own lines is ignored: it has a percent sign that is not one of the allowed placeholders (%@, %lld, or the numbered forms %1$@ and %1$lld, and %% for a percent sign).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
