            "value" : "The original file “%1$@” could not be moved to the Trash: %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo mover a la Papelera el archivo original “%1$@”: %2$@"
