    "audioEditError.originalNeeded.saved" : {
      "comment" : "Ends a message saying the edits need an original audio that is gone: only undoing or redoing back to the audio as last saved helps.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تراجع أو أعد للرجوع إلى الصوت كما حُفظ آخر مرة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "শেষবার সংরক্ষণের সময়ের অডিওতে ফিরতে পূর্বাবস্থায় ফেরান বা পুনরায় করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Widerrufe oder wiederhole, bis das Audio so ist, wie es zuletzt gesichert wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undo or redo back to the audio as last saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deshaz o rehaz hasta volver al audio como se guardó por última vez."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "با واگرد یا انجام مجدد به صدای آخرین ذخیره برگردید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Annulez ou rétablissez pour revenir à l’audio tel qu’il a été enregistré en dernier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בטל או בצע שוב עד לשמע כפי שנשמר לאחרונה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पिछली बार सहेजे गए ऑडियो तक पूर्ववत या फिर से करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Urungkan atau ulangi untuk kembali ke audio seperti yang terakhir disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Annulla o ripeti fino a tornare all’audio salvato l’ultima volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "最後に保存した状態のオーディオまで、取り消すかやり直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "마지막으로 저장한 오디오 상태가 될 때까지 실행 취소하거나 다시 실행하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Maak ongedaan of herhaal tot de audio zoals die voor het laatst is bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cofnij lub ponów, aby wrócić do dźwięku z ostatniego zachowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Desfaça ou refaça até voltar ao áudio como foi salvo por último."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Отмените или повторите правки, чтобы вернуться к последнему сохранённому аудио."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ångra eller gör om tills ljudet är som när det senast sparades."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ให้เลิกทำหรือทำซ้ำกลับไปที่เสียงตามที่บันทึกครั้งล่าสุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Son kaydedilen sese dönmek için geri alın veya yineleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Скасуйте або повторіть правки, щоб повернутися до аудіо, збереженого востаннє."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آخری بار محفوظ کیے گئے آڈیو تک کالعدم یا دوبارہ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hãy hoàn tác hoặc làm lại về âm thanh như lần lưu gần nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "请通过撤销或重做回到上次存储的音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "請用還原或重做，回到上次儲存時的音訊。"
          }
        }
      }
    },
