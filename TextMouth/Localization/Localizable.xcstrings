    "phoneReader.navigationUnitHint" : {
      "comment" : "Hint of the iPhone reader's Navigation unit control.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يختار الوحدة التي يتنقل بها زر التشغيل وأزرار التخطي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“চালান” ও এগিয়ে-পিছিয়ে যাওয়ার বোতামগুলো কিসের ভিত্তিতে এগোয় তা বেছে নেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Legt fest, um welche Einheit „Wiedergeben“ und die Sprungtasten weiterspringen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chooses what Play and the skip buttons move by."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige en qué unidad avanzan Reproducir y los botones de salto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "واحدی را که «پخش» و دکمه‌های رد شدن با آن حرکت می‌کنند انتخاب می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisit l’unité de déplacement de Lire et des boutons de saut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בוחר את היחידה שבה “נגן” ולחצני הדילוג מתקדמים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चुनता है कि “चलाएँ” और आगे-पीछे जाने के बटन किस इकाई से चलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Memilih unit gerak Putar dan tombol lompat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sceglie di quanto si spostano Riproduci e i pulsanti di salto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「再生」とスキップボタンで移動する単位を選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "재생 및 건너뛰기 버튼의 이동 단위를 선택합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kiest waarmee Speel af en de springknoppen vooruit- of teruggaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wybiera jednostkę, według której działają Odtwórz i przyciski przewijania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escolhe a unidade pela qual Reproduzir e os botões Avançar e Retroceder se movem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Выбирает шаг перехода для воспроизведения и кнопок перемотки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Väljer vad ”Spela upp” och hoppknapparna flyttar med."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เลือกหน่วยที่การเล่นและปุ่มข้ามเลื่อนไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Oynat ve atlama düğmelerinin neye göre ilerleyeceğini seçer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вибирає, на яку одиницю переходять «Відтворити» та кнопки перемотування."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "منتخب کرتا ہے کہ “چلائیں” اور چھلانگ کے بٹن کس اکائی سے آگے بڑھیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chọn đơn vị mà nút Phát và các nút tua di chuyển theo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "选取“播放”和跳转按钮的移动单位。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選擇「播放」和跳轉按鈕移動的單位。"
          }
        }
      }
    },
    "phoneReader.nextHeadingHint" : {
      "comment" : "Hint of the iPhone reader's Next Heading button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ينتقل إلى العنوان الرئيسي التالي مع إبقاء وحدة التنقل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পরের হেডিংয়ে যায়, নেভিগেশন ইউনিট একই রেখে।"
          }
        },
        "de" : {
          "stringUnit" : {
