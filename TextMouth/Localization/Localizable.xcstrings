    "transcription.stopHint" : {
      "comment" : "VoiceOver hint of the Cancel button of the Transcribe Audio sheet while transcribing.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يوقف التفريغ. يبقى الكتاب كما كان."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ট্রান্সক্রাইব করা থামায়। বইটি যেমন ছিল তেমনই থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppt das Transkribieren. Das Buch bleibt unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops transcribing. The book stays as it was."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detiene la transcripción. El libro queda como estaba."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "رونویسی را متوقف می‌کند. کتاب همان‌طور که بود می‌ماند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrête la transcription. Le livre reste tel qu’il était."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "עוצר את התמלול. הספר נשאר כפי שהיה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ट्रांसक्राइब करना रोकता है। पुस्तक जैसी थी वैसी रहती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menghentikan transkripsi. Buku tetap seperti semula."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe la trascrizione. Il libro resta com’era."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文字起こしを停止します。ブックは元のままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "대본 만들기를 중지합니다. 책은 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stopt het transcriberen. Het boek blijft zoals het was."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zatrzymuje transkrybowanie. Książka pozostaje bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe a transcrição. O livro continua como estava."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Останавливает расшифровку. Книга остаётся прежней."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Slutar transkribera. Boken förblir som den var."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หยุดการถอดเสียง หนังสือจะคงเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yazıya dökmeyi durdurur. Kitap olduğu gibi kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Зупиняє транскрибування. Книга лишається такою, як була."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ٹرانسکرائب کرنا روکتا ہے۔ کتاب جیسی تھی ویسی ہی رہتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dừng chép lời. Sách giữ nguyên như cũ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止转录。图书保持原样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止轉錄。書籍維持原狀。"
          }
        }
      }
    },
    "transcription.textInCloud" : {
      "comment" : "Line of the Transcribe Audio sheet, and an error, when the book's text file has not been downloaded from iCloud to this Mac.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نص الكتاب موجود في iCloud فقط، لذا يتركه TextMouth. نزّل الكتاب ثم حاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইয়ের টেক্সট শুধু iCloud-এ আছে, তাই TextMouth সেটিতে হাত দেয় না। বইটি ডাউনলোড করুন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Text des Buchs ist nur in iCloud, daher lässt TextMouth ihn unverändert. Lade das Buch herunter und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The book's text is only in iCloud, so TextMouth leaves it. Download the book, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto del libro solo está en iCloud, así que TextMouth no lo toca. Descarga el libro y vuelve a intentarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "متن کتاب فقط در iCloud است، پس TextMouth به آن دست نمی‌زند. کتاب را بارگیری کنید، سپس دوباره تلاش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le texte du livre est seulement dans iCloud, donc TextMouth n’y touche pas. Téléchargez le livre, puis réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הטקסט של הספר נמצא רק ב-iCloud, ולכן TextMouth משאיר אותו. הורד את הספר ונסה שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पुस्तक का टेक्स्ट केवल iCloud में है, इसलिए TextMouth उसे छोड़ देता है। पुस्तक डाउनलोड करें, फिर से प्रयास करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Teks buku hanya ada di iCloud, jadi TextMouth membiarkannya. Unduh buku, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo del libro è solo in iCloud, quindi TextMouth non lo tocca. Scarica il libro, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブックのテキストは iCloud にしかないため、TextMouth はそのままにします。ブックをダウンロードしてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책의 텍스트가 iCloud에만 있어서 TextMouth가 그대로 둡니다. 책을 다운로드한 다음 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De tekst van het boek staat alleen in iCloud, dus TextMouth laat die ongemoeid. Download het boek en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tekst książki jest tylko w iCloud, więc TextMouth go pomija. Pobierz książkę, a potem spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O texto do livro está apenas no iCloud, então o TextMouth o deixa como está. Baixe o livro e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Текст книги только в iCloud, поэтому TextMouth его не трогает. Загрузите книгу и повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bokens text finns bara i iCloud, så TextMouth låter den vara. Hämta boken och försök sedan igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ข้อความของหนังสืออยู่ใน iCloud เท่านั้น TextMouth จึงปล่อยไว้ ให้ดาวน์โหลดหนังสือ แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitabın metni yalnızca iCloud'da olduğundan TextMouth dokunmaz. Kitabı indirin, sonra tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Текст книги лише в iCloud, тому TextMouth його не чіпає. Завантажте книгу й повторіть спробу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب کا متن صرف iCloud میں ہے، اس لیے TextMouth اسے نہیں چھیڑتا۔ کتاب ڈاؤن لوڈ کریں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Văn bản của sách chỉ có trên iCloud, nên TextMouth bỏ qua. Hãy tải sách về, rồi thử lại."
