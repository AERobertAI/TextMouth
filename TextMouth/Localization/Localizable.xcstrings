    "Transcribe" : {
      "comment" : "Button of the Transcribe Audio sheet that starts transcribing the audiobook.\nButton of the question offered after an import that opens Transcribe Audio for the new audiobook."
    },
    "Transcribe %@" : {
      "comment" : "Heading of the Transcribe Audio sheet before transcribing. %@ is the audiobook's title."
    },
    "Transcribe Audio" : {
      "comment" : "Heading of the Transcribe Audio sheet when it can only explain why transcription is not possible.\nTitle of the alert saying why Transcribe Audio did nothing."
