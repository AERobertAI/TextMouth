    "phoneRow.emptyReadingList" : {
      "comment" : "The only row of the iPhone's empty Reading List. \"Add to Reading List\" is the name of a book's action, so keep it the same as that action's label.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "قائمة القراءة فارغة. لإضافة كتاب، اختر “إضافة إلى قائمة القراءة” من إجراءاته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পড়ার তালিকা খালি। একটি বই যোগ করতে এর অ্যাকশন থেকে “পড়ার তালিকায় যোগ করুন” বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Leseliste ist leer. Um ein Buch hinzuzufügen, wähle bei seinen Aktionen „Zur Leseliste hinzufügen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The reading list is empty. To add a book, choose Add to Reading List from its actions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La lista de lectura está vacía. Para agregar un libro, elige Agregar a la lista de lectura en sus acciones."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فهرست مطالعه خالی است. برای افزودن کتاب، «افزودن به فهرست مطالعه» را از کارهای آن انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La liste de lecture est vide. Pour ajouter un livre, choisissez Ajouter à la liste de lecture dans ses actions."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "רשימת הקריאה ריקה. כדי להוסיף ספר, בחר “הוסף לרשימת הקריאה” מהפעולות שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "रीडिंग लिस्ट ख़ाली है। पुस्तक जोड़ने के लिए उसकी क्रियाओं से “रीडिंग लिस्ट में जोड़ें” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Daftar bacaan kosong. Untuk menambahkan buku, pilih Tambahkan ke Daftar Bacaan dari tindakannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’elenco di lettura è vuoto. Per aggiungere un libro, scegli Aggiungi all’elenco di lettura dalle sue azioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "リーディングリストは空です。ブックを追加するには、そのアクションから「リーディングリストに追加」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "읽기 목록이 비어 있습니다. 책을 추가하려면 해당 책의 동작에서 읽기 목록에 추가를 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De leeslijst is leeg. Kies Voeg toe aan leeslijst in de acties van een boek om een boek toe te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lista czytelnicza jest pusta. Aby dodać książkę, wybierz Dodaj do listy czytelniczej z jej akcji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A lista de leitura está vazia. Para adicionar um livro, escolha Adicionar à lista de leitura em suas ações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Список для чтения пуст. Чтобы добавить книгу, выберите «Добавить в список для чтения» в её действиях."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Läslistan är tom. Om du vill lägga till en bok väljer du Lägg till i läslistan bland dess åtgärder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "รายการอ่านว่างเปล่า หากต้องการเพิ่มหนังสือ ให้เลือก เพิ่มไปยังรายการอ่าน จากการดำเนินการของหนังสือ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Okuma listesi boş. Kitap eklemek için eylemlerinden Okuma Listesine Ekle'yi seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Список читання порожній. Щоб додати книгу, виберіть «Додати до списку читання» в її діях."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مطالعے کی فہرست خالی ہے۔ کتاب شامل کرنے کے لیے اس کی کارروائیوں سے “مطالعے کی فہرست میں شامل کریں” منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Danh sách đọc trống. Để thêm sách, hãy chọn Thêm vào danh sách đọc trong các hành động của sách."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "阅读列表为空。要添加图书，请从其操作中选取“添加到阅读列表”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "閱讀列表是空的。若要加入書籍，請從其動作中選擇「加入閱讀列表」。"
          }
        }
      }
    },
