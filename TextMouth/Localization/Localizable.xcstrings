    "folderNavigation.nextArticleCancelled" : {
      "comment" : "VoiceOver announcement when the listener cancelled the download of the next feed article that Next in Folder started.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أُلغي تنزيل المقالة التالية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পরবর্তী নিবন্ধের ডাউনলোড বাতিল করা হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
