    "readerOgg.needsConverting" : {
      "comment" : "What Play says for a book found still in Ogg, whose conversion TextMouth starts.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحتاج صوت هذا الكتاب إلى التحويل من Ogg إلى AAC. يحوّله TextMouth الآن، وسيُشغَّل عندما ينتهي ذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই বইয়ের অডিও Ogg থেকে AAC-তে রূপান্তর করা দরকার। TextMouth এখন তা রূপান্তর করছে, এবং শেষ হলে এটি চলবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Audio dieses Buchs muss von Ogg in AAC umgewandelt werden. TextMouth wandelt es jetzt um, und es wird wiedergegeben, wenn das fertig ist."
          }
