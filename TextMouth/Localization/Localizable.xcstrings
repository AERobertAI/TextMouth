    "settings.autoPlayExplanation" : {
      "comment" : "Explanation under the Auto-play after navigation checkbox in the Playback settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يبدأ التشغيل تلقائيًا عند الانتقال إلى عنوان رئيسي أو إشارة مرجعية أو نتيجة بحث."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "হেডিং, বুকমার্ক বা অনুসন্ধানের ফলাফলে গেলে নিজে থেকে চালানো শুরু হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Startet die Wiedergabe automatisch, wenn du zu einer Überschrift, einem Lesezeichen oder einem Suchergebnis navigierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically start playing when you navigate to a heading, bookmark, or search result."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Empieza a reproducir automáticamente cuando navegas a un encabezado, un marcador o un resultado de búsqueda."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هنگام رفتن به یک سرفصل، نشانک یا نتیجه جست‌وجو، پخش به‌طور خودکار شروع شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Démarre automatiquement la lecture quand vous accédez à un en-tête, à un signet ou à un résultat de recherche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מתחיל לנגן אוטומטית כשעוברים לכותרת, לסימנייה או לתוצאת חיפוש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "जब आप किसी हेडिंग, बुकमार्क या खोज परिणाम पर जाते हैं, तो प्लेबैक अपने आप शुरू हो जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mulai memutar secara otomatis saat Anda bernavigasi ke tajuk, markah, atau hasil pencarian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Avvia automaticamente la riproduzione quando vai a un’intestazione, un segnalibro o un risultato di ricerca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "見出し、ブックマーク、検索結果に移動したとき、自動的に再生を開始します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "표제, 북마크 또는 검색 결과로 이동하면 자동으로 재생을 시작합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Begint automatisch met afspelen wanneer je naar een kop, bladwijzer of zoekresultaat navigeert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Automatycznie rozpoczyna odtwarzanie po przejściu do nagłówka, zakładki lub wyniku wyszukiwania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Começa a reproduzir automaticamente ao navegar para um cabeçalho, um marcador ou um resultado de busca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Автоматически начинать воспроизведение при переходе к заголовку, закладке или результату поиска."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Börja spela upp automatiskt när du navigerar till en rubrik, ett bokmärke eller ett sökresultat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เริ่มเล่นอัตโนมัติเมื่อไปยังหัวข้อ ที่คั่นหน้า หรือผลการค้นหา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bir başlığa, yer imine veya arama sonucuna gittiğinizde oynatmayı otomatik olarak başlatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Автоматично починати відтворення після переходу до заголовка, закладки або результату пошуку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کسی سرخی، بک مارک یا تلاش کے نتیجے پر جانے پر خود بخود چلنا شروع ہو جاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tự động bắt đầu phát khi bạn điều hướng đến một đề mục, dấu trang hoặc kết quả tìm kiếm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "导航到章节标题、书签或搜索结果时自动开始播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "前往標題、書籤或搜尋結果後，自動開始播放。"
          }
        }
      }
    },
