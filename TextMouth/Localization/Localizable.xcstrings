          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "השמע של הספר השתנה מאז שתומלל (%@), ולכן התמליל כבר אינו מתאים. תמלל שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ट्रांसक्राइब करने के बाद से पुस्तक का ऑडियो बदल गया है (%@), इसलिए ट्रांसक्रिप्ट अब मेल नहीं खाती। फिर से ट्रांसक्राइब करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
