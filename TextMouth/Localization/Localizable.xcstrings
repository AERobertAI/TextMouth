        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "המקומות, הסימניות והתמלילים שלהן, אם יש, נשמרים, ואפשר להוריד אותן שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
