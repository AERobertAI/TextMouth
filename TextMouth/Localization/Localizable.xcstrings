                  "value" : "TextMouth también está abierto en «%1$@» (activo hace %2$lld minutos)."
                }
              }
            }
          }
        },
        "it" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "TextMouth è aperto anche su “%@” (attivo %lld di minuti fa)."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "TextMouth è aperto anche su “%@” (attivo %lld minuto fa)."
                }
              },
              "other" : {
                "stringUnit" : {
