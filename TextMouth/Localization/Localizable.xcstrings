          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Anulowano pobieranie poprzedniego artykułu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Download do artigo anterior cancelado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Загрузка предыдущей статьи отменена."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
