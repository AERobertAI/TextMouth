    "miscellaneousSettings.bluetoothExplanation" : {
      "comment" : "Explanation under the Enable Bluetooth monitoring switch in the Miscellaneous settings. macOS is the name of the operating system.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يمنع أمر التشغيل الزائف الذي يرسله macOS عند إزالة سماعات Bluetooth."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth হেডফোন খুলে নিলে macOS যে অনাকাঙ্ক্ষিত চালানোর কমান্ড পাঠায়, তা আটকে দেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Blockiert den fehlerhaften Wiedergabebefehl, den macOS sendet, wenn Bluetooth-Kopfhörer abgenommen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocks the spurious play command macOS sends when Bluetooth headphones are removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bloquea la falsa orden de reproducción que macOS envía al quitarse unos auriculares Bluetooth."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "از فرمان پخش نادرستی که macOS هنگام برداشتن هدفون Bluetooth می‌فرستد جلوگیری می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bloque la commande de lecture parasite que macOS envoie quand des écouteurs Bluetooth sont retirés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "חוסם את פקודת הניגון השגויה ש-macOS שולח כשמסירים אוזניות Bluetooth."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth हेडफ़ोन हटाने पर macOS द्वारा भेजे जाने वाले अनचाहे प्ले कमांड को रोकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Memblokir perintah putar palsu yang dikirim macOS saat headphone Bluetooth dilepas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Blocca il comando di riproduzione indesiderato che macOS invia quando le cuffie Bluetooth vengono rimosse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth ヘッドフォンを外したときに macOS が送る不要な再生コマンドをブロックします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth 헤드폰을 뺄 때 macOS가 보내는 불필요한 재생 명령을 차단합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Blokkeert het onterechte afspeelcommando dat macOS verstuurt wanneer je Bluetooth-koptelefoon wordt losgekoppeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Blokuje fałszywe polecenie odtwarzania, które macOS wysyła po odłączeniu słuchawek Bluetooth."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bloqueia o comando de reprodução indevido que o macOS envia quando fones Bluetooth são removidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Блокирует ложную команду воспроизведения, которую macOS отправляет при отключении наушников Bluetooth."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Blockerar det felaktiga uppspelningskommando som macOS skickar när Bluetooth-hörlurar tas bort."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ป้องกันคำสั่งเล่นที่ไม่ควรเกิดขึ้นซึ่ง macOS ส่งเมื่อถอดหูฟัง Bluetooth"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth kulaklıklar çıkarıldığında macOS'in gönderdiği gereksiz oynatma komutunu engeller."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Блокує хибну команду відтворення, яку macOS надсилає, коли відключаються навушники Bluetooth."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth ہیڈ فون ہٹانے پر macOS کی طرف سے بھیجے جانے والے غیر ضروری چلانے کے حکم کو روکتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chặn lệnh phát giả mà macOS gửi khi tháo tai nghe Bluetooth."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "阻止 macOS 在移除 Bluetooth 耳机时发出的多余播放命令。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "阻止 macOS 在 Bluetooth 耳機被取下時傳送的錯誤播放指令。"
          }
        }
      }
    },
