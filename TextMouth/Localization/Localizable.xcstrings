    },
    "Transcribing %@." : {
      "comment" : "What VoiceOver hears as a transcription begins, when the audio's length is not known. %@ is the audiobook's title."
    },
    "Transcribing again replaces it." : {
      "comment" : "Last sentence of the Transcribe Audio sheet's line about a transcript made by a later version of TextMouth."
    },
    "Transcribing again replaces this transcript." : {
      "comment" : "Last sentence of the Transcribe Audio sheet's line about the transcript a book already has."
    },
    "Transcribing it takes %@." : {
      "comment" : "Second sentence of the question offering to transcribe a new audiobook. %@ is the time it should take, such as \"about 6 minutes\" or \"less than a minute\"."
    },
    "Transcript" : {
      "comment" : "Label of the detail in Book Information that says where the book's transcript came from.\nThe name of the Transcript checkbox in the Export dialog: the book's transcript."
    },
    "Transcription" : {
      "comment" : "Heading of the group of transcription settings in Playback settings."
    },
    "Transcription doesn't support %@." : {
      "comment" : "Error shown when the chosen transcription language cannot be transcribed. %@ is the language's name."
    },
    "Transcription language" : {
      "comment" : "Label of the pop-up in Playback settings that chooses the language audiobooks are transcribed in."
    },
    "Transcription needs macOS 26 or later." : {
      "comment" : "Error shown when transcription is tried on a Mac whose system is too old."
    },
    "Transcription progress" : {
      "comment" : "VoiceOver label of the progress bar in the Transcribe Audio sheet."
    },
    "Transcription stopped." : {
      "comment" : "What VoiceOver hears when a transcription stopped for a reason that has no words of its own."
    },
    "Transcription stopped: %@" : {
      "comment" : "What VoiceOver hears when a transcription stopped because of an error from the system. %@ is the system's own sentence."
    },
    "Transcription stopped: %@." : {
      "comment" : "Error shown when the speech recognizer failed. %@ is the reason, a short phrase in English."
    },
    "Transcription was cancelled." : {
      "comment" : "What VoiceOver hears, and the Transcribe Audio sheet shows, when the user cancels a transcription."
    },
    "Transcription works on one audiobook at a time." : {
      "comment" : "First sentence of the alert shown when Transcribe Audio is chosen with several books selected."
    },
    "Tries again to save every change that could not be saved" : {
      "comment" : "VoiceOver hint of the Retry Saving button in Storage settings."
    },
    "Tries again to save the recording as an audiobook." : {
      "comment" : "VoiceOver hint of the Save Again button of the Record window."
    },
    "Tries to get the book again" : {
      "comment" : "Hint of the Try Again button of the reader's view for a book that could not be got from the cloud."
    },
    "Trim End" : {
      "comment" : "Name of an edit, as the Undo and Redo menu items and VoiceOver say it after \"Undo\" or \"Redo\": trimming the end of the audio."
    },
    "Trim Silence at Both Ends" : {
      "comment" : "Title of a premade audio filter preset: removes the silence at the start and at the end of the audio."
    },
    "Trim Start" : {
      "comment" : "Name of an edit, as the Undo and Redo menu items and VoiceOver say it after \"Undo\" or \"Redo\": trimming the start of the audio."
    },
    "Trim to Selection" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Deletes all audio outside the selection.\nName of an edit, as the Undo and Redo menu items say it after \"Undo\" or \"Redo\": the audio editor's Trim to Selection, which trims the start and the end together."
    },
    "Trimmed to the selection: %@ kept." : {
      "comment" : "Said as the audio editor's Trim to Selection trims. %@ is the length kept, in words."
    },
    "Try Again" : {
      "comment" : "Button of the library index recovery sheet that reads the index file again. Also the name sentences use for it.\nButton of the reader's alert about a chapter that could not be downloaded; it tries the download again.\nButton of the reader's view for a book that could not be got from the cloud; it tries again.\nButton on the Library Not Available screen that checks the library's folder again."
    },
    "Try a Double Press" : {
      "comment" : "Button in the Shortcuts tab of Settings that lets the listener press a key twice to find out whether the double press time counts the two presses as a double press."
    },
    "Try again in a moment." : {
      "comment" : "Last sentence of why a cloud operation was refused for now: wait and try again."
    },
    "Try again once that move is done." : {
      "comment" : "Last sentence of why an operation was refused while the library is being moved."
    },
    "Try again once the book has downloaded." : {
      "comment" : "Ends a message saying a file of the book is only in the cloud and isn't on this Mac yet: what to do about it."
    },
    "Try again when that finishes." : {
      "comment" : "Last sentence of why an operation was refused while something else finishes."
    },
    "Try again." : {
      "comment" : "Last sentence of why a move of the data directory did not finish: what to do."
    },
    "Turn off writing to the file, or download the book first." : {
      "comment" : "Second sentence of the message when Save in Book Information is refused because the book's EPUB file is only in the cloud: what to do."
    },
    "Turn off “%@” to save the metadata to the library only." : {
      "comment" : "Second sentence of that message. %@ is the shown name of the editor's switch that also writes the file, quoted."
    },
    "Two different keys, not a double press." : {
      "comment" : "Announced by VoiceOver at the end of a trial of the double press time when the two presses were of different keys."
    },
    "Two presses, %@ apart. Set the time above %@ to count them as one." : {
      "comment" : "Announced by VoiceOver at the end of a trial of the double press time when the two presses were too far apart for the time set. Both %1$@ and %2$@ are the time between the presses, such as \"0.7 seconds\"; the listener should set the double press time above it.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Two presses, %1$@ apart. Set the time above %2$@ to count them as one."
          }
        }
      }
    },
    "Two presses, %@ apart. The double press time goes up to %@." : {
      "comment" : "Announced by VoiceOver at the end of a trial of the double press time when the two presses were farther apart than the longest time allowed. %1$@ is the time between the presses, such as \"2.5 seconds\", and %2$@ is the longest time allowed, such as \"2 seconds\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Two presses, %1$@ apart. The double press time goes up to %2$@."
          }
        }
      }
    },
    "Type a chain of filters." : {
      "comment" : "Shown under a filter preset's chain field while it is empty."
    },
    "Type a page as the book numbers it, such as 12 or xii." : {
      "comment" : "Last sentence of the Go to Page field's hint: what the user may type. 12 and xii are examples of page labels, a number and a roman numeral."
    },
    "Type a page number." : {
      "comment" : "Message when Go to Page is chosen with nothing typed in its field."
    },
    "Type a percent from 0 to 100, such as 47.5." : {
      "comment" : "Hint of the Go to Percent field: what the user may type. 47.5 is an example number; write it as the language writes numbers."
    },
    "Type a podcast's title or publisher, then press Return to search Apple's directory" : {
      "comment" : "VoiceOver hint of the podcast search field. Return is the Return key."
    },
    "Type a time, such as 12:04.3, 1:02:03, or 75.5." : {
      "comment" : "Shown or spoken when a time field holds nothing, or something that is not a time (Go to Time, Insert Silence, the reader's Go to Time). The examples are clock times and seconds."
    },
    "Type a title, then save again." : {
      "comment" : "Second sentence of that message: what to do."
    },
    "Type or paste a feed or web page address, then press Return" : {
      "comment" : "VoiceOver hint of the field where the listener types a feed's address. Return is the Return key."
    },
    "Type straight quotation marks: in TextEdit, turn off Smart Quotes under Edit, Substitutions." : {
      "comment" : "Third sentence of the Edit Manifest explanation. TextEdit is the Mac's text editor; Smart Quotes, Edit and Substitutions are its menu names, so use the words macOS shows for them."
    },
    "Type text to find in every book of the library." : {
      "comment" : "Status line of the Search Library window before anything is typed."
    },
    "Type to search the book's transcript" : {
      "comment" : "VoiceOver hint of the search field in Search in Book when the book searched is a transcribed audiobook."
    },
    "Type to search the text of every book in the library" : {
      "comment" : "VoiceOver hint of the search field in the Search Library window."
    },
    "Type to search within the book" : {
      "comment" : "VoiceOver hint of the search field in Search in Book when the book searched is a text book."
    },
    "UTF-16 (big-endian)" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. The name a listener hears for encoding: the catalog's for one of its own, \"UTF-8\", the Unicode encodings with their byte order in words (\"UTF-16 (little-endian)\"), and any other by its IANA name (TextFileDecoder.name(of:)), such as an encoding an HTML file declares that the catalog does not hold. This is the case .utf16BigEndian."
    },
    "UTF-16 (little-endian)" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. The name a listener hears for encoding: the catalog's for one of its own, \"UTF-8\", the Unicode encodings with their byte order in words (\"UTF-16 (little-endian)\"), and any other by its IANA name (TextFileDecoder.name(of:)), such as an encoding an HTML file declares that the catalog does not hold. This is the case .utf16LittleEndian."
    },
    "UTF-32 (big-endian)" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. The name a listener hears for encoding: the catalog's for one of its own, \"UTF-8\", the Unicode encodings with their byte order in words (\"UTF-16 (little-endian)\"), and any other by its IANA name (TextFileDecoder.name(of:)), such as an encoding an HTML file declares that the catalog does not hold. This is the case .utf32BigEndian."
    },
    "UTF-32 (little-endian)" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. The name a listener hears for encoding: the catalog's for one of its own, \"UTF-8\", the Unicode encodings with their byte order in words (\"UTF-16 (little-endian)\"), and any other by its IANA name (TextFileDecoder.name(of:)), such as an encoding an HTML file declares that the catalog does not hold. This is the case .utf32LittleEndian."
    },
    "UTF-8" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. The name a listener hears for encoding: the catalog's for one of its own, \"UTF-8\", the Unicode encodings with their byte order in words (\"UTF-16 (little-endian)\"), and any other by its IANA name (TextFileDecoder.name(of:)), such as an encoding an HTML file declares that the catalog does not hold. This is the case .utf8."
    },
    "Uncontracted" : {
      "comment" : "How a braille table contracts, for a table with no grade that writes every letter out."
    },
    "Uncontracted (Grade %@)" : {
      "comment" : "How a braille table contracts, for a table of one grade that writes every letter out. %@ is the grade, an identifier such as 1."
    },
    "Underscore" : {
      "comment" : "Name of the punctuation key \"_\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Underscore\"."
    },
    "Undid %@." : {
      "comment" : "Said as the audio editor's Undo undoes an edit. %@ is the edit's name, such as \"Cut 2.5 Seconds\"."
    },
    "Undid the cleanup of the transcript of %@." : {
      "comment" : "What VoiceOver hears once a transcript's cleanup is undone. %@ is the audiobook's title."
    },
    "Undo" : {
      "comment" : "Name of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Undo\".\nName of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Undoes the last edit.\nName of the Edit menu's Undo command, in a sentence saying why a keyboard shortcut cannot take its key."
    },
    "Undo %@" : {
      "comment" : "Title of the audio editor's Undo button. %@ is the name of the edit it would undo, such as \"Cut 2.5 Seconds\"."
    },
    "Undo Cleanup" : {
      "comment" : "Button of the Clean Up Transcript sheet that puts back the transcript from before the last cleanup."
    },
    "Undo Cleanup puts back the transcript from before." : {
      "comment" : "Last sentence of the Clean Up Transcript sheet's line about a transcript cleaned up already. Undo Cleanup is the name of a button of the sheet."
    },
    "Undo or redo back to the audio as last saved." : {
      "comment" : "Ends a message saying the edits need an original audio that is gone: only undoing or redoing back to the audio as last saved helps."
    },
    "Undoes every edit, back to the original; Redo brings them back." : {
      "comment" : "Hint of the audio editor's Revert to Original button. \"Redo\" is the name of a command."
    },
    "Undoes the newest edit." : {
      "comment" : "Hint of the audio editor's Undo button."
    },
    "Unknown" : {
      "comment" : "Shown in place of a time (hours, minutes and seconds) that is not a usable number, such as an enormous or missing length.\nThe author shown for a book whose author nothing names, in the library's author column and a book's information."
    },
    "Unknown Length" : {
      "comment" : "A length of audio that is no length (not a finite number of seconds), as a menu item's title-cased words, such as the Undo item's \"Cut Unknown Length\"."
    },
    "Unknown duration" : {
      "comment" : "Spoken in place of a length of time that is not a usable number, such as an enormous or missing length."
    },
    "Unopened" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. What a book's summary says of a book never opened.\nText of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. A reading state as the pop-up names it. This is the case .unopened."
    },
    "Unread: %@ couldn't be read (%@), %@" : {
      "comment" : "A file Compare Libraries could not read. %1$@ names the file, %2$@ is the reason in English, as the file's reader worded it, and %3$@ is the clause that says what follows from it.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unread: %1$@ couldn't be read (%2$@), %3$@"
          }
        }
      }
    },
    "Unread: %@ hasn't arrived from the cloud after %lld seconds, %@" : {
      "comment" : "A file Compare Libraries could not read. %1$@ names the file, %2$lld is how many seconds TextMouth waited for it, a count, and %3$@ is the clause that says what follows from it.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
