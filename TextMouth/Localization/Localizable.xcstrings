    "Books Imported" : {
      "comment" : "Title of the library's alert as a ZIP batch that added several books ends with something to tell about some of them, such as chapters left out. Title case.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
