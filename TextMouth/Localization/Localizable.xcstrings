    "feed.searchHint" : {
      "comment" : "VoiceOver hint of the podcast search field. Return is the Return key.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اكتب عنوان بودكاست أو ناشره، ثم اضغط Return للبحث في دليل Apple"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পডকাস্টের শিরোনাম বা প্রকাশক টাইপ করার পর রিটার্ন চাপলে Apple-এর ডিরেক্টরিতে অনুসন্ধান হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gib den Titel oder Herausgeber eines Podcasts ein und drücke dann Return, um das Verzeichnis von Apple zu durchsuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type a podcast's title or publisher, then press Return to search Apple's directory"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escribe el título o el editor de un podcast y pulsa Retorno para buscar en el directorio de Apple"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عنوان یا ناشر یک پادکست را تایپ کنید، سپس برای جست‌وجو در فهرست Apple، Return را فشار دهید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saisissez le titre ou l’éditeur d’un podcast, puis appuyez sur Retour pour rechercher dans l’annuaire d’Apple."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הקלד שם או מפרסם של פודקאסט, ואז הקש Return כדי לחפש במאגר הפודקאסטים של Apple."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पॉडकास्ट का शीर्षक या प्रकाशक टाइप करें, फिर Apple की डायरेक्टरी में खोजने के लिए रिटर्न दबाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ketik judul atau penerbit podcast, lalu tekan Return untuk mencari di direktori Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Digita il titolo o l’editore di un podcast, poi premi Invio per cercare nella directory di Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Podcast のタイトルまたは発行元を入力して Return キーを押すと、Apple のディレクトリを検索します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "팟캐스트 제목이나 게시자를 입력한 다음 Return 키를 눌러 Apple 디렉터리에서 검색합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Typ de titel of uitgever van een podcast en druk op Return om in de gids van Apple te zoeken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wpisz tytuł lub wydawcę podcastu, a potem naciśnij Return, aby przeszukać katalog Apple."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Digite o título ou o publicador de um podcast e pressione Return para buscar no diretório da Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Введите название или издателя подкаста, затем нажмите Return, чтобы искать в каталоге Apple."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Skriv titeln eller utgivaren för en podcast och tryck sedan på Retur för att söka i Apples katalog."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "พิมพ์ชื่อหรือผู้เผยแพร่ของพอดแคสต์ แล้วกด Return เพื่อค้นหาในไดเรกทอรีของ Apple"
          }
        },
        "tr" : {
          "stringUnit" : {
