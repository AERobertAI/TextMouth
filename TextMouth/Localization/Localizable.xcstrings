    "storageSettings.rebuildDirectoryHint" : {
      "comment" : "VoiceOver hint of the Rebuild Directory button in Storage settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعيد إنشاء بنية الدليل وينقل أي كتب تستخدم التخزين القديم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ডিরেক্টরির কাঠামো আবার তৈরি করে এবং পুরোনো স্টোরেজ ব্যবহার করা বইগুলো স্থানান্তর করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Erstellt die Ordnerstruktur neu und migriert Bücher, die noch das alte Speicherformat nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recreates the directory structure and migrates any books using old storage"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vuelve a crear la estructura de directorios y migra los libros que usan el almacenamiento antiguo"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ساختار دایرکتوری را دوباره می‌سازد و کتاب‌هایی را که از ذخیره‌سازی قدیمی استفاده می‌کنند منتقل می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Recrée la structure du dossier et migre les livres qui utilisent l’ancien stockage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "יוצר מחדש את מבנה התיקיות ומעביר ספרים שמשתמשים באחסון ישן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "डायरेक्टरी संरचना फिर से बनाता है और पुराने संग्रहण वाली पुस्तकों को स्थानांतरित करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuat ulang struktur direktori dan memigrasikan buku yang memakai penyimpanan lama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ricrea la struttura della cartella e migra i libri che usano la vecchia archiviazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ディレクトリ構造を再作成し、古い保存方式を使っているブックを移行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "디렉터리 구조를 다시 만들고 이전 저장 방식을 사용하는 책을 마이그레이션합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Maakt de directorystructuur opnieuw en migreert boeken die nog de oude opslag gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Odtwarza strukturę folderów i migruje książki korzystające ze starego sposobu przechowywania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Recria a estrutura da pasta de dados e migra os livros que usam o armazenamento antigo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Заново создаёт структуру каталога и переносит книги, использующие старое хранилище."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
