    "sync.booksOnDevice.announce.all" : {
      "comment" : "Said aloud after the person chose All books for this device. Books this device lacks download after the next sync.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "كل الكتب. الكتب غير الموجودة هنا تُنزَّل بعد المزامنة التالية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সব বই। যে বইগুলো এখানে নেই, পরের সিঙ্কের পর সেগুলো ডাউনলোড হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alle Bücher. Fehlende Bücher werden nach der nächsten Synchronisierung heruntergeladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All books. Books missing here download after the next sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Todos los libros. Los libros que faltan aquí se descargan después de la próxima sincronización."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "همه کتاب‌ها. کتاب‌هایی که اینجا نیستند، پس از همگام‌سازی بعدی بارگیری می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tous les livres. Les livres absents ici sont téléchargés après la prochaine synchronisation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כל הספרים. ספרים שחסרים כאן יורדו לאחר הסנכרון הבא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सभी पुस्तकें। यहाँ जो पुस्तकें नहीं हैं, वे अगले सिंक के बाद डाउनलोड होंगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Semua buku. Buku yang belum ada di sini diunduh setelah sinkronisasi berikutnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tutti i libri. I libri mancanti qui vengono scaricati dopo la prossima sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "すべてのブック。このデバイスにないブックは、次の同期のあとにダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "모든 책. 이 기기에 없는 책은 다음 동기화 후 다운로드됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alle boeken. Boeken die hier ontbreken, worden na de volgende synchronisatie gedownload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wszystkie książki. Książki, których tu brakuje, zostaną pobrane po następnej synchronizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Todos os livros. Os livros que faltam aqui são baixados após a próxima sincronização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Все книги. Недостающие здесь книги загрузятся после следующей синхронизации."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alla böcker. Böcker som saknas här laddas ned efter nästa synkronisering."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หนังสือทั้งหมด หนังสือที่ยังไม่มีในเครื่องนี้จะดาวน์โหลดหลังการซิงค์ครั้งถัดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tüm kitaplar. Burada olmayan kitaplar bir sonraki eşzamanlamadan sonra indirilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Усі книги. Книги, яких тут немає, завантажаться після наступної синхронізації."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تمام کتابیں۔ جو کتابیں یہاں موجود نہیں، وہ اگلے سنک کے بعد ڈاؤن لوڈ ہوں گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tất cả sách. Những sách chưa có ở đây sẽ được tải về sau lần đồng bộ tiếp theo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "所有图书。此设备上缺少的图书会在下次同步后下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "所有書籍。此裝置上缺少的書籍會在下次同步後下載。"
          }
        }
      }
    },
    "sync.booksOnDevice.announce.openedOrKept" : {
      "comment" : "Said aloud after the person chose Books you open or keep for this device. No download is removed at once.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "الكتب التي تفتحها أو تحتفظ بها. لا يُزال شيء الآن."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আপনি যে বই খোলেন বা রাখেন। এখন কিছুই সরানো হবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bücher, die du öffnest oder behältst. Es wird jetzt nichts entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Books you open or keep. Nothing is removed now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Libros que abres o mantienes. Ahora no se quita nada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب‌هایی که باز می‌کنید یا نگه می‌دارید. اکنون چیزی برداشته نمی‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Livres que vous ouvrez ou conservez. Rien n’est retiré maintenant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ספרים שאתה פותח או שומר. שום דבר לא יוסר עכשיו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "वे पुस्तकें जो आप खोलते या रखते हैं। अभी कुछ नहीं हटाया जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Buku yang Anda buka atau simpan. Tidak ada yang dibuang sekarang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Libri che apri o mantieni. Per ora non viene rimosso nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "開くか保持するブック。今は何も取り除きません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "열거나 보관하는 책. 지금은 아무것도 제거되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Boeken die je opent of bewaart. Er wordt nu niets verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Książki, które otwierasz lub zachowujesz. Teraz nic nie jest usuwane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Livros que você abre ou mantém. Nada é removido agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Книги, которые вы открываете или храните. Сейчас ничего не убирается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Böcker du öppnar eller behåller. Inget tas bort nu."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หนังสือที่คุณเปิดหรือเก็บไว้ ตอนนี้ยังไม่นำสิ่งใดออก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Açtığınız veya tuttuğunuz kitaplar. Şu an hiçbir şey kaldırılmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Книги, які ви відкриваєте або зберігаєте. Зараз нічого не вилучається."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "وہ کتابیں جو آپ کھولتے یا رکھتے ہیں۔ ابھی کچھ نہیں ہٹایا جاتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sách bạn mở hoặc giữ. Hiện chưa gỡ gì cả."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "你打开或保留的图书。现在不会移除任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "你打開或保留的書籍。現在不會移除任何項目。"
          }
        }
      }
    },
    "sync.booksOnDevice.hint" : {
      "comment" : "VoiceOver hint of the Books on this device setting.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحدد ما إذا كان هذا الجهاز يُنزّل كل الكتب أو الكتب التي تفتحها أو تحتفظ بها فقط."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই ডিভাইস সব বই ডাউনলোড করবে, নাকি শুধু আপনি যে বই খোলেন বা রাখেন, তা বেছে নেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Legt fest, ob dieses Gerät alle Bücher herunterlädt oder nur die, die du öffnest oder behältst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chooses whether this device downloads every book, or only the books you open or keep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige si este dispositivo descarga todos los libros o solo los que abres o mantienes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مشخص می‌کند این دستگاه همه کتاب‌ها را بارگیری کند یا فقط کتاب‌هایی را که باز می‌کنید یا نگه می‌دارید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisit si cet appareil télécharge tous les livres ou seulement ceux que vous ouvrez ou conservez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "קובע אם המכשיר הזה מוריד את כל הספרים, או רק את הספרים שאתה פותח או שומר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चुनता है कि यह डिवाइस सभी पुस्तकें डाउनलोड करे या केवल वे जिन्हें आप खोलते या रखते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Memilih apakah perangkat ini mengunduh semua buku atau hanya buku yang Anda buka atau simpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sceglie se questo dispositivo scarica tutti i libri o solo quelli che apri o mantieni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このデバイスですべてのブックをダウンロードするか、開くか保持するブックだけをダウンロードするかを選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 기기에서 모든 책을 다운로드할지, 열거나 보관하는 책만 다운로드할지 선택합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kiest of dit apparaat alle boeken downloadt, of alleen de boeken die je opent of bewaart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wybiera, czy to urządzenie pobiera wszystkie książki, czy tylko te, które otwierasz lub zachowujesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escolhe se este dispositivo baixa todos os livros ou apenas os que você abre ou mantém."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Выбирает, загружает ли это устройство все книги или только те, которые вы открываете или храните."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Väljer om den här enheten laddar ned alla böcker eller bara de böcker du öppnar eller behåller."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เลือกว่าอุปกรณ์เครื่องนี้จะดาวน์โหลดหนังสือทั้งหมด หรือเฉพาะหนังสือที่คุณเปิดหรือเก็บไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu aygıtın tüm kitapları mı, yoksa yalnızca açtığınız veya tuttuğunuz kitapları mı indireceğini seçer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Визначає, чи завантажує цей пристрій усі книги, чи лише ті, які ви відкриваєте або зберігаєте."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "طے کرتا ہے کہ یہ آلہ تمام کتابیں ڈاؤن لوڈ کرے یا صرف وہ جو آپ کھولتے یا رکھتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chọn việc thiết bị này tải về mọi sách hay chỉ những sách bạn mở hoặc giữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "选择此设备是下载所有图书，还是只下载你打开或保留的图书。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選擇此裝置是下載所有書籍，還是只下載你打開或保留的書籍。"
          }
        }
      }
    },
