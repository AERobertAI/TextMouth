    "interfaceLanguage.launchNote.mac" : {
      "comment" : "A short note under the interface language picker on the Mac: some of the words macOS itself supplies (the standard menu items, the open and save panels) change only the next time TextMouth opens.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تتغير بعض كلمات macOS نفسه في المرة التالية التي يُفتح فيها TextMouth."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOS-এর নিজস্ব কিছু শব্দ পরের বার TextMouth খোলার সময় বদলায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Einige Wörter von macOS selbst ändern sich erst beim nächsten Öffnen von TextMouth."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some of macOS's own words change the next time TextMouth opens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Algunas palabras del propio macOS cambian la próxima vez que se abra TextMouth."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "برخی از کلمه‌های خود macOS دفعهٔ بعد که TextMouth باز شود تغییر می‌کنند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Certains mots propres à macOS changent à la prochaine ouverture de TextMouth."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "חלק מהמילים של macOS עצמה ישתנו בפעם הבאה ש-TextMouth ייפתח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOS के अपने कुछ शब्द अगली बार TextMouth खुलने पर बदलते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sebagian kata milik macOS sendiri berubah saat TextMouth dibuka lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alcune parole di macOS stesso cambiano alla prossima apertura di TextMouth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOS 自体の一部の言葉は、次に TextMouth を開いたときに変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
