          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בחלק שנבחר מהספר אין מילים להקראה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चुने गए हिस्से में बोलने के लिए कोई शब्द नहीं हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
