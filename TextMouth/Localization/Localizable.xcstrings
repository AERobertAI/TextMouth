    "pronunciationLexicon.nothingToExport" : {
      "comment" : "Message of the alert when Export Rules finds no rule it can write as a pronunciation lexicon.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا توجد قواعد للتصدير: لا يمكن كتابة سوى قواعد النص العادي المفعّلة في قاموس."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "রপ্তানি করার মতো কোনো নিয়ম নেই: লেক্সিকনে শুধু চালু থাকা সাধারণ টেক্সট নিয়ম লেখা যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Keine Regeln zu exportieren: Nur aktivierte Klartextregeln können in ein Lexikon geschrieben werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No rules to export: only plain text rules that are on can be written in a lexicon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay reglas que exportar: en un léxico solo se pueden escribir las reglas de texto simple que están activadas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "قاعده‌ای برای صادر کردن نیست: فقط قاعده‌های متن ساده که روشن هستند را می‌توان در واژه‌نامه نوشت."
