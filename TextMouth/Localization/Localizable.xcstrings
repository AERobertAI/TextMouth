          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पहले पूछता है, फिर लाइब्रेरी के लिए इस Mac को ज्ञात पहचान लिखता है और उसे खोलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bertanya dulu, lalu menulis identitas yang diketahui Mac ini untuk pustaka dan membukanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chiede conferma, poi scrive l’identità che questo Mac conosce per la libreria e la apre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "確認してから、この Mac が把握しているライブラリの ID を書き込み、ライブラリを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "먼저 확인한 다음 이 Mac이 알고 있는 보관함의 식별 정보를 쓰고 보관함을 엽니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pergunta antes, depois grava a identidade que este Mac conhece para a biblioteca e a abre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сначала спрашивает, затем записывает идентификатор библиотеки, известный этому Mac, и открывает её."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Спочатку запитує, потім записує ідентичність, яку цей Mac знає для бібліотеки, і відкриває її."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "先询问，然后写入这台 Mac 所知的资料库标识并打开它。"
          }
        }
      }
    },
    "Asks for an optional note, then marks the reading position." : {
      "comment" : "VoiceOver hint of the Bookmarks list's Add Bookmark button: it opens the step where an optional note is written, then the bookmark is added where the book is being read.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fragt nach einer optionalen Notiz und setzt dann ein Lesezeichen an der Leseposition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pide una nota opcional y luego marca la posición de lectura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Demande une note facultative, puis marque la position de lecture."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "एक वैकल्पिक नोट माँगता है, फिर पठन स्थिति पर चिह्न लगाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Meminta catatan opsional, lalu menandai posisi baca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chiede una nota facoltativa, poi segna la posizione di lettura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "メモ（任意）の入力を求めてから、現在の読書位置にしるしを付けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "선택 사항인 메모를 입력한 다음 읽기 위치에 표시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pede uma nota opcional e depois marca a posição de leitura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Запрашивает необязательную заметку, затем отмечает позицию чтения."
          }
        },
        "uk" : {
          "stringUnit" : {
