            "value" : "מתנגן כשהפקודה “איפה אני?” מתחילה להקריא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ध्वनि तब बजती है जब “मैं कहाँ हूँ?” बोलना शुरू करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Diputar saat Di mana saya? mulai berbicara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si attiva quando Dove sono? inizia a parlare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「ここはどこ？」の読み上げが始まると鳴ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“내 위치는?” 안내가 시작될 때 재생됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wordt afgespeeld wanneer Waar ben ik? begint te spreken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Odtwarza się na początku wypowiedzi Gdzie jestem?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toca quando Onde estou? começa a falar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Звучит, когда «Где я?» начинает говорить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Spelas upp när ”Var är jag?” börjar läsa upp."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เล่นเมื่อ ฉันอยู่ที่ไหน เริ่มพูด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Neredeyim? konuşmaya başladığında çalar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відтворюється, коли «Де я?» починає говорити."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جب “میں کہاں ہوں؟” بولنا شروع کرتا ہے تو چلتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Phát khi lệnh Tôi đang ở đâu bắt đầu đọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在“我在哪里”开始朗读时播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在「我在哪裡？」開始朗讀時播放。"
          }
        }
      }
    },
