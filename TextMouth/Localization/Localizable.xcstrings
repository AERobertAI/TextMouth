    "textEncoding.automaticNote" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. What Automatic does, as the alert says it before it is chosen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يقرأ TextMouth ملفه كما يقرأ ملفًا تضيفه: بالترميز الذي يحدده الملف، وإلا فبالترميز الذي يجده TextMouth."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth বইটির ফাইল সেভাবেই পড়ে, যেভাবে আপনার যোগ করা কোনো ফাইল পড়ে: ফাইলে যে এনকোডিংয়ের উল্লেখ আছে সেটিতে, নইলে TextMouth যেটি খুঁজে পায় সেটিতে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth liest die Datei so, wie es eine hinzugefügte Datei liest: in der Codierung, die die Datei nennt, oder sonst in der, die TextMouth findet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth reads its file as it reads a file you add: in the encoding the file names, or else the one TextMouth finds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth lee su archivo como lee un archivo que agregas: con la codificación que indica el archivo o, si no, con la que TextMouth encuentra."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth فایل کتاب را همان‌طور می‌خواند که فایلی را که شما اضافه می‌کنید: با کدگذاری‌ای که فایل مشخص کرده است، وگرنه با کدگذاری‌ای که TextMouth خودش پیدا می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth lit son fichier comme un fichier que vous ajoutez : dans l’encodage que le fichier indique, sinon celui que TextMouth trouve."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth קורא את הקובץ שלו כפי שהוא קורא קובץ שמוסיפים: בקידוד שהקובץ מציין, או אחרת בקידוד ש-TextMouth מוצא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth अपनी फ़ाइल उसी तरह पढ़ता है जैसे आपकी जोड़ी गई फ़ाइल: फ़ाइल में बताई गई एन्कोडिंग में, या फिर वह जो TextMouth को मिले।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth membaca file-nya seperti membaca file yang Anda tambahkan: dalam pengodean yang disebutkan file, atau yang ditemukan TextMouth."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth legge il suo file come legge un file che aggiungi: nella codifica indicata dal file, oppure in quella che TextMouth individua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は、追加したファイルと同じように、ファイルが示すエンコーディングで、示していない場合は TextMouth が見つけたエンコーディングで読み込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth는 추가한 파일과 같은 방식으로 파일을 읽습니다. 파일에 지정된 인코딩을 사용하고, 없으면 TextMouth가 찾은 인코딩을 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth leest het bestand van het boek zoals een bestand dat je toevoegt: in de codering die het bestand opgeeft, of anders in de codering die TextMouth vindt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth odczytuje ten plik tak, jak plik, który dodajesz: w kodowaniu podanym w pliku albo w tym, które sam znajdzie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth lê o arquivo dele como lê um arquivo que você adiciona: na codificação que o arquivo indica ou, se não houver, na que o TextMouth encontra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth читает файл так же, как файл, который вы добавляете: в кодировке, которую указывает сам файл, а если она не указана, то в той, которую определит TextMouth."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth läser bokens fil som en fil du lägger till: med den teckenkodning som filen anger, annars den som TextMouth hittar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth อ่านไฟล์นี้เหมือนที่อ่านไฟล์ที่เพิ่ม คือใช้การเข้ารหัสที่ไฟล์ระบุ ไม่เช่นนั้นใช้การเข้ารหัสที่ TextMouth พบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth dosyasını, eklediğiniz bir dosyayı okuduğu gibi okur: dosyanın belirttiği kodlamayla, yoksa TextMouth'un bulduğu kodlamayla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth читає цей файл так само, як файл, який ви додаєте: у кодуванні, вказаному у файлі, а якщо його немає — у тому, яке знайде сам."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth اس کی فائل ویسے ہی پڑھتا ہے جیسے آپ کی شامل کردہ فائل: اس انکوڈنگ میں جو فائل خود بتائے، ورنہ وہ جو TextMouth خود تلاش کرے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth đọc tệp của nó như khi đọc một tệp bạn thêm vào: theo bảng mã mà tệp nêu, hoặc nếu không thì theo bảng mã TextMouth tìm ra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 读取此文件的方式与读取你添加的文件相同：使用文件指明的编码，否则使用 TextMouth 找到的编码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 讀取其檔案的方式，與讀取你加入的檔案相同：使用檔案所指定的編碼，否則使用 TextMouth 找到的編碼。"
          }
        }
      }
    },
    "textEncoding.bookGoneRefusal" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. Why a book that left the library while its Book Information was open is not read again.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يعد الكتاب في المكتبة، لذا لم تتم إعادة قراءته."
