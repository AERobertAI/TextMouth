          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не удалось убрать исходный файл, поэтому он сохранён здесь: %@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Оригінальний файл книги не вдалося вилучити, тому його збережено в %@."
