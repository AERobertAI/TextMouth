          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо увімкнено, використовуйте \\b у шаблоні для меж слів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "启用后，请在模式中使用 \\b 表示单词边界。"
          }
        }
      }
    },
    "When off, its files are deleted permanently and cannot be recovered." : {
      "comment" : "Second sentence of the hint of the setting that moves deleted files to the Trash: what happens with the setting off.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عند الإيقاف، تُحذف ملفاته نهائيًا ولا يمكن استردادها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wenn ausgeschaltet, werden die Dateien endgültig gelöscht und lassen sich nicht wiederherstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si está desactivado, sus archivos se eliminan de forma permanente y no se pueden recuperar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si désactivé, ses fichiers sont supprimés définitivement et ne peuvent pas être récupérés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "बंद होने पर, इसकी फ़ाइलें स्थायी रूप से मिटा दी जाती हैं और वापस नहीं पाई जा सकतीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saat nonaktif, file-nya dihapus secara permanen dan tidak dapat dipulihkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se disattivata, i file del libro vengono eliminati definitivamente e non possono essere recuperati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オフにすると、ファイルは完全に削除され、復元できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "꺼져 있으면 파일이 영구 삭제되며 복구할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quando desativado, os arquivos são excluídos permanentemente e não podem ser recuperados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Если выключено, файлы удаляются навсегда, и их нельзя восстановить."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо вимкнено, файли видаляються остаточно й не підлягають відновленню."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "关闭后，其文件会被永久删除且无法恢复。"
          }
        }
      }
    },
    "When off, removing a book will %@ at once." : {
      "comment" : "Second sentence of the hint of the setting that confirms before removing a book. %@ is what deleting does, such as \"move the files to the Trash\".",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عند الإيقاف، ستؤدي إزالة كتاب إلى %@ فورًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wenn ausgeschaltet, bedeutet das Entfernen eines Buchs sofort: %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si está desactivado, quitar un libro implica %@ de inmediato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si désactivé, retirer un livre revient à %@ immédiatement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "बंद होने पर, पुस्तक हटाने पर तुरंत यह होता है: %@।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saat nonaktif, membuang buku akan langsung %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se disattivata, rimuovere un libro significa subito %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オフにすると、ブックを取り除いたとき、すぐに%@ことになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "꺼져 있으면 책을 제거할 때 즉시 %@합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quando desativado, remover um livro vai %@ imediatamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Если выключено, при удалении книги сразу выполняется действие: %@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо вимкнено, під час вилучення книги одразу буде виконано дію: %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "关闭后，移除图书会立即%@。"
          }
        }
      }
    },
    "When off, the sheet stays open showing the remaining time and a reset button" : {
      "comment" : "VoiceOver hint of the Close sheet after setting timer checkbox in the Playback settings.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عند الإيقاف، تبقى الورقة مفتوحة وتعرض الوقت المتبقي وزر إعادة الضبط"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বন্ধ থাকলে শিটটি খোলা থাকে এবং অবশিষ্ট সময় ও একটি রিসেট বোতাম দেখায়"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wenn deaktiviert, bleibt das Sheet offen und zeigt die verbleibende Zeit und eine Taste zum Zurücksetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si está desactivado, la hoja sigue abierta y muestra el tiempo restante y un botón de reinicio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si désactivé, la feuille reste ouverte avec le temps restant et un bouton de réinitialisation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "बंद होने पर, शीट खुली रहती है और बचा हुआ समय तथा एक रीसेट बटन दिखाती है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jika nonaktif, lembar tetap terbuka menampilkan sisa waktu dan tombol setel ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se disattivato, il foglio resta aperto e mostra il tempo rimanente e un pulsante di reimpostazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オフにすると、シートは開いたままで、残り時間とリセットボタンが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "비활성화하면 시트가 열린 채로 남아 남은 시간과 재설정 버튼을 표시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quando desativado, a folha continua aberta mostrando o tempo restante e um botão para reiniciar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Если выключено, лист остаётся открытым и показывает оставшееся время и кнопку сброса."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо вимкнено, аркуш залишається відкритим із залишком часу та кнопкою скидання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "关闭后，表单会保持打开，显示剩余时间和重置按钮。"
          }
        }
      }
    },
    "When on, a braille file read as contracted Unified English Braille that is clearly English Braille, American Edition is read as that instead." : {
      "comment" : "The hint of the guess switch in the Braille tab of Settings. Unified English Braille and English Braille, American Edition are the names of braille codes.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wenn aktiviert, wird eine Braille-Datei, die als Unified English Braille in Kurzschrift gelesen wird, aber eindeutig English Braille, American Edition ist, stattdessen als diese gelesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si está activado, un archivo braille leído como Unified English Braille contraído que sea claramente English Braille, American Edition se lee como este último."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si activé, un fichier braille lu comme de l’Unified English Braille abrégé qui est clairement de l’English Braille, American Edition est lu comme tel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चालू होने पर, संक्षिप्त Unified English Braille के रूप में पढ़ी गई वह ब्रेल फ़ाइल जो साफ़ तौर पर English Braille, American Edition है, उसी के रूप में पढ़ी जाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saat aktif, file braille yang dibaca sebagai Unified English Braille disingkat yang jelas merupakan English Braille, American Edition akan dibaca sebagai itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se attivo, un file braille letto come Unified English Braille contratto che è chiaramente English Braille, American Edition viene letto come tale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オンにすると、縮約形の Unified English Braille として読み取られた点字ファイルのうち、明らかに English Braille, American Edition であるものは、そのコードとして読み取られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "켜져 있으면, 축약 통합 영어 점자로 읽은 점자 파일이 분명히 영어 점자 미국판이면 그 코드로 읽습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quando ativado, um arquivo braille lido como Unified English Braille contraído que seja claramente English Braille, American Edition é lido como este último."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Если включено, файл Брайля, прочитанный как сокращённый Unified English Braille, но явно написанный кодом English Braille, American Edition, читается именно так."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо увімкнено, брайлівський файл, прочитаний як Unified English Braille зі скороченнями, що явно є English Braille, American Edition, читається як такий."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "开启后，被读取为缩写的统一英语盲文、但显然是美式英语盲文的盲文文件，将按后者读取。"
          }
        }
      }
    },
    "When on, a deleted book's files go to the Trash, where you can recover them until the Trash is emptied." : {
      "comment" : "First sentence of the hint of the setting that moves deleted files to the Trash: what happens with the setting on.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عند التشغيل، تذهب ملفات الكتاب المحذوف إلى سلة المهملات، حيث يمكنك استردادها إلى أن تُفرَّغ السلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wenn eingeschaltet, kommen die Dateien eines gelöschten Buchs in den Papierkorb, wo du sie bis zum Leeren des Papierkorbs wiederherstellen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si está activado, los archivos de un libro eliminado van a la Papelera, donde puedes recuperarlos hasta que se vacíe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si activé, les fichiers d’un livre supprimé vont dans la corbeille, où vous pouvez les récupérer jusqu’à ce qu’elle soit vidée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चालू होने पर, मिटाई गई पुस्तक की फ़ाइलें ट्रैश में चली जाती हैं, जहाँ ट्रैश खाली होने तक आप उन्हें वापस पा सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saat aktif, file buku yang dihapus dipindahkan ke Tempat Sampah, tempat Anda dapat memulihkannya sampai Tempat Sampah dikosongkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se attiva, i file di un libro eliminato vanno nel Cestino, dove puoi recuperarli finché il Cestino non viene svuotato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オンにすると、削除したブックのファイルはゴミ箱に入り、ゴミ箱を空にするまで復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "켜져 있으면 삭제한 책의 파일이 휴지통으로 이동되며, 휴지통을 비우기 전까지 복구할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quando ativado, os arquivos de um livro excluído vão para a Lixeira, onde você pode recuperá-los até que ela seja esvaziada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Если включено, файлы удалённой книги перемещаются в Корзину, откуда их можно восстановить, пока Корзина не очищена."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо увімкнено, файли видаленої книги потрапляють до Кошика, де їх можна відновити, доки Кошик не очищено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "开启后，已删除图书的文件会移到废纸篓，在清倒废纸篓之前你都可以恢复。"
          }
        }
      }
    },
    "When on, removing a book first asks whether to %@ or keep them in the TextMouth library folder." : {
      "comment" : "First sentence of the hint of the setting that confirms before removing a book. %@ is what deleting does, such as \"move the files to the Trash\".",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عند التشغيل، تسأل إزالة كتاب أولًا عما إذا كان سيتم %@ أو الاحتفاظ بها في مجلد مكتبة TextMouth."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wenn eingeschaltet, fragt das Entfernen eines Buchs zuerst, ob du %@ oder sie im Bibliotheksordner von TextMouth behalten möchtest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si está activado, al quitar un libro se pregunta primero si quieres %@ o conservarlos en la carpeta de la biblioteca de TextMouth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si activé, retirer un livre demande d’abord s’il faut %@, ou les conserver dans le dossier de la bibliothèque TextMouth."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चालू होने पर, पुस्तक हटाने से पहले पूछा जाता है कि %@ है या उन्हें TextMouth लाइब्रेरी फ़ोल्डर में रखना है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saat aktif, membuang buku akan terlebih dahulu menanyakan apakah akan %@ atau tetap menyimpannya di folder pustaka TextMouth."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se attiva, prima di rimuovere un libro viene chiesto se %@ o conservarli nella cartella della libreria di TextMouth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オンにすると、ブックを取り除く前に、%@か、TextMouth のライブラリフォルダに残すかを確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "켜져 있으면 책을 제거할 때 먼저 %@할지, 아니면 TextMouth 보관함 폴더에 유지할지 묻습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quando ativado, remover um livro primeiro pergunta se você quer %@ ou mantê-los na pasta da biblioteca do TextMouth."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Если включено, при удалении книги сначала спрашивается, нужно ли %@ или оставить файлы в папке библиотеки TextMouth."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо увімкнено, перед вилученням книги запитується, чи %@, чи залишити їх у папці бібліотеки TextMouth."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "开启后，移除图书前会先询问是否%@，或将它们保留在 TextMouth 资料库文件夹中。"
          }
        }
      }
    },
    "When resuming playback, rewind to the start of this unit" : {
      "comment" : "VoiceOver hint of the Rewind to pop-up in the Playback settings.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عند استئناف التشغيل، يرجّع إلى بداية هذه الوحدة"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "প্লেব্যাক আবার শুরুর সময় এই ইউনিটের শুরুতে পিছিয়ে যান"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beim Fortsetzen der Wiedergabe bis zum Anfang dieser Einheit zurückspulen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Al reanudar la reproducción, retrocede hasta el inicio de esta unidad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "À la reprise de la lecture, revient au début de cette unité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "प्लेबैक फिर शुरू करते समय, इस इकाई की शुरुआत तक पीछे जाएँ"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saat melanjutkan pemutaran, mundur ke awal unit ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alla ripresa della riproduzione, riavvolge all’inizio di questa unità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "再生を再開するとき、この単位の先頭まで巻き戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "재생을 재개할 때 이 단위의 시작 지점으로 되감습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ao retomar a reprodução, retrocede até o início desta unidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "При возобновлении воспроизведения перематывает к началу этой единицы."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Під час продовження відтворення перемотувати до початку цієї одиниці."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "继续播放时，倒带到此单位的开头。"
          }
        }
      }
    },
    "When this book ends" : {
      "comment" : "Title of the book's own settings menu that chooses what happens when this book ends.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
