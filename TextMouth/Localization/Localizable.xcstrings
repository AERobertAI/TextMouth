        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ नहीं बनाया जा सकता, क्योंकि उसे रखने वाला फ़ोल्डर %2$@ नहीं मिल रहा।"
