          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@のアドレスには、TextMouth が読み取れるフィードがありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
