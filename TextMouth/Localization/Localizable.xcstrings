    },
    "Replacement text. Leave empty to skip matched text." : {
      "comment" : "VoiceOver label of the replacement field in the substitution rule editor.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ersetzungstext. Leer lassen, um gefundenen Text zu überspringen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texto de reemplazo. Déjalo vacío para omitir el texto encontrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texte de remplacement. Laissez vide pour ignorer le texte trouvé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Testo di sostituzione. Lascia vuoto per ignorare il testo trovato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texto de substituição. Deixe vazio para omitir o texto encontrado."
          }
        }
      }
    },
    "Replaces the text with the text on the clipboard" : {
      "comment" : "Hint of the Paste from Clipboard button of the New Book from Text sheet.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ersetzt den Text durch den Text in der Zwischenablage"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reemplaza el texto con el texto del portapapeles"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Remplace le texte par celui du presse-papiers"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sostituisce il testo con quello degli appunti"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Substitui o texto pelo texto da área de transferência."
          }
        }
      }
    },
    "Replacing keeps the existing copy's reading position and bookmarks, moved to their words in the new text where found, and its settings, folder, and place on the reading list. An edit of its text is kept as a copy beside the new text, not applied." : {
      "comment" : "Part of the question asked about a duplicate book that is read from text: what Replace Existing keeps of the library's copy. \"The existing copy\" is the library's copy.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beim Ersetzen bleiben die Leseposition und die Lesezeichen der vorhandenen Kopie erhalten, verschoben zu ihren Wörtern im neuen Text, soweit gefunden, ebenso ihre Einstellungen, ihr Ordner und ihr Platz auf der Leseliste. Eine Bearbeitung ihres Textes bleibt als Kopie neben dem neuen Text erhalten und wird nicht angewendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Al reemplazar, se conservan la posición de lectura y los marcadores de la copia existente, movidos a sus palabras en el texto nuevo donde se encuentren, además de sus ajustes, su carpeta y su lugar en la lista de lectura. Una edición de su texto se conserva como copia junto al texto nuevo, sin aplicarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le remplacement conserve la position de lecture et les signets de la copie existante, déplacés vers leurs mots dans le nouveau texte lorsqu’ils sont retrouvés, ainsi que ses réglages, son dossier et sa place dans la liste de lecture. Une modification de son texte est conservée comme copie à côté du nouveau texte, sans être appliquée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La sostituzione conserva la posizione di lettura e i segnalibri della copia esistente, spostati sulle loro parole nel nuovo testo dove vengono trovate, e le sue impostazioni, la cartella e la posizione nell’elenco di lettura. Una modifica del suo testo viene conservata come copia accanto al nuovo testo, non applicata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Substituir mantém a posição de leitura e os marcadores da cópia existente, movidos para as palavras deles no novo texto onde forem encontradas, e também os ajustes, a pasta e o lugar dela na lista de leitura. Uma edição do texto dela é mantida como uma cópia ao lado do novo texto, sem ser aplicada."
          }
        }
      }
    },
    "Replacing keeps the existing copy's reading position, bookmarks, settings, folder, and place on the reading list, and its transcript when the audio is the same, rather than the transcript file found beside the new copy's audio." : {
      "comment" : "Part of the question asked about a duplicate audiobook whose new copy came with a transcript file beside its audio: Replace Existing keeps the library copy's own transcript over that file. \"The existing copy\" is the library's copy. A sentence about what is not kept follows.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beim Ersetzen bleiben Leseposition, Lesezeichen, Einstellungen, Ordner und Platz auf der Leseliste der vorhandenen Kopie erhalten, dazu ihr Transkript, wenn das Audio dasselbe ist, statt der Transkriptdatei neben dem Audio der neuen Kopie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Al reemplazar, se conservan la posición de lectura, los marcadores, los ajustes, la carpeta y el lugar en la lista de lectura de la copia existente, y su transcripción cuando el audio es el mismo, en lugar de la transcripción que se encontró junto al audio de la copia nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le remplacement conserve la position de lecture, les signets, les réglages, le dossier et la place dans la liste de lecture de la copie existante, ainsi que sa transcription lorsque l’audio est le même, plutôt que le fichier de transcription trouvé à côté de l’audio de la nouvelle copie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La sostituzione conserva la posizione di lettura, i segnalibri, le impostazioni, la cartella e la posizione nell’elenco di lettura della copia esistente, e la sua trascrizione quando l’audio è lo stesso, anziché il file di trascrizione trovato accanto all’audio della nuova copia."
          }
        },
