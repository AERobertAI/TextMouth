    "fileImportError.archiveLinksOutside" : {
      "comment" : "Why an archive was refused at import: it holds a symbolic link to a file outside it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحتوي الأرشيف على رابط إلى ملف خارجه، ولا يُستخرج أبدًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আর্কাইভে এর বাইরের একটি ফাইলের লিঙ্ক আছে, যা কখনও এক্সট্র্যাক্ট করা হয় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Archiv enthält einen Link auf eine Datei außerhalb des Archivs; er wird nie entpackt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archive holds a link to a file outside it, which is never extracted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo comprimido contiene un enlace a un archivo fuera de él, que nunca se extrae."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آرشیو پیوندی به فایلی بیرون از آن دارد که هرگز استخراج نمی‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’archive contient un lien vers un fichier extérieur à elle, qui n’est jamais extrait."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הארכיון מכיל קישור לקובץ שמחוצה לו, ולכן הקישור לא יחולץ לעולם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आर्काइव में उसके बाहर की फ़ाइल का लिंक है, जिसे कभी निकाला नहीं जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arsip ini berisi tautan ke file di luar arsip, dan tautan itu tidak pernah diekstrak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’archivio contiene un collegamento a un file esterno; non viene mai estratto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "アーカイブに、外部のファイルへのリンクが含まれています。このリンクは展開されません。"
          }
