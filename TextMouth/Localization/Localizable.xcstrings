        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si sta allegando una trascrizione al libro %@. Trascrivilo al termine."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uma transcrição está sendo anexada a %@. Transcreva o áudio quando ela terminar."
          }
