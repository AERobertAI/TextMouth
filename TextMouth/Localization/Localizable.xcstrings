    "The file %@ failed partway through." : {
      "comment" : "A sentence telling an audio file failed while playing. %@ is the file's name, such as 03.mp3.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo %@ falló a medias."
          }
        }
