    "moveToLibraryError.folderMissing" : {
      "comment" : "Why Move to Library did nothing: the folder chosen was removed from the library. Follows \"Could not move to the library: \".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يعد المجلد المختار في المكتبة. اختر مجلدًا آخر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বেছে নেওয়া ফোল্ডার আর লাইব্রেরিতে নেই। অন্য একটি ফোল্ডার বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der gewählte Ordner ist nicht mehr in der Bibliothek. Wähle einen anderen Ordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The folder chosen is no longer in the library. Choose another folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La carpeta elegida ya no está en la biblioteca. Elige otra carpeta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پوشه انتخاب‌شده دیگر در کتابخانه نیست. پوشه دیگری انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le dossier choisi n’est plus dans la bibliothèque. Choisissez un autre dossier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
