            "value" : "Yeterli yer yok (%1$@): %2$@ indirilemiyor. Zaten burada olan kitaplar kalıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Недостатньо місця (%1$@), щоб завантажити: %2$@. Книги, які вже тут, залишаються."
          }
        },
        "ur" : {
