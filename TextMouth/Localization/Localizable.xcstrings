        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tidak dapat membuka file yang dilindungi dari penyalinan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non può aprire file protetti da copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は、コピー保護されたファイルを開けません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
