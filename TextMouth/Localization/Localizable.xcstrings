    "speechRefusal.closeHint" : {
      "comment" : "VoiceOver hint of the Close button of the speech refusal report.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بعد ذلك، يحاول “تشغيل” نطق هذا النص مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এরপর “চালান” অংশটি আবার পড়ার চেষ্টা করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Danach versucht „Wiedergeben“ die Stelle erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afterwards, Play tries the passage again"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Después, Reproducir vuelve a intentar el pasaje"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پس از آن، «پخش» بخش را دوباره امتحان می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ensuite, Lire essaie de nouveau le passage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לאחר מכן, הפקודה “נגן” מנסה שוב את הקטע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसके बाद “चलाएँ” अंश को फिर से चलाने का प्रयास करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Setelahnya, Putar mencoba bagian itu lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Poi Riproduci riprova il passaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "この後「再生」すると、その箇所をもう一度試します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이후 재생하면 해당 구간을 다시 시도합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Daarna probeert Speel af de passage opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Potem Odtwórz ponownie spróbuje odczytać ten fragment."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Depois, Reproduzir tenta o trecho novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Затем «Воспроизвести» снова попробует прочитать отрывок."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Därefter gör ”Spela upp” ett nytt försök med stycket."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หลังจากนั้น เล่น จะลองอ่านข้อความช่วงนั้นอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sonrasında Oynat, pasajı tekrar dener."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Після цього «Відтворити» знову спробує цей уривок."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بعد میں “چلائیں” سے یہ حصہ دوبارہ آزمایا جاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sau đó, nút Phát sẽ thử lại đoạn này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "之后，“播放”会再次尝试朗读该段落。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "關閉後，「播放」會再次嘗試該段落。"
          }
        }
      }
    },
