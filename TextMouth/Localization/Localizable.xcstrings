        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سنک کرنے والا ہر آلہ اس کتاب کی فائلیں رکھتا ہے اور ممکن ہونے پر انہیں ڈاؤن لوڈ کرتا ہے۔"
