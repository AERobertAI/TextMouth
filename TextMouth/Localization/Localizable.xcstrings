    "protection.unsupported" : {
      "comment" : "Why a protected book cannot be unlocked: its kind of password protection is not one TextMouth opens.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يستطيع TextMouth فتح هذا النوع من الحماية بكلمة مرور في هذا الكتاب."
