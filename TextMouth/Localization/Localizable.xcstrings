    "sync.stopQuestion" : {
      "comment" : "The confirmation asked before syncing stops. \"This Mac\" names the device the person is using.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هل تريد إيقاف مزامنة هذه المكتبة؟ لن يُحذف شيء، لا على هذا الـ Mac ولا في iCloud Drive."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই লাইব্রেরির সিঙ্ক বন্ধ করবেন? এই Mac-এ বা iCloud Drive-এ কিছুই মোছা হবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Synchronisierung dieser Bibliothek beenden? Nichts wird gelöscht, weder auf diesem Mac noch in iCloud Drive."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop syncing this library? Nothing is deleted, on this Mac or in iCloud Drive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "¿Dejar de sincronizar esta biblioteca? No se elimina nada, ni en esta Mac ni en iCloud Drive."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "همگام‌سازی این کتابخانه متوقف شود؟ هیچ چیزی حذف نمی‌شود، نه در این Mac و نه در iCloud Drive."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrêter la synchronisation de cette bibliothèque ? Rien n’est supprimé, ni sur ce Mac ni dans iCloud Drive."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "להפסיק לסנכרן את הספרייה הזו? שום דבר לא יימחק, לא ב-Mac הזה ולא ב-iCloud Drive."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस लाइब्रेरी का सिंक रोकें? इस Mac और iCloud Drive में कुछ भी नहीं हटाया जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Berhenti menyinkronkan pustaka ini? Tidak ada yang dihapus, baik di Mac ini maupun di iCloud Drive."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompere la sincronizzazione di questa libreria? Non viene eliminato nulla, né su questo Mac né in iCloud Drive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このライブラリの同期を停止しますか？この Mac でも iCloud Drive でも、何も削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 보관함의 동기화를 중지하시겠습니까? 이 Mac과 iCloud Drive 모두 아무것도 삭제되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Synchronisatie van deze bibliotheek stoppen? Er wordt niets verwijderd, niet op deze Mac en niet in iCloud Drive."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zatrzymać synchronizację tej biblioteki? Nic nie zostanie usunięte ani na tym komputerze Mac, ani w iCloud Drive."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Parar de sincronizar esta biblioteca? Nada é apagado, neste Mac nem no iCloud Drive."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Остановить синхронизацию этой библиотеки? Ничего не удаляется ни на этом Mac, ни в iCloud Drive."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sluta synkronisera det här biblioteket? Ingenting raderas, varken på den här Mac-datorn eller i iCloud Drive."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หยุดซิงค์ไลบรารีนี้ไหม จะไม่มีอะไรถูกลบ ทั้งใน Mac เครื่องนี้และใน iCloud Drive"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu kitaplığın eşzamanlaması durdurulsun mu? Bu Mac'te de iCloud Drive'da da hiçbir şey silinmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Зупинити синхронізацію цієї бібліотеки? Нічого не видаляється ні на цьому Mac, ні в iCloud Drive."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس لائبریری کا سنک روکیں؟ اس Mac اور iCloud Drive میں کچھ بھی حذف نہیں کیا جائے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dừng đồng bộ thư viện này? Không có gì bị xóa, cả trên máy Mac này lẫn trong iCloud Drive."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "要停止同步这个资料库吗？这台 Mac 和 iCloud 云盘上的内容都不会被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "要停止同步這個書庫嗎？這部 Mac 和 iCloud Drive 上的內容都不會被刪除。"
          }
        }
      }
    },
    "sync.stopQuestion.onlyInCloud" : {
      "comment" : "Added to the question before syncing stops, when some books' files are only in iCloud Drive. %@ is a count of books, such as \"12 books\".",
