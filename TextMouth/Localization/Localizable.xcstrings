    "listeningOptions.continuationHint.article" : {
      "comment" : "VoiceOver hint of the pop-up button in a news feed's Feed Info that sets what happens when one of its articles ends.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يختار ما يحدث عندما تنتهي إحدى مقالات هذا الموجز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই ফিডের একটি নিবন্ধ শেষ হলে কী হবে তা বেছে নেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Legt fest, was passiert, wenn einer der Artikel dieses Feeds endet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chooses what happens when one of this feed's articles ends"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige qué ocurre cuando termina uno de los artículos de este canal"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "انتخاب می‌کند وقتی یکی از مقاله‌های این فید تمام می‌شود چه اتفاقی بیفتد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisit ce qui se passe quand un article de ce flux se termine."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בוחר מה קורה כשאחת מכתבות הערוץ הזה מסתיימת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चुनता है कि इस फ़ीड का कोई लेख ख़त्म होने पर क्या हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Memilih apa yang terjadi saat salah satu artikel feed ini selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sceglie cosa succede quando termina uno degli articoli di questo feed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このフィードの記事が終わったときの動作を選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 피드의 기사가 끝날 때의 동작을 선택합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kiest wat er gebeurt als een artikel van deze feed eindigt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wybiera, co się dzieje po zakończeniu jednego z artykułów tego kanału."
