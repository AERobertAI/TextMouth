        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lista de lectura, libro %1$lld de %2$lld"
          }
        }
      }
    },
    "Reading list: %@ is only on %@'s list, at place %@." : {
      "comment" : "A difference found by Compare Libraries. %1$@ is a book's title, %2$@ is the copy of the library whose Reading List holds it, and %3$@ is its place in that list, an identifier written without digit grouping.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reading list: %1$@ is only on %2$@'s list, at place %3$@."
          }
        }
      }
    },
    "Reading list: the order differs." : {
