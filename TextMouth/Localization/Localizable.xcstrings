    "Choose the app to edit the text of %@ with." : {
      "comment" : "Message of the panel in which the user chooses an app to edit a book's text with. %@ is the book's title."
    },
    "Chooses what a book opened from the list does when it ends." : {
      "comment" : "VoiceOver hint of the Reading List's When a book ends pop-up button.",
