    "MP3 can't be written: TextMouth's encoder couldn't start, and ffmpeg is missing or off in Storage settings." : {
      "comment" : "Said when MP3 is asked for and neither TextMouth's built-in encoder nor an installed ffmpeg program can write it. \"Storage settings\" is the name of a settings tab.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "MP3 kann nicht geschrieben werden: Der Encoder von TextMouth konnte nicht starten, und ffmpeg fehlt oder ist in den Speichereinstellungen ausgeschaltet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se puede escribir MP3: el codificador de TextMouth no pudo iniciarse, y ffmpeg falta o está desactivado en los ajustes de Almacenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossible d’écrire du MP3 : l’encodeur de TextMouth n’a pas pu démarrer, et ffmpeg est absent ou désactivé dans les réglages Stockage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile scrivere MP3: il codificatore di TextMouth non si è avviato e ffmpeg manca o è disattivato nelle impostazioni di Archiviazione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não é possível gravar MP3: o codificador do TextMouth não pôde iniciar, e o ffmpeg está ausente ou desativado nos ajustes de Armazenamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не удалось записать MP3: не запустился кодировщик TextMouth, а ffmpeg отсутствует или выключен в настройках хранилища."
          }
        }
      }
    },
