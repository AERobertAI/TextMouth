    "leadingArticle.pickerHint" : {
      "comment" : "Hint and tooltip of the Leading Articles pop-up in the Library settings. The, A, and An are the English articles the setting skips.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يختار ما إذا كانت The وA وAn في بداية العنوان تُحتسب عند الفرز وعند كتابة الأحرف الأولى من العنوان."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সাজানোর সময় এবং শিরোনামের প্রথম অক্ষর টাইপ করার সময় শিরোনামের শুরুর The, A ও An গণ্য হবে কি না তা ঠিক করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Legt fest, ob „The“, „A“ und „An“ am Anfang eines Titels beim Sortieren und beim Eintippen der ersten Buchstaben eines Titels zählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chooses whether The, A, and An at the start of a title count when sorting and when typing a title's first letters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige si The, A y An al principio de un título cuentan al ordenar y al escribir las primeras letras de un título."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعیین می‌کند «The»، «A» و «An» در آغاز عنوان، هنگام مرتب‌سازی و هنگام تایپ اولین حرف‌های عنوان به حساب بیایند یا نه."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisit si The, A et An au début d’un titre comptent pour le tri et la saisie des premières lettres d’un titre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "קובע אם The, A ו-An בתחילת שם הספר נחשבים במיון ובהקלדת האותיות הראשונות של השם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चुनता है कि शीर्षक की शुरुआत में The, A और An क्रमबद्ध करते समय और शीर्षक के पहले अक्षर टाइप करते समय गिने जाएँ या नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Memilih apakah The, A, dan An di awal judul dihitung saat mengurutkan dan saat mengetik huruf pertama judul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sceglie se The, A e An all’inizio di un titolo contano nell’ordinamento e quando digiti le prime lettere di un titolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "タイトルの先頭の The、A、An を、並べ替えのときと、タイトルの最初の文字を入力するときに数えるかどうかを選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "제목 맨 앞의 The, A, An을 정렬할 때와 제목의 첫 글자를 입력할 때 포함할지 선택합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kiest of The, A en An aan het begin van een titel meetellen bij het sorteren en bij het typen van de eerste letters van een titel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Określa, czy słowa The, A i An na początku tytułu są brane pod uwagę przy sortowaniu i wpisywaniu pierwszych liter tytułu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escolhe se The, A e An no início de um título contam ao ordenar e ao digitar as primeiras letras de um título."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Выбирает, учитываются ли The, A и An в начале названия при сортировке и при вводе первых букв названия."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Väljer om The, A och An i början av en titel räknas vid sortering och när du skriver en titels första bokstäver."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เลือกว่า The, A และ An ที่ต้นชื่อเรื่องจะนับหรือไม่เมื่อเรียงลำดับและเมื่อพิมพ์ตัวอักษรแรกของชื่อเรื่อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Başlığın başındaki The, A ve An kelimelerinin sıralamada ve bir başlığın ilk harfleri yazılırken sayılıp sayılmayacağını seçer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Визначає, чи враховуються артиклі The, A і An на початку назви під час сортування та введення перших літер назви."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "طے کرتا ہے کہ عنوان کے شروع میں The، A اور An کو ترتیب دینے اور عنوان کے ابتدائی حروف ٹائپ کرنے میں شمار کیا جائے یا نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chọn có tính The, A và An ở đầu tiêu đề khi sắp xếp và khi gõ những chữ cái đầu của tiêu đề hay không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "选择在排序和输入标题首字母时，是否将标题开头的 The、A 和 An 计算在内。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選擇標題開頭的 The、A 和 An 在排序與輸入標題前幾個字母時是否計入。"
          }
        }
      }
    },
