        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@-এর টেক্সট সম্পাদনা বন্ধ হয়েছে, কারণ একটি নতুন কপি এটি প্রতিস্থাপন করেছে।"
          }
