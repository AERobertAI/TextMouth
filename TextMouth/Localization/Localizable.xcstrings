    "audioEditor.explanation.editorPunchIn" : {
      "comment" : "Hint of the audio editor's Punch In button. \"Stop\" is the name of a button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يسجّل فوق التحديد، أو عند المؤشر، بعد نغمة. ينهيه اختياره مرة أخرى أو اختيار “إيقاف”."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বিপ শব্দের পর নির্বাচনের ওপর, বা কার্সরের জায়গায় রেকর্ড করে। আবার বেছে নিলে, বা “থামান” বেছে নিলে, রেকর্ডিং শেষ হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nimmt nach einem Signalton auf und ersetzt die Auswahl oder fügt am Cursor ein. Ein erneutes „Darüber aufnehmen“ oder „Stoppen“ beendet die Aufnahme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Records over the selection, or at the cursor, after a beep. Again, or Stop, ends it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Graba sobre la selección o en el cursor, después de un pitido. Usarlo de nuevo, o Detener, la termina."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پس از یک بوق، روی انتخاب یا در محل مکان‌نما ضبط می‌کند. انتخاب دوباره‌ی آن، یا «توقف»، ضبط را پایان می‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Enregistre sur la sélection, ou au curseur, après un bip. Enregistrer par-dessus à nouveau, ou Arrêter, le termine."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מקליט מעל הבחירה, או בסמן, אחרי צפצוף. הפעלה נוספת, או “עצור”, מסיימת את ההקלטה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "बीप के बाद चयन के ऊपर, या कर्सर पर रिकॉर्ड करता है। दोबारा चुनने पर, या “रोकें” से, यह समाप्त होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Merekam menimpa pilihan, atau di posisi kursor, setelah bunyi bip. Pilih lagi, atau Berhenti, untuk mengakhirinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Registra sopra la selezione, o nella posizione del cursore, dopo un segnale acustico. Per terminare, sceglilo di nuovo o scegli Interrompi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ビープ音のあと、選択範囲に上書き、またはカーソルの位置に録音します。「上書き録音」をもう一度選ぶか、「停止」で終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "신호음 뒤에 선택 영역 위나 커서 위치에 녹음합니다. 다시 선택하거나 중지하면 끝납니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Neemt over de selectie of bij de cursor op, na een pieptoon. Opnieuw kiezen of Stop beëindigt de opname."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nagrywa w miejsce zaznaczenia albo przy kursorze, po sygnale dźwiękowym. Ponowne użycie albo Zatrzymaj kończy nagrywanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Grava sobre a seleção ou no cursor, após um sinal sonoro. Usá-lo de novo ou usar Parar encerra a gravação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Записывает поверх выделенного или в позиции курсора после сигнала. Повторный вызов или «Остановить» завершает запись."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Spelar in över markeringen eller vid markören, efter ett pip. Samma kommando igen, eller Stoppa, avslutar inspelningen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "บันทึกทับส่วนที่เลือก หรือที่เคอร์เซอร์ หลังเสียงบี๊บ เลือกอีกครั้ง หรือเลือก หยุด เพื่อสิ้นสุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Seçimin üzerine veya imlecin olduğu yere, bip sesinden sonra kayıt yapar. Yeniden seçmek veya Durdur kaydı bitirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Записує поверх виділення або в місці курсора після сигналу. «Записати поверх» знову чи «Зупинити» завершує запис."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بیپ کے بعد انتخاب پر، یا کرسر پر، ریکارڈ کرتا ہے۔ اسے دوبارہ منتخب کرنے سے، یا “روکیں” سے، ریکارڈنگ ختم ہو جاتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ghi đè lên vùng chọn, hoặc tại con trỏ, sau một tiếng bíp. Chọn lại, hoặc Dừng, sẽ kết thúc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在提示音之后，覆盖所选内容或在光标处录制。再次选取它或选取“停止”即可结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "嗶聲之後，覆蓋錄製選取範圍，或在游標處錄音。再次選擇或選擇「停止」即可結束。"
          }
        }
      }
    },
    "audioEditor.explanation.editorRedo" : {
      "comment" : "Hint of the audio editor's Redo button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعيد آخر تعديل تم التراجع عنه."
