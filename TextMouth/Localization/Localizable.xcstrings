        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ düzeltme dosyası hasarlı ya da başka bir kayda ait, bu yüzden %2$@ dönüştürülemedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл корекції %1$@ пошкоджено або він належить до іншого запису, тому %2$@ не вдалося перетворити."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اصلاحی فائل %1$@ خراب ہے یا کسی دوسری ریکارڈنگ کی ہے، اس لیے %2$@ تبدیل نہیں ہو سکی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tệp hiệu chỉnh %1$@ bị hỏng hoặc thuộc về bản ghi âm khác, nên không thể chuyển đổi %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "校正文件 %1$@ 已损坏或属于另一段录音，因此无法转换 %2$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "校正檔案 %1$@ 已損毀，或屬於另一份錄音，因此無法轉換 %2$@。"
          }
        }
      }
    },
