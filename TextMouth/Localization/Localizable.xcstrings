          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth “%@” को दूसरे ब्रेल कोड के साथ फिर से पढ़ रहा है। इसके पूरा होने पर फिर से प्रयास करें।"
