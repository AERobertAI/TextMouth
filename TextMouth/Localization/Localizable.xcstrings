        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le chapitre %@ n’a pas pu être lu : %@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא ניתן היה לנגן את פרק %1$@: %2$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "अध्याय %1$@ चलाया नहीं जा सका: %2$@।"
          }
        },
        "id" : {
          "stringUnit" : {
