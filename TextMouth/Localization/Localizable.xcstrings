        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A la copia migrada le falta el contenido de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il manque à la copie migrée le contenu de %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nella copia migrata manca il contenuto di %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A cópia migrada não tem o conteúdo de %@."
