    "protection.importLockedHint" : {
      "comment" : "Hint of the Import Locked button: what it does and how to unlock the books later.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يضيف الكتب مقفلة. يمكنك فتح قفل كل كتاب عند فتحه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইগুলি লক করা অবস্থায় যোগ করে। প্রতিটি বই খোলার সময় আনলক করতে পারবেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fügt die Bücher gesperrt hinzu. Sie können jedes beim Öffnen entsperren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds the books locked. You can unlock each one when you open it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Añade los libros bloqueados. Puedes desbloquear cada uno al abrirlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب‌ها را قفل‌شده اضافه می‌کند. هنگام باز کردن هر کدام می‌توانید قفلش را باز کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ajoute les livres verrouillés. Vous pourrez déverrouiller chacun à son ouverture."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מוסיף את הספרים נעולים. אפשר לבטל את הנעילה של כל אחד בעת פתיחתו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पुस्तकों को लॉक करके जोड़ता है। हर पुस्तक खोलते समय आप उसे अनलॉक कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menambahkan buku dalam keadaan terkunci. Anda dapat membuka kunci tiap buku saat membukanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aggiunge i libri bloccati. Potrai sbloccare ciascuno quando lo apri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブックをロックしたまま追加します。開くときに1冊ずつロックを解除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책을 잠긴 상태로 추가합니다. 각 책을 열 때 잠금을 해제할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voegt de boeken vergrendeld toe. Je kunt elk boek ontgrendelen als je het opent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dodaje książki zablokowane. Każdą możesz odblokować przy otwarciu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Adiciona os livros bloqueados. Você pode desbloquear cada um ao abri-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Добавляет книги заблокированными. Каждую можно разблокировать при открытии."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lägger till böckerna låsta. Du kan låsa upp varje bok när du öppnar den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เพิ่มหนังสือแบบล็อก คุณปลดล็อกแต่ละเล่มได้เมื่อเปิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitapları kilitli olarak ekler. Her birini açtığınızda kilidini açabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Додає книги заблокованими. Кожну можна розблокувати під час відкриття."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتابوں کو مقفل شامل کرتا ہے۔ ہر کتاب کھولتے وقت آپ اسے ان لاک کر سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thêm sách ở trạng thái khóa. Bạn có thể mở khóa từng cuốn khi mở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "以锁定状态添加这些图书。打开每本图书时可以解锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "以鎖定狀態加入這些書。開啟每本書時可以解鎖。"
          }
        }
      }
    },
    "protection.locked" : {
      "comment" : "Why a book's text could not be read: it is protected by a password and has not been unlocked.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
