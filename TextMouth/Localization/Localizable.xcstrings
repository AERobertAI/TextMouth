    "brailleCode.readingAgainRefusal" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. Why what would rewrite the text of the braille book titled bookTitle waits while TextMouth reads it again with another braille code, as the other re-reads' sentences say it (TextEncodingWording.readingAgainRefusal(bookTitle:), BrailleFileCodeWording.readingAgainRefusal(bookTitle:)). Placeholders in order: bookTitle.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعيد TextMouth قراءة “%@” برمز برايل آخر. حاول مرة أخرى عند انتهاء ذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth “%@” অন্য ব্রেইল কোডে আবার পড়ছে। সেটি শেষ হলে আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth liest „%@“ gerade mit einem anderen Braille-Code erneut. Versuche es erneut, wenn das beendet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth is reading “%@” again with another braille code. Try again when that finishes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth está volviendo a leer “%@” con otro código braille. Inténtalo de nuevo cuando termine."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth در حال خواندن دوباره‌ی «%@» با کد بریل دیگری است. پس از پایان آن دوباره تلاش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
