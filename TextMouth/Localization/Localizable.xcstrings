    "audioEditor.historyUnusableExplanation" : {
      "comment" : "Explains the question about an unreadable audio edit history: what Start Over and Cancel do.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم الاحتفاظ بنسخة في حزمة الكتاب. ابدأ من جديد بلا تعديلات، أو ألغِ."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইয়ের প্যাকেজে একটি কপি রাখা হয়েছিল। কোনো সম্পাদনা ছাড়া নতুন করে শুরু করুন, অথবা বাতিল করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eine Kopie wurde im Paket des Buchs aufbewahrt. Fange ohne Bearbeitungen neu an oder brich ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A copy was kept in the book's package. Start over with no edits, or cancel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se conservó una copia en el paquete del libro. Empieza de nuevo sin ediciones, o cancela."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یک نسخه در بسته‌ی کتاب نگه داشته شد. بدون هیچ ویرایشی از ابتدا شروع کنید، یا لغو کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une copie a été conservée dans le paquet du livre. Recommencez sans modification, ou annulez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "עותק נשמר בחבילת הספר. התחל מחדש ללא עריכות, או בטל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पुस्तक के पैकेज में एक प्रति रखी गई थी। बिना किसी संपादन के नए सिरे से शुरू करें, या रद्द करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Salinan disimpan di paket buku. Mulai dari awal tanpa edit, atau batalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una copia è stata conservata nel pacchetto del libro. Ricomincia senza modifiche oppure annulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "コピーはブックのパッケージ内に保管されています。編集なしで最初からやり直すか、キャンセルできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책 패키지에 사본이 보관되어 있습니다. 편집 없이 처음부터 다시 시작하거나 취소할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Er is een kopie bewaard in het pakket van het boek. Begin opnieuw zonder bewerkingen, of annuleer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kopia została zachowana w pakiecie książki. Zacznij od nowa bez edycji albo anuluj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uma cópia foi mantida no pacote do livro. Recomece sem edições ou cancele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Копия сохранена в пакете книги. Начните заново без правок или отмените."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En kopia sparades i bokens paket. Börja om utan redigeringar, eller avbryt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เก็บสำเนาไว้ในแพ็กเกจของหนังสือแล้ว เริ่มใหม่โดยไม่มีการแก้ไข หรือยกเลิก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitabın paketinde bir kopya saklandı. Düzenlemesiz baştan başlayın veya vazgeçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Копію збережено в пакеті книги. Почніть спочатку без правок або скасуйте."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ایک کاپی کتاب کے پیکیج میں رکھی گئی ہے۔ بغیر کسی ترمیم کے نئے سرے سے شروع کریں، یا منسوخ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Một bản sao đã được giữ trong gói của sách. Hãy bắt đầu lại mà không có chỉnh sửa nào, hoặc hủy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "副本已保留在图书的包中。可以不带任何编辑重新开始，或取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "已在書籍套件中保留一份副本。你可以從頭開始（不含任何編輯），或取消。"
          }
        }
      }
    },
    "audioEditor.historyUnusableQuestion" : {
