        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আগে সেগুলো ডাউনলোড করুন: লাইব্রেরিতে সেগুলো নির্বাচন করে %@ বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lade sie zuerst herunter: Wähle sie in der Bibliothek aus und wähle dann %@."
