    "feedDownloadProgress.comingBack.check" : {
      "comment" : "After Cancel stops feed downloads, exactly one of which TextMouth downloads again by itself.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ينزّل TextMouth واحدًا منها مرة أخرى عند الفحص التالي لموجزه، أو عند فتحه في المرة القادمة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth সেগুলোর মধ্যে 1টি আবার ডাউনলোড করে, সেটির ফিডের পরের চেকে বা পরের বার খোলার সময়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth lädt 1 davon bei der nächsten Prüfung seines Feeds oder beim nächsten Öffnen erneut herunter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth downloads 1 of them again at its feed's next check, or the next time it opens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth vuelve a descargar 1 de ellos en la próxima revisión de su canal, o la próxima vez que se abra."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 1 مورد از آن‌ها را در بررسی بعدی فیدش یا دفعه بعد که باز شود دوباره بارگیری می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth en télécharge de nouveau 1 à la prochaine vérification de son flux, ou à sa prochaine ouverture."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth מוריד שוב 1 מהם בבדיקה הבאה של הערוץ שלו, או בפעם הבאה שהוא נפתח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इनमें से 1 को TextMouth उसके फ़ीड की अगली जाँच पर, या अगली बार खुलने पर, फिर से डाउनलोड करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth mengunduh ulang 1 di antaranya pada pemeriksaan feed-nya yang berikutnya, atau saat TextMouth dibuka lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ne scarica di nuovo 1 al prossimo controllo del suo feed, o al prossimo avvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "そのうち1件は、フィードの次回の確認時、または次に TextMouth を開いたときに、もう一度ダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 중 1개는 피드를 다음에 확인할 때나 TextMouth를 다음에 열 때 다시 다운로드됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth downloadt 1 ervan opnieuw bij de volgende controle van de feed, of de volgende keer dat TextMouth start."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth pobierze 1 z nich ponownie przy następnym sprawdzeniu jego kanału lub przy następnym otwarciu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth baixa 1 deles novamente na próxima verificação do feed dele, ou na próxima vez que abrir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth снова загрузит 1 из них при следующей проверке его ленты или при следующем открытии."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth hämtar 1 av dem igen vid flödets nästa kontroll, eller nästa gång TextMouth öppnas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth จะดาวน์โหลด 1 รายการในนั้นอีกครั้งเมื่อตรวจสอบฟีดของรายการครั้งถัดไป หรือเมื่อเปิดแอปครั้งถัดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth bunlardan 1 tanesini, beslemesinin bir sonraki denetiminde veya bir sonraki açılışında yeniden indirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth знову завантажить 1 із них під час наступної перевірки його стрічки або під час наступного відкриття."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ان میں سے 1 کو اس کی فیڈ کی اگلے چیک پر، یا اگلی بار کھلنے پر، دوبارہ ڈاؤن لوڈ کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tải về lại 1 trong số đó ở lần kiểm tra kế tiếp của nguồn cấp, hoặc ở lần mở kế tiếp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 会在订阅源下次检查时或下次打开时，重新下载其中的 1 个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 會在其訂閱源下次檢查時，或下次打開時，重新下載其中 1 個。"
          }
        }
      }
    },
