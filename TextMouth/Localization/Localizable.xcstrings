        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe a exportação e mantém por uma semana os capítulos já falados, até outra exportação de áudio falado começar ou a voz, o texto, as substituições ou as pausas do livro mudarem. Exportar o mesmo intervalo com a mesma velocidade e o mesmo tom continua a partir deles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Останавливает экспорт и сохраняет уже озвученные главы на неделю, до начала другого экспорта озвученного аудио или изменения голоса, текста, замен или пауз книги. Экспорт того же диапазона с теми же скоростью и высотой тона продолжится с них."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppar exporten och behåller de redan upplästa kapitlen i en vecka, tills en annan export av uppläst ljud startar eller bokens röst, text, ersättningar eller pauser ändras. En export av samma intervall med samma hastighet och tonhöjd fortsätter från dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หยุดการส่งออกและเก็บบทที่อ่านออกเสียงแล้วไว้หนึ่งสัปดาห์ จนกว่าการส่งออกเสียงอ่านครั้งอื่นจะเริ่ม หรือเสียง ข้อความ การแทนที่ หรือช่วงหยุดของหนังสือเปลี่ยนไป การส่งออกช่วงเดียวกันด้วยความเร็วและความสูงต่ำของเสียงเท่าเดิมจะทำต่อจากบทเหล่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dışa aktarmayı durdurur ve seslendirilmiş bölümleri, farklı bir seslendirilmiş ses dışa aktarması başlayana veya kitabın sesi, metni, değiştirmeleri ya da duraklamaları değişene kadar bir hafta saklar. Aynı aralığı aynı hız ve perdeyle dışa aktarmak onlardan devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Зупиняє експорт і зберігає вже озвучені розділи на тиждень, до початку іншого експорту озвученого аудіо або зміни голосу, тексту, замін чи пауз книги. Експорт того самого діапазону з тією самою швидкістю й висотою тону продовжується з них."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "برآمد روکتا ہے اور اب تک بولے گئے ابواب کو ایک ہفتے تک رکھتا ہے، جب تک کوئی دوسری بولی گئی آڈیو برآمد شروع نہ ہو یا کتاب کی آواز، متن، تبدیلی کے اصول یا وقفے نہ بدلیں۔ اسی رفتار اور پچ پر وہی حد برآمد کرنے سے کام انہی سے آگے بڑھتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dừng quá trình xuất và giữ các chương đã đọc trong một tuần, cho đến khi một lần xuất âm thanh đọc khác bắt đầu, hoặc giọng nói, văn bản, quy tắc thay thế hay quãng nghỉ của sách thay đổi. Nếu xuất cùng phạm vi với cùng tốc độ và cao độ, quá trình xuất sẽ tiếp tục từ các chương đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止导出，并将已朗读的章节保留一周，直到开始另一次朗读音频导出，或图书的语音、文本、替换或停顿发生变化。以同样的速度和音调导出相同范围，会从这些章节继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止輸出，並將已朗讀的章節保留一週，直到開始另一次語音音訊輸出，或書籍的語音、文字、取代規則或停頓更改為止。以相同的速度和音調輸出相同範圍，會從這些章節繼續。"
          }
        }
      }
    },
    "speechExport.throughHint" : {
      "comment" : "The hint of the To pop-up in the Export dialog's spoken audio options.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "العنوان الرئيسي الذي ينتهي الصوت بنهاية قسمه، بما فيه من عناوين فرعية، أو نهاية الكتاب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "যে হেডিংয়ের বিভাগের শেষে অডিও শেষ হয়, তার উপহেডিংসহ, অথবা বইয়ের শেষ।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Überschrift, deren Abschnitt das Audio beendet, mit ihren Unterüberschriften, oder das Ende des Buchs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The heading whose section ends the audio, with its subheadings, or the end of the book."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El encabezado cuya sección termina el audio, con sus subencabezados, o el final del libro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سرفصلی که بخش آن، با زیرسرفصل‌هایش، صدا را پایان می‌دهد، یا پایان کتاب."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’en-tête dont la section termine l’audio, avec ses sous-en-têtes, ou la fin du livre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הכותרת שהמקטע שלה מסיים את השמע, עם כותרות המשנה שלה, או סוף הספר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "वह हेडिंग जिसका खंड ऑडियो को ख़त्म करता है, उसकी उपहेडिंग के साथ, या पुस्तक का अंत।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tajuk yang bagiannya mengakhiri audio, beserta subtajuknya, atau akhir buku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’intestazione la cui sezione termina l’audio, con le sue sottointestazioni, oppure la fine del libro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オーディオの終わりとなるセクションの見出し（小見出しを含む）、またはブックの終わりです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "섹션이 오디오의 끝이 되는 표제(하위 표제 포함) 또는 책의 끝입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De kop waarvan de sectie de audio beëindigt, met zijn subkoppen, of het einde van het boek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nagłówek, którego sekcja kończy dźwięk, razem z jego podnagłówkami, albo koniec książki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O cabeçalho cuja seção termina o áudio, com seus subcabeçalhos, ou o fim do livro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Заголовок, раздел которого завершает аудио, вместе с его подзаголовками, или конец книги."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rubriken vars sektion avslutar ljudet, med dess underrubriker, eller slutet av boken."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หัวข้อที่ส่วนของหัวข้อนั้นเป็นจุดสิ้นสุดของเสียง พร้อมหัวข้อย่อย หรือจุดสิ้นสุดของหนังสือ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kısmı, alt başlıklarıyla birlikte sesi bitiren başlık ya da kitabın sonu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Заголовок, секція якого завершує аудіо, разом з його підзаголовками, або кінець книги."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "وہ سرخی جس کا حصہ آڈیو کو ختم کرتا ہے، اس کی ذیلی سرخیوں کے ساتھ، یا کتاب کا اختتام۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đề mục mà phần của nó kết thúc âm thanh, cùng các đề mục con, hoặc cuối sách."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "音频结束的位置：某个章节标题所属部分（含其子标题）的末尾，或图书结尾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "音訊結束的位置：某個標題的區段結尾（連同其子標題），或書籍結尾。"
          }
        }
      }
    },
