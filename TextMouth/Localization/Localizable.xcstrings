                  "value" : "Imported %lld books, but %@"
                }
              }
            }
          }
        }
      }
    },
    "Imported %lld books." : {
      "comment" : "Sentence of the alert about a ZIP batch that was cancelled after it imported some books. %lld is the number of books imported.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
