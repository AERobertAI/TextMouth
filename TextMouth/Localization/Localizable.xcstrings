    "libraryViewEditor.limitUnavailableHint" : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. Show at Most's hint while the view lists feeds alone, when it is dimmed (finding 6).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يختار الحد من بين الكتب والحلقات والمقالات، ولا يختار الموجزات أبدًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সীমা বই, পর্ব ও নিবন্ধের মধ্যে বেছে নেয়, ফিড কখনও নয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Limit wählt unter Büchern, Folgen und Artikeln aus, nie unter Feeds."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A limit chooses among books, episodes, and articles, never feeds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un límite elige entre libros, episodios y artículos, nunca canales."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "محدودیت از میان کتاب‌ها، قسمت‌ها و مقاله‌ها انتخاب می‌کند، نه فیدها."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une limite choisit parmi les livres, les épisodes et les articles, jamais les flux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מגבלה בוחרת מבין ספרים, אפיזודות וכתבות, אף פעם לא ערוצים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सीमा पुस्तकों, एपिसोड और लेखों में से चुनती है, फ़ीड में से कभी नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Batas memilih di antara buku, episode, dan artikel, bukan feed."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un limite sceglie tra libri, episodi e articoli, mai tra i feed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "制限で選べるのは、ブック、エピソード、記事です。フィードは選べません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "제한은 책, 에피소드, 기사 중에서 선택하며 피드는 선택하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Een limiet kiest uit boeken, afleveringen en artikelen, nooit uit feeds."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Limit dotyczy książek, odcinków i artykułów, nigdy kanałów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um limite escolhe entre livros, episódios e artigos, nunca feeds."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ограничение выбирает только книги, выпуски и статьи, но не ленты."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En gräns väljer bland böcker, avsnitt och artiklar, aldrig flöden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ขีดจำกัดเลือกได้เฉพาะหนังสือ ตอน และบทความ ไม่รวมฟีด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sınır, beslemeler arasından değil, yalnızca kitaplar, podcast bölümleri ve makaleler arasından seçer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Обмеження вибирає серед книг, епізодів і статей, але не стрічок."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "حد کتابوں، ایپی سوڈز اور مضامین میں سے انتخاب کرتی ہے، فیڈز میں سے کبھی نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Giới hạn chọn trong số sách, tập và bài viết, không bao giờ chọn nguồn cấp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "限制只在图书、单集和文章中选取，不涉及订阅源。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "限制只會在書籍、單集和文章之間選擇，不包含訂閱源。"
          }
        }
      }
    },
    "libraryViewEditor.listsCaption" : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. What conditions test, under the kinds.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "الشروط المتعلقة بالكتب تختبر الكتب والحلقات والمقالات؛ والشروط المتعلقة بالموجزات تختبر الموجزات. لا يخفي الشرط أبدًا صفًا لا يختبره."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বই-সংক্রান্ত শর্ত বই, পর্ব ও নিবন্ধ পরীক্ষা করে; ফিড-সংক্রান্ত শর্ত ফিড পরীক্ষা করে। কোনো শর্ত কখনও এমন সারি লুকায় না, যা সে পরীক্ষা করে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bedingungen zu Büchern prüfen Bücher, Folgen und Artikel; Bedingungen zu Feeds prüfen Feeds. Eine Bedingung blendet nie eine Zeile aus, die sie nicht prüft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conditions about books test books, episodes, and articles; conditions about feeds test feeds. A condition never hides a row it does not test."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Las condiciones sobre libros evalúan libros, episodios y artículos; las condiciones sobre canales evalúan canales. Una condición nunca oculta una fila que no evalúa."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "شرط‌هایی که درباره‌ی کتاب هستند، کتاب‌ها، قسمت‌ها و مقاله‌ها را می‌سنجند؛ شرط‌هایی که درباره‌ی فید هستند، فیدها را می‌سنجند. شرط هرگز ردیفی را که نمی‌سنجد پنهان نمی‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les conditions sur les livres testent les livres, les épisodes et les articles ; les conditions sur les flux testent les flux. Une condition ne masque jamais une ligne qu’elle ne teste pas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "תנאים על ספרים בודקים ספרים, אפיזודות וכתבות; תנאים על ערוצים בודקים ערוצים. תנאי לעולם אינו מסתיר שורה שהוא אינו בודק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पुस्तकों की शर्तें पुस्तकों, एपिसोड और लेखों को जाँचती हैं; फ़ीड की शर्तें फ़ीड को जाँचती हैं। कोई शर्त उस पंक्ति को नहीं छिपाती जिसे वह जाँचती नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kondisi tentang buku menguji buku, episode, dan artikel; kondisi tentang feed menguji feed. Kondisi tidak pernah menyembunyikan baris yang tidak diujinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le condizioni sui libri verificano libri, episodi e articoli; le condizioni sui feed verificano i feed. Una condizione non nasconde mai una riga che non verifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブックに関する条件はブック、エピソード、記事を調べ、フィードに関する条件はフィードを調べます。条件が、調べない行を非表示にすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책에 대한 조건은 책, 에피소드, 기사를 검사하고, 피드에 대한 조건은 피드를 검사합니다. 조건은 검사하지 않는 행을 숨기지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voorwaarden over boeken testen boeken, afleveringen en artikelen; voorwaarden over feeds testen feeds. Een voorwaarde verbergt nooit een rij die ze niet test."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Warunki dotyczące książek sprawdzają książki, odcinki i artykuły; warunki dotyczące kanałów sprawdzają kanały. Warunek nigdy nie ukrywa wiersza, którego nie sprawdza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "As condições sobre livros testam livros, episódios e artigos; as condições sobre feeds testam feeds. Uma condição nunca oculta uma linha que ela não testa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Условия для книг проверяют книги, выпуски и статьи; условия для лент проверяют ленты. Условие никогда не скрывает строку, которую не проверяет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Villkor om böcker testar böcker, avsnitt och artiklar; villkor om flöden testar flöden. Ett villkor döljer aldrig en rad som det inte testar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เงื่อนไขเกี่ยวกับหนังสือจะทดสอบหนังสือ ตอน และบทความ เงื่อนไขเกี่ยวกับฟีดจะทดสอบฟีด เงื่อนไขจะไม่ซ่อนแถวที่ไม่ได้ทดสอบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitaplarla ilgili koşullar kitapları, podcast bölümlerini ve makaleleri sınar; beslemelerle ilgili koşullar beslemeleri sınar. Bir koşul, sınamadığı bir satırı asla gizlemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Умови щодо книг перевіряють книги, епізоди та статті; умови щодо стрічок перевіряють стрічки. Умова ніколи не приховує рядок, який вона не перевіряє."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتابوں کے بارے میں شرائط کتابوں، ایپی سوڈز اور مضامین کو جانچتی ہیں؛ فیڈز کے بارے میں شرائط فیڈز کو جانچتی ہیں۔ کوئی شرط ایسی صف کو نہیں چھپاتی جسے وہ نہیں جانچتی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Điều kiện về sách kiểm tra sách, tập và bài viết; điều kiện về nguồn cấp kiểm tra nguồn cấp. Một điều kiện không bao giờ ẩn hàng mà nó không kiểm tra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "关于图书的条件会检验图书、单集和文章；关于订阅源的条件检验订阅源。条件不会隐藏它不检验的行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "有關書籍的條件會檢查書籍、單集和文章；有關訂閱源的條件會檢查訂閱源。條件不會隱藏它未檢查的列。"
          }
        }
      }
    },
