    "sleepTimerView.newTimerNote.replaces" : {
      "comment" : "Note under the sleep timer sheet's New Timer heading while a timer runs: setting one of the timers below stops it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحل مؤقت جديد محل المؤقت الجاري."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "একটি নতুন টাইমার চলমান টাইমারটিকে প্রতিস্থাপন করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein neuer Timer ersetzt den laufenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new timer replaces the one running."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un temporizador nuevo reemplaza al que está en curso."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "زمان‌سنج جدید جایگزین زمان‌سنج در حال اجرا می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un nouveau minuteur remplace celui en cours."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "טיימר חדש מחליף את הטיימר שרץ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "नया टाइमर चल रहे टाइमर की जगह ले लेता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Timer baru menggantikan timer yang sedang berjalan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un nuovo timer sostituisce quello in corso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "実行中のタイマーは、新しいタイマーに置き換わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "새 타이머를 설정하면 실행 중인 타이머가 대체됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Een nieuwe timer vervangt de timer die loopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nowy minutnik zastępuje uruchomiony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um novo timer substitui o que está em execução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Новый таймер заменит запущенный."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En ny timer ersätter den som körs."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตัวจับเวลาใหม่จะแทนที่ตัวที่กำลังทำงานอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yeni bir zamanlayıcı çalışanın yerini alır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Новий таймер замінює той, що працює."
