    "textNotKept.errorDescription" : {
      "comment" : "Error shown when Replace Existing could not keep the edited text of the library's copy beside the new copy's text. Nothing was replaced.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يتمكن TextMouth من الاحتفاظ بالنص المحرر للنسخة الموجودة في مكتبتك بجوار نص النسخة الجديدة، فترك النسختين كما هما."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth আপনার লাইব্রেরির কপির সম্পাদিত টেক্সট নতুন কপির টেক্সটের পাশে রাখতে পারেনি, তাই দুটি কপিই যেমন ছিল তেমনই রেখেছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth konnte den bearbeiteten Text der Kopie in deiner Bibliothek nicht neben dem Text der neuen Kopie erhalten und hat beide Kopien unverändert gelassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth couldn't keep the edited text of the copy in your library beside the new copy's text, so it left both copies as they are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no pudo conservar el texto editado de la copia de tu biblioteca junto al texto de la copia nueva, así que dejó ambas copias como están."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth نتوانست متن ویرایش‌شده‌ی نسخه‌ی موجود در کتابخانه‌ی شما را کنار متن نسخه‌ی جدید نگه دارد، بنابراین هر دو نسخه را همان‌طور که بودند گذاشت."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth n’a pas pu conserver le texte modifié de la copie de votre bibliothèque à côté du texte de la nouvelle copie, donc il a laissé les deux copies telles quelles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth לא הצליח לשמור את הטקסט הערוך של העותק בספרייה שלך לצד הטקסט של העותק החדש, ולכן השאיר את שני העותקים כפי שהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth आपकी लाइब्रेरी की कॉपी के संपादित टेक्स्ट को नई कॉपी के टेक्स्ट के बगल में नहीं रख सका, इसलिए उसने दोनों कॉपी जैसी थीं वैसी ही छोड़ दीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tidak dapat menyimpan teks hasil edit salinan di pustaka Anda di samping teks salinan baru, jadi kedua salinan dibiarkan apa adanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non è riuscito a conservare il testo modificato della copia nella tua libreria accanto al testo della nuova copia, quindi ha lasciato entrambe le copie come sono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は、ライブラリ内のコピーの編集済みテキストを新しいコピーのテキストとは別に残せなかったため、どちらのコピーもそのままにしました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 보관함에 있는 사본의 편집된 텍스트를 새 사본의 텍스트 옆에 유지하지 못해 두 사본을 그대로 두었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kon de bewerkte tekst van de kopie in je bibliotheek niet naast de tekst van de nieuwe kopie bewaren, dus blijven beide kopieën zoals ze zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth nie mógł zachować edytowanego tekstu kopii z biblioteki obok tekstu nowej kopii, więc obie kopie pozostawił bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não conseguiu manter o texto editado da cópia da sua biblioteca ao lado do texto da nova cópia, então deixou as duas cópias como estão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не удалось сохранить изменённый текст копии из вашей библиотеки рядом с текстом новой копии, поэтому обе копии оставлены как есть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kunde inte behålla den redigerade texten i kopian i ditt bibliotek bredvid den nya kopians text, så båda kopiorna lämnades som de var."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth เก็บข้อความที่แก้ไขของสำเนาในไลบรารีไว้คู่กับข้อความของสำเนาใหม่ไม่ได้ จึงปล่อยทั้งสองสำเนาไว้ตามเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth, kitaplığınızdaki kopyanın düzenlenmiş metnini yeni kopyanın metninin yanında saklayamadı, bu yüzden iki kopyayı da olduğu gibi bıraktı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не вдалося зберегти відредагований текст копії у вашій бібліотеці поряд із текстом нової копії, тому обидві копії залишено без змін."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth آپ کی لائبریری میں موجود کاپی کا ترمیم شدہ متن نئی کاپی کے متن کے ساتھ نہیں رکھ سکا، اس لیے اس نے دونوں کاپیاں جیسی تھیں ویسی ہی رہنے دیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth không thể giữ văn bản đã sửa của bản sao trong thư viện của bạn cạnh văn bản của bản sao mới, nên đã để nguyên cả hai bản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 无法将你资料库中副本的已编辑文本保留在新副本的文本旁，因此两个副本都保持原样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 無法將書庫中該副本編輯過的文字與新副本的文字一併保留，因此兩份副本都維持原樣。"
          }
        }
      }
    },
