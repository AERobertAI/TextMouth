            "value" : "Die Dateien des Buchs sind noch nicht auf diesem Mac. %@ synchronisiert sie möglicherweise noch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The book's files aren't on this Mac yet. %@ may still be syncing them."
          }
        },
