    "phoneRow.removalMessage.permanently" : {
      "comment" : "First sentence of the message of the iPhone's question before a book is removed: nothing is kept on this iPhone.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحذف الكتاب وملفاته نهائيًا من هذا الـ iPhone."
