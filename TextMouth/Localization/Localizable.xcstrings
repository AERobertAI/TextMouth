        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ נמצא בספרייה שלך, ללא הרשמה. כדי לבדוק אותו שוב, בחר “%2$@” בשורה שלו או ב“%3$@” שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
