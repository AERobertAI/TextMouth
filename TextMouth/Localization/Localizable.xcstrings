    "shortcutsSettings.worksInHint" : {
      "comment" : "VoiceOver hint of the Works in pop-up button of a keyboard shortcut action: choosing a choice makes the action the listener's own, and Reset to Default restores where it works by default.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يجعل الاختيار الاختصار خاصًا بك، وتستعيد “إعادة الضبط إلى الافتراضي” المكان الذي يعمل فيه افتراضيًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বেছে নিলে শর্টকাটটি আপনার নিজস্ব হয়ে যায়; “ডিফল্ট পুনরুদ্ধার করুন” ডিফল্ট কাজের জায়গা ফিরিয়ে আনে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eine Auswahl macht den Kurzbefehl zu deinem eigenen; „Auf Standard zurücksetzen“ stellt wieder her, wo er standardmäßig gilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choosing makes the shortcut yours; Reset to Default restores where it works by default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elegir hace tuyo el atajo; Restablecer valores predeterminados restaura dónde funciona por defecto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "انتخاب، میان‌بر را شخصی می‌کند؛ «بازنشانی به پیش‌فرض» محل کارکرد پیش‌فرض را برمی‌گرداند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un choix personnalise le raccourci ; Rétablir par défaut restaure les fenêtres où il fonctionne par défaut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הבחירה הופכת את הקיצור לשלך; “שחזר ברירת מחדל” משחזר את המקום שבו הוא פועל כברירת מחדל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चुनने पर शॉर्टकट आपका अपना हो जाता है; “डिफ़ॉल्ट पर रीसेट करें” उसका डिफ़ॉल्ट कार्य-क्षेत्र लौटा देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Memilih akan menjadikan pintasan ini milik Anda; Setel Ulang ke Default memulihkan tempat berfungsinya secara default."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scegliere rende tua la scorciatoia; Ripristina predefinito riporta le finestre in cui funziona a quelle predefinite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選択すると、このショートカットはカスタム設定になります。「デフォルトに戻す」で、デフォルトの動作場所に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "선택하면 이 단축키가 내 설정이 되며, 기본값으로 재설정을 선택하면 기본 작동 범위로 돌아갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Met een keuze wordt het toetsenbordcommando van jou; Herstel standaardwaarde zet terug waar het standaard werkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wybór ustawia własne miejsce działania skrótu; Przywróć domyślne przywraca miejsce domyślne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escolher torna o atalho seu; Restaurar padrão restaura onde ele funciona por padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Выбор делает сочетание вашим; «Сбросить по умолчанию» возвращает место, где оно работает по умолчанию."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ett val gör genvägen till din egen; ”Återställ till standard” återställer var den fungerar som standard."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "การเลือกจะทำให้ทางลัดนี้เป็นแบบกำหนดเอง ส่วน รีเซ็ตเป็นค่าเริ่มต้น จะคืนหน้าต่างที่ใช้งานได้ตามค่าเริ่มต้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bir seçim yapmak kısayolu size özel kılar; Varsayılanı Geri Yükle, varsayılan çalışma yerini geri getirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ваш вибір замінює типове значення; «Скинути до типових» відновлює вікна, де комбінація діє типово."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "منتخب کرنے سے شارٹ کٹ آپ کا اپنا ہو جاتا ہے؛ “ڈیفالٹ پر ری سیٹ کریں” اس کے کام کرنے کی ڈیفالٹ جگہ بحال کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Khi bạn chọn, phím tắt trở thành của riêng bạn; nút Đặt lại về mặc định khôi phục nơi phím tắt hoạt động theo mặc định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "选取后，此快捷键即成为你的自定设置；“重置为默认设置”会恢复其默认适用范围。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選擇後，快速鍵會變成你自己的；「重置為預設值」會還原預設的適用範圍。"
          }
        }
      }
    },
