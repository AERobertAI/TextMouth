    "audioSampleForm.advice" : {
      "comment" : "Ends every refusal of an audio file whose samples TextMouth can't decode: what the listener can do about it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "حوّله إلى عينات أعداد صحيحة 16 بت أو 24 بت، ثم استورده مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এটি 16-বিট বা 24-বিট ইন্টিজার স্যাম্পলে রূপান্তর করুন, তারপর আবার আমদানি করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Konvertiere sie in Ganzzahl-Samples mit 16 oder 24 Bit und importiere sie dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convert it to 16-bit or 24-bit integer samples, then import it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Conviértelo a muestras enteras de 16 o 24 bits y vuelve a importarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آن را به نمونه‌های عدد صحیح 16 بیتی یا 24 بیتی تبدیل کنید، سپس دوباره وارد کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Convertissez-le en échantillons entiers de 16 ou 24 bits, puis importez-le à nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "המר אותו לדגימות של 16 או 24 סיביות במספרים שלמים, ואז ייבא אותו שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसे 16-बिट या 24-बिट पूर्णांक सैंपल में बदलें, फिर दोबारा आयात करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Konversikan ke sampel bilangan bulat 16-bit atau 24-bit, lalu impor lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Convertilo in campioni interi a 16 o 24 bit, poi importalo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "16ビットまたは24ビットの整数サンプルに変換してから、もう一度読み込んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "16비트 또는 24비트 정수 샘플로 변환한 다음 다시 가져오십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zet het om naar integer-samples van 16 of 24 bits en importeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Przekonwertuj go na próbki całkowitoliczbowe 16- lub 24-bitowe, a potem zaimportuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Converta-o para amostras inteiras de 16 ou 24 bits e importe-o de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Преобразуйте его в 16- или 24-битные целочисленные отсчёты и импортируйте снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Konvertera den till 16- eller 24-bitars heltalssampel och importera den igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "แปลงเป็นข้อมูลเสียงแบบจำนวนเต็ม 16 บิตหรือ 24 บิต แล้วนำเข้าอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "16 bit veya 24 bit tamsayı örneklere dönüştürün, sonra yeniden içe aktarın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Перетворіть його на 16- або 24-бітні цілочисельні семпли й імпортуйте знову."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اسے 16-بٹ یا 24-بٹ انٹیجر سیمپلز میں تبدیل کریں، پھر دوبارہ درآمد کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hãy chuyển sang mẫu số nguyên 16 bit hoặc 24 bit, rồi nhập lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "请将其转换为 16 位或 24 位整数采样，然后再次导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "請將它轉換為 16 位元或 24 位元整數取樣，再重新輸入。"
          }
        }
      }
    },
