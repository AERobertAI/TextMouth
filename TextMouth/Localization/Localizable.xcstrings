    "transcriptCleanup.unreadableTranscript" : {
      "comment" : "Alert shown when Clean Up Transcript is chosen for an audiobook whose transcript cannot be read. %@ is the audiobook's title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّرت قراءة النسخة النصية لـ%@. إذا كان الكتاب في السحابة فقط، فنزّله وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@-এর ট্রান্সক্রিপ্ট পড়া যাচ্ছে না। বইটি শুধু ক্লাউডে থাকলে ডাউনলোড করুন এবং আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript von %@ kann nicht gelesen werden. Wenn das Buch nur in der Cloud ist, lade es herunter und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The transcript of %@ can't be read. If the book is only in the cloud, download it and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se puede leer la transcripción de %@. Si el libro solo está en la nube, descárgalo y vuelve a intentarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "رونوشت %@ خوانده نمی‌شود. اگر کتاب فقط در فضای ابری است، آن را بارگیری کنید و دوباره تلاش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcription de %@ ne peut pas être lue. Si le livre est seulement dans le cloud, téléchargez-le et réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא ניתן לקרוא את התמליל של %@. אם הספר נמצא רק בענן, הורד אותו ונסה שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ की ट्रांसक्रिप्ट पढ़ी नहीं जा सकती। यदि पुस्तक केवल क्लाउड में है, तो उसे डाउनलोड करें और फिर से प्रयास करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transkrip %@ tidak dapat dibaca. Jika buku hanya ada di cloud, unduh dan coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile leggere la trascrizione di %@. Se il libro è solo nel cloud, scaricalo e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@の文字起こしを読み取れません。ブックがクラウドにのみある場合は、ダウンロードしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@의 대본을 읽을 수 없습니다. 책이 클라우드에만 있다면 다운로드한 다음 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De transcriptie van %@ kan niet worden gelezen. Als het boek alleen in de cloud staat, download het dan en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie można odczytać transkrypcji audiobooka %@. Jeśli książka jest tylko w chmurze, pobierz ją i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não foi possível ler a transcrição de %@. Se o livro está apenas na nuvem, baixe-o e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не удалось прочитать расшифровку книги «%@». Если книга только в облаке, загрузите её и повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transkriptionen för %@ kan inte läsas. Om boken bara finns i molnet, hämta den och försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "อ่านข้อความถอดเสียงของ %@ ไม่ได้ หากหนังสืออยู่ในคลาวด์เท่านั้น ให้ดาวน์โหลดแล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ transkripti okunamıyor. Kitap yalnızca bulutta ise indirin ve tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не вдалося прочитати транскрипцію для %@. Якщо книга лише в хмарі, завантажте її й повторіть спробу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ کا ٹرانسکرپٹ پڑھا نہیں جا سکتا۔ اگر کتاب صرف کلاؤڈ میں ہے تو اسے ڈاؤن لوڈ کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không thể đọc bản chép lời của %@. Nếu sách chỉ có trên đám mây, hãy tải về và thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "无法读取“%@”的文字稿。如果图书仅在云端，请下载后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "無法讀取「%@」的逐字稿。如果這本書只在雲端，請先下載，然後再試一次。"
          }
        }
      }
    },
    "transcriptCleanup.userCopyInCloud" : {
      "comment" : "Line of the Clean Up Transcript sheet when the user's own rules file has not been downloaded from the cloud drive yet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نسختك من القواعد موجودة في السحابة فقط، لذا طلبها TextMouth ويستخدم قواعده الخاصة في هذه الأثناء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আপনার নিয়মের কপি শুধু ক্লাউডে আছে, তাই TextMouth সেটি চেয়েছে এবং ততক্ষণ নিজের নিয়ম ব্যবহার করছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deine Kopie der Regeln ist nur in der Cloud, daher hat TextMouth sie angefordert und verwendet in der Zwischenzeit seine eigenen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your copy of the rules is only in the cloud, so TextMouth asked for it and uses its own meanwhile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tu copia de las reglas solo está en la nube, así que TextMouth la solicitó y mientras tanto usa las suyas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نسخه‌ی شما از قاعده‌ها فقط در فضای ابری است، پس TextMouth آن را درخواست کرد و در این میان از قاعده‌های خودش استفاده می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Votre copie des règles est seulement dans le cloud, donc TextMouth l’a demandée et utilise les siennes en attendant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "העותק שלך של הכללים נמצא רק בענן, ולכן TextMouth ביקש אותו ובינתיים משתמש בכללים משלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "नियमों की आपकी प्रति केवल क्लाउड में है, इसलिए TextMouth ने उसे मँगवाया है और तब तक अपने नियम इस्तेमाल करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Salinan aturan Anda hanya ada di cloud, jadi TextMouth memintanya dan sementara memakai aturan bawaannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La tua copia delle regole è solo nel cloud, quindi TextMouth l’ha richiesta e nel frattempo usa le proprie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "お使いのルールのコピーはクラウドにのみあるため、TextMouth がダウンロードを要求しました。それまでは TextMouth 標準のルールを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "사용자 규칙 사본이 클라우드에만 있어서 TextMouth가 가져오도록 요청했으며, 그동안 자체 규칙을 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Je kopie van de regels staat alleen in de cloud, dus TextMouth heeft erom gevraagd en gebruikt ondertussen zijn eigen regels."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Twoja kopia reguł jest tylko w chmurze, więc TextMouth o nią poprosił i na razie używa własnych reguł."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sua cópia das regras está apenas na nuvem, então o TextMouth a solicitou e usa as regras próprias enquanto isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ваша копия правил только в облаке, поэтому TextMouth запросил её и пока использует собственные правила."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Din kopia av reglerna finns bara i molnet, så TextMouth har begärt den och använder sina egna under tiden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "สำเนากฎของคุณอยู่ในคลาวด์เท่านั้น TextMouth จึงขอดาวน์โหลดและใช้กฎของตัวเองไปก่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kurallarınızın kopyası yalnızca bulutta, bu yüzden TextMouth onu istedi ve bu arada kendi kurallarını kullanıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ваша копія правил лише в хмарі, тому TextMouth запросив її й тим часом використовує власні правила."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اصولوں کی آپ کی کاپی صرف کلاؤڈ میں ہے، اس لیے TextMouth نے اسے طلب کیا ہے اور اتنی دیر اپنے اصول استعمال کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bản sao các quy tắc của bạn chỉ có trên đám mây, nên TextMouth đã yêu cầu tải về và tạm dùng quy tắc riêng của mình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "你的规则副本仅在云端，因此 TextMouth 已请求下载，并暂时使用自带的规则。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "你的規則副本只在雲端，因此 TextMouth 已要求下載，並在此期間使用自己的規則。"
          }
        }
      }
    },
    "transcriptCleanup.userCopyUnusable" : {
      "comment" : "Line of the Clean Up Transcript sheet when the user's own rules file is damaged. %@ is the reason, a short technical phrase in English.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يمكن استخدام ملف قواعدك: %@. يحتفظ TextMouth به وبنسخة منه، ويستخدم قواعده الخاصة إلى أن تصحّحه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আপনার নিয়ম ফাইল ব্যবহার করা যাচ্ছে না: %@। TextMouth এটি ও একটি কপি রেখে দেয়, এবং আপনি ঠিক না করা পর্যন্ত নিজের নিয়ম ব্যবহার করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deine Regeldatei kann nicht verwendet werden: %@. TextMouth behält sie samt einer Kopie und verwendet seine eigenen Regeln, bis du sie korrigierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your rules file can't be used: %@. TextMouth keeps it and a copy, and uses its own rules until you correct it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se puede usar tu archivo de reglas: %@. TextMouth lo conserva junto con una copia, y usa sus propias reglas hasta que lo corrijas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فایل قاعده‌های شما قابل استفاده نیست: %@. TextMouth آن و یک نسخه از آن را نگه می‌دارد و تا وقتی آن را اصلاح کنید از قاعده‌های خودش استفاده می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Votre fichier de règles ne peut pas être utilisé : %@. TextMouth le garde ainsi qu’une copie, et utilise ses propres règles jusqu’à ce que vous le corrigiez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא ניתן להשתמש בקובץ הכללים שלך: %@. TextMouth שומר אותו ועותק שלו, ומשתמש בכללים משלו עד שתתקן אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आपकी नियम फ़ाइल इस्तेमाल नहीं की जा सकती: %@। TextMouth उसे और उसकी एक प्रति रखता है, और जब तक आप उसे ठीक नहीं करते, अपने नियम इस्तेमाल करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "File aturan Anda tidak dapat dipakai: %@. TextMouth menyimpannya beserta salinannya, dan memakai aturan bawaannya sampai Anda memperbaikinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile usare il tuo file di regole: %@. TextMouth lo conserva insieme a una copia e usa le proprie regole finché non lo correggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ルールファイルを使用できません：%@。TextMouth はそのファイルとコピーを保持し、修正されるまで標準のルールを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "규칙 파일을 사용할 수 없습니다: %@. TextMouth는 이 파일과 사본을 보관하며, 수정할 때까지 자체 규칙을 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Je regelbestand kan niet worden gebruikt: %@. TextMouth bewaart het en een kopie, en gebruikt zijn eigen regels totdat je het corrigeert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Twojego pliku reguł nie można użyć: %@. TextMouth zachowuje go wraz z kopią i używa własnych reguł, dopóki go nie poprawisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não é possível usar seu arquivo de regras: %@. O TextMouth o mantém, com uma cópia, e usa as regras próprias até você corrigi-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл с вашими правилами использовать нельзя: %@. TextMouth сохраняет его и копию и использует собственные правила, пока вы не исправите файл."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Din regelfil kan inte användas: %@. TextMouth behåller den och en kopia, och använder sina egna regler tills du rättar den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ใช้ไฟล์กฎของคุณไม่ได้: %@ TextMouth เก็บไฟล์และสำเนาไว้ และใช้กฎของตัวเองจนกว่าคุณจะแก้ไข"
          }
        },
        "tr" : {
