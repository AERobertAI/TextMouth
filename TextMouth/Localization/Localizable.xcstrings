        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đóng các tùy chọn này để bạn tiếp tục đọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "关闭这些选项，以便你继续阅读。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "關閉這些選項，讓你繼續閱讀。"
          }
        }
      }
    },
