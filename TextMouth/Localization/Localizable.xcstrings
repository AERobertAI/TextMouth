          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ข้อความรูปแบบริชเท็กซ์ โดยแต่ละหัวข้ออยู่ในระดับโครงร่างของตัวเอง สำหรับ Word, Pages และ TextEdit"
          }
        },
        "tr" : {
          "stringUnit" : {
