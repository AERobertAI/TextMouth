        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El audio de este libro se está convirtiendo de Ogg a AAC. Se reproducirá cuando termine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’audio de ce livre est en cours de conversion d’Ogg en AAC. Il sera lu à la fin de la conversion."
