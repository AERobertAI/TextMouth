      }
    },
    "Text not updated: %@ was removed, or its download deleted, so Edit Text has stopped for it." : {
      "comment" : "Announcement when an Edit Text session ends because the book left the library. %@ is the book's title. Edit Text is a menu command.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texto no actualizado: %@ se quitó, o se eliminó su descarga, así que Editar texto se detuvo para él."
          }
        }
      }
    },
    "Text not updated: chapter %@ of the edited text of %@ %@, which TextMouth can't read safely. Flatten it and save again, or undo the change; the book keeps its old text until then." : {
      "comment" : "Announcement when an edited text was refused because one chapter nests lists or quotes too deeply. %1$@ is the chapter's number, an identifier written without digit grouping; %2$@ is the book's title; %3$@ is a clause such as \"nests more than 20 levels deep\", written by another part of the app.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Text not updated: chapter %1$@ of the edited text of %2$@ %3$@, which TextMouth can't read safely. Flatten it and save again, or undo the change; the book keeps its old text until then."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texto no actualizado: el capítulo %1$@ del texto editado de %2$@ %3$@, algo que TextMouth no puede leer de forma segura. Simplifícalo y guarda de nuevo, o deshaz el cambio; hasta entonces el libro conserva su texto anterior."
          }
        }
      }
    },
    "Text not updated: the edited text of %@ %@, which TextMouth can't read safely. Flatten it and save again, or undo the change; the book keeps its old text until then." : {
      "comment" : "Announcement when an edited text was refused because it nests lists or quotes too deeply. %1$@ is the book's title; %2$@ is a clause such as \"nests more than 20 levels deep\", written by another part of the app.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Text not updated: the edited text of %1$@ %2$@, which TextMouth can't read safely. Flatten it and save again, or undo the change; the book keeps its old text until then."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texto no actualizado: el texto editado de %1$@ %2$@, algo que TextMouth no puede leer de forma segura. Simplifícalo y guarda de nuevo, o deshaz el cambio; hasta entonces el libro conserva su texto anterior."
          }
        }
      }
    },
    "Text not updated: the edited text of %@ has no chapter with any text. Undo the change and save again; the book keeps its old text until then." : {
      "comment" : "Announcement when an edited text was refused because no chapter has any text left. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texto no actualizado: el texto editado de %@ no tiene ningún capítulo con texto. Deshaz el cambio y guarda de nuevo; hasta entonces el libro conserva su texto anterior."
          }
        }
      }
    },
    "Text not updated: the edited text of %@ isn't UTF-8 text. Save it as UTF-8; the book keeps its old text until then." : {
      "comment" : "Announcement when an edited text was refused because it is not UTF-8 text. %@ is the book's title. UTF-8 is a text encoding.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texto no actualizado: el texto editado de %@ no es texto UTF-8. Guárdalo como UTF-8; hasta entonces el libro conserva su texto anterior."
          }
        }
      }
    },
    "Text not updated: the edited transcript of %@ adds words to a chapter with no speech, where they can't be kept. Remove them and save again; the book keeps its old text until then." : {
      "comment" : "Announcement when an edited transcript was refused because the user added words to a chapter with no speech. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texto no actualizado: la transcripción editada de %@ agrega palabras a un capítulo sin voz, donde no se pueden conservar. Quítalas y guarda de nuevo; hasta entonces el libro conserva su texto anterior."
          }
        }
      }
    },
    "Text not updated: the edited transcript of %@ changes a chapter's heading, which comes from its audio. Put it back and save again; the book keeps its old text until then." : {
      "comment" : "Announcement when an edited transcript was refused because the user changed a chapter's heading. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texto no actualizado: la transcripción editada de %@ cambia el encabezado de un capítulo, que viene de su audio. Vuelve a ponerlo y guarda de nuevo; hasta entonces el libro conserva su texto anterior."
          }
        }
      }
    },
    "Text not updated: the edited transcript of %@ has %@, but the audiobook has %@. Keep every line beginning with <!-- chapter: and save again; the book keeps its old text until then." : {
      "comment" : "Announcement when an edited transcript was refused because its number of chapters no longer matches the audiobook's. %1$@ is the book's title; %2$@ and %3$@ are counts of chapters such as \"3 chapters\". \"<!-- chapter:\" is literal text in the file and stays exactly as written.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Text not updated: the edited transcript of %1$@ has %2$@, but the audiobook has %3$@. Keep every line beginning with <!-- chapter: and save again; the book keeps its old text until then."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texto no actualizado: la transcripción editada de %1$@ tiene %2$@, pero el audiolibro tiene %3$@. Conserva cada línea que empieza con <!-- chapter: y guarda de nuevo; hasta entonces el libro conserva su texto anterior."
          }
        }
      }
    },
    "Text not updated: the original file of %@ changed too. The book's text is read from it again the next time the book opens." : {
      "comment" : "Announcement when an edited text was not taken because the book's own file changed too. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texto no actualizado: el archivo original de %@ también cambió. El texto del libro se vuelve a leer de él la próxima vez que se abra el libro."
          }
        }
      }
    },
    "Text not updated: the transcript of %@ changed too. The book's text is written from it again the next time the book opens." : {
      "comment" : "Announcement when an edited text was not taken because the book's transcript changed too. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texto no actualizado: la transcripción de %@ también cambió. El texto del libro se vuelve a escribir a partir de ella la próxima vez que se abra el libro."
          }
        }
      }
    },
    "Text recognition could not read %@: %@." : {
      "comment" : "Warning after a book of pictures was imported: text recognition could not read some pages. %1$@ is how many of how many, such as \"1 of 12 pages\", and %2$@ names the pages and why, such as \"page 3 (its picture could not be decoded)\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Text recognition could not read %1$@: %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El reconocimiento de texto no pudo leer %1$@: %2$@."
          }
        }
      }
    },
    "Text recognition could not read any of the %lld pages: %@." : {
      "comment" : "Why a book of several pages of pictures was refused at import: text recognition could not read any page. %1$lld is the number of pages and %2$@ names the pages and why, such as \"pages 1 and 2 (its picture could not be decoded)\".",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Text recognition could not read any of the %lld page: %@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Text recognition could not read any of the %lld pages: %@."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "El reconocimiento de texto no pudo leer ninguna de las %lld de páginas: %@."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "El reconocimiento de texto no pudo leer %lld página: %@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "El reconocimiento de texto no pudo leer ninguna de las %lld páginas: %@."
                }
              }
            }
          }
        }
      }
    },
    "Text recognition could not read the only page: %@." : {
      "comment" : "Why a book of one page of a picture was refused at import: text recognition could not read its only page. %@ names the page and why, such as \"page 1 (its picture could not be decoded)\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El reconocimiento de texto no pudo leer la única página: %@."
          }
        }
      }
    },
    "Text substitution rules could not be saved: %@" : {
      "comment" : "Failure notice: the text substitution rules could not be saved. %@ is the reason, a sentence from the system.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudieron guardar las reglas de sustitución de texto: %@"
          }
        }
      }
    },
    "Text substitution rules saved." : {
      "comment" : "Announcement after a retry saved the text substitution rules that had failed to save.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reglas de sustitución de texto guardadas."
          }
        }
      }
    },
    "Text to find in every book" : {
      "comment" : "Placeholder of the empty search field in the Search Library window.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texto que buscar en cada libro"
          }
        }
      }
    },
    "Text updated" : {
      "comment" : "Announcement after the user saved an edited text and TextMouth took it as the book's text. Written without its full stop.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texto actualizado"
          }
        }
      }
    },
    "Text updated." : {
      "comment" : "Announcement after the user saved an edited text of a feed episode's transcript, followed by a note about where the transcript stays.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texto actualizado."
          }
        }
      }
    },
    "TextMouth Is Open on Another Mac" : {
      "comment" : "Title of the warning shown when another Mac has this library open too.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth está abierto en otra Mac"
          }
        }
      }
    },
    "TextMouth Quit to Protect Your Mac" : {
      "comment" : "Title of the alert at launch telling that TextMouth quit at its last run because its memory grew too large while a book played.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth se cerró para proteger tu Mac"
          }
        }
      }
    },
    "TextMouth Subscriptions" : {
      "comment" : "The title written into an exported OPML file of subscriptions. Title case.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Suscripciones de TextMouth"
          }
        }
      }
    },
    "TextMouth attaches WebVTT (.vtt) and SubRip (.srt) files." : {
      "comment" : "Alert explaining why a chosen file was not attached as a transcript. WebVTT and SubRip are subtitle file formats, and .vtt and .srt their file extensions.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth adjunta archivos WebVTT (.vtt) y SubRip (.srt)."
          }
        }
      }
    },
    "TextMouth can't convert %@ files because its converter is missing from the app." : {
      "comment" : "Why a file was not imported: the converter TextMouth carries is missing from the app, which only a damaged copy is. %@ is the name of the file's format, such as WMA or Matroska. Advice to install the app again follows.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede convertir archivos %@ porque falta su conversor en la app."
          }
        }
      }
    },
    "TextMouth can't convert the sound of “%@”: it is in a kind of audio it does not read." : {
      "comment" : "Why a file was not imported: its sound is in a codec TextMouth does not decode. %@ is the file's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede convertir el sonido de “%@”: está en un tipo de audio que no lee."
          }
        }
      }
    },
    "TextMouth can't convert “%@”: its sound changes rate or channels partway through, by more than it can follow." : {
      "comment" : "Why a file was not imported: its sound changes its sample rate or its number of channels partway through, by more than the converter can follow. %@ is the file's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede convertir “%@”: su sonido cambia de frecuencia o de canales a mitad del archivo, más de lo que puede seguir."
          }
        }
      }
    },
    "TextMouth can't convert “%@”: part of its sound is in one piece too large to decode." : {
      "comment" : "Why a file was not imported: one frame of its sound holds more samples than TextMouth decodes at once. %@ is the file's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede convertir “%@”: una parte de su sonido está en un fragmento demasiado grande para decodificarse."
          }
        }
      }
    },
    "TextMouth can't play this kind of file (%@)." : {
      "comment" : "Why a feed's episode could not be downloaded: the file is of a kind TextMouth does not play. %@ is the file's type or extension, such as audio/x-flac.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede reproducir este tipo de archivo (%@)."
          }
        }
      }
    },
    "TextMouth can't read the audio file %@ because %@." : {
      "comment" : "Why an audio file could not be converted at import: it is of a format TextMouth reads, in a form it refuses. %1$@ is the file's name and %2$@ the reason, a clause in English that follows \"because\" and has no full stop.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TextMouth can't read the audio file %1$@ because %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede leer el archivo de audio %1$@ porque %2$@."
          }
        }
      }
    },
    "TextMouth can't read the folder %@: %@." : {
      "comment" : "Why the chosen folder can't be used: it can't be read. %1$@ is the folder's path; %2$@ is the reason in a few words, such as \"permission denied\", with no full stop.\nWhy the library can't be used: its folder can't be read. %1$@ is the folder's path; %2$@ is the reason in a few words, such as \"permission denied\", with no full stop.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TextMouth can't read the folder %1$@: %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede leer la carpeta %1$@: %2$@."
          }
        }
      }
    },
    "TextMouth can't read this kind of picture (%@). Save it as a PNG or JPEG, then import that copy." : {
      "comment" : "Why a picture was refused at import: a kind of picture the system knows but TextMouth does not decode. %@ is the system's description of the kind, such as \"DNG image\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede leer este tipo de imagen (%@). Guárdala como PNG o JPEG y luego importa esa copia."
          }
        }
      }
    },
    "TextMouth can't read “%@” as %@. It may be damaged, or named for another format." : {
      "comment" : "Why a file was not imported: its bytes are not of the format its name says, or are damaged. %1$@ is the file's name and %2$@ the name of the format its name says, such as WMA or AVI video.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TextMouth can't read “%1$@” as %2$@. It may be damaged, or named for another format."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede leer “%1$@” como %2$@. Puede estar dañado o tener el nombre de otro formato."
          }
        }
      }
    },
    "TextMouth can't safely read the file “%@” in this book, because it defines entities of its own." : {
      "comment" : "First sentence of why a file inside an EPUB or DAISY book was refused: it defines XML entities of its own, which could make it far larger when read. %@ is the file's path inside the book.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede leer de forma segura el archivo “%@” de este libro, porque define entidades propias."
          }
        }
      }
    },
    "TextMouth can't safely read the file “%@” in this book, because it is written in the %@ encoding." : {
      "comment" : "First sentence of why a file inside an EPUB or DAISY book was refused: it is in a text encoding TextMouth cannot see through. %1$@ is the file's path inside the book and %2$@ the encoding's name as the file declares it.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TextMouth can't safely read the file “%1$@” in this book, because it is written in the %2$@ encoding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede leer de forma segura el archivo “%1$@” de este libro, porque está escrito en la codificación %2$@."
          }
        }
      }
    },
    "TextMouth can't safely read the file “%@” in this document, because it defines entities of its own." : {
      "comment" : "First sentence of why a file inside a Word or OpenDocument document was refused: it defines XML entities of its own, which could make it far larger when read. %@ is the file's path inside the document.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede leer de forma segura el archivo “%@” de este documento, porque define entidades propias."
          }
        }
      }
    },
    "TextMouth can't safely read the file “%@” in this document, because it is written in the %@ encoding." : {
      "comment" : "First sentence of why a file inside a Word or OpenDocument document was refused: it is in a text encoding TextMouth cannot see through. %1$@ is the file's path inside the document and %2$@ the encoding's name as the file declares it.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
