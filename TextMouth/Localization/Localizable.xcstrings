        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "C’est après la fin de l’audio, à %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "È dopo la fine dell’audio, a %@."
          }
