          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reimpacchetta le pagine dei fumetti RAR come fumetti CBZ, poi importali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
