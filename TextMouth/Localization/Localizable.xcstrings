            "value" : "La biblioteca de tu Mac no se toca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La bibliothèque de votre Mac n’est pas touchée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La libreria del tuo Mac non viene toccata."
