    "bookTextEdit.transcriptStale" : {
      "comment" : "Sentence after the reason that an audiobook's transcript no longer fits its audio: what to do.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فرّغه مرة أخرى، ثم حرّر النسخة النصية الجديدة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আবার ট্রান্সক্রাইব করুন, তারপর নতুন ট্রান্সক্রিপ্ট সম্পাদনা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transkribiere es erneut und bearbeite dann das neue Transkript."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcribe it again, then edit the new transcript."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transcríbelo de nuevo y luego edita la transcripción nueva."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آن را دوباره رونویسی کنید، سپس رونوشت جدید را ویرایش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transcrivez-le à nouveau, puis modifiez la nouvelle transcription."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "תמלל אותו שוב, ואז ערוך את התמליל החדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "उसे फिर से ट्रांसक्राइब करें, फिर नई ट्रांसक्रिप्ट संपादित करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transkripsikan lagi, lalu edit transkrip yang baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trascrivilo di nuovo, poi modifica la nuova trascrizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "もう一度文字起こししてから、新しい文字起こしを編集してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "대본을 다시 만든 다음 새 대본을 편집하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transcribeer het opnieuw en wijzig dan de nieuwe transcriptie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transkrybuj ją ponownie, a następnie edytuj nową transkrypcję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transcreva-o novamente e edite a nova transcrição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Расшифруйте её заново, затем измените новую расшифровку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transkribera den igen och redigera sedan den nya transkriptionen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ถอดเสียงอีกครั้ง แล้วแก้ไขข้อความถอดเสียงใหม่"
