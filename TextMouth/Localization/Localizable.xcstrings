    "bookExport.panelMessage" : {
      "comment" : "The message of the folder chooser that the Export dialog opens. \"New Folder\" is the chooser's own button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اختر المجلد الذي تريد التصدير إليه. ينشئ “مجلد جديد” مجلدًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "রপ্তানির ফোল্ডারটি বেছে নিন। “নতুন ফোল্ডার” একটি তৈরি করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wähle den Ordner für den Export. „Neuer Ordner“ erstellt einen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the folder to export to. New Folder makes one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige la carpeta a la que exportar. Nueva carpeta crea una."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
