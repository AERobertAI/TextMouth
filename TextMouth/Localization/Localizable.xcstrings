        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "У тексті книги є зміни, які TextMouth не зміг скопіювати, тому залишає текст як є."
          }
        },
        "ur" : {
          "stringUnit" : {
