          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Agregar marcador"
          }
        }
      }
    },
    "Add Preset" : {
      "comment" : "Button in the filter presets sheet that adds a new filter preset."
    },
    "Added %@" : {
      "comment" : "Said as a filter preset is added. %@ is the preset's name."
