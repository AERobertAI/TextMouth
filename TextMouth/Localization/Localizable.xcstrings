          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth %1$@ को बंद हो गया: पुस्तक चलते समय macOS के ऑडियो में खराबी के कारण उसकी मेमोरी %2$@ GB तक बढ़ गई। आपकी जगह सहेज ली गई थी।"
          }
        },
        "id" : {
          "stringUnit" : {
