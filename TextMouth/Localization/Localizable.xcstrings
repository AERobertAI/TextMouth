          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth li sposta di nuovo quando lo spostamento della sua cartella dei dati termina."
          }
        }
      }
    },
    "TextMouth needs the drive “%@” connected to open the library." : {
      "comment" : "What using a library on another drive means. %@ is the drive's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
