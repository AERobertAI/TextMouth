            "state" : "machine_translated",
            "value" : "Il convertitore di TextMouth ha restituito dell’audio di «%@» che TextMouth non ha potuto leggere."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O conversor do TextMouth devolveu áudio de “%@” que o TextMouth não conseguiu ler."
          }
        }
      }
    },
    "TextMouth's converter stopped before the end of “%@”, so it could not be imported." : {
      "comment" : "Why a file was not imported: TextMouth's converter ended before the end of its sound, with no error. %@ is the file's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Umwandlungsprogramm von TextMouth hat vor dem Ende von „%@“ gestoppt, daher konnte die Datei nicht importiert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El conversor de TextMouth se detuvo antes del final de “%@”, así que no se pudo importar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le convertisseur de TextMouth s’est arrêté avant la fin de « %@ », donc il n’a pas pu être importé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il convertitore di TextMouth si è fermato prima della fine di «%@», quindi non è stato possibile importarlo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O conversor do TextMouth parou antes do fim de “%@”, então ele não pôde ser importado."
          }
        }
      }
    },
    "TextMouth's converter stopped unexpectedly while reading “%@”. The file may be damaged." : {
      "comment" : "Why a file was not imported: TextMouth's converter stopped unexpectedly while reading it, as a damaged file can make it do. %@ is the file's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Umwandlungsprogramm von TextMouth ist beim Lesen von „%@“ unerwartet gestoppt. Die Datei ist möglicherweise beschädigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El conversor de TextMouth se detuvo inesperadamente al leer “%@”. Puede que el archivo esté dañado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le convertisseur de TextMouth s’est arrêté de façon inattendue pendant la lecture de « %@ ». Le fichier est peut-être endommagé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il convertitore di TextMouth si è fermato inaspettatamente durante la lettura di «%@». Il file potrebbe essere danneggiato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O conversor do TextMouth parou inesperadamente ao ler “%@”. O arquivo pode estar danificado."
          }
        }
      }
    },
    "TextMouth's own filters don't include “%@”. They are %@; with ffmpeg installed, every filter it has works." : {
      "comment" : "Problem said of a filter TextMouth doesn't run itself. %1$@ is the filter's name as typed, and %2$@ the list of the filters TextMouth does run, such as \"a, b, and c\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die eigenen Filter von TextMouth enthalten „%1$@“ nicht. Sie sind %2$@; mit installiertem ffmpeg funktioniert jeder Filter, den es hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TextMouth's own filters don't include “%1$@”. They are %2$@; with ffmpeg installed, every filter it has works."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los filtros propios de TextMouth no incluyen “%1$@”. Son %2$@; con ffmpeg instalado, funciona cualquier filtro que tenga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les filtres propres à TextMouth n’incluent pas « %1$@ ». Ce sont %2$@ ; avec ffmpeg installé, tous ses filtres fonctionnent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I filtri propri di TextMouth non includono “%1$@”. Sono %2$@; con ffmpeg installato funzionano tutti i suoi filtri."
