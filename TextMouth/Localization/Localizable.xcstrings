          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Текст книги, озвученный её голосом в один аудиофайл, с главой для каждого заголовка."
          }
        }
      }
    },
    "The book's transcript couldn't be read, so it wasn't exported." : {
      "comment" : "Error in an export's summary: the audiobook's transcript could not be read, so no captions file was written.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript des Buchs konnte nicht gelesen werden, daher wurde es nicht exportiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
