          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replacing keeps the existing copy's reading position, bookmarks, settings, folder, and place on the reading list, and its transcript when the audio is the same."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Al reemplazar, se conservan la posición de lectura, los marcadores, los ajustes, la carpeta y el lugar en la lista de lectura de la copia existente, y su transcripción cuando el audio es el mismo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جایگزینی موقعیت مطالعه، نشانک‌ها، تنظیمات، پوشه و جایگاه نسخه‌ی موجود در فهرست مطالعه را نگه می‌دارد و اگر صدا یکسان باشد، رونوشت آن را هم نگه می‌دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le remplacement conserve la position de lecture, les signets, les réglages, le dossier et la place dans la liste de lecture de la copie existante, ainsi que sa transcription lorsque l’audio est le même."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ההחלפה שומרת את מיקום הקריאה, הסימניות, ההגדרות, התיקייה והמקום ברשימת הקריאה של העותק הקיים, ואת התמליל שלו כשהשמע זהה."
          }
        },
