          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "وقتی گوش دادن به قسمتی دیگر ادامه می‌یابد اعمال می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "S’applique quand la lecture passe à un autre épisode."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "חל כשההאזנה ממשיכה לאפיזודה אחרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "तब लागू होता है जब सुनना किसी दूसरे एपिसोड पर आगे बढ़ता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Berlaku saat pemutaran dilanjutkan ke episode lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vale quando l’ascolto prosegue con un altro episodio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "続けて別のエピソードを聴くときに適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "다른 에피소드로 이어서 들을 때 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Geldt wanneer het luisteren doorgaat naar een andere aflevering."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Działa, gdy słuchanie przechodzi do kolejnego odcinka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vale quando a reprodução continua em outro episódio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Действует при переходе к другому выпуску."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gäller när lyssningen fortsätter till ett annat avsnitt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "มีผลเมื่อการฟังไปต่อที่ตอนอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dinleme başka bir podcast bölümüne geçtiğinde uygulanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Діє, коли прослуховування переходить до іншого епізоду."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس وقت لاگو ہوتا ہے جب پلے بیک کسی دوسرے ایپی سوڈ پر جاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Áp dụng khi việc nghe tiếp tục sang tập khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "适用于继续收听下一单集时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "當聆聽接續到另一集時適用。"
          }
        }
      }
    },
