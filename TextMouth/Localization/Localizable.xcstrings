    "miscellaneousSettings.timeWindowExplanation" : {
      "comment" : "Explanation under the restart gesture's time window slider in the Miscellaneous settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أقصى وقت قد يستغرقه التسلسل كله. الإطارات الزمنية الأقصر تعني مطابقات عرضية أقل لكن ضغطات أسرع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পুরো ক্রমটি সর্বোচ্চ যতটা সময় নিতে পারে। ছোট সময়সীমায় দুর্ঘটনাবশত মিল কম হয়, তবে প্রেস দ্রুত করতে হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die längste Zeit, die die gesamte Folge dauern darf. Kürzere Zeitfenster bedeuten weniger versehentliche Treffer, aber schnelleres Drücken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The most time the whole sequence may take. Shorter windows mean fewer accidental matches but quicker presses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El tiempo máximo que puede durar toda la secuencia. Con una ventana más corta hay menos coincidencias accidentales, pero hay que pulsar más rápido."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بیشترین زمانی که کل دنباله ممکن است بگیرد. بازه‌های کوتاه‌تر یعنی تطابق تصادفی کمتر، اما فشردن سریع‌تر."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le temps maximal que la séquence entière peut prendre. Des fenêtres plus courtes donnent moins de correspondances accidentelles, mais exigent des appuis plus rapides."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הזמן המרבי שהרצף כולו יכול להימשך. חלונות קצרים יותר פירושם פחות התאמות מקריות אך לחיצות מהירות יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पूरे क्रम में अधिकतम जितना समय लग सकता है। छोटी समय सीमा से गलती से मिलान कम होते हैं, पर प्रेस जल्दी करने पड़ते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Waktu terlama yang boleh dipakai seluruh urutan. Jangka waktu yang lebih pendek berarti lebih sedikit kecocokan tidak sengaja, tetapi penekanan harus lebih cepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il tempo massimo che l’intera sequenza può richiedere. Intervalli più brevi significano meno corrispondenze accidentali ma pressioni più rapide."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "一連の操作全体にかけられる最長の時間です。短くすると誤って一致することが減りますが、素早く押す必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "전체 순서에 걸릴 수 있는 최대 시간입니다. 시간 범위가 짧을수록 우연한 일치는 줄지만 더 빠르게 눌러야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De maximale tijd die de hele reeks mag duren. Kortere vensters geven minder toevallige overeenkomsten, maar vragen snellere toetsaanslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Najdłuższy czas, jaki może zająć cała sekwencja. Krótsze okna oznaczają mniej przypadkowych dopasowań, ale szybsze naciśnięcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O tempo máximo que a sequência inteira pode levar. Janelas menores significam menos correspondências acidentais, mas pressionamentos mais rápidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Наибольшее время, которое может занять вся последовательность. Меньшее окно даёт меньше случайных совпадений, но требует более быстрых нажатий."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Den längsta tid hela sekvensen får ta. Kortare fönster ger färre oavsiktliga träffar men kräver snabbare tryckningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เวลามากที่สุดที่ทั้งลำดับใช้ได้ ช่วงเวลาที่สั้นกว่าทำให้ตรงโดยไม่ตั้งใจน้อยลง แต่ต้องกดเร็วขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tüm dizinin sürebileceği en uzun süre. Daha kısa aralıklar daha az yanlışlıkla eşleşme ama daha hızlı basış demektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Найбільший час, який може тривати вся послідовність. Коротші проміжки дають менше випадкових збігів, але вимагають швидших натискань."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پوری ترتیب میں لگنے والا زیادہ سے زیادہ وقت۔ چھوٹی حدوں سے غیر ارادی مماثلتیں کم ہوتی ہیں، لیکن بٹن زیادہ تیزی سے دبانے پڑتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thời gian tối đa cho cả chuỗi. Khoảng thời gian ngắn hơn nghĩa là ít khớp nhầm hơn nhưng phải nhấn nhanh hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "整个序列允许花费的最长时间。时间窗口越短，误触发越少，但需要按得越快。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "整個序列可花費的最長時間。較短的範圍表示較少意外符合，但需要更快地按下。"
          }
        }
      }
    },
