    "feed.importFoundUnsubscribed" : {
      "comment" : "What the Import OPML sheet says of several feeds the file lists that are in the library already, unsubscribed. The first %@ is a list of their titles; the second is the name of the Resubscribe command; the third is the name of the Feed Info sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ موجودة في مكتبتك لكن اشتراكها ملغى. اختر %2$@ في صف الموجز، أو في %3$@، لفحصها مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ আপনার লাইব্রেরিতে আছে, সাবস্ক্রিপশন বাতিল করা অবস্থায়। আবার চেক করতে ফিডের সারিতে বা এর %3$@-এ %2$@ বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ sind in deiner Bibliothek, aber abbestellt. Wähle %2$@ in der Zeile des jeweiligen Feeds oder unter %3$@, um sie erneut zu prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ are in your library, unsubscribed. Choose %@ on a feed's row, or in its %@, to check it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ya están en tu biblioteca, sin suscripción. Elige %2$@ en la fila de un canal, o en su %3$@, para volver a revisarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ در کتابخانه‌ی شما هستند، اما اشتراکشان لغو شده است. برای بررسی دوباره، %2$@ را در ردیف فید یا در %3$@ انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ figurent dans votre bibliothèque, mais sans abonnement. Choisissez %2$@ sur la ligne d’un flux, ou dans %3$@, pour les vérifier de nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ נמצאים בספרייה שלך, ללא הרשמה. כדי לבדוק ערוץ שוב, בחר “%2$@” בשורה שלו או ב“%3$@” שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ आपकी लाइब्रेरी में हैं, लेकिन उनकी सदस्यता रद्द है। उन्हें फिर से जाँचने के लिए फ़ीड की पंक्ति पर, या उसके %3$@ में, “%2$@” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ada di pustaka Anda, tetapi tidak lagi dilanggan. Pilih %2$@ pada baris feed, atau di %3$@, untuk memeriksanya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ sono nella tua libreria, ma l’iscrizione è annullata. Scegli %2$@ nella riga di un feed, o nel foglio %3$@, per riprendere a controllarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@は購読解除の状態でライブラリにあります。もう一度確認するには、フィードの行で、またはその%3$@で、%2$@を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@은(는) 보관함에 구독 해제된 상태로 있습니다. 다시 확인하려면 피드의 행 또는 %3$@에서 %2$@을(를) 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ staan in je bibliotheek, zonder abonnement. Kies %2$@ in de rij van een feed, of in de bijbehorende %3$@, om die feed opnieuw te controleren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ są w Twojej bibliotece, bez subskrypcji. Aby sprawdzić je ponownie, wybierz %2$@ w wierszu kanału lub w oknie %3$@."
          }
        },
