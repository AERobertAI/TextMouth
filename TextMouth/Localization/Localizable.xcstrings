            "value" : "TextMouth “%@” को फिर से नहीं पढ़ सका, इसलिए उसने पुस्तक जैसी थी वैसी ही छोड़ दी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
