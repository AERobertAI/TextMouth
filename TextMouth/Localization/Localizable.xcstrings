          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Agrega botones de velocidad y la velocidad actual"
          }
        }
      }
    },
    "Adds the lexicon's entries after your rules; entries with only a phonetic spelling are set aside" : {
      "comment" : "VoiceOver hint of the Import Rules button in Settings, Text, Substitutions: what is added and what is left out.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
