    "interfaceTextFile.editTitle" : {
      "comment" : "A button in Settings under Interface Language, on the Mac. It opens the file of the person's own interface lines in their editor, after filling it with the current text if it has none for this language.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
