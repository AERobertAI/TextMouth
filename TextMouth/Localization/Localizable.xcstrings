            "state" : "translated",
            "value" : "%@ couldn't send the feed (error %@). Try again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ no pudo enviar el canal (error %2$@). Inténtalo de nuevo más tarde."
