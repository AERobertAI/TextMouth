    "transcriptCleanup.applyHint" : {
      "comment" : "VoiceOver hint of the Apply button of the Clean Up Transcript sheet. Undo Cleanup is the name of a button of the sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يجري هذه التصحيحات. تبقى النسخة النصية السابقة محفوظة، لذا يمكن للأمر “تراجع عن التنظيف” إعادتها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই সংশোধনগুলো করে। আগের ট্রান্সক্রিপ্ট রাখা থাকে, তাই “পরিষ্কার করা পূর্বাবস্থায় ফেরান” দিয়ে তা ফিরিয়ে আনা যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nimmt diese Korrekturen vor. Das bisherige Transkript bleibt erhalten, sodass „Bereinigung widerrufen“ es wiederherstellen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makes these corrections. The transcript from before is kept, so Undo Cleanup can put it back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hace estas correcciones. Se conserva la transcripción anterior, así que Deshacer limpieza puede restaurarla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "این اصلاحات را انجام می‌دهد. رونوشت قبلی نگه داشته می‌شود، پس «واگرد پاک‌سازی» می‌تواند آن را برگرداند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Effectue ces corrections. La transcription précédente est conservée, donc Annuler le nettoyage peut la rétablir."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מבצע את התיקונים האלה. התמליל מלפני כן נשמר, כך ש“בטל ניקוי” יכול להחזיר אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ये सुधार करता है। पहले की ट्रांसक्रिप्ट रखी जाती है, ताकि “सफ़ाई पूर्ववत करें” उसे वापस ला सके।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuat koreksi ini. Transkrip sebelumnya disimpan, sehingga Urungkan Perapian dapat mengembalikannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Applica queste correzioni. La trascrizione precedente viene conservata, così il comando Annulla pulizia può ripristinarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "これらの修正を行います。元の文字起こしは保持されるので、「整理を取り消す」で復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 수정 사항을 적용합니다. 이전 대본은 보관되므로 정리 실행 취소로 되돌릴 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voert deze correcties door. De transcriptie van voorheen blijft bewaard, zodat Maak opschoning ongedaan die kan terugzetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wprowadza te poprawki. Poprzednia transkrypcja zostaje zachowana, więc Cofnij oczyszczanie może ją przywrócić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Faz estas correções. A transcrição anterior é mantida, então Desfazer limpeza pode restaurá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вносит эти исправления. Прежняя расшифровка сохраняется, поэтому «Отменить исправление» может её вернуть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gör de här rättelserna. Den tidigare transkriptionen sparas, så Ångra uppstädning kan återställa den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ทำการแก้ไขเหล่านี้ ข้อความถอดเสียงเดิมยังเก็บไว้ คำสั่ง เลิกทำการตรวจแก้ จึงนำกลับคืนได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu düzeltmeleri yapar. Önceki transkript saklanır, böylece Temizlemeyi Geri Al onu geri getirebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вносить ці виправлення. Попередню транскрипцію збережено, тож «Відмінити очищення» поверне її."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یہ اصلاحات کرتا ہے۔ پہلے کا ٹرانسکرپٹ رکھا جاتا ہے، تاکہ “صفائی کالعدم کریں” اسے واپس لا سکے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thực hiện các hiệu chỉnh này. Bản chép lời trước đó được giữ lại, nên Hoàn tác dọn dẹp có thể khôi phục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "进行这些修正。保留之前的文字稿，因此“撤销整理”可将其恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "進行這些修正。先前的逐字稿會保留，因此可用「還原清理」恢復。"
          }
        }
      }
    },
