    },
    "Recording. Stop or discard it with Clear Selection, then close." : {
      "comment" : "Said when the audio editor's window can't close because a punch-in records. \"Clear Selection\" is the name of a command.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aufnahme läuft. Stoppe oder verwirf sie mit „Auswahl aufheben“ und schließe dann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Grabando. Detén la grabación o descártala con Quitar selección y luego cierra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Enregistrement en cours. Arrêtez-le ou abandonnez-le avec Désélectionner, puis fermez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Registrazione in corso. Interrompila o scartala con Deseleziona, poi chiudi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gravando. Pare ou descarte com Desmarcar seleção e depois feche."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Идёт запись. Остановите её или отбросьте командой «Снять выделение», затем закройте окно."
          }
        }
      }
    },
    "Recording. Stop the recording first." : {
      "comment" : "Said when an audio editor command other than the punch-in's own is chosen while a punch-in records.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aufnahme läuft. Stoppe zuerst die Aufnahme."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Grabando. Detén primero la grabación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Enregistrement en cours. Arrêtez d’abord l’enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Registrazione in corso. Interrompi prima la registrazione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gravando. Pare a gravação primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Идёт запись. Сначала остановите запись."
          }
        }
      }
    },
    "Records a new shortcut." : {
      "comment" : "VoiceOver hint of a keyboard shortcut's key button, and of the add shortcut button, in Settings: the next key pressed becomes the shortcut.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
