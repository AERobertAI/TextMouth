            "value" : "पिछली सफ़ाई से पहले की ट्रांसक्रिप्ट वापस लाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mengembalikan transkrip seperti sebelum perapian terakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ripristina la trascrizione com’era prima dell’ultima pulizia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "最後の整理の前の文字起こしに戻します。"
