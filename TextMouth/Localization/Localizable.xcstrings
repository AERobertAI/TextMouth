    "bookManifestEdit.sectionsGiven.audiobook" : {
      "comment" : "Second sentence of the reason an edited manifest.json was refused for having segments: the user should remove the segments.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أزلها، فالكتاب الصوتي المكوَّن من مقاطع يُرتَّب بالمقاطع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সেগুলো সরিয়ে দিন: ট্র্যাকের অডিওবুক ট্র্যাক দিয়েই সাজানো হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Entferne sie: Ein Hörbuch aus Tracks wird mit Tracks angeordnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove them: an audiobook of tracks is arranged with tracks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quítalos: un audiolibro de pistas se organiza con pistas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آن‌ها را بردارید: کتاب صوتی متشکل از تراک با تراک‌ها مرتب می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Retirez-les : un livre audio composé de pistes s’organise par pistes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הסר אותם: ספר שמע המורכב מרצועות מסודר באמצעות רצועות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "उन्हें हटाएँ: ट्रैक वाली ऑडियोबुक ट्रैक के साथ ही व्यवस्थित होती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Buang segmen itu: buku audio berisi trek diatur dengan trek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rimuovile: un audiolibro di tracce si organizza con le tracce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "セグメントを取り除いてください。トラックで構成されるオーディオブックは、トラックで編成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "제거하십시오. 트랙으로 이루어진 오디오북은 트랙으로 구성됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Haal ze weg: een luisterboek met tracks is ingedeeld in tracks."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usuń je: w audiobooku złożonym ze ścieżek układ wyznaczają ścieżki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Remova-os: um audiolivro de faixas é organizado com faixas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Уберите их: аудиокнига из дорожек строится из самих дорожек."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ta bort dem: en ljudbok med spår ordnas med spår."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ให้นำเซกเมนต์ออก เพราะหนังสือเสียงที่แบ่งเป็นแทร็กใช้แทร็กในการจัดเรียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bunları kaldırın: parçalardan oluşan bir sesli kitap parçalarla düzenlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вилучіть їх: аудіокнига з доріжками впорядковується доріжками."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "انہیں ہٹا دیں: ٹریکس والی آڈیو بک ٹریکس سے ترتیب دی جاتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hãy gỡ chúng: sách nói gồm các bản âm thanh được sắp xếp bằng các bản âm thanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "请移除它们：由音轨组成的有声书以音轨来编排。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "請移除它們：由音軌組成的有聲書是以音軌編排的。"
          }
        }
      }
    },
    "bookManifestEdit.sectionsGiven.segments" : {
      "comment" : "First sentence of a reason an edited manifest.json was refused. manifest.json is a file name and stays as written; DAISY is a book format.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحتوي manifest.json على أجزاء، ولا يكتبها TextMouth إلا لكتاب DAISY يحوّله."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "manifest.json-এ সেগমেন্ট আছে, যা TextMouth শুধু রূপান্তরিত DAISY বইয়ের জন্য লেখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "manifest.json enthält Segmente, die TextMouth nur für ein von ihm konvertiertes DAISY-Buch schreibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "manifest.json has segments, which TextMouth writes only for a DAISY book it converts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "manifest.json tiene segmentos, que TextMouth escribe solo para un libro DAISY que convierte."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "manifest.json بخش‌هایی (segments) دارد که TextMouth فقط برای کتاب DAISY تبدیل‌شده می‌نویسد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
