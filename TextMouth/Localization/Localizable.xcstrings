    "bookManifestEdit.explanation.headings" : {
      "comment" : "Second sentence of the Edit Manifest explanation: what the manifest lists and what the user can change in it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يسرد مقاطع الكتاب بترتيب التشغيل، ولكل مقطع عنوان. يمكنك إعادة ترتيبها وتغيير عناوينها وتجميعها تحت عناوين رئيسية من اختيارك، وضبط الوقفات بينها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এটি বইয়ের ট্র্যাকগুলো চালানোর ক্রমে তালিকাভুক্ত করে, প্রতিটির সঙ্গে তার হেডিংয়ের শিরোনাম। আপনি সেগুলো পুনর্বিন্যাস করতে, নতুন নাম দিতে, নিজের হেডিংয়ের অধীনে সাজাতে এবং সেগুলোর মধ্যকার বিরতি ঠিক করতে পারেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es listet die Tracks des Buchs in Wiedergabereihenfolge auf, jeweils mit dem Titel ihrer Überschrift. Du kannst sie neu anordnen, umbenennen und unter eigenen Überschriften gruppieren sowie die Pausen dazwischen festlegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It lists the book's tracks in play order, each with its heading's title. You can reorder, retitle, and group them under headings of your own, and set the pauses between them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Enumera las pistas del libro en orden de reproducción, cada una con el título de su encabezado. Puedes reordenarlas, cambiarles el título, agruparlas bajo encabezados propios y fijar las pausas entre ellas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تراک‌های کتاب را به ترتیب پخش فهرست می‌کند، هر کدام با عنوان سرفصل خود. می‌توانید آن‌ها را جابه‌جا کنید، عنوانشان را تغییر دهید، زیر سرفصل‌های دلخواه گروه‌بندی کنید و وقفه‌های میان آن‌ها را تنظیم کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il liste les pistes du livre dans l’ordre de lecture, chacune avec le titre de son en-tête. Vous pouvez les réordonner, les renommer, les regrouper sous vos propres en-têtes et régler les pauses entre elles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הוא מפרט את רצועות הספר לפי סדר הניגון, כל אחת עם שם הכותרת שלה. ניתן לשנות את הסדר, לשנות שמות, לקבץ אותן תחת כותרות משלך ולקבוע את ההפסקות ביניהן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसमें पुस्तक के ट्रैक चलने के क्रम में सूचीबद्ध होते हैं, हर एक अपनी हेडिंग के शीर्षक के साथ। आप उनका क्रम बदल सकते हैं, उनके शीर्षक बदल सकते हैं, उन्हें अपनी हेडिंग के अंतर्गत समूहित कर सकते हैं, और उनके बीच के विराम तय कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Manifes mencantumkan trek buku sesuai urutan putar, masing-masing dengan judul tajuknya. Anda dapat mengurutkan ulang, mengganti judul, dan mengelompokkannya di bawah tajuk buatan Anda sendiri, serta mengatur jeda di antaranya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elenca le tracce del libro nell’ordine di riproduzione, ciascuna con il titolo della sua intestazione. Puoi riordinarle, cambiarne il titolo, raggrupparle sotto intestazioni tue e impostare le pause tra l’una e l’altra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブックのトラックを再生順に、それぞれの見出しのタイトルとともに一覧にします。並べ替え、タイトルの変更、独自の見出しでのグループ化、トラック間の無音の設定ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책의 트랙을 재생 순서대로 표제의 제목과 함께 나열합니다. 트랙의 순서를 바꾸고, 제목을 바꾸고, 직접 만든 표제 아래로 묶을 수 있으며, 트랙 사이의 정지 구간도 설정할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Het toont de tracks van het boek in afspeelvolgorde, elk met de titel van zijn kop. Je kunt ze opnieuw ordenen, een andere titel geven en groeperen onder je eigen koppen, en de pauzes ertussen instellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wymienia ścieżki książki w kolejności odtwarzania, każdą z tytułem jej nagłówka. Można zmieniać ich kolejność i tytuły, grupować je pod własnymi nagłówkami oraz ustawiać przerwy między nimi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ele lista as faixas do livro na ordem de reprodução, cada uma com o título do seu cabeçalho. Você pode reordená-las, renomeá-las e agrupá-las sob cabeçalhos próprios, além de definir as pausas entre elas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В нём перечислены дорожки книги в порядке воспроизведения, каждая с названием своего заголовка. Вы можете менять порядок дорожек и их названия, группировать их под собственными заголовками и задавать паузы между ними."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Det listar bokens spår i uppspelningsordning, vart och ett med rubrikens titel. Du kan ändra ordning, byta titel och gruppera dem under egna rubriker samt ställa in pauserna mellan dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "แสดงแทร็กของหนังสือตามลำดับการเล่น พร้อมชื่อหัวข้อของแต่ละแทร็ก คุณจัดลำดับใหม่ เปลี่ยนชื่อ จัดกลุ่มภายใต้หัวข้อของคุณเอง และตั้งช่วงหยุดระหว่างแทร็กได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitabın parçalarını çalma sırasıyla, her birini başlığının adıyla listeler. Bunları yeniden sıralayabilir, yeniden adlandırabilir, kendi başlıklarınız altında gruplayabilir ve aralarındaki duraklamaları ayarlayabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Він перелічує доріжки книги в порядку відтворення, кожну із назвою її заголовка. Ви можете змінювати їхній порядок, перейменовувати їх і групувати під власними заголовками, а також задавати паузи між ними."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس میں کتاب کے ٹریکس چلنے کی ترتیب سے درج ہیں، ہر ایک اپنی سرخی کے عنوان کے ساتھ۔ آپ انہیں دوبارہ ترتیب دے سکتے ہیں، ان کے عنوان بدل سکتے ہیں، انہیں اپنی سرخیوں کے تحت گروپ کر سکتے ہیں، اور ان کے درمیان وقفے مقرر کر سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tệp liệt kê các bản âm thanh của sách theo thứ tự phát, mỗi bản kèm tiêu đề đề mục của nó. Bạn có thể sắp xếp lại, đổi tiêu đề, nhóm chúng dưới các đề mục của riêng bạn, và đặt quãng nghỉ giữa chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "清单按播放顺序列出图书的音轨，每条音轨都附有对应章节标题的名称。你可以重新排序、重新命名音轨，把它们归入自己的章节标题下，并设置音轨之间的停顿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "它按播放順序列出書籍的音軌，並附上各自標題的名稱。你可以重新排序、重新命名，並將它們歸入自訂的標題下，也可以設定音軌之間的停頓。"
          }
        }
      }
    },
    "bookManifestEdit.explanation.quotation" : {
      "comment" : "Third sentence of the Edit Manifest explanation. TextEdit is the Mac's text editor; Smart Quotes, Edit and Substitutions are its menu names, so use the words macOS shows for them.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اكتب علامات اقتباس مستقيمة: في TextEdit، أوقف علامات الاقتباس الذكية من تحرير، ثم الاستبدالات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সোজা উদ্ধৃতি চিহ্ন লিখুন: TextEdit-এ Edit, Substitutions-এর অধীনে Smart Quotes বন্ধ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gib gerade Anführungszeichen ein: Deaktiviere in TextEdit unter „Bearbeiten“, „Ersetzungen“ die intelligenten Anführungszeichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type straight quotation marks: in TextEdit, turn off Smart Quotes under Edit, Substitutions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escribe comillas rectas: en TextEdit, desactiva Comillas tipográficas en Edición, Sustituciones."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "از علامت‌های نقل‌قول ساده استفاده کنید: در TextEdit، Smart Quotes را زیر Edit، Substitutions خاموش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saisissez des guillemets droits : dans TextEdit, désactivez les Guillemets intelligents sous Édition, Substitutions."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הקלד מירכאות ישרות: ב-TextEdit, כבה את “מירכאות חכמות” תחת “עריכה”, “החלפות”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सीधे उद्धरण चिह्न टाइप करें: TextEdit के “संपादित करें” मेनू में, “प्रतिस्थापन” के अंतर्गत “स्मार्ट कोटेशन” बंद करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ketik tanda kutip lurus: di TextEdit, matikan Kutipan Cerdas di bawah Edit, Substitusi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Digita virgolette dritte: in TextEdit, disattiva Virgolette smart in Modifica, Sostituzioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "まっすぐな引用符を入力してください。テキストエディットでは、「編集」の「自動置換」で「スマート引用符」をオフにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "직선 따옴표를 입력하십시오. 텍스트 편집기에서는 편집, 대체에서 스마트 인용 부호를 끄십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Typ rechte aanhalingstekens: zet in TextEdit “Slimme aanhalingstekens” uit onder Wijzig, Vervangingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wpisuj proste cudzysłowy: w TextEdit wyłącz Inteligentne cudzysłowy w menu Edycja, Podstawienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Digite aspas retas: no TextEdit, desative Aspas inteligentes em Editar, Substituições."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вводите прямые кавычки: в TextEdit выключите «Смарт-кавычки» в меню «Правка», подменю «Замены»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Skriv raka citattecken: i TextEdit stänger du av ”Smarta citattecken” under ”Redigera”, ”Ersättningar”."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "พิมพ์เครื่องหมายคำพูดแบบตรง: ใน TextEdit ให้ปิด อัญประกาศอัจฉริยะ ใน แก้ไข การเปลี่ยนแทนที่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Düz tırnak işaretleri yazın: TextEdit'te Düzen, Yerine Koymalar altında Akıllı Tırnaklar seçeneğini kapatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вводьте прямі лапки: у Мініредакторі вимкніть «Динамічні лапки» (меню «Редагування», підменю «Підстановки»)."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سیدھے اقتباسی نشان ٹائپ کریں: TextEdit میں Edit، Substitutions کے تحت Smart Quotes آف کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hãy gõ dấu nháy thẳng: trong TextEdit, tắt Trích dẫn thông minh trong menu Sửa, Phương án thay thế."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "请输入直引号：在“文本编辑”中，到“编辑”的“替换”下关闭“智能引号”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "請輸入直引號：在「文字編輯」的「編輯」選單中，於「替代」下關閉「智慧型引號」。"
          }
        }
      }
    },
    "bookManifestEdit.explanation.rearranges" : {
      "comment" : "Fourth sentence of the Edit Manifest explanation: what happens when the user saves the manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عند الحفظ، يتحقق TextMouth من ملف البيان ويعيد ترتيب الكتاب، مع الحفاظ على موضعك في المقطع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সংরক্ষণ করলে TextMouth ম্যানিফেস্ট যাচাই করে বইটি নতুন করে সাজায়, এবং এর ট্র্যাকে আপনার জায়গা ধরে রাখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beim Sichern prüft TextMouth das Manifest und ordnet das Buch neu an, wobei deine Stelle im Track erhalten bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you save, TextMouth checks the manifest and rearranges the book, keeping your place in its track."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Al guardar, TextMouth comprueba el manifiesto y reorganiza el libro, conservando tu lugar en su pista."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هنگام ذخیره، TextMouth مانیفست را بررسی می‌کند و کتاب را دوباره مرتب می‌کند و جای شما را در تراک حفظ می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "À l’enregistrement, TextMouth vérifie le manifeste et réorganise le livre, en conservant votre position dans sa piste."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בעת השמירה, TextMouth בודק את המניפסט ומסדר מחדש את הספר, תוך שמירה על מקומך ברצועה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सहेजने पर TextMouth मैनिफ़ेस्ट की जाँच करता है और पुस्तक को फिर से व्यवस्थित करता है, तथा उसके ट्रैक में आपकी जगह बनाए रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saat Anda menyimpan, TextMouth memeriksa manifes dan menata ulang buku, dengan tetap mempertahankan posisi Anda di trek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quando salvi, TextMouth controlla il manifest e riorganizza il libro, mantenendo la tua posizione nella traccia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "保存すると、TextMouth はマニフェストを確認してブックを再編成し、トラック内の現在位置を維持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "저장하면 TextMouth가 매니페스트를 확인하고 책을 재배열하며, 트랙 안의 현재 위치는 그대로 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bij het bewaren controleert TextMouth het manifest en ordent het boek opnieuw, waarbij je plek in de track behouden blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Po zachowaniu TextMouth sprawdza manifest i porządkuje książkę na nowo, zachowując miejsce na jej ścieżce."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ao salvar, o TextMouth verifica o manifesto e reorganiza o livro, mantendo sua posição na faixa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "При сохранении TextMouth проверяет манифест и перестраивает книгу, сохраняя вашу позицию чтения в дорожке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "När du sparar kontrollerar TextMouth manifestet och ordnar om boken, och behåller din plats i dess spår."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เมื่อคุณบันทึก TextMouth จะตรวจสอบแมนิเฟสต์และจัดเรียงหนังสือใหม่ โดยคงตำแหน่งของคุณในแทร็กไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kaydettiğinizde TextMouth manifesti denetler ve kitabı yeniden düzenler; parçadaki yerinizi korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Коли ви збережете, TextMouth перевірить маніфест і перевпорядкує книгу, зберігши ваше місце в її доріжці."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "محفوظ کرنے پر TextMouth مینی فیسٹ کو جانچتا ہے اور کتاب کو دوبارہ ترتیب دیتا ہے، اور اس کے ٹریک میں آپ کی جگہ برقرار رکھتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Khi bạn lưu, TextMouth kiểm tra tệp kê khai và sắp xếp lại sách, giữ nguyên vị trí của bạn trong bản âm thanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "存储时，TextMouth 会检查清单并重新编排图书，同时保持你在其音轨中的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "儲存時，TextMouth 會檢查資訊清單並重新編排書籍，同時保留你在音軌中的位置。"
          }
        }
      }
    },
    "bookManifestEdit.explanationTitle" : {
      "comment" : "Title of the alert shown the first time Edit Manifest is used. %@ is the book's title.",
