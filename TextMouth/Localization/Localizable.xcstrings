                  "value" : "Stop Keeping %lld Book on This Mac"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Stop Keeping %lld Books on This Mac"
                }
              }
            }
          }
        }
      }
    },
    "Stop Keeping on This Mac" : {
      "comment" : "Library menu command that stops keeping a book's files downloaded on this Mac. Also the name other sentences use for the command."
    },
    "Stop Preview" : {
      "comment" : "Button of the audio editor's Apply Filter sheet that stops the preview."
    },
    "Stop Recording" : {
      "comment" : "Title of the audio editor's Punch In button while it records."
    },
    "Stop Where Am I announcement" : {
      "comment" : "What VoiceOver calls the reader toolbar's Where Am I? button while an announcement speaks; pressing it stops the announcement."
    },
    "Stop and Save" : {
      "comment" : "Title of the question's default button when the Record window is closed while recording: it stops the recording and saves it."
