    "Opens the library in the default location, ~/.TextMouth, or starts a new one there, instead of the library that isn't available." : {
      "comment" : "VoiceOver hint of the Use Default Location button in Storage settings. ~/.TextMouth is the default folder's path and stays as written.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يفتح المكتبة في الموقع الافتراضي، ~/.TextMouth، أو يبدأ مكتبة جديدة هناك، بدلًا من المكتبة غير المتاحة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "যে লাইব্রেরি উপলব্ধ নেই তার বদলে ডিফল্ট অবস্থান ~/.TextMouth-এর লাইব্রেরি খোলে, বা সেখানে নতুন একটি শুরু করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffnet die Bibliothek am Standardort ~/.TextMouth oder legt dort eine neue an, statt der nicht verfügbaren Bibliothek."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre la biblioteca de la ubicación predeterminada, ~/.TextMouth, o crea una nueva allí, en lugar de la biblioteca que no está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ouvre la bibliothèque à l’emplacement par défaut, ~/.TextMouth, ou en crée une nouvelle à cet endroit, à la place de la bibliothèque non disponible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "उपलब्ध न होने वाली लाइब्रेरी की जगह डिफ़ॉल्ट स्थान, ~/.TextMouth, में लाइब्रेरी खोलता है, या वहाँ नई लाइब्रेरी शुरू करता है।"
