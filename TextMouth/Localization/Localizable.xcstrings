        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ٹرانسکرائب ہونے کے بعد کتاب کا آڈیو بدل گیا (%@)، اس لیے ٹرانسکرپٹ اب درست نہیں بیٹھتا۔ دوبارہ ٹرانسکرائب کریں۔"
