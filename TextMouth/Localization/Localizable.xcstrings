    },
    "The book's text as Markdown, with its headings, lists, and emphasis." : {
      "comment" : "The hint of the Convert to picker in the Export dialog while Markdown is chosen, and of the Text as Markdown checkbox.",
      "localizations" : {
        "es" : {
