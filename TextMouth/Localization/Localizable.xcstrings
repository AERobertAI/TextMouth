    "dataDirectoryUnavailability.gettingFromCloud" : {
      "comment" : "Second sentence of why the library can't be used yet: the files are being fetched from the cloud, and the library opens by itself when they arrive. \"Them\" means the library's files named in the sentence before.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحصل TextMouth عليها الآن، وتُفتح المكتبة عند وصولها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth এখন সেগুলো আনছে, আর সেগুলো পৌঁছালে লাইব্রেরি খুলবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ruft sie gerade ab, und die Bibliothek wird geöffnet, sobald sie ankommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth is getting them now, and the library opens when they arrive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth los está obteniendo ahora, y la biblioteca se abre cuando lleguen."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth اکنون آن‌ها را دریافت می‌کند و کتابخانه هنگام رسیدن آن‌ها باز می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth les obtient maintenant, et la bibliothèque s’ouvre quand ils arrivent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth מוריד אותם כעת, והספרייה תיפתח כשיגיעו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth उन्हें अभी प्राप्त कर रहा है, और वे आते ही लाइब्रेरी खुल जाएगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth sedang mengambilnya, dan pustaka terbuka saat semuanya tiba."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth li sta ottenendo ora e la libreria si aprirà quando arriveranno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth はそれらを今取得しています。届くとライブラリが開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 지금 가져오는 중이며, 도착하면 보관함이 열립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth haalt ze nu op en de bibliotheek wordt geopend zodra ze er zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth pobiera je teraz, a biblioteka otworzy się, gdy dotrą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth está obtendo esses arquivos agora, e a biblioteca abre quando eles chegarem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth получает их сейчас, и библиотека откроется, когда они поступят."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth hämtar dem nu, och biblioteket öppnas när de har kommit."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth กำลังรับไฟล์เหล่านั้นอยู่ และจะเปิดไลบรารีเมื่อไฟล์มาถึง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth bunları şimdi alıyor ve kitaplık, dosyalar geldiğinde açılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth отримує їх зараз, і бібліотека відкриється, коли вони надійдуть."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth انہیں اب حاصل کر رہا ہے، اور ان کے پہنچنے پر لائبریری کھل جائے گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth đang lấy chúng, và thư viện sẽ mở khi chúng đến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 正在获取它们，获取完成后资料库会打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 正在取得這些檔案，取得後就會打開書庫。"
          }
        }
      }
    },
    "dataDirectoryUnavailability.identityUnreadable" : {
      "comment" : "Why the library can't be used: the file that names the library can't be read. %@ is the reason, a phrase or sentence from the system or TextMouth.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "المجلد موجود، لكن TextMouth لا يستطيع قراءة ملف هوية مكتبته: %@"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফোল্ডারটি আছে, কিন্তু TextMouth তার লাইব্রেরি পরিচয় ফাইল পড়তে পারছে না: %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Ordner ist da, aber TextMouth kann die Identitätsdatei der Bibliothek nicht lesen: %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The folder is there, but TextMouth can't read its library identity file: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La carpeta está ahí, pero TextMouth no puede leer el archivo de identidad de su biblioteca: %@"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پوشه آنجاست، اما TextMouth نمی‌تواند فایل شناسه‌ی کتابخانه آن را بخواند: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le dossier est là, mais TextMouth ne peut pas lire le fichier d’identité de sa bibliothèque : %@"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "התיקייה קיימת, אך TextMouth לא מצליח לקרוא את קובץ הזהות של הספרייה: %@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ोल्डर मौजूद है, लेकिन TextMouth उसकी लाइब्रेरी पहचान फ़ाइल नहीं पढ़ सकता: %@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Folder-nya ada, tetapi TextMouth tidak dapat membaca file identitas pustakanya: %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La cartella c’è, ma TextMouth non riesce a leggere il file di identità della libreria: %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フォルダはありますが、TextMouth はそのライブラリの ID ファイルを読み取れません：%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "폴더는 있지만 TextMouth가 보관함 식별 파일을 읽을 수 없습니다: %@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De map is er, maar TextMouth kan het identiteitsbestand van de bibliotheek niet lezen: %@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Folder jest na miejscu, ale TextMouth nie może odczytać pliku tożsamości biblioteki: %@"
          }
