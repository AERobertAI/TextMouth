    "The archive expands to %@, but the disk holding the TextMouth library has only %@ free, and TextMouth keeps %@ of it free." : {
      "comment" : "First sentence of why an import's archive was refused for want of disk space. %1$@ is the size the archive expands to; %2$@ is the free space; %3$@ is the space TextMouth keeps free.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Archiv wird auf %1$@ entpackt, aber auf dem Datenträger mit der TextMouth-Bibliothek sind nur %2$@ frei, und TextMouth hält %3$@ davon frei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The archive expands to %1$@, but the disk holding the TextMouth library has only %2$@ free, and TextMouth keeps %3$@ of it free."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo comprimido se expande a %1$@, pero el disco que contiene la biblioteca de TextMouth solo tiene %2$@ libres, y TextMouth mantiene %3$@ libres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’archive se développe à %1$@, mais le disque contenant la bibliothèque TextMouth n’a que %2$@ libres, et TextMouth en garde %3$@ de libre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’archivio si espande a %@, ma il disco che contiene la libreria di TextMouth ha solo %@ liberi, e TextMouth ne mantiene liberi %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo compactado se expande para %1$@, mas o disco que contém a biblioteca do TextMouth tem só %2$@ livres, e o TextMouth mantém %3$@ livres."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Архив распаковывается до %1$@, но на диске с библиотекой TextMouth свободно только %2$@, а TextMouth оставляет свободными %3$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Після розпакування архів займе %1$@, але на диску з бібліотекою TextMouth вільно лише %2$@, а TextMouth залишає вільними %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "该归档展开后为 %1$@，但存放 TextMouth 资料库的磁盘只有 %2$@ 可用空间，而 TextMouth 要保留其中的 %3$@。"
          }
        }
      }
    },
    "The archive expands to %@, more than the %@ TextMouth extracts from archives holding audio or other archives." : {
      "comment" : "Why an import's archive was refused. %1$@ is the size the archive expands to, such as \"2 GB\"; %2$@ is the limit for archives that hold audio or other archives.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Archiv wird auf %1$@ entpackt, mehr als die %2$@, die TextMouth aus Archiven mit Audio oder anderen Archiven extrahiert."
          }
        },
