        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Книга хранится на этом Mac и находится в списке для чтения, который этот Mac держит загруженным, поэтому её загрузку нельзя убрать."
          }
        },
        "uk" : {
          "stringUnit" : {
