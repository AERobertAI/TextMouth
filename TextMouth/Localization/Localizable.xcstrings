            "value" : "El archivo “%1$@” de este libro DAISY hace referencia a “%2$@”, fuera de la carpeta del libro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il file “%@” in questo libro DAISY fa riferimento a “%@”, fuori dalla cartella del libro."
          }
        }
      }
    },
    "The file “%@” in this archive is damaged or incomplete: %@. Get a fresh copy of the archive, then import it again." : {
      "comment" : "Why a ZIP archive or comic book archive (a ZIP of pictures named .cbz) could not be imported: a file inside it is damaged. %1$@ is the file's path inside the archive and %2$@ the reason, a phrase in English that begins with a lowercase letter and has no full stop.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The file “%1$@” in this archive is damaged or incomplete: %2$@. Get a fresh copy of the archive, then import it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
