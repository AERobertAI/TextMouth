          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não é possível abrir livros enquanto a biblioteca não está disponível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Книги нельзя открывать, пока библиотека недоступна."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Böcker kan inte öppnas medan biblioteket inte är tillgängligt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เปิดหนังสือไม่ได้ขณะที่ไลบรารีไม่พร้อมใช้งาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitaplık kullanılamıyorken kitap açılamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Книги не можна відкривати, поки бібліотека недоступна."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لائبریری دستیاب نہ ہونے پر کتابیں کھولی نہیں جا سکتیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không thể mở sách khi thư viện không khả dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "资料库不可用时无法打开图书。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "書庫無法使用時無法打開書籍。"
          }
        }
      }
    },
