    "ffmpegImport.missing.need" : {
      "comment" : "Notice that a book left out several files that only TextMouth's own converter reads, because the converter is missing from the app. %@ is the files' count and names, such as \"2 files, “a.avi” and “b.wmv”\". Advice to install the app again follows.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تجاهل TextMouth %@، وهي تحتاج إلى محوّل TextMouth المفقود من التطبيق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth %@ বাদ দিয়েছে, যেগুলোর জন্য TextMouth-এর কনভার্টার দরকার, যা অ্যাপে নেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth hat %@ ausgelassen, für die das Umwandlungsprogramm von TextMouth nötig ist, das in der App fehlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth left out %@, which need TextMouth's converter, missing from the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth omitió %@, que necesitan el conversor de TextMouth, que falta en la app."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth %@ را که به مبدل TextMouth نیاز دارند و مبدل در برنامه نیست کنار گذاشت."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth a écarté %@, qui nécessitent le convertisseur de TextMouth, absent de l’app."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth השמיט את %@, שדורשים את הממיר של TextMouth, החסר באפליקציה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ने %@ छोड़ दीं, जिन्हें TextMouth का कनवर्टर चाहिए, जो ऐप से गायब है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth melewatkan %@, yang memerlukan konverter TextMouth, yang tidak ada di app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ha escluso %@, che richiedono il convertitore di TextMouth, mancante nell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は、アプリにない TextMouth のコンバータが必要な%@を除外しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "앱에 없는 TextMouth 자체 변환기가 필요한 %@을(를) 제외했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth heeft %@ weggelaten: ze hebben de converter van TextMouth nodig, en die ontbreekt in de app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth pominął: %@. Te pliki wymagają konwertera TextMouth, którego brakuje w aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth deixou de fora %@, que precisam do conversor do TextMouth, ausente do app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth пропустил %@: для них нужен конвертер TextMouth, которого нет в приложении."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth utelämnade %@, som kräver konverteraren i TextMouth, vilken saknas i appen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ข้าม %@ ซึ่งต้องใช้ตัวแปลงของ TextMouth แต่แอปไม่มีตัวแปลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth şunları dışarıda bıraktı: %@. Uygulamada eksik olan TextMouth dönüştürücüsüne ihtiyaç duyuyorlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Пропущено %@: для них потрібен перетворювач TextMouth, якого немає в застосунку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth نے %@ چھوڑ دیے، جنہیں TextMouth کا کنورٹر چاہیے، جو ایپ میں موجود نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth đã bỏ qua %@, những tệp cần bộ chuyển đổi của TextMouth, vốn bị thiếu trong ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 略去了%@，它们需要 TextMouth 的转换器，但 App 中缺少该转换器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 略過了 %@，它們需要 TextMouth 的轉換器，但 App 中缺少。"
          }
        }
      }
    },
