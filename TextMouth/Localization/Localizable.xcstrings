    "readerPage.sayInWhereAmIHint" : {
      "comment" : "Hint and caption of the Playback setting that adds the page to Where Am I?, a command that says where the reader is. \"Page 12 of 300\" is an example of how the page is said.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يضيف الصفحة، مثل الصفحة 12 من 300، إلى ملخصات “أين أنا؟” للكتب التي تضم أكثر من صفحة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "একাধিক পৃষ্ঠার বইয়ের জন্য পৃষ্ঠা, যেমন 300-এর মধ্যে 12, “আমি কোথায়?”-এর সারাংশে যোগ করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fügt die Seite, etwa „Seite 12 von 300“, zu den Zusammenfassungen von „Wo bin ich?“ hinzu, bei Büchern mit mehr als einer Seite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds the page, such as Page 12 of 300, to Where Am I?'s summaries, for books of more than one page."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Agrega la página, como Página 12 de 300, a los resúmenes de ¿Dónde estoy?, en libros de más de una página."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صفحه، مانند «صفحه 12 از 300»، را به خلاصه‌های «کجا هستم؟» اضافه می‌کند، برای کتاب‌هایی با بیش از یک صفحه."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ajoute la page, par exemple « Page 12 sur 300 », aux résumés d’Où suis-je ? pour les livres de plus d’une page."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מוסיף את העמוד, כגון עמוד 12 מתוך 300, לסיכומים של “איפה אני?”, בספרים שיש בהם יותר מעמוד אחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "एक से अधिक पृष्ठ वाली पुस्तकों के लिए, पृष्ठ को, जैसे 300 में से पृष्ठ 12, “मैं कहाँ हूँ?” के सारांश में जोड़ता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menambahkan halaman, seperti Halaman 12 dari 300, ke ringkasan Di mana saya?, untuk buku dengan lebih dari satu halaman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aggiunge la pagina, ad esempio Pagina 12 di 300, ai riepiloghi di Dove sono?, per i libri di più pagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ページが複数あるブックで、「ここはどこ？」の要約に「300ページ中12ページ目」などのページを追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "두 페이지 이상인 책에서 “내 위치는?”의 요약에 페이지(예: 300페이지 중 12페이지)를 추가합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voegt de pagina, zoals Pagina 12 van 300, toe aan de samenvattingen van Waar ben ik?, voor boeken met meer dan één pagina."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dodaje stronę, na przykład Strona 12 z 300, do podsumowań polecenia Gdzie jestem? w książkach składających się z więcej niż jednej strony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Adiciona a página, como Página 12 de 300, aos resumos de Onde estou?, para livros com mais de uma página."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Добавляет страницу, например «Страница 12 из 300», в сводки команды «Где я?» для книг из нескольких страниц."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lägger till sidan, till exempel sidan 12 av 300, i sammanfattningarna från ”Var är jag?” för böcker med mer än en sida."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เพิ่มหน้า เช่น หน้า 12 จาก 300 ลงในสรุปของ ฉันอยู่ที่ไหน สำหรับหนังสือที่มีหลายหน้า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Birden çok sayfası olan kitaplarda, Sayfa 12 / 300 gibi sayfa bilgisini Neredeyim? özetlerine ekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Додає сторінку, наприклад «Сторінка 12 з 300», до підсумків команди «Де я?» для книг більш ніж з однією сторінкою."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اگر کتاب میں ایک سے زیادہ صفحات ہوں تو “میں کہاں ہوں؟” کے خلاصوں میں صفحہ، جیسے 300 میں سے صفحہ 12، شامل کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thêm trang, chẳng hạn Trang 12 trên 300, vào phần tóm tắt của lệnh Tôi đang ở đâu, cho sách có nhiều hơn một trang."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "将页码（如第 12 页，共 300 页）添加到“我在哪里”的摘要中，适用于多页图书。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在「我在哪裡？」的摘要中加入頁碼，例如「第 12 頁，共 300 頁」，適用於超過一頁的書籍。"
          }
        }
      }
    },
    "readerPage.sayInWhereAmITitle" : {
      "comment" : "Label of the Playback setting's checkbox that adds the page to Where Am I?, a command that says where the reader is.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نطق الصفحة في “أين أنا؟”"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“আমি কোথায়?”-এ পৃষ্ঠা বলুন"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Seite bei „Wo bin ich?“ nennen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say the page in Where Am I?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Decir la página en ¿Dónde estoy?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "گفتن صفحه در «کجا هستم؟»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dire la page dans Où suis-je ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אמור את העמוד ב“איפה אני?”"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“मैं कहाँ हूँ?” में पृष्ठ बोलें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ucapkan halaman dalam Di mana saya?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Leggi la pagina in Dove sono?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「ここはどこ？」でページを読み上げる"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“내 위치는?”에서 페이지 말하기"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zeg de pagina bij Waar ben ik?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Podawaj stronę w poleceniu Gdzie jestem?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dizer a página em Onde estou?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Произносить страницу в «Где я?»"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Säg sidan i Var är jag?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "บอกหน้าใน ฉันอยู่ที่ไหน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sayfayı Neredeyim? komutunda söyle"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Озвучувати сторінку в «Де я?»"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“میں کہاں ہوں؟” میں صفحہ بولیں"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đọc trang trong lệnh Tôi đang ở đâu"
          }
        },
        "zh-Hans" : {
