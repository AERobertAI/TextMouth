    },
    "It stays in %@" : {
      "comment" : "Announcement after Remove Download removed one book's files from this Mac: the book is still in the cloud. %@ is the cloud service's name, or \"the cloud\" when it is unknown."
    },
    "It was copied from %@." : {
      "comment" : "Last sentence of the message after the data directory moved: where the copy was made from. %@ is the folder, with the link that leads to it."
    },
    "Items" : {
      "comment" : "Label of the count of a feed's items, episodes and articles, in Feed Info. Title case."
    },
    "Items (%lld of %@ listed)" : {
      "comment" : "The heading of a feed's items when the library lists fewer than the feed has. %lld is how many are listed; %@ is the feed's size, such as \"381\" or \"more than 2000\". Title case.",
