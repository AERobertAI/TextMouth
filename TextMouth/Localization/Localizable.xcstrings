              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "(%lld books not yet opened)"
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "(%lld de libros aún sin abrir)"
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "(%lld libro aún sin abrir)"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "(%lld libros aún sin abrir)"
                }
              }
            }
          }
        }
      }
    },
    "(none)" : {
      "comment" : "The restart gesture's summary when it has no steps, which the editor does not normally allow.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "(ninguno)"
          }
        }
      }
    },
    "(skip)" : {
      "comment" : "Shown in a substitution rule's row where its replacement would be, when the rule skips the matched text.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "(omitir)"
          }
        }
      }
    },
    "0 = %@, 1 = %@ (periods), 2 = %@ (+ commas), 3 = %@ (+ paragraph breaks)" : {
      "comment" : "Explanation under the punctuation pause level slider in the Playback settings. %1$@ to %4$@ are the names of levels 0 to 3, as the slider speaks them: Off, Subtle, Moderate, and Heavy. The words in parentheses say what pauses at that level.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "0 = %1$@, 1 = %2$@ (periods), 2 = %3$@ (+ commas), 3 = %4$@ (+ paragraph breaks)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "0 = %1$@, 1 = %2$@ (puntos), 2 = %3$@ (+ comas), 3 = %4$@ (+ saltos de párrafo)"
          }
        }
      }
    },
    "1 book in this library needs a newer version of TextMouth. It is kept as it is, but not shown." : {
      "comment" : "Storage settings note: one book of the library was added by a newer TextMouth, which this one keeps but can't show.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "1 libro de esta biblioteca necesita una versión más reciente de TextMouth. Se conserva tal como está, pero no se muestra."
          }
        }
      }
    },
    "1 file left" : {
      "comment" : "Part of the download progress value when one file is all that is left and no percentage is known.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Queda 1 archivo"
          }
        }
      }
    },
    "; %@ stay" : {
      "comment" : "A clause that ends the announcement of Unsubscribe: the feed's downloads stay. %@ is the downloads, such as \"its 5 downloaded episodes\". Starts with a semicolon.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "; %@ se quedan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "; %@ restano"
          }
        }
      }
    },
    "; %@ stays" : {
      "comment" : "A clause that ends the announcement of Unsubscribe: the one download the feed kept stays. %@ is the download, such as \"its downloaded episode\". Starts with a semicolon.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "; %@ se queda"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "; %@ resta"
          }
        }
      }
    },
    "A .%@ file is a transcript, not a book. To use it, import its audio, open the book, and choose Attach Transcript… from the Book menu." : {
      "comment" : "Advice after the refusal of a transcript file chosen as a book. %@ is the file's extension without its dot. \"Attach Transcript…\" is a command of the Book menu: keep its name the same as that command's and the menu's.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un archivo .%@ es una transcripción, no un libro. Para usarlo, importa su audio, abre el libro y elige Adjuntar transcripción… en el menú Libro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un file .%@ è una trascrizione, non un libro. Per usarlo, importa il suo audio, apri il libro e scegli Allega trascrizione… dal menu Libro."
          }
        }
      }
    },
    "A Little Faster" : {
      "comment" : "Title of a premade audio filter preset: plays the audio a quarter faster without raising its pitch.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un poco más rápido"
          }
        }
      }
    },
    "A New Window" : {
      "comment" : "A choice of the Open the next book in pop-up button (Settings, Playback; Feed Info; Folder Settings): the next book opens in a window of its own, and this one stays.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una ventana nueva"
          }
        }
      }
    },
    "A book that's only in %@ needs an internet connection to open." : {
      "comment" : "What using a library in a cloud folder means. %@ is the cloud service's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un libro que solo está en %@ necesita conexión a internet para abrirse."
          }
        }
      }
    },
    "A book that's only in the cloud needs an internet connection to open." : {
      "comment" : "Last sentence of what moving the library into a cloud folder means.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un libro que solo está en la nube necesita conexión a internet para abrirse."
          }
        }
      }
    },
    "A built-in view can be hidden, not deleted." : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). Delete…'s hint for a built-in view, when it is dimmed.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una vista integrada se puede ocultar, no eliminar."
          }
        }
      }
    },
    "A chapter marker needs a title." : {
      "comment" : "Problem shown when the title of a chapter marker to insert in the audio editor is blank.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una marca de capítulo necesita un título."
          }
        }
      }
    },
    "A copy was kept in the book's package. Start over with no edits, or cancel." : {
      "comment" : "Explains the question about an unreadable audio edit history: what Start Over and Cancel do.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se conservó una copia en el paquete del libro. Empieza de nuevo sin ediciones, o cancela."
          }
        }
      }
    },
    "A destination folder path is invalid." : {
      "comment" : "Error shown when books or folders cannot be moved because the destination folder's path is not a valid place in the library.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La ruta de la carpeta de destino no es válida."
          }
        }
      }
    },
    "A feed address, such as a link ending in .rss or .xml, or a web page that names its feed." : {
      "comment" : "The line under the address field of the Add Feed sheet. .rss and .xml are file extensions.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una dirección de canal, como un enlace que termina en .rss o .xml, o una página web que indica su canal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un indirizzo di feed, come un link che termina con .rss o .xml, o una pagina web che indica il suo feed."
          }
        }
      }
    },
    "A feed can have its own %@ choice and its own days before deleting played downloads, in its %@." : {
      "comment" : "The note under the Feeds tab's settings. The first %@ is the name of the List and download choice; the second is the name of the Feed Info sheet.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A feed can have its own %1$@ choice and its own days before deleting played downloads, in its %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un canal puede tener su propia opción de %1$@ y sus propios días antes de eliminar las descargas reproducidas, en su %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un feed può avere una propria scelta %1$@ e un proprio numero di giorni prima dell’eliminazione dei download riprodotti, nel foglio %2$@."
          }
        }
      }
    },
    "A filter preset needs a name." : {
      "comment" : "Said when a filter preset is saved with a blank name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un preajuste de filtro necesita un nombre."
          }
        }
      }
    },
    "A folder name can't be empty, \".\" or \"..\", end in \".tmb\", or be reserved by TextMouth." : {
      "comment" : "Error shown when a folder's new name is refused: the name is empty, is a single or double dot, ends in .tmb, or is one TextMouth keeps for itself. The quoted pieces are literal text.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El nombre de una carpeta no puede estar vacío, ser \".\" ni \"..\", terminar en \".tmb\" ni estar reservado por TextMouth."
          }
        }
      }
    },
    "A folder named %@ already exists in %@." : {
      "comment" : "Error shown when a folder's new name or place is taken. %1$@ is the existing folder's name, in straight double quotes. %2$@ is where it is: its folder's location in straight double quotes, or the name of the library's top level.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A folder named %1$@ already exists in %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ya existe una carpeta llamada %1$@ en %2$@."
          }
        }
      }
    },
    "A library in the cloud can take a while: its cloud-only files are downloaded to this Mac to be read." : {
      "comment" : "Sentence of what the Compare Libraries sheet says while it works: a library kept in a cloud drive is slow because files that are only in the cloud are downloaded first.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una biblioteca en la nube puede tardar: sus archivos que solo están en la nube se descargan en esta Mac para leerlos."
          }
        }
      }
    },
    "A limit chooses among books, episodes, and articles, never feeds." : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. Show at Most's hint while the view lists feeds alone, when it is dimmed (finding 6).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un límite elige entre libros, episodios y artículos, nunca canales."
          }
        }
      }
    },
    "A managed package named %@ already exists." : {
      "comment" : "Why a TextMouth package could not be imported: the library already holds a package of that name. %@ is the package's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ya existe un paquete administrado llamado %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esiste già un pacchetto gestito con il nome %@."
          }
        }
      }
    },
    "A move shifts one book at a time, and several are selected. Select one book, then try again." : {
      "comment" : "VoiceOver announcement when Move Book Up or Move Book Down is used with several books selected.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un movimiento desplaza un libro a la vez, y hay varios seleccionados. Selecciona un solo libro e inténtalo de nuevo."
          }
        }
      }
    },
    "A new timer replaces the one running." : {
      "comment" : "Note under the sleep timer sheet's New Timer heading while a timer runs: setting one of the timers below stops it.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un temporizador nuevo reemplaza al que está en curso."
          }
        }
      }
    },
    "A newer TextMouth edited this audio, so this version leaves its edits alone." : {
      "comment" : "Said when the book's saved edit history was written by a later version of TextMouth than this one.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una versión más reciente de TextMouth editó este audio, así que esta versión no modifica sus ediciones."
          }
        }
      }
    },
    "A number from 2 to 99" : {
      "comment" : "VoiceOver hint of the field that sets the length from which a run of one symbol is collapsed, in Settings, Text, Repeated Symbols.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un número del 2 al 99"
          }
        }
      }
    },
    "A quote isn't closed in “%@”." : {
      "comment" : "Problem found in a typed filter chain: a single quote is opened and never closed. %@ is the text of the part holding it.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Falta cerrar unas comillas en “%@”."
          }
        }
      }
    },
    "A run is one symbol repeated, alone or with single spaces, such as * * * * or ====. Speech rewrites runs before the rules above; the screen and braille keep every symbol." : {
      "comment" : "Caption under the controls of Settings, Text, Repeated Symbols that explains what a run is and that only speech changes.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una serie es un símbolo repetido, solo o con espacios sencillos, como * * * * o ====. La voz reescribe las series antes de aplicar las reglas anteriores; la pantalla y el braille conservan todos los símbolos."
          }
        }
      }
    },
    "A stretch of the edits runs past the end of “%@”." : {
      "comment" : "Said when an edit names a stretch of a source audio file that lies past the file's end. %@ is the file's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un tramo de las ediciones llega más allá del final de “%@”."
          }
        }
      }
    },
    "A symbolic link cannot be deleted as a managed book package." : {
      "comment" : "Why a book's files were not deleted: its package is a symbolic link, and deleting it could delete another book. Follows \"Import failed: \".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un enlace simbólico no se puede eliminar como paquete de libro administrado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un collegamento simbolico non può essere eliminato come pacchetto di libro gestito."
          }
        }
      }
    },
    "A transcript is being attached to %@. Transcribe it once that finishes." : {
      "comment" : "Alert shown when Transcribe Audio is chosen for an audiobook that a transcript is being attached to. %@ is the audiobook's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se está adjuntando una transcripción a %@. Transcríbelo cuando termine."
          }
        }
      }
    },
    "A view holds at most %lld conditions." : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. Its hint at the limit, when it is dimmed. Placeholders in order: LibraryViewFilter.conditionLimit.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "A view holds at most %lld condition."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "A view holds at most %lld conditions."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Una vista contiene como máximo %lld de condiciones."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Una vista contiene como máximo %lld condición."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Una vista contiene como máximo %lld condiciones."
                }
              }
            }
          }
        }
      }
    },
    "A view you made has no default to restore." : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). Restore Default…'s hint for a view the listener made, when it is dimmed.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una vista que creaste no tiene un valor predeterminado que restaurar."
          }
        }
      }
    },
    "A view's name can be at most %lld characters." : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. Save's problem with a name too long. Placeholders in order: LibraryViewDefinition.nameLimit.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "A view's name can be at most %lld character."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "A view's name can be at most %lld characters."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "El nombre de una vista puede tener como máximo %lld de caracteres."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "El nombre de una vista puede tener como máximo %lld carácter."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "El nombre de una vista puede tener como máximo %lld caracteres."
                }
              }
            }
          }
        }
      }
    },
    "A web page of the book's text, with a contents list linking each heading." : {
      "comment" : "The hint of the Convert to picker in the Export dialog while HTML is chosen.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una página web con el texto del libro y una lista de contenidos que enlaza cada encabezado."
          }
        }
      }
    },
    "AVI video" : {
      "comment" : "The name of the AVI video format, as people say it. Inside sentences about importing a file of that format.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "video AVI"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "video AVI"
          }
        }
      }
    },
    "Aa" : {
      "comment" : "A small tag in a substitution rule's row: the rule is case sensitive. A capital and a small letter of the language's alphabet.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aa"
          }
        }
      }
