        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "o loudnorm do próprio TextMouth normaliza com um único ganho, então aceita apenas true"
          }
        }
      }
    },
    "TextMouth's own rules are newer, version %@. To use them, delete your copy or copy their rules into it." : {
      "comment" : "Line of the Clean Up Transcript sheet when the rules that come with the app are newer than the user's copy. %@ is the new version number, written without digit grouping.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die eigenen Regeln von TextMouth sind neuer, Version %@. Um sie zu verwenden, lösche deine Kopie oder kopiere ihre Regeln hinein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Las reglas propias de TextMouth son más recientes, versión %@. Para usarlas, elimina tu copia o copia sus reglas en ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les règles propres à TextMouth sont plus récentes, version %@. Pour les utiliser, supprimez votre copie ou copiez-y leurs règles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le regole proprie di TextMouth sono più recenti, versione %@. Per usarle, elimina la tua copia o copia al suo interno le loro regole."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "As regras do próprio TextMouth são mais recentes, versão %@. Para usá-las, exclua sua cópia ou copie as regras delas para ela."
          }
        }
      }
    },
    "TextMouth: no build details recorded" : {
