            "value" : "¿Copiar todos los datos de TextMouth a %@, validarlos y usar la ubicación nueva?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Copier toutes les données de TextMouth vers %@, les valider et utiliser le nouvel emplacement ?"
          }
        },
        "hi" : {
          "stringUnit" : {
