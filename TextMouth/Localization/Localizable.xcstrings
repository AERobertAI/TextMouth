    "recording.rememberedMicrophoneMissing" : {
      "comment" : "Said by the Record window when the microphone used last is not connected as the window opens. %@ is the name of the microphone recordings use instead.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "الميكروفون الذي استخدمه TextMouth آخر مرة غير متصل، لذا تستخدم التسجيلات %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth যে মাইক্রোফোন সবশেষ ব্যবহার করেছিল তা সংযুক্ত নেই, তাই রেকর্ডিং %@ ব্যবহার করবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das zuletzt von TextMouth verwendete Mikrofon ist nicht verbunden, daher verwenden Aufnahmen %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The microphone TextMouth used last isn't connected, so recordings use %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El micrófono que TextMouth usó por última vez no está conectado, así que las grabaciones usan %@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "میکروفونی که TextMouth آخرین بار استفاده کرد وصل نیست، پس ضبط‌ها از %@ استفاده می‌کنند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le microphone que TextMouth a utilisé en dernier n’est pas connecté, donc les enregistrements utilisent %@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "המיקרופון ש-TextMouth השתמש בו לאחרונה אינו מחובר, ולכן ההקלטות ישתמשו ב-%@."
          }
        },
        "hi" : {
          "stringUnit" : {
