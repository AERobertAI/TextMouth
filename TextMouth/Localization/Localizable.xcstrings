    "Page Up" : {
      "comment" : "Name of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Page Up\"."
    },
    "Pages" : {
      "comment" : "Heading of the group in Playback settings that holds the settings about pages."
    },
    "Panels" : {
