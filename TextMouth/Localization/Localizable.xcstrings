    "No original audio is kept for this book, so saved edits can't be undone." : {
      "comment" : "Said when Undo can't reach edits already saved, and the hint of a dimmed Undo in the audio editor: the book keeps no original audio.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Für dieses Buch wird kein Originalaudio aufbewahrt, daher können gesicherte Bearbeitungen nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se conserva audio original de este libro, así que las ediciones guardadas no se pueden deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucun audio original n’est conservé pour ce livre, donc les modifications enregistrées ne peuvent pas être annulées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Per questo libro non viene conservato alcun audio originale, quindi le modifiche salvate non si possono annullare."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nenhum áudio original é mantido para este livro, então as edições salvas não podem ser desfeitas."
          }
        }
      }
    },
    "No original is kept, so it can't be reverted. Undo takes back edits since the last save." : {
      "comment" : "Said by the audio editor's Revert to Original when the book keeps no original audio.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es wird kein Original aufbewahrt, daher kann nicht zurückgesetzt werden. „Widerrufen“ nimmt Bearbeitungen seit dem letzten Sichern zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se conserva ningún original, así que no se puede revertir. Deshacer anula las ediciones desde el último guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucun original n’est conservé, donc le retour à l’original est impossible. Annuler reprend les modifications faites depuis le dernier enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non viene conservato alcun originale, quindi non si può ripristinare. Con Annulla si annullano le modifiche dall’ultimo salvataggio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nenhum original é mantido, então não é possível reverter. Desfazer retoma as edições feitas desde o último salvamento."
          }
        }
      }
    },
    "No original is kept: edits change the audio in place, and saved edits can't be undone." : {
      "comment" : "Explains Storage settings' Original audio choice Don't keep: no original is kept, so saved edits can't be undone.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es wird kein Original aufbewahrt: Bearbeitungen ändern das Audio direkt, und gesicherte Bearbeitungen können nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se conserva ningún original: las ediciones cambian el audio directamente, y las ediciones guardadas no se pueden deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucun original n’est conservé : les modifications changent l’audio sur place, et les modifications enregistrées ne peuvent pas être annulées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non viene conservato alcun originale: le modifiche cambiano direttamente l’audio e quelle salvate non si possono annullare."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nenhum original é mantido: as edições alteram o áudio no próprio arquivo, e as edições salvas não podem ser desfeitas."
          }
        }
      }
    },
