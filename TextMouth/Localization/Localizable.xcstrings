          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Стаття остаточно зникає зі списку, а її завантаження, якщо є, видаляється."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مضمون ہمیشہ کے لیے فہرست سے نکل جاتا ہے، اور اس کا ڈاؤن لوڈ، اگر ہو، حذف کر دیا جاتا ہے۔"
