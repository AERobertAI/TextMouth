    "protection.rememberHint" : {
      "comment" : "Hint of the Remember checkbox: where the password is kept and what it saves.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحفظها في سلسلة مفاتيح هذا الجهاز، فلا يسأل TextMouth عنها مجددًا لهذا الكتاب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এটি এই ডিভাইসের কিচেইনে রাখে, তাই TextMouth এই বইয়ের জন্য আর জিজ্ঞাসা করবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Speichert es im Schlüsselbund dieses Geräts, damit TextMouth bei diesem Buch nicht erneut fragt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps it in this device's Keychain, so TextMouth does not ask again for this book."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La guarda en el llavero de este dispositivo, así que TextMouth no vuelve a pedirla para este libro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آن را در زنجیره کلید این دستگاه نگه می‌دارد تا TextMouth دوباره برای این کتاب نپرسد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La garde dans le trousseau de cet appareil, pour que TextMouth ne la redemande pas pour ce livre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "שומר אותה בצרור המפתחות של המכשיר, כך ש-TextMouth לא ישאל שוב עבור הספר הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसे इस डिवाइस की कीचेन में रखता है, ताकि TextMouth इस पुस्तक के लिए दोबारा न पूछे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menyimpannya di Rantai Kunci perangkat ini, sehingga TextMouth tidak bertanya lagi untuk buku ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La conserva nel portachiavi di questo dispositivo, così TextMouth non la chiede più per questo libro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このデバイスのキーチェーンに保存するので、このブックではTextMouthが再度尋ねません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 기기의 키체인에 보관하므로 이 책에 대해 TextMouth가 다시 묻지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bewaart het in de sleutelhanger van dit apparaat, zodat TextMouth er voor dit boek niet opnieuw om vraagt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zapisuje je w pęku kluczy tego urządzenia, więc TextMouth nie zapyta o nie ponownie dla tej książki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Guarda no chaveiro deste dispositivo, para que o TextMouth não peça de novo neste livro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сохраняет его в связке ключей этого устройства, чтобы TextMouth не спрашивал снова для этой книги."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
