          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Папки больше нет в библиотеке. Возможно, её переместили, переименовали или удалили в другом окне."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mappen finns inte längre i biblioteket. Den kan ha flyttats, bytt namn eller raderats i ett annat fönster."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "โฟลเดอร์ไม่อยู่ในไลบรารีแล้ว อาจถูกย้าย เปลี่ยนชื่อ หรือลบในอีกหน้าต่างหนึ่ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Klasör artık kitaplıkta değil. Başka bir pencerede taşınmış, yeniden adlandırılmış veya silinmiş olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Папки більше немає в бібліотеці. Її могли перемістити, перейменувати або видалити в іншому вікні."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فولڈر اب لائبریری میں نہیں ہے۔ ہو سکتا ہے کسی اور ونڈو میں اسے منتقل یا حذف کیا گیا ہو، یا اس کا نام تبدیل کیا گیا ہو۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thư mục không còn trong thư viện. Có thể nó đã được di chuyển, đổi tên hoặc xóa trong cửa sổ khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "该文件夹已不在资料库中。它可能已在另一个窗口中被移动、重新命名或删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "檔案夾已不在書庫中。它可能已在另一個視窗中被移動、重新命名或刪除。"
          }
        }
      }
    },
