        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El audio del libro cambió desde que se transcribió (%@), así que la transcripción ya no coincide. Vuelve a transcribir."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صدای کتاب از زمان رونویسی تغییر کرده است (%@)، پس رونوشت دیگر مناسب نیست. دوباره رونویسی کنید."
