    "settings.minimumPauseExplanation" : {
      "comment" : "Explanation under the minimum pause stepper in the Playback settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يُرجَّع التشغيل إذا كان الإيقاف المؤقت أقصر من هذه المدة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এর চেয়ে কম সময় বিরতি দিলে পিছিয়ে যাবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nicht zurückspulen, wenn die Pause kürzer als dieser Wert war."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't rewind if paused for less than this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No retroceder si la pausa es menor que esto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اگر مکث کمتر از این مقدار باشد، به عقب برنمی‌گردد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucun retour en arrière si la pause est plus courte que cette durée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אל תחזיר לאחור אם ההשהיה קצרה מזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इससे कम समय के लिए पॉज़ रहने पर पीछे न जाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jangan mundurkan jika dijeda kurang dari ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non riavvolge se la pausa dura meno di questo tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "この時間より短い一時停止では巻き戻しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 시간보다 짧게 일시 정지했다면 되감지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Spoelt niet terug als de pauze korter is dan dit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie przewija do tyłu, jeśli wstrzymanie trwało krócej niż ten czas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não retrocede se a pausa durar menos que isto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не перематывать назад, если пауза короче этого значения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Spola inte tillbaka om pausen är kortare än så."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไม่ย้อนกลับหากหยุดชั่วคราวนานน้อยกว่านี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bundan daha kısa süre duraklatıldıysa geri sarma."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не перемотувати назад, якщо пауза коротша за це значення."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اگر وقفہ اس سے کم ہو تو ری وائنڈ نہ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
