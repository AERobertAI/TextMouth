    },
    "TextMouth is finishing up before it quits: %@. It quits when that is done." : {
      "comment" : "Panel text and announcement while TextMouth finishes work before quitting. %@ is the list of what is under way, such as \"saving the library and keeping downloads\", already joined in the language's own list style.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth está terminando antes de salir: %@. Saldrá cuando termine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth termine son travail avant de se fermer : %@. Il se ferme ensuite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth sta ultimando le operazioni prima di uscire: %@. Uscirà al termine."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth está concluindo antes de sair: %@. Ele sai quando isso terminar."
          }
        }
      }
    },
    "TextMouth is getting them now, and the library opens when they arrive." : {
      "comment" : "Second sentence of why the library can't be used yet: the files are being fetched from the cloud, and the library opens by itself when they arrive. \"Them\" means the library's files named in the sentence before.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ruft sie gerade ab, und die Bibliothek wird geöffnet, sobald sie ankommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth los está obteniendo ahora, y la biblioteca se abre cuando lleguen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth les obtient maintenant, et la bibliothèque s’ouvre quand ils arrivent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth li sta ottenendo ora e la libreria si aprirà quando arriveranno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth está obtendo esses arquivos agora, e a biblioteca abre quando eles chegarem."
          }
        }
      }
    },
    "TextMouth is moving books between folders." : {
      "comment" : "First sentence of why an operation was refused: books are being moved between folders.",
      "localizations" : {
