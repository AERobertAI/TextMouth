        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไม่มีพื้นที่พอบน %1$@ สำหรับดาวน์โหลด %2$@ หนังสือที่มีอยู่แล้วจะยังอยู่"
