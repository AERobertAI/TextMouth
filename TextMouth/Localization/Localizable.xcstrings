    "Brings the text to the sentence being spoken." : {
      "comment" : "Hint of the iPhone reader's book text while the book plays: activating it moves VoiceOver to the sentence being spoken.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Springt im Text zu dem Satz, der gerade gesprochen wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lleva el texto a la frase que se está leyendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Amène VoiceOver à la phrase lue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Porta il testo alla frase in lettura."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Leva o texto até a frase que está sendo falada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Переходит в тексте к произносимому предложению."
          }
        }
      }
    },
    "But %@ also holds %lld books a newer TextMouth added: they are kept where they are, and so is every folder that holds one." : {
      "comment" : "Last sentence of the second confirmation that deletes a folder, when the folder holds books that a newer TextMouth added. %1$@ is the folder's name in quotation marks and %2$lld is how many books, a count.",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Aber %1$@ enthält auch %2$lld Buch, das ein neueres TextMouth hinzugefügt hat: Es bleibt, wo es ist, ebenso jeder Ordner, der es enthält."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Aber %1$@ enthält auch %2$lld Bücher, die ein neueres TextMouth hinzugefügt hat: Sie bleiben, wo sie sind, ebenso jeder Ordner, der eines enthält."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "But %@ also holds %lld book a newer TextMouth added: it is kept where it is, and so is every folder that holds it."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "But %@ also holds %lld books a newer TextMouth added: they are kept where they are, and so is every folder that holds one."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Pero %1$@ también contiene %2$lld de libros que agregó una versión más reciente de TextMouth: se conservan donde están, y también cada carpeta que contiene alguno."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Pero %1$@ también contiene %2$lld libro que agregó una versión más reciente de TextMouth: se conserva donde está, y también cada carpeta que lo contiene."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Pero %1$@ también contiene %2$lld libros que agregó una versión más reciente de TextMouth: se conservan donde están, y también cada carpeta que contiene alguno."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Mais %@ contient aussi %lld de livres ajoutés par une version plus récente de TextMouth : ils sont conservés là où ils sont, comme tout dossier qui en contient un."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Mais %@ contient aussi %lld livre ajouté par une version plus récente de TextMouth : il est conservé là où il est, comme tout dossier qui le contient."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Mais %@ contient aussi %lld livres ajoutés par une version plus récente de TextMouth : ils sont conservés là où ils sont, comme tout dossier qui en contient un."
                }
              }
            }
          }
        },
        "it" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Ma %@ contiene anche %lld di libri aggiunti da una versione più recente di TextMouth: vengono conservati dove si trovano, così come ogni cartella che ne contiene uno."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Ma %@ contiene anche %lld libro aggiunto da una versione più recente di TextMouth: viene conservato dove si trova, così come ogni cartella che ne contiene uno."
                }
