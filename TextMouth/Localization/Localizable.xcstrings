    "feed.unsubscribed.episodes" : {
      "comment" : "What VoiceOver says once Unsubscribe is done, for a feed of episodes. The first %@ is the feed's title; the second is a clause about the downloads that stay, which may be empty.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم إلغاء الاشتراك في %1$@: لم يعد TextMouth يفحص الحلقات الجديدة فيه%2$@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@-এর সাবস্ক্রিপশন বাতিল করা হয়েছে: TextMouth আর নতুন পর্বের জন্য এটি চেক করে না%2$@।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ abbestellt: TextMouth prüft ihn nicht mehr auf neue Folgen%2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unsubscribed from %@: TextMouth no longer checks it for new episodes%@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se canceló la suscripción a %1$@: TextMouth ya no lo revisa en busca de episodios nuevos%2$@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اشتراک %1$@ لغو شد: TextMouth دیگر آن را برای قسمت‌های جدید بررسی نمی‌کند%2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Désabonné de %1$@ : TextMouth n’y recherche plus de nouveaux épisodes%2$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ביטלת את ההרשמה ל-%1$@: TextMouth כבר אינו בודק אם יש בו אפיזודות חדשות%2$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ की सदस्यता रद्द की गई: TextMouth अब उसमें नए एपिसोड नहीं जाँचता%2$@।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Berhenti berlangganan %1$@: TextMouth tidak lagi memeriksa episode baru%2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Annullata l’iscrizione a %1$@: TextMouth non controlla più se ha nuovi episodi%2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@の購読を解除しました：TextMouth は新しいエピソードを確認しなくなります%2$@。"
