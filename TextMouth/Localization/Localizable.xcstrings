            "value" : "TextMouth sedang memindahkan buku antar folder. Tunggu hingga selesai, lalu pilih %@ lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth sta spostando libri tra le cartelle. Attendi che finisca, poi scegli di nuovo %@."
