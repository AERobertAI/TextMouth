    "readerViewModel.audioStoppedRespondingMessage" : {
      "comment" : "Message when playback was stopped because the system's audio stopped responding. Play is the name of a button; TextMouth is the app's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "توقف التشغيل: توقف الصوت عن الاستجابة. اضغط على “تشغيل” للمحاولة مرة أخرى، وإذا توقف مجددًا فأنهِ TextMouth وأعد فتحه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "প্লেব্যাক বন্ধ হয়েছে: অডিও সাড়া দেওয়া বন্ধ করেছে। আবার চেষ্টা করতে “চালান” চাপুন; আবার বন্ধ হলে TextMouth থেকে প্রস্থান করে সেটি আবার খুলুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Wiedergabe wurde angehalten: Das Audio reagiert nicht mehr. Wähle „Wiedergeben“, um es erneut zu versuchen; stoppt es wieder, beende TextMouth und öffne es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playback stopped: the audio stopped responding. Press Play to try again; if it stops again, quit and reopen TextMouth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La reproducción se detuvo: el audio dejó de responder. Pulsa Reproducir para volver a intentarlo; si se detiene otra vez, cierra TextMouth y ábrelo de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پخش متوقف شد: صدا دیگر پاسخ نمی‌داد. برای تلاش دوباره «پخش» را فشار دهید؛ اگر دوباره متوقف شد، از TextMouth خارج شوید و دوباره آن را باز کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La lecture s’est arrêtée : l’audio a cessé de répondre. Appuyez sur Lire pour réessayer ; si elle s’arrête de nouveau, quittez puis rouvrez TextMouth."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הניגון נעצר: השמע הפסיק להגיב. לחץ על “נגן” כדי לנסות שוב; אם הוא נעצר שוב, צא מ-TextMouth ופתח אותו מחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "प्लेबैक रुक गया: ऑडियो ने जवाब देना बंद कर दिया। फिर से प्रयास करने के लिए “चलाएँ” दबाएँ; यदि यह फिर रुक जाए, तो TextMouth को छोड़कर दोबारा खोलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pemutaran dihentikan: audio berhenti merespons. Tekan Putar untuk mencoba lagi; jika berhenti lagi, keluar lalu buka kembali TextMouth."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Riproduzione interrotta: l’audio ha smesso di rispondere. Premi Riproduci per riprovare; se si interrompe di nuovo, esci da TextMouth e riaprilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "再生を停止しました：オーディオが応答しなくなりました。「再生」を押して再試行してください。再び停止する場合は、TextMouth を終了して開き直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "재생이 중지되었습니다. 오디오가 응답하지 않습니다. 재생을 눌러 다시 시도하고, 다시 중지되면 TextMouth를 종료한 뒤 다시 여십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Afspelen is gestopt: de audio reageerde niet meer. Druk op Speel af om het opnieuw te proberen; als het weer stopt, sluit TextMouth af en open het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Odtwarzanie zatrzymano: dźwięk przestał odpowiadać. Naciśnij Odtwórz, aby spróbować ponownie; jeśli znów się zatrzyma, zakończ TextMouth i otwórz go ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reprodução interrompida: o áudio parou de responder. Pressione Reproduzir para tentar novamente; se parar outra vez, encerre o TextMouth e abra-o de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Воспроизведение остановлено: звуковая система перестала отвечать. Нажмите «Воспроизвести», чтобы повторить попытку; если воспроизведение снова остановится, завершите TextMouth и откройте его заново."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uppspelningen stoppades: ljudet slutade svara. Tryck på Spela upp för att försöka igen; om det stoppar igen, avsluta och öppna TextMouth på nytt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "การเล่นหยุดลง เพราะระบบเสียงไม่ตอบสนอง กด เล่น เพื่อลองอีกครั้ง หากหยุดอีก ให้ออกจาก TextMouth แล้วเปิดใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Oynatma durduruldu: ses yanıt vermeyi bıraktı. Tekrar denemek için Oynat'a basın; yine durursa TextMouth'tan çıkıp yeniden açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відтворення зупинено: аудіо перестало відповідати. Натисніть «Відтворити», щоб спробувати знову; якщо воно знову зупиниться, завершіть TextMouth і відкрийте його знову."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پلے بیک رک گیا: آڈیو نے جواب دینا بند کر دیا۔ دوبارہ کوشش کے لیے “چلائیں” دبائیں؛ اگر یہ پھر رک جائے تو TextMouth بند کر کے دوبارہ کھولیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đã dừng phát: âm thanh ngừng phản hồi. Hãy nhấn Phát để thử lại; nếu lại dừng, hãy thoát rồi mở lại TextMouth."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "播放已停止：音频不再响应。请按“播放”重试；若再次停止，请退出并重新打开 TextMouth。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "播放已停止：音訊停止回應。請按「播放」再試一次；如果再次停止，請結束並重新打開 TextMouth。"
          }
        }
      }
    },
    "readerViewModel.bookmarkAddedAnnouncement" : {
