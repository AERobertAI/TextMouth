            "value" : "Каталог данных отсутствует, поэтому журналы пишутся в %@, пока он не вернётся."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Каталог даних відсутній, тому журнали записуються в %@, доки його не буде."
