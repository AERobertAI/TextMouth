            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Esta imagen mide %@, más de %lld de megapíxeles, el límite que TextMouth lee."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Esta imagen mide %@, más de %lld megapíxel, el límite que TextMouth lee."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Esta imagen mide %@, más de %lld megapíxeles, el límite que TextMouth lee."
                }
              }
            }
          }
        }
      }
    },
    "This range has %lld headings, but an MP3 has chapters for the first %@ only. Choose M4B for a chapter for each." : {
      "comment" : "The line under the Format pop-up in the Export dialog's spoken audio options while MP3 is chosen for a range with more headings than an MP3 has chapters. %1$lld is the number of headings in the range and %2$@ the number of chapters an MP3 can have, 255. M4B and MP3 are audio file formats.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This range has %lld heading, but an MP3 has chapters for the first %@ only. Choose M4B for a chapter for each."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This range has %lld headings, but an MP3 has chapters for the first %@ only. Choose M4B for a chapter for each."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Este intervalo tiene %1$lld de encabezados, pero un MP3 tiene capítulos solo para los primeros %2$@. Elige M4B para tener un capítulo por cada uno."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Este intervalo tiene %1$lld encabezado, pero un MP3 tiene capítulos solo para los primeros %2$@. Elige M4B para tener un capítulo por cada uno."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Este intervalo tiene %1$lld encabezados, pero un MP3 tiene capítulos solo para los primeros %2$@. Elige M4B para tener un capítulo por cada uno."
                }
              }
            }
          }
        }
      }
    },
    "This re-extracts the cached text of every book, which may take a while for a large library." : {
      "comment" : "First sentence of the Redo Text Extraction question.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esto vuelve a extraer el texto en caché de cada libro, lo que puede tardar un poco en una biblioteca grande."
          }
        }
      }
    },
    "This recording isn't saved. %@ tries again, %@ deletes it, and %@ keeps the window open." : {
      "comment" : "Explanation under the question asked when the Record window is closed with a recording that could not be saved. %1$@, %2$@, and %3$@ are the titles of the question's three buttons: the one that saves, the one that deletes the recording, and the one that keeps the window open.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This recording isn't saved. %1$@ tries again, %2$@ deletes it, and %3$@ keeps the window open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta grabación no está guardada. %1$@ lo intenta de nuevo, %2$@ la elimina y %3$@ mantiene abierta la ventana."
          }
        }
      }
    },
    "This recreates the directory structure and migrates books using old storage." : {
      "comment" : "First sentence of the Rebuild Directory confirmation.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esto vuelve a crear la estructura de directorios y migra los libros que usan el almacenamiento antiguo."
          }
        }
      }
    },
    "This view is as TextMouth made it." : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). Restore Default…'s hint for a built-in view as TextMouth made it, or Folders or the Reading List, when it is dimmed.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta vista es como la hizo TextMouth."
          }
        }
      }
    },
    "This web archive holds a file of the type “%@”, not a web page or text, so it has nothing to read." : {
      "comment" : "Why a web archive (.webarchive, which Safari saves) could not be imported: its main file is not a page or text, but a picture or a PDF. %@ is the file's media type, such as image/png, which stays as it is.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este archivo web contiene un archivo del tipo “%@”, no una página web ni texto, así que no hay nada que leer."
          }
        }
      }
    },
    "Tilde" : {
      "comment" : "Name of the punctuation key \"~\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Tilde\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tilde"
          }
        }
      }
    },
    "Time" : {
      "comment" : "A segment of the display picker in Search in Book: each result's position is shown as an estimated time into the book.\nLabel before the time of the refusal, in a line of the speech refusal report; the time is written as the log files write it.\nLabel of a field in the audio editor that takes a time.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tiempo"
          }
        }
      }
    },
    "Time In" : {
      "comment" : "Choice of the headings sheet's display picker: each heading shows the time into the book at which it begins.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tiempo desde el inicio"
          }
        }
      }
    },
    "Time at %@" : {
      "comment" : "Label of the Go to Time field for a text book. %@ is the reading speed the times count at, such as \"500 words a minute\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tiempo a %@"
          }
        }
      }
    },
    "Time exceeds book length." : {
