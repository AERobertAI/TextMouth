    "libraryViewsSettings.visibilityHint" : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). The Visibility pop-up's hint.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحدد متى تتيح قائمة العرض المنبثقة هذا العرض."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ভিউ পপ-আপ কখন এই ভিউ দেখাবে তা ঠিক করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Legt fest, wann das Einblendmenü diese Ansicht anbietet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sets when the View pop-up offers this view"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Define cuándo el menú Vista ofrece esta vista"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعیین می‌کند منوی بازشوی نما چه زمانی این نما را ارائه کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Définit quand le menu Vue propose cette vue."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "קובע מתי התפריט הקופץ “תצוגה” מציע את התצוגה הזו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "तय करता है कि दृश्य पॉप-अप इस दृश्य को कब पेश करे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mengatur kapan menu pop-up Tampilan menawarkan tampilan ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Imposta quando il menu Vista propone questa vista."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「ビュー」ポップアップメニューにこのビューを表示するタイミングを設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보기 팝업 메뉴에서 이 보기를 제공하는 시점을 설정합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bepaalt wanneer de pop-up Weergave deze weergave aanbiedt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Określa, kiedy rozwijane menu Widok oferuje ten widok."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Define quando o menu local Visualização oferece esta visualização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Задаёт, когда меню представлений предлагает это представление."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Anger när popupknappen Vy erbjuder den här vyn."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "กำหนดว่าเมนูป๊อปอัปมุมมองจะแสดงมุมมองนี้เมื่อใด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Görünüm açılır menüsünün bu görünümü ne zaman sunacağını belirler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Задає, коли спливне меню «Вигляд» пропонує цей вигляд."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "طے کرتا ہے کہ منظر کا پاپ اپ مینو یہ منظر کب پیش کرے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đặt thời điểm nút bật lên Chế độ xem hiển thị chế độ xem này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "设定“视图”弹出式菜单何时提供此视图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "設定「顯示方式」彈出式選單何時提供此顯示方式。"
          }
        }
      }
    },
