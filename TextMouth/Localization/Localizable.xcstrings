          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Falló la conversión de %1$@ (el conversor terminó con el código %2$@)."
          }
        }
      }
    },
    "Converting %@ was stopped because %@." : {
      "comment" : "Why an audio conversion was stopped: it ran too long or used too much memory. %1$@ is the source file's name and %2$@ the reason, a clause in English that follows \"because\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Converting %1$@ was stopped because %2$@."
