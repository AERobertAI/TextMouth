            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Esta imagen contiene %lld de páginas, más de las %@ que TextMouth lee."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Esta imagen contiene %lld página, más de las %@ que TextMouth lee."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Esta imagen contiene %lld páginas, más de las %@ que TextMouth lee."
                }
              }
            }
          }
        }
      }
    },
    "This picture is %@, larger than the %lld megapixels TextMouth reads." : {
      "comment" : "Why a picture was refused at import: it says it holds more pixels than TextMouth decodes. %1$@ is its size, such as \"30,000 by 30,000 pixels\", and %2$lld the limit in megapixels.",
      "localizations" : {
        "en" : {
          "variations" : {
