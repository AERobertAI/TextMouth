        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ogni dispositivo che sincronizza mantiene i file di questo libro e li scarica quando può."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "同期するすべてのデバイスが、このブックのファイルを保持し、可能なときにダウンロードします。"
          }
        },
        "ko" : {
          "stringUnit" : {
