    },
    "Speak Download Progress" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Information group and read by VoiceOver. Speaks how far the feed downloads under way have got. Also the title of the menu command of the same name."
    },
    "Speak Full Info" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Information group and read by VoiceOver. Speaks the full summary of the selected book, folder or feed. Also the title of the menu command of the same name."
    },
    "Speak Import Progress" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Information group and read by VoiceOver. Speaks how far the imports under way have got. Also the title of the menu command of the same name."
    },
    "Speak Info" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Information group and read by VoiceOver. Speaks a short summary of the selected book, folder or feed. Also the title of the menu command of the same name."
    },
    "Speak Selection" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Speaks what is selected, with its length."
    },
    "Speed" : {
      "comment" : "Heading of the voice sheet's speed group, and what VoiceOver calls its speed slider."
    },
    "Speed: %@" : {
      "comment" : "Caption above an audiobook's speed slider in its own settings sheet. %@ is the speed, such as 1.25x."
    },
    "Speed: %lld WPM" : {
      "comment" : "Caption above the voice sheet's speed slider for a text book. WPM is the abbreviation of words per minute; %lld is the number of words.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Speed: %lld WPM"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Speed: %lld WPM"
                }
              }
            }
          }
        }
      }
    },
    "Start of the reading list" : {
      "comment" : "A sentence of the announcement as a book read from the reading list ends while the list plays upward: no book above it. Written without its full stop.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Inicio de la lista de lectura"
          }
        }
      }
    },
    "Starting again: %@" : {
      "comment" : "VoiceOver announcement as Play starts a finished book over from its beginning. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Empezando de nuevo: %@"
          }
        }
      }
    },
    "Starting: %@" : {
      "comment" : "VoiceOver announcement as the next book starts playing after one ends. %@ is the next book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Iniciando: %@"
          }
        }
      }
    },
    "Starts recording from %@." : {
      "comment" : "VoiceOver hint of the Record button in the Record window. %@ is the name of the microphone it records from."
    },
    "Starts recording once a microphone is connected." : {
      "comment" : "VoiceOver hint of the Record button in the Record window while no microphone is connected."
    },
    "Stats" : {
      "comment" : "Name of the Settings tab for reading statistics."
    },
    "Step %@" : {
      "comment" : "VoiceOver label of one step's pop-up of the restart gesture in the Miscellaneous settings. %@ is the step's number, an identifier written without digit grouping."
    },
    "Step %@:" : {
      "comment" : "The number of a step of the restart gesture in the Miscellaneous settings, shown beside its pop-up, ending with a colon. %@ is the step's number, an identifier written without digit grouping."
    },
    "Still starting: %@" : {
      "comment" : "VoiceOver announcement when Play is pressed while the next book is still opening. %@ is the next book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aún iniciando: %@"
          }
        }
      }
    },
    "Stop" : {
      "comment" : "A choice of the Reading List's When a book ends pop-up button: when a book opened from the list ends, stop there.\nA choice of the When a Book Ends picker: the book stops at its end, finished. Play then says it is finished.\nName of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Stop\".\nName of a keyboard shortcut action, listed in Settings in the Record window group and read by VoiceOver. Stops the recording.\nName of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Stops playback in the audio editor.\nTitle of the button in the Record window that stops recording and saves it.\nTitle of the button that stops a running search in the Search Library window.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detener"
          }
        }
      }
    },
    "Stop At" : {
      "comment" : "Heading of the sleep timer sheet's section of timers that stop at a place in the book: End of heading and End of book.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detener en"
          }
        }
      }
    },
    "Stop Where Am I announcement" : {
      "comment" : "What VoiceOver calls the reader toolbar's Where Am I? button while an announcement speaks; pressing it stops the announcement."
    },
    "Stop and Save" : {
      "comment" : "Title of the question's default button when the Record window is closed while recording: it stops the recording and saves it."
    },
    "Stop and save the recording?" : {
      "comment" : "The question asked when the Record window is closed while recording."
    },
    "Stop at the end of the book" : {
      "comment" : "VoiceOver label of the sleep timer sheet's End of book button, which sets a timer that stops where the book ends.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detener al final del libro"
          }
        }
      }
    },
    "Stop at the end of this heading" : {
      "comment" : "VoiceOver label of the sleep timer sheet's End of heading button, which sets a timer that stops where the heading playing ends.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detener al final de este encabezado"
          }
        }
      }
    },
    "Stop, and Play Starts Over" : {
      "comment" : "A choice of the When a Book Ends picker: the book stops at its end, finished, and Play then starts it again from the beginning."
    },
    "Stopped after %@ of %@:" : {
      "comment" : "Opening of the Search Library status after the user stopped a search, followed by what it had found. %1$@ is the number of books searched, and %2$@ is the count of all the books with its noun, such as \"750 books\". Ends with a colon.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stopped after %1$@ of %2$@:"
          }
        }
      }
    },
    "Stops playback resuming when headphones disconnect" : {
      "comment" : "VoiceOver hint of the Enable Bluetooth monitoring switch in the Miscellaneous settings."
    },
    "Stops recording and saves it in your library as an audiobook." : {
      "comment" : "VoiceOver hint of the Stop button in the Record window."
    },
    "Stops the search, keeping the matches found so far" : {
      "comment" : "VoiceOver hint of the Stop button of the Search Library window."
    },
    "Stops waiting for the download" : {
      "comment" : "Hint of the Cancel button of the reader's view while a book downloads."
    },
    "Storage" : {
      "comment" : "Name of the Settings tab for where the library is stored, importing books, and the logs."
    },
    "Subheading" : {
      "comment" : "A unit a skip or navigation picker moves by: one subheading, a heading below the main headings."
    },
    "Subtle" : {
      "comment" : "The name of punctuation pause level 1: only periods pause."
    },
    "Switches to jump to page controls" : {
      "comment" : "Hint of the status row's page button while the jump to percent or time panel is open."
    },
    "Switches to jump to percent controls" : {
      "comment" : "Hint of the reader's percent button while the jump to time or page panel is open."
    },
    "Switches to jump to time controls" : {
      "comment" : "Hint of the reader's time button while the jump to percent or page panel is open."
    },
    "System" : {
      "comment" : "Name of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + System\"."
    },
    "System Request" : {
      "comment" : "Name of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + System Request\"."
    },
    "Tab" : {
      "comment" : "Name of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Tab\"."
    },
    "Taken from %@" : {
      "comment" : "Announced by VoiceOver after a key was given to a keyboard shortcut action that another action had. %@ names the action or actions that lost the key, such as \"Play / Pause and Where Am I?\"."
    },
    "Takes %lld to %lld minutes." : {
      "comment" : "VoiceOver hint of the sleep timer sheet's custom minutes field on the iPhone: the fewest and most minutes it takes. %1$lld is the fewest (1); %2$lld the most (480).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Takes %1$lld to %2$lld minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Admite de %1$lld a %2$lld minutos."
          }
        }
      }
    },
    "Takes %lld to %lld minutes. Return sets the timer and plays the book." : {
      "comment" : "VoiceOver hint of the sleep timer sheet's custom minutes field on the Mac: the fewest and most minutes it takes, and what the Return key does there. %1$lld is the fewest (1); %2$lld the most (480). Return is the name of the key.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Takes %1$lld to %2$lld minutes. Return sets the timer and plays the book."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Admite de %1$lld a %2$lld minutos. Retorno programa el temporizador y reproduce el libro."
          }
        }
      }
    },
    "Takes each finished book off the list when its window moves on or closes. Books finished before you turn it on stay." : {
      "comment" : "VoiceOver hint of the Reading List's Remove books when finished checkbox.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quita de la lista cada libro terminado cuando su ventana pasa a otro libro o se cierra. Los libros terminados antes de activarlo se quedan."
          }
        }
      }
    },
    "Takes the selected books off the reading list. They stay in the library." : {
      "comment" : "VoiceOver hint of the Library's edit-mode bar button Remove from Reading List.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quita los libros seleccionados de la lista de lectura. Siguen en la biblioteca."
          }
        }
      }
    },
    "Test" : {
      "comment" : "Title of the button that tests a substitution rule on the input, and the heading of the group that holds it, in the rule editor."
    },
    "Test input" : {
      "comment" : "Placeholder of the field in the substitution rule editor where text is typed to test the rule on."
    },
    "Test input text" : {
      "comment" : "VoiceOver label of the test input field in the substitution rule editor."
    },
    "Test result: %@" : {
      "comment" : "VoiceOver label of the text a substitution rule made of the test input. %@ is the result."
    },
    "Test this rule against the input" : {
      "comment" : "VoiceOver label of the Test button in the substitution rule editor."
    },
    "Text" : {
      "comment" : "Name of the Settings tab for text substitution rules and repeated symbols."
    },
    "Text not updated: %@" : {
      "comment" : "Announcement when an edited text could not be taken for a reason the system or another part of the app gives. %@ is the reason."
    },
    "Text not updated: %@ was removed, or its download deleted, so Edit Text has stopped for it." : {
      "comment" : "Announcement when an Edit Text session ends because the book left the library. %@ is the book's title. Edit Text is a menu command."
    },
    "Text not updated: chapter %@ of the edited text of %@ %@, which TextMouth can't read safely. Flatten it and save again, or undo the change; the book keeps its old text until then." : {
      "comment" : "Announcement when an edited text was refused because one chapter nests lists or quotes too deeply. %1$@ is the chapter's number, an identifier written without digit grouping; %2$@ is the book's title; %3$@ is a clause such as \"nests more than 20 levels deep\", written by another part of the app.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Text not updated: chapter %1$@ of the edited text of %2$@ %3$@, which TextMouth can't read safely. Flatten it and save again, or undo the change; the book keeps its old text until then."
          }
        }
      }
    },
    "Text not updated: the edited text of %@ %@, which TextMouth can't read safely. Flatten it and save again, or undo the change; the book keeps its old text until then." : {
      "comment" : "Announcement when an edited text was refused because it nests lists or quotes too deeply. %1$@ is the book's title; %2$@ is a clause such as \"nests more than 20 levels deep\", written by another part of the app.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Text not updated: the edited text of %1$@ %2$@, which TextMouth can't read safely. Flatten it and save again, or undo the change; the book keeps its old text until then."
          }
        }
      }
    },
    "Text not updated: the edited text of %@ has no chapter with any text. Undo the change and save again; the book keeps its old text until then." : {
      "comment" : "Announcement when an edited text was refused because no chapter has any text left. %@ is the book's title."
    },
    "Text not updated: the edited text of %@ isn't UTF-8 text. Save it as UTF-8; the book keeps its old text until then." : {
      "comment" : "Announcement when an edited text was refused because it is not UTF-8 text. %@ is the book's title. UTF-8 is a text encoding."
    },
    "Text not updated: the edited transcript of %@ adds words to a chapter with no speech, where they can't be kept. Remove them and save again; the book keeps its old text until then." : {
      "comment" : "Announcement when an edited transcript was refused because the user added words to a chapter with no speech. %@ is the book's title."
    },
    "Text not updated: the edited transcript of %@ changes a chapter's heading, which comes from its audio. Put it back and save again; the book keeps its old text until then." : {
      "comment" : "Announcement when an edited transcript was refused because the user changed a chapter's heading. %@ is the book's title."
    },
    "Text not updated: the edited transcript of %@ has %@, but the audiobook has %@. Keep every line beginning with <!-- chapter: and save again; the book keeps its old text until then." : {
      "comment" : "Announcement when an edited transcript was refused because its number of chapters no longer matches the audiobook's. %1$@ is the book's title; %2$@ and %3$@ are counts of chapters such as \"3 chapters\". \"<!-- chapter:\" is literal text in the file and stays exactly as written.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Text not updated: the edited transcript of %1$@ has %2$@, but the audiobook has %3$@. Keep every line beginning with <!-- chapter: and save again; the book keeps its old text until then."
          }
        }
      }
    },
    "Text not updated: the original file of %@ changed too. The book's text is read from it again the next time the book opens." : {
      "comment" : "Announcement when an edited text was not taken because the book's own file changed too. %@ is the book's title."
    },
    "Text not updated: the transcript of %@ changed too. The book's text is written from it again the next time the book opens." : {
      "comment" : "Announcement when an edited text was not taken because the book's transcript changed too. %@ is the book's title."
    },
    "Text to find in every book" : {
      "comment" : "Placeholder of the empty search field in the Search Library window."
    },
    "Text updated" : {
      "comment" : "Announcement after the user saved an edited text and TextMouth took it as the book's text. Written without its full stop."
    },
    "Text updated." : {
      "comment" : "Announcement after the user saved an edited text of a feed episode's transcript, followed by a note about where the transcript stays."
    },
    "TextMouth closed while opening %@, so it wasn't reopened." : {
      "comment" : "Announced at launch after the app closed while it was opening a book. %@ is the book's title, which is not opened again."
    },
    "TextMouth couldn't open %@ in Finder." : {
      "comment" : "Shown under the Show Logs in Finder button when Finder could not open the folder. %@ is the folder's full path, which stays as written."
    },
    "TextMouth couldn't start recording from %@." : {
      "comment" : "Error in the Record window when recording from the chosen microphone failed to start. %@ is the microphone's name."
    },
    "TextMouth hasn't read the latest save yet." : {
      "comment" : "Reason after a colon: a rebuild left the book's text alone because the latest save of the edited text is not read yet."
    },
    "TextMouth is finishing up before it quits: %@. It quits when that is done." : {
      "comment" : "Panel text and announcement while TextMouth finishes work before quitting. %@ is the list of what is under way, such as \"saving the library and keeping downloads\", already joined in the language's own list style."
    },
    "TextMouth is not downloading right now." : {
      "comment" : "Why the download of a feed's next episode did not start: the app is quitting or the feed is being deleted. Said after \"The next episode could not be downloaded, so playback stopped.\"",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no está descargando en este momento."
          }
        }
      }
    },
    "TextMouth isn't allowed to use the microphone. Turn it on in System Settings, Privacy & Security, Microphone." : {
      "comment" : "Error in the Record window when macOS has denied TextMouth the microphone. Names the places in System Settings, as macOS words them, where the user can allow it."
    },
    "TextMouth kept the text you changed in %@." : {
      "comment" : "First sentence of the message when an automatic rebuild left a book's edited text alone. %@ is the book's title."
    },
    "TextMouth opens the book's manifest.json in your text editor." : {
      "comment" : "First sentence of the Edit Manifest explanation. manifest.json is a file name and stays as written."
    },
    "TextMouth opens the book's text in your text editor, as a Markdown file." : {
      "comment" : "First sentence of the Edit Text explanation. Markdown is the name of a text format."
    },
    "That match is no longer in the book's text. Search again to find it." : {
      "comment" : "Announcement when a search match is no longer in the book's text."
    },
    "The %@ in the list will be replaced by TextMouth's %@." : {
      "comment" : "First sentence of the message of the question asked before the Substitutions settings replace every rule with the defaults. %1$@ is the number of rules in the list with their noun, such as \"15 rules\", and %2$@ is the number of default rules with their noun, such as \"16 default rules\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The %1$@ in the list will be replaced by TextMouth's %2$@."
          }
        }
      }
    },
    "The %@ page labelled %@" : {
      "comment" : "The start of a sentence naming one of several pages that carry the same label. %1$@ is which of them it is, as an ordinal word such as \"first\" or \"11th\"; %2$@ is the label, an identifier written without digit grouping.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The %1$@ page labelled %2$@"
          }
        }
      }
    },
    "The %lld selected books are already in the reading list." : {
      "comment" : "VoiceOver announcement when Add to Reading List added nothing: every book selected is on the list already. %lld is the number of books selected (two or more).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los %lld libros seleccionados ya están en la lista de lectura."
          }
        }
      }
    },
    "The Hobbit counts as an H when you type. The list keeps its order and shows each title as it is written." : {
      "comment" : "Describes the Leading Articles choice Ignored When Typing, under the pop-up. The Hobbit is the example title, typed under the letter H."
    },
    "The Hobbit sorts among the H's and shows as Hobbit, The. Typing H finds it among the H's." : {
      "comment" : "Describes the Leading Articles choice Ignored When Typing and Sorting, under the pop-up. The Hobbit is the example title; the article moves to the end and the book sorts and types under H."
    },
    "The audio editor" : {
      "comment" : "Choice of the Works in pop-up of a keyboard shortcut: the shortcut works only in the audio editor's windows."
    },
    "The audiobook's title in your library." : {
      "comment" : "VoiceOver hint and tooltip of the Title field in the Record window."
    },
    "The book is in %@." : {
      "comment" : "Second sentence of the announcement after an import at the Reading List added one book to it: the library folder the book went to. %@ is the folder's path, such as Essays/Sea, or Library Root.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El libro está en %@."
          }
        }
      }
    },
    "The books are in %@." : {
      "comment" : "Second sentence of the announcement after an import at the Reading List added several books to it: the library folder they went to. %@ is the folder's path, such as Essays/Sea, or Library Root.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los libros están en %@."
          }
        }
      }
    },
    "The cursor is %@." : {
      "comment" : "Announcement after Go to Page when the cursor is not on the page typed and there is no known reason. %@ says where the cursor is, such as \"on page 52\" or \"before page 1\"."
    },
    "The data directory has no Logs folder, so logs go to %@ until it has one." : {
      "comment" : "The line under the Log location pop-up in the Storage settings while the data directory has no Logs folder. %@ is the folder's full path, which stays as written."
    },
    "The data directory is missing, so logs go to %@ until it is back." : {
      "comment" : "The line under the Log location pop-up in the Storage settings while the data directory is missing. %@ is the folder's full path, which stays as written."
    },
    "The data directory's Logs folder can't be written (%@), so logs go to %@ until it can." : {
      "comment" : "The line under the Log location pop-up in the Storage settings while the data directory's Logs folder cannot be written. %1$@ is the reason the system gives, which may be in English, and %2$@ is the folder's full path, which stays as written.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The data directory's Logs folder can't be written (%1$@), so logs go to %2$@ until it can."
          }
        }
      }
    },
    "The disk is almost full, so recording stopped. What was recorded is kept." : {
      "comment" : "Error in the Record window when the disk filled up while recording."
    },
    "The library folder the recording is saved in." : {
      "comment" : "VoiceOver hint of the Save in pop-up of the Record window."
    },
    "The library isn't available, so logs go to %@ until it is." : {
      "comment" : "The line under the Log location pop-up in the Storage settings while the library cannot be reached. %@ is the folder's full path, which stays as written."
    },
    "The manifest of %@ can't be edited: %@" : {
      "comment" : "Message when a book's manifest could not be readied for editing. %1$@ is the book's title; %2$@ is the reason, a sentence from the system or TextMouth.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The manifest of %1$@ can't be edited: %2$@"
          }
        }
      }
    },
    "The microphone TextMouth used last isn't connected, so recordings use %@." : {
      "comment" : "Said by the Record window when the microphone used last is not connected as the window opens. %@ is the name of the microphone recordings use instead."
    },
    "The microphone to record from. TextMouth remembers it; the input macOS uses elsewhere is unchanged." : {
      "comment" : "VoiceOver hint and tooltip of the Microphone pop-up in the Record window. TextMouth is the app's name."
    },
    "The most time the whole sequence may take. Shorter windows mean fewer accidental matches but quicker presses." : {
      "comment" : "Explanation under the restart gesture's time window slider in the Miscellaneous settings."
    },
    "The next article could not be downloaded, so playback stopped. %@" : {
      "comment" : "VoiceOver announcement when the download of a feed's next article failed. %@ is the download's own sentence saying why.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo descargar el siguiente artículo, así que la reproducción se detuvo. %@"
          }
        }
      }
    },
    "The next episode could not be downloaded, so playback stopped. %@" : {
      "comment" : "VoiceOver announcement when the download of a feed's next episode failed. %@ is the download's own sentence saying why.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo descargar el siguiente episodio, así que la reproducción se detuvo. %@"
          }
        }
      }
    },
    "The original file you imported is not changed." : {
      "comment" : "Last sentence of the warning shown under the metadata editor's switch while it is on: the file the user first imported stays as it was."
    },
    "The original file you imported is not touched." : {
      "comment" : "Last sentence of the hint of the metadata editor's switch that also writes the EPUB file: the file the user first imported stays as it was."
    },
    "The reading list is empty. To add a book, choose Add to Reading List from its context menu, its VoiceOver actions, or the Library menu." : {
      "comment" : "Shown and read as the only row of the Reading List while it holds no book. Add to Reading List is the name of the command in the Library menu.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La lista de lectura está vacía. Para agregar un libro, elige Add to Reading List en su menú contextual, sus acciones de VoiceOver o el menú Library."
          }
        }
      }
    },
    "The reading list is set to stop when a book ends" : {
      "comment" : "A sentence of the announcement as a book read from the reading list ends, after \"Finished: <title>.\": the list's When a book ends is Stop. Written without its full stop.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La lista de lectura está configurada para detenerse al terminar un libro"
          }
        }
      }
    },
    "The recording couldn't be converted to an audiobook file." : {
      "comment" : "Error in the Record window when saving: the recording could not be encoded as an audiobook file."
    },
    "The recording couldn't be finished properly. What was recorded is kept." : {
      "comment" : "Error in the Record window when stopping could not finish the recording's file properly."
    },
    "The recording couldn't be saved: %@ It is kept; choose %@ or %@." : {
      "comment" : "Status line and announcement of the Record window when saving a recording failed. %1$@ is the reason, a whole sentence that ends with its own full stop, %2$@ is the title of the button that tries again, and %3$@ is the title of the button that deletes the recording.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The recording couldn't be saved: %1$@ It is kept; choose %2$@ or %3$@."
          }
        }
      }
    },
    "The recording lasts %@." : {
      "comment" : "Second sentence of that refusal. %@ is the recording's length spoken in words, such as \"9 hours, 41 minutes, 7 seconds\"."
    },
    "The recording was discarded." : {
      "comment" : "Status line of the Record window after a recording was discarded."
    },
    "The recording window" : {
      "comment" : "Choice of the Works in pop-up of a keyboard shortcut: the shortcut works only in the Record window."
    },
    "The recording's audio couldn't be read." : {
      "comment" : "Error in the Record window when saving: the recorded take holds no audio that can be read."
    },
    "The text changed since the search; moved to the nearest match." : {
      "comment" : "Announcement when the book's text changed since the search and the reader moved to the nearest match."
    },
    "The text content.md held before was kept as %@, in the book's package." : {
      "comment" : "Second sentence of that message. content.md is the file name of the book's text and stays as written; %@ is the backup's file name such as content.md.edited-20261004T123012Z, which stays as written."
    },
    "The text of %@ can't be read, so it can't be edited." : {
      "comment" : "Message when Edit Text finds the book's text file unreadable. %@ is the book's title."
    },
    "The text of %@ isn't ready to edit yet." : {
      "comment" : "First sentence of the message when Edit Text finds the book's text file missing. %@ is the book's title."
    },
    "The text of %@ was read again from its own file." : {
      "comment" : "First sentence of the message after a book's text was read again from its own file. %@ is the book's title."
    },
    "There is no page %@ in this book." : {
      "comment" : "First sentence of the message when Go to Page is given a page the book does not have. %@ is what the user typed."
    },
    "This Mac doesn't allow TextMouth to use the microphone: a device management profile or Screen Time restricts it." : {
      "comment" : "Error in the Record window when something other than the user, a device management profile or Screen Time, keeps TextMouth from using the microphone."
    },
    "This Window" : {
      "comment" : "A choice of the Open the next book in pop-up button (Settings, Playback; Feed Info; Folder Settings): the next book opens in the window already open, in place of the book there.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta ventana"
          }
        }
      }
    },
    "This book has %lld pages, from %@ to %@." : {
      "comment" : "First sentence of the Go to Page field's hint. %1$lld is the number of pages in the book; %2$@ is the first page's label and %3$@ the last page's label, identifiers such as i or 300 written without digit grouping.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This book has %lld page, from %@ to %@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This book has %lld pages, from %@ to %@."
                }
              }
            }
          }
        }
      }
    },
    "This book has no pages." : {
      "comment" : "Announcement when a page command is used in a book that has no pages."
    },
    "This book has only one page." : {
      "comment" : "Announcement when a page command is used in a book that has one page, so there is no other page to go to."
    },
    "This book was not opened from the reading list." : {
      "comment" : "VoiceOver announcement when Next in Reading List or Previous in Reading List is used in a reader whose book was not opened from the reading list.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este libro no se abrió desde la lista de lectura."
          }
        }
      }
    },
    "This book's only page is %@." : {
      "comment" : "First sentence of the Go to Page field's hint for a book of one page. %@ is that page's label, an identifier written without digit grouping."
    },
    "This explanation appears only once." : {
      "comment" : "Last sentence of the Edit Manifest explanation: it is shown only the first time.\nLast sentence of the Edit Text explanation: it is shown only the first time."
    },
    "This recording isn't saved. %@ tries again, %@ deletes it, and %@ keeps the window open." : {
      "comment" : "Explanation under the question asked when the Record window is closed with a recording that could not be saved. %1$@, %2$@, and %3$@ are the titles of the question's three buttons: the one that saves, the one that deletes the recording, and the one that keeps the window open.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This recording isn't saved. %1$@ tries again, %2$@ deletes it, and %3$@ keeps the window open."
          }
        }
      }
    },
    "Tilde" : {
      "comment" : "Name of the punctuation key \"~\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Tilde\"."
    },
    "Time" : {
      "comment" : "A segment of the display picker in Search in Book: each result's position is shown as an estimated time into the book."
    },
    "Time In" : {
      "comment" : "Choice of the headings sheet's display picker: each heading shows the time into the book at which it begins."
    },
    "Time at %@" : {
      "comment" : "Label of the Go to Time field for a text book. %@ is the reading speed the times count at, such as \"500 words a minute\"."
    },
    "Time exceeds book length." : {
      "comment" : "First sentence of the refusal when the time typed in Go to Time is after the end of a text book."
    },
    "Time exceeds the recording's length." : {
      "comment" : "First sentence of the refusal when the time typed in Go to Time is after the end of an audiobook."
    },
    "Time in the recording" : {
      "comment" : "Label of the Go to Time field for an audiobook: the time is counted in the recording itself."
    },
    "Time window" : {
      "comment" : "Title of the slider in the Miscellaneous settings that sets how long the restart gesture's sequence may take."
    },
    "Time window: %@" : {
      "comment" : "The restart gesture's time window shown above its slider in the Miscellaneous settings. %@ is the window in seconds, such as \"2 seconds\"."
    },
    "Timer reset." : {
      "comment" : "VoiceOver announcement after the Restart Sleep Timer command started the running sleep timer again.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Temporizador reiniciado."
          }
        }
      }
    },
    "Timer reset: %@." : {
      "comment" : "VoiceOver announcement after Reset Timer started the sleep timer again. %@ is the timer's state, such as \"15:00 remaining\" or \"stops at the end of the book\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Temporizador reiniciado: %@."
          }
