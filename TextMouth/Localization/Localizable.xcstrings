    "dataDirectoryUnavailable.tryAgainHint" : {
      "comment" : "VoiceOver hint of Try Again on the Library Not Available screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يتحقق من موقع المكتبة مرة أخرى، ويفتح المكتبة عندما تكون موجودة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "লাইব্রেরির অবস্থান আবার যাচাই করে, আর সেখানে থাকলে লাইব্রেরি খোলে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Prüft den Ort der Bibliothek erneut und öffnet die Bibliothek, wenn sie dort ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checks the library's location again, and opens the library when it is there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vuelve a comprobar la ubicación de la biblioteca y la abre si está allí."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مکان کتابخانه را دوباره بررسی می‌کند و اگر کتابخانه آنجا باشد، آن را باز می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vérifie à nouveau l’emplacement de la bibliothèque et ouvre la bibliothèque si elle s’y trouve."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בודק שוב את מיקום הספרייה, ופותח את הספרייה כשהיא שם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लाइब्रेरी का स्थान फिर से जाँचता है, और वहाँ मिलने पर लाइब्रेरी खोलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Memeriksa lokasi pustaka lagi, dan membuka pustaka jika ada di sana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ricontrolla la posizione della libreria e la apre se è presente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ライブラリの場所を再確認し、見つかればライブラリを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관함의 위치를 다시 확인하고, 보관함이 있으면 엽니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Controleert de locatie van de bibliotheek opnieuw en opent de bibliotheek als die er is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ponownie sprawdza lokalizację biblioteki i otwiera ją, gdy tam jest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Verifica a localização da biblioteca de novo e abre a biblioteca se ela estiver lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Снова проверяет расположение библиотеки и открывает библиотеку, если она там."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kontrollerar bibliotekets plats igen och öppnar biblioteket när det finns där."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตรวจสอบตำแหน่งที่ตั้งของไลบรารีอีกครั้ง และเปิดไลบรารีเมื่อพบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitaplığın konumunu yeniden denetler ve kitaplık oradaysa açar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Знову перевіряє розташування бібліотеки й відкриває її, якщо вона на місці."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لائبریری کا مقام دوبارہ جانچتا ہے، اور لائبریری موجود ہو تو اسے کھولتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kiểm tra lại vị trí của thư viện và mở thư viện khi có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "再次检查资料库的位置，并在找到时打开资料库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "再次檢查書庫的位置，並在書庫位於該處時打開書庫。"
          }
        }
      }
    },
    "dataDirectoryUnavailableError.errorDescription" : {
      "comment" : "Error text when the library's folder can't be used. It follows what failed, as in \"Listening statistics could not be saved: The library at /Volumes/Backup/TextMouth isn't available.\" %@ is the folder's path.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "المكتبة في %@ غير متاحة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@-এর লাইব্রেরি উপলব্ধ নেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
