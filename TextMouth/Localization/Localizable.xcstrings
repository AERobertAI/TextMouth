    },
    "Found a recording from before TextMouth last quit, under %@. Save or discard it." : {
      "comment" : "Announcement of the Record window when it finds one recording left behind. %@ is the heading of the list of recovered recordings."
    },
    "Genre" : {
      "comment" : "Name of the book information sheet's field for an audiobook's genre; VoiceOver reads it as the field's label."
