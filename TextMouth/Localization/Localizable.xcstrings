    "Choose Edit Text again to edit the new copy's text." : {
      "comment" : "Second sentence of that announcement: what to do to edit the new copy. Edit Text is a menu command.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اختر تحرير النص مرة أخرى لتحرير نص النسخة الجديدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wähle erneut „Text bearbeiten“, um den Text der neuen Kopie zu bearbeiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige Editar texto otra vez para editar el texto de la copia nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisissez à nouveau Modifier le texte pour modifier le texte de la nouvelle copie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "नई प्रति का टेक्स्ट संपादित करने के लिए \"टेक्स्ट संपादित करें\" फिर से चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pilih Edit Teks lagi untuk mengedit teks salinan baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scegli di nuovo Modifica testo per modificare il testo della nuova copia."
