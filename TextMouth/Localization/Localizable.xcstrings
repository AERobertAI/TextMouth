        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "重做最近一次還原的編輯。"
          }
        }
      }
    },
    "audioEditor.explanation.editorRevert" : {
      "comment" : "Hint of the audio editor's Revert to Original button. \"Redo\" is the name of a command.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يتراجع عن كل تعديل حتى الأصل؛ وتعيدها “إعادة”."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "মূল অডিওতে ফিরে প্রতিটি সম্পাদনা পূর্বাবস্থায় ফেরায়; “পুনরায় করুন” বেছে নিলে সেগুলো ফিরে আসে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Widerruft jede Bearbeitung bis zum Original; „Wiederholen“ bringt sie zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undoes every edit, back to the original; Redo brings them back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deshace todas las ediciones, hasta el original; Rehacer las recupera."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "همه ویرایش‌ها را تا صدای اصلی واگرد می‌کند؛ «انجام مجدد» آن‌ها را برمی‌گرداند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Annule toutes les modifications, jusqu’à l’original ; Rétablir les ramène."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מבטל כל עריכה, עד למקור; “בצע שוב” מחזיר אותן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "हर संपादन को मूल स्थिति तक पूर्ववत करता है; “फिर से करें” उन्हें वापस लाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mengurungkan setiap edit, kembali ke audio asli; pilih Ulangi untuk mengembalikannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Annulla ogni modifica, fino all’originale; il comando Ripeti le riporta indietro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "すべての編集を元のオーディオまで取り消します。「やり直す」で復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "모든 편집을 원본까지 취소합니다. 다시 실행으로 다시 적용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Maakt elke bewerking ongedaan, terug naar het origineel; Herhaal brengt ze terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cofa każdą edycję, aż do oryginału; Ponów je przywraca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Desfaz todas as edições e volta ao original; Refazer pode trazê-las de volta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Отменяет все правки до оригинала; «Повторить» возвращает их."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ångrar varje redigering, tillbaka till originalet; Gör om återställer dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เลิกทำทุกการแก้ไขกลับไปเป็นต้นฉบับ คำสั่ง ทำซ้ำ จะนำกลับมา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Her düzenlemeyi orijinale kadar geri alır; Yinele bunları geri getirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Скасовує всі правки до оригіналу; «Повторити» повертає їх."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ہر ترمیم کو کالعدم کر کے اصل پر لاتا ہے؛ “دوبارہ کریں” انہیں واپس لے آتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hoàn tác mọi chỉnh sửa, về bản gốc; Làm lại sẽ khôi phục chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "撤销所有编辑，回到原始音频；“重做”可将其恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "還原所有編輯，回到原始音訊；「重做」可恢復它們。"
          }
        }
      }
    },
    "audioEditor.explanation.editorSave" : {
      "comment" : "Hint of the audio editor's Save button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحفظ التعديلات في ملف صوت الكتاب، بالصيغة التي يحتفظ بها الكتاب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইয়ের ফরম্যাটেই সম্পাদনাগুলো বইয়ের অডিও ফাইলে সংরক্ষণ করে।"
