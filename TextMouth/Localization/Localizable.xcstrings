    "pdfExtractionDiagnostics.problem.allPages" : {
      "comment" : "Warning after an import of a PDF whose every page needed text recognition (OCR) where it could not run. %lld is how many pages the PDF has, two or more. %@ is the pages and why, such as \"pages 3 and 7 (text recognition is not available)\", the reasons in English.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "تعذّر تشغيل OCR على كل صفحات ملف PDF، وعددها %lld صفحات، لذا ينقص النص الموجود في صورها فقط: %@."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "تعذّر تشغيل OCR على كل صفحات ملف PDF، وعددها %lld صفحة، لذا ينقص النص الموجود في صورها فقط: %@."
                }
              },
              "one" : {
