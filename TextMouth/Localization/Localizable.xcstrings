    "inProcessEngine.abandoned" : {
      "comment" : "Said when a library call inside the iPhone app ran too long and was abandoned. %1$@ is the work's name, such as \"the braille translation\" (English until its area converts); %2$@ is why it was stopped, such as \"it ran longer than 11 seconds\" (English until the watchdog's area converts). Read after an import's own words.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أوقف TextMouth %1$@ لأن %2$@، ولن يحاول مرة أخرى حتى يُغلق TextMouth ويُفتح من جديد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth %1$@ থামিয়ে দিয়েছে কারণ %2$@, এবং TextMouth বন্ধ করে আবার না খোলা পর্যন্ত আর চেষ্টা করবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth hat %1$@ gestoppt, weil %2$@, und versucht es erst wieder, wenn TextMouth beendet und neu geöffnet wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth stopped %@ because %@, and won't try again until TextMouth is closed and opened again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth detuvo %1$@ porque %2$@, y no volverá a intentarlo hasta que cierres y vuelvas a abrir TextMouth."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth %1$@ را متوقف کرد چون %2$@، و تا زمانی که TextMouth بسته و دوباره باز نشود دوباره تلاش نمی‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth a arrêté %1$@ parce que %2$@, et ne réessaiera pas avant que TextMouth soit fermé puis rouvert."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth עצר את %1$@ כי %2$@, ולא ינסה שוב עד שייסגר וייפתח מחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ने %1$@ रोक दिया क्योंकि %2$@, और TextMouth बंद करके दोबारा खोलने तक फिर से प्रयास नहीं करेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth menghentikan %1$@ karena %2$@, dan tidak akan mencoba lagi sampai TextMouth ditutup dan dibuka kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ha interrotto %1$@ perché %2$@, e non riproverà finché TextMouth non verrà chiuso e riaperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は%1$@を中止しました。理由：%2$@。TextMouth を閉じてもう一度開くまで、再試行しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 %1$@을(를) 중지했으며(이유: %2$@), TextMouth를 닫았다가 다시 열 때까지 다시 시도하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth heeft %1$@ gestopt omdat %2$@, en probeert het pas opnieuw als TextMouth is gesloten en weer geopend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth zatrzymał %1$@, ponieważ %2$@, i nie spróbuje ponownie, dopóki TextMouth nie zostanie zamknięty i otwarty od nowa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth interrompeu %1$@ porque %2$@, e não tentará novamente até ser fechado e aberto outra vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth остановил %1$@, потому что %2$@, и не будет пробовать снова, пока TextMouth не будет закрыт и открыт заново."
          }
