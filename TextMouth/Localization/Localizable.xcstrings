    "The previous episode could not be downloaded, so playback stopped." : {
      "comment" : "First sentence of the VoiceOver announcement when Previous in Folder could not download the previous podcast episode while a book was playing, so playback was paused. A sentence with the reason follows it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die vorherige Folge konnte nicht heruntergeladen werden, daher wurde die Wiedergabe gestoppt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo descargar el episodio anterior, así que la reproducción se detuvo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’épisode précédent n’a pas pu être téléchargé, donc la lecture s’est arrêtée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non è stato possibile scaricare l’episodio precedente, quindi la riproduzione si è interrotta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O episódio anterior não pôde ser baixado, então a reprodução parou."
          }
        }
      }
    },
    "The previous episode could not be downloaded." : {
