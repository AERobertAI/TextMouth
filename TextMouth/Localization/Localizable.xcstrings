    "feed.importPanelMessage" : {
      "comment" : "The message of the Open panel that chooses an OPML file of subscriptions.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اختر ملف OPML للاشتراكات، كما يصدّره قارئ موجزات آخر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "অন্য কোনো ফিড রিডার থেকে রপ্তানি করা সাবস্ক্রিপশনের একটি OPML ফাইল বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wähle eine OPML-Datei mit Abonnements, wie sie ein anderer Feed-Reader exportiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose an OPML file of subscriptions, as another feed reader exports them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige un archivo OPML de suscripciones, tal como lo exportan otros lectores de canales."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فایل OPML اشتراک‌ها را انتخاب کنید، همان فایلی که فیدخوان‌های دیگر صادر می‌کنند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisissez un fichier OPML d’abonnements, comme en exportent les autres lecteurs de flux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בחר קובץ OPML של הרשמות, כפי שקוראי ערוצים אחרים מייצאים אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सदस्यताओं की OPML फ़ाइल चुनें, जैसी दूसरा फ़ीड रीडर निर्यात करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pilih file OPML berisi langganan, seperti yang diekspor pembaca feed lain."
