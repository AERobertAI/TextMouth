        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Оригинал аудио удалён %@, поэтому правки, сохранённые до этого, нельзя отменить."
          }
        }
      }
    },
    "The original file at %@ could not be read to check a copy of it." : {
