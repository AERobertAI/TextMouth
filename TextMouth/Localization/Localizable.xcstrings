    "libraryIndexRecoveryError.couldNotPreserveFix" : {
      "comment" : "Last sentence of why Rebuild Library Index replaced nothing: what to do.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تأكد من إمكانية الكتابة في مجلده، ثم حاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এর ফোল্ডারে লেখা যায় কি না নিশ্চিত করুন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stelle sicher, dass in den Ordner geschrieben werden kann, und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure its folder can be written to, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Comprueba que se pueda escribir en su carpeta e inténtalo de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مطمئن شوید می‌توان در پوشه آن نوشت، سپس دوباره تلاش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Assurez-vous que son dossier est accessible en écriture, puis réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ודא שאפשר לכתוב בתיקייה שלו, ואז נסה שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सुनिश्चित करें कि उसके फ़ोल्डर में लिखा जा सकता है, फिर दोबारा प्रयास करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pastikan folder-nya dapat ditulisi, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Verifica che la sua cartella sia scrivibile, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "そのフォルダに書き込めることを確認してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "폴더에 쓸 수 있는지 확인한 다음 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zorg dat naar de map kan worden geschreven en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Upewnij się, że do jego folderu można zapisywać, i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
