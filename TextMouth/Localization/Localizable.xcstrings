    "audioEditor.microphoneHint" : {
      "comment" : "Hint of the audio editor's microphone pop-up. \"Record window\" is TextMouth's window that records audio.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "الميكروفون الذي يسجّل منه “تسجيل فوق التحديد”. يتذكره TextMouth بمعزل عن إدخال macOS."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "রেকর্ড করে বসানোর মাইক্রোফোন। macOS-এর ইনপুট থেকে আলাদাভাবে TextMouth এটি মনে রাখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Mikrofon, mit dem „Darüber aufnehmen“ aufnimmt. TextMouth merkt es sich, unabhängig vom Eingang von macOS."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The microphone Punch In records from. TextMouth remembers it, apart from macOS's input."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El micrófono que usa Grabar encima para grabar. TextMouth lo recuerda, aparte de la entrada de macOS."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "میکروفونی که «ضبط روی انتخاب» از آن ضبط می‌کند. TextMouth آن را جدا از ورودی macOS به یاد می‌سپارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le microphone avec lequel Enregistrer par-dessus enregistre. TextMouth s’en souvient, indépendamment de l’entrée de macOS."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "המיקרופון שממנו “הקלט מעל” מקליט. TextMouth זוכר אותו, בנפרד מהקלט של macOS."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "वह माइक्रोफ़ोन जिससे चयन पर रिकॉर्ड किया जाता है। TextMouth उसे याद रखता है, macOS के इनपुट से अलग।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mikrofon yang dipakai Rekam Menimpa untuk merekam. TextMouth mengingatnya, terpisah dari input macOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il microfono usato dal comando Registra sopra. TextMouth lo ricorda, a prescindere dall’ingresso di macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「上書き録音」で録音するマイクです。TextMouth は、macOS の入力とは別に記憶します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "덮어 녹음에 사용하는 마이크입니다. TextMouth는 macOS 입력 설정과 별도로 이 선택을 기억합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De microfoon waarmee Neem erover op opneemt. TextMouth onthoudt die, los van de invoer van macOS."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mikrofon, z którego nagrywa funkcja Nagraj w miejscu zaznaczenia. TextMouth go zapamiętuje, niezależnie od wejścia macOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O microfone de onde Gravar por cima grava. O TextMouth o memoriza, separado da entrada do macOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Микрофон, с которого ведёт запись «Записать поверх». TextMouth запоминает его отдельно от входа macOS."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mikrofonen som Spela in över spelar in från. TextMouth kommer ihåg den, oberoende av ingången i macOS."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไมโครโฟนที่ใช้บันทึกทับ โดย TextMouth จะจำไว้แยกจากอินพุตของ macOS"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Üzerine Kayıt'ın kayıt yaptığı mikrofon. TextMouth bunu, macOS'in girişinden ayrı olarak hatırlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Мікрофон, з якого записує «Записати поверх». TextMouth запам’ятовує його окремо від входу macOS."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "وہ مائیکروفون جس سے “انتخاب پر ریکارڈ کریں” ریکارڈ کرتا ہے۔ TextMouth اسے macOS کے ان پٹ سے الگ یاد رکھتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Micrô mà lệnh Ghi đè dùng để ghi âm. TextMouth ghi nhớ micrô này, tách biệt với đầu vào của macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "覆盖录制所用的麦克风。TextMouth 会记住它，与 macOS 的输入设备无关。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「覆蓋錄音」使用的麥克風。TextMouth 會記住它，與 macOS 的輸入裝置無關。"
          }
        }
      }
    },
