        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um livro que está apenas em %@ precisa de conexão com a internet para ser aberto."
          }
        }
      }
    },
    "A book that's only in the cloud needs an internet connection to open." : {
