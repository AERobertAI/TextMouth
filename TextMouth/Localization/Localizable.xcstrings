    "nextBookWindow.globalHint" : {
      "comment" : "VoiceOver hint of the Open the next book in pop-up button in Settings, Playback, also shown under it. %@ is the name of its choice This Window.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يختار المكان الذي يُفتح فيه الكتاب التالي: في هذه النافذة أو في نافذة جديدة. يظهر الكتاب المفتوح في نافذة أخرى، وعند اختيار “%@” تُغلق هذه النافذة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পরের বই কোথায় খুলবে তা বেছে নেয়: এই উইন্ডোতে বা একটি নতুন উইন্ডোতে। অন্য উইন্ডোতে খোলা বই সামনে আসে, এবং %@ বেছে নিলে এই উইন্ডো বন্ধ হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Legt fest, wo das nächste Buch geöffnet wird: in diesem oder in einem neuen Fenster. Ein in einem anderen Fenster geöffnetes Buch kommt nach vorn, und bei der Wahl von „%@“ wird dieses Fenster geschlossen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chooses where the next book opens: in this window or a new one. A book open in another window comes forward, and with %@ chosen, this window closes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige dónde se abre el siguiente libro: en esta ventana o en una nueva. Un libro abierto en otra ventana pasa al frente y, si eliges %@, esta ventana se cierra."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "انتخاب می‌کند کتاب بعدی کجا باز شود: در این پنجره یا در پنجره‌ای جدید. کتابی که در پنجره‌ای دیگر باز است به جلو می‌آید، و با انتخاب %@ این پنجره بسته می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisit où s’ouvre le livre suivant : dans cette fenêtre ou dans une nouvelle. Un livre ouvert dans une autre fenêtre passe au premier plan, et avec %@ choisi, cette fenêtre se ferme."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בוחר היכן ייפתח הספר הבא: בחלון הזה או בחלון חדש. ספר שפתוח בחלון אחר עובר לחזית, וכשנבחר %@, החלון הזה נסגר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चुनता है कि अगली पुस्तक कहाँ खुले: इसी विंडो में या नई में। किसी दूसरी विंडो में खुली पुस्तक आगे आ जाती है, और “%@” चुनने पर यह विंडो बंद हो जाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Memilih tempat buku berikutnya dibuka: di jendela ini atau jendela baru. Buku yang terbuka di jendela lain dibawa ke depan, dan jika %@ dipilih, jendela ini ditutup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sceglie dove si apre il libro successivo: in questa finestra o in una nuova. Un libro aperto in un’altra finestra passa in primo piano e, con %@ scelto, questa finestra si chiude."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "次のブックを開く場所を、このウインドウか新しいウインドウから選びます。別のウインドウで開いているブックは前面に表示され、「%@」を選ぶとこのウインドウは閉じます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "다음 책을 이 윈도우에서 열지 새 윈도우에서 열지 선택합니다. 다른 윈도우에 열려 있는 책은 앞으로 나오며, %@을(를) 선택하면 이 윈도우가 닫힙니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kiest waar het volgende boek opent: in dit venster of in een nieuw venster. Een boek dat in een ander venster is geopend, komt naar voren, en als %@ is gekozen, wordt dit venster gesloten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wybiera, gdzie otwiera się następna książka: w tym oknie lub w nowym. Książka otwarta w innym oknie jest przenoszona na wierzch, a po wybraniu %@ to okno się zamyka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escolhe onde o próximo livro abre: nesta janela ou em uma nova. Um livro aberto em outra janela vem para a frente e, com %@ escolhido, esta janela é fechada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Выбирает, где откроется следующая книга: в этом окне или в новом. Книга, открытая в другом окне, выходит на передний план, а при выборе «%@» это окно закрывается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Väljer var nästa bok öppnas: i det här fönstret eller i ett nytt. En bok som är öppen i ett annat fönster kommer fram, och med ”%@” valt stängs det här fönstret."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เลือกตำแหน่งที่จะเปิดหนังสือเล่มถัดไป: ในหน้าต่างนี้หรือหน้าต่างใหม่ หนังสือที่เปิดอยู่ในหน้าต่างอื่นจะขึ้นมาด้านหน้า และเมื่อเลือก %@ หน้าต่างนี้จะปิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sonraki kitabın nerede açılacağını seçer: bu pencerede veya yeni bir pencerede. Başka bir pencerede açık olan kitap öne gelir; %@ seçiliyse bu pencere kapanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вибирає, де відкривається наступна книга: у цьому вікні чи в новому. Книга, відкрита в іншому вікні, виходить на передній план, а якщо вибрано «%@», це вікно закривається."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "منتخب کرتا ہے کہ اگلی کتاب کہاں کھلے: اسی ونڈو میں یا نئی ونڈو میں۔ دوسری ونڈو میں کھلی کتاب سامنے آ جاتی ہے، اور %@ منتخب ہو تو یہ ونڈو بند ہو جاتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chọn nơi mở sách tiếp theo: trong cửa sổ này hay cửa sổ mới. Sách đang mở trong cửa sổ khác sẽ được đưa lên trước, và khi chọn %@, cửa sổ này sẽ đóng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "选取下一本图书的打开位置：在此窗口或新窗口中。在其他窗口中已打开的图书会移到前面，选取“%@”时，此窗口会关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選擇下一本書要打開的位置：此視窗或新視窗。已在其他視窗打開的書會移到前面，若選擇 %@，此視窗會關閉。"
          }
        }
      }
    },
    "nextBookWindow.globalLabel" : {
      "comment" : "Label of the pop-up button in Settings, Playback, and in a folder's settings, choosing where the next book opens; its choices are This Window and A New Window.",
      "extractionState" : "manual",
