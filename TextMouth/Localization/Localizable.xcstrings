      }
    },
    "The View pop-up of a Library window offers these views in this order. A new window opens at the first one offered." : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). What the list is, and where a new window opens.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Einblendmenü „Ansicht“ eines Bibliotheksfensters bietet diese Ansichten in dieser Reihenfolge an. Ein neues Fenster öffnet sich bei der ersten angebotenen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El menú Vista de una ventana de la biblioteca ofrece estas vistas en este orden. Una ventana nueva se abre en la primera que se ofrece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le menu Vue d’une fenêtre de bibliothèque propose ces vues dans cet ordre. Une nouvelle fenêtre s’ouvre sur la première proposée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il menu Vista di una finestra della libreria propone queste viste in quest’ordine. Una nuova finestra si apre sulla prima proposta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O menu Visualização de uma janela da biblioteca oferece estas visualizações nesta ordem. Uma nova janela abre na primeira oferecida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Меню представлений окна библиотеки предлагает эти представления в таком порядке. Новое окно открывается на первом из предложенных."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Меню «Вигляд» у вікні бібліотеки пропонує ці вигляди в такому порядку. Нове вікно відкривається на першому з запропонованих."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "资料库窗口的“视图”弹出式菜单按此顺序提供这些视图。新窗口会在提供的第一个视图处打开。"
          }
        }
      }
    },
    "The address of %@ doesn't hold a feed TextMouth can read." : {
      "comment" : "Why a feed could not be refreshed or subscribed to: its address holds something that is not a feed, such as a web page. %@ is the feed's title or server.",
      "localizations" : {
