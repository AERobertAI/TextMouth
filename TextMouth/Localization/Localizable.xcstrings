      }
    },
    "This book has no headings, so all of it is exported." : {
      "comment" : "Shown in the Export dialog's spoken audio options in place of the From and To pop-ups when the book has no headings.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este libro no tiene encabezados, así que se exporta completo."
          }
        }
      }
    },
    "This book has no pages." : {
      "comment" : "Announcement when a page command is used in a book that has no pages.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este libro no tiene páginas."
          }
        }
      }
    },
    "This book has no valid managed package. Remove it from the library only, or repair its storage before deleting it." : {
      "comment" : "Why a book's files were not deleted: it has no package inside the library. Follows \"Import failed: \". \"Remove it from the library only\" is a choice of the removal commands.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este libro no tiene un paquete administrado válido. Quítalo solo de la biblioteca, o repara su almacenamiento antes de eliminarlo."
          }
        }
      }
    },
    "This book has only one page." : {
      "comment" : "Announcement when a page command is used in a book that has one page, so there is no other page to go to.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este libro tiene una sola página."
          }
        }
      }
    },
    "This book keeps its original audio for %lld days after it was saved or last edited." : {
      "comment" : "Said as a book's original audio policy is set to keep the original for a number of days. %lld is the number of days.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This book keeps its original audio for %lld day after it was saved or last edited."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This book keeps its original audio for %lld days after it was saved or last edited."
                }
