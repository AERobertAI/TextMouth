          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Spelar upp boken; den stannar ändå vid slutet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
