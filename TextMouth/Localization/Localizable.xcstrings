    "libraryList.entersEditMode" : {
      "comment" : "Hint of the toolbar's edit mode button while edit mode is off.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يدخل وضع التحرير لتحديد عدة كتب لنقلها أو إزالتها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "একাধিক বই নির্বাচন করে স্থানান্তর করতে বা সরাতে সম্পাদনা মোডে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Schaltet den Bearbeitungsmodus ein, um mehrere Bücher zum Verschieben oder Entfernen auszuwählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enters edit mode, for selecting several books to move or remove."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Entra en el modo de edición, para seleccionar varios libros que mover o quitar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "وارد حالت ویرایش می‌شود، برای انتخاب چند کتاب جهت انتقال یا برداشتن."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Active le mode modification, pour sélectionner plusieurs livres à déplacer ou à retirer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "נכנס למצב עריכה, לבחירת כמה ספרים להעברה או להסרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "संपादन मोड में जाता है, कई पुस्तकें चुनकर उन्हें ले जाने या हटाने के लिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Masuk ke mode edit untuk memilih beberapa buku yang akan dipindahkan atau dibuang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Entra in modalità modifica, per selezionare più libri da spostare o rimuovere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "編集モードを開始します。複数のブックを選択して、移動したり取り除いたりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "편집 모드를 시작합니다. 여러 책을 선택하여 이동하거나 제거할 수 있습니다."
          }
