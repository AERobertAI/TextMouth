    "No copy of your edited text could be kept, so TextMouth leaves content.md as it is." : {
      "comment" : "Sentence saying that no backup of the user's edited text could be made. content.md is the file name of the book's text and stays as written.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّر الاحتفاظ بنسخة من نصك المحرَّر، لذا يترك TextMouth الملف content.md كما هو."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es konnte keine Kopie deines bearbeiteten Texts behalten werden, daher lässt TextMouth content.md unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo conservar ninguna copia de tu texto editado, así que TextMouth deja content.md como está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucune copie de votre texte modifié n’a pu être conservée, donc TextMouth laisse content.md tel quel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आपके संपादित टेक्स्ट की कोई प्रति नहीं रखी जा सकी, इसलिए TextMouth content.md को जैसा है वैसा ही छोड़ देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tidak ada salinan teks hasil edit Anda yang dapat disimpan, sehingga TextMouth membiarkan content.md apa adanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non è stato possibile conservare una copia del tuo testo modificato, quindi TextMouth lascia content.md com’è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "編集したテキストのコピーを保持できなかったため、TextMouth は content.md をそのままにします。"
