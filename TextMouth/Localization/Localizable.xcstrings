          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deteniendo el traslado de la biblioteca antes de salir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrêt du déplacement de la bibliothèque avant de quitter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
