    "bookExport.hint.audio" : {
      "comment" : "The hint of the Audio checkbox in the Export dialog.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صوت الكتاب: ملفه، أو مقاطعه في مجلد يحمل اسم الكتاب، كل منها باسم فصله."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইয়ের অডিও: এর ফাইল, বা বইয়ের নামে ফোল্ডারে এর ট্র্যাকগুলো, প্রতিটি তার অধ্যায়ের নামে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Audio des Buchs: seine Datei oder seine Tracks in einem nach dem Buch benannten Ordner, jeweils nach ihrem Kapitel benannt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The book's audio: its file, or its tracks in a folder named after the book, each named for its chapter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El audio del libro: su archivo, o sus pistas en una carpeta con el nombre del libro, cada una con el nombre de su capítulo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صدای کتاب: فایل آن، یا تراک‌های آن در پوشه‌ای به نام کتاب، هر کدام به نام فصلش."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’audio du livre : son fichier, ou ses pistes dans un dossier portant le nom du livre, chacune nommée d’après son chapitre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "השמע של הספר: הקובץ שלו, או הרצועות שלו בתיקייה על שם הספר, כל אחת על שם הפרק שלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पुस्तक का ऑडियो: उसकी फ़ाइल, या पुस्तक के नाम वाले फ़ोल्डर में उसके ट्रैक, हर एक का नाम उसके अध्याय पर।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Audio buku: file-nya, atau trek-nya dalam folder bernama sesuai buku, masing-masing dinamai sesuai babnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’audio del libro: il suo file o le sue tracce in una cartella con il nome del libro, ognuna col nome del suo capitolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブックのオーディオです。ファイル、またはブック名のフォルダに入った各トラックで、トラックにはチャプタ名が付きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책의 오디오: 파일 하나 또는 책 이름의 폴더에 있는 트랙이며, 각 트랙은 챕터 이름을 따릅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De audio van het boek: het bestand, of de tracks ervan in een map met de naam van het boek, elk genoemd naar zijn hoofdstuk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dźwięk książki: jej plik albo jej ścieżki w folderze nazwanym od książki, każda nazwana od swojego rozdziału."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O áudio do livro: seu arquivo, ou suas faixas em uma pasta com o nome do livro, cada uma com o nome do seu capítulo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Аудио книги: её файл или её дорожки в папке с названием книги, каждая с названием своей главы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bokens ljud: dess fil, eller dess spår i en mapp uppkallad efter boken, vart och ett uppkallat efter sitt kapitel."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เสียงของหนังสือ: ไฟล์ของหนังสือ หรือแทร็กในโฟลเดอร์ที่ตั้งชื่อตามหนังสือ โดยแต่ละแทร็กตั้งชื่อตามบท"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitabın sesi: dosyası veya kitabın adını taşıyan klasördeki parçaları; her biri bölümünün adını taşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Аудіо книги: її файл або доріжки в папці з назвою книги, кожна названа за розділом."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب کا آڈیو: اس کی فائل، یا کتاب کے نام کے فولڈر میں اس کے ٹریک، ہر ایک اپنے باب کے نام سے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Âm thanh của sách: tệp của sách, hoặc các bản âm thanh trong một thư mục đặt theo tên sách, mỗi bản được đặt tên theo chương."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "图书的音频：其文件，或位于以图书命名的文件夹中的各个音轨，每个以其章节命名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "書籍的音訊：其檔案，或位於以書名命名的檔案夾中的各個音軌，每個音軌以其章節命名。"
          }
        }
      }
    },
    "bookExport.hint.originalAudio" : {
      "comment" : "The hint of the Original audio checkbox in the Export dialog. \"Original audio\" is the name of a setting.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صوت الكتاب كما كان قبل أول تعديل، ويحتفظ به TextMouth ما دام إعداد الصوت الأصلي مفعّلًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইয়ের প্রথম সম্পাদনার আগের অডিও, যা “মূল অডিও” সেটিং চালু থাকা পর্যন্ত TextMouth রাখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Audio des Buchs vor seiner ersten Bearbeitung, das TextMouth aufbewahrt, solange „Originalaudio“ aktiviert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The book's audio as it was before its first edit, which TextMouth keeps while the Original audio setting does."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El audio del libro antes de su primera edición, que TextMouth conserva mientras el ajuste Audio original lo indique."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صدای کتاب پیش از اولین ویرایشش، که TextMouth تا وقتی تنظیم «صدای اصلی» روشن است نگه می‌دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’audio du livre tel qu’il était avant sa première modification, que TextMouth conserve tant que le réglage Audio d’origine est activé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "השמע של הספר כפי שהיה לפני העריכה הראשונה, ש-TextMouth שומר כל עוד ההגדרה “שמע מקורי” פועלת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पुस्तक का ऑडियो जैसा वह पहले संपादन से पहले था, जिसे TextMouth तब तक रखता है जब तक मूल ऑडियो सेटिंग चालू है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Audio buku sebelum pengeditan pertamanya, yang disimpan TextMouth selama pengaturan Audio asli aktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’audio del libro com’era prima della prima modifica, che TextMouth conserva finché l’impostazione Audio originale è attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "最初の編集の前のブックのオーディオです。「元のオーディオ」の設定がオンの間、TextMouth が保持しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "첫 편집 전의 책 오디오로, 원본 오디오 설정이 켜져 있는 동안 TextMouth가 보관합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De audio van het boek zoals die was vóór de eerste wijziging, die TextMouth bewaart zolang de instelling Originele audio aanstaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dźwięk książki sprzed pierwszej edycji, który TextMouth zachowuje, dopóki włączone jest ustawienie Oryginalny dźwięk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O áudio do livro como era antes da primeira edição, que o TextMouth mantém enquanto o ajuste Áudio original estiver ativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Аудио книги до первой правки, которое TextMouth хранит, пока включён параметр «Исходное аудио»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bokens ljud som det var före första redigeringen, vilket TextMouth behåller så länge inställningen ”Originalljud” är på."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เสียงของหนังสือก่อนการแก้ไขครั้งแรก ซึ่ง TextMouth เก็บไว้ตราบที่การตั้งค่าเสียงต้นฉบับเปิดอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitabın ilk düzenlemesinden önceki sesi; Orijinal ses ayarı açık olduğu sürece TextMouth bunu saklar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Аудіо книги до першої правки, яке TextMouth зберігає, поки увімкнено налаштування «Оригінальне аудіо»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب کا آڈیو جیسا اس کی پہلی ترمیم سے پہلے تھا، جسے TextMouth اس وقت تک رکھتا ہے جب تک “اصل آڈیو” کی ترتیب آن ہو۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Âm thanh của sách như trước lần sửa đầu tiên, mà TextMouth giữ lại chừng nào cài đặt Âm thanh gốc còn bật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "图书在首次编辑前的音频，只要“原始音频”设置开启，TextMouth 就会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "書籍在第一次編輯前的音訊，只要「原始音訊」設定開啟，TextMouth 就會保留。"
          }
        }
      }
    },
    "bookExport.hint.originalFile" : {
      "comment" : "The hint of the Original file checkbox in the Export dialog.",
