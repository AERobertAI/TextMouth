          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "テキストエディタで開き、エンティティ定義を削除して保存してから、もう一度読み込んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "텍스트 편집기에서 열어 엔티티 정의를 제거하고 저장한 다음 다시 가져오십시오."
          }
        },
        "nl" : {
