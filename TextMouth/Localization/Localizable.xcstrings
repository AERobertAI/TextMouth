    "Read" : {
      "comment" : "The note on a feed's article that was read to its end or marked read. Title case.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Leído"
          }
        }
      }
    },
    "Read Again" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. The alert's button that reads the book again; Cancel leaves it.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Volver a leer"
          }
        }
      }
    },
    "Read Only" : {
      "comment" : "Heading of the group of fields of the book information sheet that the user cannot change.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Solo lectura"
          }
        }
      }
    },
    "Read on the web:" : {
      "comment" : "The line that starts the link to an article's web page, at the end of the article's text as TextMouth saves it as a book. The article's address follows as a link.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Leer en la web:"
          }
        }
      }
    },
    "Read “%@” again as %@?" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. The title of the alert that asks before the book titled bookTitle is read again as the reading named readingName: \"Read “Ledger” again as Shift JIS (Japanese)?\". Braille file characters are asked about in the same sentence (BrailleFileCodeWording.confirmTitle(bookTitle:code:)). Placeholders in order: bookTitle, readingName.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Read “%1$@” again as %2$@?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "¿Volver a leer “%1$@” como %2$@?"
          }
        }
      }
    },
    "Read “%@” again automatically?" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. The title of the alert that asks before a book is read again as option says: \"Read “Ledger” again as Shift JIS (Japanese)?\", or \"Read “Ledger” again automatically?\". Placeholders in order: bookTitle.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "¿Volver a leer “%@” automáticamente?"
          }
        }
      }
    },
    "Reader Toolbar" : {
      "comment" : "The heading of the Playback settings section that holds the options of the reader's toolbar.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Barra de herramientas del lector"
          }
        }
      }
    },
    "Reader windows" : {
      "comment" : "Choice of the Works in pop-up of a keyboard shortcut: the shortcut works in the reader windows, where a book is read.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ventanas del lector"
          }
        }
      }
    },
    "Reading" : {
      "comment" : "Heading of the iPhone Settings section that holds Follow in Braille.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lectura"
          }
        }
      }
    },
    "Reading List" : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. A kind of test as a condition's test pop-up names it. This is the case .inReadingList.\nThe start of the window title of a book read from the reading list, before a colon and the book's title, in place of \"Book\"; also the name of the Library's Reading List.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lista de lectura"
          }
        }
      }
    },
    "Reading List Order" : {
      "comment" : "Name of the order the Reading List shows its books in, the one the listener arranges: the only item of its Sort menu.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Orden de la lista de lectura"
          }
        }
      }
    },
    "Reading State" : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. A kind of test as a condition's test pop-up names it. This is the case .readingState.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Estado de lectura"
          }
        }
      }
    },
    "Reading Statistics" : {
      "comment" : "Row in iPhone Settings that opens the reading statistics, and the title of the screen it opens.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Estadísticas de lectura"
          }
        }
      }
    },
    "Reading list, book %lld of %lld" : {
      "comment" : "Where a book read from the reading list stands in it, in the reader's header and in Where Am I?. %1$lld is the book's place in the list; %2$lld how many books the list holds.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reading list, book %1$lld of %2$lld"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lista de lectura, libro %1$lld de %2$lld"
          }
        }
      }
    },
    "Reading list: %@ is only on %@'s list, at place %@." : {
      "comment" : "A difference found by Compare Libraries. %1$@ is a book's title, %2$@ is the copy of the library whose Reading List holds it, and %3$@ is its place in that list, an identifier written without digit grouping.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reading list: %1$@ is only on %2$@'s list, at place %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lista de lectura: %1$@ solo está en la lista de %2$@, en el lugar %3$@."
          }
        }
      }
    },
    "Reading list: the order differs." : {
      "comment" : "First sentence of a Reading List difference found by Compare Libraries: the two copies hold the same books in a different order.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lista de lectura: el orden es distinto."
          }
        }
      }
    },
    "Reading list: “%@” is %@ in %@ and %@ in %@." : {
      "comment" : "A difference found by Compare Libraries. %1$@ is the name of a Reading List option, %2$@ is its value (on or off) in this copy, %3$@ is this copy, %4$@ is its value in the other copy, and %5$@ is the other copy.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reading list: “%1$@” is %2$@ in %3$@ and %4$@ in %5$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lista de lectura: “%1$@” es %2$@ en %3$@ y %4$@ en %5$@."
          }
        }
      }
    },
    "Reading position copied to clipboard" : {
      "comment" : "Announcement after Copy Reading Position put the reading position on the clipboard.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Posición de lectura copiada al portapapeles"
          }
        }
      }
    },
    "Reading positions are kept, but character offsets may shift slightly if the text changes." : {
      "comment" : "Last sentence of the Redo Text Extraction question.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Las posiciones de lectura se conservan, pero los desplazamientos de caracteres pueden cambiar un poco si cambia el texto."
          }
        }
      }
    },
    "Reading the audio took longer than %@ seconds; TextMouth stopped waiting." : {
      "comment" : "Error shown when reading an audio file took too long and TextMouth gave up waiting. %@ is the limit in seconds with a fraction, already formatted, such as 0.2.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La lectura del audio tardó más de %@ segundos; TextMouth dejó de esperar."
          }
        }
      }
    },
    "Reading the audio took longer than %lld minutes; TextMouth stopped waiting." : {
      "comment" : "Error shown when reading an audio file took too long and TextMouth gave up waiting. %lld is the limit in whole minutes.",
      "localizations" : {
