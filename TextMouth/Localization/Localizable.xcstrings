            "value" : "File identitas pustaka ada di Mac ini, tetapi indeksnya, %1$@, belum tiba dari %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il file di identità della libreria è su questo Mac, ma il suo indice, %@, non è arrivato tramite %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ライブラリの ID ファイルはこの Mac にありますが、そのインデックス%1$@が%2$@から届いていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관함의 식별 파일은 이 Mac에 있지만 색인 %1$@이(가) %2$@에서 도착하지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo de identidade da biblioteca está neste Mac, mas o índice dela, %1$@, não chegou de %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл идентификатора библиотеки есть на этом Mac, но её индекс, %1$@, не поступил через %2$@."
