    "passwordProtectedDocument.error.locked" : {
      "comment" : "First sentence of why a document could not be imported: it is locked with a password TextMouth does not have.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هذا المستند محمي بكلمة مرور."
          }
        },
        "bn" : {
