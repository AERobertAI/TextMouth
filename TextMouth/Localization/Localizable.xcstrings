    "bookExportDeepChapter.exportAsWrittenHint" : {
      "comment" : "The hint of the Export as Written button in the alert an export shows when a chapter nests too deeply.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يكتب هذا الفصل فقرات عادية من أسطره، ويصدّر كل ما عداه كالمعتاد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই অধ্যায়টি তার লাইনগুলোর সাধারণ অনুচ্ছেদ হিসেবে লেখে, এবং বাকি সবকিছু যথারীতি রপ্তানি করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Schreibt dieses Kapitel als einfache Absätze aus seinen Zeilen und exportiert alles andere wie gewohnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writes this chapter as plain paragraphs of its lines, and exports everything else as usual."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escribe este capítulo como párrafos simples con sus líneas y exporta todo lo demás como de costumbre."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "این فصل را به‌صورت پاراگراف‌های ساده از خطوطش می‌نویسد و بقیه را طبق معمول صادر می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Écrit ce chapitre en paragraphes simples de ses lignes, et exporte tout le reste comme d’habitude."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כותב את הפרק הזה כפסקאות פשוטות מהשורות שלו, ומייצא את כל השאר כרגיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस अध्याय को उसकी पंक्तियों के सादे अनुच्छेदों के रूप में लिखता है, और बाकी सब सामान्य रूप से निर्यात करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menulis bab ini sebagai paragraf biasa dari barisnya, dan mengekspor semua yang lain seperti biasa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scrive questo capitolo come semplici paragrafi delle sue righe ed esporta tutto il resto come al solito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "この章を行ごとの通常の段落として書き出し、それ以外はすべて通常どおり書き出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 챕터를 줄 단위의 일반 단락으로 작성하고 나머지는 평소처럼 내보냅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Schrijft de regels van dit hoofdstuk als gewone alinea's en exporteert al het andere zoals gewoonlijk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zapisuje ten rozdział jako zwykłe akapity z jego wierszy, a wszystko inne eksportuje jak zwykle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Grava este capítulo como parágrafos simples de suas linhas e exporta todo o resto normalmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Записывает эту главу обычными абзацами из её строк, а всё остальное экспортирует как обычно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Skriver det här kapitlet som vanliga stycken av sina rader och exporterar allt annat som vanligt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เขียนบทนี้เป็นย่อหน้าธรรมดาตามบรรทัด และส่งออกส่วนอื่นตามปกติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu bölümü satırlarından oluşan düz paragraflar olarak yazar ve geri kalan her şeyi her zamanki gibi dışa aktarır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Записує цей розділ звичайними абзацами з його рядків, а решту експортує як зазвичай."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس باب کو اس کی سطروں کے سادہ پیراگرافوں کی صورت میں لکھتا ہے، اور باقی سب کچھ معمول کے مطابق برآمد کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ghi chương này thành các đoạn văn thường gồm các dòng của nó, và xuất mọi thứ khác như bình thường."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "将此章节写成由其各行组成的普通段落，其余内容照常导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "將此章節寫成純段落（每行一段），其餘內容照常輸出。"
          }
        }
      }
    },
