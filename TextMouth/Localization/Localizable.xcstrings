    "bookExport.nestedTooDeeply.chapter" : {
      "comment" : "Why a book's text was not exported: a chapter of it nests quotes, lists, or emphasis too deeply. %1$@ is the chapter's number, an identifier written without digit grouping, and %2$@ the clause that says how deep, such as \"nests quotes, lists, or emphasis more than 128 levels deep\". \"Edit Text\" is a command.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "الفصل %1$@ من هذا الكتاب %2$@، ولا يستطيع TextMouth تصديره بأمان. اختر “تحرير النص”، وسطّح التداخل، واحفظ؛ ثم صدّر مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই বইয়ের অধ্যায় %1$@ %2$@, যা TextMouth নিরাপদে রপ্তানি করতে পারে না। “টেক্সট সম্পাদনা করুন” বেছে নিন, নেস্টিং সমতল করুন এবং সংরক্ষণ করুন; তারপর আবার রপ্তানি করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kapitel %1$@ dieses Buchs %2$@, und TextMouth kann das nicht sicher exportieren. Wähle „Text bearbeiten“, verringere die Verschachtelung und sichere; exportiere dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chapter %@ of this book %@, which TextMouth can't export safely. Choose Edit Text, flatten the nesting, and save; then export again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El capítulo %1$@ de este libro %2$@, y TextMouth no puede exportarlo con seguridad. Elige Editar texto, simplifica el anidamiento y guarda; después vuelve a exportar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فصل %1$@ این کتاب %2$@ و TextMouth نمی‌تواند آن را با ایمنی صادر کند. «ویرایش متن» را انتخاب کنید، ساختار تودرتو را ساده کنید و ذخیره کنید؛ سپس دوباره صادر کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le chapitre %1$@ de ce livre %2$@, ce que TextMouth ne peut pas exporter sans risque. Choisissez Modifier le texte, aplatissez l’imbrication et enregistrez ; puis exportez de nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "פרק %1$@ בספר הזה %2$@, ו-TextMouth לא יכול לייצא אותו בבטחה. בחר “ערוך טקסט”, צמצם את הקינון ושמור; ואז ייצא שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस पुस्तक का अध्याय %1$@ %2$@, जिसे TextMouth सुरक्षित रूप से निर्यात नहीं कर सकता। “टेक्स्ट संपादित करें” चुनें, नेस्टिंग को सपाट करें और सहेजें; फिर दोबारा निर्यात करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bab %1$@ buku ini %2$@, yang tidak dapat diekspor TextMouth dengan aman. Pilih Edit Teks, ratakan tingkatnya, lalu simpan; kemudian ekspor lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il capitolo %1$@ di questo libro %2$@, e TextMouth non può esportarlo in sicurezza. Scegli Modifica testo, appiattisci l’annidamento e salva; poi esporta di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このブックの第%1$@章は%2$@。TextMouth では安全に書き出せません。「テキストを編集」を選び、入れ子を解消して保存してから、もう一度書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 책의 챕터 %1$@은(는) %2$@. TextMouth는 안전하게 내보낼 수 없습니다. 텍스트 편집을 선택하고 중첩을 평탄화한 다음 저장한 후 다시 내보내십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hoofdstuk %1$@ van dit boek %2$@, wat TextMouth niet veilig kan exporteren. Kies Wijzig tekst, maak de nesting plat en bewaar; exporteer daarna opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rozdział %1$@ tej książki %2$@, czego TextMouth nie może bezpiecznie wyeksportować. Wybierz Edytuj tekst, spłaszcz zagnieżdżenie i zachowaj zmiany, a potem wyeksportuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O capítulo %1$@ deste livro %2$@, e o TextMouth não consegue exportar com segurança. Escolha Editar texto, desfaça o aninhamento e salve; depois exporte de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Глава %1$@ этой книги %2$@, и TextMouth не может безопасно её экспортировать. Выберите «Изменить текст», уберите вложенность, сохраните и экспортируйте снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kapitel %1$@ i den här boken %2$@, vilket TextMouth inte kan exportera säkert. Välj Redigera text, platta ut nästlingen och spara. Exportera sedan igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "บทที่ %1$@ ของหนังสือเล่มนี้ %2$@ ซึ่ง TextMouth ส่งออกอย่างปลอดภัยไม่ได้ เลือก แก้ไขข้อความ แก้การซ้อนให้เรียบ แล้วบันทึก จากนั้นส่งออกอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu kitabın %1$@. bölümü %2$@; TextMouth bunu güvenle dışa aktaramaz. Metni Düzenle'yi seçin, iç içe geçmeyi düzleştirin ve kaydedin; sonra yeniden dışa aktarın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Розділ %1$@ цієї книги %2$@, тому TextMouth не може безпечно експортувати це. Виберіть «Редагувати текст», вирівняйте вкладеність і збережіть, а потім експортуйте знову."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس کتاب کے باب %1$@ میں %2$@، جسے TextMouth محفوظ طریقے سے برآمد نہیں کر سکتا۔ “متن میں ترمیم کریں” منتخب کریں، تہہ بندی کو ہموار کریں اور محفوظ کریں؛ پھر دوبارہ برآمد کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chương %1$@ của sách này %2$@, nên TextMouth không thể xuất an toàn. Hãy chọn Sửa văn bản, làm phẳng phần lồng ghép, lưu, rồi xuất lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此图书的第 %1$@ 章 %2$@，TextMouth 无法安全导出。请选取“编辑文本”，将嵌套展平并存储，然后再次导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此書的第 %1$@ 章中，%2$@，TextMouth 無法安全輸出。請選擇「編輯文字」，減少巢狀層級並儲存，然後再次輸出。"
          }
        }
      }
    },
