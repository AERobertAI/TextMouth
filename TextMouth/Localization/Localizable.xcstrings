    "recordingFailure.stoppedUnexpectedly" : {
      "comment" : "Error in the Record window when recording stopped by itself because capture failed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "توقف التسجيل لأن الميكروفون أبلغ عن مشكلة. تم الاحتفاظ بما سُجّل."
