      }
    },
    "The saved copy at %@ keeps the old data." : {
      "comment" : "Last sentence of what Rebuild Library Index does: where the old data stays. %@ is the saved copy's path.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La copia guardada en %@ conserva los datos anteriores."
