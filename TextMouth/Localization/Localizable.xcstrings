          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The passage as the book has it, characters %1$@ to %2$@ of chapter %3$@:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
