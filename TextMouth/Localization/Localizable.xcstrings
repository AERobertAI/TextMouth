          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sie hat dieselben Bücher, Positionen, Lesezeichen, dieselbe Leseliste und dieselben Ordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It has the same books, places, bookmarks, reading list, and folders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tiene los mismos libros, lugares, marcadores, lista de lectura y carpetas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب‌ها، مکان‌ها، نشانک‌ها، فهرست مطالعه و پوشه‌های یکسانی دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elle a les mêmes livres, positions, signets, liste de lecture et dossiers."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "יש בו אותם ספרים, מקומות, סימניות, רשימת קריאה ותיקיות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसमें वही पुस्तकें, स्थान, बुकमार्क, रीडिंग लिस्ट और फ़ोल्डर हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Isinya sama: buku, posisi, markah, daftar bacaan, dan folder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Libri, posizioni, segnalibri, elenco di lettura e cartelle coincidono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブック、場所、ブックマーク、リーディングリスト、フォルダがすべて同じです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책, 위치, 북마크, 읽기 목록, 폴더가 동일합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die heeft dezelfde boeken, leesposities, bladwijzers, leeslijst en mappen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ma te same książki, miejsca, zakładki, listę czytelniczą i foldery."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tem os mesmos livros, posições, marcadores, lista de leitura e pastas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В ней те же книги, позиции чтения, закладки, список для чтения и папки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Den har samma böcker, platser, bokmärken, läslista och mappar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "มีหนังสือ ตำแหน่ง ที่คั่นหน้า รายการอ่าน และโฟลเดอร์เหมือนกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aynı kitaplara, yerlere, yer imlerine, okuma listesine ve klasörlere sahip."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
