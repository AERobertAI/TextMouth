    },
    "Title for a chapter marker at the cursor. One already there is renamed." : {
      "comment" : "Explains the title field of the audio editor's Insert Chapter Marker sheet."
    },
    "Too long to keep for pasting. To move it, paste right after cutting." : {
      "comment" : "Said by the audio editor's Paste when the audio cut was too long to keep for pasting."
    },
    "Track" : {
      "comment" : "Label of the pop-up that chooses which audio track of a book to edit."
    },
    "Trim End" : {
      "comment" : "Name of an edit, as the Undo and Redo menu items and VoiceOver say it after \"Undo\" or \"Redo\": trimming the end of the audio."
    },
    "Trim Silence at Both Ends" : {
      "comment" : "Title of a premade audio filter preset: removes the silence at the start and at the end of the audio."
    },
    "Trim Start" : {
      "comment" : "Name of an edit, as the Undo and Redo menu items and VoiceOver say it after \"Undo\" or \"Redo\": trimming the start of the audio."
    },
    "Trim to Selection" : {
      "comment" : "Name of an edit, as the Undo and Redo menu items say it after \"Undo\" or \"Redo\": the audio editor's Trim to Selection, which trims the start and the end together."
    },
    "Trimmed to the selection: %@ kept." : {
      "comment" : "Said as the audio editor's Trim to Selection trims. %@ is the length kept, in words."
    },
    "Try again once the book has downloaded." : {
      "comment" : "Ends a message saying a file of the book is only in the cloud and isn't on this Mac yet: what to do about it."
    },
    "Type a chain of filters." : {
      "comment" : "Shown under a filter preset's chain field while it is empty."
    },
    "Type a time, such as 12:04.3, 1:02:03, or 75.5." : {
      "comment" : "Shown or spoken when a time field holds nothing, or something that is not a time (Go to Time, Insert Silence, the reader's Go to Time). The examples are clock times and seconds."
    },
    "Undid %@." : {
      "comment" : "Said as the audio editor's Undo undoes an edit. %@ is the edit's name, such as \"Cut 2.5 Seconds\"."
    },
    "Undo %@" : {
      "comment" : "Title of the audio editor's Undo button. %@ is the name of the edit it would undo, such as \"Cut 2.5 Seconds\"."
    },
    "Undo or redo back to the audio as last saved." : {
      "comment" : "Ends a message saying the edits need an original audio that is gone: only undoing or redoing back to the audio as last saved helps."
    },
    "Undoes every edit, back to the original; Redo brings them back." : {
      "comment" : "Hint of the audio editor's Revert to Original button. \"Redo\" is the name of a command."
    },
    "Undoes the newest edit." : {
      "comment" : "Hint of the audio editor's Undo button."
    },
    "Unknown Length" : {
      "comment" : "A length of audio that is no length (not a finite number of seconds), as a menu item's title-cased words, such as the Undo item's \"Cut Unknown Length\"."
    },
    "Use ffmpeg for filters" : {
      "comment" : "Label of the switch in Storage settings (Audio Editing) that lets the audio editor's filters run through an installed ffmpeg program. ffmpeg is the program's name."
    },
    "Use the global setting (%@)" : {
      "comment" : "A choice of the Open the next book in pop-up button in Feed Info and Folder Settings: do as Settings says. %@ is the name of the choice Settings has now, such as This Window.\nThe first choice of the Audio Info pop-up for a book's original audio: follow the global setting. %@ is that setting's name, such as \"Keep\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usar el ajuste general (%@)"
          }
        }
      }
    },
    "When a book ends" : {
      "comment" : "Label of the Reading List's options bar pop-up button choosing what a book opened from the list does when it ends: play the book below, play the book above, or stop.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Al terminar un libro"
          }
        }
      }
    },
    "Which track of %@ do you want to edit?" : {
      "comment" : "Question asked before editing a book of several audio tracks. %@ is the book's title."
    },
    "Whole File" : {
      "comment" : "Choice in the audio editor's Apply Filter sheet: filter all of the audio."
    },
    "With \"%@\", Play on a finished book says it is finished; with \"%@\", Play starts it again from the beginning." : {
      "comment" : "Caption under the When book ends picker in Settings, Playback. %1$@ and %2$@ are the names of two of the picker's choices, as the picker shows them (Stop, and Stop, and Play Starts Over); Play is the reader's Play button.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "With \"%1$@\", Play on a finished book says it is finished; with \"%2$@\", Play starts it again from the beginning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con “%1$@”, Play en un libro terminado avisa que ya está terminado; con “%2$@”, Play lo vuelve a empezar desde el principio."
          }
        }
      }
    },
    "Writes chapter markers and markers beside the audio, in an Audacity label file of the same name." : {
      "comment" : "Hint of the Also write the markers as Audacity labels checkbox. Audacity is the name of an audio editing program."
    },
    "Your library is empty. Add to Library adds a book." : {
      "comment" : "The only row of an empty library. \"Add to Library\" is the name of the button that adds a book, so keep it the same as that button's label."
    },
    "fading out" : {
      "comment" : "The sleep timer's state as VoiceOver reads it after \"Sleep timer:\" while the timer fades the sound out. Lowercase, since it follows a colon.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "bajando el volumen"
          }
        }
      }
    },
    "ffmpeg couldn't be started. Check it is installed, or turn off Use ffmpeg in Storage settings." : {
      "comment" : "Problem said when the ffmpeg program can't be started. \"Use ffmpeg\" is the name of a switch in the Storage settings."
    },
    "ffmpeg couldn't run the filters: %@" : {
      "comment" : "Problem said when the ffmpeg program refused a filter chain or the audio. %@ is ffmpeg's own words, in English."
    },
    "ffmpeg isn't installed; TextMouth's own filters are used." : {
      "comment" : "Shown in Storage settings (Audio Editing) when no ffmpeg program is installed. ffmpeg is the program's name."
    },
    "give a frequency below half the audio's sample rate, %@ Hz" : {
      "comment" : "What a frequency option of a filter accepts, said at the end of a refusal such as \"The highpass filter's frequency can't be “x”: <this>.\" Written without its full stop. %@ is half the audio's sample rate, in hertz, written without digit grouping."
    },
    "give a narrower width, since this one makes no usable filter at %@ Hz" : {
      "comment" : "What a width option of a filter accepts, said at the end of a refusal such as \"The equalizer filter's width can't be “x”: <this>.\" Written without its full stop. %@ is the filter's frequency in hertz, already written."
    },
    "give a number from %@ to %@" : {
      "comment" : "What a number option of a filter accepts, said at the end of a refusal such as \"The volume filter's volume can't be “x”: <this>.\" Written without its full stop. %1$@ is the lowest number allowed and %2$@ the highest, already written.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "give a number from %1$@ to %2$@"
          }
        }
      }
    },
    "give a number, such as 0.5, or decibels, such as -6dB" : {
      "comment" : "What a volume option of a filter accepts, said at the end of a refusal such as \"The volume filter's volume can't be “x”: <this>.\" Written without its full stop. The examples are filter syntax."
    },
    "give a time such as 2.5, 250ms, or 0:01:30" : {
      "comment" : "What a time option of a filter accepts, said at the end of a refusal such as \"The afade filter's duration can't be “x”: <this>.\" Written without its full stop. The examples are filter syntax."
    },
    "give a whole number from %@ to %@" : {
      "comment" : "What a whole-number option of a filter accepts, said at the end of a refusal such as \"The afade filter's duration can't be “x”: <this>.\" Written without its full stop. %1$@ is the lowest number allowed and %2$@ the highest, already written.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "give a whole number from %1$@ to %2$@"
          }
        }
      }
    },
    "give one of %@" : {
      "comment" : "What a choice option of a filter accepts, said at the end of a refusal such as \"The afade filter's type can't be “x”: <this>.\" Written without its full stop. %@ is the allowed values, filter syntax, as a list such as \"in, out\"."
    },
    "give true or false" : {
      "comment" : "What an on-or-off option of a filter accepts, said at the end of a refusal such as \"The loudnorm filter's dual_mono can't be “x”: <this>.\" Written without its full stop."
    },
    "in chapter %@: %@" : {
      "comment" : "A part of the audio editor's status line: the chapter the cursor is in. %1$@ is the chapter's number, an identifier written without digit grouping, and %2$@ its title.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "in chapter %1$@: %2$@"
          }
        }
      }
    },
    "min" : {
      "comment" : "Short for minutes, shown after the sleep timer sheet's custom minutes field. Hidden from VoiceOver.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "min"
          }
        }
      }
    },
    "none" : {
      "comment" : "Said in place of a list of filters or options when there are none, inside a filter message such as \"Its options are none.\""
    },
    "selection from %@ to %@, %@" : {
      "comment" : "A part of the audio editor's status line: the selection. %1$@ is its start and %2$@ its end, as clock times such as \"11:58\", and %3$@ its length in words.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "selection from %1$@ to %2$@, %3$@"
          }
        }
      }
    },
    "stops at the end of the book" : {
      "comment" : "The state of a sleep timer set to End of book, as VoiceOver reads it after \"Sleep timer:\". Lowercase, since it follows a colon.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "se detiene al final del libro"
          }
        }
      }
    },
    "stops at the end of this heading" : {
      "comment" : "The state of a sleep timer set to End of heading, as VoiceOver reads it after \"Sleep timer:\". Lowercase, since it follows a colon.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "se detiene al final de este encabezado"
          }
        }
      }
    },
    "unknown length" : {
      "comment" : "A length of audio that is no length (not a finite number of seconds), said in a sentence, such as \"Cut unknown length.\""
    },
    "“%@” is recording. Stop or discard it with Clear Selection, then quit." : {
      "comment" : "Said in an audio editor when TextMouth can't quit because a punch-in records there. %@ is the book's title. \"Clear Selection\" is the name of a command."
    },
    "“%@” is still working. Quit once the change is done." : {
      "comment" : "Said in an audio editor when TextMouth can't quit because its work is under way. %@ is the book's title."
    },
    "“%@” isn't a filter's name." : {
      "comment" : "Problem found in a typed filter chain: the text before an equals sign is not a filter's name. %@ is that text."
    },
    "“%@” uses %@ samples, which TextMouth can't play." : {
      "comment" : "Refuses an audio file whose samples TextMouth can't decode, which is not damaged. %1$@ is the file's name and %2$@ its sample form, such as \"64-bit integer\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” uses %2$@ samples, which TextMouth can't play."
          }
        }
      }
    }
  },
  "version" : "1.0"
}