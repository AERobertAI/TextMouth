    "librarySearch.matchGone" : {
      "comment" : "Announcement when a search match is no longer in the book's text.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم تعد تلك المطابقة في نص الكتاب. ابحث مرة أخرى للعثور عليها."
          }
