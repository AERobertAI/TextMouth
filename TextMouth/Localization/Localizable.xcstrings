    "audioEditor.silenceExplanation" : {
      "comment" : "Explains the silence length field of the audio editor's Insert Silence sheet. The examples are typed times.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "طول الصمت المراد إدراجه: ثوانٍ (2.5) أو دقائق وثوانٍ (1:30)."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সন্নিবেশ করার নীরবতার দৈর্ঘ্য: সেকেন্ড (2.5) অথবা মিনিট ও সেকেন্ড (1:30)।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Länge der einzufügenden Stille: Sekunden (2.5) oder Minuten und Sekunden (1:30)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Length of silence to insert: seconds (2.5) or minutes and seconds (1:30)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Duración del silencio que se insertará: segundos (2.5) o minutos y segundos (1:30)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "طول سکوت برای درج: ثانیه (2.5) یا دقیقه و ثانیه (1:30)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Durée du silence à insérer : secondes (2.5) ou minutes et secondes (1:30)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אורך השקט להוספה: שניות (2.5) או דקות ושניות (1:30)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "डालने के लिए मौन की अवधि: सेकंड (2.5) या मिनट और सेकंड (1:30)।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Durasi senyap yang disisipkan: detik (2.5) atau menit dan detik (1:30)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Durata del silenzio da inserire: secondi (2.5) oppure minuti e secondi (1:30)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "挿入する無音の長さ：秒（2.5）、または分と秒（1:30）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "삽입할 무음의 길이: 초(2.5) 또는 분과 초(1:30)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lengte van de in te voegen stilte: seconden (2.5) of minuten en seconden (1:30)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Długość ciszy do wstawienia: sekundy (2.5) albo minuty i sekundy (1:30)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Duração do silêncio a inserir: segundos (2.5) ou minutos e segundos (1:30)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Длина вставляемой тишины: секунды (2.5) или минуты и секунды (1:30)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Längd på tystnaden som ska infogas: sekunder (2.5) eller minuter och sekunder (1:30)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ความยาวของความเงียบที่จะแทรก: วินาที (2.5) หรือนาทีและวินาที (1:30)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eklenecek sessizliğin uzunluğu: saniye (2.5) veya dakika ve saniye (1:30)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Тривалість тиші для вставлення: секунди (2.5) або хвилини й секунди (1:30)."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "داخل کی جانے والی خاموشی کی لمبائی: سیکنڈ (2.5) یا منٹ اور سیکنڈ (1:30)۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Độ dài khoảng lặng cần chèn: giây (2.5) hoặc phút và giây (1:30)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "要插入的静音长度：秒（2.5）或分与秒（1:30）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "要插入的靜音長度：秒數（2.5），或分鐘與秒數（1:30）。"
          }
        }
      }
    },
    "audioEditor.silenceTooLong" : {
      "comment" : "Problem shown when the silence to insert in the audio editor is longer than a day.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يمكن أن يستمر الصمت يومًا واحدًا على الأكثر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "নীরবতা সর্বোচ্চ একদিন হতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stille darf höchstens einen Tag dauern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silence can last at most a day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El silencio puede durar como máximo un día."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سکوت حداکثر می‌تواند یک روز باشد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un silence ne peut pas durer plus d’un jour."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "שקט יכול להימשך יום אחד לכל היותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "मौन अधिकतम एक दिन का हो सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Senyap paling lama satu hari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il silenzio può durare al massimo un giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "無音は最長で1日までです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "무음은 최대 하루까지 가능합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stilte mag maximaal een dag duren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cisza może trwać najwyżej dobę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O silêncio pode durar no máximo um dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Тишина может длиться не более суток."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
