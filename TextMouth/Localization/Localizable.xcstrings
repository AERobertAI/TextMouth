    "libraryComparison.panelMessage" : {
      "comment" : "Message of the folder panel in which the listener chooses the other copy of the library to compare.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اختر المجلد الذي يحتوي على نسخة أخرى من هذه المكتبة. لن يتغير أي شيء فيه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই লাইব্রেরির আরেকটি কপি যে ফোল্ডারে আছে সেটি বেছে নিন। এর কিছুই পরিবর্তন করা হবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wähle den Ordner mit einer weiteren Kopie dieser Bibliothek. Nichts darin wird geändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the folder that holds another copy of this library. Nothing in it is changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige la carpeta que contiene otra copia de esta biblioteca. No se cambia nada en ella."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پوشه‌ای را انتخاب کنید که نسخه‌ی دیگری از این کتابخانه را دارد. چیزی در آن تغییر نمی‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisissez le dossier qui contient une autre copie de cette bibliothèque. Rien n’y sera modifié."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בחר את התיקייה שמכילה עותק אחר של הספרייה הזו. דבר בה לא ישתנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "वह फ़ोल्डर चुनें जिसमें इस लाइब्रेरी की दूसरी कॉपी है। उसमें कुछ नहीं बदला जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pilih folder yang berisi salinan lain pustaka ini. Tidak ada yang diubah di dalamnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scegli la cartella che contiene un’altra copia di questa libreria. Nulla al suo interno verrà modificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このライブラリの別のコピーが入っているフォルダを選択してください。中のものは変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 보관함의 다른 사본이 있는 폴더를 선택하십시오. 폴더의 내용은 변경되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kies de map met een andere kopie van deze bibliotheek. Er wordt niets in gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wybierz folder zawierający inną kopię tej biblioteki. Nic w nim nie zostanie zmienione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escolha a pasta que contém outra cópia desta biblioteca. Nada nela é alterado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Выберите папку с другой копией этой библиотеки. В ней ничего не изменится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Välj mappen som innehåller en annan kopia av det här biblioteket. Inget i den ändras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เลือกโฟลเดอร์ที่มีสำเนาอื่นของไลบรารีนี้ ข้อมูลในโฟลเดอร์จะไม่ถูกเปลี่ยนแปลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu kitaplığın başka bir kopyasını içeren klasörü seçin. İçindeki hiçbir şey değiştirilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Виберіть папку з іншою копією цієї бібліотеки. Нічого в ній не буде змінено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "وہ فولڈر منتخب کریں جس میں اس لائبریری کی دوسری کاپی ہو۔ اس میں کچھ تبدیل نہیں کیا جاتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chọn thư mục chứa một bản sao khác của thư viện này. Không có gì trong đó bị thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "选取存放此资料库另一个副本的文件夹。其中的内容不会有任何更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選擇存放這個書庫另一份副本的檔案夾。其中的內容不會更改。"
          }
        }
      }
    },
