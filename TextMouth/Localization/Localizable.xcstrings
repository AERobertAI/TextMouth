    "folderOperationConflict.nameInUse.capitalization" : {
      "comment" : "Second sentence of the error about a folder name that is taken, added when the two names are spelled differently, in capital letters or in how an accent is stored.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "الأسماء التي لا تختلف إلا في حالة الأحرف أو ترميز العلامات المميزة تشير إلى المجلد نفسه على هذا القرص."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "শুধু বড়-ছোট হাতের অক্ষর বা অ্যাকসেন্ট এনকোডিংয়ে ভিন্ন নামগুলো এই ডিস্কে একই ফোল্ডার বোঝায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Namen, die sich nur in der Groß-/Kleinschreibung oder der Codierung von Akzenten unterscheiden, bezeichnen auf diesem Datenträger denselben Ordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Names that differ only in capitalization or accent encoding refer to the same folder on this disk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los nombres que solo difieren en mayúsculas o en la codificación de los acentos se refieren a la misma carpeta en este disco."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نام‌هایی که فقط در بزرگی و کوچکی حروف یا نحوه‌ی ذخیره‌ی نشانه‌های آوایی تفاوت دارند، در این دیسک به یک پوشه اشاره می‌کنند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Des noms qui ne diffèrent que par les majuscules ou le codage des accents désignent le même dossier sur ce disque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "שמות שנבדלים רק ברישיות או בקידוד של סימנים דיאקריטיים מתייחסים לאותה תיקייה בדיסק הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "जो नाम केवल अक्षरों के बड़े-छोटे रूप या उच्चारण-चिह्न के एन्कोडिंग में भिन्न हैं, वे इस डिस्क पर एक ही फ़ोल्डर को दर्शाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nama yang hanya berbeda dalam kapitalisasi atau pengodean aksen merujuk ke folder yang sama di disk ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I nomi che differiscono solo per maiuscole o per la codifica degli accenti si riferiscono alla stessa cartella su questo disco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "大文字と小文字の違いや、アクセントの符号化だけが異なる名前は、このディスク上では同じフォルダを指します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "대소문자나 악센트 부호 인코딩만 다른 이름은 이 디스크에서 같은 폴더를 가리킵니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Namen die alleen verschillen in hoofdletters of in de codering van accenten, verwijzen op deze schijf naar dezelfde map."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nazwy różniące się tylko wielkością liter lub kodowaniem akcentów oznaczają ten sam folder na tym dysku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nomes que diferem apenas em maiúsculas ou na codificação dos acentos se referem à mesma pasta neste disco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Имена, которые различаются только регистром или записью диакритических знаков, обозначают на этом диске одну и ту же папку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Namn som bara skiljer sig i stor eller liten bokstav eller i hur accenter kodas syftar på samma mapp på den här disken."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ชื่อที่ต่างกันเพียงตัวพิมพ์เล็กใหญ่หรือการเข้ารหัสตัวกำกับเสียง จะหมายถึงโฟลเดอร์เดียวกันบนดิสก์นี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yalnızca büyük/küçük harf veya aksan kodlaması bakımından farklı olan adlar bu diskte aynı klasöre karşılık gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Назви, що відрізняються лише регістром або способом збереження діакритичних знаків, позначають ту саму папку на цьому диску."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جن ناموں میں صرف بڑے چھوٹے حروف یا اعراب کی انکوڈنگ کا فرق ہو، وہ اس ڈسک پر ایک ہی فولڈر کی طرف اشارہ کرتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Những tên chỉ khác nhau ở chữ hoa chữ thường hoặc cách mã hóa dấu đều trỏ đến cùng một thư mục trên ổ đĩa này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "仅大小写或重音编码不同的名称，在此磁盘上指向同一个文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "僅大小寫或重音編碼不同的名稱，在這個磁碟上指的是同一個檔案夾。"
          }
        }
      }
    },
    "folderOperationConflict.namesCollide" : {
      "comment" : "Error shown when two folders moved together would land on the same name. %1$@ and %2$@ are the two folders' names, in straight double quotes. %3$@ is where they go: a folder's location in straight double quotes, or the name of the library's top level.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يمكن نقل المجلدين %1$@ و%2$@ معًا إلى %3$@: اسماهما يعنيان المجلد نفسه على هذا القرص."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফোল্ডার %1$@ ও %2$@ দুটিকে একসঙ্গে %3$@-এ সরানো যায় না: এই ডিস্কে এগুলোর নাম একই ফোল্ডার বোঝায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Ordner %1$@ und %2$@ können nicht beide nach %3$@ verschoben werden: Ihre Namen bezeichnen auf diesem Datenträger denselben Ordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The folders %@ and %@ can't both move into %@: their names mean the same folder on this disk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Las carpetas %1$@ y %2$@ no pueden moverse juntas a %3$@: sus nombres se refieren a la misma carpeta en este disco."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پوشه‌های %@ و %@ را نمی‌توان هر دو به %@ منتقل کرد: نام‌هایشان در این دیسک به یک پوشه اشاره می‌کنند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les dossiers %@ et %@ ne peuvent pas être déplacés tous les deux dans %@ : leurs noms désignent le même dossier sur ce disque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אי אפשר להעביר את התיקיות %1$@ ו-%2$@ גם יחד אל %3$@: השמות שלהן מציינים את אותה תיקייה בדיסק הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ोल्डर %1$@ और %2$@ दोनों %3$@ में नहीं जा सकते: इस डिस्क पर उनके नामों का मतलब एक ही फ़ोल्डर है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Folder %@ dan %@ tidak dapat dipindahkan bersamaan ke %@: nama keduanya berarti folder yang sama di disk ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le cartelle %@ e %@ non possono essere spostate entrambe in %@: i loro nomi indicano la stessa cartella su questo disco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フォルダ%1$@と%2$@は、名前がこのディスク上で同じフォルダを指すため、両方を%3$@に移動することはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "폴더 %1$@ 및 %2$@은(는) 함께 %3$@ 안으로 이동할 수 없습니다. 이 디스크에서 두 이름이 같은 폴더를 뜻하기 때문입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De mappen %@ en %@ kunnen niet allebei naar %@ worden verplaatst: hun namen verwijzen op deze schijf naar dezelfde map."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Foldery %1$@ i %2$@ nie mogą jednocześnie trafić do: %3$@, ponieważ ich nazwy oznaczają ten sam folder na tym dysku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "As pastas %1$@ e %2$@ não podem ser movidas juntas para %3$@: os nomes delas significam a mesma pasta neste disco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Папки %1$@ и %2$@ нельзя переместить в %3$@ вместе: на этом диске их имена обозначают одну и ту же папку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mapparna %@ och %@ kan inte båda flyttas till %@: deras namn syftar på samma mapp på den här disken."
          }
        },
        "th" : {
