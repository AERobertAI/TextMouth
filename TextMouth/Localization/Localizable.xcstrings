    },
    "The original file was kept." : {
      "comment" : "Sentence of an import's notice or alert: the original file was kept because something was left out of the book or the batch.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Originaldatei wurde behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se conservó el archivo original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le fichier d’origine a été conservé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il file originale è stato conservato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo original foi mantido."
          }
        },
        "ru" : {
          "stringUnit" : {
