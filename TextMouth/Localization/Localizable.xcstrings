{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@" : {
      "comment" : "Joins two whole sentences into one text. %1$@ is the first sentence and %2$@ the second. English puts a space between them; Japanese and Chinese join sentences with no space at all, so change only the separator.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ adds a bookmark at the current position." : {
      "comment" : "Help under \"No bookmarks yet.\" in the Bookmarks list. %@ is the keyboard shortcut that adds a bookmark, spelled out in words, such as Command + B.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ agrega un marcador en la posición actual."
          }
        }
      }
    },
    "%@ adds one at the current position." : {
      "comment" : "Help under \"No bookmarks yet.\" in the Bookmarks list, when the add command has no keyboard shortcut. %@ is the name of the Add Bookmark button above the list.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ agrega uno en la posición actual."
          }
        }
      }
    },
    "%@ has it in the menus, and no shortcut may take it" : {
      "comment" : "The reason, said after \"not recorded\", why a key cannot be a shortcut: a command of the Mac's own menus uses it. %@ is that command's name, such as Quit TextMouth or Copy. Lower case in English, since it follows a colon."
    },
    "%@ has its default, %@" : {
      "comment" : "Said in the row of a keyboard shortcut action that has lost its default key to another action. %1$@ is the name of the action that now has the key, and %2$@ is the key in words, such as \"Shift + Command + T\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has its default, %2$@"
          }
        }
      }
    },
    "%@ is already in the reading list." : {
      "comment" : "VoiceOver announcement when Add to Reading List added nothing: the one book selected is on the list already. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ya está en la lista de lectura."
          }
        }
      }
    },
    "%@ isn't in the reading list." : {
      "comment" : "VoiceOver announcement when Remove from Reading List took nothing off: the one book selected is not on the list. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no está en la lista de lectura."
          }
        }
      }
    },
    "%@ not recorded for %@: %@" : {
      "comment" : "Announced by VoiceOver when a key cannot become a keyboard shortcut. %1$@ is the key in words, %2$@ is the action's name, and %3$@ is the reason, which starts in lower case.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ not recorded for %2$@: %3$@"
          }
        }
      }
    },
    "%@ now waits before %@, in case it is pressed twice." : {
      "comment" : "Announced by VoiceOver after a key's double press was given to an action: the key's single press now waits a moment before it acts, in case a second press follows. %1$@ is the key in words, such as \"J\", and %2$@ is the name of the action of its single press.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ now waits before %2$@, in case it is pressed twice."
          }
        }
      }
    },
    "%@ or %@" : {
      "comment" : "Joins two keyboard shortcuts of one action with \"or\", as in \"Space or K\". %1$@ is the shortcuts so far and %2$@ the next one.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ or %2$@"
          }
        }
      }
    },
    "%@ remaining" : {
      "comment" : "The sleep timer's state as VoiceOver reads it after \"Sleep timer:\" while it counts down. %@ is the time left in minutes and seconds, such as 4:59.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "quedan %@"
          }
        }
      }
    },
    "%@ reset to default: %@" : {
      "comment" : "Announced by VoiceOver after a keyboard shortcut action was given its default keys again. %1$@ is the action's name and %2$@ is its keys in words, such as \"Option + Shift + Command + B\", or \"No shortcut\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ reset to default: %2$@"
          }
        }
      }
    },
    "%@ seconds" : {
      "comment" : "A length of time in seconds with one decimal digit, such as \"0.5 seconds\". %@ is the already formatted number."
    },
    "%@ twice" : {
      "comment" : "A keyboard shortcut that is its key pressed twice quickly, as spoken or shown. %@ is the shortcut, such as \"W\" or \"Command + I\"."
    },
    "%@ works in %@." : {
      "comment" : "Announced by VoiceOver after the listener chose where a keyboard shortcut works. %1$@ is the action's name and %2$@ names the windows, such as \"every window\" or \"Library windows\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ works in %2$@."
          }
        }
      }
    },
    "%@, recorded for %@" : {
      "comment" : "Announced by VoiceOver after a key became a keyboard shortcut. %1$@ is the key in words, such as \"Shift + R\" or \"W twice\", and %2$@ is the action's name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, recorded for %2$@"
          }
        }
      }
    },
    "%@." : {
      "comment" : "Ends a sentence with its full stop. %@ is the sentence without it. Chinese and Japanese use their own full stop here."
    },
    "%@: %@" : {
      "comment" : "A name, a colon, and its value, such as a keyboard shortcut action's name and its keys, or a control's label and its value. %1$@ is the name and %2$@ is the value.\nThe name of a keyboard shortcut action with the name of its group before it, such as an audio editor action. %1$@ is the group's name and %2$@ the action's own name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@"
          }
        }
      }
    },
    "%lld articles" : {
      "comment" : "A count of news articles in a list, counted beside books. %lld is the number of articles.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld article"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld articles"
                }
              }
            }
          }
        }
      }
    },
    "%lld bookmarks" : {
      "comment" : "A count of bookmarks standing alone, as Speak Info and a feed item's row say it. %lld is the number of bookmarks.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld bookmark"
                }
