    "TextMouth has no braille table named “%@”." : {
      "comment" : "Why a braille translation was refused: no braille table has this name. %@ is the table's name as liblouis or macOS gives it.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
