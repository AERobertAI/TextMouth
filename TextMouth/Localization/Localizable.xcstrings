          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ بیش از حد تو در تو است"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ est imbriqué trop profondément"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ מקונן ברמות רבות מדי"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ बहुत गहराई तक नेस्टेड है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ bertingkat terlalu dalam"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ è annidato troppo in profondità"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@は入れ子が深すぎます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@의 중첩이 너무 깊음"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ is te diep genest"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ma zbyt głębokie zagnieżdżenie"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ tem aninhamento profundo demais"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@: слишком глубокая вложенность"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ nästlar för djupt"
