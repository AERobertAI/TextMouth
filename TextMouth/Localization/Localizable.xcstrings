    "bookTextEdit.nestedTooDeeply.chapterShows" : {
      "comment" : "Reason after a colon, for an audiobook whose edited text nests one chapter too deeply; begins in lower case. %1$@ is the chapter's number, an identifier written without digit grouping; %2$@ is a clause such as \"nests more than 20 levels deep\", written by another part of the app.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فصله %1$@ %2$@، ولا يستطيع TextMouth قراءته بأمان. بسّط بنيته واحفظ مرة أخرى، أو تراجع عن التغيير، فيظهر النص."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এর অধ্যায় %1$@ %2$@, যা TextMouth নিরাপদে পড়তে পারে না। এটি সমতল করে আবার সংরক্ষণ করুন, বা পরিবর্তনটি পূর্বাবস্থায় ফেরান, তাহলে টেক্সট দেখা যাবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "sein Kapitel %1$@ %2$@, was TextMouth nicht sicher lesen kann. Verringere die Verschachtelung und sichere erneut oder mache die Änderung rückgängig, dann wird der Text angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "its chapter %@ %@, which TextMouth can't read safely. Flatten it and save again, or undo the change, and the text shows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "su capítulo %1$@ %2$@, algo que TextMouth no puede leer de forma segura. Simplifícalo y guarda de nuevo, o deshaz el cambio, y el texto se mostrará."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فصل %1$@ آن %2$@ و TextMouth نمی‌تواند آن را با ایمنی بخواند. آن را ساده کنید و دوباره ذخیره کنید، یا تغییر را واگرد کنید، تا متن نمایش داده شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "son chapitre %@ %@, ce que TextMouth ne peut pas lire en toute sécurité. Réduisez cette imbrication et enregistrez à nouveau, ou annulez la modification, et le texte s’affiche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הפרק %1$@ שלו %2$@, ש-TextMouth לא יכול לקרוא בבטחה. צמצם את הקינון ושמור שוב, או בטל את השינוי, והטקסט יוצג."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "उसका अध्याय %1$@ %2$@, जिसे TextMouth सुरक्षित रूप से नहीं पढ़ सकता। उसे सरल करके फिर से सहेजें, या बदलाव पूर्ववत करें, तब टेक्स्ट दिखेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "bab %1$@ %2$@, yang tidak dapat dibaca TextMouth dengan aman. Ratakan lalu simpan lagi, atau urungkan perubahan, maka teks akan tampil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "il suo capitolo %@ %@, e TextMouth non può leggerlo in sicurezza. Appiattiscilo e salva di nuovo, oppure annulla la modifica, e il testo viene mostrato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "チャプタ%1$@について、%2$@。TextMouth は安全に読み取れません。入れ子を浅くしてもう一度保存するか、変更を取り消すと、テキストが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "챕터 %1$@은(는) TextMouth가 안전하게 읽을 수 없는 구조입니다(%2$@). 구조를 단순하게 만들고 다시 저장하거나 변경을 실행 취소하면 텍스트가 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "hoofdstuk %@ %@, wat TextMouth niet veilig kan lezen. Maak het vlakker en bewaar opnieuw, of maak de wijziging ongedaan, en de tekst verschijnt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "jego rozdział %1$@ %2$@, czego TextMouth nie może bezpiecznie odczytać. Spłaszcz go i zachowaj ponownie albo cofnij zmianę, a tekst się pokaże."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "o capítulo %1$@ dele %2$@, o que o TextMouth não consegue ler com segurança. Simplifique-o e salve de novo, ou desfaça a alteração, e o texto será exibido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "его глава %1$@ %2$@, а TextMouth не может безопасно её прочитать. Упростите её и сохраните снова или отмените изменение, и текст появится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "dess kapitel %@ %@, vilket TextMouth inte kan läsa på ett säkert sätt. Förenkla det och spara igen, eller ångra ändringen, så visas texten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "บทที่ %1$@ %2$@ ซึ่ง TextMouth อ่านได้ไม่ปลอดภัย ลดระดับความซ้อนแล้วบันทึกอีกครั้ง หรือเลิกทำการเปลี่ยนแปลง แล้วข้อความจะแสดง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ numaralı bölümü %2$@; TextMouth bunu güvenle okuyamaz. Düzleştirip yeniden kaydedin ya da değişikliği geri alın, böylece metin görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "його розділ %1$@ %2$@, і TextMouth не може безпечно його прочитати. Спростіть структуру й збережіть знову або скасуйте зміну, і текст з’явиться."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس کے باب %1$@ میں %2$@، جسے TextMouth محفوظ طریقے سے نہیں پڑھ سکتا۔ تہہ بندی کم کر کے دوبارہ محفوظ کریں، یا تبدیلی کالعدم کریں، اور متن دکھائی دے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "chương %1$@ của nó %2$@, mà TextMouth không thể đọc an toàn. Hãy làm phẳng nó rồi lưu lại, hoặc hoàn tác thay đổi, để văn bản hiện ra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "其第 %1$@ 章%2$@，TextMouth 无法安全读取。请将其展平后再次存储，或撤销更改，文本便会显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "它的第 %1$@ 章中，%2$@，TextMouth 無法安全讀取。請減少巢狀層級後再次儲存，或還原更改，文字便會顯示。"
          }
        }
      }
    },
    "bookTextEdit.noCopyKept" : {
      "comment" : "Reason after a colon: a rebuild left the book's text alone because no backup could be made; begins in lower case. content.md is a file name and stays as written.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّر الاحتفاظ بنسخة من النص المحرَّر، لذا يترك TextMouth الملف content.md كما هو."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সম্পাদিত টেক্সটের কোনো কপি রাখা যায়নি, তাই TextMouth content.md যেমন আছে তেমনই রাখছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "es konnte keine Kopie des bearbeiteten Texts angelegt werden, daher lässt TextMouth content.md unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "no copy of the edited text could be kept, so TextMouth leaves content.md as it is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "no se pudo conservar ninguna copia del texto editado, así que TextMouth deja content.md como está."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نسخه‌ای از متن ویرایش‌شده قابل نگه‌داری نبود، بنابراین TextMouth فایل content.md را همان‌طور که هست می‌گذارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "aucune copie du texte modifié n’a pu être conservée, donc TextMouth laisse content.md tel quel."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא ניתן היה לשמור עותק של הטקסט הערוך, ולכן TextMouth משאיר את content.md כפי שהוא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "संपादित टेक्स्ट की कोई प्रति नहीं रखी जा सकी, इसलिए TextMouth content.md को जैसा है वैसा ही छोड़ देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "tidak ada salinan teks hasil edit yang dapat disimpan, sehingga TextMouth membiarkan content.md apa adanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "non è stato possibile conservare una copia del testo modificato, quindi TextMouth lascia content.md com’è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "編集したテキストのコピーを保持できなかったため、TextMouth は content.md をそのままにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "편집한 텍스트의 사본을 보관할 수 없어 TextMouth가 content.md를 그대로 둡니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "er kon geen kopie van de bewerkte tekst worden bewaard, dus TextMouth laat content.md zoals het is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "nie udało się zachować kopii edytowanego tekstu, więc TextMouth pozostawia plik content.md bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "nenhuma cópia do texto editado pôde ser guardada, então o TextMouth deixa content.md como está."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "не удалось сохранить копию изменённого текста, поэтому TextMouth оставляет content.md как есть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ingen kopia av den redigerade texten kunde sparas, så TextMouth lämnar content.md som den är."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "สำรองข้อความที่แก้ไขไว้ไม่ได้ TextMouth จึงคง content.md ไว้ตามเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "düzenlenen metnin hiçbir kopyası saklanamadı, bu yüzden TextMouth content.md dosyasını olduğu gibi bırakır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "не вдалося зберегти копію відредагованого тексту, тому TextMouth залишає content.md як є."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ترمیم شدہ متن کی کوئی کاپی محفوظ نہ ہو سکی، اس لیے TextMouth content.md کو جوں کا توں چھوڑتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "không thể giữ bản sao nào của văn bản đã sửa, nên TextMouth để nguyên content.md."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "无法保留编辑后文本的副本，因此 TextMouth 保持 content.md 不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "無法保留編輯後文字的副本，因此 TextMouth 讓 content.md 維持原樣。"
          }
        }
      }
    },
    "bookTextEdit.noText.audiobook" : {
      "comment" : "First sentence of the message when Edit Text is chosen for an audiobook with no transcript. %@ is the book's title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ كتاب صوتي بلا نسخة نصية، لذا ليس فيه نص لتحريره."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ট্রান্সক্রিপ্ট ছাড়া একটি অডিওবুক, তাই সম্পাদনার মতো কোনো টেক্সট নেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ist ein Hörbuch ohne Transkript und hat daher keinen Text zum Bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is an audiobook without a transcript, so it has no text to edit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ es un audiolibro sin transcripción, así que no tiene texto para editar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ یک کتاب صوتی بدون رونوشت است، بنابراین متنی برای ویرایش ندارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ est un livre audio sans transcription, il n’a donc aucun texte à modifier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ הוא ספר שמע ללא תמליל, ולכן אין בו טקסט לעריכה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ट्रांसक्रिप्ट के बिना ऑडियोबुक है, इसलिए संपादित करने के लिए उसमें कोई टेक्स्ट नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
