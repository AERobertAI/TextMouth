    "settings.shiftSkipExplanation" : {
      "comment" : "Explanation under the Shift+Skip pop-ups in the Playback settings. Shift is the key's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اضغط مع الاستمرار على Shift أثناء التخطي لاستخدام مقدار تخطٍّ ثانوي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "দ্বিতীয় এগিয়ে-পিছিয়ে যাওয়ার পরিমাণ ব্যবহার করতে এগিয়ে-পিছিয়ে যাওয়ার সময় শিফট ধরে রাখুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Halte die Umschalttaste beim Springen gedrückt, um einen zweiten Sprungwert zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold Shift while skipping to use a secondary skip amount."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mantén pulsada la tecla Mayúsculas al saltar para usar una cantidad de salto secundaria."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هنگام رد شدن، Shift را نگه دارید تا از مقدار رد شدن دوم استفاده شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Maintenez la touche Maj enfoncée pendant le saut pour utiliser une durée de saut secondaire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "החזק את Shift בזמן דילוג כדי להשתמש בכמות דילוג משנית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आगे-पीछे जाते समय दूसरी मात्रा के लिए शिफ़्ट दबाए रखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tahan Shift saat melompat untuk memakai jumlah lompatan kedua."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tieni premuto Maiusc mentre salti per usare un valore di salto secondario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "スキップするときにシフトキーを押したままにすると、もう1つのスキップ量を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "건너뛰는 동안 Shift 키를 누르고 있으면 보조 건너뛰기 양을 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Houd Shift ingedrukt tijdens het overslaan om een tweede sprongduur te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Przytrzymaj Shift podczas przewijania, aby użyć dodatkowej wartości przewijania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mantenha a tecla Shift pressionada ao pular para usar um intervalo de salto secundário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Удерживайте Shift при перемотке, чтобы использовать дополнительный шаг перемотки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Håll ned Skift medan du hoppar för att använda ett andra hoppintervall."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "กด Shift ค้างขณะข้ามเพื่อใช้ระยะข้ามที่สอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Atlarken ikinci bir atlama miktarı kullanmak için Shift tuşunu basılı tutun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Утримуйте Shift під час перемотування, щоб використати додатковий крок перемотування."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ثانوی چھلانگ کی مقدار استعمال کرنے کے لیے چھلانگ لگاتے وقت شفٹ دبائے رکھیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Giữ Shift khi tua để dùng mức tua phụ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "跳过时按住 Shift 键可使用第二跳过量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "跳轉時按住 Shift，可使用第二個跳轉量。"
          }
        }
      }
    },
