    "miscellaneousSettings.restartShortcutNote" : {
      "comment" : "Note under the restart gesture in the Miscellaneous settings. %1$@ is the name of the shortcut's action, %2$@ is the name of the Settings tab where shortcuts are set, and %3$@ is the default key in words, such as \"Shift + Command + R\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اضبط اختصاره باستخدام %@ في تبويب %@؛ والاختصار الافتراضي هو %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@ ট্যাবে %1$@ দিয়ে এর শর্টকাট ঠিক করুন; ডিফল্ট হলো %3$@।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lege den Kurzbefehl unter „%1$@“ im Tab „%2$@“ fest; der Standard ist %3$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set its shortcut with %@ in the %@ tab; the default is %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Define su atajo con %1$@ en la pestaña %2$@; el predeterminado es %3$@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "میان‌بر آن را با %1$@ در برگه %2$@ تنظیم کنید؛ پیش‌فرض %3$@ است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Définissez son raccourci avec %1$@ dans l’onglet %2$@ ; par défaut : %3$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הגדר את הקיצור שלו בפעולה “%1$@” בלשונית “%2$@”; ברירת המחדל היא %3$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@ टैब में %1$@ से इसका शॉर्टकट सेट करें; डिफ़ॉल्ट %3$@ है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Atur pintasannya dengan %1$@ di tab %2$@; defaultnya adalah %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Imposta la sua scorciatoia con %@ nella scheda %@; quella predefinita è %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%2$@」タブの「%1$@」でショートカットを設定します。デフォルトは%3$@です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@ 탭의 %1$@에서 단축키를 설정하십시오. 기본값은 %3$@입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stel het toetsenbordcommando ervoor in met %1$@ in het tabblad %2$@; standaard is dat %3$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ustaw skrót dla %1$@ na karcie %2$@; domyślny to %3$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Defina o atalho com %1$@ na aba %2$@; o padrão é %3$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Задайте сочетание клавиш для действия «%1$@» на вкладке «%2$@»; по умолчанию: %3$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ställ in dess genväg med %1$@ på fliken %2$@; standardgenvägen är %3$@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตั้งทางลัดด้วย %@ ในแท็บ %@ ค่าเริ่มต้นคือ %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kısayolunu “%2$@” sekmesinde “%1$@” eylemiyle ayarlayın; varsayılanı: %3$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Задайте комбінацію клавіш за допомогою «%1$@» на вкладці «%2$@»; типова — %3$@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس کا شارٹ کٹ “%2$@” ٹیب میں “%1$@” کے ذریعے مقرر کریں؛ ڈیفالٹ %3$@ ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đặt phím tắt của nó ở mục %1$@ trong tab %2$@; mặc định là %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "请在 %2$@ 标签页中通过 %1$@ 设置其快捷键；默认为 %3$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在「%2$@」標籤頁中使用 %1$@ 設定其快速鍵；預設為 %3$@。"
          }
        }
      }
    },
