        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth necesita que la unidad «%@» esté conectada para abrir la biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth a besoin que le disque « %@ » soit connecté pour ouvrir la bibliothèque."
