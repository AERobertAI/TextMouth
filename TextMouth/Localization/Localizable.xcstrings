    "Played downloads are kept until you delete them" : {
      "comment" : "VoiceOver hint of the checkbox that turns off deleting downloads after playing.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wiedergegebene Downloads bleiben erhalten, bis du sie löschst."
