            "value" : "%1$@ kitabı, bu TextMouth sürümünün okuyamadığı bir metin kodlaması olan “%2$@” ile okunacak şekilde ayarlı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@: вибрано читання як «%2$@» — кодування тексту, якого ця версія TextMouth не підтримує."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ کو “%2$@” کے طور پر پڑھنے کے لیے سیٹ کیا گیا ہے، ایک ایسی ٹیکسٹ انکوڈنگ جسے TextMouth کا یہ ورژن نہیں پڑھ سکتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ được đặt để đọc dưới dạng “%2$@”, một bảng mã mà phiên bản TextMouth này không đọc được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 被设为按“%2$@”读取，这是此版本的 TextMouth 无法读取的文本编码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 設為以「%2$@」讀取，但這個版本的 TextMouth 無法讀取該文字編碼。"
          }
        }
      }
    },
    "textEncoding.unmarkedUnicodeNote" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. What follows the name of a Unicode encoding for a file recognized as UTF-16 or UTF-32 by the structure of its bytes, which has no byte-order mark.",
