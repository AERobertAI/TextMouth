    "Reading the book again..." : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. What Book Information shows, beside a spinner, while the book is read again (SheetWorkIndicator).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Volviendo a leer el libro..."
          }
        }
      }
    },
    "Reading the book's headings…" : {
      "comment" : "Shown under the Text as spoken audio checkbox in the Export dialog while the book's text is read for its headings.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Leyendo los encabezados del libro…"
          }
        }
      }
    },
    "Reading the transcript and the rules…" : {
      "comment" : "Line of the Clean Up Transcript sheet while it reads the transcript and the correction rules.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Leyendo la transcripción y las reglas…"
          }
        }
      }
    },
    "Reads the file again." : {
      "comment" : "First sentence of what Try Again does on the library index recovery sheet.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vuelve a leer el archivo."
          }
        }
      }
    },
    "Ready to record from %@." : {
      "comment" : "Status line of the Record window while nothing is recording. %@ is the name of the microphone.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Listo para grabar con %@."
          }
        }
      }
    },
    "RealMedia" : {
      "comment" : "The name of the RealMedia format. Inside sentences about importing a file of that format.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "RealMedia"
          }
        }
      }
    },
    "Reason" : {
      "comment" : "Label of why the library index could not be read, on the library index recovery sheet.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Motivo"
          }
        }
      }
    },
    "Rebuild" : {
      "comment" : "Button of the Rebuild Directory confirmation that rebuilds the directory.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reconstruir"
          }
        }
      }
    },
    "Rebuild Directory" : {
      "comment" : "Button in Storage settings that rebuilds the data directory's structure. Also the title of its confirmation.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reconstruir directorio"
          }
        }
      }
    },
    "Rebuild Library Index" : {
      "comment" : "Button of the library index recovery sheet that saves the temporary library as the new index. Also the name sentences use for it.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reconstruir índice de la biblioteca"
          }
        }
      }
    },
    "Rebuild TextMouth directory" : {
      "comment" : "VoiceOver label of the Rebuild Directory button in Storage settings.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reconstruir el directorio de TextMouth"
          }
        }
      }
    },
    "Rebuilding the data directory..." : {
      "comment" : "Storage settings status line while Rebuild Directory runs.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reconstruyendo el directorio de datos…"
          }
        }
      }
    },
    "Recently Finished" : {
      "comment" : "Heading of the section of Settings, Stats that lists the books finished most recently, each with the date.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Terminados recientemente"
          }
        }
      }
    },
    "Record" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Record window group and read by VoiceOver. Starts recording in the Record window.\nTitle of the button in the Record window that starts recording.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Grabar"
          }
        }
      }
    },
    "Recording" : {
      "comment" : "The name a new recording's title starts with, followed by the date and time, such as \"Recording 2026-10-04 06:30\". It becomes the title of the audiobook the recording is saved as.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Grabación"
          }
        }
      }
    },
    "Recording discarded." : {
      "comment" : "Said as a punch-in recording under way is discarded in the audio editor.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Grabación descartada."
          }
        }
      }
    },
    "Recording from %@." : {
      "comment" : "Status line and announcement of the Record window when recording starts. %@ is the name of the microphone.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Grabando con %@."
          }
        }
      }
    },
    "Recording of %@, %@" : {
      "comment" : "Describes a recording left behind. %1$@ is when it was recorded, a date and time, and %2$@ is how long it lasts, spoken, such as \"1 minute, 4 seconds\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Recording of %1$@, %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Grabación del %1$@, %2$@"
          }
        }
      }
    },
    "Recording of %@, which holds no sound" : {
      "comment" : "Describes a recording left behind that holds no sound. %@ is when it was recorded, a date and time.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Grabación del %@, sin sonido"
          }
        }
      }
    },
    "Recording over %@ at %@, from %@, after the beep. Punch In or Stop ends it; Clear Selection discards it." : {
      "comment" : "Said before the audio editor's Punch In records over a selection. %1$@ is the selection's length in words, %2$@ its start in words, and %3$@ the microphone's name. \"Punch In\", \"Stop\" and \"Clear Selection\" are the names of controls.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Recording over %1$@ at %2$@, from %3$@, after the beep. Punch In or Stop ends it; Clear Selection discards it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Grabando sobre %1$@ en %2$@, con %3$@, después del pitido. Grabar encima o Detener la termina; Quitar selección la descarta."
          }
        }
      }
    },
    "Recording shortcut. Press a key with Command or Control." : {
      "comment" : "VoiceOver label of a menu command's key button while it waits for the new key: the shortcut of a menu command must be a key held with the Command or Control key.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Registrando atajo. Pulsa una tecla con Comando o Control."
          }
        }
      }
    },
    "Recording shortcut. Press a key, or press it twice for a double press." : {
      "comment" : "VoiceOver label of a keyboard shortcut's key button while it waits for the new key: pressing a key records it, and pressing the same key twice quickly records a double press.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Registrando atajo. Pulsa una tecla, o púlsala dos veces para una doble pulsación."
          }
        }
      }
    },
    "Recording stopped because the microphone reported a problem. What was recorded is kept." : {
      "comment" : "Error in the Record window when recording stopped by itself because capture failed.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La grabación se detuvo porque el micrófono informó de un problema. Lo grabado se conserva."
          }
        }
      }
    },
    "Recording to insert at %@, from %@, after the beep. Punch In or Stop ends it; Clear Selection discards it." : {
      "comment" : "Said before the audio editor's Punch In records at the cursor. %1$@ is the cursor's time in words and %2$@ the microphone's name. \"Punch In\", \"Stop\" and \"Clear Selection\" are the names of controls.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Recording to insert at %1$@, from %2$@, after the beep. Punch In or Stop ends it; Clear Selection discards it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Grabando para insertar en %1$@, con %2$@, después del pitido. Grabar encima o Detener la termina; Quitar selección la descarta."
          }
        }
      }
    },
    "Recording, %@, level %@" : {
      "comment" : "A part of the audio editor's status line while a punch-in records. %1$@ is the time recorded, in words, and %2$@ the input level.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Recording, %1$@, level %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Grabando, %1$@, nivel %2$@"
          }
        }
      }
    },
    "Recording. Stop or discard it with Clear Selection, then close." : {
      "comment" : "Said when the audio editor's window can't close because a punch-in records. \"Clear Selection\" is the name of a command.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Grabando. Detén la grabación o descártala con Quitar selección y luego cierra."
          }
        }
      }
    },
    "Recording. Stop the recording first." : {
      "comment" : "Said when an audio editor command other than the punch-in's own is chosen while a punch-in records.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Grabando. Detén primero la grabación."
          }
        }
      }
    },
    "Records a new shortcut." : {
      "comment" : "VoiceOver hint of a keyboard shortcut's key button, and of the add shortcut button, in Settings: the next key pressed becomes the shortcut.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Registra un atajo nuevo."
          }
        }
      }
    },
    "Records from a microphone into a new audiobook." : {
      "comment" : "One-line summary and VoiceOver hint of the Record choice of the Add to Library sheet.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Graba desde un micrófono en un audiolibro nuevo."
          }
        }
      }
    },
    "Records over the selection, or at the cursor, after a beep. Again, or Stop, ends it." : {
      "comment" : "Hint of the audio editor's Punch In button. \"Stop\" is the name of a button.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Graba sobre la selección o en el cursor, después de un pitido. Usarlo de nuevo, o Detener, la termina."
          }
        }
      }
    },
    "Recovered recordings" : {
      "comment" : "Heading of the list in the Record window of recordings TextMouth kept from before it last quit.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Grabaciones recuperadas"
          }
        }
