    "is being exported, and %@ now would stop the export" : {
      "comment" : "Why a book's download cannot be deleted or replaced yet, as the words after the book's title: it is being exported. %@ is what the listener tried, a phrase such as \"deleting its download\" or \"replacing it\", which starts the second part of the sentence.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "wird gerade exportiert, und %@ würde jetzt den Export stoppen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "se está exportando, y %@ ahora detendría la exportación"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "est en cours d’exportation, et %@ maintenant l’interromprait"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "निर्यात किया जा रहा है, और अभी %@ निर्यात को रोक देगा"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "sedang diekspor, dan %@ sekarang akan menghentikan ekspor"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "è in fase di esportazione, e %@ ora interromperebbe l’esportazione"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "は書き出し中です。いま%@を行うと、書き出しが停止します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "내보내는 중이며 지금 %@은(는) 내보내기를 중단시킵니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
