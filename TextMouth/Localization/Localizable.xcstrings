    },
    "%@, any subfolders, and the book inside will be removed from the library." : {
      "comment" : "First sentence of the second confirmation that deletes a folder holding one book. %@ is the folder's name in quotation marks."
    },
    "%@, at %@" : {
      "comment" : "VoiceOver label and rotor entry of a search result in a transcribed audiobook. %1$@ is the match with its context and place, and %2$@ is the time it is heard, spoken.",
