                  "value" : "Text recognition could not read any of the %lld pages: %@."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "El reconocimiento de texto no pudo leer ninguna de las %lld de páginas: %@."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "El reconocimiento de texto no pudo leer %lld página: %@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "El reconocimiento de texto no pudo leer ninguna de las %lld páginas: %@."
                }
              }
            }
          }
        }
      }
    },
    "Text recognition could not read the only page: %@." : {
      "comment" : "Why a book of one page of a picture was refused at import: text recognition could not read its only page. %@ names the page and why, such as \"page 1 (its picture could not be decoded)\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El reconocimiento de texto no pudo leer la única página: %@."
          }
        }
      }
    },
    "Text substitution rules could not be saved: %@" : {
      "comment" : "Failure notice: the text substitution rules could not be saved. %@ is the reason, a sentence from the system.",
      "localizations" : {
