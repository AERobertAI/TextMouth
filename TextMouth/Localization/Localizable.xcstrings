            "value" : "Её содержимого ещё нет на этом Mac, поэтому TextMouth не заглядывал внутрь."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Її вміст ще не на цьому Mac, тому TextMouth не заглядав усередину."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
