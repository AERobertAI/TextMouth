    "bookTextEdit.stoppedBookGone" : {
      "comment" : "Announcement when an Edit Text session ends because the book left the library. %@ is the book's title. Edit Text is a menu command.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يُحدَّث النص: أُزيل %@ أو حُذف تنزيله، لذا توقف “تحرير النص” له."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "টেক্সট হালনাগাদ হয়নি: %@ সরানো হয়েছে, বা এর ডাউনলোড মুছে ফেলা হয়েছে, তাই এর জন্য টেক্সট সম্পাদনা বন্ধ হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Text nicht aktualisiert: %@ wurde entfernt oder sein Download gelöscht, daher wurde „Text bearbeiten“ dafür beendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text not updated: %@ was removed, or its download deleted, so Edit Text has stopped for it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texto no actualizado: %@ se quitó, o se eliminó su descarga, así que Editar texto se detuvo para él."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "متن به‌روزرسانی نشد: %@ برداشته شد یا بارگیری آن حذف شد، بنابراین ویرایش متن برای آن متوقف شد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texte non mis à jour : %@ a été retiré, ou son téléchargement supprimé, donc la modification de son texte s’est arrêtée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הטקסט לא עודכן: %@ הוסר, או שההורדה שלו נמחקה, ולכן “ערוך טקסט” הופסק עבורו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "टेक्स्ट अपडेट नहीं हुआ: %@ हटा दी गई, या उसका डाउनलोड मिटा दिया गया, इसलिए उसके लिए “टेक्स्ट संपादित करें” रुक गया है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Teks tidak diperbarui: %@ dibuang, atau unduhannya dihapus, sehingga Edit Teks dihentikan untuknya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Testo non aggiornato: %@ è stato rimosso, o il suo download eliminato, quindi Modifica testo si è interrotto per questo libro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "テキストは更新されませんでした：%@は取り除かれたか、ダウンロードが削除されたため、テキストの編集を終了しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "텍스트가 업데이트되지 않음: %@이(가) 제거되었거나 다운로드가 삭제되어 텍스트 편집이 중지되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tekst niet bijgewerkt: %@ is weggehaald, of de download is verwijderd, dus Wijzig tekst is ervoor gestopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie zaktualizowano tekstu: książka %@ została usunięta lub jej pobrany plik został usunięty, więc edycja jej tekstu została przerwana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texto não atualizado: o livro %@ foi removido, ou seu download foi excluído, então a edição do texto parou para ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Текст не обновлён: книга «%@» убрана из библиотеки или её загрузка удалена, поэтому изменение текста остановлено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texten uppdaterades inte: %@ har tagits bort, eller dess nedladdning har raderats, så ”Redigera text” har avslutats för den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ยังไม่ได้อัปเดตข้อความ: %@ ถูกนำออก หรือการดาวน์โหลดถูกลบ การแก้ไขข้อความจึงหยุดลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Metin güncellenmedi: %@ kaldırıldı ya da indirmesi silindi, bu yüzden Metni Düzenle onun için durdu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Текст не оновлено: «%@» вилучено або її завантаження видалено, тому редагування тексту для неї зупинено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "متن اپ ڈیٹ نہیں ہوا: %@ ہٹا دی گئی، یا اس کا ڈاؤن لوڈ حذف کر دیا گیا، اس لیے اس کے لیے “متن میں ترمیم کریں” رک گیا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chưa cập nhật văn bản: %@ đã bị gỡ, hoặc bản tải về của nó đã bị xóa, nên việc sửa văn bản cho sách đã dừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文本未更新：%@ 已被移除或其下载已删除，因此其“编辑文本”已停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文字未更新：%@ 已被移除，或其下載項目已刪除，因此其「編輯文字」已停止。"
          }
        }
      }
    },
    "bookTextEdit.stoppedBookReadAgain.choose" : {
