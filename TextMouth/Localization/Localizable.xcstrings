            "value" : "Los tiempos de la transcripción no encajan entre sí, así que TextMouth no puede usarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les instants de la transcription ne concordent pas, donc TextMouth ne peut pas l’utiliser."
