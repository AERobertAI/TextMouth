        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non ha potuto salvare il suo elenco dei download di questo feed, quindi il download è stato conservato. Riprova quando la libreria potrà essere salvata."
