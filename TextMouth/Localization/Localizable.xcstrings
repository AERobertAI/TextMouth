    "libraryViewEditor.onePerFeedHint" : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. Its hint.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "من حلقات كل موجز ومقالاته، يسرد فقط ما فتحته أخيرًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "প্রতিটি ফিডের পর্ব ও নিবন্ধের মধ্যে আপনি সর্বশেষ যেটি খুলেছেন, শুধু সেটিই তালিকাভুক্ত করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Listet von den Folgen und Artikeln jedes Feeds nur die auf, die du zuletzt geöffnet hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of each feed's episodes and articles, lists only the one you opened last."
