          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hai modificato questa trascrizione il %@. Trascrivere di nuovo sostituisce le tue modifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "この文字起こしは%@に編集されています。もう一度文字起こしすると、編集内容が置き換えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
