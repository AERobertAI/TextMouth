        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sesli kitabın sesi, yeriniz ve yer imleriniz olduğu gibi kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Аудіо аудіокниги, ваше місце й ваші закладки залишаються без змін."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آڈیو بک کا آڈیو، آپ کی جگہ، اور آپ کے بک مارک جیسے ہیں ویسے ہی رہتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Âm thanh, vị trí và dấu trang của sách nói vẫn giữ nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "有声书的音频、你的位置和你的书签保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "有聲書的音訊、你的播放位置和你的書籤都維持原樣。"
          }
        }
      }
    },
