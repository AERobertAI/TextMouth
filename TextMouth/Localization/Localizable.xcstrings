    "Name (optional)" : {
      "comment" : "Placeholder of the field that names a substitution rule in the rule editor."
    },
    "Navigate" : {
      "comment" : "Title of the Navigate menu in the menu bar, which holds the commands that move around a book, such as Go to Library and Next Heading. Only a reader window shows it."
    },
    "Navigation" : {
      "comment" : "Heading of the group of navigation keyboard shortcuts in Settings.\nHeading of the navigation group in the Playback settings."
