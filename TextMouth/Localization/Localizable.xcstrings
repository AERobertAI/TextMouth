        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "متن از فایل ویرایشگر دوباره خوانده نشد، بنابراین متن اینجا بدون تغییر است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
