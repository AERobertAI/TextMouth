        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tidak ada cukup ruang di %1$@ untuk mengunduh %2$@. Buku yang sudah ada di sini tetap ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Su %1$@ non c'è spazio per scaricare %2$@. I libri già presenti restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@には、%2$@をダウンロードする空き容量がありません。すでにあるブックは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "공간 부족(%1$@): 다운로드할 수 없는 책 %2$@. 이미 있는 책은 그대로 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Er is geen ruimte op %1$@ om %2$@ te downloaden. De boeken die er al zijn, blijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Brak miejsca (%1$@), by pobrać: %2$@. Książki, które już tu są, pozostają."
