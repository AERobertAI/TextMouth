{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@" : {
      "comment" : "Joins two whole sentences into one text. %1$@ is the first sentence and %2$@ the second. English puts a space between them; Japanese and Chinese join sentences with no space at all, so change only the separator.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ adds a bookmark at the current position." : {
      "comment" : "Help under \"No bookmarks yet.\" in the Bookmarks list. %@ is the keyboard shortcut that adds a bookmark, spelled out in words, such as Command + B.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ agrega un marcador en la posición actual."
          }
        }
      }
    },
    "%@ adds one at the current position." : {
      "comment" : "Help under \"No bookmarks yet.\" in the Bookmarks list, when the add command has no keyboard shortcut. %@ is the name of the Add Bookmark button above the list.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ agrega uno en la posición actual."
          }
        }
      }
    },
    "%@ has no transcript to clean up. Transcribe its audio first." : {
      "comment" : "Alert shown when Clean Up Transcript is chosen for an audiobook with no transcript. %@ is the audiobook's title."
    },
    "%@ in %@." : {
      "comment" : "Summary line of the Clean Up Transcript sheet. %1$@ is the number of corrections, such as \"23 corrections\"; %2$@ is the number of sentences they are in, such as \"19 sentences\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ in %2$@."
          }
        }
      }
    },
    "%@ is already in the reading list." : {
      "comment" : "VoiceOver announcement when Add to Reading List added nothing: the one book selected is on the list already. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ya está en la lista de lectura."
          }
        }
      }
    },
    "%@ is being transcribed. Cancel it, or attach the transcript once it finishes." : {
      "comment" : "Alert shown when Attach Transcript is chosen for an audiobook that is being transcribed. %@ is the audiobook's title."
    },
    "%@ is being transcribed. Cancel it, or delete the transcript once it finishes." : {
      "comment" : "Alert shown when Delete Transcript is chosen for an audiobook that is being transcribed. %@ is the audiobook's title."
    },
    "%@ is being transcribed. Clean up its transcript once that finishes." : {
      "comment" : "Alert shown when Clean Up Transcript is chosen for an audiobook that is being transcribed. %@ is the audiobook's title."
    },
    "%@ isn't an audiobook; only audiobooks can be transcribed." : {
      "comment" : "Alert shown when Transcribe Audio is chosen for a book that is text, not audio. %@ is the book's title."
    },
    "%@ isn't in the reading list." : {
      "comment" : "VoiceOver announcement when Remove from Reading List took nothing off: the one book selected is not on the list. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no está en la lista de lectura."
          }
        }
      }
    },
    "%@ of %@ transcribed" : {
      "comment" : "Line of the Transcribe Audio sheet while transcribing. %1$@ is the length of audio transcribed so far, in words such as \"40 minutes\"; %2$@ is the audiobook's whole length in words, such as \"6 hours, 12 minutes\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@ transcribed"
          }
        }
      }
    },
    "%@ remaining" : {
      "comment" : "The sleep timer's state as VoiceOver reads it after \"Sleep timer:\" while it counts down. %@ is the time left in minutes and seconds, such as 4:59.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "quedan %@"
          }
        }
      }
    },
    "%@ seconds" : {
      "comment" : "A length of time in seconds with one decimal digit, such as \"0.5 seconds\". %@ is the already formatted number."
    },
    "%@, %@" : {
      "comment" : "A language's menu item in the transcription language pop-up, with its speech model's status. %1$@ is the language's name, such as \"English (United States)\"; %2$@ is the status: installed, needs download, or not supported.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%@: %@" : {
      "comment" : "What VoiceOver says for a detail of Book Information. %1$@ is the detail's label; %2$@ is its value.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@"
          }
        }
      }
    },
    "%@: %lld percent transcribed." : {
      "comment" : "What VoiceOver hears as a transcription passes a quarter of the audio. %1$@ is the audiobook's title; %2$lld is the percent done: 25, 50, or 75.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@: %lld percent transcribed."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@: %lld percent transcribed."
                }
              }
            }
          }
        }
      }
    },
    "%lld articles" : {
      "comment" : "A count of news articles in a list, counted beside books. %lld is the number of articles.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld article"
