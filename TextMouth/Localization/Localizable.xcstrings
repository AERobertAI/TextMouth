    "Reset all shortcuts to defaults" : {
      "comment" : "VoiceOver label of the button at the end of the Shortcuts tab of Settings that gives every keyboard shortcut its default keys again."
    },
    "Reset this book's voice, speed, and pitch to the global defaults" : {
      "comment" : "What VoiceOver calls the button that removes a text book's own voice, speed and pitch."
    },
    "Reset to Default" : {
      "comment" : "Button in Storage settings that moves the library back to the default location.\nButton in the row of a keyboard shortcut action the listener changed, and the row's VoiceOver action: gives that one action its default keys again."
    },
    "Reset to Default Location?" : {
      "comment" : "Title of the question asked before moving the library back to the default location."
    },
    "Reset to Defaults" : {
      "comment" : "Button at the end of the Shortcuts tab of Settings that gives every keyboard shortcut its default keys again. It asks to confirm first.\nTitle of the button in the Substitutions settings that replaces every rule with TextMouth's default rules, after asking."
    },
    "Reset to Global Settings" : {
      "comment" : "Button of a text book's own settings sheet that removes its own voice, speed and pitch."
