    "sync.announce.removedUnopened" : {
      "comment" : "Said aloud once after a sync removed downloads of books not opened for some days. %1$@ is a count of books, such as \"3 books\"; %2$@ is a count of days, such as \"7 days\". Every book stays in iCloud Drive.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أُزيلت تنزيلات %1$@ التي لم تُفتح خلال %2$@. تبقى جميعها في iCloud Drive."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@ ধরে না খোলা %1$@-এর ডাউনলোড সরানো হয়েছে। সবগুলো iCloud Drive-এ থাকছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Downloads von %1$@ entfernt, die seit %2$@ nicht geöffnet wurden. Alle bleiben in iCloud Drive."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removed downloads of %@ not opened in %@. All stay in iCloud Drive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se quitaron las descargas de %1$@ sin abrir en %2$@. Todos siguen en iCloud Drive."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بارگیری %1$@ که %2$@ باز نشده بودند برداشته شد. همه در iCloud Drive می‌مانند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Téléchargements retirés pour %1$@ non ouverts depuis %2$@. Tous restent dans iCloud Drive."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הורדות של %1$@ שלא נפתחו במשך %2$@ הוסרו. כולם נשארים ב-iCloud Drive."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@ से न खोली गई %1$@ के डाउनलोड हटाए गए। सभी iCloud Drive में बनी रहती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Unduhan %1$@ yang tidak dibuka selama %2$@ dibuang. Semuanya tetap ada di iCloud Drive."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rimossi i download di %1$@ non aperti da %2$@. Tutti restano in iCloud Drive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@以上開かれていない%1$@のダウンロードを取り除きました。すべて iCloud Drive に残っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
