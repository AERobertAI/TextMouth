    "dataDirectoryMoveRefusal.booksOpen.library" : {
      "comment" : "Why a move of the library was refused: a book is open in a reader. \"It\" is that book.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يمكن نقل المكتبة بينما يوجد كتاب مفتوح. أغلقه أولًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বই খোলা থাকলে লাইব্রেরি সরানো যায় না। আগে সেটি বন্ধ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Bibliothek kann nicht verschoben werden, solange ein Buch geöffnet ist. Schließe es zuerst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The library can't move while a book is open. Close it first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La biblioteca no se puede mover mientras hay un libro abierto. Ciérralo primero."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تا وقتی کتابی باز است، کتابخانه را نمی‌توان منتقل کرد. ابتدا آن را ببندید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La bibliothèque ne peut pas être déplacée tant qu’un livre est ouvert. Fermez-le d’abord."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא ניתן להעביר את הספרייה כשספר פתוח. סגור אותו קודם."
          }
        },
        "hi" : {
