        }
      }
    },
    "TextMouth exports one spoken audio file at a time. Export this once the current one has finished." : {
      "comment" : "Why a spoken audio export was refused: another one is running.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth exportiert jeweils eine gesprochene Audiodatei. Exportiere dies, sobald der aktuelle Export beendet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth exporta un solo archivo de audio hablado a la vez. Exporta esto cuando termine el actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth n’exporte qu’un fichier audio parlé à la fois. Exportez celui-ci une fois le fichier en cours terminé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth esporta un solo file audio parlato alla volta. Esporta questo quando quello in corso sarà terminato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth exporta um arquivo de áudio falado por vez. Exporte este quando o atual terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth экспортирует озвученное аудио в один файл за раз. Экспортируйте это после завершения текущего."
          }
        }
      }
    },
    "TextMouth first saves a copy of the old file, and does not rebuild if it cannot." : {
      "comment" : "Last sentence of what Rebuild Library Index does when no copy has been saved yet: it saves one first.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth sichert zuerst eine Kopie der alten Datei und baut nicht neu auf, wenn das nicht gelingt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth primero guarda una copia del archivo anterior, y no reconstruye si no puede."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth enregistre d’abord une copie de l’ancien fichier, et ne reconstruit rien s’il n’y arrive pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth salva prima una copia del vecchio file e non ricostruisce se non ci riesce."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth primeiro salva uma cópia do arquivo antigo e não reconstrói se não conseguir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth сначала сохраняет копию старого файла и не перестраивает индекс, если сделать это не удаётся."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Спочатку TextMouth зберігає копію старого файлу й не перебудовує, якщо не може цього зробити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 会先存储旧文件的副本，如果无法存储就不会重建。"
          }
        }
      }
    },
    "TextMouth found no braille tables in its bundle." : {
      "comment" : "Shown in the Braille tab of Settings in place of the pop-ups when the app holds no braille tables.",
      "localizations" : {
        "de" : {
