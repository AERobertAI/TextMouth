    "TextMouth couldn't save its list of this feed's downloads, so the download was kept. Try again once the library can be saved." : {
      "comment" : "Why a feed episode's download could not be deleted: the list of the feed's downloads could not be saved.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth konnte seine Liste der Downloads dieses Feeds nicht sichern, daher blieb der Download erhalten. Versuche es erneut, sobald die Bibliothek gesichert werden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no pudo guardar su lista de las descargas de este canal, así que se conservó la descarga. Inténtalo de nuevo cuando se pueda guardar la biblioteca."
