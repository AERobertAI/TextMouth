    "recording.stopHint" : {
      "comment" : "VoiceOver hint of the Stop button in the Record window.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يوقف التسجيل ويحفظه في مكتبتك ككتاب صوتي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "রেকর্ড করা থামায় এবং আপনার লাইব্রেরিতে অডিওবুক হিসেবে সংরক্ষণ করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppt die Aufnahme und sichert sie als Hörbuch in deiner Bibliothek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops recording and saves it in your library as an audiobook."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detiene la grabación y la guarda en tu biblioteca como audiolibro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ضبط را متوقف و آن را در کتابخانه‌ی شما به‌صورت کتاب صوتی ذخیره می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrête l’enregistrement et le sauvegarde dans votre bibliothèque comme livre audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "עוצר את ההקלטה ושומר אותה בספרייה שלך כספר שמע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "रिकॉर्डिंग रोकता है और उसे आपकी लाइब्रेरी में ऑडियोबुक के रूप में सहेजता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menghentikan perekaman dan menyimpannya di pustaka Anda sebagai buku audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe la registrazione e la salva nella tua libreria come audiolibro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "録音を停止し、ライブラリにオーディオブックとして保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "녹음을 중지하고 보관함에 오디오북으로 저장합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stopt de opname en bewaart die als luisterboek in je bibliotheek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zatrzymuje nagrywanie i zachowuje je w bibliotece jako audiobook."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para a gravação e a salva na sua biblioteca como audiolivro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Останавливает запись и сохраняет её в вашей библиотеке как аудиокнигу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppar inspelningen och sparar den i ditt bibliotek som en ljudbok."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หยุดบันทึกเสียงและบันทึกไว้ในไลบรารีของคุณเป็นหนังสือเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kaydı durdurur ve kitaplığınıza sesli kitap olarak kaydeder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Зупиняє запис і зберігає його в бібліотеці як аудіокнигу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ریکارڈنگ روکتا ہے اور اسے آپ کی لائبریری میں آڈیو بک کے طور پر محفوظ کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dừng ghi âm và lưu vào thư viện của bạn thành sách nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止录音，并将其作为有声书存入你的资料库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止錄音，並將它以有聲書的形式儲存到你的書庫。"
          }
        }
      }
    },
