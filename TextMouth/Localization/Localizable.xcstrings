    "Made %@, %lld of %lld." : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). What VoiceOver says after Duplicate: the copy and its place. Placeholders in order: name, number, count.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم إنشاء %1$@، %2$lld من %3$lld."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ erstellt, %2$lld von %3$lld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Made %1$@, %2$lld of %3$lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se creó %1$@, %2$lld de %3$lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vue %@ créée, %lld sur %lld."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ बनाया गया, %3$lld में से %2$lld।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ dibuat, %lld dari %lld."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Creata %@, %lld di %lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@を作成しました。%3$lld件中%2$lld件目。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 만듦, %3$lld개 중 %2$lld번째."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Visualização %1$@ criada, %2$lld de %3$lld."
          }
        },
        "ru" : {
          "stringUnit" : {
