          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتابخانه را در مکان پیش‌فرض، ~/.TextMouth، باز می‌کند یا کتابخانه‌ای جدید در آنجا شروع می‌کند، به جای کتابخانه‌ای که در دسترس نیست."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
