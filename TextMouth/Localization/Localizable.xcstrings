          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Открывает библиотеку в расположении по умолчанию, ~/.TextMouth, или создаёт там новую вместо недоступной библиотеки."
          }
        },
        "sv" : {
          "stringUnit" : {
