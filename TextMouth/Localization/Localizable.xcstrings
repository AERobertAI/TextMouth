    "feedDownloadProgress.comingBack.chooseRow" : {
      "comment" : "After Cancel stops one feed download that only the listener's Download brings back. %@ is the name of the Download command.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لتنزيله مرة أخرى، اختر %@ في صفه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আবার ডাউনলোড করতে এর সারিতে %@ বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um es erneut herunterzuladen, wähle %@ in seiner Zeile."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To download it again, choose %@ on its row."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para descargarlo de nuevo, elige %@ en su fila."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "برای بارگیری دوباره، %@ را در ردیف آن انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pour le télécharger de nouveau, choisissez %@ sur sa ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כדי להוריד אותו שוב, בחר “%@” בשורה שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसे फिर से डाउनलोड करने के लिए उसकी पंक्ति पर “%@” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Untuk mengunduhnya lagi, pilih %@ pada barisnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Per scaricarlo di nuovo, scegli %@ nella sua riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "もう一度ダウンロードするには、その行で%@を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "다시 다운로드하려면 해당 행에서 %@을(를) 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kies %@ in de rij ervan om het opnieuw te downloaden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aby pobrać go ponownie, wybierz %@ w jego wierszu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
