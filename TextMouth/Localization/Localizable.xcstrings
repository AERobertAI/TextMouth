    "The current directory will be retained as recovery data." : {
      "comment" : "Last sentence of the question asked before moving the library: the old folder is kept.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سيُحتفَظ بالمجلد الحالي كبيانات استرداد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বর্তমান ডিরেক্টরি পুনরুদ্ধারের ডেটা হিসেবে রাখা হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der aktuelle Datenordner wird als Wiederherstellungsdaten behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El directorio actual se conservará como datos de recuperación."
