    "Copy all TextMouth data to %@, validate it, and use the new location?" : {
      "comment" : "First sentence of the question asked before moving the library. %@ is the new folder's path.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هل تريد نسخ كل بيانات TextMouth إلى %@ والتحقق منها واستخدام الموقع الجديد؟"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সব TextMouth ডেটা %@-এ কপি করে, যাচাই করে নতুন অবস্থান ব্যবহার করবেন?"
          }
        },
        "de" : {
          "stringUnit" : {
