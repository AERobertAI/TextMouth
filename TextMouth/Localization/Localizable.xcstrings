            "value" : "%@ aggiunge un segnalibro alla posizione corrente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@で、現在の位置にブックマークを追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@을(를) 사용하면 현재 위치에 북마크가 추가됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
