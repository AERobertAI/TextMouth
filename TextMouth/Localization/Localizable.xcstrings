    "persistenceFailureBannerRowView.hidesNotice" : {
      "comment" : "First sentence of the VoiceOver hint of the failure banner's Dismiss button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
