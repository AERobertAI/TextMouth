        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Phụ đề ở định dạng %@, mà trình duyệt web và hầu hết trình phát đọc được: một tệp, tính thời gian từ đầu âm thanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
