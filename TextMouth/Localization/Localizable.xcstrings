    },
    "The next episode could not be downloaded, so playback stopped. %@" : {
      "comment" : "VoiceOver announcement when the download of a feed's next episode failed. %@ is the download's own sentence saying why.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo descargar el siguiente episodio, así que la reproducción se detuvo. %@"
          }
        }
      }
    },
    "The podcast's own transcript, downloaded with the episode on %@." : {
      "comment" : "Sentence saying a podcast episode's transcript is the one the podcast published. %@ is a date."
    },
    "The pre-cleanup transcript is only in the cloud. Download the book and try again." : {
      "comment" : "Error shown when Undo Cleanup is pressed and the transcript from before the cleanup has not been downloaded from the cloud drive."
    },
    "The reading list is empty. To add a book, choose Add to Reading List from its context menu, its VoiceOver actions, or the Library menu." : {
      "comment" : "Shown and read as the only row of the Reading List while it holds no book. Add to Reading List is the name of the command in the Library menu.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La lista de lectura está vacía. Para agregar un libro, elige Add to Reading List en su menú contextual, sus acciones de VoiceOver o el menú Library."
          }
        }
      }
    },
    "The reading list is set to stop when a book ends" : {
      "comment" : "A sentence of the announcement as a book read from the reading list ends, after \"Finished: <title>.\": the list's When a book ends is Stop. Written without its full stop.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La lista de lectura está configurada para detenerse al terminar un libro"
          }
        }
      }
    },
    "The speech model for %@ isn't on this Mac yet. Download it first." : {
      "comment" : "Error shown when transcription is tried before the language's speech model is downloaded. %@ is the language's name."
    },
    "The transcript and the text made from it are deleted." : {
      "comment" : "First sentence of the question asked before an audiobook's transcript is deleted."
    },
    "The transcript can't be read. If the book is only in the cloud, download it and try again." : {
      "comment" : "Error shown when Clean Up Transcript cannot read the transcript."
    },
    "The transcript changed since this was shown. Reopen Clean Up Transcript to see the changes." : {
      "comment" : "Error shown when the transcript changed after the Clean Up Transcript sheet showed its changes. Clean Up Transcript is the command's name."
    },
    "The transcript files beside the audio weren't attached: %@" : {
      "comment" : "Notice after an import: the transcript files beside each track's audio were not attached. %@ is the reason, a sentence."
    },
    "The transcript from before the cleanup can't be used: %@." : {
      "comment" : "Error shown when Undo Cleanup is pressed and the transcript from before the cleanup is damaged. %@ is the reason, a technical phrase in English."
    },
    "The transcript from “%@” replaces the book's transcript and the text made from it." : {
      "comment" : "First sentence of the question asked before a transcript from a file replaces an audiobook's transcript. %@ is the file's name."
    },
    "The transcript holds no text to attach." : {
      "comment" : "Error shown when an attached transcript file holds no text."
    },
    "The transcript is only in iCloud, so TextMouth leaves it. Download the book, then try again." : {
      "comment" : "Line of the Transcribe Audio sheet when the book's transcript file has not been downloaded from iCloud to this Mac."
    },
    "The transcript is only in the cloud. Its details appear once the book is downloaded." : {
      "comment" : "Book Information's Transcript detail when the transcript file has not been downloaded from the cloud drive."
    },
    "The transcript of %@ can't be read. If the book is only in the cloud, download it and try again." : {
      "comment" : "Alert shown when Clean Up Transcript is chosen for an audiobook whose transcript cannot be read. %@ is the audiobook's title."
    },
    "The transcript runs to %@, past the audio's end at %@, so it is for other audio." : {
      "comment" : "Error shown when an attached transcript file's times run past the end of the book's audio. %1$@ is where the transcript ends and %2$@ where the audio ends, each a length of time in words such as \"1 hour, 2 minutes, 5 seconds\".",
      "localizations" : {
