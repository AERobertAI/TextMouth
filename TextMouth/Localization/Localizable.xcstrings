    "Automatically start playing when you navigate to a heading, bookmark, or search result." : {
      "comment" : "Explanation under the Auto-play after navigation checkbox in the Playback settings.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ابدأ التشغيل تلقائيًا عند الانتقال إلى عنوان رئيسي أو إشارة مرجعية أو نتيجة بحث."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "হেডিং, বুকমার্ক বা অনুসন্ধানের ফলাফলে গেলে নিজে থেকে চালানো শুরু করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Startet die Wiedergabe automatisch, wenn du zu einer Überschrift, einem Lesezeichen oder einem Suchergebnis navigierst."
          }
        },
        "es" : {
