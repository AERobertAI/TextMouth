            "value" : "%@ записує текст звичайними абзацами з його рядків, зберігаючи позначки цитат і списків як символи, а решту експортує як зазвичай."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” سے متن اس کی سطروں کے سادہ پیراگرافوں کی صورت میں لکھا جاتا ہے، اس کے اقتباس اور فہرست کے نشانات حروف کی شکل میں رہتے ہیں، اور باقی سب کچھ معمول کے مطابق برآمد ہوتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nút %@ ghi văn bản thành các đoạn văn thường gồm các dòng của nó, giữ dấu trích dẫn và dấu danh sách dưới dạng ký tự, và xuất mọi thứ khác như bình thường."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 会将文本写成由其各行组成的普通段落，保留其引用和列表标记的字符，其余内容照常导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 會把文字寫成純段落（每行一段），其引用和列表標記保留為字元，其餘內容照常輸出。"
          }
        }
      }
    },
    "bookExportDeepChapter.message.without" : {
      "comment" : "The third sentence of the alert an export shows when a chapter nests too deeply and others may too. %@ is the name of the Export Every Such Chapter as Written button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” يفعل الشيء نفسه لكل فصل كهذا في هذا التصدير، دون أن يسأل مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ এই রপ্তানির এ ধরনের প্রতিটি অধ্যায়ের জন্য একই কাজ করে, আবার জিজ্ঞেস না করেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ macht dasselbe für jedes solche Kapitel dieses Exports, ohne erneut zu fragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ does the same for every such chapter of this export, without asking again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ hace lo mismo con cada capítulo de este tipo de esta exportación, sin volver a preguntar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ همین کار را برای هر فصل مشابه در این صادر کردن انجام می‌دهد، بدون اینکه دوباره بپرسد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ fait de même pour tous les chapitres de ce type dans cette exportation, sans redemander."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ עושה את אותו הדבר לכל פרק כזה בייצוא הזה, בלי לשאול שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” इस निर्यात के ऐसे हर अध्याय के लिए यही करता है, दोबारा पूछे बिना।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ melakukan hal yang sama untuk setiap bab seperti itu dalam ekspor ini, tanpa bertanya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ fa lo stesso per ogni capitolo di questo tipo in questa esportazione, senza chiedere di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」は、この書き出しのそのような章すべてに、あらためて確認せずに同じ処理をします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@을(를) 선택하면 이번 내보내기의 해당하는 모든 챕터에 다시 묻지 않고 같은 방식이 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ doet hetzelfde voor elk zulk hoofdstuk van deze export, zonder opnieuw te vragen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ robi to samo dla każdego takiego rozdziału w tym eksporcie, bez ponownego pytania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ faz o mesmo com todos os capítulos desse tipo nesta exportação, sem perguntar de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ делает то же для каждой такой главы этого экспорта, не спрашивая снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Med ”%@” görs detsamma för varje sådant kapitel i den här exporten, utan att fråga igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ทำเช่นเดียวกันกับทุกบทลักษณะนี้ในการส่งออกครั้งนี้ โดยไม่ถามอีก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, bu dışa aktarmadaki bu türden her bölüm için aynısını, tekrar sormadan yapar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ робить те саме з кожним таким розділом цього експорту без повторних запитів."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” سے اس برآمد کے ہر ایسے باب کے ساتھ یہی ہوتا ہے، دوبارہ پوچھے بغیر۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nút %@ làm tương tự cho mọi chương như vậy trong lần xuất này, không hỏi lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 会对此次导出中所有这类章节执行同样的操作，不再询问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 會對此次輸出中每個這類章節執行相同操作，不再詢問。"
          }
        }
      }
    },
