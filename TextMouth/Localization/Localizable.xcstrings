    "cueSheet.headingsDidNotFit" : {
      "comment" : "Notice after an import of tracks that came without the headings of some cue sheets and label files, because a heading lay past the end of the audio. %@ is the files' names in curly quotes, listed as a sentence lists them.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تتجاوز العناوين الرئيسية من %@ نهاية الصوت، لذا استُوردت المقاطع بدونها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@-এর হেডিং অডিওর শেষ ছাড়িয়ে গেছে, তাই ট্র্যাকগুলো সেগুলো ছাড়াই আমদানি করা হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Überschriften aus %@ reichen über das Ende des Audios hinaus, daher wurden die Tracks ohne sie importiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The headings from %@ run past the end of the audio, so the tracks were imported without them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los encabezados de %@ van más allá del final del audio, así que las pistas se importaron sin ellos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سرفصل‌های %@ از انتهای صدا فراتر می‌روند، پس تراک‌ها بدون آن‌ها وارد شدند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les en-têtes de %@ dépassent la fin de l’audio, donc les pistes ont été importées sans eux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הכותרות מ-%@ חורגות מסוף השמע, ולכן הרצועות יובאו בלעדיהן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ के हेडिंग ऑडियो के अंत से आगे जाते हैं, इसलिए ट्रैक उनके बिना आयात किए गए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tajuk dari %@ melewati akhir audio, jadi trek diimpor tanpa tajuk tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le intestazioni di %@ superano la fine dell’audio, quindi le tracce sono state importate senza di esse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@の見出しがオーディオの終わりを超えているため、見出しなしでトラックを読み込みました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@의 표제가 오디오의 끝을 넘어서므로 표제 없이 트랙을 가져왔습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De koppen uit %@ lopen voorbij het einde van de audio, dus de tracks zijn zonder de koppen geïmporteerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nagłówki z %@ wykraczają poza koniec dźwięku, więc ścieżki zaimportowano bez nich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Os cabeçalhos de %@ vão além do fim do áudio, então as faixas foram importadas sem eles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Заголовки из %@ выходят за конец аудио, поэтому дорожки импортированы без них."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rubrikerna från %@ ligger efter slutet av ljudet, så spåren importerades utan dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หัวข้อจาก %@ เลยท้ายเสียง จึงนำเข้าแทร็กโดยไม่มีหัวข้อเหล่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ içindeki başlıklar sesin sonunu aştığı için parçalar başlıksız içe aktarıldı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Заголовки з %@ виходять за кінець аудіо, тож доріжки імпортовано без них."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ کی سرخیاں آڈیو کے اختتام سے آگے جاتی ہیں، اس لیے ٹریکس ان کے بغیر درآمد کیے گئے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Các đề mục từ %@ vượt quá phần cuối của âm thanh, nên các bản âm thanh được nhập mà không có chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@中的章节标题超出了音频的结尾，因此导入音轨时未使用它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 的標題超出了音訊的結尾，因此輸入的音軌沒有這些標題。"
          }
        }
      }
    },
    "cueSheet.noTracks" : {
      "comment" : "Refusal of a cue sheet chosen on its own that places no track. \"It\" is the cue sheet. Follows the sentence naming the file.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يسرد أي مقطع صوتي له بداية يستطيع TextMouth قراءتها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এতে এমন কোনো অডিও ট্র্যাক নেই যার শুরুর সময় TextMouth পড়তে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Darin ist kein Audiotrack mit einer Startzeit verzeichnet, die TextMouth lesen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It lists no audio track with a start that TextMouth can read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No indica ninguna pista de audio con un inicio que TextMouth pueda leer."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هیچ تراک صوتی با زمان شروعِ قابل خواندن برای TextMouth فهرست نکرده است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il ne répertorie aucune piste audio dont TextMouth reconnaisse le point de départ."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הוא אינו מציין אף רצועת שמע עם זמן התחלה ש-TextMouth יכול לקרוא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसमें ऐसा कोई ऑडियो ट्रैक सूचीबद्ध नहीं है जिसकी शुरुआत TextMouth पढ़ सके।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tidak ada trek audio dengan titik awal yang dapat dibaca TextMouth."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non elenca nessuna traccia audio con un inizio che TextMouth possa leggere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
