    },
    "The folder for this feed is no longer in the library. Choose another folder for it." : {
      "comment" : "Why a feed's episode could not be downloaded: the feed's folder was removed from the library.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La carpeta de este canal ya no está en la biblioteca. Elige otra carpeta para él."
          }
        }
      }
    },
    "The folder holds %lld DAISY books (%@)." : {
      "comment" : "First sentence of why a folder could not be imported as one DAISY book: its top level holds several books' package files. %lld is how many books, always two or more, and %@ their file names, separated by commas.",
      "localizations" : {
        "en" : {
