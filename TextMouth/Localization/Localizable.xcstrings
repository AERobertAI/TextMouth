            "value" : "יש בו רשימת עמודים, ותחילת כל עמוד מסומנת בטקסט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसकी एक पृष्ठ सूची है, और हर पृष्ठ की शुरुआत टेक्स्ट में चिह्नित है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ada daftar halaman, dan awal setiap halaman ditandai dalam teks."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ha un elenco delle pagine e l’inizio di ogni pagina è segnato nel testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ページリストがあり、各ページの先頭がテキスト内に示されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "페이지 목록이 있으며, 각 페이지의 시작이 텍스트에 표시되어 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Het heeft een paginalijst, en het begin van elke pagina is in de tekst gemarkeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ma listę stron, a początek każdej strony jest oznaczony w tekście."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tem uma lista de páginas, e o início de cada página está marcado no texto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В ней есть список страниц, а начало каждой страницы отмечено в тексте."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Den har en sidlista, och början på varje sida är markerad i texten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "มีรายการหน้า และจุดเริ่มต้นของแต่ละหน้ามีเครื่องหมายอยู่ในข้อความ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sayfa listesi var ve her sayfanın başlangıcı metinde işaretli."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Має список сторінок, і початок кожної сторінки позначено в тексті."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس میں صفحات کی فہرست ہے، اور ہر صفحے کا آغاز متن میں نشان زد ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sách có danh sách trang, và điểm bắt đầu của mỗi trang được đánh dấu trong văn bản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "含有页码列表，每页的起点都在文本中标出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "它有頁碼列表，每一頁的起點都標記在文字中。"
          }
        }
      }
    },
    "epubPackageBuilder.accessibilitySummary.noMedia" : {
      "comment" : "The last sentence of the accessibility summary written into an exported EPUB.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ليس فيه صور أو صوت أو فيديو، ويُحفظ نص وصف الصورة كنص."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এতে কোনো ছবি, অডিও বা ভিডিও নেই, এবং ছবির বর্ণনার টেক্সট টেক্সট হিসেবেই রাখা হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es enthält keine Bilder, keinen Ton und kein Video, und der Text der Beschreibung eines Bildes bleibt als Text erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It has no pictures, sound, or video, and the text of a picture's description is kept as text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No tiene imágenes, sonido ni video, y el texto de la descripción de una imagen se conserva como texto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تصویر، صدا یا ویدیو ندارد و متن توضیح هر تصویر به‌صورت متن نگه داشته شده است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il n’a ni image, ni son, ni vidéo, et le texte de la description d’une image est conservé comme texte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אין בו תמונות, צליל או וידאו, וטקסט התיאור של תמונה נשמר כטקסט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसमें कोई चित्र, ध्वनि या वीडियो नहीं है, और चित्र के विवरण का टेक्स्ट टेक्स्ट के रूप में रखा गया है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tidak ada gambar, suara, atau video, dan teks deskripsi gambar disimpan sebagai teks."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non ha immagini, suoni o video, e il testo della descrizione di un’immagine viene conservato come testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "画像、サウンド、ビデオは含まれず、画像の説明文はテキストとして保持されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "그림, 소리, 동영상은 없으며, 그림 설명 텍스트는 텍스트로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Het bevat geen afbeeldingen, geluid of video, en de tekst van de beschrijving van een afbeelding blijft tekst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie ma obrazów, dźwięku ani wideo, a opis obrazu jest zachowany jako tekst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não tem imagens, som nem vídeo, e o texto da descrição de uma imagem é mantido como texto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В ней нет картинок, звука и видео, а текст описания картинки сохранён как текст."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Den har inga bilder, inget ljud och ingen video, och texten i en bilds beskrivning behålls som text."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไม่มีรูปภาพ เสียง หรือวิดีโอ และข้อความอธิบายรูปภาพจะเก็บไว้เป็นข้อความ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Resim, ses veya video içermez; resim açıklamasının metni metin olarak korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "У ній немає зображень, звуку чи відео, а текст опису зображення збережено як текст."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس میں تصاویر، آواز یا ویڈیو نہیں ہیں، اور تصویر کی تفصیل کا متن بطور متن رکھا گیا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sách không có hình ảnh, âm thanh hay video, và văn bản mô tả của một hình ảnh được giữ dưới dạng văn bản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "不含图片、声音或视频，图片说明的文字以文本保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "它沒有圖片、聲音或影片，圖片說明的文字則保留為文字。"
          }
        }
      }
    },
