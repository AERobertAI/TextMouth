    "audioEditor.previewingBeforeApplying" : {
      "comment" : "Said as the audio editor's Apply plays a preview first, because the Preview filters before applying setting is on. %@ is the filter preset's name. \"Apply\" is the name of the button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جارٍ معاينة %@ أولًا. اختر “تطبيق” مرة أخرى لتطبيقه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আগে %@-এর প্রিভিউ চলছে। প্রয়োগ করতে আবার “প্রয়োগ করুন” বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%@“ wird zuerst als Vorschau wiedergegeben. Wähle erneut „Anwenden“, um den Filter anzuwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previewing %@ first. Choose Apply again to apply it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vista previa de %@ primero. Elige Aplicar de nuevo para aplicarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ابتدا پیش‌نمایش %@. برای اعمال آن، دوباره «اعمال» را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aperçu de %@ d’abord. Choisissez Appliquer à nouveau pour l’appliquer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מציג תחילה תצוגה מקדימה של %@. בחר שוב “החל” כדי להחיל אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पहले %@ का पूर्वावलोकन चल रहा है। इसे लागू करने के लिए “लागू करें” दोबारा चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Memutar pratinjau %@ terlebih dahulu. Pilih Terapkan lagi untuk menerapkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Prima l’anteprima di %@. Scegli di nuovo Applica per applicarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "先に%@をプレビューします。適用するには、もう一度「適用」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "먼저 %@을(를) 미리 듣는 중입니다. 적용하려면 적용을 다시 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ wordt eerst als voorvertoning afgespeeld. Kies opnieuw Pas toe om het toe te passen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Najpierw podgląd: %@. Wybierz Zastosuj ponownie, aby zastosować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproduzindo primeiro uma prévia de %@. Escolha Aplicar de novo para aplicá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сначала прослушивается фильтр «%@». Чтобы применить его, снова выберите «Применить»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Förhandsvisar %@ först. Välj Tillämpa igen för att tillämpa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "กำลังดูตัวอย่าง %@ ก่อน เลือก นำไปใช้ อีกครั้งเพื่อใช้ตัวกรอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ önce önizleniyor. Uygulamak için Uygula'yı yeniden seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Спершу попередній перегляд %@. Щоб застосувати, знову виберіть «Застосувати»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پہلے %@ کا پیش منظر چلایا جا رہا ہے۔ لاگو کرنے کے لیے دوبارہ “لاگو کریں” منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đang nghe thử %@ trước. Hãy chọn Áp dụng lần nữa để áp dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "正在预览 %@。再次选取“应用”即可应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "先預覽 %@。再次選擇「套用」即可套用。"
          }
        }
      }
    },
