          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এর ট্র্যাক যে অডিওর নাম দেয় তার শেষ ছাড়িয়ে যায়, তাই এটি সেই অডিওর অন্য কপির জন্য বানানো হয়েছিল।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Seine Tracks reichen über das Ende des genannten Audios hinaus; es wurde also für eine andere Kopie dieses Audios erstellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its tracks run past the end of the audio it names, so it was made for another copy of that audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sus pistas van más allá del final del audio que nombra, así que se hizo para otra copia de ese audio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تراک‌های آن از انتهای صدایی که نام می‌برد فراتر می‌روند، پس برای نسخه‌ای دیگر از آن صدا ساخته شده است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ses pistes dépassent la fin de l’audio qu’il désigne, donc il a été fait pour une autre copie de cet audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הרצועות שלו חורגות מסוף השמע שהוא מציין, ולכן הוא נוצר לעותק אחר של השמע הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसके ट्रैक उस ऑडियो के अंत के आगे तक जाते हैं जिसका यह नाम लेती है, इसलिए यह उस ऑडियो की किसी दूसरी प्रति के लिए बनाई गई थी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Treknya melewati akhir audio yang disebutkan, jadi file ini dibuat untuk salinan audio yang lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le sue tracce superano la fine dell’audio che indica, quindi è stato creato per un’altra copia di quell’audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "トラックが、指定されたオーディオの終わりを超えています。そのオーディオの別のコピー用に作られたものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "트랙이 지정된 오디오의 끝을 넘어서므로 다른 오디오 사본용으로 만들어진 것입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De tracks lopen voorbij het einde van de audio die het noemt, dus het is gemaakt voor een andere kopie van die audio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jego ścieżki wykraczają poza koniec wskazanego dźwięku, więc powstał dla innej kopii tego dźwięku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "As faixas dele vão além do fim do áudio que ele cita, então ele foi feito para outra cópia desse áudio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Его дорожки выходят за конец указанного в нём аудио, поэтому он создан для другой копии этого аудио."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dess spår sträcker sig förbi slutet av det ljud den anger, så den gjordes för en annan kopia av ljudet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "แทร็กของไฟล์ CUE เลยท้ายเสียงที่ระบุ จึงสร้างขึ้นสำหรับสำเนาอื่นของเสียงนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Parçaları, adını verdiği sesin sonunu aşıyor; bu yüzden o sesin başka bir kopyası için yapılmış."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Доріжки виходять за кінець вказаного аудіо, тож цей файл CUE створено для іншої копії аудіо."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس کے ٹریکس اس آڈیو کے اختتام سے آگے جاتے ہیں جس کا یہ نام لیتی ہے، اس لیے یہ اس آڈیو کی کسی دوسری کاپی کے لیے بنائی گئی تھی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Các bản âm thanh của nó kéo dài quá phần cuối của âm thanh mà nó nêu, nên nó được lập cho một bản sao khác của âm thanh đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "其音轨超出了它所指明的音频的结尾，所以它是为该音频的另一个副本制作的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "其音軌超出了它所指音訊的結尾，因此它是為另一份音訊副本製作的。"
          }
        }
      }
    },
    "cueSheet.tooLarge" : {
      "comment" : "Refusal of a cue sheet that is larger than TextMouth reads. %@ is the cue sheet's file name.",
      "extractionState" : "manual",
      "localizations" : {
