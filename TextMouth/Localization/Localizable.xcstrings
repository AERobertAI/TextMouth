    "feed.deleteItemMessage.episode" : {
      "comment" : "First sentence of the confirmation before an episode that was moved into the library is deleted from its feed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تغادر الحلقة القائمة نهائيًا؛ ويبقى الكتاب الذي صارت إليه في مكتبتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পর্বটি চিরতরে তালিকা থেকে চলে যায়; আপনার লাইব্রেরিতে এটি থেকে তৈরি হওয়া বইটি থেকে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Folge verschwindet für immer aus der Liste; das Buch, das daraus in deiner Bibliothek wurde, bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The episode leaves the list for good; the book it became in your library stays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El episodio sale de la lista para siempre; el libro en que se convirtió en tu biblioteca se queda."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "قسمت برای همیشه از فهرست خارج می‌شود؛ کتابی که از آن در کتابخانه‌ی شما ساخته شده است می‌ماند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’épisode quitte définitivement la liste ; le livre qu’il est devenu dans votre bibliothèque reste."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "האפיזודה עוזבת את הרשימה לצמיתות; הספר שנוצר ממנה בספרייה שלך נשאר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "एपिसोड हमेशा के लिए सूची से हट जाता है; उससे बनी पुस्तक आपकी लाइब्रेरी में बनी रहती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Episode ini dihapus dari daftar untuk selamanya; buku hasilnya di pustaka Anda tetap ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’episodio esce dall’elenco per sempre; il libro in cui si è trasformato resta nella tua libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "エピソードは一覧から完全に消えますが、ライブラリ内でブックになったものは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "에피소드가 목록에서 완전히 사라지지만, 보관함에서 책이 된 항목은 그대로 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De aflevering verdwijnt voorgoed uit de lijst; het boek dat ervan is gemaakt, blijft in je bibliotheek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Odcinek znika z listy na stałe; książka, którą się stał w Twojej bibliotece, zostaje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O episódio sai da lista de vez; o livro em que ele se transformou na sua biblioteca permanece."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Выпуск навсегда исчезает из списка; книга, в которую он превратился в вашей библиотеке, остаётся."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Avsnittet försvinner för gott från listan; boken som det blev i ditt bibliotek finns kvar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตอนจะออกจากรายการอย่างถาวร ส่วนหนังสือที่ได้จากตอนในไลบรารีของคุณจะยังอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Podcast bölümü listeden kalıcı olarak çıkar; kitaplığınızda olan kitabı kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Епізод остаточно зникає зі списку; книга, якою він став у вашій бібліотеці, залишається."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ایپی سوڈ ہمیشہ کے لیے فہرست سے نکل جاتا ہے؛ جو کتاب وہ آپ کی لائبریری میں بنا وہ رہتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tập rời khỏi danh sách vĩnh viễn; sách được tạo từ tập này trong thư viện của bạn vẫn còn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "该单集会永久从列表中移除；由它转成的图书仍会保留在你的资料库中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此單集會從列表中永久移除；它在你書庫中轉成的書籍會保留。"
          }
        }
      }
    },
