    "headingNavigatorView.levelFilterHint" : {
      "comment" : "Hint of the headings sheet's level filter: what choosing a level does.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعرض العناوين الرئيسية حتى المستوى المختار فقط."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বেছে নেওয়া স্তর পর্যন্ত হেডিংগুলোই দেখায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zeigt nur die Überschriften bis zur gewählten Ebene an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows only the headings up to the level chosen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Muestra solo los encabezados hasta el nivel elegido."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فقط سرفصل‌ها را تا سطح انتخاب‌شده نشان می‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Affiche seulement les en-têtes jusqu’au niveau choisi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מציג רק את הכותרות עד הרמה שנבחרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चुने हुए स्तर तक की हेडिंग ही दिखाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hanya menampilkan tajuk sampai tingkat yang dipilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mostra solo le intestazioni fino al livello scelto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選択したレベルまでの見出しだけを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "선택한 레벨까지의 표제만 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toont alleen de koppen tot het gekozen niveau."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pokazuje tylko nagłówki do wybranego poziomu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mostra apenas os cabeçalhos até o nível escolhido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Показывает только заголовки до выбранного уровня."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Visar bara rubrikerna upp till vald nivå."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "แสดงเฉพาะหัวข้อถึงระดับที่เลือก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yalnızca seçilen düzeye kadar olan başlıkları gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Показує лише заголовки до вибраного рівня."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "منتخب سطح تک کی سرخیاں ہی دکھاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chỉ hiển thị các đề mục đến cấp đã chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "仅显示不超过所选级别的章节标题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "只顯示到所選層級為止的標題。"
          }
        }
      }
    },
