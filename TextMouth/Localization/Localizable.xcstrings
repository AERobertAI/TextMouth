    "storageLocation.chooserHint.instead" : {
      "comment" : "VoiceOver hint of the Choose Another Library button in Storage settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يفتح أداة اختيار مجلد لاختيار مجلد يحتوي على مكتبة TextMouth، ثم يفتحها TextMouth بدلًا من المكتبة الحالية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "একটি ফোল্ডার চয়নকারী খোলে, যাতে TextMouth লাইব্রেরি আছে এমন একটি ফোল্ডার বেছে নেওয়া যায়; TextMouth তারপর এর বদলে সেই লাইব্রেরিটি খোলে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffnet eine Ordnerauswahl, um einen Ordner mit einer TextMouth-Bibliothek zu wählen, die TextMouth dann stattdessen öffnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens a folder chooser to pick a folder that holds a TextMouth library, which TextMouth then opens instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre un selector de carpetas para elegir una carpeta que contenga una biblioteca de TextMouth, que TextMouth abre en su lugar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یک انتخابگر پوشه باز می‌کند تا پوشه‌ای را که کتابخانه‌ی TextMouth در آن است انتخاب کنید و TextMouth به جای کتابخانه فعلی آن را باز کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ouvre un sélecteur de dossier pour choisir un dossier contenant une bibliothèque TextMouth, que TextMouth ouvre ensuite à la place."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "פותח בורר תיקיות לבחירת תיקייה שמכילה ספריית TextMouth, ו-TextMouth פותח אותה במקום הספרייה הנוכחית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ोल्डर चुनने की विंडो खोलता है, जिसमें TextMouth लाइब्रेरी वाला फ़ोल्डर चुना जा सकता है; TextMouth फिर उसे खोलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuka pemilih folder untuk memilih folder yang berisi pustaka TextMouth, yang kemudian dibuka TextMouth."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apre un selettore di cartelle per scegliere una cartella che contiene una libreria di TextMouth, che TextMouth aprirà al posto di quella attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フォルダ選択を開き、TextMouth ライブラリを含むフォルダを選ぶと、TextMouth が代わりにそれを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "폴더 선택 창을 열어 TextMouth 보관함이 들어 있는 폴더를 고르면 TextMouth가 그 보관함을 대신 엽니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Opent een mapkiezer om een map met een TextMouth-bibliotheek te kiezen, die TextMouth dan in plaats daarvan opent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Otwiera okno wyboru folderu, w którym można wskazać folder zawierający bibliotekę TextMouth, a TextMouth otworzy ją zamiast bieżącej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre um seletor de pastas para escolher uma pasta que contenha uma biblioteca do TextMouth, que o TextMouth abre no lugar da atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Открывает окно выбора папки с библиотекой TextMouth, которую TextMouth затем откроет вместо текущей."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öppnar en mappväljare för att välja en mapp som innehåller ett TextMouth-bibliotek, som TextMouth sedan öppnar i stället."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เปิดหน้าต่างเลือกโฟลเดอร์เพื่อเลือกโฟลเดอร์ที่มีไลบรารี TextMouth ซึ่ง TextMouth จะเปิดแทน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kitaplığı içeren bir klasör seçmek için klasör seçici açar; TextMouth bunun yerine o kitaplığı açar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відкриває вікно вибору папки, щоб вибрати папку з бібліотекою TextMouth, яку TextMouth потім відкриє замість поточної."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فولڈر منتخب کرنے کی ونڈو کھولتا ہے تاکہ ایسا فولڈر چنا جا سکے جس میں TextMouth لائبریری ہو، جسے TextMouth پھر کھولتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mở hộp thoại chọn thư mục để chọn thư mục chứa thư viện TextMouth, rồi TextMouth mở thư viện đó thay thế."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "打开文件夹选择器，选取包含 TextMouth 资料库的文件夹，TextMouth 会改为打开该资料库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "打開檔案夾選擇器，選擇存放 TextMouth 書庫的檔案夾，TextMouth 隨後會改為打開它。"
          }
        }
      }
    },
    "storageLocation.chooserHint.receives" : {
      "comment" : "VoiceOver hint of the Change Location button in Storage settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يفتح أداة اختيار مجلد. يتلقى المجلد الفارغ نسخة من المكتبة؛ ويمكن استخدام مجلد يحتوي على مكتبة TextMouth كما هو."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "একটি ফোল্ডার চয়নকারী খোলে। খালি ফোল্ডার লাইব্রেরির একটি কপি পায়; TextMouth লাইব্রেরি আছে এমন ফোল্ডার যেমন আছে তেমনই ব্যবহার করা যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffnet eine Ordnerauswahl. Ein leerer Ordner erhält eine Kopie der Bibliothek; ein Ordner mit einer TextMouth-Bibliothek kann unverändert verwendet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens a folder chooser. An empty folder receives a copy of the library; a folder that holds a TextMouth library can be used as it is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre un selector de carpetas. Una carpeta vacía recibe una copia de la biblioteca; una carpeta que contenga una biblioteca de TextMouth se puede usar tal como está."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یک انتخابگر پوشه باز می‌کند. پوشه‌ی خالی یک نسخه از کتابخانه دریافت می‌کند؛ از پوشه‌ای که کتابخانه‌ی TextMouth در آن است می‌توان همان‌طور که هست استفاده کرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ouvre un sélecteur de dossier. Un dossier vide reçoit une copie de la bibliothèque ; un dossier contenant une bibliothèque TextMouth peut être utilisé tel quel."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "פותח בורר תיקיות. תיקייה ריקה מקבלת עותק של הספרייה; תיקייה שמכילה ספריית TextMouth אפשר להשתמש בה כמות שהיא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ोल्डर चुनने की विंडो खोलता है। खाली फ़ोल्डर में लाइब्रेरी की प्रति रखी जाती है; TextMouth लाइब्रेरी वाले फ़ोल्डर का सीधे उपयोग किया जा सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuka pemilih folder. Folder kosong menerima salinan pustaka; folder yang berisi pustaka TextMouth dapat digunakan apa adanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apre un selettore di cartelle. Una cartella vuota riceve una copia della libreria; una cartella che contiene una libreria di TextMouth può essere usata così com’è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フォルダ選択を開きます。空のフォルダにはライブラリのコピーが作成され、TextMouth ライブラリを含むフォルダはそのまま使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "폴더 선택 창을 엽니다. 빈 폴더에는 보관함의 사본이 만들어지고, TextMouth 보관함이 들어 있는 폴더는 그대로 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Opent een mapkiezer. Een lege map krijgt een kopie van de bibliotheek; een map met een TextMouth-bibliotheek kan worden gebruikt zoals die is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Otwiera okno wyboru folderu. Pusty folder otrzyma kopię biblioteki; folder zawierający bibliotekę TextMouth może zostać użyty bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre um seletor de pastas. Uma pasta vazia recebe uma cópia da biblioteca; uma pasta que contenha uma biblioteca do TextMouth pode ser usada como está."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Открывает окно выбора папки. В пустую папку копируется библиотека; папку с библиотекой TextMouth можно использовать как есть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öppnar en mappväljare. En tom mapp får en kopia av biblioteket; en mapp som innehåller ett TextMouth-bibliotek kan användas som den är."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เปิดหน้าต่างเลือกโฟลเดอร์ โฟลเดอร์ว่างจะได้รับสำเนาของไลบรารี ส่วนโฟลเดอร์ที่มีไลบรารี TextMouth ใช้ได้ทันที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Klasör seçici açar. Boş bir klasör kitaplığın bir kopyasını alır; TextMouth kitaplığı içeren bir klasör olduğu gibi kullanılabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відкриває вікно вибору папки. Порожня папка отримає копію бібліотеки; папку з бібліотекою TextMouth можна використати як є."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فولڈر منتخب کرنے کی ونڈو کھولتا ہے۔ خالی فولڈر کو لائبریری کی کاپی ملتی ہے؛ جس فولڈر میں TextMouth لائبریری ہو اسے جوں کا توں استعمال کیا جا سکتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mở hộp thoại chọn thư mục. Thư mục trống nhận một bản sao của thư viện; thư mục chứa thư viện TextMouth có thể dùng nguyên trạng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "打开文件夹选择器。空文件夹会接收资料库的拷贝；包含 TextMouth 资料库的文件夹可以直接使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "打開檔案夾選擇器。空檔案夾會收到書庫的副本；存放 TextMouth 書庫的檔案夾可以直接使用。"
          }
        }
      }
    },
