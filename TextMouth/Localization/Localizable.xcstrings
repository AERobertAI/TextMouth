    "leadingArticle.languagesNote.portuguese" : {
      "comment" : "First sentence of the note under the Leading Articles pop-up, shown where articles are ignored. Names the languages whose articles TextMouth skips; Le, Die, and The are example articles and stay as written.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عند تجاهل أدوات التعريف، يتجاوز الكتاب الذي تذكر بياناته الوصفية الفرنسية أو الألمانية أو الإسبانية أو الإيطالية أو البرتغالية أو الهولندية أو الكتالونية أو السويدية أو الدنماركية أو النرويجية أدوات التعريف في تلك اللغة، مثل Le وDie، وكذلك The."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "যখন আর্টিকল উপেক্ষা করা হয়, তখন যে বইয়ের মেটাডেটায় ফরাসি, জার্মান, স্প্যানিশ, ইতালীয়, পর্তুগিজ, ডাচ, কাতালান, সুইডিশ, ড্যানিশ বা নরওয়েজীয় ভাষার নাম আছে, সেটি ওই ভাষার আর্টিকল, যেমন Le ও Die, এবং The বাদ দেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wenn Artikel ignoriert werden, übergeht TextMouth bei einem Buch, dessen Metadaten Französisch, Deutsch, Spanisch, Italienisch, Portugiesisch, Niederländisch, Katalanisch, Schwedisch, Dänisch oder Norwegisch nennen, die Artikel dieser Sprache, etwa „Le“ und „Die“, sowie „The“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When articles are ignored, a book whose metadata names French, German, Spanish, Italian, Portuguese, Dutch, Catalan, Swedish, Danish, or Norwegian passes over that language's articles, such as Le and Die, and The."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cuando se ignoran los artículos, un libro cuyos metadatos indican francés, alemán, español, italiano, portugués, neerlandés, catalán, sueco, danés o noruego omite los artículos de ese idioma, como Le y Die, además de The."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "وقتی حروف تعریف نادیده گرفته می‌شوند، کتابی که فراداده‌اش فرانسوی، آلمانی، اسپانیایی، ایتالیایی، پرتغالی، هلندی، کاتالان، سوئدی، دانمارکی یا نروژی را نام می‌برد، حروف تعریف آن زبان، مانند Le و Die، و The را نادیده می‌گیرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quand les articles sont ignorés, un livre dont les métadonnées indiquent le français, l’allemand, l’espagnol, l’italien, le portugais, le néerlandais, le catalan, le suédois, le danois ou le norvégien ignore les articles de cette langue, comme Le et Die, ainsi que The."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כאשר מתעלמים ממילות יידוע, ספר שהמטא-נתונים שלו מציינים צרפתית, גרמנית, ספרדית, איטלקית, פורטוגזית, הולנדית, קטלאנית, שוודית, דנית או נורווגית מדלג על מילות היידוע של אותה שפה, כמו Le ו-Die, ועל The."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "जब आर्टिकल अनदेखे किए जाते हैं, तब जिस पुस्तक के मेटाडेटा में फ़्रेंच, जर्मन, स्पेनिश, इतालवी, पुर्तगाली, डच, कैटलन, स्वीडिश, डेनिश या नॉर्वेजियन भाषा लिखी हो, वह उस भाषा के आर्टिकल, जैसे Le और Die, और The छोड़ देती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saat kata sandang diabaikan, buku yang metadatanya menyebut bahasa Prancis, Jerman, Spanyol, Italia, Portugis, Belanda, Katalan, Swedia, Denmark, atau Norwegia mengabaikan kata sandang bahasa itu, seperti Le dan Die, serta The."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quando gli articoli vengono ignorati, un libro i cui metadati indicano francese, tedesco, spagnolo, italiano, portoghese, olandese, catalano, svedese, danese o norvegese ignora gli articoli di quella lingua, come Le e Die, e The."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "冠詞を無視する場合、メタデータの言語がフランス語、ドイツ語、スペイン語、イタリア語、ポルトガル語、オランダ語、カタルーニャ語、スウェーデン語、デンマーク語、ノルウェー語のブックでは、その言語の冠詞（Le、Die、The など）を無視します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "관사를 무시하는 경우, 메타데이터에 프랑스어, 독일어, 스페인어, 이탈리아어, 포르투갈어, 네덜란드어, 카탈루냐어, 스웨덴어, 덴마크어 또는 노르웨이어가 지정된 책은 Le, Die 같은 해당 언어의 관사와 The를 건너뜁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Als lidwoorden worden genegeerd, worden bij een boek waarvan de metadata Frans, Duits, Spaans, Italiaans, Portugees, Nederlands, Catalaans, Zweeds, Deens of Noors noemt, de lidwoorden van die taal overgeslagen, zoals Le en Die, en ook The."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gdy przedimki są ignorowane, książka, której metadane wskazują francuski, niemiecki, hiszpański, włoski, portugalski, niderlandzki, kataloński, szwedzki, duński lub norweski, pomija przedimki tego języka, takie jak Le i Die, oraz The."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quando os artigos são ignorados, um livro cujos metadados indicam francês, alemão, espanhol, italiano, português, holandês, catalão, sueco, dinamarquês ou norueguês ignora os artigos desse idioma, como Le e Die, e The."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Если артикли игнорируются, в книге, метаданные которой указывают французский, немецкий, испанский, итальянский, португальский, нидерландский, каталанский, шведский, датский или норвежский язык, пропускаются артикли этого языка, такие как Le и Die, и The."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "När artiklar ignoreras hoppar en bok vars metadata anger franska, tyska, spanska, italienska, portugisiska, nederländska, katalanska, svenska, danska eller norska över det språkets artiklar, som Le och Die, och The."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เมื่อไม่นับคำนำหน้า หนังสือที่ข้อมูลเมตาระบุภาษาฝรั่งเศส เยอรมัน สเปน อิตาลี โปรตุเกส ดัตช์ คาตาลัน สวีเดน เดนมาร์ก หรือนอร์เวย์ จะข้ามคำนำหน้าของภาษานั้น เช่น Le และ Die รวมถึง The"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Artikeller yoksayıldığında, meta verisinde dil olarak Fransızca, Almanca, İspanyolca, İtalyanca, Portekizce, Felemenkçe, Katalanca, İsveççe, Danca veya Norveççe belirtilen bir kitap, o dilin Le ve Die gibi artikellerini ve The kelimesini atlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Коли артиклі ігноруються, книга, метадані якої вказують французьку, німецьку, іспанську, італійську, португальську, нідерландську, каталонську, шведську, данську або норвезьку мову, пропускає артиклі цієї мови, як-от Le і Die, а також The."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جب آرٹیکلز نظر انداز کیے جاتے ہیں، تو جس کتاب کا میٹا ڈیٹا فرانسیسی، جرمن، ہسپانوی، اطالوی، پرتگالی، ڈچ، کیٹالان، سویڈش، ڈینش یا نارویجین بتائے وہ اس زبان کے آرٹیکلز، جیسے Le اور Die، اور The کو چھوڑ دیتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Khi mạo từ bị bỏ qua, sách có siêu dữ liệu ghi tiếng Pháp, Đức, Tây Ban Nha, Ý, Bồ Đào Nha, Hà Lan, Catalan, Thụy Điển, Đan Mạch hoặc Na Uy sẽ bỏ qua các mạo từ của ngôn ngữ đó, như Le và Die, cùng The."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "忽略冠词时，元数据标明法语、德语、西班牙语、意大利语、葡萄牙语、荷兰语、加泰罗尼亚语、瑞典语、丹麦语或挪威语的图书，会略过该语言的冠词，例如 Le、Die 和 The。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "忽略冠詞時，中介資料註明為法文、德文、西班牙文、義大利文、葡萄牙文、荷蘭文、加泰蘭文、瑞典文、丹麥文或挪威文的書籍，會略過該語言的冠詞（例如 Le 和 Die）以及 The。"
          }
        }
      }
    },
