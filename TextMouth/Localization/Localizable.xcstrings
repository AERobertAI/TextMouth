        }
      }
    },
    "bookSettings.saveAsDefaultsLabel" : {
      "comment" : "What VoiceOver calls the buttons that save a text book's voice, speed and pitch as the settings for every book.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
