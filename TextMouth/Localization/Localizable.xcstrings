    "transcriptionError.audioChanged" : {
      "comment" : "Error shown when the book's audio files changed during a transcription, so the transcript was not saved. %@ is the reason, a short phrase in English.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تغيّر صوت الكتاب أثناء تفريغه: %@. فرّغه مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ট্রান্সক্রাইব করার সময় বইয়ের অডিও বদলে গেছে: %@। এটি আবার ট্রান্সক্রাইব করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Audio des Buchs hat sich während der Transkription geändert: %@. Transkribiere es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The book's audio changed while it was being transcribed: %@. Transcribe it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El audio del libro cambió mientras se transcribía: %@. Vuelve a transcribirlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صدای کتاب هنگام رونویسی تغییر کرد: %@. دوباره رونویسی کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’audio du livre a changé pendant sa transcription : %@. Transcrivez-le à nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "השמע של הספר השתנה בזמן התמלול: %@. תמלל אותו שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ट्रांसक्राइब होते समय पुस्तक का ऑडियो बदल गया: %@। इसे फिर से ट्रांसक्राइब करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Audio buku berubah saat sedang ditranskripsikan: %@. Transkripsikan lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’audio del libro è cambiato durante la trascrizione: %@. Trascrivilo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文字起こし中にブックのオーディオが変わりました：%@。もう一度文字起こししてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "대본을 만드는 동안 책의 오디오가 변경되었습니다: %@. 대본을 다시 만드십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De audio van het boek is gewijzigd tijdens het transcriberen: %@. Transcribeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dźwięk książki zmienił się podczas transkrybowania: %@. Transkrybuj go ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O áudio do livro mudou durante a transcrição: %@. Transcreva-o de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Аудио книги изменилось во время расшифровки: %@. Расшифруйте снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bokens ljud ändrades medan det transkriberades: %@. Transkribera det igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เสียงของหนังสือเปลี่ยนไประหว่างการถอดเสียง: %@ ให้ถอดเสียงอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitabın sesi yazıya dökülürken değişti: %@. Yeniden yazıya dökün."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Аудіо книги змінилося під час транскрибування: %@. Транскрибуйте її знову."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ٹرانسکرائب ہوتے وقت کتاب کا آڈیو بدل گیا: %@۔ اسے دوبارہ ٹرانسکرائب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Âm thanh của sách đã thay đổi trong lúc chép lời: %@. Hãy chép lời lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "转录期间图书的音频已更改：%@。请重新转录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "這本書的音訊在轉錄期間已更改：%@。請重新轉錄。"
          }
        }
      }
    },
    "transcriptionError.bookRemoved" : {
      "comment" : "Error shown when the book was removed from the library during a transcription.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "غادر الكتاب المكتبة أثناء التفريغ، لذا لم تُحفظ نسخته النصية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ট্রান্সক্রিপশনের সময় বইটি লাইব্রেরি থেকে চলে গেছে, তাই এর ট্রান্সক্রিপ্ট সংরক্ষণ করা হয়নি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Buch hat die Bibliothek während der Transkription verlassen, daher wurde sein Transkript nicht gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The book left the library during transcription, so its transcript wasn't saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El libro salió de la biblioteca durante la transcripción, así que su transcripción no se guardó."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب هنگام رونویسی از کتابخانه خارج شد، پس رونوشت آن ذخیره نشد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le livre a quitté la bibliothèque pendant la transcription, donc sa transcription n’a pas été enregistrée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הספר עזב את הספרייה במהלך התמלול, ולכן התמליל שלו לא נשמר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ट्रांसक्राइब करने के दौरान पुस्तक लाइब्रेरी से हट गई, इसलिए उसकी ट्रांसक्रिप्ट सहेजी नहीं गई।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Buku meninggalkan pustaka saat transkripsi, jadi transkripnya tidak disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il libro è uscito dalla libreria durante la trascrizione, quindi la trascrizione non è stata salvata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文字起こし中にブックがライブラリから取り除かれたため、文字起こしは保存されませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "대본을 만드는 동안 책이 보관함에서 사라져서 대본이 저장되지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Het boek verliet de bibliotheek tijdens het transcriberen, dus de transcriptie is niet bewaard."
