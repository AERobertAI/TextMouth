    "repeatedSymbolsSettingsView.neverCollapseLabel" : {
      "comment" : "Label of the checkbox in Settings, Text, Repeated Symbols that makes the voice read every symbol of a run, whatever the style.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عدم الطي أبدًا: قراءة كل رمز"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "কখনও সংকুচিত করবেন না: প্রতিটি চিহ্ন পড়ুন"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie zusammenfassen: jedes Symbol lesen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never collapse: read every symbol"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nunca agrupar: leer todos los símbolos"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هرگز ادغام نشود: خواندن هر نماد"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ne jamais regrouper : lire chaque symbole"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לעולם לא לכווץ: הקרא כל סמל"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कभी न समेटें: हर प्रतीक पढ़ें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jangan ringkas: baca setiap simbol"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non comprimere mai: leggi ogni simbolo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "折りたたまない：すべての記号を読み上げる"
          }
        },
        "ko" : {
