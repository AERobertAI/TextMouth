            "value" : "Rekaman %1$@, %2$@, dibuang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scartata la registrazione del %1$@, %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
