        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সব বই থেকে ক্যাশ করা টেক্সট আবার নিষ্কাশন করে। পার্সারের সংশোধন বা ফরম্যাটের উন্নতির পর কাজে আসে।"
