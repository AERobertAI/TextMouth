          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо його немає, виберіть «%@»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اگر وہ موجود نہیں ہے تو “%@” منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
