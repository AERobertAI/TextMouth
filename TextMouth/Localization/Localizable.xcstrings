    "bookSettings.saveAsDefaultsHint" : {
      "comment" : "Hint and tooltip of the buttons that save a text book's voice, speed and pitch as the settings for every book.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحدّث الصوت والسرعة وطبقة الصوت الافتراضية لكل كتاب ليس له إعدادات خاصة به."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "যেসব বইয়ের নিজস্ব সেটিংস নেই, সেগুলোর জন্য ডিফল্ট ভয়েস, গতি ও পিচ হালনাগাদ করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aktualisiert die Standardstimme, -geschwindigkeit und -tonhöhe für jedes Buch ohne eigene Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates the default voice, speed, and pitch for every book without settings of its own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Actualiza la voz, la velocidad y el tono predeterminados de todos los libros que no tienen ajustes propios."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صدا، سرعت و زیر و بمی پیش‌فرض را برای هر کتابی که تنظیمات خودش را ندارد به‌روز می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Met à jour la voix, la vitesse et la hauteur par défaut pour chaque livre sans réglages propres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מעדכן את הקול, המהירות וגובה הצליל המוגדרים כברירת מחדל לכל ספר שאין לו הגדרות משלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "उन सभी पुस्तकों के लिए डिफ़ॉल्ट आवाज़, गति और पिच अपडेट करता है जिनकी अपनी सेटिंग नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Memperbarui suara, kecepatan, dan nada default untuk setiap buku yang tidak memiliki pengaturan sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aggiorna voce, velocità e tono predefiniti per ogni libro senza impostazioni proprie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
