        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चालू होने पर, खोज टेक्स्ट एक ICU रेगुलर एक्सप्रेशन होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
