          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "รายการอ่าน การเรียงลำดับและตัวเลือกการฟังของโฟลเดอร์ และหนังสือที่ไฟล์ยังไม่อยู่ในโฟลเดอร์นี้ จะไม่อยู่ในดัชนี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Okuma listesi, klasörlerin sıralamaları ve dinleme seçenekleri ile dosyaları bu klasörde henüz bulunmayan kitaplar yeni dizinde olmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Список читання, параметри сортування й прослуховування папок і будь-яка книга, файлів якої ще немає в цій папці, до нього не потраплять."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مطالعے کی فہرست، فولڈروں کی ترتیب اور سننے کے اختیارات، اور کوئی بھی کتاب جس کی فائلیں ابھی اس فولڈر میں نہیں ہیں، اس میں شامل نہیں ہوں گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Danh sách đọc, cách sắp xếp và tùy chọn nghe của các thư mục, cùng mọi sách có tệp chưa nằm trong thư mục này sẽ không có trong đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "阅读列表、文件夹的排序和收听选项，以及文件尚未在此文件夹中的图书，都不会在其中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "閱讀列表、檔案夾的排序與聆聽選項，以及檔案尚未在此檔案夾中的任何書籍，都不會在其中。"
          }
        }
      }
    },
