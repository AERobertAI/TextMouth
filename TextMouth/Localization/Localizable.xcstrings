        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transkript %1$@ süresine kadar uzanıyor ve sesin %2$@ olan sonunu aşıyor, bu yüzden başka bir ses içindir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Транскрипція триває до позначки %1$@, за кінцем аудіо на позначці %2$@, тож вона для іншого аудіо."
