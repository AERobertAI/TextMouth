        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@”-এর মাঝপথে ভয়েস থেমে গেছে, এবং TextMouth অপেক্ষা করা বন্ধ করেছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
