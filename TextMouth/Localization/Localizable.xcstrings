          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس فائل کا مارک اپ TextMouth کے پڑھنے کے لیے بہت زیادہ وقت لے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mã đánh dấu của tệp này sẽ khiến TextMouth mất quá nhiều thời gian để đọc."
          }
        },
        "zh-Hans" : {
