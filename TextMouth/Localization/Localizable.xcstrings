    "librarySessionLease.warningMessage.minute" : {
      "comment" : "First sentence of the warning that another Mac has this library open. %@ is that Mac's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth مفتوح أيضًا على “%@” (نشط منذ أقل من دقيقة)."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth “%@”-এও খোলা আছে (এক মিনিটেরও কম আগে সক্রিয় ছিল)।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ist auch auf „%@“ geöffnet (vor weniger als einer Minute aktiv)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth is also open on “%@” (active less than a minute ago)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth también está abierto en “%@” (activo hace menos de un minuto)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth روی «%@» هم باز است (کمتر از یک دقیقه پیش فعال بوده)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth est aussi ouvert sur « %@ » (actif il y a moins d’une minute)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth פתוח גם ב-“%@” (פעיל לפני פחות מדקה)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth “%@” पर भी खुला है (एक मिनट से कम पहले सक्रिय)।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth juga terbuka di “%@” (aktif kurang dari semenit lalu)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth è aperto anche su “%@” (attivo meno di un minuto fa)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は「%@」でも開かれています（1分以内にアクティブ）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 “%@”에서도 열려 있습니다(1분 이내에 활성)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth is ook open op “%@” (minder dan een minuut geleden actief)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth jest otwarty także na komputerze „%@” (aktywny mniej niż minutę temu)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth também está aberto em “%@” (ativo há menos de um minuto)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth также открыт на «%@» (активен менее минуты назад)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth är också öppet på ”%@” (aktivt för mindre än en minut sedan)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth เปิดอยู่บน “%@” ด้วย (ใช้งานเมื่อไม่ถึงหนึ่งนาทีก่อน)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ayrıca “%@” adlı Mac'te de açık (bir dakikadan kısa süre önce etkindi)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth також відкрито на «%@» (активність: менше хвилини тому)."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth “%@” پر بھی کھلا ہے (ایک منٹ سے کم پہلے فعال تھا)۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth cũng đang mở trên “%@” (hoạt động chưa đến một phút trước)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 也在“%@”上打开（不到一分钟前活跃）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 也在「%@」上打開（不到一分鐘前仍在使用）。"
          }
        }
      }
