    "phoneSettings.followInBrailleHint.playing" : {
      "comment" : "First sentence of the hint of Follow in Braille in iPhone Settings. \"Book content\" is the name of the element that holds the book's text, as VoiceOver reads it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أثناء التشغيل، ينقل محتوى الكتاب مع النطق، حتى أثناء قراءتك له."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "চালানোর সময়, আপনি পড়ার সময়েও স্পিচের সঙ্গে বইয়ের বিষয়বস্তুকে এগিয়ে নেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Führt „Buchinhalt“ während der Wiedergabe mit der Sprache weiter, auch während du ihn liest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While playing, moves Book content on with the speech, even as you read it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mientras se reproduce, mueve el contenido del libro junto con la voz, incluso mientras lo lees."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هنگام پخش، «محتوای کتاب» را با گفتار جلو می‌برد، حتی وقتی آن را می‌خوانید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pendant la lecture, fait avancer Contenu du livre avec la voix, même quand vous le lisez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בזמן ניגון, מעביר את תוכן הספר יחד עם הדיבור, גם בזמן הקריאה בו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चलते समय, पुस्तक की सामग्री को स्पीच के साथ आगे बढ़ाता है, आपके उसे पढ़ते समय भी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saat diputar, menggerakkan Isi buku mengikuti ucapan, bahkan saat Anda membacanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Durante la riproduzione, sposta il contenuto del libro insieme alla voce, anche mentre lo leggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "再生中は、読んでいるときでも、読み上げに合わせて「ブックの内容」を進めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "재생하는 동안 책 내용을 음성에 맞춰 이동하며, 읽는 중에도 마찬가지입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Verplaatst tijdens het afspelen Boekinhoud mee met de spraak, ook terwijl je erin leest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Podczas odtwarzania przesuwa Zawartość książki razem z mową, nawet w trakcie czytania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Durante a reprodução, move o Conteúdo do livro junto com a fala, mesmo enquanto você o lê."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Во время воспроизведения продвигает «Содержимое книги» вслед за речью, даже пока вы его читаете."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Under uppspelning flyttas Bokinnehåll fram med uppläsningen, även medan du läser det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ขณะเล่น เลื่อนเนื้อหาหนังสือไปตามเสียงอ่านแม้ขณะที่คุณอ่านอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Oynatılırken Kitap içeriğini, siz okurken bile konuşmayla birlikte ilerletir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Під час відтворення переміщує «Вміст книги» услід за озвученням, навіть коли ви читаєте його."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "چلتے وقت، “کتاب کا مواد” کو اسپیچ کے ساتھ آگے بڑھاتا ہے، چاہے آپ اسے پڑھ رہے ہوں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Khi đang phát, đưa Nội dung sách đi theo giọng đọc, ngay cả khi bạn đang đọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "播放时，让“图书内容”随朗读一起前进，即使你正在阅读它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "播放時，即使你正在閱讀，也會讓「書籍內容」隨朗讀一起前進。"
          }
        }
      }
    },
    "phoneSettings.navigationUnitHint" : {
      "comment" : "Hint of the two iPhone Settings rows that choose a navigation unit, one for text books and one for audiobooks.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ما يتنقل به كتاب من هذا النوع إلى أن تكون له وحدته الخاصة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই ধরনের বই নিজস্ব ইউনিট না পাওয়া পর্যন্ত কিসের ভিত্তিতে এগোয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um welche Einheit ein Buch dieser Art springt, bis es eine eigene hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What a book of this kind moves by until it has a unit of its own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Qué unidad usa un libro de este tipo para moverse hasta que tenga una propia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "واحدی که کتابی از این نوع تا وقتی واحد خودش را ندارد با آن حرکت می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’unité de déplacement d’un livre de ce type, tant qu’il n’a pas la sienne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לפי מה ספר מסוג זה מתקדם עד שיש לו יחידה משלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस तरह की पुस्तक अपनी इकाई मिलने तक किस इकाई से आगे-पीछे जाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Unit gerak untuk buku jenis ini hingga memiliki unit sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cosa usa per spostarsi un libro di questo tipo finché non ha un’unità propria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "この種類のブックに専用の単位が設定されるまで、何を単位に移動するかです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 종류의 책이 자체 단위를 갖기 전까지 이동하는 기준입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Waarmee een boek van dit soort verspringt totdat het een eigen eenheid heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jednostka, według której przesuwa się książka tego rodzaju, dopóki nie ma własnej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A unidade pela qual um livro deste tipo se move até ter uma unidade própria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Единица перехода для книг этого вида, пока у книги нет своей."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vad en bok av det här slaget flyttar med tills den har en egen enhet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หน่วยที่หนังสือประเภทนี้ใช้เลื่อน จนกว่าหนังสือจะมีหน่วยของตัวเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu türden bir kitabın, kendi birimi olana kadar neye göre ilerlediği."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "На яку одиницю переходить книга цього типу, доки не має власної."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "وہ یونٹ جس سے اس قسم کی کتاب آگے بڑھتی ہے، جب تک اس کا اپنا یونٹ نہ ہو۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đơn vị mà sách loại này di chuyển theo cho đến khi sách có đơn vị riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此类图书在拥有自己的单位之前的移动单位。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "這類書籍在擁有自己的單位之前所使用的移動單位。"
          }
        }
      }
    },
