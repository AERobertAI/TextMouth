          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thông báo xuất hiện lại nếu sự cố quay lại sau khi đã hết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "如果问题在消除后再次出现，它会重新显示。"
          }
