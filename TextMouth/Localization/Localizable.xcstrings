    "recording.microphoneConnectedAndChosen" : {
      "comment" : "Said by the Record window when a microphone connects and recordings now use it. %@ is the microphone's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم توصيل %@، لذا تستخدمه التسجيلات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ সংযুক্ত হয়েছে, তাই রেকর্ডিং এটি ব্যবহার করবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ wurde verbunden, daher wird es für Aufnahmen verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ was connected, so recordings use it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ se conectó, así que las grabaciones lo usan."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ وصل شد، پس ضبط‌ها از آن استفاده می‌کنند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Microphone connecté : %@. Les enregistrements l’utilisent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ חובר, ולכן ההקלטות ישתמשו בו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ को कनेक्ट किया गया, इसलिए रिकॉर्डिंग में इसका उपयोग होगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ tersambung, sehingga rekaman memakainya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Microfono %@ collegato: le registrazioni lo usano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@が接続されたため、録音で使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@이(가) 연결되어 이제 녹음에 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ is aangesloten, dus opnamen gebruiken deze microfoon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mikrofon %@ został podłączony, więc nagrania będą z niego korzystać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ foi conectado, então as gravações passam a usá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Микрофон «%@» подключён, теперь запись ведётся с него."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ anslöts, så inspelningar använder den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เชื่อมต่อ %@ แล้ว การบันทึกเสียงจึงใช้อุปกรณ์นี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ bağlandı; kayıtlar artık bunu kullanıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Мікрофон %@ підключено, тож записи використовують його."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ جڑ گیا، اس لیے ریکارڈنگز اسی کو استعمال کریں گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đã kết nối %@, nên bản ghi âm sẽ dùng thiết bị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 已连接，录音将使用它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 已連接，錄音將使用它。"
          }
        }
      }
    },
    "recording.microphoneDisconnected.connect" : {
      "comment" : "Said by the Record window when the chosen microphone is unplugged and no other is connected. %@ is the microphone's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم فصل %@. وصّل ميكروفونًا للتسجيل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ সংযোগ বিচ্ছিন্ন হয়েছে। রেকর্ড করতে একটি মাইক্রোফোন সংযুক্ত করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ wurde getrennt. Verbinde ein Mikrofon, um aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ was disconnected. Connect a microphone to record."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ se desconectó. Conecta un micrófono para grabar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ قطع شد. برای ضبط، میکروفونی وصل کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Microphone déconnecté : %@. Connectez un microphone pour enregistrer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ נותק. חבר מיקרופון כדי להקליט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ को डिस्कनेक्ट किया गया। रिकॉर्ड करने के लिए कोई माइक्रोफ़ोन कनेक्ट करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ terputus. Sambungkan mikrofon untuk merekam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Microfono %@ scollegato. Collega un microfono per registrare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@の接続が解除されました。録音するにはマイクを接続してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 연결이 끊겼습니다. 녹음하려면 마이크를 연결하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ is losgekoppeld. Sluit een microfoon aan om op te nemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mikrofon %@ został odłączony. Podłącz mikrofon, aby nagrywać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ foi desconectado. Conecte um microfone para gravar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Микрофон «%@» отключён. Подключите микрофон, чтобы вести запись."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ kopplades bort. Anslut en mikrofon för att spela in."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตัดการเชื่อมต่อ %@ แล้ว ให้เชื่อมต่อไมโครโฟนเพื่อบันทึกเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ bağlantısı kesildi. Kayıt yapmak için bir mikrofon bağlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Мікрофон %@ відключено. Підключіть мікрофон, щоб записувати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ منقطع ہو گیا۔ ریکارڈ کرنے کے لیے کوئی مائیکروفون جوڑیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đã ngắt kết nối %@. Hãy kết nối micrô để ghi âm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 已断开连接。请连接麦克风以录音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 已中斷連接。請連接麥克風以錄音。"
          }
        }
      }
    },
    "recording.microphoneDisconnected.recordings" : {
      "comment" : "Said by the Record window when the chosen microphone is unplugged and another takes its place. %1$@ is the microphone that went away and %2$@ is the one recordings use now.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم فصل %1$@، لذا تستخدم التسجيلات %2$@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ সংযোগ বিচ্ছিন্ন হয়েছে, তাই রেকর্ডিং %2$@ ব্যবহার করবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ wurde getrennt, daher verwenden Aufnahmen jetzt %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ was disconnected, so recordings use %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ se desconectó, así que las grabaciones usan %2$@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ قطع شد، پس ضبط‌ها از %2$@ استفاده می‌کنند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Microphone déconnecté : %1$@. Les enregistrements utilisent %2$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ נותק, ולכן ההקלטות ישתמשו ב-%2$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ को डिस्कनेक्ट किया गया, इसलिए रिकॉर्डिंग में %2$@ का उपयोग होगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ terputus, sehingga rekaman memakai %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Microfono %1$@ scollegato, quindi le registrazioni usano %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@の接続が解除されたため、録音には%2$@を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 연결이 끊겨 이제 %2$@을(를) 녹음에 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ is losgekoppeld, dus opnamen gebruiken %2$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mikrofon %1$@ został odłączony, więc nagrania będą korzystać z mikrofonu %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ foi desconectado, então as gravações usam %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Микрофон «%1$@» отключён, теперь запись ведётся с микрофона «%2$@»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ kopplades bort, så inspelningar använder %2$@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตัดการเชื่อมต่อ %1$@ แล้ว การบันทึกเสียงจึงใช้ %2$@ แทน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ bağlantısı kesildi, bu yüzden kayıtlar %2$@ kullanıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Мікрофон %1$@ відключено, тож записи використовують %2$@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ منقطع ہو گیا، اس لیے ریکارڈنگز اب %2$@ استعمال کریں گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đã ngắt kết nối %1$@, nên bản ghi âm dùng %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 已断开连接，录音将改用 %2$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 已中斷連接，錄音將改用 %2$@。"
          }
        }
      }
    },
    "recording.microphoneHint" : {
      "comment" : "VoiceOver hint and tooltip of the Microphone pop-up in the Record window. TextMouth is the app's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "الميكروفون الذي يُسجَّل منه. يتذكره TextMouth؛ ولا يتغير الإدخال الذي يستخدمه macOS في أماكن أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "রেকর্ড করার মাইক্রোফোন। TextMouth এটি মনে রাখে; macOS অন্যত্র যে ইনপুট ব্যবহার করে তা বদলায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Mikrofon, mit dem aufgenommen wird. TextMouth merkt es sich; der Eingang, den macOS sonst verwendet, bleibt unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The microphone to record from. TextMouth remembers it; the input macOS uses elsewhere is unchanged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El micrófono con el que se graba. TextMouth lo recuerda; la entrada que macOS usa en otros lugares no cambia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "میکروفونی که از آن ضبط می‌شود. TextMouth آن را به یاد می‌سپارد؛ ورودی‌ای که macOS در جاهای دیگر استفاده می‌کند تغییر نمی‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le microphone avec lequel enregistrer. TextMouth s’en souvient ; l’entrée que macOS utilise ailleurs n’est pas modifiée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "המיקרופון שממנו מקליטים. TextMouth זוכר אותו; הקלט ש-macOS משתמש בו במקומות אחרים אינו משתנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "वह माइक्रोफ़ोन जिससे रिकॉर्ड करना है। TextMouth उसे याद रखता है; macOS जो इनपुट बाकी जगह इस्तेमाल करता है वह नहीं बदलता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mikrofon untuk merekam. TextMouth mengingatnya; input yang dipakai macOS di tempat lain tidak berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il microfono da cui registrare. TextMouth lo ricorda; l’ingresso che macOS usa altrove non cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "録音に使うマイクです。TextMouth が記憶し、macOS がほかで使う入力は変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "녹음에 사용할 마이크입니다. TextMouth가 이 선택을 기억하며, 다른 곳에서 사용하는 macOS 입력 설정은 바뀌지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De microfoon om mee op te nemen. TextMouth onthoudt die; de invoer die macOS elders gebruikt, blijft ongewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mikrofon do nagrywania. TextMouth go zapamiętuje; wejście używane przez macOS w innych miejscach pozostaje bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O microfone para gravar. O TextMouth o memoriza; a entrada que o macOS usa em outros lugares não muda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Микрофон для записи. TextMouth запоминает его; вход, который macOS использует в других местах, не меняется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mikrofonen att spela in från. TextMouth kommer ihåg den. Ingången som macOS använder på andra ställen ändras inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไมโครโฟนที่ใช้บันทึกเสียง โดย TextMouth จะจำไว้ และอินพุตที่ macOS ใช้ในที่อื่นจะไม่เปลี่ยนแปลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kayıt yapılacak mikrofon. TextMouth bunu hatırlar; macOS'in başka yerlerde kullandığı giriş değişmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Мікрофон для запису. TextMouth запам’ятовує його; вхід, який macOS використовує в інших місцях, не змінюється."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ریکارڈ کرنے کا مائیکروفون۔ TextMouth اسے یاد رکھتا ہے؛ macOS میں کہیں اور استعمال ہونے والا ان پٹ تبدیل نہیں ہوتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Micrô để ghi âm. TextMouth ghi nhớ micrô này; đầu vào mà macOS dùng ở nơi khác không thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "用于录音的麦克风。TextMouth 会记住它；macOS 在其他地方使用的输入设备不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "用來錄音的麥克風。TextMouth 會記住它；macOS 在其他地方使用的輸入裝置不會改變。"
          }
        }
      }
    },
