          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "시스템 설정에서 마이크 개인정보 보호 설정을 엽니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Opent de privacy-instellingen voor Microfoon in Systeeminstellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
