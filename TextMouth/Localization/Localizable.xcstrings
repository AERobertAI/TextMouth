        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gỡ bản tải về của sách khỏi thiết bị này khi bạn không mở sách trong khoảng thời gian này. Sách vẫn ở trong iCloud Drive."
