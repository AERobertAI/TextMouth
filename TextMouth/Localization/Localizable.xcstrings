    "readerView.returnHint" : {
      "comment" : "Hint of the reader toolbar's Return button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعود إلى المكان الذي كنت فيه قبل تصفح العناوين الرئيسية أو الإشارات المرجعية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "হেডিং বা বুকমার্ক ঘুরে দেখার আগে যেখানে ছিলেন সেখানে ফিরে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Geht dorthin zurück, wo du vor dem Durchsuchen von Überschriften oder Lesezeichen warst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go back to where you were before browsing headings or bookmarks"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vuelve adonde estabas antes de explorar encabezados o marcadores"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "به جایی که پیش از مرور سرفصل‌ها یا نشانک‌ها بودید برمی‌گردد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Revient à l’endroit où vous étiez avant de parcourir les en-têtes ou les signets."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "חוזר למקום שבו היית לפני העיון בכותרות או בסימניות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "हेडिंग या बुकमार्क देखने से पहले जहाँ थे, वहाँ वापस ले जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kembali ke tempat Anda sebelum menjelajahi tajuk atau markah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Torna al punto in cui eri prima di sfogliare le intestazioni o i segnalibri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "見出しやブックマークを閲覧する前にいた場所に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "표제나 북마크를 둘러보기 전에 있던 위치로 돌아갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gaat terug naar waar je was voordat je door koppen of bladwijzers bladerde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wraca do miejsca sprzed przeglądania nagłówków lub zakładek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Volta para onde você estava antes de navegar pelos cabeçalhos ou marcadores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Возвращает туда, где вы были до просмотра заголовков или закладок."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Går tillbaka dit du var innan du bläddrade bland rubriker eller bokmärken."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "กลับไปยังตำแหน่งก่อนเรียกดูหัวข้อหรือที่คั่นหน้า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Başlıklara ya da yer imlerine göz atmadan önce bulunduğunuz yere geri döner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Повертає туди, де ви були до перегляду заголовків або закладок."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سرخیاں یا بک مارک دیکھنے سے پہلے والی جگہ پر واپس لے جاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quay lại chỗ bạn đã ở trước khi duyệt đề mục hoặc dấu trang."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "返回到浏览章节标题或书签之前所在的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "返回瀏覽標題或書籤之前所在的位置。"
          }
        }
      }
    },
