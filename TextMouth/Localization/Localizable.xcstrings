            "value" : "Hoje"
          }
        }
      }
    },
    "Together with the archives inside it, the archive expands to %@, more than the %@ TextMouth extracts from archives holding audio or other archives." : {
      "comment" : "Why an import's archive was refused when it holds other archives. %1$@ is the total size they expand to, such as \"2 GB\"; %2$@ is the limit for archives that hold audio or other archives.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zusammen mit den darin enthaltenen Archiven wird das Archiv auf %1$@ entpackt, mehr als die %2$@, die TextMouth aus Archiven mit Audio oder anderen Archiven extrahiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Together with the archives inside it, the archive expands to %1$@, more than the %2$@ TextMouth extracts from archives holding audio or other archives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Junto con los archivos comprimidos de su interior, el archivo comprimido se expande a %1$@, más de los %2$@ que TextMouth extrae de archivos comprimidos con audio u otros archivos comprimidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Avec les archives qu’elle contient, l’archive se développe à %1$@, soit plus que les %2$@ que TextMouth extrait des archives contenant de l’audio ou d’autres archives."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Insieme agli archivi al suo interno, l’archivio si espande a %@, più dei %@ che TextMouth estrae da archivi contenenti audio o altri archivi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Junto com os arquivos compactados dentro dele, o arquivo compactado se expande para %1$@, mais do que os %2$@ que o TextMouth extrai de arquivos compactados com áudio ou com outros arquivos compactados."
          }
        }
      }
    },
    "Together with the archives inside it, the archive expands to %@, more than the %@ TextMouth extracts from archives without audio." : {
      "comment" : "Why an import's archive was refused when it holds other archives. %1$@ is the total size they expand to, such as \"2 GB\"; %2$@ is the limit for archives that hold no audio.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zusammen mit den darin enthaltenen Archiven wird das Archiv auf %1$@ entpackt, mehr als die %2$@, die TextMouth aus Archiven ohne Audio extrahiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Together with the archives inside it, the archive expands to %1$@, more than the %2$@ TextMouth extracts from archives without audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Junto con los archivos comprimidos de su interior, el archivo comprimido se expande a %1$@, más de los %2$@ que TextMouth extrae de archivos comprimidos sin audio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Avec les archives qu’elle contient, l’archive se développe à %1$@, soit plus que les %2$@ que TextMouth extrait des archives sans audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Insieme agli archivi al suo interno, l’archivio si espande a %@, più dei %@ che TextMouth estrae da archivi senza audio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Junto com os arquivos compactados dentro dele, o arquivo compactado se expande para %1$@, mais do que os %2$@ que o TextMouth extrai de arquivos compactados sem áudio."
          }
        }
      }
    },
    "Together with the archives inside it, the archive holds %@ files and folders, more than the %@ TextMouth extracts in one import." : {
      "comment" : "Why an import's archive was refused when it holds other archives. %1$@ is how many files and folders they hold in all, already formatted; %2$@ is the limit, already formatted.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zusammen mit den darin enthaltenen Archiven enthält das Archiv %1$@ Dateien und Ordner, mehr als die %2$@, die TextMouth bei einem Import extrahiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Together with the archives inside it, the archive holds %1$@ files and folders, more than the %2$@ TextMouth extracts in one import."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Junto con los archivos comprimidos de su interior, el archivo comprimido contiene %1$@ archivos y carpetas, más de los %2$@ que TextMouth extrae en una importación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Avec les archives qu’elle contient, l’archive contient %1$@ fichiers et dossiers, soit plus que les %2$@ que TextMouth extrait en une seule importation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Insieme agli archivi al suo interno, l’archivio contiene %@ file e cartelle, più dei %@ che TextMouth estrae in una sola importazione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Junto com os arquivos compactados dentro dele, o arquivo compactado contém %1$@ arquivos e pastas, mais do que os %2$@ que o TextMouth extrai em uma importação."
          }
        }
      }
    },
    "Toggle Bookmark" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Bookmarks group and read by VoiceOver. Adds a bookmark at the reading position, or removes the one there. Also the title of the menu command of the same name.",
