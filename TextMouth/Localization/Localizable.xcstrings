        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Типова висота тону для нових книг. 1,0 — нормальна. Кожна книга може змінити її."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نئی کتابوں کے لیے ڈیفالٹ پچ۔ 1.0 عام ہے۔ ہر کتاب اسے تبدیل کر سکتی ہے۔"
