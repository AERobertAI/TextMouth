    "shortcutsSettings.recordingHint" : {
      "comment" : "VoiceOver hint of a keyboard shortcut's key button while it waits for the new key: Escape stops recording.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اضغط المفتاح الجديد، أو Escape للإلغاء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "নতুন কী চাপলে সেটি বেছে নেওয়া হয়; এস্কেপ চাপলে বাতিল হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Drücke die neue Taste oder Escape zum Abbrechen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press the new key, or Escape to cancel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pulsa la nueva tecla, o Esc para cancelar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کلید جدید را فشار دهید، یا برای لغو Escape را بزنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Appuyez sur la nouvelle touche, ou sur Échap pour annuler."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לחץ על המקש החדש, או על Escape לביטול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "नई कुंजी दबाएँ, या रद्द करने के लिए एस्केप दबाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tekan tombol baru, atau Escape untuk membatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Premi il nuovo tasto, oppure Esc per annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "新しいキーを押すか、キャンセルする場合はエスケープキーを押してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "새 키를 누르거나 Escape를 눌러 취소하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Druk op de nieuwe toets, of op Escape om te annuleren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Naciśnij nowy klawisz lub Escape, aby anulować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pressione a nova tecla, ou Esc para cancelar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Нажмите новую клавишу или Escape для отмены."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tryck på den nya tangenten, eller på Escape för att avbryta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "กดแป้นใหม่ หรือกด Escape เพื่อยกเลิก"
          }
        },
        "tr" : {
