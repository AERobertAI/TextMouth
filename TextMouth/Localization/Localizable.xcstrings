          }
        }
      }
    },
    "Adds the new copy to the library as a separate book." : {
      "comment" : "VoiceOver hint of the Keep Both button of the duplicate-book question.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Agrega la copia nueva a la biblioteca como un libro aparte."
