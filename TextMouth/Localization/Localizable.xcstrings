          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menghapus rekaman tanpa menyimpannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elimina la registrazione senza salvarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "録音を保存せずに削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
