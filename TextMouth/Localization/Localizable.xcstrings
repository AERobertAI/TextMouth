        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Триває інший експорт. Його картка вгорі Бібліотеки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ایک اور برآمد جاری ہے۔ اس کا کارڈ لائبریری کے اوپر ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Một lần xuất khác đang chạy. Thẻ của nó ở đầu Thư viện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "另一项导出正在进行。它的卡片位于资料库顶部。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "另一項輸出正在進行。它的卡片位於書庫頂部。"
          }
        }
      }
    },
    "phoneExport.canCloseNow" : {
      "comment" : "Said by VoiceOver on the iPhone's Export sheet when the spoken audio file is being made and the sheet may be closed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يمكنك إغلاق هذا. يستمر التصدير."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আপনি এটি বন্ধ করতে পারেন। রপ্তানি চলতে থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du kannst dies schließen. Der Export läuft weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can close this. The export goes on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Puedes cerrar esto. La exportación continúa."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "می‌توانید این را ببندید. صادر کردن ادامه می‌یابد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vous pouvez fermer ceci. L’exportation continue."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אפשר לסגור את זה. הייצוא נמשך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आप इसे बंद कर सकते हैं। निर्यात जारी रहता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Anda dapat menutup ini. Ekspor terus berjalan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Puoi chiudere questa schermata. L’esportazione continua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
