    },
    "at %@ of %@ in the recording" : {
      "comment" : "Part of the text Copy Reading Position copies, for an audiobook. %1$@ is the time reached and %2$@ the recording's length, both written as clock times such as 2:13:05.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "at %1$@ of %2$@ in the recording"
          }
        }
      }
    },
    "at most %lld, %@" : {
      "comment" : "Library view editor: a clause at the end of a filter's description, said when the view shows only some rows. %1$lld is how many rows at most, a count; %2$@ is how they are chosen, in lower case, such as \"opened last\".",
      "localizations" : {
        "en" : {
          "variations" : {
