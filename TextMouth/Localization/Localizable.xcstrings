    "Books with the same title, regardless of author" : {
      "comment" : "Hint of the Same Title criterion of Find Duplicate Books."
    },
    "Cancel" : {
      "comment" : "Button that closes a sheet or answers a question without doing or changing anything.\nButton that leaves a sheet, panel, or question without making its change, such as the panel for adding a bookmark or editing its note.\nTitle of a button that cancels, in the Substitutions settings' question and rule editor.\nTitle of the button that cancels the removal of the duplicate books selected, in its confirmation.\nTitle of the question's button that keeps the Record window open; it answers the Escape key.",
      "localizations" : {
