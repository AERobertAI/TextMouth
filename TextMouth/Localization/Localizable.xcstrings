          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 正在重建其数据目录。"
          }
        }
      }
    },
    "TextMouth is rebuilding its data directory. Wait until that finishes, then choose %@ again." : {
      "comment" : "Why Replace Existing waits: TextMouth is rebuilding its data directory, the folder that holds the library. %@ is the name of the Replace Existing button, which the sentence asks the user to choose again.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth baut gerade sein Datenverzeichnis neu auf. Warte, bis das beendet ist, und wähle dann erneut %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth está reconstruyendo su directorio de datos. Espera a que termine y vuelve a elegir %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth reconstruit son dossier de données. Attendez la fin, puis choisissez de nouveau %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
