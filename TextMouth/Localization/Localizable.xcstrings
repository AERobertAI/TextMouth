    "The audio can't be edited" : {
      "comment" : "Title of the alert saying the audio editor couldn't open."
    },
    "The audio couldn't be exported." : {
      "comment" : "Said when the audio editor's export fails. A sentence giving the reason follows."
    },
    "The audio couldn't be read." : {
      "comment" : "Said when an audio file that the edits need can't be read as audio."
    },
    "The audio editor for %@ is already open." : {
      "comment" : "Said when Edit Audio… is chosen for a book whose editor is already open; that window comes forward. %@ is the book's title."
    },
    "The audio file “%@” that the edits need is missing from the book." : {
      "comment" : "Said when an audio file that the edits need is missing. %@ is its path inside the book's package."
    },
    "The audio is only in the cloud, not on this Mac yet." : {
