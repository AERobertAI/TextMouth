    "feed.deletesSentence.deletedPermanentlyRecovered" : {
      "comment" : "A sentence of the confirmation before Delete Feed, when files are deleted permanently: what the feed deletes, one thing. %@ is what is deleted.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحذف %@: يُحذف نهائيًا ولا يمكن استرجاعه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এটি %@ মুছে ফেলে: তা স্থায়ীভাবে মুছে যায় এবং ফিরে পাওয়া যায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Endgültig gelöscht wird %@; das lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It deletes %@: it is deleted permanently and cannot be recovered."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elimina %@: se elimina de forma permanente y no se puede recuperar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ را حذف می‌کند: برای همیشه حذف می‌شود و قابل بازیابی نیست."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cela supprime %@ : il est supprimé définitivement et ne peut pas être récupéré."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הפעולה מוחקת: %@. הקבצים נמחקים לצמיתות, ואי אפשר לשחזר אותם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "यह %@ मिटाता है: वह स्थायी रूप से मिट जाता है और वापस नहीं पाया जा सकता।"
