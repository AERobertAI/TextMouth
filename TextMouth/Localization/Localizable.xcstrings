    "importDecisionChoice.replaceExisting" : {
      "comment" : "VoiceOver hint of the Replace Existing button of the duplicate-book question, when both copies are of one kind. \"The existing copy\" is the copy in the library.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يضع النسخة الجديدة مكان الموجودة في المكتبة، مع الاحتفاظ بموضع قراءة النسخة الموجودة وإشاراتها المرجعية وإعداداتها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "নতুন কপিটি লাইব্রেরির আগের কপির জায়গায় রাখে, বিদ্যমান কপির পড়ার অবস্থান, বুকমার্ক ও সেটিংস রেখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ersetzt die vorhandene Kopie in der Bibliothek durch die neue und behält die Leseposition, die Lesezeichen und die Einstellungen der vorhandenen Kopie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puts the new copy in place of the one already in the library, keeping the existing copy's reading position, bookmarks, and settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pone la copia nueva en lugar de la que ya está en la biblioteca, conservando la posición de lectura, los marcadores y los ajustes de la copia existente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نسخه‌ی جدید را به جای نسخه‌ی موجود در کتابخانه می‌گذارد و موقعیت مطالعه، نشانک‌ها و تنظیمات نسخه‌ی موجود را نگه می‌دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Remplace la copie déjà présente dans la bibliothèque par la nouvelle, en conservant la position de lecture, les signets et les réglages de la copie existante."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מציב את העותק החדש במקום העותק שבספרייה, ושומר את מיקום הקריאה, הסימניות וההגדרות של העותק הקיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "नई प्रति को लाइब्रेरी की मौजूदा प्रति की जगह रखता है, मौजूदा प्रति की पठन स्थिति, बुकमार्क और सेटिंग रखते हुए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mengganti salinan yang sudah ada di pustaka dengan salinan baru, dan mempertahankan posisi baca, markah, serta pengaturan salinan yang ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mette la nuova copia al posto di quella già nella libreria, conservando la posizione di lettura, i segnalibri e le impostazioni della copia esistente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "新しいコピーを、ライブラリにすでにあるコピーの代わりに置きます。既存のコピーの読み上げ位置、ブックマーク、設定は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "새 사본을 보관함의 기존 사본 대신 넣고, 기존 사본의 읽기 위치, 북마크, 설정을 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vervangt de bestaande kopie in de bibliotheek door de nieuwe kopie en behoudt de leespositie, bladwijzers en instellingen van de bestaande kopie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wstawia nową kopię w miejsce tej, która jest już w bibliotece, zachowując pozycję czytania, zakładki i ustawienia istniejącej kopii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Coloca a nova cópia no lugar da que já está na biblioteca, mantendo a posição de leitura, os marcadores e os ajustes da cópia existente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ставит новую копию на место копии, уже находящейся в библиотеке, сохраняя позицию чтения, закладки и настройки существующей копии."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ersätter kopian som redan finns i biblioteket med den nya och behåller den befintliga kopians läsposition, bokmärken och inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "นำสำเนาใหม่ไปแทนที่สำเนาที่อยู่ในไลบรารีแล้ว โดยเก็บตำแหน่งการอ่าน ที่คั่นหน้า และการตั้งค่าของสำเนาที่มีอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yeni kopyayı kitaplıktakinin yerine koyar; mevcut kopyanın okuma konumunu, yer imlerini ve ayarlarını korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Замінює наявну в бібліотеці копію новою, зберігаючи позицію читання, закладки й налаштування наявної копії."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نئی کاپی کو لائبریری میں موجود کاپی کی جگہ رکھتا ہے، اور موجودہ کاپی کی مطالعے کی پوزیشن، بک مارکس اور ترتیبات باقی رکھتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đặt bản sao mới thay cho bản đã có trong thư viện, giữ lại vị trí đọc, dấu trang và cài đặt của bản hiện có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "用新副本替换资料库中已有的副本，并保留现有副本的阅读位置、书签和设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "以新副本取代書庫中已有的副本，並保留現有副本的閱讀位置、書籤與設定。"
          }
        }
      }
    },
    "importDecisionChoice.replaceExistingAcrossKinds" : {
      "comment" : "VoiceOver hint of the Replace Existing button of the duplicate-book question, when one copy is an audiobook and the other is not. \"The existing copy\" is the copy in the library.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يضع النسخة الجديدة مكان الموجودة في المكتبة، مع الاحتفاظ بمجلد النسخة الموجودة ومكانها في قائمة القراءة فقط."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "নতুন কপিটি লাইব্রেরির আগের কপির জায়গায় রাখে, শুধু বিদ্যমান কপির ফোল্ডার ও পড়ার তালিকায় এর জায়গা রেখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ersetzt die vorhandene Kopie in der Bibliothek durch die neue und behält nur den Ordner und den Platz der vorhandenen Kopie auf der Leseliste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puts the new copy in place of the one already in the library, keeping only the existing copy's folder and place on the reading list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pone la copia nueva en lugar de la que ya está en la biblioteca, conservando solo la carpeta y el lugar en la lista de lectura de la copia existente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نسخه‌ی جدید را به جای نسخه‌ی موجود در کتابخانه می‌گذارد و فقط پوشه و جایگاه نسخه‌ی موجود در فهرست مطالعه را نگه می‌دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Remplace la copie déjà présente dans la bibliothèque par la nouvelle, en ne conservant que le dossier de la copie existante et sa place dans la liste de lecture."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מציב את העותק החדש במקום העותק שבספרייה, ושומר רק את תיקיית העותק הקיים ואת מקומו ברשימת הקריאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "नई प्रति को लाइब्रेरी की मौजूदा प्रति की जगह रखता है, केवल मौजूदा प्रति का फ़ोल्डर और रीडिंग लिस्ट में उसकी जगह रखते हुए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mengganti salinan yang sudah ada di pustaka dengan salinan baru, dan hanya mempertahankan folder serta posisi salinan yang ada di Daftar Bacaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mette la nuova copia al posto di quella già nella libreria, conservando solo la cartella e la posizione nell’elenco di lettura della copia esistente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "新しいコピーを、ライブラリにすでにあるコピーの代わりに置きます。保持されるのは、既存のコピーのフォルダとリーディングリストでの位置だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "새 사본을 보관함의 기존 사본 대신 넣고, 기존 사본의 폴더와 읽기 목록 위치만 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vervangt de bestaande kopie in de bibliotheek door de nieuwe kopie en behoudt alleen de map en de plaats op de leeslijst van de bestaande kopie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wstawia nową kopię w miejsce tej, która jest już w bibliotece, zachowując tylko folder istniejącej kopii i jej miejsce na liście czytelniczej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Coloca a nova cópia no lugar da que já está na biblioteca, mantendo apenas a pasta e o lugar da cópia existente na lista de leitura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ставит новую копию на место копии, уже находящейся в библиотеке, сохраняя только папку существующей копии и её место в списке для чтения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ersätter kopian som redan finns i biblioteket med den nya och behåller bara den befintliga kopians mapp och plats i läslistan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "นำสำเนาใหม่ไปแทนที่สำเนาที่อยู่ในไลบรารีแล้ว โดยเก็บเฉพาะโฟลเดอร์และตำแหน่งในรายการอ่านของสำเนาที่มีอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yeni kopyayı kitaplıktakinin yerine koyar; yalnızca mevcut kopyanın klasörünü ve Okuma Listesindeki yerini korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Замінює наявну в бібліотеці копію новою, зберігаючи лише папку наявної копії та її місце у списку читання."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نئی کاپی کو لائبریری میں موجود کاپی کی جگہ رکھتا ہے، اور صرف موجودہ کاپی کا فولڈر اور مطالعے کی فہرست میں اس کی جگہ باقی رکھتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đặt bản sao mới thay cho bản đã có trong thư viện, chỉ giữ lại thư mục và vị trí trong danh sách đọc của bản hiện có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "用新副本替换资料库中已有的副本，只保留现有副本的文件夹及其在阅读列表中的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "以新副本取代書庫中已有的副本，只保留現有副本所在的檔案夾與在閱讀列表中的位置。"
          }
        }
      }
    },
