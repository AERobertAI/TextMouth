        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هیچ فایل صوتی‌ای را که TextMouth بتواند وارد کند در پوشه‌ی خودش نام نبرده است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
