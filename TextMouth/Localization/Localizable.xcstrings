        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "टेक्स्ट अपडेट नहीं हुआ: %@ का ट्रांसक्रिप्ट भी बदल गया। पुस्तक अगली बार खुलने पर उसका टेक्स्ट उसी से फिर से लिखा जाता है।"
