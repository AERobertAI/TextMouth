    "miscellaneousSettings.bluetoothHint" : {
      "comment" : "VoiceOver hint of the Enable Bluetooth monitoring switch in the Miscellaneous settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يمنع استئناف التشغيل عند قطع اتصال سماعات الرأس."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "হেডফোন বিচ্ছিন্ন হলে প্লেব্যাক আবার শুরু হওয়া আটকায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Verhindert, dass die Wiedergabe fortgesetzt wird, wenn Kopfhörer getrennt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops playback resuming when headphones disconnect"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Evita que la reproducción se reanude cuando se desconectan los auriculares"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "از ادامه پخش هنگام قطع اتصال هدفون جلوگیری می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Empêche la lecture de reprendre quand les écouteurs sont déconnectés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מונע מהניגון להתחדש כשאוזניות מתנתקות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "हेडफ़ोन डिस्कनेक्ट होने पर प्लेबैक का फिर शुरू होना रोकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mencegah pemutaran berlanjut sendiri saat headphone terputus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impedisce la ripresa della riproduzione quando le cuffie si disconnettono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ヘッドフォンの接続が切れたときに再生が再開しないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "헤드폰 연결이 해제될 때 재생이 다시 시작되지 않게 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voorkomt dat het afspelen hervat wanneer de koptelefoon wordt losgekoppeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zapobiega wznawianiu odtwarzania po odłączeniu słuchawek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impede que a reprodução seja retomada quando os fones se desconectam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не даёт воспроизведению возобновляться при отключении наушников."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hindrar att uppspelningen återupptas när hörlurar kopplas från."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ป้องกันไม่ให้การเล่นเริ่มต่อเมื่อถอดหูฟัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kulaklıklar bağlantıyı kestiğinde oynatmanın devam etmesini engeller."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не дає відтворенню продовжуватися, коли навушники відключаються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ہیڈ فون منقطع ہونے پر پلے بیک کو دوبارہ شروع ہونے سے روکتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ngăn phát lại tiếp tục khi tai nghe ngắt kết nối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "耳机断开时阻止播放自动恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "避免耳機中斷連線時繼續播放。"
          }
        }
      }
    },
