          }
        }
      }
    },
    "Undo or redo back to the audio as last saved." : {
      "comment" : "Ends a message saying the edits need an original audio that is gone: only undoing or redoing back to the audio as last saved helps.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تراجع أو أعد للرجوع إلى الصوت كما حُفظ آخر مرة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Widerrufe oder wiederhole, bis das Audio so ist, wie es zuletzt gesichert wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deshaz o rehaz hasta volver al audio como se guardó por última vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Annulez ou rétablissez pour revenir à l’audio tel qu’il a été enregistré en dernier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पिछली बार सहेजे गए ऑडियो तक पूर्ववत या फिर से करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Urungkan atau ulangi untuk kembali ke audio seperti yang terakhir disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Annulla o ripeti fino all’audio come salvato l’ultima volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "最後に保存した状態のオーディオまで、取り消すかやり直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "마지막으로 저장한 오디오 상태가 될 때까지 실행 취소하거나 다시 실행하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Desfaça ou refaça até voltar ao áudio como foi salvo por último."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Отмените или повторите правки, чтобы вернуться к последнему сохранённому аудио."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Скасуйте або повторіть правки, щоб повернутися до аудіо, збереженого востаннє."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "请通过撤销或重做回到上次存储的音频。"
          }
        }
      }
    },
    "Undoes every edit, back to the original; Redo brings them back." : {
      "comment" : "Hint of the audio editor's Revert to Original button. \"Redo\" is the name of a command.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يتراجع عن كل تعديل حتى الأصل؛ وتعيدها “إعادة”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Widerruft jede Bearbeitung bis zum Original; „Wiederholen“ bringt sie zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deshace todas las ediciones, hasta el original; Rehacer las recupera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Annule toutes les modifications, jusqu’à l’original ; Rétablir les ramène."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "हर संपादन को मूल स्थिति तक पूर्ववत करता है; “फिर से करें” उन्हें वापस लाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mengurungkan setiap edit, kembali ke audio asli; Ulangi mengembalikannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Annulla ogni modifica, fino all’originale; Ripeti le riporta indietro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "すべての編集を元のオーディオまで取り消します。「やり直す」で復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "모든 편집을 원본까지 취소합니다. 다시 실행으로 다시 적용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Desfaz todas as edições, de volta ao original; Refazer as traz de volta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Отменяет все правки до оригинала; «Повторить» возвращает их."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Скасовує всі правки до оригіналу; «Повторити» повертає їх."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "撤销所有编辑，回到原始音频；“重做”可将其恢复。"
          }
        }
      }
    },
