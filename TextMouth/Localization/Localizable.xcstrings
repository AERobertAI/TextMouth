    "Opens a sheet to open a book, import a folder, make a book from text, record audio, or add a feed" : {
      "comment" : "VoiceOver hint of the Add to Library toolbar button. Names the five choices the sheet offers, in the order the sheet lists them.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
