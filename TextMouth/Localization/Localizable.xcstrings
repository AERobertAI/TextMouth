    "duplicateCopy.answerUnderWay" : {
      "comment" : "What an import question says when it is answered again while the previous answer is still being carried out.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يزال TextMouth ينفذ إجابتك الأخيرة. انتظر حتى ينتهي."
