    "bookTextEdit.held" : {
      "comment" : "First part of the message a reader shows in place of a book whose edited text can't be used. %1$@ is the book's title; %2$@ is the reason, a clause that begins in lower case and ends with its full stop.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّر فتح %1$@ لأن نصه المحرَّر غير صالح للاستخدام: %2$@"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ খোলা যাচ্ছে না, কারণ এর সম্পাদিত টেক্সট ব্যবহার করা যাচ্ছে না: %2$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ lässt sich nicht öffnen, solange sein bearbeiteter Text nicht verwendet werden kann: %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ can't open while its edited text can't be used: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ no se puede abrir mientras su texto editado no se pueda usar: %2$@"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ باز نمی‌شود، زیرا متن ویرایش‌شده‌اش قابل استفاده نیست: %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ne peut pas être ouvert tant que son texte modifié est inutilisable : %@"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא ניתן לפתוח את %1$@ כי לא ניתן להשתמש בטקסט הערוך שלו: %2$@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ नहीं खुल सकती, क्योंकि उसका संपादित टेक्स्ट उपयोग नहीं किया जा सकता: %2$@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ tidak dapat dibuka karena teks hasil editnya tidak dapat digunakan: %2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ non può essere aperto perché il suo testo modificato non è utilizzabile: %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "編集したテキストが使用できないため、%1$@を開けません：%2$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "편집한 텍스트를 사용할 수 없어 %1$@을(를) 열 수 없습니다: %2$@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ kan niet worden geopend, omdat de bewerkte tekst niet kan worden gebruikt: %@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie można otworzyć książki %1$@, bo nie można użyć jej edytowanego tekstu: %2$@"
          }
        },
        "pt-BR" : {
