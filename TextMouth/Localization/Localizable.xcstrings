          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede comprobar la copia de iCloud Drive mientras %@ no tiene conexión, así que la descarga se queda."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تا زمانی که %@ آفلاین است، TextMouth نمی‌تواند نسخهٔ iCloud Drive را بررسی کند، بنابراین بارگیری می‌ماند."
