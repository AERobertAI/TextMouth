        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Agregar marcador"
          }
        }
      }
    },
    "Add bookmark" : {
      "comment" : "What VoiceOver says for the playback bar's bookmark button while no bookmark is at the place being read; it adds one."
    },
    "Added %lld books to the reading list." : {
      "comment" : "VoiceOver announcement after several books were added to the reading list. %lld is the number of books added.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
