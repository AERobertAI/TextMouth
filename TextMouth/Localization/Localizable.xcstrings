          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Недостаточно свободного места на диске для преобразования %1$@: нужно %2$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Недостатньо вільного місця на диску для перетворення %1$@: потрібно %2$@ вільного місця."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
