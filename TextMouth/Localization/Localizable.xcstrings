    "feed.movedToLibrary.lists" : {
      "comment" : "What VoiceOver says once Move to Library moved one feed item into the library. The first %@ is the item's title; the second is the library folder, or \"the top of your library\"; the third is the note its feed's row shows, \"In Library\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم نقل “%1$@” إلى %2$@. أصبح كتابًا في المكتبة؛ يعرض الموجز الملاحظة “%3$@”."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” %2$@-এ সরানো হয়েছে। এটি এখন লাইব্রেরির বই, আর এর ফিডে এটি %3$@ হিসেবে দেখানো হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%1$@“ in %2$@ verschoben. Der Eintrag ist jetzt ein Buch in der Bibliothek, und sein Feed zeigt ihn als „%3$@“ an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moved “%@” into %@. It's a library book now, and its feed lists it %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se movió “%1$@” a %2$@. Ahora es un libro de la biblioteca, y su canal lo muestra como %3$@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%1$@» به %2$@ منتقل شد. اکنون کتابی در کتابخانه است و فیدش آن را با وضعیت «%3$@» نشان می‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "« %1$@ » déplacé dans %2$@. C’est maintenant un livre de la bibliothèque, et son flux le signale ainsi : %3$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” הועבר אל %2$@. כעת הוא ספר בספרייה, והערוץ שלו מציג אותו %3$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” को %2$@ में ले जाया गया। अब यह लाइब्रेरी की पुस्तक है, और इसका फ़ीड इसे “%3$@” दिखाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” dipindahkan ke %2$@. Kini menjadi buku pustaka, dan feed-nya mencantumkannya dengan catatan %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Spostato “%1$@” (posizione: %2$@). Ora è un libro della libreria e il suo feed lo elenca con la nota “%3$@”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%1$@」を%2$@に移動しました。ライブラリのブックになり、フィードでは「%3$@」と表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@”을(를) %2$@(으)로 이동했습니다. 이제 보관함의 책이며, 피드에는 “%3$@” 메모가 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” verplaatst naar %2$@. Het is nu een bibliotheekboek en de feed toont het als “%3$@”."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Przeniesiono „%1$@” do: %2$@. To teraz książka w bibliotece, a kanał pokazuje ją jako: %3$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” movido para %2$@. Ele agora é um livro da biblioteca, e o feed dele o lista como “%3$@”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Перемещено в %2$@: «%1$@». Теперь это книга библиотеки, и в ленте у неё пометка «%3$@»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Flyttade ”%1$@” till %2$@. Den är en biblioteksbok nu, och dess flöde listar den som %3$@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ย้าย “%1$@” ไปยัง %2$@ แล้ว ตอนนี้เป็นหนังสือในไลบรารี และฟีดของรายการแสดงเป็น %3$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” taşındı (%2$@). Artık bir kitaplık kitabı; beslemesi onu şöyle listeler: %3$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%1$@» переміщено. Розташування: %2$@. Тепер це книга бібліотеки, а її стрічка показує «%3$@»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” کو %2$@ میں منتقل کر دیا گیا۔ یہ اب لائبریری کی کتاب ہے، اور اس کی فیڈ اسے %3$@ کے طور پر دکھاتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đã chuyển “%1$@” vào %2$@. Giờ nó là sách trong thư viện, và nguồn cấp của nó liệt kê nó với ghi chú %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "已将“%1$@”移到 %2$@。它现在是资料库中的图书，其订阅源将其标注为“%3$@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "已將「%1$@」移入 %2$@。它現在是書庫中的書籍，其訂閱源會將它標註為「%3$@」。"
          }
        }
      }
