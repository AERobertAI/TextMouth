          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sommige woorden van macOS zelf veranderen pas bij de volgende start van TextMouth."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Niektóre słowa samego systemu macOS zmienią się przy następnym otwarciu TextMouth."
