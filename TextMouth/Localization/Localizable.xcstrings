        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo compactado contém mais do que os %@ que ele declara, então a extração parou."
          }
        }
      }
    },
    "The archive is damaged, incomplete, or not a ZIP archive." : {
      "comment" : "Why an archive was refused at import: it could not be read as a ZIP archive.",
      "localizations" : {
