    "speechExportError.busy" : {
      "comment" : "Why a spoken audio export was refused: another one is running.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يصدّر TextMouth ملفًا صوتيًا منطوقًا واحدًا في كل مرة. صدّر هذا بعد انتهاء الحالي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth একবারে একটি পড়ে শোনানো অডিও ফাইল রপ্তানি করে। বর্তমানটি শেষ হলে এটি রপ্তানি করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth exportiert jeweils eine gesprochene Audiodatei. Exportiere dies, sobald der aktuelle Export beendet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth exports one spoken audio file at a time. Export this once the current one has finished."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth exporta un solo archivo de audio hablado a la vez. Exporta esto cuando termine el actual."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth هر بار یک فایل صدای گفتاری صادر می‌کند. این را پس از پایان فایل فعلی صادر کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth n’exporte qu’un fichier audio parlé à la fois. Exportez celui-ci une fois le fichier en cours terminé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth מייצא קובץ שמע מוקרא אחד בכל פעם. ייצא את זה אחרי שהנוכחי יסתיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth एक बार में एक बोली गई ऑडियो फ़ाइल निर्यात करता है। मौजूदा निर्यात पूरा होने पर इसे निर्यात करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth mengekspor satu file audio ucapan dalam satu waktu. Ekspor lagi setelah ekspor yang sedang berjalan selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth esporta un solo file audio parlato alla volta. Esporta questo quando quello in corso sarà terminato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth が読み上げオーディオファイルを書き出せるのは、一度に1つだけです。現在のものが終わってから、これを書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth는 음성 오디오 파일을 한 번에 하나씩 내보냅니다. 현재 내보내기가 끝난 후에 이것을 내보내십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth exporteert één gesproken audiobestand tegelijk. Exporteer dit zodra het huidige klaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth eksportuje jeden plik dźwięku mówionego naraz. Wyeksportuj ten po zakończeniu bieżącego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth exporta um arquivo de áudio falado por vez. Exporte este quando o atual terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth может экспортировать только один озвученный аудиофайл за раз. Запустите этот экспорт после завершения текущего."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth exporterar en uppläst ljudfil åt gången. Exportera den här när den pågående är klar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ส่งออกไฟล์เสียงอ่านได้ครั้งละหนึ่งไฟล์ ส่งออกสิ่งนี้เมื่อไฟล์ปัจจุบันเสร็จแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth aynı anda tek bir seslendirilmiş ses dosyası dışa aktarır. Bunu, şimdikinin bitmesinden sonra dışa aktarın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth експортує по одному озвученому аудіофайлу. Експортуйте це, коли поточний завершиться."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ایک وقت میں ایک بولی گئی آڈیو فائل برآمد کرتا ہے۔ موجودہ برآمد مکمل ہونے کے بعد اسے برآمد کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth chỉ xuất một tệp âm thanh đọc mỗi lần. Hãy xuất mục này sau khi lần xuất hiện tại hoàn tất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 一次只能导出一个朗读音频文件。请在当前导出完成后再导出此项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 一次只能輸出一個語音音訊檔案。請在目前的輸出完成後再輸出這個。"
          }
        }
      }
    },
    "speechExportError.headingsChanged" : {
      "comment" : "Why a spoken audio export was refused: the book's headings changed after the Export dialog opened.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تغيّرت العناوين الرئيسية للكتاب بعد فتح مربع الحوار. أعد فتحه واختر النطاق مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ডায়ালগ খোলার পরে বইয়ের হেডিং বদলে গেছে। এটি আবার খুলুন এবং পরিসর আবার বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Überschriften des Buchs haben sich geändert, nachdem der Dialog geöffnet wurde. Öffne ihn erneut und wähle den Bereich noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The book's headings changed after the dialog opened. Reopen it and choose the range again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los encabezados del libro cambiaron después de abrir el diálogo. Ábrelo de nuevo y vuelve a elegir el intervalo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سرفصل‌های کتاب پس از باز شدن پنجره تغییر کردند. دوباره آن را باز کنید و بازه را دوباره انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les en-têtes du livre ont changé après l’ouverture de la fenêtre. Rouvrez-la et choisissez de nouveau la plage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כותרות הספר השתנו אחרי שהחלון נפתח. פתח אותו שוב ובחר את הטווח מחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "डायलॉग खुलने के बाद पुस्तक की हेडिंग बदल गईं। इसे फिर खोलें और रेंज दोबारा चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tajuk buku berubah setelah dialog dibuka. Buka kembali dan pilih rentangnya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le intestazioni del libro sono cambiate dopo l’apertura della finestra. Riaprila e scegli di nuovo l’intervallo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ダイアログを開いた後に、ブックの見出しが変わりました。開き直して、範囲をもう一度選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "대화 상자를 연 후 책의 표제가 바뀌었습니다. 다시 열어 범위를 다시 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De koppen van het boek zijn gewijzigd nadat het venster werd geopend. Open het opnieuw en kies het bereik opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nagłówki książki zmieniły się po otwarciu okna. Otwórz je ponownie i wybierz zakres jeszcze raz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Os cabeçalhos do livro mudaram depois que a janela abriu. Abra-a de novo e escolha o intervalo outra vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Заголовки книги изменились после открытия диалога. Откройте его снова и выберите диапазон заново."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bokens rubriker ändrades efter att rutan öppnades. Öppna den igen och välj intervallet på nytt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หัวข้อของหนังสือเปลี่ยนไปหลังจากเปิดกล่องโต้ตอบ เปิดใหม่แล้วเลือกช่วงอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitabın başlıkları pencere açıldıktan sonra değişti. Pencereyi yeniden açıp aralığı tekrar seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Заголовки книги змінилися після відкриття діалогу. Відкрийте його знову та виберіть діапазон ще раз."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ڈائیلاگ کھلنے کے بعد کتاب کی سرخیاں بدل گئیں۔ اسے دوبارہ کھولیں اور حد دوبارہ منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Các đề mục của sách đã thay đổi sau khi hộp thoại mở. Hãy mở lại hộp thoại và chọn lại phạm vi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "对话框打开后，图书的章节标题发生了变化。请重新打开对话框并再次选取范围。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "對話框打開後，書籍的標題已更改。請重新打開，再次選擇範圍。"
          }
        }
      }
    },
    "speechExportError.noVoice" : {
      "comment" : "Why a spoken audio export was refused: no voice is installed. System Settings, Accessibility, and Spoken Content are the names of macOS settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يوجد صوت مثبّت. أضف صوتًا في إعدادات النظام، تسهيلات الاستخدام، المحتوى المنطوق، ثم صدّر مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "কোনো ভয়েস ইনস্টল করা নেই। সিস্টেম সেটিংস, অ্যাক্সেসিবিলিটি, স্পোকেন কনটেন্টে একটি যোগ করুন, তারপর আবার রপ্তানি করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es ist keine Stimme installiert. Füge in den Systemeinstellungen unter „Bedienungshilfen“, „Gesprochene Inhalte“ eine hinzu und exportiere dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No voice is installed. Add one in System Settings, Accessibility, Spoken Content, then export again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay ninguna voz instalada. Agrega una en Ajustes del Sistema, Accesibilidad, Contenido leído, y vuelve a exportar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هیچ صدایی نصب نشده است. یکی را در System Settings، Accessibility، Spoken Content اضافه کنید، سپس دوباره صادر کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucune voix n’est installée. Ajoutez-en une dans Réglages Système, Accessibilité, Contenu énoncé, puis exportez de nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אין קול מותקן. הוסף קול בהגדרות המערכת, “נגישות”, “תוכן מדובר”, ואז ייצא שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कोई आवाज़ इंस्टॉल नहीं है। सिस्टम सेटिंग, एक्सेसिबिलिटी, बोली जाने वाली सामग्री में एक जोड़ें, फिर दोबारा निर्यात करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tidak ada suara yang terpasang. Tambahkan satu di Pengaturan Sistem, Aksesibilitas, Konten Ucapan, lalu ekspor lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nessuna voce installata. Aggiungine una in Impostazioni di Sistema, Accessibilità, Contenuti letti ad alta voce, poi esporta di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "インストールされている声がありません。「システム設定」の「アクセシビリティ」の「読み上げコンテンツ」で追加してから、もう一度書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "설치된 음성이 없습니다. 시스템 설정, 손쉬운 사용, 읽기 및 말하기에서 음성을 추가한 다음 다시 내보내십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Er is geen stem geïnstalleerd. Voeg er een toe in Systeeminstellingen, Toegankelijkheid, Gesproken materiaal, en exporteer daarna opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie zainstalowano żadnego głosu. Dodaj go w: Ustawienia systemowe, Dostępność, Treść mówiona, a potem wyeksportuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nenhuma voz está instalada. Adicione uma em Ajustes do Sistema, Acessibilidade, Conteúdo falado e exporte novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не установлено ни одного голоса. Добавьте голос в «Системные настройки», «Универсальный доступ», «Устный контент», затем экспортируйте снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ingen röst är installerad. Lägg till en i ”Systeminställningar”, ”Hjälpmedel”, ”Uppläst innehåll”, och exportera sedan igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไม่ได้ติดตั้งเสียงใด เพิ่มเสียงในการตั้งค่าระบบ การช่วยการเข้าถึง เนื้อหาที่พูด แล้วส่งออกอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yüklü ses yok. Sistem Ayarları, Erişilebilirlik, Konuşulan İçerik bölümünden bir ses ekleyin, sonra yeniden dışa aktarın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Жодного голосу не встановлено. Додайте голос: Системні параметри, Доступність, Усний вміст, а потім експортуйте знову."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کوئی آواز انسٹال نہیں ہے۔ سسٹم ترتیبات، رسائی، بولا جانے والا مواد میں ایک شامل کریں، پھر دوبارہ برآمد کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chưa cài đặt giọng nói nào. Hãy thêm một giọng trong Cài đặt hệ thống, Trợ năng, Nội dung được đọc, rồi xuất lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "未安装语音。请在“系统设置”的“辅助功能”中，于“朗读内容”添加，然后再次导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "尚未安裝語音。請在「系統設定」的「輔助使用」中，於「語音內容」加入語音，然後再次輸出。"
          }
        }
      }
    },
    "speechExportError.noVoice.iphone" : {
      "comment" : "Why a spoken audio export was refused on the iPhone: no voice is installed. Settings, Accessibility, and Spoken Content are the names of iOS settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يوجد صوت مثبّت. أضف صوتًا في الإعدادات، تسهيلات الاستخدام، المحتوى المنطوق، ثم صدّر مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "কোনো ভয়েস ইনস্টল করা নেই। সেটিংস, অ্যাক্সেসিবিলিটি, স্পোকেন কনটেন্টে একটি যোগ করুন, তারপর আবার রপ্তানি করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es ist keine Stimme installiert. Füge in den Einstellungen unter „Bedienungshilfen“, „Gesprochene Inhalte“ eine hinzu und exportiere dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No voice is installed. Add one in Settings, Accessibility, Spoken Content, then export again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay ninguna voz instalada. Agrega una en Ajustes, Accesibilidad, Contenido leído, y vuelve a exportar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هیچ صدایی نصب نشده است. یکی را در Settings، Accessibility، Spoken Content اضافه کنید، سپس دوباره صادر کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucune voix n’est installée. Ajoutez-en une dans Réglages, Accessibilité, Contenu énoncé, puis exportez de nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אין קול מותקן. הוסף קול בהגדרות, “נגישות”, “תוכן מדובר”, ואז ייצא שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कोई आवाज़ इंस्टॉल नहीं है। सेटिंग, एक्सेसिबिलिटी, बोली जाने वाली सामग्री में एक जोड़ें, फिर दोबारा निर्यात करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tidak ada suara yang terpasang. Tambahkan satu di Pengaturan, Aksesibilitas, Konten Ucapan, lalu ekspor lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nessuna voce installata. Aggiungine una in Impostazioni, Accessibilità, Contenuti letti ad alta voce, poi esporta di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "インストールされている声がありません。「設定」の「アクセシビリティ」の「読み上げコンテンツ」で追加してから、もう一度書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "설치된 음성이 없습니다. 설정, 손쉬운 사용, 읽기 및 말하기에서 음성을 추가한 다음 다시 내보내십시오."
