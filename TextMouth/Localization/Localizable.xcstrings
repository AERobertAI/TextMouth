            "state" : "machine_translated",
            "value" : "Um endereço de feed, como um link terminado em .rss ou .xml, ou uma página da web que indique o feed."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Адрес ленты, например ссылка, которая заканчивается на .rss или .xml, или веб-страница, где указана её лента."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Адреса стрічки, наприклад посилання, що закінчується на .rss або .xml, або вебсторінка, яка вказує свою стрічку."
          }
        }
      }
    },
    "A feed can have its own %@ choice and its own days before deleting played downloads, in its %@." : {
      "comment" : "The note under the Feeds tab's settings. The first %@ is the name of the List and download choice; the second is the name of the Feed Info sheet.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Feed kann unter %2$@ eine eigene Auswahl für %1$@ und eine eigene Anzahl Tage bis zum Löschen wiedergegebener Downloads haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A feed can have its own %1$@ choice and its own days before deleting played downloads, in its %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un canal puede tener su propia opción de %1$@ y sus propios días antes de eliminar las descargas reproducidas, en su %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un flux peut avoir son propre choix %1$@ et son propre nombre de jours avant la suppression des téléchargements écoutés, dans %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un feed può avere una propria scelta %1$@ e un proprio numero di giorni prima dell’eliminazione dei download riprodotti, nel foglio %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um feed pode ter a própria opção de %1$@ e os próprios dias antes de excluir downloads reproduzidos, em %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "У ленты могут быть собственный выбор %1$@ и собственное число дней до удаления прослушанных загрузок — в листе %2$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Стрічка може мати власний вибір «%1$@» і власну кількість днів до видалення прослуханих завантажень в аркуші «%2$@»."
          }
        }
      }
    },
    "A filter preset needs a name." : {
      "comment" : "Said when a filter preset is saved with a blank name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eine Filtervoreinstellung braucht einen Namen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un preajuste de filtro necesita un nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un préréglage de filtre a besoin d’un nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un preset di filtro ha bisogno di un nome."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uma predefinição de filtro precisa de um nome."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Для пресета фильтра нужно имя."
          }
        }
      }
    },
    "A folder name can't be empty, \".\" or \"..\", end in \".tmb\", or be reserved by TextMouth." : {
      "comment" : "Error shown when a folder's new name is refused: the name is empty, is a single or double dot, ends in .tmb, or is one TextMouth keeps for itself. The quoted pieces are literal text.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Ordnername darf nicht leer, „.“ oder „..“ sein, nicht auf „.tmb“ enden und nicht von TextMouth reserviert sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El nombre de una carpeta no puede estar vacío, ser \".\" ni \"..\", terminar en \".tmb\" ni estar reservado por TextMouth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le nom d’un dossier ne peut pas être vide, « . » ou « .. », se terminer par « .tmb », ni être réservé par TextMouth."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il nome di una cartella non può essere vuoto, “.” o “..”, terminare con “.tmb” né essere riservato da TextMouth."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O nome de uma pasta não pode ser vazio, \".\" ou \"..\", terminar em \".tmb\" nem ser reservado pelo TextMouth."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Имя папки не может быть пустым, равным «.» или «..», оканчиваться на «.tmb» или быть зарезервированным в TextMouth."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Назва папки не може бути порожньою, «.» чи «..», закінчуватися на «.tmb» або бути зарезервованою TextMouth."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文件夹名称不能为空，不能是“.”或“..”，不能以“.tmb”结尾，也不能是 TextMouth 保留的名称。"
          }
        }
      }
    },
    "A folder named %@ already exists in %@." : {
      "comment" : "Error shown when a folder's new name or place is taken. %1$@ is the existing folder's name, in straight double quotes. %2$@ is where it is: its folder's location in straight double quotes, or the name of the library's top level.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Ordner namens %1$@ ist bereits in %2$@ vorhanden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A folder named %1$@ already exists in %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ya existe una carpeta llamada %1$@ en %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un dossier nommé %@ existe déjà dans %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esiste già una cartella chiamata %@ in %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Já existe uma pasta chamada %1$@ em %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Папка с именем %1$@ уже есть в %2$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Папка з назвою %1$@ уже є в %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@ 中已存在名为 %1$@ 的文件夹。"
          }
        }
      }
    },
    "A library in the cloud can take a while: its cloud-only files are downloaded to this Mac to be read." : {
      "comment" : "Sentence of what the Compare Libraries sheet says while it works: a library kept in a cloud drive is slow because files that are only in the cloud are downloaded first.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eine Bibliothek in der Cloud kann eine Weile dauern: Ihre nur in der Cloud liegenden Dateien werden zum Lesen auf diesen Mac geladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una biblioteca en la nube puede tardar: sus archivos que solo están en la nube se descargan en esta Mac para leerlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une bibliothèque dans le cloud peut prendre du temps : ses fichiers qui ne sont que dans le cloud sont téléchargés sur ce Mac pour être lus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una libreria nel cloud può richiedere del tempo: i suoi file presenti solo nel cloud vengono scaricati su questo Mac per essere letti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uma biblioteca na nuvem pode demorar: os arquivos que estão só na nuvem são baixados para este Mac para serem lidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Библиотека в облаке может обрабатываться долго: файлы, которые есть только в облаке, сначала загружаются на этот Mac, чтобы их прочитать."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Бібліотека в хмарі може завантажуватися довго: файли, що є лише в хмарі, завантажуються на цей Mac для читання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "云端资料库可能需要较长时间：仅存在于云端的文件会先下载到这台 Mac 才能读取。"
          }
        }
      }
    },
    "A limit chooses among books, episodes, and articles, never feeds." : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. Show at Most's hint while the view lists feeds alone, when it is dimmed (finding 6).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Limit wählt unter Büchern, Folgen und Artikeln aus, nie unter Feeds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un límite elige entre libros, episodios y artículos, nunca canales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une limite choisit parmi les livres, les épisodes et les articles, jamais les flux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un limite sceglie tra libri, episodi e articoli, mai tra i feed."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um limite escolhe entre livros, episódios e artigos, nunca feeds."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ограничение выбирает только книги, выпуски и статьи, но не ленты."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Обмеження вибирає серед книг, епізодів і статей, але не стрічок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "限制只在图书、单集和文章中选择，不涉及订阅源。"
          }
        }
      }
    },
    "A managed package named %@ already exists." : {
      "comment" : "Why a TextMouth package could not be imported: the library already holds a package of that name. %@ is the package's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein verwaltetes Paket namens %@ ist bereits vorhanden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ya existe un paquete administrado llamado %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un paquet géré nommé %@ existe déjà."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esiste già un pacchetto gestito con il nome %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Já existe um pacote gerenciado chamado %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Управляемый пакет с именем %@ уже существует."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Керований пакет з назвою %@ уже існує."
          }
        }
      }
    },
    "A move shifts one book at a time, and several are selected. Select one book, then try again." : {
      "comment" : "VoiceOver announcement when Move Book Up or Move Book Down is used with several books selected.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Verschoben wird jeweils nur ein Buch, und es sind mehrere ausgewählt. Wähle ein Buch aus und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un movimiento desplaza un libro a la vez, y hay varios seleccionados. Selecciona un solo libro e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un déplacement ne décale qu’un livre à la fois, et plusieurs sont sélectionnés. Sélectionnez un seul livre, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uno spostamento sposta un libro alla volta e ne sono selezionati diversi. Seleziona un solo libro, poi riprova."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um movimento desloca um livro por vez, e há vários selecionados. Selecione um único livro e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Перемещается одна книга за раз, а выбрано несколько. Выберите одну книгу и повторите попытку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Пересувати можна лише одну книгу за раз, а вибрано кілька. Виберіть одну книгу й повторіть спробу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "一次只能移动一本图书，而现在选择了多本。请选择一本图书，然后重试。"
          }
        }
      }
    },
    "A new timer replaces the one running." : {
      "comment" : "Note under the sleep timer sheet's New Timer heading while a timer runs: setting one of the timers below stops it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein neuer Timer ersetzt den laufenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un temporizador nuevo reemplaza al que está en curso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un nouveau minuteur remplace celui en cours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un nuovo timer sostituisce quello in corso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um novo timer substitui o que está em execução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Новый таймер заменит запущенный."
          }
        }
      }
    },
    "A newer TextMouth edited this audio, so this version leaves its edits alone." : {
      "comment" : "Said when the book's saved edit history was written by a later version of TextMouth than this one.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eine neuere Version von TextMouth hat dieses Audio bearbeitet, daher lässt diese Version ihre Bearbeitungen unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una versión más reciente de TextMouth editó este audio, así que esta versión no modifica sus ediciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une version plus récente de TextMouth a modifié cet audio ; cette version laisse ses modifications intactes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una versione più recente di TextMouth ha modificato questo audio, quindi questa versione non tocca le sue modifiche."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uma versão mais recente do TextMouth editou este áudio, então esta versão não mexe nas edições dela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Это аудио изменено более новой версией TextMouth, поэтому эта версия не затрагивает его правки."
          }
        }
      }
    },
    "A number from 2 to 99" : {
      "comment" : "VoiceOver hint of the field that sets the length from which a run of one symbol is collapsed, in Settings, Text, Repeated Symbols.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eine Zahl von 2 bis 99"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un número del 2 al 99"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un nombre de 2 à 99"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un numero da 2 a 99."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um número de 2 a 99"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Число от 2 до 99"
          }
        }
      }
    },
    "A quote isn't closed in “%@”." : {
      "comment" : "Problem found in a typed filter chain: a single quote is opened and never closed. %@ is the text of the part holding it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "In „%@“ ist ein Anführungszeichen nicht geschlossen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Falta cerrar unas comillas en “%@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un guillemet simple n’est pas fermé dans « %@ »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una virgoletta non è chiusa in “%@”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uma aspa simples não foi fechada em “%@”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В «%@» не закрыта кавычка."
          }
        }
      }
    },
    "A run is one symbol repeated, alone or with single spaces, such as * * * * or ====. Speech rewrites runs before the rules above; the screen and braille keep every symbol." : {
      "comment" : "Caption under the controls of Settings, Text, Repeated Symbols that explains what a run is and that only speech changes.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eine Reihe ist ein einzelnes Symbol, das wiederholt wird, allein oder mit einzelnen Leerzeichen, wie * * * * oder ====. Die Sprachausgabe schreibt Reihen vor den obigen Regeln um; der Bildschirm und Braille behalten jedes Symbol."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una serie es un símbolo repetido, solo o con espacios sencillos, como * * * * o ====. La voz reescribe las series antes de aplicar las reglas anteriores; la pantalla y el braille conservan todos los símbolos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une séquence est un même symbole répété, seul ou séparé par des espaces simples, comme * * * * ou ====. La voix réécrit les séquences avant les règles ci-dessus ; l’écran et le braille gardent chaque symbole."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una sequenza è un simbolo ripetuto, da solo o con spazi singoli, come * * * * o ====. La voce riscrive le sequenze prima delle regole qui sopra; lo schermo e il braille mantengono ogni simbolo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uma sequência é um símbolo repetido, sozinho ou com espaços simples, como * * * * ou ====. A fala reescreve as sequências antes das regras acima; a tela e o braille mantêm todos os símbolos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Серия — это один повторяющийся символ, отдельно или через одиночные пробелы, например * * * * или ====. Озвучивание переписывает серии перед правилами выше; на экране и в Брайле остаётся каждый символ."
          }
        }
      }
    },
    "A stretch of the edits runs past the end of “%@”." : {
      "comment" : "Said when an edit names a stretch of a source audio file that lies past the file's end. %@ is the file's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Abschnitt der Bearbeitungen reicht über das Ende von „%@“ hinaus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un tramo de las ediciones llega más allá del final de “%@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une portion des modifications dépasse la fin de « %@ »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una parte delle modifiche va oltre la fine di “%@”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um trecho das edições passa do fim de “%@”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Часть правок выходит за конец файла «%@»."
          }
        }
      }
    },
    "A symbolic link cannot be deleted as a managed book package." : {
      "comment" : "Why a book's files were not deleted: its package is a symbolic link, and deleting it could delete another book. Follows \"Import failed: \".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein symbolischer Link kann nicht als verwaltetes Buchpaket gelöscht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un enlace simbólico no se puede eliminar como paquete de libro administrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un lien symbolique ne peut pas être supprimé comme paquet de livre géré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un collegamento simbolico non può essere eliminato come pacchetto di libro gestito."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um link simbólico não pode ser excluído como um pacote de livro gerenciado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Символическую ссылку нельзя удалить как управляемый пакет книги."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Символічне посилання не можна видалити як керований пакет книги."
          }
        }
      }
    },
    "A transcript is being attached to %@. Transcribe it once that finishes." : {
      "comment" : "Alert shown when Transcribe Audio is chosen for an audiobook that a transcript is being attached to. %@ is the audiobook's title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "An %@ wird gerade ein Transkript angehängt. Transkribiere es, sobald das fertig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se está adjuntando una transcripción a %@. Transcríbelo cuando termine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une transcription est en train d’être jointe à %@. Transcrivez-le une fois l’opération terminée."
