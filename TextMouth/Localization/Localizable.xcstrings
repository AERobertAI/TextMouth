          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เปิดไลบรารีที่ตำแหน่งที่ตั้งเริ่มต้น ~/.TextMouth หรือเริ่มไลบรารีใหม่ที่นั่นแทนไลบรารีที่ไม่พร้อมใช้งาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
