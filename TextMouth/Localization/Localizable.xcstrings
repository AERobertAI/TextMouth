    "audioEditor.chooseTrackExplanation" : {
      "comment" : "Explains the question about which track of a book to edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحرّر مقطعًا واحدًا في كل مرة، والمقاطع مدرجة حسب اسم الفصل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "একবারে একটি ট্র্যাক সম্পাদনা করে; ট্র্যাকগুলো অধ্যায়ের নাম অনুযায়ী তালিকাভুক্ত।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bearbeitet jeweils einen Track, nach Kapitelnamen aufgelistet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edits one track at a time, listed by chapter name."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Edita una pista a la vez, en una lista por nombre de capítulo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هر بار یک تراک را ویرایش می‌کند؛ تراک‌ها بر اساس نام فصل فهرست شده‌اند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Modifie une piste à la fois ; les pistes sont listées par nom de chapitre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "עורך רצועה אחת בכל פעם, לפי שם הפרק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "एक बार में एक ट्रैक संपादित करता है, अध्याय के नाम के अनुसार सूचीबद्ध।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mengedit satu trek dalam satu waktu, tercantum menurut nama bab."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Modifica una traccia alla volta; le tracce sono elencate per nome del capitolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "トラックを1つずつ、チャプタ名の一覧から編集します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "챕터 이름으로 나열된 트랙을 한 번에 하나씩 편집합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wijzigt één track tegelijk, weergegeven per hoofdstuknaam."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Edytuje jedną ścieżkę naraz; ścieżki są wymienione według nazw rozdziałów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Edita uma faixa por vez, listada pelo nome do capítulo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Изменяет по одной дорожке, список составлен по названиям глав."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Redigerar ett spår i taget; spåren listas efter kapitelnamn."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "แก้ไขทีละแทร็ก แสดงรายการตามชื่อบท"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Her seferinde bir parçayı düzenler; parçalar bölüm adına göre listelenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Редагує по одній доріжці; доріжки перелічено за назвами розділів."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ایک وقت میں ایک ٹریک میں ترمیم کرتا ہے، جو باب کے نام سے درج ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sửa từng bản âm thanh một, liệt kê theo tên chương."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "一次编辑一条音轨，按章节名称列出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "一次編輯一個音軌，依章節名稱列出。"
          }
        }
      }
