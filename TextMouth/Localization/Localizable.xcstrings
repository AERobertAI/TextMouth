          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ транскрибується. Скасуйте транскрибування або видаліть транскрипцію, коли воно завершиться."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ٹرانسکرائب کی جا رہی ہے۔ اسے منسوخ کریں، یا ختم ہونے پر ٹرانسکرپٹ حذف کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ đang được chép lời. Hãy hủy, hoặc xóa bản chép lời sau khi hoàn tất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
