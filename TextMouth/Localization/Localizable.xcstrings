        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "팟캐스트 디렉터리가 검색을 거부했습니다. 분당 약 20회까지 허용됩니다. 1분 기다린 다음 다시 시도하십시오."
          }
