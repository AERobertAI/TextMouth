    "importDecision.choice" : {
      "comment" : "First paragraph of the question asked when a book just imported matches one in the library. %1$@ is the new copy's file name (or its title when it came from no file) and %2$@ the title of the library's copy.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” يطابق “%2$@” الموجود بالفعل في مكتبتك. هل تريد استبدال النسخة الموجودة، أم الاحتفاظ بالاثنين ككتابين منفصلين؟"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” আপনার লাইব্রেরিতে থাকা “%2$@”-এর সঙ্গে মেলে। বিদ্যমান কপিটি প্রতিস্থাপন করবেন, নাকি উভয়টি আলাদা বই হিসেবে রাখবেন?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%1$@“ entspricht „%2$@“, das bereits in deiner Bibliothek ist. Vorhandene Kopie ersetzen oder beide als getrennte Bücher behalten?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” matches “%@”, already in your library. Replace the existing copy, or keep both as separate books?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” coincide con “%2$@”, que ya está en tu biblioteca. ¿Quieres reemplazar la copia existente o conservar ambas como libros separados?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%1$@» با «%2$@» که از قبل در کتابخانه‌ی شما است مطابقت دارد. نسخه‌ی موجود جایگزین شود یا هر دو به‌صورت کتاب‌های جداگانه نگه داشته شوند؟"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "« %1$@ » correspond à « %2$@ », déjà dans votre bibliothèque. Remplacer la copie existante, ou conserver les deux comme livres distincts ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” תואם ל-“%2$@”, שכבר נמצא בספרייה שלך. להחליף את העותק הקיים, או לשמור את שניהם כספרים נפרדים?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” “%2$@” से मेल खाती है, जो आपकी लाइब्रेरी में पहले से है। मौजूदा प्रति को बदलें, या दोनों को अलग पुस्तकों के रूप में रखें?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” cocok dengan “%2$@”, yang sudah ada di pustaka Anda. Ganti salinan yang ada, atau pertahankan keduanya sebagai buku terpisah?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” corrisponde a “%2$@”, già nella tua libreria. Sostituire la copia esistente, o conservarle entrambe come libri separati?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%1$@」は、ライブラリにすでにある「%2$@」と一致します。既存のコピーを置き換えますか？それとも、両方を別々のブックとして保持しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@”은(는) 이미 보관함에 있는 “%2$@”와(과) 일치합니다. 기존 사본을 대체하시겠습니까, 아니면 둘 다 별도의 책으로 유지하시겠습니까?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” komt overeen met “%2$@”, dat al in je bibliotheek staat. De bestaande kopie vervangen, of beide bewaren als aparte boeken?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%1$@” odpowiada „%2$@” z Twojej biblioteki. Zastąpić istniejącą kopię czy zachować obie jako osobne książki?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” corresponde a “%2$@”, que já está na sua biblioteca. Substituir a cópia existente ou manter as duas como livros separados?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%1$@» совпадает с «%2$@» из вашей библиотеки. Заменить существующую копию или оставить обе как отдельные книги?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "”%1$@” matchar ”%2$@”, som redan finns i ditt bibliotek. Vill du ersätta den befintliga kopian eller behålla båda som separata böcker?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” ตรงกับ “%2$@” ที่อยู่ในไลบรารีของคุณแล้ว ต้องการแทนที่สำเนาที่มีอยู่ หรือเก็บทั้งสองไว้เป็นหนังสือแยกกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@”, kitaplığınızda zaten bulunan “%2$@” ile eşleşiyor. Mevcut kopya değiştirilsin mi, yoksa ikisi ayrı kitap olarak mı saklansın?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%1$@» збігається з «%2$@», що вже є у вашій бібліотеці. Замінити наявну копію чи зберегти обидві як окремі книги?"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” “%2$@” سے مطابقت رکھتی ہے، جو پہلے ہی آپ کی لائبریری میں ہے۔ موجودہ کاپی کو تبدیل کریں، یا دونوں کو الگ کتابوں کے طور پر رکھیں؟"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” trùng với “%2$@”, đã có trong thư viện của bạn. Thay thế bản hiện có, hay giữ cả hai thành các sách riêng?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@”与资料库中已有的“%2$@”相匹配。要替换现有副本，还是将两者作为单独的图书保留？"
          }
