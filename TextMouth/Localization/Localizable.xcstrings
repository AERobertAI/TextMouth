    "audioEditor.noChapterAfter" : {
      "comment" : "Said when the audio editor's Next Chapter finds no chapter marker after the cursor.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا توجد علامة فصل بعد المؤشر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "কার্সরের পরে কোনো অধ্যায় মার্কার নেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nach dem Cursor gibt es keine Kapitelmarke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No chapter marker after the cursor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay ninguna marca de capítulo después del cursor."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پس از مکان‌نما علامت فصلی نیست."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucun marqueur de chapitre après le curseur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אין נקודת ציון של פרק אחרי הסמן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कर्सर के बाद कोई अध्याय मार्कर नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tidak ada penanda bab setelah kursor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nessun marcatore di capitolo dopo il cursore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "カーソルの後にチャプタマーカーはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
