    "readerTime.settingHint" : {
      "comment" : "Hint and caption of the Playback setting that names the speed beside times. 2.0x and 500 are examples; Where Am I?, Copy Reading Position and the Headings sheet are names of commands and a sheet in the app.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يضيف السرعة التي تُحتسب بها، مثل 2.0x لكتاب صوتي ليس بسرعة 1x، أو 500 كلمة في الدقيقة لكتاب نصي، في القارئ و“أين أنا؟” و“نسخ موضع القراءة” ومدد ورقة العناوين الرئيسية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "রিডারে, “আমি কোথায়?”-এ, “পড়ার অবস্থান কপি করুন”-এ এবং হেডিং শিটের সময়কালে সময় যে গতিতে গোনা হয় তা যোগ করে, যেমন 1x-এ না থাকা অডিওবুকের জন্য 2.0x, বা টেক্সট বইয়ের জন্য মিনিটে 500 শব্দ।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fügt in der Leseansicht, bei „Wo bin ich?“, bei „Leseposition kopieren“ und bei der Anzeige „Dauer“ im Überschriften-Sheet die Geschwindigkeit hinzu, mit der die Zeiten berechnet werden, etwa 2,0x bei einem Hörbuch, das nicht mit 1x läuft, oder 500 Wörter pro Minute bei einem Textbuch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds the speed they count at, such as 2.0x for an audiobook not at 1x, or 500 words a minute for a text book, in the reader, Where Am I?, Copy Reading Position, and the Headings sheet's durations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Agrega la velocidad a la que se cuentan, como 2,0x en un audiolibro que no está a 1x, o 500 palabras por minuto en un libro de texto, en el lector, en ¿Dónde estoy?, en Copiar posición de lectura y en las duraciones de la hoja Encabezados."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سرعتی را که زمان‌ها با آن شمرده می‌شوند، مانند 2.0x برای کتاب صوتی که روی 1x نیست یا 500 کلمه در دقیقه برای کتاب متنی، در کتاب‌خوان، «کجا هستم؟»، «کپی موقعیت مطالعه» و مدت‌های برگه سرفصل‌ها اضافه می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ajoute la vitesse à laquelle les durées sont comptées, par exemple 2,0x pour un livre audio qui n’est pas à 1x, ou 500 mots par minute pour un livre texte, dans le lecteur, Où suis-je ?, Copier la position de lecture et les durées de la feuille En-têtes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מוסיף את המהירות שבה נספרים הזמנים, כגון 2.0x לספר שמע שאינו ב-1x, או 500 מילים בדקה לספר טקסט, בקורא, ב“איפה אני?”, ב“העתק מיקום קריאה” ובמשכי הזמן של גיליון הכותרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "रीडर, “मैं कहाँ हूँ?”, “पठन स्थिति कॉपी करें” और हेडिंग शीट की अवधियों में वह गति जोड़ता है जिस पर समय गिना जाता है, जैसे 1x पर न चल रही ऑडियोबुक के लिए 2.0x, या टेक्स्ट पुस्तक के लिए 500 शब्द प्रति मिनट।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menambahkan kecepatan yang berlaku, seperti 2.0x untuk buku audio yang tidak berada di 1x, atau 500 kata per menit untuk buku teks, di pembaca, Di mana saya?, Salin Posisi Baca, dan durasi pada lembar Tajuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aggiunge la velocità su cui si basano i tempi, ad esempio 2,0x per un audiolibro non a 1x, o 500 parole al minuto per un libro testuale, nel lettore, in Dove sono?, in Copia posizione di lettura e nelle durate del foglio Intestazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "リーダ、「ここはどこ？」、「読書位置をコピー」、見出しシートの長さに、時間の計算に使う速度（1倍速以外のオーディオブックなら2.0x、テキストブックなら毎分500語など）を追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "리더, “내 위치는?”, 읽기 위치 복사, 표제 시트의 길이에 시간을 계산한 기준 속도(1배속이 아닌 오디오북의 2.0x, 텍스트 책의 분당 500단어 등)를 추가합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voegt de snelheid waarmee wordt geteld toe, zoals 2,0x voor een luisterboek dat niet op 1x staat, of 500 woorden per minuut voor een tekstboek, in de lezer, Waar ben ik?, Kopieer leespositie en de duur in het blad Koppen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dodaje prędkość, z jaką liczony jest czas, na przykład 2,0x dla audiobooka odtwarzanego z prędkością inną niż 1x lub 500 słów na minutę dla książki tekstowej, w czytniku, w poleceniach Gdzie jestem? i Kopiuj pozycję czytania oraz w czasach trwania na arkuszu Nagłówki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Adiciona a velocidade em que são contados, como 2,0x para um audiolivro que não está em 1x, ou 500 palavras por minuto para um livro de texto, no leitor, em Onde estou?, em Copiar posição de leitura e nas durações da folha Cabeçalhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Добавляет скорость, с которой считается время, например 2,0x для аудиокниги не на скорости 1x или 500 слов в минуту для текстовой книги, в окне чтения, в «Где я?», в «Скопировать позицию чтения» и в длительностях на листе заголовков."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lägger till hastigheten som tiderna räknas med, till exempel 2,0x för en ljudbok som inte spelas i 1x eller 500 ord i minuten för en textbok, i läsaren, ”Var är jag?”, ”Kopiera läsposition” och rubrikarkets längder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เพิ่มความเร็วที่ใช้นับเวลา เช่น 2.0x สำหรับหนังสือเสียงที่ไม่ได้เล่นที่ 1x หรือ 500 คำต่อนาทีสำหรับหนังสือข้อความ ในตัวอ่าน ฉันอยู่ที่ไหน คัดลอกตำแหน่งการอ่าน และระยะเวลาในชีตหัวข้อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zamanların yanına, sayıldıkları hızı ekler: sesli kitap 1x hızında değilse 2.0x gibi, metin kitabı için dakikada 500 kelime gibi. Okuyucuda, Neredeyim? komutunda, Okuma Konumunu Kopyala komutunda ve Başlıklar açılır sayfasının sürelerinde görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Додає швидкість, з якою рахується час, наприклад 2,0x для аудіокниги не на 1x або 500 слів на хвилину для текстової книги, у вікні читання, у «Де я?», у «Скопіювати позицію читання» і в тривалостях аркуша «Заголовки»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ریڈر، “میں کہاں ہوں؟”، “مطالعے کی پوزیشن کاپی کریں” اور سرخیوں کی شیٹ کے دورانیوں میں اوقات کے ساتھ وہ رفتار شامل کرتا ہے جس پر وہ شمار ہوتے ہیں، جیسے 1x پر نہ ہونے والی آڈیو بک کے لیے 2.0x، یا ٹیکسٹ کتاب کے لیے 500 الفاظ فی منٹ۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thêm tốc độ đang dùng, chẳng hạn 2.0x cho sách nói không ở 1x, hoặc 500 từ mỗi phút cho sách văn bản, trong trình đọc, các lệnh Tôi đang ở đâu và Sao chép vị trí đọc, và thời lượng trong hộp thoại Đề mục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "注明时间所依据的速度（例如非 1 倍速的有声书为 2.0x，文本图书为每分钟 500 字），用于阅读器、“我在哪里”、“拷贝阅读位置”和章节标题表单中的时长。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在閱讀器、「我在哪裡？」、「拷貝閱讀位置」與「標題」工作表的時間長度中，於時間旁註明計算所用的速度，例如非 1x 有聲書的 2.0x，或文字書籍的每分鐘 500 字。"
          }
        }
      }
    },
