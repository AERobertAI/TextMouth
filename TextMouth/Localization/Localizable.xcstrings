        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এডিটরের ফাইল থেকে টেক্সট ফেরত পড়া যায়নি, তাই এখানকার টেক্সট অপরিবর্তিত আছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Text konnte nicht aus der Datei des Editors zurückgelesen werden, daher bleibt der Text hier unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not read the text back from the editor's file, so the text here is unchanged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo volver a leer el texto del archivo del editor, así que el texto de aquí no cambió."
