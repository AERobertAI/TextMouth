    "storageSettings.retrySavingHint" : {
      "comment" : "VoiceOver hint of the Retry Saving button in Storage settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعيد محاولة حفظ كل تغيير تعذّر حفظه."
