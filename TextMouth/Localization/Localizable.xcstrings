            "value" : "La nouvelle copie a remplacé « %@ », mais les fichiers de l’ancienne copie n’ont pas pu être déplacés vers la corbeille et restent dans son dossier : %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La nuova copia ha sostituito «%@», ma i file della vecchia copia non sono stati spostati nel Cestino e restano nella sua cartella: %@"
