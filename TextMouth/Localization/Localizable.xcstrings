    "The file “%@”" : {
      "comment" : "Begins a sentence about a file that could not be read in the text encoding chosen for it, such as \"The file “Ledger.txt” can't be read as Shift JIS (Japanese): …\". %@ is the file's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Datei „%@“"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo “%@”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le fichier « %@ »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il file “%@”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo “%@”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл «%@»"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文件“%@”"
          }
        }
      }
    },
    "The file “%@” declares the text encoding “%@”, but it holds bytes that are not valid in that encoding." : {
      "comment" : "First sentence of why a file could not be imported: an HTML file declares a text encoding its bytes are not valid in. %1$@ is the file's name and %2$@ the encoding's name as the file spells it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Datei „%1$@“ deklariert die Textcodierung „%2$@“, enthält aber Bytes, die in dieser Codierung ungültig sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The file “%1$@” declares the text encoding “%2$@”, but it holds bytes that are not valid in that encoding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo “%1$@” declara la codificación de texto “%2$@”, pero contiene bytes que no son válidos en esa codificación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le fichier « %@ » déclare l’encodage de texte « %@ », mais il contient des octets non valides dans cet encodage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il file “%@” dichiara la codifica del testo “%@”, ma contiene byte non validi in quella codifica."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo “%1$@” declara a codificação de texto “%2$@”, mas contém bytes que não são válidos nessa codificação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл «%1$@» объявляет кодировку текста «%2$@», но содержит байты, недопустимые в этой кодировке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文件“%1$@”声明的文本编码为“%2$@”，但其中含有该编码中无效的字节。"
          }
        }
      }
    },
    "The file “%@” declares the text encoding “%@”, which TextMouth cannot read." : {
      "comment" : "First sentence of why a file could not be imported: an HTML file declares a text encoding TextMouth does not know. %1$@ is the file's name and %2$@ the encoding's name as the file spells it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Datei „%1$@“ deklariert die Textcodierung „%2$@“, die TextMouth nicht lesen kann."
          }
        },
        "en" : {
          "stringUnit" : {
