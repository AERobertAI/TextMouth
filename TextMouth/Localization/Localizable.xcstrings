    "moveToLibraryError.recordNotSaved" : {
      "comment" : "Why Move to Library did nothing: the feed's record could not be saved. Follows \"Could not move to the library: \".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
