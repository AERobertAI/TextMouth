    "audioEditor.explanation.editorInfo" : {
      "comment" : "Hint of the audio editor's Audio Info button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعرض الطول والملف والتعديلات؛ ويحدّد ما يحدث للصوت الأصلي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "দৈর্ঘ্য, ফাইল ও সম্পাদনা দেখায়; মূল অডিওর কী হবে তা ঠিক করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zeigt Länge, Datei und Bearbeitungen; legt fest, was mit dem Originalaudio geschieht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows length, file, and edits; sets what happens to the original audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Muestra la duración, el archivo y las ediciones; define qué pasa con el audio original."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "طول، فایل و ویرایش‌ها را نشان می‌دهد؛ تعیین می‌کند با صدای اصلی چه شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Affiche la durée, le fichier et les modifications ; définit ce qu’il advient de l’audio original."
