    "transcription.offerTranscribeHint" : {
      "comment" : "VoiceOver hint of the Transcribe button of the question offered after an import. Transcribe Audio is the command's name; Transcribe is the sheet's button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يفتح “تفريغ الصوت”، الذي يبدأ فورًا إذا كان نموذج اللغة على هذا الـ Mac؛ وإلا فنزّله هناك، ثم اختر “تفريغ”."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“অডিও ট্রান্সক্রাইব করুন” খোলে, যা ভাষার মডেল এই Mac-এ থাকলে সঙ্গে সঙ্গে শুরু হয়; না থাকলে সেখানে মডেলটি ডাউনলোড করে তারপর “ট্রান্সক্রাইব করুন” বেছে নিতে হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffnet „Audio transkribieren“, das sofort startet, wenn das Modell der Sprache auf diesem Mac ist; andernfalls lade es dort herunter und wähle dann „Transkribieren“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens Transcribe Audio, which starts at once if the language's model is on this Mac; otherwise, download it there, then choose Transcribe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre Transcribir audio, que empieza de inmediato si el modelo del idioma está en esta Mac; si no, descárgalo allí y luego elige Transcribir."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«رونویسی صدا» را باز می‌کند که اگر مدل زبان روی این Mac باشد بی‌درنگ شروع می‌شود؛ در غیر این صورت، مدل را همان‌جا بارگیری کنید، سپس «رونویسی» را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ouvre Transcrire l’audio, qui démarre aussitôt si le modèle de la langue est sur ce Mac ; sinon, téléchargez-le là, puis choisissez Transcrire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "פותח את “תמלל שמע”, שמתחיל מיד אם מודל השפה נמצא ב-Mac הזה; אחרת, הורד אותו שם ולאחר מכן בחר “תמלל”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“ऑडियो ट्रांसक्राइब करें” खोलता है, जो भाषा का मॉडल इस Mac पर होने पर तुरंत शुरू हो जाता है; नहीं तो वहाँ उसे डाउनलोड करें, फिर “ट्रांसक्राइब करें” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuka Transkripsikan Audio, yang langsung dimulai jika model bahasanya ada di Mac ini; jika tidak, unduh model di sana, lalu pilih Transkripsikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apre Trascrivi audio, che parte subito se il modello della lingua è su questo Mac; altrimenti scaricalo lì, poi scegli Trascrivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「オーディオを文字起こし」を開きます。言語のモデルがこの Mac にあればすぐに始まります。なければ、そこでダウンロードしてから「文字起こし」を選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "오디오 대본 만들기를 엽니다. 해당 언어의 모델이 이 Mac에 있으면 바로 시작하고, 없으면 거기서 다운로드한 다음 대본 만들기를 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Opent Transcribeer audio, dat meteen start als het model van de taal op deze Mac staat; download het anders daar en kies dan Transcribeer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Otwiera okno Transkrybuj dźwięk, które od razu zaczyna transkrybowanie, jeśli model języka jest na tym komputerze Mac; w przeciwnym razie pobierz go tam, a potem wybierz Transkrybuj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre Transcrever áudio, que começa na hora se o modelo do idioma estiver neste Mac; senão, baixe-o ali e escolha Transcrever."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Открывает «Расшифровать аудио»: расшифровка начинается сразу, если модель языка есть на этом Mac; иначе загрузите её там, затем выберите «Расшифровать»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öppnar Transkribera ljud, som startar direkt om språkets modell finns på den här Mac-datorn. Annars hämtar du den där och väljer sedan Transkribera."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เปิด ถอดเสียงจากไฟล์เสียง ซึ่งจะเริ่มทันทีหากมีโมเดลของภาษาใน Mac เครื่องนี้ หากไม่มี ให้ดาวน์โหลดที่นั่น แล้วเลือก ถอดเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sesi Yazıya Dök'ü açar; dilin modeli bu Mac'teyse hemen başlar, değilse modeli orada indirin, sonra Yazıya Dök'ü seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відкриває «Транскрибувати аудіо», яке починається одразу, якщо модель мови є на цьому Mac; інакше завантажте її там і виберіть «Транскрибувати»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“آڈیو ٹرانسکرائب کریں” کھولتا ہے، جو زبان کا ماڈل اس Mac پر ہو تو فوراً شروع ہو جاتا ہے؛ ورنہ اسے وہیں ڈاؤن لوڈ کریں، پھر “ٹرانسکرائب کریں” منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mở Chép lời âm thanh; việc chép lời bắt đầu ngay nếu mô hình của ngôn ngữ đã có trên máy Mac này, nếu không, hãy tải mô hình về ở đó, rồi chọn Chép lời."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "打开“转录音频”；如果此 Mac 上已有该语言的模型，会立即开始，否则请在其中下载，然后选取“转录”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "打開「轉錄音訊」；若這部 Mac 上已有該語言的模型，會立即開始，否則請先在那裡下載，再選擇「轉錄」。"
          }
        }
      }
    },
