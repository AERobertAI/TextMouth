    "transcription.downloaded" : {
      "comment" : "What VoiceOver hears, and the Transcribe Audio sheet shows, when a speech model has finished downloading. %@ is the language's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم تنزيل نموذج %@. يمكن الآن تفريغ الكتاب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ মডেল ডাউনলোড হয়েছে। এখন বইটি ট্রান্সক্রাইব করা যাবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Sprachmodell für %@ ist heruntergeladen. Das Buch kann jetzt transkribiert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %@ model is downloaded. The book can be transcribed now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El modelo de %@ está descargado. Ya se puede transcribir el libro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مدل %@ بارگیری شد. اکنون می‌توان کتاب را رونویسی کرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le modèle %@ est téléchargé. Le livre peut maintenant être transcrit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מודל %@ הורד. כעת ניתן לתמלל את הספר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ मॉडल डाउनलोड हो गया है। अब पुस्तक ट्रांसक्राइब की जा सकती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Model %@ telah diunduh. Buku kini dapat ditranskripsikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il modello %@ è stato scaricato. Ora il libro può essere trascritto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@のモデルをダウンロードしました。ブックを文字起こしできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 모델을 다운로드했습니다. 이제 책의 대본을 만들 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Het %@-model is gedownload. Het boek kan nu worden getranscribeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Model %@ został pobrany. Teraz można transkrybować książkę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O modelo de %@ foi baixado. O livro já pode ser transcrito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Модель «%@» загружена. Книгу теперь можно расшифровать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Modellen för %@ har hämtats. Boken kan transkriberas nu."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ดาวน์โหลดโมเดล %@ แล้ว ตอนนี้ถอดเสียงหนังสือได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ modeli indirildi. Kitap artık yazıya dökülebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Модель (%@) завантажено. Тепер книгу можна транскрибувати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ماڈل ڈاؤن لوڈ ہو گیا۔ اب کتاب ٹرانسکرائب کی جا سکتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đã tải về mô hình %@. Giờ có thể chép lời cho sách."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 模型已下载。现在可以转录这本图书了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@模型已下載。現在可以轉錄這本書了。"
          }
        }
      }
    },
