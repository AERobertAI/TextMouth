    "folderOperationConflict.invalidPath.location" : {
      "comment" : "Error shown when a folder edit is refused because its location is not a safe library path. %@ is the location, in straight double quotes.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ليس موقعًا صالحًا لمجلد المكتبة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ লাইব্রেরি ফোল্ডারের বৈধ অবস্থান নয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ist kein gültiger Ort für einen Bibliotheksordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is not a valid library folder location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no es una ubicación válida para una carpeta de la biblioteca."
