    "readingList.emptyList" : {
      "comment" : "Shown and read as the only row of the Reading List while it holds no book. Add to Reading List is the name of the command in the Library menu.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "قائمة القراءة فارغة. لإضافة كتاب، اختر “إضافة إلى قائمة القراءة” من قائمته السياقية، أو إجراءات VoiceOver الخاصة به، أو قائمة المكتبة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পড়ার তালিকা খালি। একটি বই যোগ করতে এর কনটেক্সট মেনু, এর VoiceOver অ্যাকশন বা লাইব্রেরি মেনু থেকে “পড়ার তালিকায় যোগ করুন” বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Leseliste ist leer. Um ein Buch hinzuzufügen, wähle „Zur Leseliste hinzufügen“ in seinem Kontextmenü, in seinen VoiceOver-Aktionen oder im Menü „Bibliothek“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The reading list is empty. To add a book, choose Add to Reading List from its context menu, its VoiceOver actions, or the Library menu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La lista de lectura está vacía. Para agregar un libro, elige Agregar a la lista de lectura en su menú contextual, sus acciones de VoiceOver o el menú Biblioteca."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فهرست مطالعه خالی است. برای افزودن کتاب، «افزودن به فهرست مطالعه» را از منوی زمینه آن، کارهای VoiceOver آن یا منوی کتابخانه انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La liste de lecture est vide. Pour ajouter un livre, choisissez Ajouter à la liste de lecture dans son menu contextuel, ses actions VoiceOver ou le menu Bibliothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "רשימת הקריאה ריקה. כדי להוסיף ספר, בחר “הוסף לרשימת הקריאה” מתפריט ההקשר שלו, מהפעולות של VoiceOver שלו או מתפריט הספרייה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "रीडिंग लिस्ट ख़ाली है। पुस्तक जोड़ने के लिए उसके संदर्भ मेनू, उसकी VoiceOver क्रियाओं या लाइब्रेरी मेनू से “रीडिंग लिस्ट में जोड़ें” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Daftar bacaan kosong. Untuk menambahkan buku, pilih Tambahkan ke Daftar Bacaan dari menu konteksnya, tindakan VoiceOver, atau menu Pustaka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’elenco di lettura è vuoto. Per aggiungere un libro, scegli Aggiungi all’elenco di lettura dal suo menu contestuale, dalle sue azioni di VoiceOver o dal menu Libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "リーディングリストは空です。ブックを追加するには、コンテキストメニュー、VoiceOver のアクション、またはライブラリメニューから「リーディングリストに追加」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "읽기 목록이 비어 있습니다. 책을 추가하려면 컨텍스트 메뉴, VoiceOver 동작 또는 보관함 메뉴에서 읽기 목록에 추가를 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De leeslijst is leeg. Kies Voeg toe aan leeslijst in het contextmenu van een boek, in de VoiceOver-acties of in het menu Bibliotheek om een boek toe te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lista czytelnicza jest pusta. Aby dodać książkę, wybierz Dodaj do listy czytelniczej z jej menu kontekstowego, jej akcji VoiceOver lub menu Biblioteka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A lista de leitura está vazia. Para adicionar um livro, escolha Adicionar à lista de leitura no menu de atalho dele, nas ações do VoiceOver ou no menu Biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Список для чтения пуст. Чтобы добавить книгу, выберите «Добавить в список для чтения» в её контекстном меню, действиях VoiceOver или меню «Библиотека»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Läslistan är tom. Om du vill lägga till en bok väljer du Lägg till i läslistan i dess snabbmeny, bland dess VoiceOver-åtgärder eller i biblioteksmenyn."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "รายการอ่านว่างเปล่า หากต้องการเพิ่มหนังสือ ให้เลือก เพิ่มไปยังรายการอ่าน จากเมนูบริบท การดำเนินการของ VoiceOver หรือเมนูไลบรารี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Okuma listesi boş. Kitap eklemek için bağlam menüsünden, VoiceOver eylemlerinden veya Kitaplık menüsünden Okuma Listesine Ekle'yi seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Список читання порожній. Щоб додати книгу, виберіть «Додати до списку читання» в її контекстному меню, її діях VoiceOver або в меню «Бібліотека»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مطالعے کی فہرست خالی ہے۔ کتاب شامل کرنے کے لیے اس کے سیاقی مینو، اس کی VoiceOver کارروائیوں، یا لائبریری مینو سے “مطالعے کی فہرست میں شامل کریں” منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Danh sách đọc trống. Để thêm sách, hãy chọn Thêm vào danh sách đọc trong menu ngữ cảnh của sách, các hành động VoiceOver của sách hoặc menu Thư viện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "阅读列表为空。要添加图书，请从其快捷菜单、VoiceOver 操作或“资料库”菜单中选取“添加到阅读列表”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "閱讀列表是空的。若要加入書籍，請從其快速選單、VoiceOver 動作或「書庫」選單中選擇「加入閱讀列表」。"
          }
        }
      }
    },
