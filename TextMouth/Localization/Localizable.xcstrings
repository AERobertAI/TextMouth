        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sách Kindle này không có văn bản dàn trang linh hoạt, như truyện tranh hoặc bản sao bản in, nên TextMouth không thể đọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此 Kindle 图书没有可重排的文本（如漫画或印刷版复制品），TextMouth 无法读取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
