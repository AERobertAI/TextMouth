        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth के नए वर्ज़न ने इस ऑडियो को संपादित किया था, इसलिए यह वर्ज़न उसके संपादनों को नहीं छूता।"
          }
        },
        "id" : {
          "stringUnit" : {
