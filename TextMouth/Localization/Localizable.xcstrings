          }
        }
      }
    },
    "phoneImport.refusalNextStep" : {
      "comment" : "Last sentence of every refusal of a file the iPhone app can't import yet: the Mac can add it, and the book then comes to the iPhone.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أضفه على جهاز Mac لديك، ثم أرسل الكتاب إلى هنا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এটি আপনার Mac-এ যোগ করুন, তারপর বইটি এখানে পাঠান।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Füge sie auf deinem Mac hinzu und sende das Buch dann hierher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add it on your Mac, then send the book here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Agrégalo en tu Mac y después envía aquí el libro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آن را در Mac خود اضافه کنید، سپس کتاب را به اینجا بفرستید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ajoutez-le sur votre Mac, puis envoyez le livre ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הוסף אותו ב-Mac שלך, ואז שלח את הספר לכאן."
