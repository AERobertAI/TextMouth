    "importedBook.originalKeptNotice" : {
      "comment" : "Notice after a book was imported from a folder, such as an RTFD: the original was kept because an import never deletes a folder.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم الاحتفاظ بالملف الأصلي: إنه مجلد، ولا يحذف الاستيراد مجلدًا أبدًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "মূল ফাইলটি রাখা হয়েছে: এটি একটি ফোল্ডার, আর আমদানি কখনও ফোল্ডার মোছে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Originaldatei wurde behalten: Sie ist ein Ordner, und ein Import löscht nie einen Ordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The original file was kept: it is a folder, and an import never deletes a folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se conservó el archivo original: es una carpeta, y una importación nunca elimina una carpeta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فایل اصلی نگه داشته شد: پوشه است و وارد کردن هرگز پوشه را حذف نمی‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le fichier d’origine a été conservé : c’est un dossier, et une importation ne supprime jamais un dossier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "קובץ המקור נשמר: הוא תיקייה, וייבוא לא מוחק תיקייה לעולם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "मूल फ़ाइल रखी गई: वह एक फ़ोल्डर है, और आयात कभी फ़ोल्डर नहीं मिटाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "File asli dipertahankan: file itu adalah folder, dan impor tidak pernah menghapus folder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il file originale è stato conservato: è una cartella, e un’importazione non elimina mai una cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "元のファイルは保持されました。フォルダであり、読み込みでフォルダが削除されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "원본 파일이 유지되었습니다. 원본이 폴더이며, 가져오기는 폴더를 삭제하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Het originele bestand is bewaard: het is een map, en een import verwijdert nooit een map."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Oryginalny plik został zachowany: to folder, a import nigdy nie usuwa folderu."
          }
        },
