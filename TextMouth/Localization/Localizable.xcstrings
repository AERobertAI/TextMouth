    },
    "This file's markup nests more than %@ levels deep, which TextMouth can't read safely." : {
      "comment" : "First sentence of why a file was refused: its markup has elements inside elements more levels deep than TextMouth reads. %@ is the most levels, a number.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يتداخل ترميز هذا الملف بأكثر من %@ مستوى، ولا يستطيع TextMouth قراءته بأمان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Markup dieser Datei ist mehr als %@ Ebenen tief verschachtelt, was TextMouth nicht sicher lesen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El marcado de este archivo anida más de %@ niveles de profundidad, y TextMouth no puede leerlo de forma segura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le balisage de ce fichier est imbriqué sur plus de %@ niveaux, ce que TextMouth ne peut pas lire en toute sécurité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस फ़ाइल का मार्कअप %@ से अधिक स्तर गहरा है, जिसे TextMouth सुरक्षित रूप से नहीं पढ़ सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Markup file ini bersarang lebih dari %@ tingkat, yang tidak dapat dibaca TextMouth dengan aman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il markup di questo file è annidato per più di %@ livelli, e TextMouth non può leggerlo in sicurezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このファイルのマークアップは%@階層を超えてネストされており、TextMouth は安全に読み取れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 파일의 마크업이 %@단계를 넘게 중첩되어 TextMouth가 안전하게 읽을 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A marcação deste arquivo tem mais de %@ níveis de aninhamento, o que o TextMouth não consegue ler com segurança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Разметка этого файла вложена глубже, чем на %@ уровней, и TextMouth не может безопасно её прочитать."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Розмітка цього файлу вкладена глибше ніж на %@ рівнів, і TextMouth не може безпечно її прочитати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此文件的标记嵌套超过 %@ 层，TextMouth 无法安全读取。"
          }
        }
      }
    },
    "This file's markup would take TextMouth far too long to read." : {
      "comment" : "First sentence of why a file was refused: its markup is built so that reading it would take far too long.",
      "localizations" : {
        "ar" : {
