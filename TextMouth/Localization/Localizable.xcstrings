          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download of the next article cancelled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se canceló la descarga del siguiente artículo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بارگیری مقاله‌ی بعدی لغو شد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Téléchargement de l’article suivant annulé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הורדת הכתבה הבאה בוטלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "अगले लेख का डाउनलोड रद्द किया गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Unduhan artikel berikutnya dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Download dell’articolo successivo annullato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "次の記事のダウンロードをキャンセルしました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
