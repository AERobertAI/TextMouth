    "interfaceTextFile.exportHint" : {
      "comment" : "VoiceOver hint of the Export Interface Text button. Lines the person changed are marked in the file.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحفظ كل سطر من لغة الواجهة كما يُقرأ الآن، مع تمييز أسطرك الخاصة، في ملف تختاره."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ইন্টারফেসের ভাষার প্রতিটি লাইন এখন যেমন পড়া হয় তেমনই, আপনার নিজের লাইনগুলো চিহ্নিত করে, আপনার বেছে নেওয়া ফাইলে সংরক্ষণ করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sichert jede Zeile der Oberflächensprache, wie sie jetzt lautet, mit markierten eigenen Zeilen in einer Datei Ihrer Wahl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves every line of the interface language as it reads now, with your own lines marked, to a file you choose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Guarda en un archivo que elijas todas las líneas del idioma de la interfaz tal como se leen ahora, con tus propias líneas marcadas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هر خط از زبان رابط را همان‌طور که اکنون خوانده می‌شود، با علامت‌گذاری خط‌های خودتان، در فایلی که انتخاب می‌کنید ذخیره می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Enregistre dans un fichier de votre choix chaque ligne de la langue de l’interface telle qu’elle se lit maintenant, vos propres lignes étant signalées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "שומר כל שורה בשפת הממשק כפי שהיא נקראת עכשיו, עם סימון השורות שלך, בקובץ שתבחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इंटरफ़ेस की भाषा की हर पंक्ति को वैसे ही, जैसी वह अभी पढ़ी जाती है, आपकी अपनी पंक्तियों पर निशान के साथ, आपकी चुनी फ़ाइल में सहेजता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menyimpan setiap baris bahasa antarmuka seperti yang terbaca sekarang, dengan baris Anda sendiri ditandai, ke file yang Anda pilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Salva in un file a tua scelta ogni riga della lingua dell’interfaccia così come si legge ora, con le tue righe personali contrassegnate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "インターフェイスの言語のすべての行を、現在の表記のまま、自分用の行に印を付けて、選んだファイルに保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "인터페이스 언어의 모든 줄을 현재 표기 그대로, 내 줄에 표시를 해서 선택한 파일에 저장합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bewaart elke regel van de interfacetaal zoals die nu luidt, met je eigen regels gemarkeerd, in een bestand naar keuze."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zapisuje w wybranym przez Ciebie pliku każdy wiersz języka interfejsu tak, jak brzmi teraz, z oznaczonymi Twoimi własnymi wierszami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Salva em um arquivo à sua escolha todas as linhas do idioma da interface como são lidas agora, com as suas próprias linhas marcadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сохраняет в выбранный вами файл каждую строку языка интерфейса в том виде, как она звучит сейчас, с пометкой ваших собственных строк."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sparar varje rad i gränssnittets språk som den lyder nu, med dina egna rader markerade, i en fil du väljer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "บันทึกทุกบรรทัดของภาษาอินเทอร์เฟซตามที่อ่านอยู่ในตอนนี้ พร้อมทำเครื่องหมายบรรทัดของคุณเอง ลงในไฟล์ที่คุณเลือก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arayüz dilinin her satırını şimdiki haliyle, kendi satırlarınız işaretli olarak, seçtiğiniz bir dosyaya kaydeder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Зберігає у вибраний вами файл кожен рядок мови інтерфейсу так, як він звучить зараз, із позначкою ваших власних рядків."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "انٹرفیس کی زبان کی ہر لائن کو اسی طرح جیسے وہ اب پڑھی جاتی ہے، آپ کی اپنی لائنوں پر نشان کے ساتھ، آپ کی چنی ہوئی فائل میں محفوظ کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lưu mọi dòng của ngôn ngữ giao diện như hiện đang đọc, với các dòng riêng của bạn được đánh dấu, vào một tệp bạn chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "按当前的读法，把界面语言的每一行连同标出的您自定义行，存入您选择的文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "依目前的讀法，把介面語言的每一行連同標出的您自訂行，存入您選擇的檔案。"
          }
        }
      }
    },
