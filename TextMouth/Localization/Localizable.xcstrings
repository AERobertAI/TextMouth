    "feedSubscribeError.message.invalidAddress" : {
      "comment" : "Why Subscribe refused: the address typed is not a web address.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هذا ليس عنوان ويب. أدخل عنوان موجز، أو عنوان صفحة تذكر موجزًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সেটি ওয়েব ঠিকানা নয়। একটি ফিডের ঠিকানা, অথবা কোনো ফিডের ঠিকানা জানায় এমন পৃষ্ঠার ঠিকানা লিখুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das ist keine Webadresse. Gib die Adresse eines Feeds oder einer Seite ein, die einen Feed nennt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That isn't a web address. Enter a feed's address, or the address of a page that names one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eso no es una dirección web. Escribe la dirección de un canal, o la de una página que nombre uno."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آن نشانی وب نیست. نشانی یک فید یا نشانی صفحه‌ای را که فیدی را نام می‌برد وارد کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce n’est pas une adresse web. Saisissez l’adresse d’un flux, ou celle d’une page qui en désigne un."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "זו אינה כתובת אינטרנט. הזן כתובת של ערוץ, או כתובת של דף שמציין ערוץ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "वह वेब पता नहीं है। फ़ीड का पता, या ऐसे पृष्ठ का पता दर्ज करें जो किसी फ़ीड का पता बताता हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Itu bukan alamat web. Masukkan alamat feed, atau alamat halaman yang menyebutkan feed."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non è un indirizzo web. Inserisci l’indirizzo di un feed, o di una pagina che ne indica uno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Web アドレスではありません。フィードのアドレス、またはフィードを示すページのアドレスを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "웹 주소가 아닙니다. 피드 주소 또는 피드를 알려 주는 페이지의 주소를 입력하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dat is geen webadres. Voer het adres van een feed in, of het adres van een pagina die er een noemt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "To nie jest adres internetowy. Wpisz adres kanału lub adres strony, która go wskazuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Isso não é um endereço da web. Digite o endereço de um feed, ou o de uma página que cite um."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Это не веб-адрес. Введите адрес ленты или адрес страницы, где она указана."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Det är inte en webbadress. Ange ett flödes adress eller adressen till en sida som anger ett."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "นั่นไม่ใช่ที่อยู่เว็บ ป้อนที่อยู่ของฟีด หรือที่อยู่ของหน้าที่ระบุฟีด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu bir web adresi değil. Bir beslemenin adresini veya bir beslemeyi belirten bir sayfanın adresini girin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Це не вебадреса. Введіть адресу стрічки або адресу сторінки, яка вказує на стрічку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یہ ویب پتا نہیں ہے۔ فیڈ کا پتا درج کریں، یا ایسے صفحے کا پتا جو کسی فیڈ کی طرف اشارہ کرتا ہو۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đó không phải địa chỉ web. Hãy nhập địa chỉ của một nguồn cấp, hoặc địa chỉ của một trang có liên kết đến nguồn cấp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "这不是网址。请输入订阅源的地址，或指明订阅源的页面的地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "這不是網址。請輸入訂閱源網址，或列出訂閱源的網頁網址。"
          }
        }
      }
    },
