    "libraryCloud.letGoOfOneBookFirst" : {
      "comment" : "Last sentence of why Remove Download was refused for a book the reading list keeps downloaded: what to do first. %@ is the name of the Reading List's option that keeps its books downloaded, as the option shows it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أزله من قائمة القراءة، أو ألغِ تحديد %@ في خيارات قائمة القراءة أولًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এটি পড়ার তালিকা থেকে সরান, অথবা আগে পড়ার তালিকার বিকল্পে “%@” অচিহ্নিত করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nimm es von der Leseliste oder deaktiviere zuerst %@ in den Optionen der Leseliste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take it off the reading list, or clear %@ in the Reading List's options first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quítalo de la lista de lectura, o desactiva %@ en las opciones de la lista de lectura primero."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آن را از فهرست مطالعه بردارید، یا ابتدا %@ را در گزینه‌های فهرست مطالعه پاک کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Retirez-le de la liste de lecture, ou décochez d’abord %@ dans les options de la liste de lecture."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הסר אותו מרשימת הקריאה, או בטל תחילה את הסימון של “%@” באפשרויות של רשימת הקריאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसे रीडिंग लिस्ट से हटाएँ, या पहले रीडिंग लिस्ट के विकल्पों में %@ को अचयनित करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Keluarkan dari daftar bacaan, atau matikan %@ di opsi Daftar Bacaan dulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toglilo dall’elenco di lettura, oppure disattiva prima %@ nelle opzioni dell’elenco di lettura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "リーディングリストから外すか、先にリーディングリストのオプションで「%@」の選択を解除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "읽기 목록에서 제거하거나, 먼저 읽기 목록 옵션에서 %@을(를) 해제하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Haal het van de leeslijst af of schakel eerst %@ uit bij de opties van de leeslijst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zdejmij ją z listy czytelniczej albo najpierw odznacz %@ w opcjach listy czytelniczej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
