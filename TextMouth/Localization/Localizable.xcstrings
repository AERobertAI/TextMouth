    "Export can't write into TextMouth's library folder. Choose another folder." : {
      "comment" : "Why the Export dialog refuses the folder chosen: it is TextMouth's own library folder or inside it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Export kann nicht in den Bibliotheksordner von TextMouth schreiben. Wähle einen anderen Ordner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La exportación no puede escribir en la carpeta de la biblioteca de TextMouth. Elige otra carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’exportation ne peut pas écrire dans le dossier de la bibliothèque de TextMouth. Choisissez un autre dossier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "निर्यात TextMouth के लाइब्रेरी फ़ोल्डर में नहीं लिख सकता। कोई दूसरा फ़ोल्डर चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ekspor tidak dapat menulis ke folder pustaka TextMouth. Pilih folder lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esporta non può scrivere nella cartella della libreria di TextMouth. Scegli un’altra cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth のライブラリフォルダには書き出せません。別のフォルダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "내보내기는 TextMouth의 보관함 폴더에 쓸 수 없습니다. 다른 폴더를 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A exportação não pode gravar na pasta da biblioteca do TextMouth. Escolha outra pasta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Экспорт не может записывать в папку библиотеки TextMouth. Выберите другую папку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Експорт не може записувати в папку бібліотеки TextMouth. Виберіть іншу папку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "导出无法写入 TextMouth 的资料库文件夹。请选取其他文件夹。"
          }
        }
      }
    },
    "Export can't write into the folder where TextMouth keeps spoken chapters, which it empties. Choose another folder." : {
      "comment" : "Why the Export dialog refuses the folder chosen: it is the folder where TextMouth keeps the chapters of a spoken audio export, or inside it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Export kann nicht in den Ordner schreiben, in dem TextMouth gesprochene Kapitel ablegt und den es leert. Wähle einen anderen Ordner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La exportación no puede escribir en la carpeta donde TextMouth guarda los capítulos hablados, porque la vacía. Elige otra carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’exportation ne peut pas écrire dans le dossier où TextMouth garde les chapitres lus à voix haute, qu’il vide. Choisissez un autre dossier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "निर्यात उस फ़ोल्डर में नहीं लिख सकता जहाँ TextMouth बोले गए अध्याय रखता है और जिसे वह ख़ाली कर देता है। कोई दूसरा फ़ोल्डर चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ekspor tidak dapat menulis ke folder tempat TextMouth menyimpan bab yang diucapkan, yang dikosongkannya. Pilih folder lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esporta non può scrivere nella cartella in cui TextMouth conserva i capitoli letti, che viene svuotata. Scegli un’altra cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth が読み上げた章を保管するフォルダ（中身は空にされます）には書き出せません。別のフォルダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "내보내기는 TextMouth가 음성 챕터를 보관하고 비우는 폴더에 쓸 수 없습니다. 다른 폴더를 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A exportação não pode gravar na pasta onde o TextMouth guarda os capítulos falados, que ele esvazia. Escolha outra pasta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Экспорт не может записывать в папку, где TextMouth хранит озвученные главы: он её очищает. Выберите другую папку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Експорт не може записувати в папку, де TextMouth зберігає озвучені розділи і яку очищає. Виберіть іншу папку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "导出无法写入 TextMouth 存放朗读章节的文件夹，该文件夹会被清空。请选取其他文件夹。"
          }
        }
      }
    },
