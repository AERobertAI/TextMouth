    "audioFilterError.needsFFmpeg" : {
      "comment" : "Problem said of a filter graph with labels or semicolons, which only the ffmpeg program runs: TextMouth's own filters take a chain separated by commas.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "التسميات والفواصل المنقوطة تتطلب ffmpeg. تقبل مرشحات TextMouth الخاصة سلسلة واحدة مفصولة بفواصل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "লেবেল ও সেমিকোলনের জন্য ffmpeg লাগে। TextMouth-এর নিজের ফিল্টার কমা দিয়ে আলাদা করা একটি চেইন নেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Labels und Semikolons erfordern ffmpeg. Die eigenen Filter von TextMouth verwenden eine einzelne, durch Kommas getrennte Kette."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Labels and semicolons need ffmpeg. TextMouth's own filters take one comma-separated chain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Las etiquetas y los puntos y coma necesitan ffmpeg. Los filtros propios de TextMouth admiten una sola cadena separada por comas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "برچسب‌ها و نقطه‌ویرگول‌ها به ffmpeg نیاز دارند. فیلترهای خود TextMouth یک زنجیره جدا شده با کاما می‌پذیرند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les étiquettes et les points-virgules nécessitent ffmpeg. Les filtres propres à TextMouth acceptent une seule chaîne séparée par des virgules."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "תוויות ונקודה-פסיק דורשות ffmpeg. המסננים של TextMouth מקבלים שרשרת אחת מופרדת בפסיקים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लेबल और सेमीकोलन के लिए ffmpeg ज़रूरी है। TextMouth के अपने फ़िल्टर अल्पविराम से अलग की गई एक शृंखला लेते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Label dan titik koma memerlukan ffmpeg. Filter TextMouth sendiri hanya menerima satu rangkaian yang dipisahkan koma."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Etichette e punti e virgola richiedono ffmpeg. I filtri di TextMouth accettano una sola catena separata da virgole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ラベルとセミコロンには ffmpeg が必要です。TextMouth 独自のフィルタは、カンマで区切った1本のチェーンを受け付けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "레이블과 세미콜론에는 ffmpeg이 필요합니다. TextMouth의 자체 필터는 쉼표로 구분한 체인 하나만 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Labels en puntkomma's vereisen ffmpeg. De eigen filters van TextMouth accepteren één keten gescheiden door komma's."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Etykiety i średniki wymagają ffmpeg. Własne filtry TextMouth przyjmują jeden łańcuch rozdzielony przecinkami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rótulos e pontos e vírgulas exigem o ffmpeg. Os filtros do próprio TextMouth aceitam uma única cadeia separada por vírgulas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Метки и точки с запятой требуют ffmpeg. Собственные фильтры TextMouth принимают одну цепочку, разделённую запятыми."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Etiketter och semikolon kräver ffmpeg. TextMouths egna filter tar en kedja avskild med kommatecken."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ป้ายกำกับและเครื่องหมายอัฒภาคต้องใช้ ffmpeg ตัวกรองของ TextMouth ใช้ลูกโซ่เดียวที่คั่นด้วยจุลภาค"
          }
        },
        "tr" : {
          "stringUnit" : {
