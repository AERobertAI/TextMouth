          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo de transcrição encontrado ao lado do áudio da nova cópia substitui a transcrição da cópia existente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл расшифровки, найденный рядом с аудио новой копии, заменяет расшифровку существующей копии."
          }
        },
        "uk" : {
          "stringUnit" : {
