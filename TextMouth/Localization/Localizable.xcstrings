          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ищет во всей библиотеке книги, соответствующие выбранным критериям."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Söker i hela biblioteket efter böcker som matchar de valda kriterierna."
          }
