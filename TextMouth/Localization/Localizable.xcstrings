          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre %@, a pasta em que os registros são gravados agora, no Finder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Открывает в Finder папку %@, в которую сейчас записываются журналы."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відкриває у Finder папку %@, до якої зараз записуються журнали."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在 Finder 中打开当前写入日志的文件夹 %@。"
          }
        }
      }
    },
    "Opens TextMouth's settings." : {
      "comment" : "Hint of the iPhone Library's Settings button.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffnet die Einstellungen von TextMouth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre los ajustes de TextMouth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ouvre les réglages de TextMouth."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth की सेटिंग खोलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuka pengaturan TextMouth."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apre le impostazioni di TextMouth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth の設定を開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 설정을 엽니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre os ajustes do TextMouth."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Открывает настройки TextMouth."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відкриває налаштування TextMouth."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "打开 TextMouth 的设置。"
          }
        }
      }
    },
    "Opens Transcribe Audio, which starts at once if the language's model is on this Mac; otherwise, download it there, then choose Transcribe." : {
      "comment" : "VoiceOver hint of the Transcribe button of the question offered after an import. Transcribe Audio is the command's name; Transcribe is the sheet's button.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يفتح “تفريغ الصوت”، الذي يبدأ فورًا إذا كان نموذج اللغة على هذا الـ Mac؛ وإلا فنزّله هناك، ثم اختر “تفريغ”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffnet „Audio transkribieren“, das sofort startet, wenn das Modell der Sprache auf diesem Mac ist; andernfalls lade es dort herunter und wähle dann „Transkribieren“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre Transcribir audio, que empieza de inmediato si el modelo del idioma está en esta Mac; si no, descárgalo allí y luego elige Transcribir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ouvre Transcrire l’audio, qui démarre aussitôt si le modèle de la langue est sur ce Mac ; sinon, téléchargez-le là, puis choisissez Transcrire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“ऑडियो ट्रांसक्राइब करें” खोलता है, जो भाषा का मॉडल इस Mac पर होने पर तुरंत शुरू हो जाता है; नहीं तो वहाँ उसे डाउनलोड करें, फिर “ट्रांसक्राइब करें” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuka Transkripsikan Audio, yang langsung dimulai jika model bahasanya ada di Mac ini; jika tidak, unduh model di sana, lalu pilih Transkripsikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apre Trascrivi audio, che parte subito se il modello della lingua è su questo Mac; altrimenti scaricalo lì, poi scegli Trascrivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「オーディオを文字起こし」を開きます。言語のモデルがこの Mac にあればすぐに始まります。なければ、そこでダウンロードしてから「文字起こし」を選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "오디오 대본 만들기를 엽니다. 해당 언어의 모델이 이 Mac에 있으면 바로 시작하고, 없으면 거기서 다운로드한 다음 대본 만들기를 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre Transcrever áudio, que começa na hora se o modelo do idioma estiver neste Mac; senão, baixe-o ali e escolha Transcrever."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Открывает «Расшифровать аудио»: расшифровка начинается сразу, если модель языка есть на этом Mac; иначе загрузите её там, затем выберите «Расшифровать»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відкриває «Транскрибувати аудіо», яке починається одразу, якщо модель мови є на цьому Mac; інакше завантажте її там і виберіть «Транскрибувати»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "打开“转录音频”；如果此 Mac 上已有该语言的模型，会立即开始，否则请在其中下载，然后选取“转录”。"
          }
        }
      }
    },
    "Opens a file picker to import books in any format TextMouth reads." : {
      "comment" : "Hint of the choice that opens a file picker to import books, in the Add to Library sheet.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يفتح منتقي ملفات لاستيراد الكتب بأي تنسيق يقرؤه TextMouth."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffnet eine Dateiauswahl, um Bücher in jedem Format zu importieren, das TextMouth liest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre un selector de archivos para importar libros en cualquier formato que TextMouth lea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ouvre un sélecteur de fichiers pour importer des livres dans tout format que TextMouth sait lire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ऐसा फ़ाइल पिकर खोलता है जिससे TextMouth द्वारा पढ़े जाने वाले किसी भी फ़ॉर्मैट की पुस्तकें आयात की जा सकें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuka pemilih file untuk mengimpor buku dalam format apa pun yang dibaca TextMouth."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apre un selettore di file per importare libri in qualsiasi formato letto da TextMouth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ファイルピッカーを開き、TextMouth が読み込めるあらゆる形式のブックを読み込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 읽을 수 있는 모든 포맷의 책을 가져오기 위해 파일 선택 창을 엽니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre um seletor de arquivos para importar livros em qualquer formato que o TextMouth leia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Открывает выбор файлов, чтобы импортировать книги в любом формате, который читает TextMouth."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відкриває вікно вибору файлів для імпорту книг у будь-якому форматі, який читає TextMouth."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "打开文件选取器，以导入 TextMouth 能读取的任意格式的图书。"
          }
        }
      }
    },
    "Opens a folder chooser to pick a folder that holds a TextMouth library, which TextMouth then opens instead." : {
      "comment" : "VoiceOver hint of the Choose Another Library button in Storage settings.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يفتح أداة اختيار مجلد لاختيار مجلد يحتوي على مكتبة TextMouth، ثم يفتحها TextMouth بدلًا من المكتبة الحالية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth লাইব্রেরি আছে এমন একটি ফোল্ডার বাছাই করতে ফোল্ডার চয়নকারী খোলে, যা TextMouth তারপর এর বদলে খোলে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffnet eine Ordnerauswahl, um einen Ordner mit einer TextMouth-Bibliothek zu wählen, die TextMouth dann stattdessen öffnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre un selector de carpetas para elegir una carpeta que contenga una biblioteca de TextMouth, que TextMouth abre en su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ouvre un sélecteur de dossier pour choisir un dossier contenant une bibliothèque TextMouth, que TextMouth ouvre ensuite à la place."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ोल्डर चुनने की विंडो खोलता है, जिसमें TextMouth लाइब्रेरी वाला फ़ोल्डर चुना जा सकता है; TextMouth फिर उसे खोलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuka pemilih folder untuk memilih folder yang berisi pustaka TextMouth, yang kemudian dibuka TextMouth."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apre un selettore di cartelle per scegliere una cartella che contiene una libreria di TextMouth, che TextMouth aprirà al posto di quella attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フォルダ選択を開き、TextMouth ライブラリを含むフォルダを選ぶと、TextMouth が代わりにそれを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "폴더 선택 창을 열어 TextMouth 보관함이 들어 있는 폴더를 고르면 TextMouth가 그 보관함을 대신 엽니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre um seletor de pastas para escolher uma pasta que contenha uma biblioteca do TextMouth, que o TextMouth abre no lugar da atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Открывает окно выбора папки с библиотекой TextMouth, которую TextMouth затем откроет вместо текущей."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відкриває вікно вибору папки, щоб вибрати папку з бібліотекою TextMouth, яку TextMouth потім відкриє замість поточної."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "打开文件夹选择器，选取包含 TextMouth 资料库的文件夹，TextMouth 会改为打开该资料库。"
          }
        }
      }
    },
    "Opens a folder chooser. An empty folder receives a copy of the library; a folder that holds a TextMouth library can be used as it is." : {
      "comment" : "VoiceOver hint of the Change Location button in Storage settings.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يفتح أداة اختيار مجلد. يتلقى المجلد الفارغ نسخة من المكتبة؛ ويمكن استخدام مجلد يحتوي على مكتبة TextMouth كما هو."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "একটি ফোল্ডার চয়নকারী খোলে। খালি ফোল্ডার লাইব্রেরির একটি কপি পায়; TextMouth লাইব্রেরি আছে এমন ফোল্ডার যেমন আছে তেমনই ব্যবহার করা যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffnet eine Ordnerauswahl. Ein leerer Ordner erhält eine Kopie der Bibliothek; ein Ordner mit einer TextMouth-Bibliothek kann unverändert verwendet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre un selector de carpetas. Una carpeta vacía recibe una copia de la biblioteca; una carpeta que contenga una biblioteca de TextMouth se puede usar tal como está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ouvre un sélecteur de dossier. Un dossier vide reçoit une copie de la bibliothèque ; un dossier contenant une bibliothèque TextMouth peut être utilisé tel quel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ोल्डर चुनने की विंडो खोलता है। खाली फ़ोल्डर में लाइब्रेरी की प्रति रखी जाती है; TextMouth लाइब्रेरी वाले फ़ोल्डर का सीधे उपयोग किया जा सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuka pemilih folder. Folder kosong menerima salinan pustaka; folder yang berisi pustaka TextMouth dapat digunakan apa adanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
