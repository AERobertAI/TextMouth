    "xmlInputGuard.refusal.ownDefinitions.book" : {
      "comment" : "Last sentence of why a file inside an EPUB or DAISY book was refused because it defines entities of its own: what to do.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "افتح الكتاب في البرنامج الذي أنشأه، واحفظه مرة أخرى، ثم استورده مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইটি যে প্রোগ্রামে তৈরি হয়েছিল তাতে খুলে আবার সংরক্ষণ করুন, তারপর আবার আমদানি করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffne das Buch in dem Programm, mit dem es erstellt wurde, sichere es erneut und importiere es dann noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the book in the program that made it, save it again, then import it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre el libro en el programa que lo creó, guárdalo de nuevo y vuelve a importarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب را در برنامه‌ای که آن را ساخته باز کنید، دوباره ذخیره کنید و سپس دوباره وارد کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ouvrez le livre dans le programme qui l’a créé, enregistrez-le à nouveau, puis importez-le à nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "פתח את הספר בתוכנה שיצרה אותו, שמור אותו שוב, ואז ייבא אותו שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पुस्तक को उस प्रोग्राम में खोलें जिसने उसे बनाया था, उसे फिर से सहेजें, फिर दोबारा आयात करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Buka buku di program yang membuatnya, simpan lagi, lalu impor lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apri il libro nel programma che lo ha creato, salvalo di nuovo, poi importalo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブックを作成したプログラムで開いて保存し直してから、もう一度読み込んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책을 만든 프로그램에서 열어 다시 저장한 다음 다시 가져오십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Open het boek in het programma waarmee het is gemaakt, bewaar het opnieuw en importeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Otwórz książkę w programie, w którym została utworzona, zachowaj ją ponownie, a następnie zaimportuj ją ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abra o livro no programa que o criou, salve-o de novo e importe-o novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Откройте книгу в программе, в которой она создана, пересохраните её и снова импортируйте."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öppna boken i programmet som skapade den, spara den igen och importera den sedan igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เปิดหนังสือในโปรแกรมที่ใช้สร้าง บันทึกอีกครั้ง แล้วนำเข้าอีกครั้ง"
