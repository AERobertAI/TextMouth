                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Unread: %@ hasn't arrived from the cloud after %lld seconds, %@"
                }
              }
            }
          }
        }
      }
    },
    "Unread: %@ wasn't asked for again, because the drive hasn't answered an earlier read, %@" : {
      "comment" : "A file Compare Libraries could not read. %1$@ names the file and %2$@ is the clause that says what follows from it.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unread: %1$@ wasn't asked for again, because the drive hasn't answered an earlier read, %2$@"
          }
        }
      }
    },
    "Unread: %@ wasn't read, because TextMouth stopped waiting after %lld seconds in all, %@" : {
      "comment" : "A file Compare Libraries could not read. %1$@ names the file, %2$lld is how many seconds TextMouth waited in all, a count, and %3$@ is the clause that says what follows from it.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
