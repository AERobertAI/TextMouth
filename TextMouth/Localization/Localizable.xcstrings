    "transcription.downloadHint" : {
      "comment" : "VoiceOver hint of the button that downloads a language's speech model.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ينزّل نموذج الكلام من Apple، ويحتفظ به macOS ويشاركه. لا يُنزَّل شيء آخر، ولا يغادر صوت الكتاب هذا الـ Mac أبدًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apple থেকে স্পিচ মডেল ডাউনলোড করে, যা macOS রাখে ও শেয়ার করে। আর কিছু ডাউনলোড হয় না, এবং বইয়ের অডিও কখনো এই Mac ছেড়ে যায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lädt das Sprachmodell von Apple herunter, das macOS verwaltet und gemeinsam nutzt. Es wird nichts anderes geladen, und das Audio des Buchs verlässt diesen Mac nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads the speech model from Apple, kept and shared by macOS. Nothing else is downloaded, and the book's audio never leaves this Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Descarga de Apple el modelo de voz, que macOS conserva y comparte. No se descarga nada más, y el audio del libro nunca sale de esta Mac."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مدل گفتار را از Apple بارگیری می‌کند که macOS آن را نگه می‌دارد و به اشتراک می‌گذارد. چیز دیگری بارگیری نمی‌شود و صدای کتاب هرگز از این Mac بیرون نمی‌رود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Télécharge le modèle vocal depuis Apple, conservé et partagé par macOS. Rien d’autre n’est téléchargé, et l’audio du livre ne quitte jamais ce Mac."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מוריד את מודל הדיבור מ-Apple, שנשמר ומשותף על ידי macOS. לא מתבצעת שום הורדה אחרת, והשמע של הספר לעולם לא עוזב את ה-Mac הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apple से स्पीच मॉडल डाउनलोड करता है, जिसे macOS रखता और साझा करता है। और कुछ भी डाउनलोड नहीं होता, और पुस्तक का ऑडियो इस Mac से बाहर कभी नहीं जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mengunduh model ucapan dari Apple, yang disimpan dan dibagikan oleh macOS. Tidak ada hal lain yang diunduh, dan audio buku tidak pernah meninggalkan Mac ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scarica il modello vocale da Apple, conservato e condiviso da macOS. Non viene scaricato altro e l’audio del libro non lascia mai questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apple の音声モデルをダウンロードします。モデルは macOS が保管して共有します。それ以外はダウンロードされず、ブックのオーディオがこの Mac の外に出ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apple 서버에서 음성 모델을 다운로드하며, macOS가 보관하고 공유합니다. 그 밖의 항목은 다운로드하지 않으며, 책의 오디오는 이 Mac 밖으로 나가지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Downloadt het spraakmodel van Apple, dat door macOS wordt bewaard en gedeeld. Er wordt niets anders gedownload en de audio van het boek verlaat deze Mac nooit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pobiera model mowy od Apple, przechowywany i udostępniany przez macOS. Nic więcej nie jest pobierane, a dźwięk książki nigdy nie opuszcza tego komputera Mac."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Baixa da Apple o modelo de fala, que é guardado e compartilhado pelo macOS. Nada mais é baixado, e o áudio do livro nunca sai deste Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Загружает модель распознавания речи от Apple, которую хранит и совместно использует macOS. Больше ничего не загружается, а аудио книги никогда не покидает этот Mac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hämtar talmodellen från Apple, som sparas och delas av macOS. Inget annat hämtas, och bokens ljud lämnar aldrig den här Mac-datorn."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ดาวน์โหลดโมเดลเสียงพูดจาก Apple ซึ่ง macOS เก็บไว้และแชร์ ไม่มีการดาวน์โหลดอย่างอื่น และเสียงของหนังสือไม่เคยออกจาก Mac เครื่องนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Konuşma modelini Apple'dan indirir; model macOS tarafından saklanır ve paylaşılır. Başka hiçbir şey indirilmez ve kitabın sesi bu Mac'ten asla çıkmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Завантажує мовну модель від Apple, яку зберігає та спільно використовує macOS. Більше нічого не завантажується, а аудіо книги ніколи не залишає цей Mac."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اسپیچ ماڈل Apple سے ڈاؤن لوڈ کرتا ہے، جسے macOS رکھتا اور شیئر کرتا ہے۔ اس کے سوا کچھ ڈاؤن لوڈ نہیں ہوتا، اور کتاب کا آڈیو اس Mac سے باہر نہیں جاتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tải về mô hình giọng nói từ Apple, do macOS lưu giữ và dùng chung. Không có gì khác được tải về, và âm thanh của sách không bao giờ rời khỏi máy Mac này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "从 Apple 下载语音模型，由 macOS 保存并共享。不会下载其他任何内容，图书的音频也绝不会离开这台 Mac。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "從 Apple 下載語音模型，由 macOS 保存並共用。不會下載其他任何內容，書籍的音訊也不會離開這部 Mac。"
          }
        }
      }
    },
    "transcription.downloadTitle" : {
