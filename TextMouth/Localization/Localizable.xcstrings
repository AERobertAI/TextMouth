    "duplicateCopy.unansweredTrashed.other" : {
      "comment" : "Alert after the launch moved the new copies of four or more duplicate books to the Trash, because their questions were never answered. %lld is the number of books. \"Put Back\" is Finder's command in the Trash.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "نقل TextMouth %lld نسخ جديدة من كتب مكررة إلى سلة المهملات، لأن أسئلة الاحتفاظ بها كنسخ مكررة لم تُجَب قبل إغلاق TextMouth. لاسترجاعها، افتح سلة المهملات واختر “إرجاع”."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "نقل TextMouth %lld نسخة جديدة من كتب مكررة إلى سلة المهملات، لأن أسئلة الاحتفاظ بها كنسخ مكررة لم تُجَب قبل إغلاق TextMouth. لاسترجاعها، افتح سلة المهملات واختر “إرجاع”."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
