    "transcription.deleteWhileTranscribing" : {
      "comment" : "Alert shown when Delete Transcript is chosen for an audiobook that is being transcribed. %@ is the audiobook's title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يجري تفريغ %@. ألغِ التفريغ، أو احذف النسخة النصية بعد اكتماله."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ট্রান্সক্রাইব করা হচ্ছে। এটি বাতিল করুন, অথবা শেষ হলে ট্রান্সক্রিপ্ট মুছুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ wird gerade transkribiert. Brich den Vorgang ab oder lösche das Transkript, sobald er fertig ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is being transcribed. Cancel it, or delete the transcript once it finishes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ se está transcribiendo. Cancélalo o elimina la transcripción cuando termine."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ در حال رونویسی است. آن را لغو کنید، یا پس از پایان کار، رونوشت را حذف کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ est en cours de transcription. Annulez-la, ou supprimez la transcription une fois qu’elle est terminée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ בתהליך תמלול. בטל את התמלול, או מחק את התמליל לאחר שיסתיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ को ट्रांसक्राइब किया जा रहा है। इसे रद्द करें, या इसके पूरा होने पर ट्रांसक्रिप्ट मिटाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ sedang ditranskripsikan. Batalkan transkripsinya, atau hapus transkrip setelah selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il libro %@ è in fase di trascrizione. Annullala, oppure elimina la trascrizione al termine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@は文字起こし中です。キャンセルするか、完了してから文字起こしを削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@의 대본을 만드는 중입니다. 취소하거나, 끝난 후에 대본을 삭제하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ wordt getranscribeerd. Annuleer dit of verwijder de transcriptie zodra het klaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trwa transkrybowanie: %@. Anuluj je albo usuń transkrypcję po jego zakończeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ está sendo transcrito. Cancele a transcrição ou exclua a transcrição quando ela terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Аудиокнига «%@» сейчас расшифровывается. Отмените расшифровку или удалите расшифровку после её завершения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ håller på att transkriberas. Avbryt transkriberingen eller radera transkriptionen när den är klar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "กำลังถอดเสียง %@ ให้ยกเลิก หรือลบข้อความถอดเสียงหลังจากเสร็จแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
