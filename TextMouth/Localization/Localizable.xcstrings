    "bookTextEdit.addBackNoCopyKept" : {
      "comment" : "Message when adding a book back to the library stopped because no backup of the text it held could be made. %@ is the book's title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم تتم إعادة إضافة %@: تعذّر الاحتفاظ أولًا بنسخة من النص الذي تحتويه حزمته، لذا ترك TextMouth النص كما هو."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ আবার যোগ করা হয়নি: এর প্যাকেজে থাকা টেক্সটের কোনো কপি আগে রাখা যায়নি, তাই TextMouth টেক্সট যেমন ছিল তেমনই রেখেছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ wurde nicht wieder hinzugefügt: Der Text aus seinem Paket konnte vorher nicht gesichert werden, deshalb hat TextMouth ihn unverändert gelassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ was not added back: no copy of the text its package held could be kept first, so TextMouth left the text as it was."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no se volvió a agregar a la biblioteca: antes no se pudo conservar una copia del texto que tenía su paquete, así que TextMouth dejó el texto como estaba."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ دوباره به کتابخانه افزوده نشد: ابتدا نسخه‌ای از متنی که بسته‌اش داشت قابل نگه‌داری نبود، بنابراین TextMouth متن را همان‌طور که بود گذاشت."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ n’a pas été remis dans la bibliothèque : le texte que contenait son paquet n’a pas pu être sauvegardé d’abord, donc TextMouth l’a laissé tel quel."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ לא נוסף בחזרה: לא ניתן היה לשמור קודם עותק של הטקסט שהחבילה שלו הכילה, ולכן TextMouth השאיר את הטקסט כפי שהיה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ को वापस नहीं जोड़ा गया: उसके पैकेज में मौजूद टेक्स्ट की कोई प्रति पहले नहीं रखी जा सकी, इसलिए TextMouth ने टेक्स्ट जैसा था वैसा ही छोड़ दिया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ tidak ditambahkan kembali: salinan teks yang ada di paketnya tidak dapat disimpan terlebih dahulu, sehingga TextMouth membiarkan teks apa adanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ non è stato aggiunto di nuovo: prima non è stato possibile conservare una copia del testo contenuto nel suo pacchetto, quindi TextMouth ha lasciato il testo com’era."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@をライブラリに戻しませんでした：パッケージに含まれていたテキストのコピーを先に保持できなかったため、TextMouth はテキストをそのままにしました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@을(를) 다시 추가하지 않았습니다. 패키지에 있던 텍스트의 사본을 먼저 보관할 수 없어 TextMouth가 텍스트를 그대로 두었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ is niet opnieuw toegevoegd: er kon eerst geen kopie worden bewaard van de tekst in het pakket, dus TextMouth heeft de tekst ongewijzigd gelaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie dodano ponownie książki %@: nie udało się najpierw zachować kopii tekstu zapisanego w jej pakiecie, więc TextMouth pozostawił tekst bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não foi possível adicionar %@ de volta: nenhuma cópia do texto do pacote pôde ser guardada antes, então o TextMouth deixou o texto como estava."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не удалось добавить «%@» обратно: сначала не получилось сохранить копию текста из пакета книги, поэтому TextMouth оставил текст без изменений."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ lades inte till i biblioteket igen: ingen kopia av texten som dess paket innehöll kunde sparas först, så TextMouth lämnade texten som den var."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไม่ได้เพิ่ม %@ กลับ เพราะสำรองข้อความในแพ็กเกจไว้ก่อนไม่ได้ TextMouth จึงคงข้อความไว้ตามเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ geri eklenmedi: paketindeki metnin bir kopyası önceden saklanamadığı için TextMouth metni olduğu gibi bıraktı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ не додано назад: не вдалося спершу зберегти копію тексту з її пакета, тому TextMouth залишив текст без змін."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ کو واپس شامل نہیں کیا گیا: اس کے پیکیج میں موجود متن کی کوئی کاپی پہلے محفوظ نہ ہو سکی، اس لیے TextMouth نے متن کو جوں کا توں چھوڑ دیا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ chưa được thêm lại: không thể giữ trước một bản sao văn bản trong gói của nó, nên TextMouth để nguyên văn bản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 未重新添加到资料库：无法先保留其包内文本的副本，因此 TextMouth 未改动文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 未能重新加入：無法先保留其套件中文字的副本，因此 TextMouth 讓文字維持原樣。"
          }
        }
      }
    },
