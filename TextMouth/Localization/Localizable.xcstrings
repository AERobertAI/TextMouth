    "transcriptTextError.textNotKept" : {
      "comment" : "Error shown when a transcript could not replace a book's text because the text's unsaved changes could not be copied first.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "في نص الكتاب تغييرات تعذّر على TextMouth نسخها، لذا يترك النص كما هو."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইয়ের টেক্সটে এমন পরিবর্তন আছে যা TextMouth কপি করতে পারেনি, তাই এটি টেক্সট যেমন আছে তেমনই রাখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Text des Buchs hat Änderungen, die TextMouth nicht kopieren konnte, daher bleibt der Text unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The book's text has changes TextMouth couldn't copy, so it leaves the text as it is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto del libro tiene cambios que TextMouth no pudo copiar, así que deja el texto como está."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "متن کتاب تغییراتی دارد که TextMouth نتوانست کپی کند، پس متن را همان‌طور که هست می‌گذارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le texte du livre a des modifications que TextMouth n’a pas pu copier, donc il laisse le texte tel quel."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בטקסט של הספר יש שינויים ש-TextMouth לא הצליח להעתיק, ולכן הוא משאיר את הטקסט כפי שהוא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पुस्तक के टेक्स्ट में ऐसे बदलाव हैं जिन्हें TextMouth कॉपी नहीं कर सका, इसलिए वह टेक्स्ट को जैसा है वैसा छोड़ देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Teks buku memiliki perubahan yang tidak dapat disalin TextMouth, jadi teksnya dibiarkan seperti semula."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo del libro ha modifiche che TextMouth non è riuscito a copiare, quindi lascia il testo com’è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブックのテキストにコピーできなかった変更があるため、TextMouth はテキストをそのままにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책의 텍스트에 TextMouth가 복사할 수 없는 변경 사항이 있어서 텍스트를 그대로 둡니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
