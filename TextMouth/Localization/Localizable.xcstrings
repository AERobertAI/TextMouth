    "bookExport.destinationInLibrary" : {
      "comment" : "Why the Export dialog refuses the folder chosen: it is TextMouth's own library folder or inside it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يستطيع التصدير الكتابة في مجلد مكتبة TextMouth. اختر مجلدًا آخر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "রপ্তানি TextMouth-এর লাইব্রেরি ফোল্ডারে লিখতে পারে না। অন্য একটি ফোল্ডার বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Export kann nicht in den Bibliotheksordner von TextMouth schreiben. Wähle einen anderen Ordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export can't write into TextMouth's library folder. Choose another folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La exportación no puede escribir en la carpeta de la biblioteca de TextMouth. Elige otra carpeta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صادر کردن نمی‌تواند در پوشه‌ی کتابخانه‌ی TextMouth بنویسد. پوشه‌ای دیگر انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’exportation ne peut pas écrire dans le dossier de la bibliothèque de TextMouth. Choisissez un autre dossier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הייצוא לא יכול לכתוב לתיקיית הספרייה של TextMouth. בחר תיקייה אחרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "निर्यात TextMouth के लाइब्रेरी फ़ोल्डर में नहीं लिख सकता। कोई दूसरा फ़ोल्डर चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ekspor tidak dapat menulis ke folder pustaka TextMouth. Pilih folder lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’esportazione non può scrivere nella cartella della libreria di TextMouth. Scegli un’altra cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth のライブラリフォルダには書き出せません。別のフォルダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "내보내기는 TextMouth의 보관함 폴더에 쓸 수 없습니다. 다른 폴더를 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Exporteren naar de bibliotheekmap van TextMouth is niet mogelijk. Kies een andere map."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eksport nie może zapisywać w folderze biblioteki TextMouth. Wybierz inny folder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A exportação não pode gravar na pasta da biblioteca do TextMouth. Escolha outra pasta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Экспорт не может записывать в папку библиотеки TextMouth. Выберите другую папку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Det går inte att exportera till mappen där TextMouth har sitt bibliotek. Välj en annan mapp."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "การส่งออกเขียนลงในโฟลเดอร์ไลบรารีของ TextMouth ไม่ได้ เลือกโฟลเดอร์อื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dışa aktarma, TextMouth'un kitaplık klasörüne yazamaz. Başka bir klasör seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Експорт не може записувати в папку бібліотеки TextMouth. Виберіть іншу папку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "برآمد TextMouth کے لائبریری فولڈر میں نہیں لکھ سکتی۔ کوئی دوسرا فولڈر منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không thể xuất vào thư mục thư viện của TextMouth. Hãy chọn thư mục khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "导出无法写入 TextMouth 的资料库文件夹。请选取其他文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "輸出無法寫入 TextMouth 的書庫檔案夾。請選擇其他檔案夾。"
          }
        }
      }
    },
