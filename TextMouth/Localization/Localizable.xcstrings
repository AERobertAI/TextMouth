    "sleepTimerView.endOfBookHint.stop" : {
      "comment" : "VoiceOver hint and help tag of the sleep timer sheet's End of book button, for a book that stops at its end on its own, so the timer adds nothing there.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يشغّل الكتاب؛ ويتوقف عند نهايته على أي حال."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইটি চালায়; এটি যেকোনো ক্ষেত্রে এর শেষে থামে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gibt das Buch wieder; es hält an seinem Ende ohnehin an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plays the book; it stops at its end anyway."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproduce el libro; de todos modos se detiene al final."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب را پخش می‌کند؛ به هر حال در پایانش متوقف می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lit le livre ; il s’arrête de toute façon à la fin."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מנגן את הספר; הוא נעצר בסופו בכל מקרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पुस्तक चलाता है; वह वैसे भी अपने अंत पर रुक जाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Memutar buku; buku memang berhenti di akhirnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
