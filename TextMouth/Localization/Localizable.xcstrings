    "originalFileDeletion.consequence.recover" : {
      "comment" : "Sentence of the confirmation about the original file of a book just imported, and the hint of its Move to Trash button: the file can be recovered from the Trash.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يمكنك استرجاعه من سلة المهملات إلى أن تُفرَّغ السلة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ট্র্যাশ খালি না করা পর্যন্ত আপনি এটি ট্র্যাশ থেকে ফিরিয়ে আনতে পারবেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du kannst sie aus dem Papierkorb wiederherstellen, bis er geleert wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can recover it from the Trash until the Trash is emptied."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Puedes recuperarlo de la Papelera hasta que la vacíes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تا خالی شدن سطل زباله می‌توانید آن را از آنجا بازیابی کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vous pouvez le récupérer dans la corbeille jusqu’à ce qu’elle soit vidée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אפשר לשחזר אותו מהאשפה עד לריקון האשפה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आप उसे ट्रैश खाली होने तक ट्रैश से वापस पा सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Anda dapat memulihkannya dari Tempat Sampah sampai Tempat Sampah dikosongkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Puoi recuperarlo dal Cestino finché non viene svuotato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ゴミ箱を空にするまでは、ゴミ箱から復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "휴지통을 비우기 전에는 휴지통에서 복구할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Je kunt het terughalen uit de prullenmand tot de prullenmand wordt geleegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
