    "duplicateFinder.scanHint" : {
      "comment" : "VoiceOver hint of the Scan for Duplicates button of Find Duplicate Books.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يبحث في المكتبة كلها عن كتب تطابق المعايير المحددة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "নির্বাচিত মানদণ্ডের সঙ্গে মেলে এমন বইয়ের জন্য পুরো লাইব্রেরিতে অনুসন্ধান করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Durchsucht die gesamte Bibliothek nach Büchern, die den gewählten Kriterien entsprechen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Searches the entire library for books matching the selected criteria"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Busca en toda la biblioteca libros que coincidan con los criterios seleccionados"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کل کتابخانه را برای کتاب‌های مطابق با معیارهای انتخاب‌شده جست‌وجو می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Recherche dans toute la bibliothèque les livres correspondant aux critères sélectionnés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מחפש בכל הספרייה ספרים התואמים לקריטריונים שנבחרו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चुने गए मानदंडों से मेल खाती पुस्तकों के लिए पूरी लाइब्रेरी खोजता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mencari buku yang cocok dengan kriteria terpilih di seluruh pustaka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cerca nell’intera libreria i libri che corrispondono ai criteri selezionati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選択した条件に一致するブックをライブラリ全体から検索します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "선택한 기준과 일치하는 책을 보관함 전체에서 검색합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Doorzoekt de hele bibliotheek op boeken die aan de geselecteerde criteria voldoen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
