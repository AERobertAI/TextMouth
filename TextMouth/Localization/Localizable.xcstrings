    "Switch to a Library or book window, then choose Export again." : {
      "comment" : "What choosing File, Export says when another window, such as Settings, is in front of the Library and book windows.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wechsle zu einem Bibliotheks- oder Buchfenster und wähle dann erneut „Exportieren“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cambia a una ventana de la biblioteca o de un libro y vuelve a elegir Exportar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Passez à une fenêtre de bibliothèque ou de livre, puis choisissez de nouveau Exporter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लाइब्रेरी या पुस्तक की विंडो पर जाएँ, फिर निर्यात करें दोबारा चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beralih ke jendela Pustaka atau buku, lalu pilih Ekspor lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Passa a una finestra della libreria o di un libro, poi scegli di nuovo Esporta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ライブラリまたはブックのウインドウに切り替えてから、もう一度「書き出す」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관함 또는 책 윈도우로 전환한 다음 내보내기를 다시 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mude para uma janela da biblioteca ou de um livro e escolha Exportar de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
