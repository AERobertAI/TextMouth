          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس میں وہی کتابیں، مقامات، بک مارکس، مطالعے کی فہرست اور فولڈر ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
