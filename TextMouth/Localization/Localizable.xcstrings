    "Type text to find in every book of the library." : {
      "comment" : "Status line of the Search Library window before anything is typed.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escribe el texto que quieres buscar en todos los libros de la biblioteca."
          }
