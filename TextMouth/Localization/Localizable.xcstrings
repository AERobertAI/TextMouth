    "readerPage.typingHint" : {
      "comment" : "Last sentence of the Go to Page field's hint: what the user may type. 12 and xii are examples of page labels, a number and a roman numeral.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اكتب صفحة كما يرقّمها الكتاب، مثل 12 أو xii."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইয়ে যেভাবে নম্বর দেওয়া আছে সেভাবে একটি পৃষ্ঠা লিখুন, যেমন 12 বা xii।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gib eine Seite so ein, wie das Buch sie nummeriert, etwa 12 oder xii."
          }
        },
        "en" : {
