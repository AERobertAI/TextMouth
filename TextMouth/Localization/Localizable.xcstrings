        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay ninguna ventana de la biblioteca ni ningún libro abierto, así que no hay nada que exportar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هیچ پنجره‌ی کتابخانه یا کتابی باز نیست، بنابراین چیزی برای صادر کردن نیست."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucune fenêtre de bibliothèque ni aucun livre n’est ouvert, il n’y a donc rien à exporter."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אין חלון ספרייה או ספר פתוח, ולכן אין מה לייצא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कोई लाइब्रेरी विंडो या पुस्तक खुली नहीं है, इसलिए निर्यात करने के लिए कुछ नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tidak ada jendela Pustaka atau buku yang terbuka, jadi tidak ada yang dapat diekspor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non ci sono finestre della libreria né libri aperti, quindi non c’è nulla da esportare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ライブラリのウインドウもブックも開いていないため、書き出せるものがありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "열려 있는 보관함 윈도우나 책이 없으므로 내보낼 항목이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Er is geen bibliotheekvenster of boek geopend, dus er is niets om te exporteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie jest otwarte okno biblioteki ani żadna książka, więc nie ma czego eksportować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nenhuma janela da biblioteca nem livro está aberto, então não há nada para exportar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Нет открытого окна библиотеки или книги, поэтому экспортировать нечего."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Varken något biblioteksfönster eller någon bok är öppen, så det finns inget att exportera."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไม่มีหน้าต่างไลบรารีหรือหนังสือที่เปิดอยู่ จึงไม่มีสิ่งที่จะส่งออก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Açık bir Kitaplık penceresi veya kitap yok, bu yüzden dışa aktarılacak bir şey yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Немає відкритого вікна бібліотеки чи книги, тож нічого експортувати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کوئی لائبریری ونڈو یا کتاب کھلی نہیں ہے، اس لیے برآمد کرنے کو کچھ نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không có cửa sổ Thư viện hay sách nào đang mở, nên không có gì để xuất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "没有打开资料库窗口或图书，因此没有可导出的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "沒有打開的書庫視窗或書籍，因此沒有可輸出的內容。"
          }
        }
      }
    },
