    "feedArrivalAlert.title.articles" : {
      "comment" : "Title of the alert shown after a refresh TextMouth made by itself brought new articles. Title case.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مقالات جديدة"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "নতুন নিবন্ধ"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Neue Artikel"
          }
        },
