    "audioEditor.sectionsNotEditable" : {
      "comment" : "Said when Edit Audio… is chosen for a book whose sections are stretches of its audio tracks. %@ is the book's title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يشغّل %@ أقسامًا هي أجزاء من مقاطعه، لذا لا يمكن تحرير مقاطعه بعد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@-এর বিভাগগুলো এর ট্র্যাকের অংশ থেকে চলে, তাই এর ট্র্যাক এখনও সম্পাদনা করা যায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ gibt Abschnitte wieder, die Teile seiner Tracks sind, daher können seine Tracks noch nicht bearbeitet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ plays sections that are stretches of its tracks, so its tracks can't be edited yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ reproduce secciones que son tramos de sus pistas, así que todavía no se pueden editar sus pistas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ بخش‌هایی پخش می‌کند که تکه‌هایی از تراک‌های آن هستند، پس هنوز نمی‌توان تراک‌های آن را ویرایش کرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ lit des sections qui sont des portions de ses pistes, donc ses pistes ne peuvent pas encore être modifiées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ מנגן מקטעים שהם קטעים מתוך הרצועות שלו, ולכן עדיין אי אפשר לערוך את הרצועות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ के खंड इसके ट्रैक के हिस्से हैं, इसलिए इसके ट्रैक अभी संपादित नहीं किए जा सकते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ memutar bagian yang merupakan potongan dari treknya, sehingga treknya belum dapat diedit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il libro %@ riproduce sezioni che sono parti delle sue tracce, quindi per ora le sue tracce non si possono modificare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@は複数のトラックの一部の区間を再生するため、そのトラックはまだ編集できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@은(는) 트랙의 일부 구간을 섹션으로 재생하므로, 아직 트랙을 편집할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ speelt secties af die delen van de tracks zijn, dus de tracks kunnen nog niet worden gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Książka %@ odtwarza sekcje będące fragmentami jej ścieżek, więc nie można jeszcze edytować jej ścieżek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ reproduz seções que são trechos de suas faixas, então as faixas ainda não podem ser editadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Книга «%@» воспроизводится по разделам, которые являются отрезками её дорожек, поэтому дорожки пока нельзя изменить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ spelar upp sektioner som är delar av dess spår, så spåren kan inte redigeras än."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ เล่นส่วนที่เป็นช่วงของแทร็ก จึงยังแก้ไขแทร็กไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ kitabının kısımları ses parçalarının belirli aralıklarıdır, bu yüzden parçaları henüz düzenlenemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "У %@ секції є фрагментами доріжок, тому доріжки поки що не можна редагувати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ایسے حصے چلاتی ہے جو اس کے ٹریکس کے ٹکڑے ہیں، اس لیے اس کے ٹریکس میں ابھی ترمیم نہیں کی جا سکتی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ phát các phần là những đoạn của các bản âm thanh, nên chưa thể sửa các bản âm thanh của sách."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@”播放的是其音轨中的片段，因此暂时无法编辑其音轨。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」的區段是其音軌中的片段，因此尚無法編輯其音軌。"
          }
        }
      }
    },
