        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Livre suivant non lancé à cause du minuteur de mise en veille"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הספר הבא לא התחיל בגלל טיימר השינה"
