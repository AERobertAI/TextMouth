    "There is not enough free disk space to convert %@: it needs %@ free." : {
      "comment" : "Why an audio conversion did not start: the disk holds too little free space. %1$@ is the source file's name and %2$@ the free space it needs, with its unit, such as \"1.2 GB\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es ist nicht genug freier Speicherplatz vorhanden, um %1$@ umzuwandeln: Es werden %2$@ frei benötigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There is not enough free disk space to convert %1$@: it needs %2$@ free."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay suficiente espacio libre en el disco para convertir %1$@: necesita %2$@ libres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il n’y a pas assez d’espace disque libre pour convertir %1$@ : il faut %2$@ de libre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ को बदलने के लिए डिस्क पर पर्याप्त खाली जगह नहीं है: उसे %2$@ खाली चाहिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ruang disk kosong tidak cukup untuk mengonversi %1$@: diperlukan %2$@ ruang kosong."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non c’è abbastanza spazio libero su disco per convertire %1$@: servono %2$@ liberi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@を変換するための空きディスク容量が足りません。%2$@の空き容量が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@을(를) 변환하기에 디스크의 여유 공간이 부족합니다. 여유 공간 %2$@이(가) 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
