          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "导入时的图书文件；对于有声书，则为 TextMouth 转换前的音频文件。"
          }
        }
      }
    },
    "The book's files aren't on this Mac yet. %@ may still be syncing them." : {
      "comment" : "Why a book can't be used yet: its files have not arrived. %@ is the cloud service's name, or \"The cloud service\" when it is unknown.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ملفات الكتاب ليست على هذا الـ Mac بعد. ربما لا يزال %@ يزامنها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইটির ফাইল এখনো এই Mac-এ আসেনি। %@ হয়তো এখনো সেগুলো সিঙ্ক করছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
