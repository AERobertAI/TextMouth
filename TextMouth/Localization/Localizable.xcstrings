    "dataDirectoryMove.cancelHint" : {
      "comment" : "VoiceOver hint of the button that cancels the move of the library.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يوقف نقل المكتبة. تبقى المكتبة حيث هي، ولا يتغير أي شيء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "লাইব্রেরি স্থানান্তর থামায়। লাইব্রেরি যেখানে আছে সেখানেই থাকে, কিছুই বদলায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppt das Verschieben der Bibliothek. Die Bibliothek bleibt, wo sie ist, und nichts wird geändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops moving the library. The library stays where it is, and nothing is changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detiene el traslado de la biblioteca. La biblioteca queda donde está y no se cambia nada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "انتقال کتابخانه را متوقف می‌کند. کتابخانه همان‌جا که هست می‌ماند و چیزی تغییر نمی‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrête le déplacement de la bibliothèque. La bibliothèque reste où elle est, et rien n’est modifié."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "עוצר את העברת הספרייה. הספרייה נשארת במקומה, ודבר לא משתנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लाइब्रेरी को ले जाना रोकता है। लाइब्रेरी जहाँ है वहीं रहती है, और कुछ नहीं बदलता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menghentikan pemindahan pustaka. Pustaka tetap di tempatnya, dan tidak ada yang diubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe lo spostamento della libreria. La libreria resta dov’è e nulla viene modificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ライブラリの移動を停止します。ライブラリはそのままで、何も変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관함 이동을 중지합니다. 보관함은 그대로 있으며 아무것도 변경되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stopt het verplaatsen van de bibliotheek. De bibliotheek blijft waar ze is en er wordt niets gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zatrzymuje przenoszenie biblioteki. Biblioteka pozostaje tam, gdzie jest, i nic się nie zmienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para de mover a biblioteca. A biblioteca fica onde está, e nada é alterado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Останавливает перемещение библиотеки. Библиотека остаётся на месте, ничего не меняется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppar flytten av biblioteket. Biblioteket stannar där det är, och inget ändras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หยุดการย้ายไลบรารี ไลบรารีจะอยู่ที่เดิมและไม่มีอะไรเปลี่ยนแปลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitaplığı taşımayı durdurur. Kitaplık olduğu yerde kalır ve hiçbir şey değişmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Зупиняє переміщення бібліотеки. Бібліотека залишається на місці, і нічого не змінюється."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لائبریری کی منتقلی روک دیتا ہے۔ لائبریری وہیں رہتی ہے جہاں ہے، اور کچھ نہیں بدلتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dừng di chuyển thư viện. Thư viện giữ nguyên vị trí và không có gì thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止移动资料库。资料库保持原位，不做任何更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止移動書庫。書庫會留在原處，不會有任何更改。"
          }
        }
      }
    },
