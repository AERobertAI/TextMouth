          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 화면을 닫아도 됩니다. 내보내기는 계속됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Je kunt dit sluiten. De export gaat door."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Możesz to zamknąć. Eksport trwa dalej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Você pode fechar isto. A exportação continua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Это окно можно закрыть. Экспорт продолжится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du kan stänga det här. Exporten fortsätter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "คุณปิดหน้านี้ได้ การส่งออกจะทำต่อไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bunu kapatabilirsiniz. Dışa aktarma sürer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Це вікно можна закрити. Експорт триває."
          }
        },
        "ur" : {
          "stringUnit" : {
