          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth passe à une autre bibliothèque et se rouvre dessus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth दूसरी लाइब्रेरी पर स्विच कर रहा है और उस पर फिर से खुल रहा है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth sedang beralih ke pustaka lain dan terbuka lagi di sana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
