    "libraryCloud.thenLetGoOfOneBook" : {
      "comment" : "Last sentence of why Remove Download was refused for a book the listener keeps and the reading list keeps too: what to do after choosing Stop Keeping on This Mac. %@ is the name of the Reading List's option that keeps its books downloaded, as the option shows it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ثم أزله من قائمة القراءة، أو ألغِ تحديد %@ في خيارات قائمة القراءة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "তারপর এটি পড়ার তালিকা থেকে সরান, অথবা পড়ার তালিকার বিকল্পে “%@” অচিহ্নিত করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nimm es dann von der Leseliste oder deaktiviere %@ in den Optionen der Leseliste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Then take it off the reading list, or clear %@ in the Reading List's options."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Luego quítalo de la lista de lectura, o desactiva %@ en las opciones de la lista de lectura."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سپس آن را از فهرست مطالعه بردارید، یا %@ را در گزینه‌های فهرست مطالعه پاک کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Retirez-le ensuite de la liste de lecture, ou décochez %@ dans les options de la liste de lecture."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ואז הסר אותו מרשימת הקריאה, או בטל את הסימון של “%@” באפשרויות של רשימת הקריאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फिर उसे रीडिंग लिस्ट से हटाएँ, या रीडिंग लिस्ट के विकल्पों में %@ को अचयनित करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lalu keluarkan dari daftar bacaan, atau matikan %@ di opsi Daftar Bacaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Poi toglilo dall’elenco di lettura, oppure disattiva %@ nelle opzioni dell’elenco di lettura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "そのあと、リーディングリストから外すか、リーディングリストのオプションで「%@」の選択を解除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "그다음 읽기 목록에서 제거하거나 읽기 목록 옵션에서 %@을(를) 해제하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Haal het daarna van de leeslijst af of schakel %@ uit bij de opties van de leeslijst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Następnie zdejmij ją z listy czytelniczej albo odznacz %@ w opcjach listy czytelniczej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Depois, tire-o da lista de leitura ou desmarque %@ nas opções da Lista de leitura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Затем уберите её из списка для чтения или снимите отметку «%@» в параметрах списка для чтения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ta sedan bort den från läslistan, eller avmarkera ”%@” i läslistans alternativ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "จากนั้นนำออกจากรายการอ่าน หรือล้าง %@ ในตัวเลือกของรายการอ่าน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sonra onu okuma listesinden çıkarın veya Okuma Listesi seçeneklerinde “%@” seçeneğinin işaretini kaldırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Потім вилучіть її зі списку читання або зніміть позначку «%@» у параметрах списку читання."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پھر اسے مطالعے کی فہرست سے ہٹائیں، یا مطالعے کی فہرست کے اختیارات میں “%@” آف کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sau đó hãy gỡ nó khỏi danh sách đọc, hoặc bỏ chọn %@ trong tùy chọn của Danh sách đọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "然后将它从阅读列表中移除，或在阅读列表的选项中取消勾选 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "然後請將它從閱讀列表中移除，或在閱讀列表的選項中取消勾選 %@。"
          }
        }
      }
    },
