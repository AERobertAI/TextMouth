            "value" : "Comment la voix lit un symbole écrit plusieurs fois de suite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आवाज़ लगातार कई बार लिखे गए प्रतीक को कैसे पढ़ती है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cara suara membaca simbol yang ditulis beberapa kali berturut-turut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Come la voce legge un simbolo scritto più volte di seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "同じ記号が何度も続くとき、声がどう読み上げるかを選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "같은 기호가 여러 번 연속될 때 음성이 읽는 방식."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Como a voz lê um símbolo escrito várias vezes seguidas."
