    "feedSettings.notificationsHint" : {
      "comment" : "VoiceOver hint of the switch that posts notifications for new items.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
