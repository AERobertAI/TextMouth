    "Text not updated: %@" : {
      "comment" : "Announcement when an edited text could not be taken for a reason the system or another part of the app gives. %@ is the reason."
    },
    "Text not updated: %@ was removed, or its download deleted, so Edit Text has stopped for it." : {
      "comment" : "Announcement when an Edit Text session ends because the book left the library. %@ is the book's title. Edit Text is a menu command."
    },
    "Text not updated: chapter %@ of the edited text of %@ %@, which TextMouth can't read safely. Flatten it and save again, or undo the change; the book keeps its old text until then." : {
      "comment" : "Announcement when an edited text was refused because one chapter nests lists or quotes too deeply. %1$@ is the chapter's number, an identifier written without digit grouping; %2$@ is the book's title; %3$@ is a clause such as \"nests more than 20 levels deep\", written by another part of the app.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Text not updated: chapter %1$@ of the edited text of %2$@ %3$@, which TextMouth can't read safely. Flatten it and save again, or undo the change; the book keeps its old text until then."
          }
        }
      }
    },
    "Text not updated: the edited text of %@ %@, which TextMouth can't read safely. Flatten it and save again, or undo the change; the book keeps its old text until then." : {
      "comment" : "Announcement when an edited text was refused because it nests lists or quotes too deeply. %1$@ is the book's title; %2$@ is a clause such as \"nests more than 20 levels deep\", written by another part of the app.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Text not updated: the edited text of %1$@ %2$@, which TextMouth can't read safely. Flatten it and save again, or undo the change; the book keeps its old text until then."
          }
        }
      }
    },
    "Text not updated: the edited text of %@ has no chapter with any text. Undo the change and save again; the book keeps its old text until then." : {
      "comment" : "Announcement when an edited text was refused because no chapter has any text left. %@ is the book's title."
    },
    "Text not updated: the edited text of %@ isn't UTF-8 text. Save it as UTF-8; the book keeps its old text until then." : {
      "comment" : "Announcement when an edited text was refused because it is not UTF-8 text. %@ is the book's title. UTF-8 is a text encoding."
    },
    "Text not updated: the edited transcript of %@ adds words to a chapter with no speech, where they can't be kept. Remove them and save again; the book keeps its old text until then." : {
      "comment" : "Announcement when an edited transcript was refused because the user added words to a chapter with no speech. %@ is the book's title."
    },
    "Text not updated: the edited transcript of %@ changes a chapter's heading, which comes from its audio. Put it back and save again; the book keeps its old text until then." : {
      "comment" : "Announcement when an edited transcript was refused because the user changed a chapter's heading. %@ is the book's title."
    },
    "Text not updated: the edited transcript of %@ has %@, but the audiobook has %@. Keep every line beginning with <!-- chapter: and save again; the book keeps its old text until then." : {
      "comment" : "Announcement when an edited transcript was refused because its number of chapters no longer matches the audiobook's. %1$@ is the book's title; %2$@ and %3$@ are counts of chapters such as \"3 chapters\". \"<!-- chapter:\" is literal text in the file and stays exactly as written.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Text not updated: the edited transcript of %1$@ has %2$@, but the audiobook has %3$@. Keep every line beginning with <!-- chapter: and save again; the book keeps its old text until then."
          }
        }
      }
    },
    "Text not updated: the original file of %@ changed too. The book's text is read from it again the next time the book opens." : {
      "comment" : "Announcement when an edited text was not taken because the book's own file changed too. %@ is the book's title."
    },
    "Text not updated: the transcript of %@ changed too. The book's text is written from it again the next time the book opens." : {
      "comment" : "Announcement when an edited text was not taken because the book's transcript changed too. %@ is the book's title."
    },
    "Text updated" : {
      "comment" : "Announcement after the user saved an edited text and TextMouth took it as the book's text. Written without its full stop."
    },
    "Text updated." : {
      "comment" : "Announcement after the user saved an edited text of a feed episode's transcript, followed by a note about where the transcript stays."
    },
    "TextMouth closed while opening %@, so it wasn't reopened." : {
      "comment" : "Announced at launch after the app closed while it was opening a book. %@ is the book's title, which is not opened again."
    },
    "TextMouth hasn't read the latest save yet." : {
      "comment" : "Reason after a colon: a rebuild left the book's text alone because the latest save of the edited text is not read yet."
    },
    "TextMouth is not downloading right now." : {
      "comment" : "Why the download of a feed's next episode did not start: the app is quitting or the feed is being deleted. Said after \"The next episode could not be downloaded, so playback stopped.\"",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no está descargando en este momento."
          }
        }
      }
    },
    "TextMouth kept the text you changed in %@." : {
      "comment" : "First sentence of the message when an automatic rebuild left a book's edited text alone. %@ is the book's title."
    },
    "TextMouth opens the book's manifest.json in your text editor." : {
      "comment" : "First sentence of the Edit Manifest explanation. manifest.json is a file name and stays as written."
    },
    "TextMouth opens the book's text in your text editor, as a Markdown file." : {
      "comment" : "First sentence of the Edit Text explanation. Markdown is the name of a text format."
    },
    "The %@ page labelled %@" : {
      "comment" : "The start of a sentence naming one of several pages that carry the same label. %1$@ is which of them it is, as an ordinal word such as \"first\" or \"11th\"; %2$@ is the label, an identifier written without digit grouping.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The %1$@ page labelled %2$@"
          }
        }
      }
    },
    "The %lld selected books are already in the reading list." : {
      "comment" : "VoiceOver announcement when Add to Reading List added nothing: every book selected is on the list already. %lld is the number of books selected (two or more).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los %lld libros seleccionados ya están en la lista de lectura."
