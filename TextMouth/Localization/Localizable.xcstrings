    },
    "The original file you imported is not changed." : {
      "comment" : "Last sentence of the warning shown under the metadata editor's switch while it is on: the file the user first imported stays as it was."
    },
    "The original file you imported is not touched." : {
      "comment" : "Last sentence of the hint of the metadata editor's switch that also writes the EPUB file: the file the user first imported stays as it was."
    },
    "The previous article could not be downloaded, so playback stopped." : {
      "comment" : "First sentence of the VoiceOver announcement when Previous in Folder could not download the previous feed article while a book was playing, so playback was paused. A sentence with the reason follows it."
    },
    "The previous article could not be downloaded." : {
      "comment" : "First sentence of the VoiceOver announcement when Previous in Folder could not download the previous feed article. A sentence with the reason follows it."
    },
    "The previous episode could not be downloaded, so playback stopped." : {
