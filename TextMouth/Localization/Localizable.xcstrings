        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מציג אורך, קובץ ועריכות; קובע מה קורה לשמע המקורי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "अवधि, फ़ाइल और संपादन दिखाता है; मूल ऑडियो का क्या होगा, यह सेट करता है।"
