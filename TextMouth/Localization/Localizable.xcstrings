    "“%@” is a Personal Voice, which macOS can't record to a file. Choose another voice with the %@ button in the reader, then export again." : {
      "comment" : "Why a spoken audio export was refused: the book's voice is a Personal Voice. %1$@ is the voice's name and %2$@ the name of the Voice button in the book's reader.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%1$@“ ist eine Persönliche Stimme, die macOS nicht in eine Datei aufnehmen kann. Wähle mit der Taste „%2$@“ in der Leseansicht eine andere Stimme und exportiere dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” is a Personal Voice, which macOS can't record to a file. Choose another voice with the %2$@ button in the reader, then export again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%1$@» es una Voz personal, que macOS no puede grabar en un archivo. Elige otra voz con el botón %2$@ del lector y vuelve a exportar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "« %1$@ » est une Voix personnelle, que macOS ne peut pas enregistrer dans un fichier. Choisissez une autre voix avec le bouton %2$@ du lecteur, puis exportez de nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” è una Voce personale, che macOS non può registrare in un file. Scegli un’altra voce con il pulsante %2$@ nel lettore, poi esporta di nuovo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” é uma Voz Pessoal, que o macOS não pode gravar em um arquivo. Escolha outra voz com o botão %2$@ no leitor e exporte de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%1$@» — персональный голос, который macOS не может записать в файл. Выберите другой голос кнопкой «%2$@» в окне чтения, затем экспортируйте снова."
          }
        }
      }
    },
    "“%@” is a pronunciation lexicon, not a playlist." : {
