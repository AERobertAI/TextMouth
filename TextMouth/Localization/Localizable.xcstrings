    "sleepTimerView.resetTimerHint" : {
      "comment" : "VoiceOver hint of the sleep timer sheet's Reset Timer button: the running timer starts again from the length it was set to, and the book plays.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعيد تشغيل المؤقت بكامل مدته ويشغّل الكتاب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "টাইমার তার পূর্ণ দৈর্ঘ্যে আবার শুরু করে এবং বইটি চালায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Startet den Timer mit seiner vollen Dauer neu und gibt das Buch wieder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restarts the timer at its full length and plays the book."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reinicia el temporizador con su duración completa y reproduce el libro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "زمان‌سنج را با طول کامل دوباره شروع می‌کند و کتاب را پخش می‌کند."
          }
