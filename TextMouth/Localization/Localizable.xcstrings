    "textEncoding.stopsEditingNote" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. What a re-read does to Edit Text, said only for a book being edited: the session ends with the re-read, whose new text it never watched (BookTextEditWording.stoppedBookReadAgain(bookTitle:)).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يتوقف “تحرير النص” لهذا الكتاب؛ اختر “تحرير النص” مرة أخرى لتحرير القراءة الجديدة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই বইয়ের জন্য “টেক্সট সম্পাদনা করুন” বন্ধ হয়ে যায়; নতুন করে পড়া টেক্সট সম্পাদনা করতে আবার “টেক্সট সম্পাদনা করুন” বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„Text bearbeiten“ endet für dieses Buch; wähle erneut „Text bearbeiten“, um den neu eingelesenen Text zu bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit Text stops for this book; choose Edit Text again to edit the new reading."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Editar texto se detiene para este libro; elige Editar texto de nuevo para editar la nueva lectura."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«ویرایش متن» برای این کتاب متوقف می‌شود؛ برای ویرایش متن جدید دوباره «ویرایش متن» را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La modification du texte s’arrête pour ce livre ; choisissez de nouveau Modifier le texte pour modifier le nouveau texte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“ערוך טקסט” נעצר עבור הספר הזה; בחר שוב “ערוך טקסט” כדי לערוך את הקריאה החדשה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस पुस्तक के लिए “टेक्स्ट संपादित करें” रुक जाता है; नई रीडिंग को संपादित करने के लिए फिर से “टेक्स्ट संपादित करें” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Edit Teks berhenti untuk buku ini; pilih Edit Teks lagi untuk mengedit pembacaan baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Modifica testo si interrompe per questo libro; scegli di nuovo Modifica testo per modificare la nuova lettura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このブックの「テキストを編集」は終了します。新しい読み込み結果を編集するには、もう一度「テキストを編集」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 책의 텍스트 편집은 중지됩니다. 새로 읽은 결과를 편집하려면 텍스트 편집을 다시 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Het wijzigen van de tekst stopt voor dit boek; kies opnieuw Wijzig tekst om de nieuwe versie te wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Edytowanie tekstu tej książki zostaje przerwane; aby edytować nowy odczyt, wybierz ponownie Edytuj tekst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A edição do texto deste livro é interrompida; escolha Editar texto novamente para editar a nova leitura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Изменение текста этой книги прекращается; чтобы изменить новый текст, снова выберите «Изменить текст»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "”Redigera text” avslutas för den här boken; välj ”Redigera text” igen för att redigera den nya läsningen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "แก้ไขข้อความจะหยุดสำหรับหนังสือเล่มนี้ เลือกแก้ไขข้อความอีกครั้งเพื่อแก้ไขข้อความที่อ่านได้ใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu kitabın “Metni Düzenle” oturumu sona erer; yeniden okunan metni düzenlemek için “Metni Düzenle” komutunu yeniden seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Редагування тексту цієї книги завершується; виберіть «Редагувати текст» ще раз, щоб редагувати заново прочитаний текст."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس کتاب کے لیے “متن میں ترمیم کریں” رک جاتا ہے؛ نئی ریڈنگ میں ترمیم کرنے کے لیے دوبارہ “متن میں ترمیم کریں” منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Việc sửa văn bản cho sách này sẽ dừng; hãy chọn Sửa văn bản lần nữa để sửa kết quả đọc lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此图书的“编辑文本”会停止；再次选取“编辑文本”以编辑新的阅读内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此書的「編輯文字」會停止；請再次選擇「編輯文字」來編輯新的讀取結果。"
          }
        }
      }
    },
