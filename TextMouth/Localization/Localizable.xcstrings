    "settings.autoCloseHint" : {
      "comment" : "VoiceOver hint of the Close sheet after setting timer checkbox in the Playback settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عند الإيقاف، تبقى الورقة مفتوحة وتعرض الوقت المتبقي وزر إعادة الضبط."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বন্ধ থাকলে শিটটি খোলা থাকে এবং অবশিষ্ট সময় ও একটি রিসেট বোতাম দেখায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wenn deaktiviert, bleibt das Sheet offen und zeigt die verbleibende Zeit und eine Taste zum Zurücksetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, the sheet stays open showing the remaining time and a reset button"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si está desactivado, la hoja sigue abierta y muestra el tiempo restante y un botón de reinicio"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اگر خاموش باشد، برگه باز می‌ماند و زمان باقی‌مانده و یک دکمه بازنشانی را نشان می‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si désactivé, la feuille reste ouverte avec le temps restant et un bouton de réinitialisation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כשכבוי, הגיליון נשאר פתוח ומציג את הזמן שנותר ולחצן איפוס."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "बंद होने पर, शीट खुली रहती है और बचा हुआ समय तथा एक रीसेट बटन दिखाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jika nonaktif, lembar tetap terbuka menampilkan sisa waktu dan tombol setel ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se disattivato, il foglio resta aperto e mostra il tempo rimanente e un pulsante di reimpostazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オフにすると、シートは開いたままで、残り時間とリセットボタンが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "비활성화하면 시트가 열린 채로 남아 남은 시간과 재설정 버튼을 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Indien uitgeschakeld blijft het blad open en toont het de resterende tijd en een knop om opnieuw in te stellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gdy ta opcja jest wyłączona, arkusz pozostaje otwarty i pokazuje pozostały czas oraz przycisk resetowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quando desativado, a folha continua aberta mostrando o tempo restante e um botão para reiniciar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Если выключено, лист остаётся открытым и показывает оставшееся время и кнопку сброса."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "När det är av förblir arket öppet och visar återstående tid och en återställningsknapp."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เมื่อปิด ชีตจะยังเปิดอยู่และแสดงเวลาที่เหลือกับปุ่มรีเซ็ต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kapalıyken açılır sayfa açık kalır ve kalan süreyi ve bir sıfırlama düğmesini gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо вимкнено, аркуш залишається відкритим із залишком часу та кнопкою скидання."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آف ہونے پر شیٹ کھلی رہتی ہے اور بچا ہوا وقت اور ری سیٹ بٹن دکھاتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Khi tắt, hộp thoại vẫn mở và hiển thị thời gian còn lại cùng nút đặt lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "关闭后，表单会保持打开，显示剩余时间和重置按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "關閉時，工作表會保持打開，並顯示剩餘時間和重置按鈕。"
          }
        }
      }
    },
    "settings.autoCloseLabel" : {
      "comment" : "VoiceOver label of the Close sheet after setting timer checkbox in the Playback settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "إغلاق ورقة مؤقت النوم بعد ضبط المؤقت"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "টাইমার সেট করার পর স্লিপ টাইমার শিট বন্ধ করুন"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Einschlaf-Timer-Sheet nach dem Einstellen eines Timers schließen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close sleep timer sheet after setting a timer"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cerrar la hoja del temporizador de apagado tras fijar un temporizador"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بستن برگه زمان‌سنج خواب پس از تنظیم زمان‌سنج"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fermer la feuille du minuteur de mise en veille après le réglage d’un minuteur"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "סגור את גיליון טיימר השינה לאחר הגדרת טיימר"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "स्लीप टाइमर सेट करने के बाद शीट बंद करें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tutup lembar timer tidur setelah mengatur timer"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chiudi il foglio del timer di spegnimento dopo l’impostazione di un timer"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "スリープタイマーの設定後にシートを閉じる"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "타이머를 설정한 후 취침 타이머 시트 닫기"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sluit het blad van de slaaptimer na het instellen van een timer"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zamykaj arkusz wyłącznika czasowego po jego ustawieniu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fechar a folha do timer de repouso após definir um timer"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Закрывать лист таймера сна после установки таймера"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stäng arket för insomningstimern när en timer har ställts in"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ปิดชีตตัวตั้งเวลาปิดหลังตั้งเวลา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zamanlayıcı ayarlandıktan sonra uyku zamanlayıcısı açılır sayfasını kapat"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Закривати аркуш таймера сну після встановлення таймера"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ٹائمر لگانے کے بعد سلیپ ٹائمر شیٹ بند کریں"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đóng hộp thoại hẹn giờ ngủ sau khi đặt hẹn giờ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "设置睡眠定时器后关闭睡眠定时器表单"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "設定計時器後關閉睡眠計時器工作表"
          }
        }
      }
    },
