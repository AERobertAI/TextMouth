        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "התיקייה של הערוץ הזה כבר אינה בספרייה. בחר לו תיקייה אחרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस फ़ीड का फ़ोल्डर अब लाइब्रेरी में नहीं है। उसके लिए दूसरा फ़ोल्डर चुनें।"
