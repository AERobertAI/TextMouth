      }
    },
    "The file %@ could not be read quickly enough." : {
      "comment" : "A sentence telling an audio file could not be read fast enough to play. %@ is the file's name, such as 03.mp3.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo %@ no se pudo leer con la rapidez suficiente."
