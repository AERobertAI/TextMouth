        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Навигация книги не соответствует её аудио; получите свежую копию и снова импортируйте её."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "图书的导航与其音频不符；请获取新副本，然后再次导入。"
          }
        }
      }
    },
    "The book's package and content paths do not match a managed library location." : {
      "comment" : "Why a book's files were not deleted: its paths do not lie inside the library. Follows \"Import failed: \".",
      "localizations" : {
        "de" : {
