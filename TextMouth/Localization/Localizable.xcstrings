            "value" : "Para baixá-lo novamente, escolha %@ na linha dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Чтобы начать загрузку заново, выберите %@ в её строке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Om du vill hämta den igen väljer du %@ på dess rad."
          }
        },
        "th" : {
          "stringUnit" : {
