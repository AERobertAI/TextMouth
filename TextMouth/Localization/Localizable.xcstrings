    },
    "nextBookWindow.unavailableHint.item" : {
      "comment" : "VoiceOver hint of the dimmed Open the next item in pop-up button in a feed's Feed Info: when it can be used.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "متاح فقط عندما تنتقل عناصر هذا الموجز إلى عنصر آخر عند انتهاء أحدها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "শুধু তখনই পাওয়া যায় যখন এই ফিডের আইটেমগুলো একটি শেষ হলে অন্য আইটেমে এগিয়ে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nur verfügbar, solange die Einträge dieses Feeds am Ende zu einem anderen Eintrag weitergehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Available only while this feed's items go on to another item when one ends"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disponible solo mientras los elementos de este canal pasan a otro elemento al terminar uno"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فقط وقتی در دسترس است که مورد‌های این فید پس از پایان یک مورد به موردی دیگر بروند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disponible seulement quand les éléments de ce flux passent à un autre élément à la fin de l’un d’eux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "זמין רק כשפריטי הערוץ הזה ממשיכים לפריט אחר בסיום פריט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "केवल तब उपलब्ध जब इस फ़ीड के आइटम एक के ख़त्म होने पर दूसरे आइटम पर आगे बढ़ते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hanya tersedia saat item feed ini berlanjut ke item lain setelah satu item selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disponibile solo quando gli elementi di questo feed passano a un altro elemento al termine di uno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このフィードの項目が終わったときに別の項目へ進む場合にのみ使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 피드의 항목이 끝나고 다른 항목으로 이어질 때만 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alleen beschikbaar zolang de onderdelen van deze feed doorgaan naar een ander onderdeel wanneer er een eindigt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dostępne tylko wtedy, gdy pozycje tego kanału po zakończeniu jednej przechodzą do kolejnej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disponível apenas enquanto os itens deste feed continuam em outro item quando um termina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Доступно, только пока элементы этой ленты переходят к другому элементу по окончании текущего."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tillgänglig bara så länge det här flödets objekt går vidare till ett annat objekt när ett tar slut."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ใช้ได้เฉพาะเมื่อรายการของฟีดนี้ไปต่อที่รายการถัดไปเมื่อรายการหนึ่งจบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yalnızca bu beslemenin öğeleri, biri bitince başka bir öğeye geçerken kullanılabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Доступно, лише коли елементи цієї стрічки переходять до наступного елемента після завершення попереднього."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صرف اس وقت دستیاب ہے جب اس فیڈ کے آئٹمز ایک کے ختم ہونے پر اگلے آئٹم پر جاتے ہوں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chỉ dùng được khi các mục của nguồn cấp này tiếp tục sang mục khác khi một mục kết thúc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "仅当此订阅源的项目结束后会继续到下一个项目时可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "僅在此訂閱源的項目結束後接續到另一個項目時可用。"
          }
        }
      }
    },
    "oggConversion.notEnoughSpace.converts" : {
      "comment" : "Message of the alert about one book's Ogg audio that waits for disk space. %@ is what the book needs, such as \"“Harbor Dramas” needs 4.2 GB free\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ لتحويل صوت Ogg الخاص به إلى AAC. أخلِ بعض المساحة، وسيحوّله TextMouth في المرة التالية التي تفتح فيها التطبيق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ogg অডিও AAC-তে রূপান্তর করতে %@। কিছু জায়গা খালি করুন, তাহলে TextMouth পরের বার চালু হওয়ার সময় তা রূপান্তর করবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, um das Ogg-Audio in AAC umzuwandeln. Gib Speicherplatz frei, dann wandelt TextMouth es beim nächsten Start um."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ to convert its Ogg audio to AAC. Free some space, and TextMouth converts it at the next launch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ para convertir su audio Ogg a AAC. Libera espacio y TextMouth lo convertirá la próxima vez que se abra."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ تا صدای Ogg آن به AAC تبدیل شود. کمی فضا آزاد کنید تا TextMouth در اجرای بعدی آن را تبدیل کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ pour convertir son audio Ogg en AAC. Libérez de l’espace, et TextMouth le convertira au prochain lancement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ כדי להמיר את שמע ה-Ogg שלו ל-AAC. פנה מעט מקום, ו-TextMouth ימיר אותו בהפעלה הבאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ताकि उसका Ogg ऑडियो AAC में बदला जा सके। जगह खाली करें, और TextMouth अगले लॉन्च पर उसे बदल देगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ untuk mengonversi audio Ogg-nya ke AAC. Kosongkan sedikit ruang, dan TextMouth akan mengonversinya saat peluncuran berikutnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ per convertire il suo audio Ogg in AAC. Libera dello spazio e TextMouth lo convertirà al prossimo avvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ogg オーディオを AAC に変換するには、%@。空き容量を確保すると、次回の起動時に TextMouth が変換します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ogg 오디오를 AAC로 변환할 디스크 공간이 부족합니다(%@). 공간을 확보하면 TextMouth가 다음 실행 때 변환합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ om de Ogg-audio naar AAC te converteren. Maak ruimte vrij en TextMouth converteert de audio bij de volgende start."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, aby przekonwertować jej dźwięk Ogg na AAC. Zwolnij miejsce, a TextMouth przekonwertuje go przy następnym uruchomieniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ para converter o áudio Ogg dele em AAC. Libere espaço, e o TextMouth o converterá na próxima abertura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ для преобразования звука Ogg в AAC. Освободите место, и TextMouth преобразует его при следующем запуске."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ för att konvertera Ogg-ljudet till AAC. Frigör lite utrymme, så konverterar TextMouth det vid nästa start."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ เพื่อแปลงเสียง Ogg เป็น AAC เพิ่มพื้นที่ว่าง แล้ว TextMouth จะแปลงให้เมื่อเปิดแอปครั้งถัดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ (Ogg sesini AAC'ye dönüştürmek için). Biraz yer açın; TextMouth bir sonraki açılışta dönüştürür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, щоб перетворити аудіо Ogg цієї книги на AAC. Звільніть місце, і TextMouth перетворить його під час наступного запуску."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ تاکہ اس کی Ogg آڈیو کو AAC میں تبدیل کیا جا سکے۔ کچھ جگہ خالی کریں، تو TextMouth اسے اگلی بار کھلنے پر تبدیل کر دے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ để chuyển âm thanh Ogg của sách này sang AAC. Hãy giải phóng bớt dung lượng, TextMouth sẽ chuyển đổi sách này vào lần mở kế tiếp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@，才能将其 Ogg 音频转换为 AAC。请释放一些空间，TextMouth 会在下次启动时进行转换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@，才能將其 Ogg 音訊轉換為 AAC。請釋出一些空間，TextMouth 會在下次啟動時轉換。"
          }
        }
      }
    },
    "oggConversion.notEnoughSpace.needs" : {
      "comment" : "A book's need for free disk space, inside the alert about Ogg audio that waits for space. %1$@ is the book's title and %2$@ the free space it needs, with its unit, such as \"4.2 GB\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” يحتاج إلى %2$@ مساحة حرة"
