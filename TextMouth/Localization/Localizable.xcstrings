          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It holds the record of “%1$@”: %2$@; the record holds %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Contiene el registro de «%1$@»: %2$@; el registro contiene %3$@."
