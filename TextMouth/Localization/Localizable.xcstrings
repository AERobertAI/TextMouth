    "libraryComparison.comparingForUseSentence" : {
      "comment" : "What Storage settings says while it compares the library in use with a chosen folder's copy before Use This Library. \"Stop Comparing\" is the name of the button that skips it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تجري مقارنة هذه المكتبة بنسخة المجلد الذي اخترته لمعرفة أيهما أحدث. قد يستغرق ذلك حتى دقيقة؛ اختر “إيقاف المقارنة” لتخطيه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "কোনটি নতুন তা বলার জন্য এই লাইব্রেরিকে আপনার বেছে নেওয়া ফোল্ডারের কপির সঙ্গে তুলনা করা হচ্ছে। এতে এক মিনিট পর্যন্ত লাগতে পারে; এড়াতে “তুলনা বন্ধ করুন” বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Diese Bibliothek wird mit der Kopie im gewählten Ordner verglichen, um festzustellen, welche neuer ist. Das kann bis zu eine Minute dauern; wähle „Vergleich stoppen“, um es zu überspringen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparing this library with the copy in the folder you chose, to say which is newer. This can take up to a minute; choose Stop Comparing to skip it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Comparando esta biblioteca con la copia de la carpeta que elegiste, para saber cuál es más reciente. Puede tardar hasta un minuto; elige Detener comparación para omitirla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "در حال مقایسه‌ی این کتابخانه با نسخه‌ی موجود در پوشه‌ای که انتخاب کردید، تا مشخص شود کدام جدیدتر است. این کار تا یک دقیقه طول می‌کشد؛ برای صرف‌نظر از آن «توقف مقایسه» را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Comparaison de cette bibliothèque avec la copie du dossier que vous avez choisi, pour savoir laquelle est la plus récente. Cela peut prendre jusqu’à une minute ; choisissez Arrêter la comparaison pour l’interrompre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "משווה את הספרייה הזו לעותק בתיקייה שבחרת כדי לומר איזה מהם חדש יותר. זה עשוי להימשך עד דקה; בחר “הפסק השוואה” כדי לדלג."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस लाइब्रेरी की तुलना आपके चुने फ़ोल्डर की कॉपी से की जा रही है, यह बताने के लिए कि कौन-सी नई है। इसमें एक मिनट तक लग सकता है; इसे छोड़ने के लिए “तुलना रोकें” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membandingkan pustaka ini dengan salinan di folder yang Anda pilih, untuk menentukan mana yang lebih baru. Ini dapat memakan waktu hingga satu menit; pilih Berhenti Membandingkan untuk melewatinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Confronto di questa libreria con la copia nella cartella scelta, per stabilire quale sia più recente. Può richiedere fino a un minuto; scegli Interrompi confronto per saltarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このライブラリと選択したフォルダ内のコピーを比較して、どちらが新しいかを調べています。最大1分かかることがあります。省略するには、「比較を停止」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 보관함을 선택한 폴더의 사본과 비교하여 어느 쪽이 더 최신인지 확인하는 중입니다. 최대 1분 정도 걸릴 수 있으며, 건너뛰려면 비교 중지를 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deze bibliotheek wordt vergeleken met de kopie in de map die je hebt gekozen, om na te gaan welke de nieuwere is. Dit kan tot een minuut duren; kies Stop met vergelijken om het over te slaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Porównywanie tej biblioteki z kopią w wybranym folderze, aby sprawdzić, która jest nowsza. Może to potrwać do minuty; wybierz Zakończ porównywanie, aby to pominąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Comparando esta biblioteca com a cópia da pasta que você escolheu, para dizer qual é mais recente. Isso pode levar até um minuto; escolha Parar comparação para pular."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сравнение этой библиотеки с копией в выбранной папке, чтобы определить, какая из них новее. Это может занять до минуты; чтобы пропустить его, выберите «Остановить сравнение»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jämför det här biblioteket med kopian i mappen du valde för att avgöra vilket som är nyare. Det kan ta upp till en minut; välj Sluta jämföra för att hoppa över det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "กำลังเปรียบเทียบไลบรารีนี้กับสำเนาในโฟลเดอร์ที่เลือก เพื่อบอกว่าสำเนาใดใหม่กว่า อาจใช้เวลาถึงหนึ่งนาที เลือก หยุดเปรียบเทียบ เพื่อข้ามขั้นตอนนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu kitaplık, hangisinin daha yeni olduğunu söylemek için seçtiğiniz klasördeki kopyayla karşılaştırılıyor. Bu bir dakikaya kadar sürebilir; atlamak için “Karşılaştırmayı Durdur” düğmesini seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Порівняння цієї бібліотеки з копією у вибраній вами папці, щоб визначити, яка новіша. Це може тривати до хвилини; виберіть «Зупинити порівняння», щоб пропустити."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس لائبریری کا آپ کے منتخب کردہ فولڈر میں موجود کاپی سے موازنہ کیا جا رہا ہے تاکہ معلوم ہو کہ کون سی زیادہ نئی ہے۔ اس میں ایک منٹ تک لگ سکتا ہے؛ اسے چھوڑنے کے لیے “موازنہ روکیں” منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đang so sánh thư viện này với bản sao trong thư mục bạn đã chọn, để cho biết bản nào mới hơn. Việc này có thể mất tới một phút; chọn Ngừng so sánh để bỏ qua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "正在将此资料库与你所选文件夹中的副本进行比较，以判断哪个较新。这最多可能需要一分钟；选取“停止比较”可跳过。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "正在比較此書庫與你選擇的檔案夾中的副本，以判斷哪一份較新。這最多可能需要一分鐘；選擇「停止比較」即可略過。"
          }
        }
      }
    },
