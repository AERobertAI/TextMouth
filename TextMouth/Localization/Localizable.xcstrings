            "value" : "“%@” solo está en la nube. Descarga el libro y luego transcríbelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "« %@ » est seulement dans le cloud. Téléchargez le livre, puis transcrivez-le."
          }
