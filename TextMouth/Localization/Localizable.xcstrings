        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کوئی مائیکروفون جڑا ہوا نہیں۔ انتخاب پر ریکارڈ کرنے کے لیے ایک جوڑیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chưa kết nối micrô nào. Hãy kết nối một micrô để ghi đè."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
