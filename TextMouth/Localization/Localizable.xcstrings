    "transcriptCleanupError.audioChanged" : {
      "comment" : "Error shown when the book's audio files changed since the transcription. %@ is the reason, a short phrase in English.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تغيّر صوت الكتاب منذ تفريغه (%@)، لذا لم تعد النسخة النصية مطابقة. فرّغه مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ট্রান্সক্রাইব করার পর বইয়ের অডিও বদলে গেছে (%@), তাই ট্রান্সক্রিপ্ট আর মেলে না। আবার ট্রান্সক্রাইব করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
