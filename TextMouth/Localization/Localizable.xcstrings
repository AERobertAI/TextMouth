          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth n’a pas pu conserver le texte que vous avez modifié dans « %@ » à côté de la nouvelle lecture, donc il a laissé le livre tel quel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth “%@” में आपके बदले हुए टेक्स्ट को नई रीडिंग के बगल में नहीं रख सका, इसलिए उसने पुस्तक जैसी थी वैसी ही छोड़ दी।"
