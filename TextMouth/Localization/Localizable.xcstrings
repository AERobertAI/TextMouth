            "value" : "फ़ीड अपनी सेटिंग और %1$@ के साथ आपकी लाइब्रेरी में बना रहता है, और “%2$@” उसे फिर से जाँचता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Feed tetap ada di pustaka Anda beserta pengaturannya dan %1$@, dan %2$@ memeriksanya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il feed resta nella tua libreria con le sue impostazioni e %1$@; scegli %2$@ per controllarlo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フィードは、設定と%1$@とともにライブラリに残ります。%2$@を選択すると、もう一度確認されます。"
