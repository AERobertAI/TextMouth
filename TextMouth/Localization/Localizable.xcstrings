        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth এখনও আপনার শেষ উত্তর কার্যকর করছে। শেষ না হওয়া পর্যন্ত অপেক্ষা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth führt noch deine letzte Antwort aus. Warte, bis es fertig ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
