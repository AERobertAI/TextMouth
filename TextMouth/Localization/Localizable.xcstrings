    "Chooses whether The, A, and An at the start of a title count when sorting and when typing a title's first letters." : {
      "comment" : "Hint and tooltip of the Leading Articles pop-up in the Library settings. The, A, and An are the English articles the setting skips."
    },
    "Choosing makes the shortcut yours; Reset to Default restores where it works by default." : {
      "comment" : "VoiceOver hint of the Works in pop-up button of a keyboard shortcut action: choosing a choice makes the action the listener's own, and Reset to Default restores where it works by default."
    },
    "Clear" : {
      "comment" : "Name of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Clear\"."
    },
    "Clear Display" : {
      "comment" : "Name of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Clear Display\"."
    },
    "Clear Selection" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Removes the selection."
    },
    "Close" : {
      "comment" : "Button that closes a reader view or sheet.\nButton that closes a sheet or window and returns to what is under it, such as the sleep timer sheet over a book's reader, a feed's information sheet, or the reader's own sheets.\nButton that closes a sheet, such as the sleep timer sheet over a book's reader.\nName of the File menu's Close command, which closes the window, in a sentence saying why a keyboard shortcut cannot take its key.\nTitle of the button that closes the Search Library window.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cerrar"
          }
        }
      }
    },
    "Close All" : {
      "comment" : "Name of the File menu's Close All command, which closes every window, in a sentence saying why a keyboard shortcut cannot take its key."
    },
    "Close search and return to the book" : {
      "comment" : "VoiceOver hint of the Back to Book button of Search in Book."
    },
    "Close sheet after setting timer" : {
      "comment" : "Title of the checkbox in the Playback settings that closes the sleep timer sheet once a timer is set."
    },
    "Close sleep timer sheet after setting a timer" : {
      "comment" : "VoiceOver label of the Close sheet after setting timer checkbox in the Playback settings."
    },
    "Close the headings screen and return to the book" : {
      "comment" : "Hint of the headings sheet's Back to Book button."
    },
    "Closes Search Library; results stay for next time" : {
      "comment" : "VoiceOver hint of the Close button of the Search Library window. Search Library is the window's name."
    },
    "Closes this book's window" : {
      "comment" : "Hint of the Close button of the reader's view for a book that is not ready to read."
    },
    "Closing ends the recording. %@ saves it as an audiobook, %@ deletes it, and %@ keeps recording." : {
      "comment" : "Explanation under the question asked when the Record window is closed while recording. %1$@, %2$@, and %3$@ are the titles of the question's three buttons: the one that stops and saves, the one that deletes the recording, and the one that keeps recording.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
