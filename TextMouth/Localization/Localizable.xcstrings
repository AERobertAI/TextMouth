    "libraryCloud.isntFolderBooks" : {
      "comment" : "Why Keep on This Mac or Stop Keeping on This Mac changed nothing: the library is not in a cloud folder.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "المكتبة ليست في مجلد سحابي، لذا تكون كتبها دائمًا على هذا الـ Mac."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "লাইব্রেরি ক্লাউড ফোল্ডারে নেই, তাই এর বইগুলো সবসময় এই Mac-এ থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Bibliothek liegt nicht in einem Cloud-Ordner, daher sind ihre Bücher immer auf diesem Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The library isn't in a cloud folder, so its books are always on this Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La biblioteca no está en una carpeta de la nube, así que sus libros siempre están en esta Mac."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتابخانه در یک پوشه ابری نیست، بنابراین کتاب‌های آن همیشه روی این Mac هستند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La bibliothèque n’est pas dans un dossier cloud ; ses livres sont donc toujours sur ce Mac."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הספרייה אינה בתיקיית ענן, ולכן הספרים שלה תמיד נמצאים ב-Mac הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लाइब्रेरी क्लाउड फ़ोल्डर में नहीं है, इसलिए उसकी पुस्तकें हमेशा इस Mac पर रहती हैं।"
