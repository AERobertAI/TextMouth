    "sync.remove.nothing" : {
      "comment" : "Said aloud when the Library menu's Remove Download finds that none of the selected books has a download on this device to remove.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ليس لأي من الكتب المحددة تنزيل يمكن إزالته."
