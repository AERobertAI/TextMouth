    "speechRefusal.announcement" : {
      "comment" : "Announcement when speech stopped because the speech engine refused a passage and the book's window is not in front, so its report sheet cannot speak.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "توقف النطق: رفض محرك النطق هذا الجزء من النص. التفاصيل في نافذة الكتاب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "স্পিচ থেমেছে: স্পিচ ইঞ্জিন এই অংশ প্রত্যাখ্যান করেছে। বিবরণ বইয়ের উইন্ডোতে আছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vorlesen gestoppt: Die Sprachausgabe hat diese Passage abgelehnt. Details stehen im Fenster des Buchs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speech stopped: the speech engine refused this passage. Details are in the book's window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lectura detenida: el motor de voz rechazó este pasaje. Los detalles están en la ventana del libro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "گفتار متوقف شد: موتور گفتار این بخش را رد کرد. جزئیات در پنجره‌ی کتاب است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voix arrêtée : le moteur vocal a refusé ce passage. Les détails sont dans la fenêtre du livre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הדיבור נעצר: מנוע הדיבור סירב לקטע הזה. הפרטים נמצאים בחלון הספר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "स्पीच रुक गई: स्पीच इंजन ने इस अंश को अस्वीकार कर दिया। ब्योरा पुस्तक की विंडो में है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ucapan berhenti: mesin ucapan menolak bagian ini. Detail ada di jendela buku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lettura interrotta: il motore vocale ha rifiutato questo brano. I dettagli sono nella finestra del libro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "読み上げを停止しました：読み上げエンジンがこの箇所を拒否しました。詳細はブックのウインドウにあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "음성이 중지됨: 음성 엔진이 이 구간을 거부했습니다. 자세한 내용은 책의 윈도우에 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Spraak gestopt: de spraakengine heeft deze passage geweigerd. Details staan in het venster van het boek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mowa zatrzymana: mechanizm mowy odrzucił ten fragment. Szczegóły są w oknie książki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fala interrompida: o mecanismo de fala recusou este trecho. Os detalhes estão na janela do livro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Речь остановлена: речевой движок отклонил этот отрывок. Подробности в окне книги."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uppläsningen stoppades: talmotorn avvisade det här stycket. Detaljer finns i bokens fönster."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "การอ่านออกเสียงหยุดลง: เครื่องมืออ่านออกเสียงปฏิเสธข้อความช่วงนี้ ดูรายละเอียดในหน้าต่างของหนังสือ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Konuşma durdu: konuşma motoru bu pasajı reddetti. Ayrıntılar kitabın penceresinde."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Озвучення зупинено: система озвучення відхилила цей уривок. Подробиці є у вікні книги."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اسپیچ رک گئی: اسپیچ انجن نے اس حصے کو مسترد کر دیا۔ تفصیلات کتاب کی ونڈو میں ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Giọng đọc đã dừng: bộ máy đọc từ chối đoạn này. Chi tiết nằm trong cửa sổ của sách."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "朗读已停止：朗读引擎拒绝了此段落。详细信息见图书的窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "朗讀已停止：語音引擎拒絕了這段文字。詳細資料在書籍的視窗中。"
          }
        }
      }
    },
