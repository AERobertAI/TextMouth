          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closing the reader of %@, since editing changes its audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cerrando el lector de %@, porque editar cambia su audio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "در حال بستن کتاب‌خوان %@، چون ویرایش، صدای آن را تغییر می‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fermeture du lecteur de %@, car la modification change son audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "סוגר את הקורא של %@, כי עריכה משנה את השמע שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ का रीडर बंद किया जा रहा है, क्योंकि संपादन उसका ऑडियो बदल देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menutup pembaca %@, karena pengeditan mengubah audionya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chiusura del lettore di %@, perché la modifica ne cambia l’audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "編集するとオーディオが変わるため、%@のリーダを閉じています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "편집하면 오디오가 바뀌므로 %@의 리더를 닫는 중입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De lezer van %@ wordt gesloten, omdat wijzigen de audio verandert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zamykanie czytnika książki %@, ponieważ edycja zmienia jej dźwięk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
