          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El %1$@ termina %2$@ después del inicio de “%3$@”, que solo dura %4$@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ در زمان %2$@ از «%3$@» پایان می‌یابد، اما طول این فایل فقط %4$@ است."
