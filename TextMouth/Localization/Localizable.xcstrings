    "refusal.reason.writesEightDots" : {
      "comment" : "Why a braille table of this Mac was refused, ending a sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يكتب برايل ثماني النقاط، بينما يستخدم TextMouth برايل سداسي النقاط فقط"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এটি আট-ডট ব্রেইল লেখে, আর TextMouth শুধু ছয়-ডট ব্রেইল ব্যবহার করে"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "sie schreibt Achtpunkt-Braille, und TextMouth verwendet nur Sechspunkt-Braille"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "it writes eight-dot braille, and TextMouth uses six-dot braille only"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "escribe braille de ocho puntos, y TextMouth solo usa braille de seis puntos"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بریل هشت‌نقطه‌ای می‌نویسد و TextMouth فقط از بریل شش‌نقطه‌ای استفاده می‌کند"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "elle écrit du braille à huit points, et TextMouth n’utilise que le braille à six points"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הוא כותב ברייל בן שמונה נקודות, ו-TextMouth משתמש רק בברייל בן שש נקודות"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "यह आठ-बिंदु ब्रेल लिखती है, और TextMouth केवल छह-बिंदु ब्रेल का उपयोग करता है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "menulis braille delapan titik, dan TextMouth hanya memakai braille enam titik"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "scrive in braille a otto punti e TextMouth usa solo il braille a sei punti"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "8点点字を出力しますが、TextMouth が使うのは6点点字のみです"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "8점 점자를 쓰는데 TextMouth는 6점 점자만 사용합니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "het schrijft braille met acht punten, en TextMouth gebruikt alleen braille met zes punten"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "zapisuje braille ośmiopunktowy, a TextMouth używa tylko braille’a sześciopunktowego"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ela escreve braille de oito pontos, e o TextMouth usa apenas braille de seis pontos"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "она пишет восьмиточечный Брайль, а TextMouth использует только шеститочечный"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "den skriver punktskrift med åtta punkter, och TextMouth använder bara punktskrift med sex punkter"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เขียนอักษรเบรลล์แปดจุด แต่ TextMouth ใช้อักษรเบรลล์หกจุดเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "sekiz noktalı braille yazıyor ve TextMouth yalnızca altı noktalı braille kullanır"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "вона записує восьмикрапковий брайль, а TextMouth використовує лише шестикрапковий"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یہ آٹھ نقطوں کی بریل لکھتا ہے، اور TextMouth صرف چھ نقطوں کی بریل استعمال کرتا ہے"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "nó ghi braille tám chấm, còn TextMouth chỉ dùng braille sáu chấm"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "它写出八点盲文，而 TextMouth 只使用六点盲文"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "它寫出八點點字，而 TextMouth 只使用六點點字"
          }
        }
      }
    },
    "refusal.sentence.audioBeingEdited" : {
      "comment" : "Why Replace Existing waits: the library's copy has its audio open in the audio editor. %1$@ is the book's title. %2$@ is the name of the Replace Existing button, which the sentence asks the user to choose again.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يجري تحرير صوت “%1$@”. أغلق محرر الصوت أو انتظر حتى يُحفظ، ثم اختر %2$@ مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@”-এর অডিও সম্পাদনা করা হচ্ছে। অডিও এডিটর বন্ধ করুন বা সেটি সংরক্ষণ না হওয়া পর্যন্ত অপেক্ষা করুন, তারপর আবার “%2$@” বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Audio von „%1$@“ wird gerade bearbeitet. Schließe den Audio-Editor oder warte, bis er gesichert hat, und wähle dann erneut %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The audio of “%@” is being edited. Close the audio editor or wait for it to save, then choose %@ again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El audio de “%1$@” se está editando. Cierra el editor de audio o espera a que se guarde, y vuelve a elegir %2$@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صدای «%@» در حال ویرایش است. ویرایشگر صدا را ببندید یا منتظر ذخیره شدن آن بمانید، سپس دوباره %@ را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’audio de « %@ » est en cours de modification. Fermez l’éditeur audio ou attendez qu’il enregistre, puis choisissez de nouveau %@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "השמע של “%1$@” נערך כעת. סגור את עורך השמע או המתן שישמור, ואז בחר שוב “%2$@”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” का ऑडियो संपादित किया जा रहा है। ऑडियो एडिटर बंद करें या उसके सहेजने तक रुकें, फिर “%2$@” दोबारा चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Audio “%@” sedang diedit. Tutup editor audio atau tunggu hingga disimpan, lalu pilih %@ lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’audio di “%@” è in fase di modifica. Chiudi l’editor audio o attendi che venga salvato, poi scegli di nuovo %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%1$@」のオーディオを編集中です。オーディオエディタを閉じるか、保存が終わるのを待ってから、もう一度「%2$@」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@”의 오디오를 편집하는 중입니다. 오디오 편집기를 닫거나 저장이 끝날 때까지 기다린 다음 %2$@을(를) 다시 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De audio van “%@” wordt bewerkt. Sluit de audio-editor of wacht tot die is bewaard en kies dan opnieuw %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dźwięk książki „%1$@” jest edytowany. Zamknij edytor dźwięku albo poczekaj na zapis, a potem ponownie wybierz: %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O áudio de “%1$@” está sendo editado. Feche o editor de áudio ou espere que ele salve e escolha %2$@ novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Аудио книги «%1$@» редактируется. Закройте аудиоредактор или дождитесь сохранения и снова выберите «%2$@»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ljudet i ”%@” redigeras. Stäng ljudredigeraren eller vänta tills det har sparats och välj sedan %@ igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "กำลังแก้ไขเสียงของ “%1$@” ปิดตัวแก้ไขเสียงหรือรอให้บันทึกเสร็จ แล้วเลือก %2$@ อีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” kitabının sesi düzenleniyor. Ses düzenleyiciyi kapatın veya kaydedilmesini bekleyin, sonra “%2$@” düğmesini yeniden seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Аудіо «%1$@» редагується. Закрийте аудіоредактор або дочекайтеся збереження, а потім знову виберіть «%2$@»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” کے آڈیو میں ترمیم کی جا رہی ہے۔ آڈیو ایڈیٹر بند کریں یا اس کے محفوظ ہونے کا انتظار کریں، پھر “%2$@” دوبارہ منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Âm thanh của “%1$@” đang được chỉnh sửa. Hãy đóng trình sửa âm thanh hoặc đợi nó lưu, rồi chọn lại %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@”的音频正在编辑。请关闭音频编辑器或等待其存储完成，然后再次选取“%2$@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%1$@」的音訊正在編輯中。請關閉音訊編輯器或等候儲存完成，然後再次選擇 %2$@。"
          }
        }
      }
    },
    "refusal.sentence.filesInCloud" : {
