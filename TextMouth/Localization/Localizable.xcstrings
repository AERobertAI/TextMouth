    "Brings the text to the sentence being spoken." : {
      "comment" : "Hint of the iPhone reader's book text while the book plays: activating it moves VoiceOver to the sentence being spoken.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Springt im Text zu dem Satz, der gerade gesprochen wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lleva el texto a la frase que se está leyendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Amène VoiceOver à la phrase lue."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "टेक्स्ट को बोले जा रहे वाक्य तक ले आता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membawa teks ke kalimat yang sedang diucapkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Porta il testo alla frase in lettura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "テキストを、読み上げ中の文に移します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책 텍스트를 읽고 있는 문장으로 가져옵니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Leva o texto até a frase que está sendo falada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Переходит в тексте к произносимому предложению."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Переходить до речення, яке озвучується."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "转到正在朗读的句子。"
          }
        }
      }
    },
    "But %@ also holds %lld books a newer TextMouth added: they are kept where they are, and so is every folder that holds one." : {
      "comment" : "Last sentence of the second confirmation that deletes a folder, when the folder holds books that a newer TextMouth added. %1$@ is the folder's name in quotation marks and %2$lld is how many books, a count.",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "لكن %@ يحتوي أيضًا على %lld كتب من إضافة إصدار أحدث من TextMouth: ستبقى في مكانها، وكذلك كل مجلد يحتوي عليها."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "لكن %@ يحتوي أيضًا على %lld كتابًا من إضافة إصدار أحدث من TextMouth: ستبقى في مكانها، وكذلك كل مجلد يحتوي عليها."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "لكن %@ يحتوي أيضًا على %lld كتاب من إضافة إصدار أحدث من TextMouth: سيبقى في مكانه، وكذلك كل مجلد يحتوي عليه."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "لكن %@ يحتوي أيضًا على %lld كتاب من إضافة إصدار أحدث من TextMouth: سيبقى في مكانه، وكذلك كل مجلد يحتوي عليه."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "لكن %@ يحتوي أيضًا على %lld كتابين من إضافة إصدار أحدث من TextMouth: سيبقيان في مكانهما، وكذلك كل مجلد يحتوي عليهما."
                }
              },
              "zero" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "لكن %@ يحتوي أيضًا على %lld كتب من إضافة إصدار أحدث من TextMouth: ستبقى في مكانها، وكذلك كل مجلد يحتوي عليها."
                }
              }
            }
          }
        },
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Aber %1$@ enthält auch %2$lld Buch, das ein neueres TextMouth hinzugefügt hat: Es bleibt, wo es ist, ebenso jeder Ordner, der es enthält."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Aber %1$@ enthält auch %2$lld Bücher, die ein neueres TextMouth hinzugefügt hat: Sie bleiben, wo sie sind, ebenso jeder Ordner, der eines enthält."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "But %@ also holds %lld book a newer TextMouth added: it is kept where it is, and so is every folder that holds it."
                }
              },
