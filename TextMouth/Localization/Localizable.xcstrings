      }
    },
    "Braille" : {
      "comment" : "Name of the book format of a braille file (.brf or .brl), shown in a book's information, the format column, and the duplicate finder.\nThe heading of the Braille tab's only group in Settings.\nThe name of the Braille tab in the Settings window's toolbar.",
      "localizations" : {
