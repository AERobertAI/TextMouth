          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ jest w Twojej bibliotece, bez subskrypcji. Aby sprawdzić go ponownie, wybierz %2$@ w jego wierszu lub w oknie %3$@."
