    "feedDownloadProgress.retryAfterCancel" : {
      "comment" : "After Cancel stops feed downloads that the newest-N rule downloads again by itself.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ينزّل TextMouth أحدث ما في كل موجز مرة أخرى عند فحصه التالي، أو عند فتحه في المرة القادمة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth প্রতিটি ফিডের সবচেয়ে নতুনগুলো তার পরের চেকে, বা পরের বার খোলার সময়, আবার ডাউনলোড করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth lädt die neuesten Einträge jedes Feeds bei der nächsten Prüfung oder beim nächsten Öffnen erneut herunter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth downloads each feed's newest again at its next check, or the next time it opens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth vuelve a descargar los más recientes de cada canal en su próxima revisión, o la próxima vez que se abra."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth جدیدترین‌های هر فید را در بررسی بعدی آن یا دفعه بعد که باز شود دوباره بارگیری می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth télécharge de nouveau les plus récents de chaque flux à sa prochaine vérification, ou à sa prochaine ouverture."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth מוריד שוב את החדשים ביותר של כל ערוץ בבדיקה הבאה שלו, או בפעם הבאה שהוא נפתח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth हर फ़ीड के सबसे नए को उसकी अगली जाँच पर, या अगली बार खुलने पर, फिर से डाउनलोड करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth mengunduh ulang yang terbaru dari setiap feed pada pemeriksaan berikutnya, atau saat TextMouth dibuka lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth scarica di nuovo i più recenti di ogni feed al prossimo controllo, o al prossimo avvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "各フィードの最新のものは、次回の確認時、または次に TextMouth を開いたときに、もう一度ダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "각 피드의 최신 항목은 피드를 다음에 확인할 때나 TextMouth를 다음에 열 때 다시 다운로드됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth downloadt de nieuwste van elke feed opnieuw bij de volgende controle, of de volgende keer dat TextMouth start."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth pobierze najnowsze z każdego kanału ponownie przy jego następnym sprawdzeniu lub przy następnym otwarciu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth baixa novamente os mais recentes de cada feed na próxima verificação dele, ou na próxima vez que abrir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth снова загрузит самые новые элементы каждой ленты при её следующей проверке или при следующем открытии."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth hämtar varje flödes senaste igen vid nästa kontroll, eller nästa gång TextMouth öppnas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth จะดาวน์โหลดรายการล่าสุดของแต่ละฟีดอีกครั้งเมื่อตรวจสอบครั้งถัดไป หรือเมื่อเปิดแอปครั้งถัดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth her beslemenin en yenilerini, bir sonraki denetimde veya bir sonraki açılışta yeniden indirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth знову завантажить найновіше з кожної стрічки під час наступної перевірки або наступного відкриття."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ہر فیڈ کے تازہ ترین کو اس کی اگلے چیک پر، یا اگلی بار کھلنے پر، دوبارہ ڈاؤن لوڈ کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tải về lại các mục mới nhất của mỗi nguồn cấp ở lần kiểm tra kế tiếp của nó, hoặc ở lần mở kế tiếp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 会在每个订阅源下次检查时或下次打开时，重新下载其最新的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 會在每個訂閱源下次檢查時，或下次打開時，重新下載其最新項目。"
          }
        }
      }
    },
