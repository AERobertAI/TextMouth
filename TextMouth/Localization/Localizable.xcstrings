    "libraryList.importBookHint" : {
      "comment" : "Hint of the choice that opens a file picker to import books, in the Add to Library sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يفتح منتقي ملفات لاستيراد الكتب بأي تنسيق يقرؤه TextMouth."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth পড়তে পারে এমন যেকোনো ফরম্যাটের বই আমদানি করতে একটি ফাইল পিকার খোলে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffnet eine Dateiauswahl, um Bücher in jedem Format zu importieren, das TextMouth liest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens a file picker to import books in any format TextMouth reads."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre un selector de archivos para importar libros en cualquier formato que TextMouth lea."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یک انتخابگر فایل را برای وارد کردن کتاب‌ها در هر قالبی که TextMouth می‌خواند باز می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ouvre un sélecteur de fichiers pour importer des livres dans tout format que TextMouth sait lire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "פותח בוחר קבצים כדי לייבא ספרים בכל פורמט ש-TextMouth קורא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ऐसा फ़ाइल पिकर खोलता है जिससे TextMouth द्वारा पढ़े जाने वाले किसी भी फ़ॉर्मैट की पुस्तकें आयात की जा सकें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
