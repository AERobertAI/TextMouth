    "The Mac's speech engine refused to speak part of “%@”, even with its brackets made silent." : {
      "comment" : "Why a chapter of a spoken audio export could not be spoken. %@ is the chapter's title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Sprachausgabe des Mac weigerte sich, einen Teil von „%@“ zu sprechen, selbst mit stumm geschalteten Klammern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El motor de voz de la Mac se negó a leer una parte de «%@», incluso con sus corchetes en silencio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le moteur vocal du Mac a refusé de lire une partie de « %@ », même avec ses chevrons rendus silencieux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il motore vocale del Mac ha rifiutato di leggere una parte di “%@”, anche con le parentesi silenziate."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O mecanismo de fala do Mac se recusou a falar parte de “%@”, mesmo com os colchetes silenciados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Речевой движок Mac отказался озвучивать часть главы «%@», даже с отключёнными скобками."
          }
        }
      }
    },
    "The PDF file could not be opened." : {
      "comment" : "Why a PDF could not be imported: PDFKit could not open it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
