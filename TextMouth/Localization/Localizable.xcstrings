    "bookExportDeepChapter.message.already" : {
      "comment" : "The last sentence of the alert an export shows when a chapter nests too deeply. %@ is the name of the Cancel Export button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” يوقف التصدير بالكامل. تبقى الملفات التي كُتبت بالفعل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ পুরো রপ্তানি বন্ধ করে। যেসব ফাইল ইতিমধ্যে লেখা হয়েছে সেগুলো থাকবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ bricht den gesamten Export ab. Bereits geschriebene Dateien bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stops the whole export. Files already written stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ detiene toda la exportación. Los archivos ya escritos se conservan."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ کل صادر کردن را متوقف می‌کند. فایل‌هایی که پیش‌تر نوشته شده‌اند می‌مانند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ arrête toute l’exportation. Les fichiers déjà écrits sont conservés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ עוצר את הייצוא כולו. קבצים שכבר נכתבו נשארים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” पूरे निर्यात को रोक देता है। लिखी जा चुकी फ़ाइलें बनी रहती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ menghentikan seluruh ekspor. File yang sudah ditulis tetap ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ interrompe l’intera esportazione. I file già scritti restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」は、書き出し全体を中止します。書き出し済みのファイルは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@을(를) 선택하면 전체 내보내기가 중지됩니다. 이미 작성된 파일은 그대로 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ stopt de hele export. Bestanden die al zijn geschreven, blijven staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ zatrzymuje cały eksport. Pliki, które już zapisano, zostają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ interrompe toda a exportação. Os arquivos já gravados permanecem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ останавливает весь экспорт. Уже записанные файлы остаются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Med ”%@” stoppas hela exporten. Redan skrivna filer finns kvar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ จะหยุดการส่งออกทั้งหมด ไฟล์ที่เขียนไปแล้วจะยังอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, dışa aktarmanın tamamını durdurur. Önceden yazılan dosyalar kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ зупиняє весь експорт. Уже записані файли залишаються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” سے پوری برآمد رک جاتی ہے۔ لکھی جا چکی فائلیں برقرار رہتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nút %@ dừng toàn bộ quá trình xuất. Các tệp đã ghi vẫn được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 会停止整个导出。已写入的文件会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 會停止整個輸出。已寫入的檔案會保留。"
          }
        }
      }
    },
    "bookExportDeepChapter.message.paragraphs" : {
      "comment" : "The second sentence of the alert an export shows when a chapter nests too deeply. %@ is the name of the Export as Written button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” يكتب ذلك الفصل فقرات عادية من أسطره، مع إبقاء علامات الاقتباس والقوائم كأحرف، ويصدّر كل ما عداه كالمعتاد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ সেই অধ্যায়টি তার লাইনগুলোর সাধারণ অনুচ্ছেদ হিসেবে লেখে, উদ্ধৃতি ও তালিকার চিহ্ন অক্ষর হিসেবে রেখে, এবং বাকি সবকিছু যথারীতি রপ্তানি করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ schreibt dieses Kapitel als einfache Absätze aus seinen Zeilen, behält die Zitat- und Listenzeichen als Zeichen bei und exportiert alles andere wie gewohnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ writes that chapter as plain paragraphs of its lines, with its quote and list marks kept as characters, and exports everything else as usual."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ escribe ese capítulo como párrafos simples con sus líneas, conserva como caracteres las marcas de cita y de lista, y exporta todo lo demás como de costumbre."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ آن فصل را به‌صورت پاراگراف‌های ساده از خطوطش می‌نویسد، با علامت‌های نقل‌قول و فهرستش که به‌صورت نویسه حفظ می‌شوند، و بقیه را طبق معمول صادر می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ écrit ce chapitre en simples paragraphes de ses lignes, en gardant ses marques de citation et de liste comme caractères, et exporte tout le reste comme d’habitude."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ כותב את הפרק הזה כפסקאות פשוטות מהשורות שלו, כשסימני הציטוט והרשימה נשמרים כתווים, ומייצא את כל השאר כרגיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” उस अध्याय को उसकी पंक्तियों के सादे अनुच्छेदों के रूप में लिखता है, उद्धरण और सूची के चिह्न वर्णों के रूप में बने रहते हैं, और बाकी सब सामान्य रूप से निर्यात करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ menulis bab itu sebagai paragraf biasa dari baris-barisnya, dengan tanda kutipan dan daftarnya tetap sebagai karakter, dan mengekspor semua yang lain seperti biasa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ scrive quel capitolo come semplici paragrafi delle sue righe, mantenendo come caratteri i segni di citazione e di elenco, ed esporta tutto il resto come al solito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」は、その章を行ごとの通常の段落として書き出し、引用やリストの記号は文字のまま残します。それ以外はすべて通常どおり書き出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@을(를) 선택하면 해당 챕터가 줄 단위의 일반 단락으로 작성되고 인용 및 목록 표시는 문자로 유지되며, 나머지는 평소처럼 내보내집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ schrijft de regels van dat hoofdstuk als gewone alinea's, waarbij de citaat- en lijsttekens als tekens behouden blijven, en exporteert al het andere zoals gewoonlijk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ zapisuje ten rozdział jako zwykłe akapity z jego wierszy, z zachowaniem znaków cytatów i list jako zwykłych znaków, a wszystko inne eksportuje jak zwykle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ grava esse capítulo como parágrafos simples com as linhas dele, mantém as marcas de citação e de lista como caracteres e exporta todo o resto normalmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ записывает эту главу обычными абзацами из её строк, сохраняя знаки цитат и списков как символы, а всё остальное экспортирует как обычно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Med ”%@” skrivs det kapitlet som vanliga stycken av sina rader, med citat- och listtecknen kvar som tecken, och allt annat exporteras som vanligt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ จะเขียนบทนั้นเป็นย่อหน้าธรรมดาตามบรรทัดของบท โดยคงเครื่องหมายอ้างอิงและเครื่องหมายรายการไว้เป็นตัวอักษร และส่งออกส่วนอื่นตามปกติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, bu bölümü satırlarından oluşan düz paragraflar olarak yazar; alıntı ve liste işaretleri karakter olarak korunur, geri kalan her şey her zamanki gibi dışa aktarılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ записує цей розділ звичайними абзацами з його рядків, зберігаючи позначки цитат і списків як символи, а решту експортує як зазвичай."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” سے وہ باب اس کی سطروں کے سادہ پیراگرافوں کی صورت میں لکھا جاتا ہے، اس کے اقتباس اور فہرست کے نشانات حروف کی شکل میں رہتے ہیں، اور باقی سب کچھ معمول کے مطابق برآمد ہوتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nút %@ ghi chương đó thành các đoạn văn thường gồm các dòng của nó, giữ dấu trích dẫn và dấu danh sách dưới dạng ký tự, và xuất mọi thứ khác như bình thường."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 会将该章节写成由其各行组成的普通段落，保留其引用和列表标记的字符，其余内容照常导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 會把該章節寫成純段落（每行一段），其引用和列表標記保留為字元，其餘內容照常輸出。"
          }
        }
      }
    },
    "bookExportDeepChapter.message.structure" : {
      "comment" : "The first sentence of the alert an export shows when a chapter nests too deeply. %1$@ names what nests, such as \"Chapter 2 of Deep Notes\", and %2$@ is the clause that says how deep, such as \"nests quotes, lists, or emphasis more than 128 levels deep\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@، ولا يستطيع TextMouth تصديره ببنيته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@, যা TextMouth তার কাঠামোসহ রপ্তানি করতে পারে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@, und TextMouth kann das nicht mit seiner Struktur exportieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@, which TextMouth can't export with its structure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@, y TextMouth no puede exportarlo con su estructura."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@ و TextMouth نمی‌تواند آن را با ساختارش صادر کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@, ce que TextMouth ne peut pas exporter avec sa structure."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@, ו-TextMouth לא יכול לייצא אותו עם המבנה שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@, इसलिए TextMouth इसे इसकी संरचना के साथ निर्यात नहीं कर सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@, sehingga TextMouth tidak dapat mengekspornya dengan strukturnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@, e TextMouth non può esportarne la struttura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@は%2$@。このままでは、TextMouth は構造を保って書き出せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@은(는) %2$@. TextMouth는 구조를 유지한 채 내보낼 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@, en TextMouth kan het niet met de structuur ervan exporteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@, a TextMouth nie potrafi wyeksportować takiej struktury."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@, e o TextMouth não consegue exportar com essa estrutura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@, а TextMouth не может экспортировать такой текст вместе со структурой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@, vilket TextMouth inte kan exportera med sin struktur."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@ ซึ่ง TextMouth ส่งออกพร้อมโครงสร้างไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@; TextMouth bunu yapısıyla dışa aktaramaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@, тому TextMouth не може експортувати це зі збереженням структури."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ میں %2$@، اور TextMouth اسے اس کی ساخت کے ساتھ برآمد نہیں کر سکتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@, nên TextMouth không thể xuất với cấu trúc của nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@，TextMouth 无法按其结构导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@中，%2$@，TextMouth 無法連同其結構一起輸出。"
          }
        }
      }
    },
    "bookExportDeepChapter.message.text" : {
      "comment" : "The second sentence of the alert an export shows when a book's text, which has no chapter markers, nests too deeply. %@ is the name of the Export as Written button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” يكتب النص فقرات عادية من أسطره، مع إبقاء علامات الاقتباس والقوائم كأحرف، ويصدّر كل ما عداه كالمعتاد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ লেখাটি তার লাইনগুলোর সাধারণ অনুচ্ছেদ হিসেবে লেখে, উদ্ধৃতি ও তালিকার চিহ্ন অক্ষর হিসেবে রেখে, এবং বাকি সবকিছু যথারীতি রপ্তানি করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ schreibt den Text als einfache Absätze aus seinen Zeilen, behält die Zitat- und Listenzeichen als Zeichen bei und exportiert alles andere wie gewohnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ writes the text as plain paragraphs of its lines, with its quote and list marks kept as characters, and exports everything else as usual."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ escribe el texto como párrafos simples con sus líneas, conserva como caracteres las marcas de cita y de lista, y exporta todo lo demás como de costumbre."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ متن را به‌صورت پاراگراف‌های ساده از خطوطش می‌نویسد، با علامت‌های نقل‌قول و فهرستش که به‌صورت نویسه حفظ می‌شوند، و بقیه را طبق معمول صادر می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ écrit le texte en simples paragraphes de ses lignes, en gardant ses marques de citation et de liste comme caractères, et exporte tout le reste comme d’habitude."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ כותב את הטקסט כפסקאות פשוטות מהשורות שלו, כשסימני הציטוט והרשימה נשמרים כתווים, ומייצא את כל השאר כרגיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” टेक्स्ट को उसकी पंक्तियों के सादे अनुच्छेदों के रूप में लिखता है, उद्धरण और सूची के चिह्न वर्णों के रूप में बने रहते हैं, और बाकी सब सामान्य रूप से निर्यात करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ menulis teks sebagai paragraf biasa dari baris-barisnya, dengan tanda kutipan dan daftarnya tetap sebagai karakter, dan mengekspor semua yang lain seperti biasa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ scrive il testo come semplici paragrafi delle sue righe, mantenendo come caratteri i segni di citazione e di elenco, ed esporta tutto il resto come al solito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」は、テキストを行ごとの通常の段落として書き出し、引用やリストの記号は文字のまま残します。それ以外はすべて通常どおり書き出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@을(를) 선택하면 텍스트가 줄 단위의 일반 단락으로 작성되고 인용 및 목록 표시는 문자로 유지되며, 나머지는 평소처럼 내보내집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ schrijft de regels van de tekst als gewone alinea's, waarbij de citaat- en lijsttekens als tekens behouden blijven, en exporteert al het andere zoals gewoonlijk."
          }
        },
        "pl" : {
          "stringUnit" : {
