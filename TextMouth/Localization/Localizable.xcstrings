    "feed.sentences.articles" : {
      "comment" : "The first sentence of the confirmation before Delete Feed, for a feed of articles.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يغادر الموجز مكتبتك، مع قائمة مقالاته وإعداداته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফিডটি তার নিবন্ধের তালিকা ও সেটিংসসহ আপনার লাইব্রেরি ছেড়ে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Feed verlässt deine Bibliothek, mit seiner Artikelliste und seinen Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The feed leaves your library, with its list of articles and its settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El canal sale de tu biblioteca, con su lista de artículos y sus ajustes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فید با فهرست مقاله‌ها و تنظیماتش از کتابخانه‌ی شما خارج می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le flux quitte votre bibliothèque, avec sa liste d’articles et ses réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הערוץ עוזב את הספרייה שלך, עם רשימת הכתבות וההגדרות שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ीड आपकी लाइब्रेरी से हट जाता है, अपनी लेखों की सूची और अपनी सेटिंग के साथ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Feed ini dihapus dari pustaka Anda, beserta daftar artikel dan pengaturannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il feed lascia la tua libreria, con il suo elenco di articoli e le sue impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フィードは、記事の一覧と設定とともにライブラリから削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "피드가 기사 목록 및 설정과 함께 보관함에서 사라집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De feed verdwijnt uit je bibliotheek, met de lijst met artikelen en de instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kanał opuszcza Twoją bibliotekę wraz z listą artykułów i ustawieniami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O feed sai da sua biblioteca, com a lista de artigos e os ajustes dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Лента удаляется из вашей библиотеки вместе со списком статей и настройками."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Flödet lämnar ditt bibliotek, med sin lista över artiklar och sina inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ฟีดจะออกจากไลบรารีของคุณ พร้อมรายการบทความและการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Besleme, makale listesi ve ayarlarıyla birlikte kitaplığınızdan çıkar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Стрічка зникає з вашої бібліотеки разом зі списком статей і налаштуваннями."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فیڈ آپ کی لائبریری سے نکل جاتی ہے، اپنے مضامین کی فہرست اور اپنی ترتیبات کے ساتھ۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nguồn cấp rời khỏi thư viện của bạn, cùng danh sách bài viết và cài đặt của nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "该订阅源会连同其文章列表和设置一起从你的资料库中移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此訂閱源會連同其文章列表與設定，從你的書庫中移除。"
          }
        }
      }
    },
