    "storage.startNewLibrarySentence.available" : {
      "comment" : "First sentence of the question asked before starting a new library. %1$@ is the default location's path; %2$@ is the path of the library in use, which is not available.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سيبدأ TextMouth مكتبة جديدة فارغة في الموقع الافتراضي، %@، بدلًا من المكتبة في %@، وهي غير متاحة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@-এর লাইব্রেরি উপলব্ধ নেই, তাই TextMouth তার বদলে ডিফল্ট অবস্থান %1$@-এ একটি নতুন, খালি লাইব্রেরি শুরু করবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth legt am Standardort %1$@ eine neue, leere Bibliothek an, statt der Bibliothek in %2$@, die nicht verfügbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth will start a new, empty library in the default location, %@, instead of the library in %@, which isn't available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth iniciará una biblioteca nueva y vacía en la ubicación predeterminada, %1$@, en lugar de la biblioteca de %2$@, que no está disponible."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth به جای کتابخانه در %2$@ که در دسترس نیست، یک کتابخانه‌ی جدید و خالی در مکان پیش‌فرض، %1$@، شروع می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth va démarrer une nouvelle bibliothèque vide à l’emplacement par défaut, %1$@, au lieu de la bibliothèque dans %2$@, qui n’est pas disponible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth יתחיל ספרייה חדשה וריקה במיקום ברירת המחדל, %1$@, במקום הספרייה שבתיקייה %2$@, שאינה זמינה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth %2$@ की उस लाइब्रेरी के बजाय, जो उपलब्ध नहीं है, डिफ़ॉल्ट स्थान, %1$@, में एक नई, खाली लाइब्रेरी शुरू करेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth akan memulai pustaka baru yang kosong di lokasi default, %1$@, sebagai ganti pustaka di %2$@, yang tidak tersedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth avvierà una nuova libreria vuota nella posizione predefinita, %@, al posto della libreria in %@, che non è disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は、利用できない%2$@のライブラリの代わりに、デフォルトの場所%1$@に新しい空のライブラリを作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 사용할 수 없는 %2$@의 보관함 대신 기본 위치 %1$@에 비어 있는 새 보관함을 시작합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth begint een nieuwe, lege bibliotheek op de standaardlocatie, %1$@, in plaats van de bibliotheek in %2$@, die niet beschikbaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth utworzy nową, pustą bibliotekę w domyślnej lokalizacji, %1$@, zamiast biblioteki w %2$@, która jest niedostępna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth vai iniciar uma biblioteca nova e vazia na localização padrão, %1$@, em vez da biblioteca em %2$@, que não está disponível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth создаст новую пустую библиотеку в расположении по умолчанию, %1$@, вместо недоступной библиотеки в %2$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth startar ett nytt, tomt bibliotek på standardplatsen, %1$@, i stället för biblioteket i %2$@, som inte är tillgängligt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth จะเริ่มไลบรารีใหม่ที่ว่างในตำแหน่งที่ตั้งเริ่มต้น %@ แทนไลบรารีใน %@ ซึ่งไม่พร้อมใช้งาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth, kullanılamayan kitaplık (%2$@) yerine varsayılan konumda (%1$@) yeni, boş bir kitaplık başlatacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth створить нову порожню бібліотеку в типовому розташуванні, %1$@, замість бібліотеки в %2$@, яка недоступна."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth %2$@ میں موجود لائبریری کی جگہ، جو دستیاب نہیں ہے، ڈیفالٹ مقام %1$@ پر نئی خالی لائبریری شروع کرے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth sẽ bắt đầu một thư viện mới, trống ở vị trí mặc định, %1$@, thay cho thư viện trong %2$@, vốn không khả dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 将在默认位置 %1$@ 新建一个空资料库，而不是使用不可用的 %2$@ 中的资料库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
