                  "state" : "machine_translated",
                  "value" : "%1$@: %2$lld বা তার বেশি দৈর্ঘ্যের ধারা বিরতিসহ এড়িয়ে যাওয়া হয়"
                }
              },
              "other" : {
                "stringUnit" : {
