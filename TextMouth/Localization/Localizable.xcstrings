    "The folder is no longer in the library. It may have been moved, renamed, or deleted in another window." : {
      "comment" : "Error shown when a folder edit is refused because the folder is gone from the library.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يعد المجلد في المكتبة. ربما نُقل أو أُعيدت تسميته أو حُذف في نافذة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Ordner ist nicht mehr in der Bibliothek. Er wurde möglicherweise in einem anderen Fenster verschoben, umbenannt oder gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La carpeta ya no está en la biblioteca. Puede que se haya movido, renombrado o eliminado en otra ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le dossier n’est plus dans la bibliothèque. Il a peut-être été déplacé, renommé ou supprimé dans une autre fenêtre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ोल्डर अब लाइब्रेरी में नहीं है। हो सकता है उसे किसी दूसरी विंडो में ले जाया गया हो, उसका नाम बदला गया हो, या उसे मिटा दिया गया हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Folder tidak lagi ada di pustaka. Folder mungkin telah dipindahkan, diganti namanya, atau dihapus di jendela lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La cartella non è più nella libreria. Potrebbe essere stata spostata, rinominata o eliminata in un’altra finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フォルダはもうライブラリにありません。ほかのウインドウで移動、名前変更、削除された可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "폴더가 더 이상 보관함에 없습니다. 다른 윈도우에서 이동, 이름 변경 또는 삭제되었을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A pasta não está mais na biblioteca. Ela pode ter sido movida, renomeada ou excluída em outra janela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Папки больше нет в библиотеке. Возможно, её переместили, переименовали или удалили в другом окне."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Папки більше немає в бібліотеці. Її могли перемістити, перейменувати або видалити в іншому вікні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "该文件夹已不在资料库中。它可能已在另一个窗口中被移动、重新命名或删除。"
          }
        }
      }
    },
    "The folder is not a DAISY book: it has no ncc.html or .opf file at its top level." : {
      "comment" : "Why a folder could not be imported as a DAISY book: it holds no navigation file (ncc.html) and no package file (.opf) at its top level. ncc.html and .opf are file names and stay as they are.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "المجلد ليس كتاب DAISY: ليس فيه ملف ncc.html ولا ملف OPF في مستواه الأعلى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Ordner ist kein DAISY-Buch: Er hat auf oberster Ebene weder eine ncc.html- noch eine .opf-Datei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La carpeta no es un libro DAISY: no tiene un archivo ncc.html ni .opf en su nivel superior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le dossier n’est pas un livre DAISY : il n’a ni fichier ncc.html ni fichier .opf à sa racine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "यह फ़ोल्डर DAISY पुस्तक नहीं है: उसके सबसे ऊपरी स्तर पर कोई ncc.html या .opf फ़ाइल नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Folder ini bukan buku DAISY: tidak ada file ncc.html atau .opf di tingkat teratasnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La cartella non è un libro DAISY: al suo livello superiore non ha un file ncc.html o .opf."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フォルダは DAISY ブックではありません：最上位に ncc.html も .opf ファイルもありません。"
          }
        },
        "ko" : {
