    "brailleExport.startsFromDefault" : {
      "comment" : "Shown in the Export dialog's braille options when the table chosen in Settings can't be used. %1$@ is that table's name as macOS gives it and %2$@ the table the export starts from, in words such as \"Unified English Braille, uncontracted\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يستطيع TextMouth استخدام جدول برايل المختار في الإعدادات، “%1$@”، لذا يبدأ هذا التصدير من %2$@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth সেটিংসে বেছে নেওয়া ব্রেইল টেবিল “%1$@” ব্যবহার করতে পারে না, তাই এই রপ্তানি %2$@ থেকে শুরু হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kann die in den Einstellungen gewählte Brailletabelle „%1$@“ nicht verwenden, daher beginnt dieser Export mit %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth can't use the braille table chosen in Settings, “%@”, so this export starts from %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede usar la tabla de braille elegida en Ajustes, “%1$@”, así que esta exportación empieza con %2$@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth نمی‌تواند از جدول بریل انتخاب‌شده در تنظیمات، «%1$@»، استفاده کند، بنابراین این صادر کردن از %2$@ شروع می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ne peut pas utiliser la table braille choisie dans Réglages, « %1$@ », donc cette exportation part de %2$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth לא יכול להשתמש בטבלת הברייל שנבחרה בהגדרות, “%1$@”, ולכן הייצוא הזה מתחיל מ-%2$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth सेटिंग में चुनी गई ब्रेल टेबल “%1$@” का उपयोग नहीं कर सकता, इसलिए यह निर्यात %2$@ से शुरू होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tidak dapat memakai tabel braille yang dipilih di Pengaturan, “%1$@”, jadi ekspor ini dimulai dari %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non può usare la tabella braille scelta in Impostazioni, “%1$@”, quindi questa esportazione parte da %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "設定で選択された点字表「%1$@」を TextMouth は使用できないため、この書き出しは%2$@から始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "설정에서 선택한 점자표 “%1$@”을(를) TextMouth에서 사용할 수 없으므로, 이번 내보내기는 %2$@에서 시작합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kan de brailletabel die in Instellingen is gekozen, “%1$@”, niet gebruiken, dus deze export begint met %2$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth nie może użyć tabeli Braille’a wybranej w Ustawieniach, „%1$@”, więc ten eksport zaczyna od: %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não pode usar a tabela braille escolhida nos Ajustes, “%1$@”, então esta exportação começa com %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не может использовать таблицу Брайля, выбранную в настройках, «%1$@», поэтому экспорт начнётся с таблицы %2$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kan inte använda punktskriftstabellen som valts i Inställningar, ”%1$@”, så den här exporten börjar från %2$@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ใช้ตารางอักษรเบรลล์ที่เลือกไว้ในการตั้งค่า “%1$@” ไม่ได้ การส่งออกนี้จึงเริ่มจาก %2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth, Ayarlar'da seçilen “%1$@” braille tablosunu kullanamıyor, bu yüzden bu dışa aktarma %2$@ ile başlıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не може використати брайлівську таблицю «%1$@», вибрану в Налаштуваннях, тому цей експорт починається з %2$@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ترتیبات میں منتخب بریل جدول “%1$@” استعمال نہیں کر سکتا، اس لیے یہ برآمد %2$@ سے شروع ہوتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth không thể dùng bảng braille đã chọn trong Cài đặt, “%1$@”, nên lần xuất này bắt đầu từ %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 无法使用“设置”中选取的盲文表“%1$@”，因此本次导出从 %2$@ 开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 無法使用在設定中選擇的點字表「%1$@」，因此這次輸出從 %2$@ 開始。"
          }
        }
      }
    },
