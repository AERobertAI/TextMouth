    "feedFetchError.searchMessage.needsPassword" : {
      "comment" : "Why a podcast search failed: the directory limits searches to about 20 a minute.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "رفض دليل البودكاست البحث؛ فهو يسمح بنحو 20 بحثًا في الدقيقة. انتظر دقيقة وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পডকাস্ট ডিরেক্টরি অনুসন্ধান প্রত্যাখ্যান করেছে; এটি মিনিটে প্রায় 20টি অনুমোদন করে। এক মিনিট অপেক্ষা করে আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Podcast-Verzeichnis hat die Suche abgelehnt; es erlaubt etwa 20 pro Minute. Warte eine Minute und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The podcast directory refused the search; it allows about 20 a minute. Wait a minute and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El directorio de podcasts rechazó la búsqueda; permite unas 20 por minuto. Espera un minuto e inténtalo de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فهرست پادکست جست‌وجو را نپذیرفت؛ حدود 20 جست‌وجو در دقیقه مجاز است. یک دقیقه صبر کنید و دوباره تلاش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’annuaire de podcasts a refusé la recherche ; il en autorise environ 20 par minute. Attendez une minute et réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מאגר הפודקאסטים סירב לחיפוש; הוא מתיר כ-20 חיפושים בדקה. המתן דקה ונסה שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पॉडकास्ट डायरेक्टरी ने खोज अस्वीकार कर दी; वह लगभग 20 प्रति मिनट की अनुमति देती है। एक मिनट प्रतीक्षा करें और फिर से प्रयास करें।"
          }
        },
        "id" : {
          "stringUnit" : {
