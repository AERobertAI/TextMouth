          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ enthält zwei Versionen einer Datei dieses Buchs, daher kann der Download nicht entfernt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ guarda dos versiones de un archivo de este libro, así que no se puede quitar su descarga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ contient deux versions d’un fichier de ce livre ; son téléchargement ne peut donc pas être retiré."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ में इस पुस्तक की एक फ़ाइल के दो संस्करण हैं, इसलिए उसका डाउनलोड नहीं हटाया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ menyimpan dua versi file buku ini, sehingga unduhannya tidak dapat dibuang."
          }
        },
        "it" : {
          "stringUnit" : {
