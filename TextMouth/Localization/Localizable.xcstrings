    "Chapter %@: %@, at %@" : {
      "comment" : "A chapter marker's row in the audio editor's list. %1$@ is the chapter's number, an identifier written without digit grouping, %2$@ its title, and %3$@ its time in words.",
      "localizations" : {
        "de" : {
