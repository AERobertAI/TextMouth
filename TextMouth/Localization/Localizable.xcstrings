    },
    "Level" : {
      "comment" : "Label of the microphone's loudness while recording, in the Record window."
    },
    "Level 1" : {
      "comment" : "Choice of the headings sheet's level filter that shows only the biggest headings, level 1."
    },
    "Levels 1 to %lld" : {
      "comment" : "Choice of the headings sheet's level filter that shows levels from 1 to a deeper one. %lld is the deepest level shown."
    },
    "Library" : {
      "comment" : "Heading of the group of Library window keyboard shortcuts in Settings, and the title of the Library menu.\nText of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). The tab's name in the Settings window's toolbar.\nThe name spoken for the library's top level, the place that holds the folders and the books outside any folder, as in \"Library, 743 books\" after going to it.\nThe top of the library, as the Save in pop-up of the Record window names it.\nTitle of the Library menu in the menu bar, which holds the commands for the library's books and folders. Only a Library window shows it.\nTitle of the first screen, the list of the user's books and folders."
    },
    "Library / %@" : {
      "comment" : "A library folder in the Save in pop-up of the Record window: the library, then the folder's path, its folders separated by slashes. %@ is the path, such as \"Fiction / Sci-Fi\"."
    },
    "Library Index Could Not Be Read" : {
      "comment" : "Heading of the sheet shown when the library index file can't be read."
    },
    "Library Maintenance" : {
      "comment" : "Heading of the section of Storage settings with the duplicate finder and Redo Text Extraction."
    },
    "Library Not Available" : {
      "comment" : "Heading of the screen shown in place of the library when its folder can't be used, and the Library window's title meanwhile."
    },
    "Library Root" : {
      "comment" : "The folder name Find Duplicate Books gives a book at the top level of the library, in a duplicate's spoken label.\nThe name of the library's top level, the place that holds the folders and the books outside any folder. Shown as a folder choice, and in messages that say where a folder is."
    },
    "Library Statistics" : {
      "comment" : "Heading of the section of Storage settings that lists counts about the library."
    },
    "Library changes could not be saved: %@" : {
