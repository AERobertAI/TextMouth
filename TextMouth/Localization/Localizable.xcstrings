    "bookTextEdit.explanation.beginning" : {
      "comment" : "Second sentence of the Edit Text explanation. \"<!-- chapter:\" is the literal text that begins a chapter line in the file; it stays exactly as written.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يبدأ كل سطر يبدأ بـ <!-- chapter: فصلًا، فاحتفظ بهذه الأسطر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "<!-- chapter: দিয়ে শুরু হওয়া প্রতিটি লাইন একটি অধ্যায় শুরু করে; সেই লাইনগুলো রেখে দিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jede Zeile, die mit <!-- chapter: anfängt, beginnt ein Kapitel; behalte diese Zeilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each line beginning with <!-- chapter: starts a chapter; keep those lines."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cada línea que empieza con <!-- chapter: inicia un capítulo; conserva esas líneas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هر خطی که با <!-- chapter: شروع شود یک فصل را آغاز می‌کند؛ آن خط‌ها را نگه دارید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chaque ligne commençant par <!-- chapter: démarre un chapitre ; conservez ces lignes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כל שורה שמתחילה ב-<!-- chapter: פותחת פרק; שמור על שורות אלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "<!-- chapter: से शुरू होने वाली हर पंक्ति एक अध्याय शुरू करती है; उन पंक्तियों को बनाए रखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Setiap baris yang diawali <!-- chapter: memulai sebuah bab; pertahankan baris tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ogni riga che inizia con <!-- chapter: inizia un capitolo; conserva quelle righe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "<!-- chapter:で始まる各行はチャプタの始まりです。その行は残してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "<!-- chapter: 로 시작하는 각 줄은 챕터가 시작되는 위치이므로 그 줄을 그대로 두십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elke regel die begint met <!-- chapter: begint een hoofdstuk; laat die regels staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Każdy wiersz zaczynający się od <!-- chapter: rozpoczyna rozdział; pozostaw te wiersze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cada linha que começa com <!-- chapter: inicia um capítulo; mantenha essas linhas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Каждая строка, которая начинается с <!-- chapter:, начинает главу; сохраняйте эти строки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Varje rad som börjar med <!-- chapter: inleder ett kapitel; behåll de raderna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "แต่ละบรรทัดที่ขึ้นต้นด้วย <!-- chapter: คือจุดเริ่มต้นของบท เก็บบรรทัดเหล่านั้นไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "<!-- chapter: ile başlayan her satır bir bölüm başlatır; bu satırları koruyun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Кожен рядок, що починається з <!-- chapter:, починає розділ; залишайте ці рядки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جو سطر <!-- chapter: سے شروع ہو وہ ایک باب شروع کرتی ہے؛ ان سطروں کو رہنے دیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mỗi dòng bắt đầu bằng <!-- chapter: mở đầu một chương; hãy giữ nguyên các dòng đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "每个以 <!-- chapter: 开头的行标示一个章节的开始；请保留这些行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "每個以 <!-- chapter: 開頭的行都會開始新的一章；請保留這些行。"
          }
        }
      }
    },
    "bookTextEdit.explanation.begins" : {
