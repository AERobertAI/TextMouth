    "protection.cannotSkip" : {
      "comment" : "Said when someone tries to skip a section of a book that has a password: a skipped section is saved with its words, which a protected book never keeps. Remove the password first.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يمكن تخطي أقسام كتاب له كلمة مرور. أزل كلمة مروره أولًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পাসওয়ার্ড দেওয়া বইয়ের অংশ বাদ দেওয়া যায় না। আগে এর পাসওয়ার্ড সরান।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abschnitte eines Buchs mit Passwort lassen sich nicht überspringen. Entfernen Sie zuerst das Passwort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sections of a book with a password can't be skipped. Remove its password first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pueden omitir secciones de un libro con contraseña. Quítale primero la contraseña."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بخش‌های کتابی که گذرواژه دارد را نمی‌توان رد کرد. ابتدا گذرواژه‌اش را بردارید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les sections d’un livre protégé par mot de passe ne peuvent pas être ignorées. Retirez d’abord son mot de passe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אי אפשר לדלג על חלקים בספר עם סיסמה. הסירו קודם את הסיסמה שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पासवर्ड वाली पुस्तक के हिस्से छोड़े नहीं जा सकते। पहले उसका पासवर्ड हटाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bagian buku dengan kata sandi tidak dapat dilewati. Hapus dulu kata sandinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le sezioni di un libro con password non possono essere saltate. Rimuovi prima la password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "パスワードのあるブックのセクションはスキップできません。先にパスワードを削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "암호가 있는 책의 섹션은 건너뛸 수 없습니다. 먼저 암호를 제거하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Secties van een boek met wachtwoord kunnen niet worden overgeslagen. Verwijder eerst het wachtwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie można pomijać sekcji książki z hasłem. Najpierw usuń hasło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não é possível pular seções de um livro com senha. Remova antes a senha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Разделы книги с паролем нельзя пропускать. Сначала снимите пароль."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Avsnitt i en bok med lösenord kan inte hoppas över. Ta bort lösenordet först."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ข้ามส่วนของหนังสือที่มีรหัสผ่านไม่ได้ นำรหัสผ่านออกก่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Parolalı bir kitabın bölümleri atlanamaz. Önce parolasını kaldırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Розділи книги з паролем не можна пропускати. Спершу зніміть пароль."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پاس ورڈ والی کتاب کے حصے چھوڑے نہیں جا سکتے۔ پہلے اس کا پاس ورڈ ہٹائیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không thể bỏ qua các phần của sách có mật khẩu. Hãy gỡ mật khẩu trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "有密码的图书无法跳过各部分。请先移除密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "有密碼的書無法略過各部分。請先移除密碼。"
          }
        }
      }
    },
    "protection.damaged" : {
      "comment" : "Why a protected book cannot be unlocked: its file is damaged.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ملف هذا الكتاب تالف، لذا لا يمكن فتح قفله."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই বইয়ের ফাইলটি ক্ষতিগ্রস্ত, তাই এটি আনলক করা যাবে না।"
