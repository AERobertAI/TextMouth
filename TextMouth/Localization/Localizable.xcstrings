    "substitutions.reorderInstructions" : {
      "comment" : "Help in the footer of the Substitutions settings on reordering rules. %1$@ and %2$@ are the titles of the Move Up and Move Down commands, which stay as those commands show them.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "استخدم %@ و%@، أو اسحب، لإعادة الترتيب. تُطبَّق القواعد من الأعلى إلى الأسفل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ক্রম বদলাতে “%1$@” ও “%2$@” ব্যবহার করুন, অথবা টেনে আনুন। নিয়মগুলো উপর থেকে নিচে প্রয়োগ হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Verwende %1$@ und %2$@ oder ziehe, um die Reihenfolge zu ändern. Regeln gelten von oben nach unten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use %@ and %@, or drag, to reorder. Rules apply top to bottom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usa %1$@ y %2$@, o arrastra, para reordenar. Las reglas se aplican de arriba abajo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "از %1$@ و %2$@ یا کشیدن برای تغییر ترتیب استفاده کنید. قاعده‌ها از بالا به پایین اعمال می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Utilisez %1$@ et %2$@, ou faites glisser, pour réorganiser. Les règles s’appliquent de haut en bas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לסידור מחדש: “%1$@”, “%2$@” או גרירה. הכללים חלים מלמעלה למטה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "क्रम बदलने के लिए “%1$@” और “%2$@” का उपयोग करें, या खींचें। नियम ऊपर से नीचे लागू होते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gunakan %1$@ dan %2$@, atau seret, untuk mengurutkan ulang. Aturan berlaku dari atas ke bawah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usa %@ e %@, oppure trascina, per riordinare. Le regole vengono applicate dall’alto verso il basso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "並べ替えるには、「%1$@」と「%2$@」を使うか、ドラッグします。ルールは上から順に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 및 %2$@을(를) 사용하거나 드래그하여 순서를 바꾸십시오. 규칙은 위에서 아래로 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gebruik %1$@ en %2$@, of sleep, om de volgorde te wijzigen. Regels worden van boven naar beneden toegepast."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Użyj %1$@ i %2$@ lub przeciągnij, aby zmienić kolejność. Reguły są stosowane od góry do dołu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Use %1$@ e %2$@, ou arraste, para reordenar. As regras se aplicam de cima para baixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Используйте «%1$@» и «%2$@» или перетаскивание, чтобы изменить порядок. Правила применяются сверху вниз."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Använd %1$@ och %2$@, eller dra, för att ändra ordning. Reglerna tillämpas uppifrån och ned."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ใช้ %@ และ %@ หรือลากเพื่อจัดลำดับใหม่ กฎจะทำงานจากบนลงล่าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yeniden sıralamak için “%1$@” ve “%2$@” komutlarını kullanın veya sürükleyin. Kurallar yukarıdan aşağıya uygulanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Використовуйте %1$@ і %2$@ або перетягування, щоб змінити порядок. Правила застосовуються зверху вниз."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ترتیب بدلنے کے لیے “%1$@” اور “%2$@” استعمال کریں، یا گھسیٹیں۔ اصول اوپر سے نیچے لاگو ہوتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dùng %1$@ và %2$@, hoặc kéo, để sắp xếp lại. Các quy tắc áp dụng từ trên xuống dưới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "使用 %1$@ 和 %2$@，或拖移来重新排序。规则从上到下依次应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "使用 %1$@ 和 %2$@，或拖移，來重新排列。規則由上而下套用。"
          }
        }
      }
    },
    "substitutions.replacePart" : {
