    "sleepTimerHandOver.fadeEndedByTheMove" : {
      "comment" : "VoiceOver announcement after \"Starting: <title>\": moving to another book while the sleep timer was fading the sound out ended the timer.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أُلغي مؤقت النوم لأنك انتقلت إلى كتاب آخر أثناء تلاشي الصوت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "স্লিপ টাইমার বাতিল হয়েছে, কারণ ফেড আউটের সময় আপনি অন্য বইয়ে গেছেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Einschlaf-Timer abgebrochen, weil du während des Ausblendens zu einem anderen Buch gewechselt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep timer cancelled, because you moved to another book while it faded out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Temporizador de apagado cancelado, porque pasaste a otro libro mientras bajaba el volumen."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "زمان‌سنج خواب لغو شد، چون هنگام محو شدن صدا به کتابی دیگر رفتید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Minuteur de mise en veille annulé, car un autre livre a été ouvert pendant le fondu sortant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "טיימר השינה בוטל, כי הספר הוחלף בזמן שהשמע דעך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "स्लीप टाइमर रद्द हुआ, क्योंकि आवाज़ धीमी होते समय आप दूसरी पुस्तक पर चले गए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Timer tidur dibatalkan, karena Anda pindah ke buku lain saat suara memudar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Timer di spegnimento annullato, perché sei passato a un altro libro durante la dissolvenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フェードアウト中に別のブックへ移動したため、スリープタイマーをキャンセルしました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "취침 타이머가 취소되었습니다. 소리가 작아지는 동안 다른 책으로 이동했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Slaaptimer geannuleerd, omdat je naar een ander boek ging terwijl het geluid zachter werd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Anulowano wyłącznik czasowy, ponieważ w trakcie wyciszania zmieniono książkę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Timer de repouso cancelado, porque você passou para outro livro enquanto o som diminuía."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Таймер сна отменён, потому что вы перешли к другой книге, пока звук затухал."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Insomningstimern avbröts, eftersom du bytte till en annan bok medan ljudet tonades ned."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ยกเลิกตัวตั้งเวลาปิดแล้ว เพราะคุณย้ายไปยังหนังสือเล่มอื่นขณะที่เสียงกำลังค่อย ๆ เบาลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uyku zamanlayıcısı iptal edildi, çünkü ses kısılırken başka bir kitaba geçtiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Таймер сну скасовано, бо ви перейшли до іншої книги, поки звук затухав."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سلیپ ٹائمر منسوخ ہو گیا، کیونکہ آواز مدھم ہوتے وقت آپ دوسری کتاب پر چلے گئے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đã hủy hẹn giờ ngủ vì bạn chuyển sang sách khác trong khi âm thanh đang nhỏ dần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "睡眠定时器已取消，因为你在声音渐弱期间移到了另一本图书。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "睡眠計時器已取消，因為你在聲音淡出時切換到了另一本書。"
          }
        }
      }
    },
