    "feedFetchError.download.constrainedNetwork" : {
      "comment" : "Why a feed item's download did not run now: the network has data limits. Says the same as the row's wait reason. %@ is the item's title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ستُنزَّل “%@” عندما يصبح هذا الـ Mac على شبكة بلا حدود للبيانات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই Mac ডেটা সীমাহীন নেটওয়ার্কে এলে “%@” ডাউনলোড হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%@“ wird heruntergeladen, sobald dieser Mac in einem Netzwerk ohne Datenlimit ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” downloads once this Mac is on a network without data limits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” se descargará cuando esta Mac esté en una red sin límites de datos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%@» پس از اتصال این Mac به شبکه‌ای بدون محدودیت داده بارگیری می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "« %@ » se téléchargera quand ce Mac sera sur un réseau sans limite de données."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ההורדה של “%@” תתחיל ברגע שה-Mac הזה יהיה ברשת ללא מגבלות נתונים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” तब डाउनलोड होगा जब यह Mac डेटा सीमा रहित नेटवर्क पर होगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” diunduh setelah Mac ini terhubung ke jaringan tanpa batas data."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” verrà scaricato quando questo Mac sarà su una rete senza limiti di dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」は、この Mac がデータ量の制限のないネットワークに接続されるとダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 Mac이 데이터 제한 없는 네트워크에 연결되면 “%@”이(가) 다운로드됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” wordt gedownload zodra deze Mac verbonden is met een netwerk zonder datalimiet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pobieranie „%@” nastąpi, gdy ten komputer Mac będzie w sieci bez limitów danych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” é baixado quando este Mac estiver em uma rede sem limite de dados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Загрузка «%@» начнётся, когда этот Mac подключится к сети без ограничений трафика."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "”%@” hämtas när den här Mac-datorn är på ett nätverk utan databegränsningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” จะดาวน์โหลดเมื่อ Mac เครื่องนี้เชื่อมต่อเครือข่ายที่ไม่จำกัดข้อมูล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@”, bu Mac veri sınırı olmayan bir ağa bağlanınca indirilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%@» завантажиться, щойно цей Mac підключиться до мережі без обмежень даних."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” اس وقت ڈاؤن لوڈ ہوتا ہے جب یہ Mac ڈیٹا کی حد کے بغیر نیٹ ورک پر ہو۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” sẽ tải về khi máy Mac này vào mạng không giới hạn dữ liệu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@”会在这台 Mac 连接到不受数据流量限制的网络后下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」會在這部 Mac 連上沒有資料用量限制的網路後下載。"
          }
        }
      }
    },
