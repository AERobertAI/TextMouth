            "value" : "Choose how to remove %@ from the library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige cómo quitar %@ de la biblioteca."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "انتخاب کنید که %@ چگونه از کتابخانه برداشته شود."
