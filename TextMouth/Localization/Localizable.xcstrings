        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non è stato possibile scaricare l’articolo precedente, quindi la riproduzione si è interrotta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O artigo anterior não pôde ser baixado, então a reprodução parou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не удалось загрузить предыдущую статью, поэтому воспроизведение остановлено."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
