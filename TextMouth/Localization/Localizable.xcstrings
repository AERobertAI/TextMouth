    "feedDownloadError.message.folderMissing" : {
      "comment" : "Why a feed's episode could not be downloaded: the feed's folder was removed from the library.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يعد مجلد هذا الموجز في المكتبة. اختر له مجلدًا آخر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই ফিডের ফোল্ডার আর লাইব্রেরিতে নেই। এর জন্য অন্য একটি ফোল্ডার বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Ordner für diesen Feed ist nicht mehr in der Bibliothek. Wähle einen anderen Ordner dafür."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The folder for this feed is no longer in the library. Choose another folder for it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La carpeta de este canal ya no está en la biblioteca. Elige otra carpeta para él."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پوشه این فید دیگر در کتابخانه نیست. پوشه دیگری برای آن انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
