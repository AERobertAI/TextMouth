    "readingList.continuationHint" : {
      "comment" : "VoiceOver hint of the Reading List's When a book ends pop-up button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يختار ما يحدث عندما ينتهي كتاب فُتح من القائمة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "তালিকা থেকে খোলা একটি বই শেষ হলে কী হবে তা বেছে নেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Legt fest, was passiert, wenn ein aus der Liste geöffnetes Buch endet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chooses what a book opened from the list does when it ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige qué hace un libro abierto desde la lista al terminar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کاری را که کتابِ باز‌شده از فهرست در پایانش انجام می‌دهد انتخاب می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisit ce que fait un livre ouvert depuis la liste quand il se termine."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בוחר מה ספר שנפתח מהרשימה עושה כשהוא מסתיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चुनता है कि सूची से खोली गई पुस्तक के ख़त्म होने पर क्या हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Memilih apa yang dilakukan buku yang dibuka dari daftar saat selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
