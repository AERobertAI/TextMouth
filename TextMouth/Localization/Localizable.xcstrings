    "feed.insecureMessage" : {
      "comment" : "The warning shown once after subscribing to a feed whose address uses plain http. %@ is the feed's title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم الاشتراك في %@. يستخدم هذا الموجز بروتوكول http العادي، لذا يمكن للآخرين قراءة ما يرسله أو تغييره؛ ومع ذلك يحمّله TextMouth."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@-এ সাবস্ক্রাইব করা হয়েছে। এই ফিড সাধারণ http ব্যবহার করে, তাই অন্যরা এর পাঠানো তথ্য পড়তে বা বদলাতে পারে; TextMouth তবুও এটি লোড করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ abonniert. Dieser Feed verwendet unverschlüsseltes http, daher können andere mitlesen oder ändern, was er sendet. TextMouth lädt ihn trotzdem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscribed to %@. This feed uses plain http, so others can read or change what it sends; TextMouth still loads it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Te suscribiste a %@. Este canal usa http sin cifrar, así que otras personas pueden leer o cambiar lo que envía; TextMouth lo carga de todos modos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "در %@ مشترک شدید. این فید از http ساده استفاده می‌کند، پس دیگران می‌توانند آنچه را می‌فرستد بخوانند یا تغییر دهند؛ TextMouth باز هم آن را بارگیری می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abonné à %@. Ce flux utilise http non chiffré, donc d’autres peuvent lire ou modifier ce qu’il envoie ; TextMouth le charge quand même."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "נרשמת ל-%@. הערוץ הזה משתמש ב-http רגיל, כך שאחרים יכולים לקרוא או לשנות את מה שהוא שולח; TextMouth עדיין טוען אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ की सदस्यता ली गई। यह फ़ीड सादे http का उपयोग करता है, इसलिए दूसरे लोग उसका भेजा हुआ पढ़ या बदल सकते हैं; TextMouth फिर भी उसे लोड करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Berhasil berlangganan %@. Feed ini memakai http biasa, sehingga orang lain dapat membaca atau mengubah apa yang dikirimnya; TextMouth tetap memuatnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Iscrizione a %@ completata. Questo feed usa http non protetto, quindi altri possono leggere o modificare ciò che invia; TextMouth lo carica comunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@を購読しました。このフィードは暗号化されていない http を使用しているため、送信内容を第三者が読んだり変更したりできます。TextMouth はそれでも読み込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 구독을 시작했습니다. 이 피드는 암호화되지 않은 http를 사용하므로 피드가 보내는 내용을 다른 사람이 읽거나 바꿀 수 있습니다. 그래도 TextMouth는 불러옵니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Geabonneerd op %@. Deze feed gebruikt gewone http, dus anderen kunnen meelezen of wijzigen wat de feed verstuurt; TextMouth laadt de feed toch."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zasubskrybowano kanał %@. Ten kanał używa zwykłego http, więc inne osoby mogą odczytać lub zmienić to, co wysyła; TextMouth mimo to go wczytuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Você assinou %@. Este feed usa http simples, então outras pessoas podem ler ou alterar o que ele envia; o TextMouth ainda assim o carrega."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Подписка на %@ оформлена. Эта лента использует обычный http, поэтому другие могут прочитать или изменить то, что она отправляет; TextMouth всё равно её загружает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du prenumererar nu på %@. Flödet använder vanlig http, så andra kan läsa eller ändra det som det skickar; TextMouth läser in det ändå."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ติดตาม %@ แล้ว ฟีดนี้ใช้ http ธรรมดา ผู้อื่นจึงอ่านหรือเปลี่ยนสิ่งที่ฟีดส่งได้ แต่ TextMouth ยังโหลดฟีดนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abone olundu: %@. Bu besleme şifrelenmemiş http kullanıyor, bu yüzden gönderdiği veriler başkalarınca okunabilir veya değiştirilebilir; TextMouth yine de yükler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Підписано на %@. Ця стрічка використовує звичайний http, тож інші можуть читати або змінювати те, що вона надсилає; TextMouth усе одно її завантажує."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ کو سبسکرائب کر لیا گیا۔ یہ فیڈ سادہ http استعمال کرتی ہے، اس لیے دوسرے اس کا بھیجا ہوا مواد پڑھ یا بدل سکتے ہیں؛ پھر بھی TextMouth اسے لوڈ کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đã đăng ký %@. Nguồn cấp này dùng http thuần, nên người khác có thể đọc hoặc thay đổi những gì nó gửi; TextMouth vẫn tải nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "已订阅 %@。此订阅源使用普通 http，其他人可能读取或更改它发送的内容；TextMouth 仍会加载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "已訂閱 %@。此訂閱源使用純 http，因此其他人可能讀取或更改它傳送的內容；TextMouth 仍會載入。"
          }
        }
      }
    },
    "feed.insecureNote" : {
      "comment" : "The note in Feed Info about a feed whose address uses plain http, which is not encrypted. Plain http is a term; keep it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "http العادي: يمكن للآخرين قراءة ما يرسله هذا الموجز أو تغييره."
          }
        },
        "bn" : {
