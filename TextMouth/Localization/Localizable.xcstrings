          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Incolla o digita qui il testo, oppure riprova."
          }
        }
      }
    },
    "Pasted %@ back where they were cut." : {
      "comment" : "Said as a Paste right after a Cut, at the cut's own place, puts the audio back. %@ is its length in words.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
