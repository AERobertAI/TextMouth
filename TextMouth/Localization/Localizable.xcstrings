        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não foi possível iniciar o ffmpeg. Verifique se ele está instalado ou desative Usar o ffmpeg nos ajustes de Armazenamento."
          }
        }
      }
    },
