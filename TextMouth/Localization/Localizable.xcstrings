    "audioEditor.explanation.editorSpeakSelection" : {
      "comment" : "Hint of the audio editor's Speak Selection button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يذكر أين يبدأ التحديد وينتهي، وكم طوله."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "নির্বাচন কোথায় শুরু ও শেষ হয়, এবং কতটা দীর্ঘ তা বলে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sagt an, wo die Auswahl beginnt und endet und wie lang sie ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Says where the selection starts and ends, and how long it is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dice dónde empieza y termina la selección, y cuánto dura."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "می‌گوید انتخاب از کجا شروع و به کجا تمام می‌شود، و چقدر طول دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Indique où commence et où finit la sélection, et sa durée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אומר היכן הבחירה מתחילה ומסתיימת, וכמה זמן היא נמשכת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "बताता है कि चयन कहाँ से कहाँ तक है, और कितना लंबा है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menyebutkan awal dan akhir pilihan, serta durasinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dice dove inizia e dove finisce la selezione e quanto è lunga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選択範囲の始点、終点、長さを読み上げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "선택 영역의 시작과 끝 위치, 그리고 길이를 알려 줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zegt waar de selectie begint en eindigt en hoe lang die is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mówi, gdzie zaczyna się i kończy zaznaczenie oraz jak jest długie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Diz onde a seleção começa e termina e qual é a duração dela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сообщает, где начинается и заканчивается выделение и какова его длина."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Säger var markeringen börjar och slutar, och hur lång den är."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "บอกว่าส่วนที่เลือกเริ่มและสิ้นสุดที่ไหน และยาวเท่าไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Seçimin nerede başlayıp bittiğini ve ne kadar uzun olduğunu söyler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Повідомляє, де починається й закінчується виділення та яка його тривалість."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بتاتا ہے کہ انتخاب کہاں سے شروع اور کہاں ختم ہوتا ہے، اور کتنا لمبا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cho biết vùng chọn bắt đầu và kết thúc ở đâu, và dài bao lâu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "朗读所选内容的起止位置和长度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "朗讀選取範圍的開頭、結尾和長度。"
          }
        }
      }
    },
    "audioEditor.explanation.editorStop" : {
      "comment" : "Hint of the audio editor's Stop button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يوقف التشغيل، ويعود إلى حيث بدأ التشغيل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "চালানো থামায়, এবং যেখান থেকে শুরু হয়েছিল সেখানে ফিরে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppt die Wiedergabe und geht zurück dorthin, wo sie begann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops playing, and goes back to where playing began."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detiene la reproducción y vuelve a donde empezó."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پخش را متوقف می‌کند و به جایی که پخش از آنجا شروع شد برمی‌گردد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrête la lecture et revient où elle avait commencé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "עוצר את הניגון וחוזר למקום שבו הניגון התחיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चलाना रोकता है, और जहाँ से चलना शुरू हुआ था वहाँ वापस जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menghentikan pemutaran, dan kembali ke tempat pemutaran dimulai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe la riproduzione e torna al punto da cui è iniziata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "再生を停止し、再生を始めた位置に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "재생을 중지하고 재생을 시작한 지점으로 돌아갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stopt het afspelen en gaat terug naar waar het afspelen begon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zatrzymuje odtwarzanie i wraca do miejsca, od którego zaczęło się odtwarzanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para a reprodução e volta ao ponto onde ela começou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Останавливает воспроизведение и возвращается туда, где оно началось."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppar uppspelningen och går tillbaka dit den började."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หยุดเล่น และกลับไปที่จุดที่เริ่มเล่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Oynatmayı durdurur ve oynatmanın başladığı yere döner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Зупиняє відтворення й повертається туди, де воно почалося."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "چلانا روکتا ہے، اور وہاں واپس جاتا ہے جہاں سے چلنا شروع ہوا تھا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dừng phát, và quay lại nơi bắt đầu phát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止播放，并回到开始播放的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止播放，並回到開始播放的位置。"
          }
        }
      }
    },
