    "audioEditingSettings.playAfterMovesHint" : {
      "comment" : "Hint of the Play half a second after each move switch in Storage settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يشغّل نصف ثانية عند المؤشر بعد كل انتقال."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "প্রতিবার সরানোর পর কার্সরের জায়গায় আধা সেকেন্ড চালায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gibt nach jeder Bewegung eine halbe Sekunde am Cursor wieder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plays half a second at the cursor after each move."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproduce medio segundo en el cursor después de cada movimiento."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پس از هر حرکت، نیم ثانیه از محل مکان‌نما پخش می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lit une demi-seconde au curseur après chaque déplacement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מנגן חצי שנייה בסמן לאחר כל הזזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "हर बार आगे-पीछे जाने के बाद कर्सर पर आधा सेकंड चलाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Memutar setengah detik di posisi kursor setelah setiap perpindahan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Riproduce mezzo secondo nella posizione del cursore dopo ogni spostamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "移動のたびに、カーソルの位置を0.5秒再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이동할 때마다 커서 위치에서 0.5초를 재생합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Speelt na elke verplaatsing een halve seconde af bij de cursor."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Odtwarza pół sekundy przy kursorze po każdym przesunięciu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproduz meio segundo no cursor após cada movimento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Воспроизводит полсекунды с позиции курсора после каждого перемещения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Spelar upp en halv sekund vid markören efter varje förflyttning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เล่นครึ่งวินาทีที่เคอร์เซอร์หลังเลื่อนทุกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Her hareketten sonra imleç konumunda yarım saniye oynatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відтворює півсекунди в місці курсора після кожного переміщення."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ہر حرکت کے بعد کرسر پر آدھا سیکنڈ چلاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Phát nửa giây tại con trỏ sau mỗi lần di chuyển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "每次移动后在光标处播放半秒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "每次移動後，在游標處播放半秒。"
          }
        }
      }
    },
