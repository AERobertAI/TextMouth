    "Install TextMouth again, then import the file again." : {
      "comment" : "Advice ending the sentences about a file that TextMouth's own converter could not read because the converter is missing from the app."
    },
    "Invalid TextMouth package: %@" : {
      "comment" : "Why a TextMouth package (.tmb) was refused at import. %@ is the reason, a phrase in English."
    },
    "Invalid regex: %@" : {
      "comment" : "Shown in the substitution rule editor when the pattern is not a valid regular expression. %@ is the reason the system gives, which may be in English. Regex is short for regular expression."
