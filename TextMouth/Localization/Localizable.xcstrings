    "ffmpegImport.crashed" : {
      "comment" : "Why a file was not imported: TextMouth's converter stopped unexpectedly while reading it, as a damaged file can make it do. %@ is the file's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "توقف محوّل TextMouth بشكل غير متوقع أثناء قراءة “%@”. قد يكون الملف تالفًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth-এর কনভার্টার “%@” পড়ার সময় হঠাৎ থেমে গেছে। ফাইলটি ক্ষতিগ্রস্ত হতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Umwandlungsprogramm von TextMouth ist beim Lesen von „%@“ unerwartet gestoppt. Die Datei ist möglicherweise beschädigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth's converter stopped unexpectedly while reading “%@”. The file may be damaged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El conversor de TextMouth se detuvo inesperadamente al leer “%@”. Puede que el archivo esté dañado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مبدل TextMouth هنگام خواندن «%@» ناگهان متوقف شد. ممکن است فایل آسیب دیده باشد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le convertisseur de TextMouth s’est arrêté de façon inattendue pendant la lecture de « %@ ». Le fichier est peut-être endommagé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הממיר של TextMouth נעצר באופן בלתי צפוי בעת קריאת “%@”. ייתכן שהקובץ פגום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth का कनवर्टर “%@” को पढ़ते समय अचानक रुक गया। फ़ाइल क्षतिग्रस्त हो सकती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Konverter TextMouth berhenti tiba-tiba saat membaca “%@”. File itu mungkin rusak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il convertitore di TextMouth si è fermato inaspettatamente durante la lettura di “%@”. Il file potrebbe essere danneggiato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth のコンバータが「%@」の読み取り中に予期せず停止しました。ファイルが破損している可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth의 변환기가 “%@”을(를) 읽는 중 예기치 않게 멈췄습니다. 파일이 손상되었을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De converter van TextMouth stopte onverwacht tijdens het lezen van “%@”. Het bestand is mogelijk beschadigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Konwerter TextMouth nieoczekiwanie zatrzymał się podczas odczytu „%@”. Plik może być uszkodzony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O conversor do TextMouth parou inesperadamente ao ler “%@”. O arquivo pode estar danificado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Конвертер TextMouth неожиданно остановился при чтении «%@». Возможно, файл повреждён."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Konverteraren i TextMouth avslutades oväntat under läsningen av ”%@”. Filen kan vara skadad."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตัวแปลงของ TextMouth หยุดทำงานโดยไม่คาดคิดขณะอ่าน “%@” ไฟล์อาจเสียหาย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth'un dönüştürücüsü “%@” okunurken beklenmedik şekilde durdu. Dosya hasarlı olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Перетворювач TextMouth несподівано зупинився під час читання «%@». Файл може бути пошкоджений."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth کا کنورٹر “%@” پڑھتے وقت غیر متوقع طور پر رک گیا۔ ہو سکتا ہے فائل خراب ہو۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bộ chuyển đổi của TextMouth dừng bất ngờ khi đọc “%@”. Tệp có thể bị hỏng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 的转换器在读取“%@”时意外停止。该文件可能已损坏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 的轉換器在讀取「%@」時意外停止。該檔案可能已損毀。"
          }
        }
      }
