    "settings.fadeOutExplanation" : {
      "comment" : "Explanation under the sleep timer's fade out stepper in the Playback settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يخفض مستوى الصوت تدريجيًا قبل الإيقاف المؤقت عند انتهاء مؤقت النوم. تؤدي القيمة 0 إلى الإيقاف المؤقت فورًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "স্লিপ টাইমারের মেয়াদ শেষ হলে বিরতির আগে ধীরে ধীরে ভলিউম কমায়। 0 দিলে তাৎক্ষণিক বিরতি হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Verringert die Lautstärke allmählich, bevor pausiert wird, wenn der Einschlaf-Timer abläuft. 0 pausiert sofort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradually reduce volume before pausing when the sleep timer expires. 0 pauses instantly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reduce el volumen poco a poco antes de pausar cuando expira el temporizador de apagado. Con 0, se pausa al instante."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هنگام پایان زمان‌سنج خواب، صدا پیش از مکث به‌تدریج کم می‌شود. 0 یعنی مکث فوری."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Réduit progressivement le volume avant la mise en pause à l’expiration du minuteur de mise en veille. 0 met en pause instantanément."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מקטין את עוצמת הקול בהדרגה לפני ההשהיה כשטיימר השינה פג. 0 משהה מיד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "स्लीप टाइमर समाप्त होने पर पॉज़ करने से पहले वॉल्यूम धीरे-धीरे कम करता है। 0 तुरंत पॉज़ करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kurangi volume secara bertahap sebelum menjeda saat timer tidur berakhir. 0 menjeda seketika."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Riduce gradualmente il volume prima di mettere in pausa quando il timer di spegnimento scade. 0 mette in pausa subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "スリープタイマーが切れたとき、一時停止する前に音量を徐々に下げます。0 では即座に一時停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "취침 타이머가 끝나면 일시 정지하기 전에 음량을 서서히 줄입니다. 0이면 즉시 일시 정지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Verlaagt het volume geleidelijk voordat de slaaptimer pauzeert. Bij 0 wordt direct gepauzeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stopniowo zmniejsza głośność przed wstrzymaniem, gdy wyłącznik czasowy wygaśnie. 0 wstrzymuje natychmiast."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reduz o volume aos poucos antes de pausar quando o timer de repouso expira. Com 0, pausa na hora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Постепенно уменьшает громкость перед паузой, когда срабатывает таймер сна. При 0 пауза наступает сразу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sänk volymen gradvis innan uppspelningen pausas när insomningstimern går ut. 0 pausar direkt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ลดระดับเสียงลงทีละน้อยก่อนหยุดชั่วคราวเมื่อตัวตั้งเวลาปิดหมดลง 0 คือหยุดทันที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uyku zamanlayıcısı bittiğinde duraklatmadan önce sesi yavaş yavaş kısar. 0 anında duraklatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Поступово зменшує гучність перед паузою, коли спрацьовує таймер сну. 0 — пауза одразу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سلیپ ٹائمر ختم ہونے پر توقف سے پہلے آواز بتدریج کم کرتا ہے۔ 0 پر فوراً توقف ہوتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Giảm dần âm lượng trước khi tạm dừng khi hẹn giờ ngủ hết hạn. 0 là tạm dừng ngay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "睡眠定时器到期时，先逐渐降低音量再暂停。0 表示立即暂停。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "睡眠計時器到期時，在暫停前逐漸降低音量。0 表示立即暫停。"
          }
        }
      }
    },
