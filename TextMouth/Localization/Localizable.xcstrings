            "value" : "%1$@ پر %2$@ ڈاؤن لوڈ کرنے کی جگہ نہیں ہے۔ جو کتابیں پہلے سے یہاں ہیں، وہ رہتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không đủ dung lượng trên %1$@ để tải về %2$@. Những sách đã có ở đây vẫn được giữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
