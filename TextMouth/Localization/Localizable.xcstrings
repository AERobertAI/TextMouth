          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文字起こししたあとにブックのオーディオが変わったため（%@）、文字起こしが合わなくなりました。もう一度文字起こししてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
