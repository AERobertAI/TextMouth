        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Otro contenido ocupó el nombre de su paquete, y no se encontró ningún nombre sin usar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
