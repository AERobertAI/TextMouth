    "playlistImport.streaming" : {
      "comment" : "Refusal of a playlist that is an HLS stream, a list of pieces of one broadcast on the web. \"It\" is the playlist. Follows the sentence naming the file.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "إنها قائمة تشغيل بث لصوت الويب، ولا يستوردها TextMouth."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এটি ওয়েব অডিওর একটি স্ট্রিমিং প্লেলিস্ট, যা TextMouth আমদানি করে না।"
          }
