        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "नई प्रति को छोड़ देता है। लाइब्रेरी जैसी थी वैसी ही रहती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuang salinan baru. Pustaka tetap seperti semula."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scarta la nuova copia. La libreria resta com’era."
          }
        },
        "ja" : {
          "stringUnit" : {
