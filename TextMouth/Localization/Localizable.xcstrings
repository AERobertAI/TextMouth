    },
    "Writes this and every other too-deeply nested chapter of this export as plain paragraphs of lines, without asking again." : {
      "comment" : "The hint of the Export Every Such Chapter as Written button in the alert an export shows when a chapter nests too deeply.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Schreibt dieses und jedes andere zu tief verschachtelte Kapitel dieses Exports als einfache Absätze aus Zeilen, ohne erneut zu fragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escribe este y cualquier otro capítulo de esta exportación con anidado demasiado profundo como párrafos simples de líneas, sin volver a preguntar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Écrit ce chapitre et tous les autres chapitres trop imbriqués de cet export en paragraphes simples de lignes, sans redemander."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scrive questo e ogni altro capitolo troppo annidato di questa esportazione come semplici paragrafi di righe, senza chiedere di nuovo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Grava este e todos os outros capítulos aninhados fundo demais desta exportação como parágrafos simples de linhas, sem perguntar de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Записывает эту и каждую другую слишком глубоко вложенную главу этого экспорта обычными абзацами из строк, не спрашивая снова."
          }
        }
      }
    },
    "Writes this chapter as plain paragraphs of its lines, and exports everything else as usual." : {
      "comment" : "The hint of the Export as Written button in the alert an export shows when a chapter nests too deeply.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Schreibt dieses Kapitel als einfache Absätze aus seinen Zeilen und exportiert alles andere wie gewohnt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escribe este capítulo como párrafos simples con sus líneas y exporta todo lo demás como de costumbre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Écrit ce chapitre en paragraphes simples de ses lignes, et exporte tout le reste comme d’habitude."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scrive questo capitolo come semplici paragrafi delle sue righe ed esporta tutto il resto come al solito."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Grava este capítulo como parágrafos simples de suas linhas e exporta todo o resto normalmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Записывает эту главу обычными абзацами из её строк, а всё остальное экспортирует как обычно."
          }
        }
      }
    },
    "Year" : {
      "comment" : "Name of the book information sheet's field for an audiobook's year; VoiceOver reads it as the field's label.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jahr"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Año"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Année"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Anno"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ano"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Год"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "年份"
          }
        }
      }
    },
    "You can make a new folder here." : {
      "comment" : "Last sentence of the message of the folder chooser that Change Location opens: the chooser has a button that makes a folder.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du kannst hier einen neuen Ordner anlegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aquí puedes crear una carpeta nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vous pouvez créer un nouveau dossier ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Puoi creare qui una nuova cartella."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Você pode criar uma nova pasta aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Здесь можно создать новую папку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Тут можна створити нову папку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "你可以在此新建文件夹。"
          }
        }
      }
    },
    "You can open and read books, and reading positions are still saved with each book, but changes to the library itself are not saved until you choose one of the options below." : {
      "comment" : "Last sentence of the library index recovery sheet: what still works, and what does not until an option is chosen.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du kannst Bücher öffnen und lesen, und Lesepositionen werden weiterhin mit jedem Buch gesichert, aber Änderungen an der Bibliothek selbst werden erst gesichert, wenn du unten eine der Optionen wählst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Puedes abrir y leer libros, y las posiciones de lectura se siguen guardando con cada libro, pero los cambios de la propia biblioteca no se guardan hasta que elijas una de las opciones de abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vous pouvez ouvrir et lire des livres, et les positions de lecture sont toujours enregistrées avec chaque livre, mais les modifications de la bibliothèque elle-même ne sont pas enregistrées tant que vous n’avez pas choisi l’une des options ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Puoi aprire e leggere i libri, e le posizioni di lettura vengono ancora salvate con ogni libro, ma le modifiche alla libreria stessa non vengono salvate finché non scegli una delle opzioni qui sotto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Você pode abrir e ler livros, e as posições de leitura ainda são salvas com cada livro, mas as alterações da própria biblioteca não são salvas até você escolher uma das opções abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вы можете открывать и читать книги, позиции чтения по-прежнему сохраняются вместе с каждой книгой, но изменения самой библиотеки не сохраняются, пока вы не выберете один из вариантов ниже."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ви можете відкривати й читати книги, а позиції читання, як і раніше, зберігаються з кожною книгою, але зміни самої бібліотеки не зберігаються, доки ви не виберете один із варіантів нижче."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "你可以打开和阅读图书，阅读位置也仍会随每本图书存储，但在你选择下面的某个选项之前，资料库本身的更改不会被存储。"
          }
        }
      }
    },
    "You can recover it from the Trash until the Trash is emptied." : {
      "comment" : "Sentence of the confirmation about the original file of a book just imported, and the hint of its Move to Trash button: the file can be recovered from the Trash.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du kannst sie aus dem Papierkorb zurückholen, bis er geleert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Puedes recuperarlo de la Papelera hasta que la vacíes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vous pouvez le récupérer dans la corbeille jusqu’à ce qu’elle soit vidée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Puoi recuperarlo dal Cestino finché non viene svuotato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Você pode recuperá-lo da Lixeira até esvaziá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вы можете восстановить его из Корзины, пока Корзина не очищена."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ви можете відновити його з Кошика, доки Кошик не очищено."
          }
        }
      }
    },
    "You cleaned it up on %@." : {
      "comment" : "Sentence of Book Information's Transcript detail saying when the user cleaned up the transcript. %@ is a date, such as \"October 5, 2026\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du hast es am %@ bereinigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lo limpiaste el %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vous l’avez nettoyée le %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’hai pulita il %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Você a limpou em %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вы исправили её %@."
          }
        }
      }
    },
    "You cleaned up this transcript on %@. Transcribing again replaces the cleanup." : {
      "comment" : "Line of the Transcribe Audio sheet warning that transcribing again replaces the cleanup the user applied. %@ is a date, such as \"October 5, 2026\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du hast dieses Transkript am %@ bereinigt. Erneutes Transkribieren ersetzt die Bereinigung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Limpiaste esta transcripción el %@. Volver a transcribir reemplaza la limpieza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vous avez nettoyé cette transcription le %@. Une nouvelle transcription remplace le nettoyage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hai pulito questa trascrizione il %@. Trascrivere di nuovo sostituisce la pulizia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Você limpou esta transcrição em %@. Transcrever de novo substitui a limpeza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вы исправили эту расшифровку %@. Повторная расшифровка заменит исправление."
          }
        }
      }
    },
    "You edited it on %@." : {
      "comment" : "Sentence of Book Information's Transcript detail saying when the user edited the transcript. %@ is a date, such as \"October 5, 2026\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du hast es am %@ bearbeitet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lo editaste el %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vous l’avez modifiée le %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’hai modificata il %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Você a editou em %@."
          }
        },
        "ru" : {
          "stringUnit" : {
