        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth le salva quando ha finito di spostare i libri tra le cartelle."
          }
        }
      }
    },
    "TextMouth saves them once it has finished rebuilding its data directory." : {
      "comment" : "Why a failed save waits: it runs when the data directory has been rebuilt. \"Them\" is the changes that could not be saved.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth los guarda cuando termine de reconstruir su directorio de datos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth le salva quando ha finito di ricostruire la sua cartella dei dati."
          }
        }
      }
    },
    "TextMouth saves them once the move of its data directory ends." : {
      "comment" : "Why a failed save waits: it runs when the move of the data directory ends. \"Them\" is the changes that could not be saved.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth los guarda cuando termine el traslado de su directorio de datos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth le salva quando lo spostamento della sua cartella dei dati termina."
          }
        }
      }
    },
    "TextMouth skipped %lld entries of “%@”: %@." : {
      "comment" : "Notice after a playlist imported with entries left out. %1$lld is the number of entries skipped, %2$@ the playlist's name, and %3$@ the list of the entries, each with its reason in parentheses.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "TextMouth skipped %lld entry of “%@”: %@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "TextMouth skipped %lld entries of “%@”: %@."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "TextMouth omitió %lld de entradas de “%@”: %@."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "TextMouth omitió %lld entrada de “%@”: %@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "TextMouth omitió %lld entradas de “%@”: %@."
                }
              }
            }
          }
        }
      }
    },
    "TextMouth stopped %@ because %@, and won't try again until TextMouth is closed and opened again." : {
      "comment" : "Said when a library call inside the iPhone app ran too long and was abandoned. %1$@ is the work's name, such as \"the braille translation\" (English until its area converts); %2$@ is why it was stopped, such as \"it ran longer than 11 seconds\" (English until the watchdog's area converts). Read after an import's own words.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TextMouth stopped %1$@ because %2$@, and won't try again until TextMouth is closed and opened again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth detuvo %1$@ porque %2$@, y no volverá a intentarlo hasta que cierres y vuelvas a abrir TextMouth."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ha interrotto %1$@ perché %2$@, e non riproverà finché TextMouth non verrà chiuso e riaperto."
          }
        }
      }
    },
    "TextMouth stopped %@ earlier because it took too long, and won't try again until TextMouth is closed and opened again." : {
      "comment" : "Said when a library call inside the iPhone app is refused because an earlier one was abandoned for taking too long. %@ is the work's name, such as \"the braille translation\" (English until its area converts). Read after an import's own words.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth detuvo antes %@ porque tardaba demasiado, y no volverá a intentarlo hasta que cierres y vuelvas a abrir TextMouth."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ha interrotto %@ prima perché richiedeva troppo tempo, e non riproverà finché TextMouth non verrà chiuso e riaperto."
          }
        }
      }
    },
    "TextMouth stopped reading this document because %@." : {
      "comment" : "Why a document was refused at import: the program that reads it ran too long or used too much memory and was stopped. %@ is the reason, a clause in English that follows \"because\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth dejó de leer este documento porque %@."
          }
        }
      }
    },
    "TextMouth stopped the braille translation because %@." : {
      "comment" : "Why a braille translation ended. %@ is the reason, a clause such as \"an earlier call was abandoned\", which stays English until the engine's sentences convert.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth detuvo la traducción a braille porque %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ha interrotto la traduzione braille perché %@."
