    "The transcript's text didn't read back as one chapter per chapter of the book." : {
      "comment" : "Error shown when the text written from a transcript did not have one chapter for each chapter of the audiobook."
    },
    "The transcript's times don't fit together, so TextMouth can't use it." : {
      "comment" : "Error shown when an attached transcript file's times are out of order or inconsistent."
    },
    "The transcript, with your changes, stays with the episode in its feed, even after its download is deleted. Deleting the episode or feed deletes it; Move to Library keeps it as a book." : {
      "comment" : "Note under a podcast episode's transcript editor and cleanup sheet. Move to Library is the name of a command in the feed's episode menu."
