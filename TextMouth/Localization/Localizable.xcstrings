    "libraryViewsSettings.restoreCustomHint" : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). Restore Default…'s hint for a view the listener made, when it is dimmed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "العرض الذي أنشأته ليس له إعداد افتراضي لاستعادته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আপনার তৈরি ভিউয়ের পুনরুদ্ধার করার মতো কোনো ডিফল্ট নেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Für eine selbst erstellte Ansicht gibt es keinen Standard zum Wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A view you made has no default to restore."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una vista que creaste no tiene un valor predeterminado que restaurar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "برای نمایی که شما ساخته‌اید پیش‌فرضی برای بازگرداندن وجود ندارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une vue que vous avez créée n’a pas de valeur par défaut à restaurer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לתצוגה שיצרת אין ברירת מחדל לשחזור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आपके बनाए दृश्य का कोई डिफ़ॉल्ट नहीं है जिसे पुनर्स्थापित किया जाए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tampilan buatan Anda tidak memiliki default untuk dipulihkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una vista creata da te non ha un’impostazione predefinita da ripristinare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "自分で作成したビューには、復元するデフォルトがありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "직접 만든 보기에는 복원할 기본값이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Een weergave die je zelf hebt gemaakt, heeft geen standaardwaarde om te herstellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Widok utworzony samodzielnie nie ma wersji domyślnej do przywrócenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uma visualização que você criou não tem um padrão a restaurar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "У созданного вами представления нет исходных настроек для восстановления."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En vy som du har skapat har ingen standard att återställa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "มุมมองที่สร้างขึ้นเองไม่มีค่าเริ่มต้นให้คืนค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Oluşturduğunuz bir görünümün geri yüklenecek varsayılanı yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Для створеного вами вигляду немає типового стану для відновлення."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آپ کے بنائے ہوئے منظر کا کوئی ڈیفالٹ نہیں ہے جسے بحال کیا جائے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chế độ xem do bạn tạo không có giá trị mặc định để khôi phục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "自建的视图没有可恢复的默认设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "自己建立的顯示方式沒有可還原的預設值。"
          }
        }
      }
    },
    "libraryViewsSettings.restoreHint" : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). Restore Default…'s hint.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعيد إلى العرض الاسم والشروط والترتيب والحد التي منحها له TextMouth."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ভিউটিকে TextMouth-এর দেওয়া নাম, শর্ত, সাজানো ও সীমা ফিরিয়ে দেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gibt der Ansicht Name, Bedingungen, Sortierung und Limit zurück, die TextMouth ihr gegeben hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gives the view back the name, conditions, sort, and limit TextMouth gave it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Devuelve a la vista el nombre, las condiciones, el orden y el límite que le dio TextMouth."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نام، شرط‌ها، مرتب‌سازی و محدودیتی را که TextMouth به نما داده بود به آن بازمی‌گرداند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rend à la vue le nom, les conditions, le tri et la limite que TextMouth lui avait donnés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מחזיר לתצוגה את השם, התנאים, המיון והמגבלה ש-TextMouth נתן לה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "दृश्य को वही नाम, शर्तें, क्रम और सीमा लौटाता है जो TextMouth ने उसे दी थीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mengembalikan nama, kondisi, urutan, dan batas yang diberikan TextMouth pada tampilan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ridà alla vista il nome, le condizioni, l’ordinamento e il limite che TextMouth le aveva dato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth が付けた名前、条件、並べ替え、制限をビューに戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보기의 이름, 조건, 정렬, 제한을 TextMouth가 정한 값으로 되돌립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Geeft de weergave de naam, voorwaarden, sortering en limiet terug die TextMouth eraan gaf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Przywraca widokowi nazwę, warunki, sortowanie i limit nadane przez TextMouth."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Devolve à visualização o nome, as condições, a ordem e o limite que o TextMouth deu a ela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Возвращает представлению имя, условия, сортировку и ограничение, заданные в TextMouth."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ger vyn tillbaka det namn, de villkor, den sortering och den gräns som TextMouth gav den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "คืนชื่อ เงื่อนไข การเรียงลำดับ และขีดจำกัดที่ TextMouth ตั้งไว้ให้มุมมอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Görünüme TextMouth'un verdiği adı, koşulları, sıralamayı ve sınırı geri verir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Повертає вигляду назву, умови, сортування й обмеження, задані TextMouth."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "منظر کو وہ نام، شرائط، ترتیب اور حد واپس دیتا ہے جو TextMouth نے اسے دی تھی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trả lại cho chế độ xem tên, điều kiện, cách sắp xếp và giới hạn do TextMouth đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "将视图恢复为 TextMouth 原先设定的名称、条件、排序和限制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "將顯示方式的名稱、條件、排序和限制還原為 TextMouth 原先給它的設定。"
          }
        }
      }
    },
    "libraryViewsSettings.restoreMessage" : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). What the question says Restore Default does, and what it keeps.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعود اسمه وشروطه وترتيبه وحده إلى ما وضعه TextMouth. ويبقى موضعه في القائمة ووقت عرضه كما هما."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এর নাম, শর্ত, সাজানো ও সীমা TextMouth-এর নিজস্ব মানে ফিরে যায়। তালিকায় এর জায়গা ও কখন দেখানো হয় তা যেমন আছে তেমনই থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Name, Bedingungen, Sortierung und Limit werden auf die Vorgaben von TextMouth zurückgesetzt. Ihr Platz in der Liste und wann sie angeboten wird, bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its name, conditions, sort, and limit go back to TextMouth's own. Its place in the list and when it is offered stay as they are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Su nombre, condiciones, orden y límite vuelven a los de TextMouth. Su lugar en la lista y cuándo se ofrece permanecen como están."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نام، شرط‌ها، مرتب‌سازی و محدودیت آن به مقادیر خود TextMouth بازمی‌گردد. جای آن در فهرست و زمان ارائه‌ی آن همان‌طور که هست می‌ماند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Son nom, ses conditions, son tri et sa limite redeviennent ceux de TextMouth. Sa place dans la liste et le moment où elle est proposée restent inchangés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "השם, התנאים, המיון והמגבלה שלה חוזרים לאלה של TextMouth. מקומה ברשימה ומתי היא מוצעת נשארים כפי שהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसका नाम, शर्तें, क्रम और सीमा फिर वही हो जाते हैं जो TextMouth ने दिए थे। सूची में इसका स्थान और इसे कब पेश किया जाता है, दोनों जैसे हैं वैसे ही रहते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nama, kondisi, urutan, dan batasnya kembali ke bawaan TextMouth. Tempatnya dalam daftar dan kapan ditawarkan tidak berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il nome, le condizioni, l’ordinamento e il limite tornano a quelli di TextMouth. La sua posizione nell’elenco e il momento in cui viene proposta restano invariati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "名前、条件、並べ替え、制限が TextMouth の初期状態に戻ります。リスト内の位置と表示されるタイミングは、そのまま変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이름, 조건, 정렬, 제한이 TextMouth의 기본값으로 돌아갑니다. 목록에서의 위치와 표시 여부는 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De naam, voorwaarden, sortering en limiet gaan terug naar die van TextMouth. De plaats in de lijst en wanneer de weergave wordt aangeboden, blijven zoals ze zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jego nazwa, warunki, sortowanie i limit wracają do ustawień TextMouth. Jego miejsce na liście i to, kiedy jest oferowany, pozostają bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O nome, as condições, a ordem e o limite voltam aos do TextMouth. A posição dela na lista e quando ela é oferecida permanecem como estão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Его имя, условия, сортировка и ограничение возвращаются к исходным в TextMouth. Его место в списке и то, когда оно предлагается, остаются прежними."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dess namn, villkor, sortering och gräns återgår till TextMouths egna. Dess plats i listan och när den erbjuds ändras inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ชื่อ เงื่อนไข การเรียงลำดับ และขีดจำกัดจะกลับไปเป็นค่าของ TextMouth ส่วนตำแหน่งในรายการและเวลาที่แสดงจะคงเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Adı, koşulları, sıralaması ve sınırı TextMouth'un kendi değerlerine döner. Listedeki yeri ve ne zaman sunulduğu olduğu gibi kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Його назва, умови, сортування та обмеження повертаються до заданих у TextMouth. Місце в списку й те, коли його пропонують, не змінюються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس کا نام، شرائط، ترتیب اور حد پھر سے وہی ہو جاتی ہیں جو TextMouth نے دی تھیں۔ فہرست میں اس کی جگہ اور یہ کب پیش کیا جاتا ہے، دونوں جیسے ہیں ویسے ہی رہتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tên, điều kiện, cách sắp xếp và giới hạn của nó trở về như TextMouth đã đặt. Vị trí của nó trong danh sách và thời điểm nó được hiển thị vẫn giữ nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "其名称、条件、排序和限制会恢复为 TextMouth 自带的设置。它在列表中的位置及何时提供保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "它的名稱、條件、排序和限制會還原為 TextMouth 原有的設定。它在列表中的位置和提供的時機則維持不變。"
          }
        }
      }
    },
    "libraryViewsSettings.restoreNameTaken" : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). What Restore Default says, changing nothing, when another view has the shipped name name (finding 5). Placeholders in order: name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يوجد عرض آخر باسم %@. أعد تسميته أولًا، ثم استعد هذا العرض."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আরেকটি ভিউয়ের নাম %@। আগে সেটির নাম পরিবর্তন করুন, তারপর এই ভিউ পুনরুদ্ধার করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eine andere Ansicht heißt %@. Benenne sie zuerst um und stelle dann diese Ansicht wieder her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another view is named %@. Rename it first, then restore this view."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Otra vista se llama %@. Cámbiale el nombre primero y luego restaura esta vista."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نمای دیگری %@ نام دارد. ابتدا نام آن را تغییر دهید، سپس این نما را بازگردانی کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une autre vue s’appelle %@. Renommez-la d’abord, puis restaurez cette vue."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "תצוגה אחרת נקראת %@. שנה קודם את שמה, ואז שחזר את התצוגה הזו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "किसी अन्य दृश्य का नाम %@ है। पहले उसका नाम बदलें, फिर इस दृश्य को पुनर्स्थापित करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tampilan lain bernama %@. Ganti namanya terlebih dahulu, lalu pulihkan tampilan ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un’altra vista si chiama %@. Rinominala prima, poi ripristina questa vista."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」という名前の別のビューがあります。先にそのビューの名前を変更してから、このビューを復元してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "다른 보기의 이름이 %@입니다. 먼저 해당 보기의 이름을 변경한 다음 이 보기를 복원하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Een andere weergave heet %@. Wijzig eerst de naam ervan en herstel dan deze weergave."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Inny widok nazywa się %@. Najpierw zmień jego nazwę, a potem przywróć ten widok."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
