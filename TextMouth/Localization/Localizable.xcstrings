    "wordDocExportWriter.hint" : {
      "comment" : "The hint of the Convert to picker in the Export dialog while Word 97-2003 is chosen. Word is an app's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مستند Word 97-2003. عناوينه الرئيسية نص عادي، لذا يُغفلها جزء التنقل في Word."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Word 97-2003 নথি। এর হেডিংগুলো সাধারণ টেক্সট, তাই Word-এর নেভিগেশন প্যান সেগুলো বাদ দেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Word-97-2003-Dokument. Seine Überschriften sind einfacher Text, daher lässt der Navigationsbereich von Word sie weg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
