          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il file audio %@ non è del tipo indicato dal suo nome."
          }
        }
      }
    },
    "The audio file “%@” that the edits need is missing from the book." : {
      "comment" : "Said when an audio file that the edits need is missing. %@ is its path inside the book's package.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Audiodatei „%@“, die die Bearbeitungen brauchen, fehlt im Buch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Falta en el libro el archivo de audio “%@” que necesitan las ediciones."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nel libro manca il file audio “%@” necessario alle modifiche."
          }
        }
      }
    },
    "The audio is only in the cloud, not on this Mac yet." : {
      "comment" : "Said when an audio file that the edits need is only in the cloud. A second sentence says to download the book and try again.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Audio ist nur in der Cloud, noch nicht auf diesem Mac."
          }
        },
