        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसे अपने Mac पर जोड़ें, फिर पुस्तक यहाँ भेजें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tambahkan di Mac Anda, lalu kirim bukunya ke sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aggiungilo sul tuo Mac, poi invia qui il libro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mac で追加してから、ブックをここに送ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mac 앱에서 추가한 다음 책을 여기로 보내십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voeg het toe op je Mac en stuur het boek dan hierheen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
