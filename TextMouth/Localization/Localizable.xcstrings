    "speechExport.destinationInKeptChapters" : {
      "comment" : "Why the Export dialog refuses the folder chosen: it is the folder where TextMouth keeps the chapters of a spoken audio export, or inside it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يستطيع التصدير الكتابة في المجلد الذي يحفظ فيه TextMouth الفصول المنطوقة ويفرغه. اختر مجلدًا آخر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "রপ্তানি সেই ফোল্ডারে লিখতে পারে না, যেখানে TextMouth পড়ে শোনানো অধ্যায়গুলো রাখে এবং যা এটি খালি করে দেয়। অন্য একটি ফোল্ডার বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Export kann nicht in den Ordner schreiben, in dem TextMouth gesprochene Kapitel ablegt und den es leert. Wähle einen anderen Ordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export can't write into the folder where TextMouth keeps spoken chapters, which it empties. Choose another folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La exportación no puede escribir en la carpeta donde TextMouth guarda los capítulos hablados, porque la vacía. Elige otra carpeta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صادر کردن نمی‌تواند در پوشه‌ای بنویسد که TextMouth فصل‌های گفته‌شده را در آن نگه می‌دارد و خالی‌اش می‌کند. پوشه‌ای دیگر انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’exportation ne peut pas écrire dans le dossier où TextMouth garde les chapitres lus à voix haute, qu’il vide. Choisissez un autre dossier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הייצוא לא יכול לכתוב לתיקייה שבה TextMouth שומר פרקים מוקראים, והוא מרוקן אותה. בחר תיקייה אחרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "निर्यात उस फ़ोल्डर में नहीं लिख सकता जहाँ TextMouth बोले गए अध्याय रखता है और जिसे वह ख़ाली कर देता है। कोई दूसरा फ़ोल्डर चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ekspor tidak dapat menulis ke folder tempat TextMouth menyimpan bab yang diucapkan, yang dikosongkannya. Pilih folder lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’esportazione non può scrivere nella cartella in cui TextMouth conserva i capitoli letti, che viene svuotata. Scegli un’altra cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth が読み上げた章を保管するフォルダ（中身は空にされます）には書き出せません。別のフォルダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "내보내기는 TextMouth가 음성 챕터를 보관하고 비우는 폴더에 쓸 수 없습니다. 다른 폴더를 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Exporteren naar de map waarin TextMouth uitgesproken hoofdstukken bewaart, is niet mogelijk, want TextMouth maakt die map leeg. Kies een andere map."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eksport nie może zapisywać w folderze, w którym TextMouth przechowuje odczytane rozdziały i który opróżnia. Wybierz inny folder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A exportação não pode gravar na pasta onde o TextMouth guarda os capítulos falados, que ele esvazia. Escolha outra pasta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Экспорт не может записывать в папку, где TextMouth хранит озвученные главы: он её очищает. Выберите другую папку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Det går inte att exportera till mappen där TextMouth sparar upplästa kapitel, eftersom den töms. Välj en annan mapp."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "การส่งออกเขียนลงในโฟลเดอร์ที่ TextMouth เก็บบทที่อ่านออกเสียงไม่ได้ เพราะโฟลเดอร์นั้นจะถูกล้าง เลือกโฟลเดอร์อื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dışa aktarma, TextMouth'un seslendirilen bölümleri tuttuğu ve boşalttığı klasöre yazamaz. Başka bir klasör seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Експорт не може записувати в папку, де TextMouth зберігає озвучені розділи і яку очищає. Виберіть іншу папку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "برآمد اس فولڈر میں نہیں لکھ سکتی جہاں TextMouth بولے گئے ابواب رکھتا ہے اور جسے وہ خالی کر دیتا ہے۔ کوئی دوسرا فولڈر منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không thể xuất vào thư mục nơi TextMouth lưu các chương đã đọc, vì TextMouth làm trống thư mục này. Hãy chọn thư mục khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "导出无法写入 TextMouth 存放朗读章节的文件夹，该文件夹会被清空。请选取其他文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "輸出無法寫入 TextMouth 存放朗讀章節的檔案夾，該檔案夾會被清空。請選擇其他檔案夾。"
          }
        }
      }
    },
