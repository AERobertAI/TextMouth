        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con “%1$@”, Play en un libro terminado avisa que ya está terminado; con “%2$@”, Play lo vuelve a empezar desde el principio."
          }
        }
      }
    },
    "fading out" : {
