    "storageSettings.redoMessage.positions" : {
      "comment" : "Last sentence of the Redo Text Extraction question.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تبقى مواضع القراءة محفوظة، لكن قد تتغير مواضع الأحرف قليلًا إذا تغيّر النص."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পড়ার অবস্থান রাখা হয়, তবে টেক্সট বদলালে অক্ষরের অফসেট সামান্য সরে যেতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lesepositionen bleiben erhalten, aber Zeichenversätze können sich leicht verschieben, wenn sich der Text ändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reading positions are kept, but character offsets may shift slightly if the text changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Las posiciones de lectura se conservan, pero los desplazamientos de caracteres pueden cambiar un poco si cambia el texto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "موقعیت‌های مطالعه حفظ می‌شوند، اما اگر متن تغییر کند، موقعیت نویسه‌ای آن‌ها ممکن است کمی جابه‌جا شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les positions de lecture sont conservées, mais elles peuvent se décaler légèrement si le texte change."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מיקומי הקריאה נשמרים, אך היסטי תווים עשויים לזוז מעט אם הטקסט משתנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पठन स्थितियाँ बनी रहती हैं, पर टेक्स्ट बदलने पर अक्षर ऑफ़सेट थोड़े खिसक सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Posisi baca tetap, tetapi offset karakter dapat bergeser sedikit jika teks berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le posizioni di lettura vengono mantenute, ma gli scostamenti dei caratteri possono spostarsi leggermente se il testo cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "読書位置は保持されますが、テキストが変わると文字位置が少しずれることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "읽기 위치는 유지되지만 텍스트가 바뀌면 문자 오프셋이 약간 달라질 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Leesposities blijven bewaard, maar tekenposities kunnen iets verschuiven als de tekst verandert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pozycje czytania są zachowane, ale jeśli tekst się zmieni, mogą się przesunąć o kilka znaków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "As posições de leitura são mantidas, mas os deslocamentos de caracteres podem mudar um pouco se o texto mudar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Позиции чтения сохраняются, но смещения символов могут немного сдвинуться, если текст изменится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Läspositioner behålls, men teckenpositioner kan förskjutas något om texten ändras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตำแหน่งการอ่านจะคงไว้ แต่ตำแหน่งตัวอักษรอาจเลื่อนเล็กน้อยหากข้อความเปลี่ยน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Okuma konumları korunur ancak metin değişirse karakter ofsetleri biraz kayabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Позиції читання зберігаються, але зсуви символів можуть трохи змінитися, якщо текст зміниться."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مطالعے کی پوزیشنیں برقرار رہتی ہیں، لیکن متن بدلنے پر حروف کے آفسیٹ قدرے بدل سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vị trí đọc được giữ nguyên, nhưng độ lệch ký tự có thể thay đổi đôi chút nếu văn bản thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "阅读位置会保留，但如果文本改变，字符偏移量可能略有移动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "閱讀位置會保留，但如果文字改變，字元偏移量可能會略有位移。"
          }
        }
      }
