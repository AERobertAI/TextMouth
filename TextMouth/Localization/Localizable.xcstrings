          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は「%@」を変換できません。途中で音声のレートまたはチャンネル数が変わり、対応できる範囲を超えています。"
          }
        },
        "ko" : {
