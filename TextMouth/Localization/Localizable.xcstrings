    "textInput.pasteOrTypeInstead" : {
      "comment" : "Second sentence of the announcement when Open in Editor failed: what to do instead.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
