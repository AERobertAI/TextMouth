    },
    "audioEditError.historyInCloud.only" : {
      "comment" : "Said when the audio editor can't open a book: its edit history is only in the cloud. A second sentence says to try again once the book has downloaded.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سجل التعديلات موجود في السحابة فقط، وليس على هذا الـ Mac بعد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সম্পাদনার ইতিহাস শুধু ক্লাউডে আছে, এখনও এই Mac-এ নেই।"
          }
        },
        "de" : {
