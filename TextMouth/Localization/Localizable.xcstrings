    "brailleSettings.caption" : {
      "comment" : "The caption under the code pop-ups in the Braille tab of Settings. BRF, BRL, and PEF are braille file formats.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يقرأ TextMouth ملفات برايل (BRF و BRL و PEF) بهذا الرمز ويصدّر به ما لم يختر مربع حوار التصدير رمزًا آخر. يحتفظ الكتاب بالرمز الذي استُورد به."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ব্রেইল ফাইল (BRF, BRL ও PEF) এই কোড দিয়ে পড়ে এবং রপ্তানির ডায়ালগ অন্য কোড না বেছে নিলে এটি দিয়েই রপ্তানি করে। একটি বই যে কোড দিয়ে আমদানি হয়েছিল সেটিই রাখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth liest Braille-Dateien (BRF, BRL und PEF) mit diesem Code und exportiert damit, sofern der Exportdialog keinen anderen wählt. Ein Buch behält den Code, mit dem es importiert wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
