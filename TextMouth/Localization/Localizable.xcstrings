            "value" : "বইটি ডাউনলোড হলে আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Versuche es erneut, sobald das Buch heruntergeladen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try again once the book has downloaded."
          }
        },
        "es" : {
