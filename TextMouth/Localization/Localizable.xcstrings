        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo passato al motore vocale, dopo le sostituzioni e la protezione del markup, caratteri da %1$@ a %2$@ del testo letto:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O texto entregue ao mecanismo de fala, depois das substituições e da proteção de marcação, caracteres %1$@ a %2$@ do texto falado:"
          }
        }
      }
    },
    "The text of %@" : {
      "comment" : "Names what the export's deep-nesting question is about: a book's whole text, which has no chapter markers. %@ is the book's title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Text von %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto de %@"
