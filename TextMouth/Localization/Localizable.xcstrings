    },
    "The original file “%@” could not be moved to the Trash: %@" : {
      "comment" : "Alert about the original file of an imported book that could not be moved to the Trash. %1$@ is the file's name and %2$@ the reason, a sentence of the system's.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Originaldatei „%1$@“ konnte nicht in den Papierkorb gelegt werden: %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
