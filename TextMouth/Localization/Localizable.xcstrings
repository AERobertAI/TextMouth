          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth यह नहीं जाँच सका कि इसे ट्रैश में भेजना है या नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tidak dapat memeriksa apakah harus memindahkannya ke Tempat Sampah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non ha potuto verificare se spostarlo nel Cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth はゴミ箱に移動するかどうかを確認できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 휴지통으로 이동할지 확인할 수 없었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
