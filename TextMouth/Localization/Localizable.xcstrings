            "value" : "Negli appunti non c’è testo da incollare, quindi il testo non è cambiato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A área de transferência não tem texto para colar, então o texto não mudou."
          }
        }
      }
    },
    "The cloud service" : {
      "comment" : "How a sentence names the cloud service when it is unknown, at the start of the sentence, so it has a capital letter.",
      "localizations" : {
        "de" : {
