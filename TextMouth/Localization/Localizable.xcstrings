          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เสียงของหนังสือเปลี่ยนไปตั้งแต่ถอดเสียง (%@) ข้อความถอดเสียงจึงไม่ตรงกันอีกต่อไป ให้ถอดเสียงอีกครั้ง"
