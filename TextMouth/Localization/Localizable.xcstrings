            "value" : "TextMouth はオーディオファイル%1$@を読み取れません（%2$@）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 오디오 파일 %1$@을(를) 읽을 수 없습니다(%2$@)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kan het audiobestand %@ niet lezen, omdat %@."
          }
        },
        "pl" : {
          "stringUnit" : {
