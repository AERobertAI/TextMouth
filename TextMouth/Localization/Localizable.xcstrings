    "dataDirectoryMove.finishedDespiteCancelSentence" : {
      "comment" : "Sentence added to the done message of a move of the library when Cancel was pressed after the copy was complete.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "كانت النسخة مكتملة بالفعل عند الضغط على إلغاء، لذا استمر النقل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“বাতিল করুন” চাপার সময় কপি আগেই সম্পূর্ণ হয়ে গিয়েছিল, তাই স্থানান্তর এগিয়ে গেছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Kopie war bereits vollständig, als das Abbrechen erfolgte, daher wurde das Verschieben abgeschlossen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The copy was already complete when Cancel was pressed, so the move went ahead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La copia ya estaba completa cuando se pulsó Cancelar, así que el traslado siguió adelante."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هنگام فشردن «لغو»، کپی از قبل کامل بود، بنابراین انتقال انجام شد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La copie était déjà terminée quand vous avez choisi Annuler ; le déplacement a donc eu lieu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "העותק כבר היה שלם כשנלחץ “ביטול”, ולכן ההעברה נמשכה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "रद्द करने तक प्रति पूरी हो चुकी थी, इसलिए स्थानांतरण पूरा कर दिया गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Salinan sudah selesai saat Batal ditekan, jadi pemindahan dilanjutkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La copia era già completa quando è stato premuto Annulla, quindi lo spostamento è proseguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "キャンセルが押されたとき、コピーはすでに完了していたため、移動を続行しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "취소를 눌렀을 때 복사가 이미 완료되어 있어 이동이 계속 진행되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De kopie was al compleet toen Annuleer werd gekozen, dus de verplaatsing is doorgegaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kopia była już kompletna, gdy naciśnięto Anuluj, więc przenoszenie zostało dokończone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A cópia já estava completa quando Cancelar foi pressionado, então a movimentação prosseguiu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Копирование уже завершилось, когда была нажата отмена, поэтому перемещение выполнено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kopian var redan klar när Avbryt valdes, så flytten genomfördes."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "สำเนาเสร็จสมบูรณ์แล้วเมื่อกดยกเลิก การย้ายจึงดำเนินต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vazgeç düğmesine basıldığında kopya zaten tamamlanmıştı; bu yüzden taşıma yine de yapıldı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Копію вже було завершено, коли натиснули «Скасувати», тому переміщення виконано."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“منسوخ کریں” دبانے کے وقت کاپی مکمل ہو چکی تھی، اس لیے منتقلی مکمل ہو گئی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bản sao đã hoàn tất khi nhấn Hủy, nên việc di chuyển vẫn tiếp tục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "按下“取消”时副本已经完成，因此移动继续进行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "按下「取消」時副本已完成，因此移動繼續進行。"
          }
        }
      }
    },
    "dataDirectoryMove.importAnswerRefusal.questions" : {
      "comment" : "First sentence of what an import question says when it is answered while the library is being moved.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يمكن الإجابة عن أسئلة الاستيراد أثناء نقل المكتبة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "লাইব্রেরি স্থানান্তরের সময় আমদানির প্রশ্নের উত্তর দেওয়া যায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Importfragen können nicht beantwortet werden, während die Bibliothek verschoben wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import questions can't be answered while the library is moving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Las preguntas de importación no se pueden responder mientras se mueve la biblioteca."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تا وقتی کتابخانه در حال انتقال است، به پرسش‌های وارد کردن نمی‌توان پاسخ داد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il est impossible de répondre aux questions d’importation pendant le déplacement de la bibliothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא ניתן לענות על שאלות ייבוא בזמן שהספרייה מועברת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लाइब्रेरी स्थानांतरित होने के दौरान आयात के प्रश्नों का उत्तर नहीं दिया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pertanyaan impor tidak dapat dijawab saat pustaka sedang dipindahkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non è possibile rispondere alle domande di importazione mentre la libreria viene spostata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ライブラリの移動中は、読み込みの確認に答えられません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관함을 이동하는 중에는 가져오기 질문에 답할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Importvragen kunnen niet worden beantwoord terwijl de bibliotheek wordt verplaatst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Na pytania dotyczące importu nie można odpowiadać podczas przenoszenia biblioteki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não é possível responder a perguntas de importação enquanto a biblioteca está sendo movida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "На вопросы импорта нельзя ответить, пока библиотека перемещается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Importfrågor kan inte besvaras medan biblioteket flyttas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตอบคำถามการนำเข้าไม่ได้ขณะที่กำลังย้ายไลบรารี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitaplık taşınırken içe aktarma soruları yanıtlanamaz."
          }
