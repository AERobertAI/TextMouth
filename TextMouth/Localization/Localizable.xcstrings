    "libraryComparison.stopHint" : {
      "comment" : "VoiceOver hint of the Stop button of the Compare Libraries sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يوقف المقارنة. لم يتغير أي شيء في أي من النسختين."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "তুলনা বন্ধ করে। কোনো কপিতেই কিছু পরিবর্তন করা হয়নি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppt den Vergleich. In keiner der Kopien wurde etwas geändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops comparing. Nothing in either copy has been changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detiene la comparación. No se ha cambiado nada en ninguna de las copias."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مقایسه را متوقف می‌کند. چیزی در هیچ‌یک از دو نسخه تغییر نکرده است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrête la comparaison. Aucune des copies n’a été modifiée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מפסיק את ההשוואה. אף אחד מהעותקים לא שונה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "तुलना रोकता है। किसी भी कॉपी में कुछ नहीं बदला गया है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menghentikan perbandingan. Tidak ada yang diubah di salinan mana pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe il confronto. Nessuna delle due copie è stata modificata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "比較を停止します。どちらのコピーも変更されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "비교를 중단합니다. 어느 사본도 변경되지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stopt het vergelijken. In geen van beide kopieën is iets gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zatrzymuje porównywanie. Żadna kopia nie została zmieniona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para a comparação. Nada em nenhuma das cópias foi alterado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Останавливает сравнение. В обеих копиях ничего не изменено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Slutar jämföra. Inget i någon av kopiorna har ändrats."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หยุดการเปรียบเทียบ ไม่มีสำเนาใดถูกเปลี่ยนแปลง"
