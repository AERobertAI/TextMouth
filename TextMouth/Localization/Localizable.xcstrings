          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כשלא נותרה אף אחת מהמילים שלהם, %@, כל אחד מהם עובר לאותה נקודה בערך בפרק שלו, או לקטע הקרוב ביותר ששתי הקריאות חולקות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "जहाँ उनका कोई शब्द नहीं बचता, %@, वहाँ हर एक अपने अध्याय में लगभग उसी बिंदु पर जाता है, या उन दोनों रीडिंग के साझा निकटतम अंश पर।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jika kata-katanya tidak tersisa lagi, %@, masing-masing berpindah ke titik yang kira-kira sama di babnya, atau ke bagian terdekat yang ada di kedua pembacaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quando non resta nessuna delle loro parole, %@, ognuno va circa allo stesso punto del suo capitolo, o al passaggio più vicino che le due letture hanno in comune."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "単語が1つも残っていない場合（%@）、それぞれは章内のほぼ同じ位置、または2つの読み込み結果が共有する最も近い箇所に移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 단어가 하나도 남지 않으면 각 항목은 해당 챕터의 거의 같은 지점이나 두 읽기 결과에 공통된 가장 가까운 구절로 이동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Als er geen van hun woorden meer over is, %@, gaat elk naar ongeveer hetzelfde punt in het hoofdstuk, of naar de dichtstbijzijnde passage die de twee leesversies delen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jeśli nie zostało żadne z ich słów, %@, każda pozycja trafia mniej więcej w to samo miejsce rozdziału albo do najbliższego fragmentu wspólnego dla obu odczytów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Onde não resta nenhuma das palavras deles, %@, cada um vai para aproximadamente o mesmo ponto do seu capítulo ou para a passagem mais próxima que as duas leituras compartilham."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Если слов, к которым они привязаны, не осталось, %@, каждая из них переходит примерно в ту же точку своей главы или в ближайший фрагмент, общий для двух прочтений."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Där inget av deras ord finns kvar, %@, går var och en till ungefär samma punkt i sitt kapitel, eller till det närmaste stycke som de två läsningarna delar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หากไม่เหลือคำเดิมของรายการเหล่านั้นเลย %@ แต่ละรายการจะไปที่จุดเดียวกันโดยประมาณในบทของตน หรือไปที่ข้อความช่วงที่ใกล้ที่สุดซึ่งข้อความทั้งสองฉบับมีร่วมกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kelimelerinden hiçbiri kalmadığında, %@, her biri bölümünde yaklaşık aynı noktaya ya da iki metnin ortak olduğu en yakın pasaja gider."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо не залишилося жодного з їхніх слів, %@, кожна з них переходить приблизно на те саме місце в розділі або до найближчого уривка, спільного для старого й нового тексту."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جہاں ان کا کوئی لفظ باقی نہ رہے، %@، ہر ایک اپنے باب میں تقریباً اسی مقام پر، یا دونوں ریڈنگز کے مشترک قریب ترین حصے پر چلا جاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Khi không còn từ nào của chúng, %@, mỗi mục chuyển đến khoảng cùng điểm trong chương của nó, hoặc đến đoạn gần nhất mà cả hai bản văn bản đều có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "若它们的字词都没有保留，%@，则每个位置会移到其章节中大致相同的点，或移到两次阅读共有的最近段落。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "當它們的字詞都不剩時，%@，各自會移到章節中大約相同的位置，或兩種讀取結果共有的最近段落。"
          }
        }
      }
    },
    "textEncoding.popUpHint" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. The pop-up's hint, which VoiceOver says after its label and value.",
