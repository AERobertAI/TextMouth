    "feed.folderInfoHelp" : {
      "comment" : "The line under the folder picker in Feed Info.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اختيار مجلد آخر يعرض حلقات الموجز ومقالاته هناك بدلًا منه، بما فيها التي تم تنزيلها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "অন্য ফোল্ডার বেছে নিলে ফিডের পর্ব ও নিবন্ধ তার বদলে সেখানে তালিকাভুক্ত হয়, আগে ডাউনলোড করাগুলোও।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wählst du einen anderen Ordner, listet der Feed dort stattdessen seine Folgen und Artikel auf, auch bereits heruntergeladene."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choosing another folder lists the feed's episodes and articles there instead, those already downloaded too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Al elegir otra carpeta, se muestran allí los episodios y artículos del canal, incluidos los ya descargados."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "انتخاب پوشه‌ای دیگر، قسمت‌ها و مقاله‌های فید را به جای آن در آنجا فهرست می‌کند، از جمله آن‌هایی که قبلاً بارگیری شده‌اند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisir un autre dossier y répertorie à la place les épisodes et articles du flux, y compris ceux déjà téléchargés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בחירה בתיקייה אחרת מציגה בה במקום זאת את האפיזודות והכתבות של הערוץ, גם אלה שכבר הורדו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "दूसरा फ़ोल्डर चुनने पर फ़ीड के एपिसोड और लेख, पहले से डाउनलोड हुए भी, उसी में सूचीबद्ध होते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Memilih folder lain akan mencantumkan episode dan artikel feed di sana, termasuk yang sudah diunduh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se scegli un’altra cartella, gli episodi e gli articoli del feed verranno elencati lì, compresi quelli già scaricati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "別のフォルダを選択すると、フィードのエピソードと記事（ダウンロード済みのものも含む）がそのフォルダに一覧表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "다른 폴더를 선택하면 피드의 에피소드와 기사를 그 폴더에 나열하며, 이미 다운로드한 항목도 포함됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Als je een andere map kiest, worden de afleveringen en artikelen van de feed daar weergegeven, ook de al gedownloade."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wybranie innego folderu wyświetla tam odcinki i artykuły kanału, także te już pobrane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escolher outra pasta lista nela os episódios e artigos do feed, inclusive os já baixados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Если выбрать другую папку, выпуски и статьи ленты будут показаны в ней, в том числе уже загруженные."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Om du väljer en annan mapp listas flödets avsnitt och artiklar där i stället, även de som redan har hämtats."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "การเลือกโฟลเดอร์อื่นจะแสดงตอนและบทความของฟีดที่นั่นแทน รวมถึงที่ดาวน์โหลดแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Başka bir klasör seçerseniz beslemenin podcast bölümleri ve makaleleri, önceden indirilenler de dahil, artık orada listelenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо вибрати іншу папку, там замість цієї з’являться епізоди й статті стрічки, зокрема вже завантажені."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "دوسرا فولڈر منتخب کرنے سے فیڈ کے ایپی سوڈ اور مضامین اس کے بجائے وہاں درج ہوتے ہیں، وہ بھی جو پہلے ڈاؤن لوڈ ہو چکے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chọn thư mục khác sẽ liệt kê các tập và bài viết của nguồn cấp ở đó, kể cả những mục đã tải về."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "选取其他文件夹后，会改为列出该订阅源在那里的单集和文章，已下载的也包括在内。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選擇其他檔案夾，會改為在該處列出訂閱源的單集與文章，已下載的也一併列出。"
          }
        }
      }
    },
