        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 以此點字碼讀取點字檔案（BRF、BRL 和 PEF），並以此輸出，除非輸出對話框選擇了其他點字碼。每本書都保留其輸入時使用的點字碼。"
          }
        }
      }
