    "feed.useGlobalHint" : {
      "comment" : "VoiceOver hint of the checkbox that makes a feed follow the global setting. %@ is the name of the Feeds tab of Settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عند تحديد الخانة، يتبع هذا الموجز الإعداد الموجود في الإعدادات، %@؛ ألغِ تحديدها ليكون للموجز إعداده الخاص"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "চেক করা থাকলে এই ফিড সেটিংসের %@-এর সেটিং অনুসরণ করে; ফিডকে নিজস্ব সেটিং দিতে চেক তুলে নিতে হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wenn aktiviert, folgt dieser Feed der Einstellung im Tab „%@“ der Einstellungen; deaktiviere die Option, um dem Feed eine eigene zu geben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When checked, this feed follows the setting in Settings, %@; uncheck it to give the feed its own"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si está activado, este canal sigue el ajuste de Ajustes, %@; desactívalo para darle uno propio"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "وقتی علامت زده شود، این فید از تنظیم موجود در تنظیمات، %@، پیروی می‌کند؛ علامت را بردارید تا فید تنظیم خودش را داشته باشد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si la case est cochée, ce flux suit le réglage de l’onglet %@ des Réglages ; décochez-la pour lui donner son propre réglage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כשהאפשרות מסומנת, הערוץ הזה פועל לפי ההגדרה בהגדרות, “%@”; בטל את הסימון כדי לתת לערוץ הגדרה משלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चुना होने पर यह फ़ीड सेटिंग के %@ का पालन करता है; उसे अपनी सेटिंग देने के लिए चुनाव हटाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saat dicentang, feed ini mengikuti pengaturan di Pengaturan, %@; hapus centang untuk memberi feed pengaturan sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se l’opzione è selezionata, questo feed segue l’impostazione in Impostazioni, %@; deselezionala per dargli un’impostazione propria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オンにすると、このフィードは設定の「%@」タブの設定に従います。オフにすると、このフィード独自の設定になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "선택하면 이 피드는 설정의 %@ 설정을 따릅니다. 선택을 해제하면 피드에 자체 설정을 지정할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Als dit is aangevinkt, volgt deze feed de instelling in Instellingen, %@; vink het uit om de feed een eigen instelling te geven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Po zaznaczeniu ten kanał stosuje ustawienie w: Ustawienia, %@; odznacz, aby kanał miał własne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quando marcado, este feed segue o ajuste em Ajustes, %@; desmarque para dar ao feed um ajuste próprio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Если флажок установлен, эта лента следует общей настройке в Настройках, %@; снимите его, чтобы задать ленте собственную."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "När det är markerat följer det här flödet inställningen i Inställningar, %@; avmarkera det för att ge flödet en egen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เมื่อเลือก ฟีดนี้จะใช้ตามการตั้งค่าใน การตั้งค่า แล้วเลือก %@ ยกเลิกการเลือกเพื่อให้ฟีดมีการตั้งค่าของตัวเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "İşaretliyken bu besleme Ayarlar'daki ayarı izler (%@); beslemeye kendine ait bir ayar vermek için işareti kaldırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Коли позначено, ця стрічка дотримується налаштування з вкладки «%@» у налаштуваннях; зніміть позначку, щоб задати для стрічки власне."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جب نشان زد ہو تو یہ فیڈ ترتیبات، %@، کی ترتیب کی پیروی کرتی ہے؛ فیڈ کو اس کی اپنی ترتیب دینے کے لیے نشان ہٹائیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Khi được chọn, nguồn cấp này theo cài đặt trong Cài đặt, %@; bỏ chọn để cho nguồn cấp này cài đặt riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "勾选后，此订阅源会遵循“设置”的“%@”中的设置；取消勾选可为该订阅源设置专属选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "勾選時，此訂閱源會依循「設定」中「%@」的設定；取消勾選即可為訂閱源指定自己的設定。"
          }
        }
      }
    },
    "feed.waitingDownloadCancelled" : {
      "comment" : "What VoiceOver says once Cancel Download took back a download that waited. The first %@ is the title; the second is the name of the Download command.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يعد “%1$@” ينتظر التنزيل؛ سيُنزَّل عندما تختار %2$@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” আর ডাউনলোডের অপেক্ষায় নেই; আপনি %2$@ বেছে নিলে এটি ডাউনলোড হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%1$@“ wartet nicht mehr auf den Download; er startet, wenn du %2$@ wählst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no longer waits to download; it downloads when you choose %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” ya no espera para descargarse; se descargará cuando elijas %2$@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%1$@» دیگر در انتظار بارگیری نیست؛ وقتی %2$@ را انتخاب کنید بارگیری می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "« %1$@ » n’attend plus pour se télécharger ; il se téléchargera quand vous choisirez %2$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” אינו ממתין עוד להורדה; ההורדה תתחיל כשתבחר ב“%2$@”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” अब डाउनलोड के लिए प्रतीक्षा में नहीं है; “%2$@” चुनने पर वह डाउनलोड होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” tidak lagi menunggu untuk diunduh; akan diunduh saat Anda memilih %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” non è più in attesa di download; viene scaricato quando scegli %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%1$@」はダウンロード待ちではなくなりました。%2$@を選択すると、ダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@”은(는) 더 이상 다운로드를 기다리지 않습니다. %2$@을(를) 선택하면 다운로드됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” wacht niet meer om te downloaden; het wordt gedownload wanneer je %2$@ kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pobranie „%1$@” już nie czeka; nastąpi, gdy wybierzesz %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” não aguarda mais o download; ele é baixado quando você escolhe %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Загрузка «%1$@» больше не ожидает; она начнётся, когда вы выберете %2$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "”%1$@” väntar inte längre på att hämtas; den hämtas när du väljer %2$@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” ไม่รอดาวน์โหลดแล้ว จะดาวน์โหลดเมื่อคุณเลือก %2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” artık indirme için beklemiyor; şunu seçtiğinizde indirilir: %2$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%1$@» більше не чекає на завантаження; завантаження почнеться, коли ви виберете «%2$@»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” اب ڈاؤن لوڈ کے انتظار میں نہیں؛ جب آپ %2$@ منتخب کریں گے تو یہ ڈاؤن لوڈ ہو جائے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” không còn chờ tải về nữa; nó sẽ tải về khi bạn chọn %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@”不再等待下载；你选取“%2$@”时才会下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%1$@」不再等待下載；你選擇「%2$@」時會下載。"
          }
        }
      }
    },
