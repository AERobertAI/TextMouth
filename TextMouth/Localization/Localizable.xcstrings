        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Terminado: %@"
          }
        }
      }
    },
    "First in the Sort" : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. A limit's order as its pop-up names it. This is the case .viewSort."
    },
    "Folder" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. The kind a folder's summary names after the folder's name.\nText of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. A kind of test as a condition's test pop-up names it. This is the case .folder."
    },
    "Folder Settings" : {
      "comment" : "Text of the Folder Settings sheet, which shows one library folder's facts and its listening options. The sheet's navigation title (the window's title while it is open)."
    },
    "Folder names stay as you typed them." : {
      "comment" : "Last sentence of the note under the Leading Articles pop-up: folder names are never changed by the setting."
    },
    "Folder or Feed Settings" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Library group and read by VoiceOver. Opens the settings of the folder or feed the Library window shows. Also the title of the menu command of the same name."
    },
    "Folder “%@” in %@ is “%@” in %@." : {
      "comment" : "A difference found by Compare Libraries: the same folder has two paths. %1$@ is its path in this copy, %2$@ is this copy, %3$@ is its path in the other copy, and %4$@ is the other copy.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Folder “%1$@” in %2$@ is “%3$@” in %4$@."
          }
        }
      }
    },
    "Folder “%@” is only in %@." : {
      "comment" : "A difference found by Compare Libraries. %1$@ is a library folder's path and %2$@ is the copy of the library that has it.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Folder “%1$@” is only in %2$@."
          }
        }
      }
    },
    "Folders and the Reading List have no conditions to copy." : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). Duplicate's hint for Folders and the Reading List, when it is dimmed."
    },
    "Folders and the Reading List list what they always have. You can move them, and hide the Reading List." : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. Its hint for Folders and the Reading List, when it is dimmed."
    },
    "Folders is always shown: every folder and feed opens there." : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). The Visibility pop-up's hint for Folders, whose visibility is fixed."
    },
    "For five seconds, the next two key presses are not shortcuts; TextMouth says whether they make a double press." : {
      "comment" : "VoiceOver hint of the Try a Double Press button: for five seconds key presses are not shortcuts, and TextMouth says whether two presses were a double press."
    },
    "Format" : {
      "comment" : "Name of the book information sheet's row that shows an audiobook's file format.\nText of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. A kind of test as a condition's test pop-up names it. This is the case .format."
    },
    "Forward 10 Seconds" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Moves forward ten seconds."
    },
    "Forward Delete" : {
      "comment" : "Name of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Forward Delete\"."
    },
    "Forward One Second" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Moves forward one second."
    },
    "Forward a Tenth of a Second" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Moves forward a tenth of a second."
