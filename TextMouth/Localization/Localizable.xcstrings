    "opmlImportSummary.sentence.they" : {
      "comment" : "What the Import OPML sheet says of several new feeds whose addresses use plain http, which is not encrypted. %@ is a list of their titles.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تستخدم %@ بروتوكول http العادي، لذا يمكن للآخرين قراءة ما ترسله أو تغييره؛ ومع ذلك يحمّلها TextMouth."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ সাধারণ http ব্যবহার করে, তাই অন্যরা সেগুলোর পাঠানো তথ্য পড়তে বা বদলাতে পারে; TextMouth তবুও সেগুলো লোড করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ verwenden unverschlüsseltes http, daher können andere mitlesen oder ändern, was sie senden. TextMouth lädt sie trotzdem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ use plain http, so others can read or change what they send; TextMouth still loads it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ usan http sin cifrar, así que otras personas pueden leer o cambiar lo que envían; TextMouth los carga de todos modos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ از http ساده استفاده می‌کنند، پس دیگران می‌توانند آنچه را می‌فرستند بخوانند یا تغییر دهند؛ TextMouth باز هم آن‌ها را بارگیری می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ utilisent http non chiffré, donc d’autres peuvent lire ou modifier ce qu’ils envoient ; TextMouth les charge quand même."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ משתמשים ב-http רגיל, כך שאחרים יכולים לקרוא או לשנות את מה שהם שולחים; TextMouth עדיין טוען אותם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ सादे http का उपयोग करते हैं, इसलिए दूसरे लोग उनका भेजा हुआ पढ़ या बदल सकते हैं; TextMouth फिर भी उसे लोड करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ memakai http biasa, sehingga orang lain dapat membaca atau mengubah apa yang dikirimnya; TextMouth tetap memuatnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ usano http non protetto, quindi altri possono leggere o modificare ciò che inviano; TextMouth li carica comunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@は暗号化されていない http を使用しているため、送信内容を第三者が読んだり変更したりできます。TextMouth はそれでも読み込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@은(는) 암호화되지 않은 http를 사용하므로 보내는 내용을 다른 사람이 읽거나 바꿀 수 있습니다. 그래도 TextMouth는 불러옵니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ gebruiken gewoon http, dus anderen kunnen meelezen of wijzigen wat ze versturen; TextMouth laadt ze toch."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ używają zwykłego http, więc inne osoby mogą odczytać lub zmienić to, co wysyłają; TextMouth mimo to je wczytuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ usam http simples, então outras pessoas podem ler ou alterar o que enviam; o TextMouth ainda assim os carrega."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ используют обычный http, поэтому другие могут прочитать или изменить передаваемые данные; TextMouth всё равно загружает их."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ använder vanlig http, så andra kan läsa eller ändra det som skickas; TextMouth läser in dem ändå."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ใช้ http ธรรมดา ผู้อื่นจึงอ่านหรือเปลี่ยนข้อมูลที่ส่งได้ แต่ TextMouth ยังโหลดฟีดเหล่านี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ şifrelenmemiş http kullanıyor, bu yüzden gönderdikleri veriler başkalarınca okunabilir veya değiştirilebilir; TextMouth yine de bunları yükler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Стрічки %@ використовують звичайний http, тож інші можуть читати або змінювати те, що вони надсилають; TextMouth усе одно їх завантажує."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ سادہ http استعمال کرتے ہیں، اس لیے دوسرے ان کا بھیجا ہوا مواد پڑھ یا بدل سکتے ہیں؛ پھر بھی TextMouth انہیں لوڈ کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ dùng http thuần, nên người khác có thể đọc hoặc thay đổi những gì chúng gửi; TextMouth vẫn tải các nguồn này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 使用普通 http，其他人可能读取或更改它们发送的内容；TextMouth 仍会加载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 使用純 http，因此其他人可能讀取或更改它們傳送的內容；TextMouth 仍會載入。"
          }
        }
      }
    },
    "opmlReadError.message.damaged" : {
      "comment" : "Why an OPML file of subscriptions could not be imported: its markup is damaged. The first %@ is the line number of the fault, an identifier written without digit grouping. The second is a short technical reason in English, from the parser, kept English as detail for a bug report.",
