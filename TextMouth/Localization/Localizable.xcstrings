    "speechExport.kept.chapter" : {
      "comment" : "What the Export dialog says after a spoken audio export ended without its file and kept its only chapter.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم الاحتفاظ بالفصل المنطوق حتى يُنهى TextMouth، أو يبدأ تصدير صوتي منطوق مختلف، أو يتغير صوت الكتاب أو نصه أو بدائله أو وقفاته. لإنشاء الملف الصوتي منه، صدّر النطاق نفسه بالسرعة وطبقة الصوت نفسيهما."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পড়ে শোনানো অধ্যায়টি রাখা হয়েছে, যতক্ষণ না TextMouth বন্ধ হয়, অন্য একটি পড়ে শোনানো অডিও রপ্তানি শুরু হয়, বা বইয়ের ভয়েস, টেক্সট, প্রতিস্থাপন বা বিরতি বদলায়। এটি থেকে অডিও ফাইল বানাতে একই গতি ও পিচে একই পরিসর রপ্তানি করুন।"
          }
        },
        "de" : {
