    "epubExportWriter.hint" : {
      "comment" : "The hint of the Convert to picker in the Export dialog while EPUB is chosen. Apple Books is an app's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "كتاب إلكتروني يضم عناوين الكتاب الرئيسية ومحتوياته وأي أرقام صفحات، لتطبيق Apple Books وتطبيقات القراءة الأخرى. لا يحتوي على صور."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইয়ের হেডিং, সূচি এবং পৃষ্ঠা নম্বরসহ একটি ই-বুক, Apple Books ও অন্যান্য পড়ার অ্যাপের জন্য। এতে কোনো ছবি থাকে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein E-Book mit den Überschriften, dem Inhalt und allen Seitenzahlen des Buchs, für Apple Books und andere Lese-Apps. Es enthält keine Bilder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An e-book with the book's headings, contents, and any page numbers, for Apple Books and other reading apps. It holds no pictures."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un libro electrónico con los encabezados, el índice y los números de página del libro, para Apple Books y otras apps de lectura. No incluye imágenes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یک کتاب الکترونیکی با سرفصل‌ها، فهرست مطالب و شماره صفحه‌های کتاب، برای Apple Books و دیگر برنامه‌های مطالعه. تصویری ندارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un livre numérique avec les en-têtes, la table des matières et les éventuels numéros de page du livre, pour Apple Books et d’autres apps de lecture. Il ne contient aucune image."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ספר אלקטרוני עם כותרות הספר, תוכן העניינים ומספרי העמודים, בשביל Apple Books ואפליקציות קריאה אחרות. הוא לא כולל תמונות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पुस्तक की हेडिंग, विषय-सूची और पृष्ठ संख्याओं (यदि हों) के साथ एक ई-बुक, Apple Books और अन्य रीडिंग ऐप के लिए। इसमें चित्र नहीं होते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E-book berisi tajuk, daftar isi, dan nomor halaman buku, untuk Apple Books dan app baca lainnya. Tanpa gambar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un e-book con le intestazioni, l’indice e gli eventuali numeri di pagina del libro, per l’app Libri di Apple e altre app di lettura. Non contiene immagini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブックの見出し、目次、ページ番号を収めた電子書籍で、Apple Books などの App で読めます。画像は含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "표제, 목차 및 페이지 번호가 있는 전자책으로, Apple Books 및 다른 독서 앱에서 사용할 수 있습니다. 이미지는 포함되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Een e-boek met de koppen, de inhoudsopgave en eventuele paginanummers van het boek, voor Apple Books en andere leesapps. Het bevat geen afbeeldingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E-book z nagłówkami, spisem treści i numerami stron książki, dla aplikacji Apple Books i innych aplikacji do czytania. Nie zawiera obrazów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um e-book com os cabeçalhos, o sumário e os números de página do livro, para o Apple Books e outros apps de leitura. Não contém imagens."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Электронная книга с заголовками, оглавлением и номерами страниц, если они есть, для Apple Books и других приложений для чтения. Без картинок."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En e-bok med bokens rubriker, innehåll och eventuella sidnummer, för Apple Books och andra läsappar. Den innehåller inga bilder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หนังสืออิเล็กทรอนิกส์ที่มีหัวข้อ สารบัญ และเลขหน้าของหนังสือ สำหรับ Apple Books และแอปอ่านอื่น ๆ ไม่มีรูปภาพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitabın başlıklarını, içindekilerini ve varsa sayfa numaralarını içeren, Apple Books ve diğer okuma uygulamaları için bir e-kitap. Resim içermez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Електронна книга із заголовками, змістом і номерами сторінок книги, для Apple Books та інших програм для читання. Без зображень."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب کی سرخیوں، فہرست مضامین اور صفحہ نمبروں (اگر ہوں) کے ساتھ ایک ای بک، Apple Books اور دوسری ریڈنگ ایپس کے لیے۔ اس میں تصاویر شامل نہیں ہوتیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sách điện tử có các đề mục, mục lục và số trang (nếu có) của sách, dành cho Apple Books và các ứng dụng đọc khác. Không có hình ảnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "电子书，包含图书的章节标题、目录和页码（如有），适用于 Apple 图书和其他阅读 App。不含图片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "電子書，含書籍的標題、目錄和頁碼（如有），適用於 Apple Books 和其他閱讀 App。不含圖片。"
          }
        }
      }
    },
