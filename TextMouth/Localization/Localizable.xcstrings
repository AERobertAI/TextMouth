        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ waits for a network without data limits to refresh by itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ espera una red sin límites de datos para actualizarse por sí solo."
