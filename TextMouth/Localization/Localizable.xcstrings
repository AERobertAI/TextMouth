    "Uncontracted" : {
      "comment" : "How a braille table contracts, for a table with no grade that writes every letter out.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sin contracciones"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non contratto"
          }
