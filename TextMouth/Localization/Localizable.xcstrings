    "transcription.editedTranscript" : {
      "comment" : "Line of the Transcribe Audio sheet warning that transcribing again replaces the user's own edits. %@ is a date, such as \"October 5, 2026\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "حرّرت هذه النسخة النصية في %@. يؤدي التفريغ مرة أخرى إلى استبدال تعديلاتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আপনি এই ট্রান্সক্রিপ্ট %@ তারিখে সম্পাদনা করেছেন। আবার ট্রান্সক্রাইব করলে আপনার সম্পাদনা প্রতিস্থাপিত হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du hast dieses Transkript am %@ bearbeitet. Erneutes Transkribieren ersetzt deine Bearbeitungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You edited this transcript on %@. Transcribing again replaces your edits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Editaste esta transcripción el %@. Volver a transcribir reemplaza tus ediciones."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "شما این رونوشت را در %@ ویرایش کردید. رونویسی دوباره ویرایش‌های شما را جایگزین می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vous avez modifié cette transcription le %@. Une nouvelle transcription remplace vos modifications."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ערכת את התמליל הזה בתאריך %@. תמלול חוזר מחליף את העריכות שלך."
