    "transcription.languagePickerHint" : {
      "comment" : "VoiceOver hint of the transcription language pop-up. \"needs download\" is the status word a language's menu item shows when its speech model is not on this Mac, and Transcribe Audio is the command's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحدّد لغة التفريغ. اللغة التي يحمل نموذجها الوصف “يحتاج إلى تنزيل” لا تُنزَّل إلا من ورقة “تفريغ الصوت”."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ট্রান্সক্রিপশনের ভাষা ঠিক করে। “ডাউনলোড দরকার” চিহ্নিত ভাষা শুধু “অডিও ট্রান্সক্রাইব করুন” শিট থেকে ডাউনলোড হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Legt die Transkriptionssprache fest. Eine als „Download nötig“ markierte Sprache lässt sich nur im Sheet „Audio transkribieren“ herunterladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sets the transcription language. A language marked needs download downloads only from the Transcribe Audio sheet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Define el idioma de la transcripción. Si un idioma indica que necesita descarga, solo se descarga desde la hoja Transcribir audio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "زبان رونویسی را تنظیم می‌کند. زبانی که با «نیازمند بارگیری» مشخص شده است فقط از برگه «رونویسی صدا» بارگیری می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Définit la langue de transcription. Une langue marquée « téléchargement requis » ne se télécharge que depuis la feuille Transcrire l’audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "קובע את שפת התמלול. שפה המסומנת “נדרשת הורדה” ניתנת להורדה רק מהגיליון “תמלל שמע”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ट्रांसक्रिप्शन की भाषा सेट करता है। जिस भाषा पर “डाउनलोड आवश्यक” लिखा हो, वह केवल “ऑडियो ट्रांसक्राइब करें” शीट से डाउनलोड होती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mengatur bahasa transkripsi. Bahasa yang ditandai “perlu diunduh” hanya dapat diunduh dari lembar Transkripsikan Audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Imposta la lingua della trascrizione. Una lingua contrassegnata come “da scaricare” si scarica solo dal foglio Trascrivi audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文字起こしの言語を設定します。「ダウンロードが必要」と表示された言語は、「オーディオを文字起こし」のシートからのみダウンロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "대본 언어를 설정합니다. 다운로드 필요로 표시된 언어는 오디오 대본 만들기 시트에서만 다운로드됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stelt de taal voor transcriptie in. Een taal met de status download nodig wordt alleen gedownload via het venster Transcribeer audio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ustawia język transkrybowania. Język oznaczony jako „wymaga pobrania” można pobrać tylko w arkuszu Transkrybuj dźwięk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Define o idioma da transcrição. Um idioma marcado como “precisa ser baixado” só é baixado na folha Transcrever áudio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Задаёт язык расшифровки. Язык со статусом «нужна загрузка» загружается только в листе «Расшифровать аудио»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Anger transkriptionsspråket. Ett språk som är märkt ”behöver hämtas” hämtas bara från arket Transkribera ljud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตั้งภาษาสำหรับการถอดเสียง ภาษาที่ระบุว่า “ต้องดาวน์โหลด” จะดาวน์โหลดได้จากชีต ถอดเสียงจากไฟล์เสียง เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yazıya dökme dilini ayarlar. İndirme gerekli olarak işaretli bir dil yalnızca Sesi Yazıya Dök sayfasından indirilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Задає мову транскрибування. Мова з позначкою «потрібне завантаження» завантажується лише з аркуша «Транскрибувати аудіо»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ٹرانسکرپشن کی زبان منتخب کرتا ہے۔ جس زبان پر “ڈاؤن لوڈ درکار ہے” لکھا ہو وہ صرف “آڈیو ٹرانسکرائب کریں” شیٹ سے ڈاؤن لوڈ ہوتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đặt ngôn ngữ chép lời. Mô hình của ngôn ngữ có ghi chú “cần tải về” chỉ tải về được từ hộp thoại Chép lời âm thanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "设置转录语言。标有“需要下载”的语言只能从“转录音频”下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "設定語音轉文字的語言。標示為「需要下載」的語言，只能在「轉錄音訊」工作表中下載。"
          }
        }
      }
    },
    "transcription.laterVersionSentence" : {
      "comment" : "Sentence in the Transcribe Audio sheet and Book Information saying the book's transcript was written by a newer version of this app, which this version cannot read.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لهذا الكتاب نسخة نصية أنشأها إصدار أحدث من TextMouth."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই বইয়ের ট্রান্সক্রিপ্ট TextMouth-এর একটি নতুন সংস্করণে তৈরি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieses Buch hat ein Transkript, das eine neuere Version von TextMouth erstellt hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This book has a transcript made by a later version of TextMouth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este libro tiene una transcripción hecha por una versión posterior de TextMouth."
          }
        },
