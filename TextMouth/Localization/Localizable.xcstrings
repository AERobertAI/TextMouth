    "libraryIndexRecovery.summary.positions" : {
      "comment" : "Last sentence of the library index recovery sheet: what still works, and what does not until an option is chosen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يمكنك فتح الكتب وقراءتها، وتُحفظ مواضع القراءة مع كل كتاب، لكن تغييرات المكتبة نفسها لا تُحفظ إلى أن تختار أحد الخيارات أدناه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আপনি বই খুলতে ও পড়তে পারেন, এবং পড়ার অবস্থান এখনো প্রতিটি বইয়ের সঙ্গে সংরক্ষিত হয়, কিন্তু নিচের কোনো বিকল্প বেছে না নেওয়া পর্যন্ত লাইব্রেরির নিজের পরিবর্তন সংরক্ষিত হয় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du kannst Bücher öffnen und lesen, und Lesepositionen werden weiterhin mit jedem Buch gesichert, aber Änderungen an der Bibliothek selbst werden erst gesichert, wenn du unten eine der Optionen wählst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can open and read books, and reading positions are still saved with each book, but changes to the library itself are not saved until you choose one of the options below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Puedes abrir y leer libros, y las posiciones de lectura se siguen guardando con cada libro, pero los cambios de la propia biblioteca no se guardan hasta que elijas una de las opciones de abajo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "می‌توانید کتاب‌ها را باز کنید و بخوانید و موقعیت‌های مطالعه هنوز همراه هر کتاب ذخیره می‌شوند، اما تغییرات خود کتابخانه تا وقتی یکی از گزینه‌های زیر را انتخاب نکنید ذخیره نمی‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vous pouvez ouvrir et lire des livres, et les positions de lecture sont toujours enregistrées avec chaque livre, mais les modifications de la bibliothèque elle-même ne sont pas enregistrées tant que vous n’avez pas choisi l’une des options ci-dessous."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אפשר לפתוח ולקרוא ספרים, ומיקומי הקריאה עדיין נשמרים עם כל ספר, אך שינויים בספרייה עצמה לא יישמרו עד לבחירת אחת מהאפשרויות שלהלן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आप पुस्तकें खोल और पढ़ सकते हैं, और पठन स्थितियाँ अब भी हर पुस्तक के साथ सहेजी जाती हैं, लेकिन लाइब्रेरी में हुए बदलाव तब तक सहेजे नहीं जाते जब तक आप नीचे दिए विकल्पों में से कोई एक नहीं चुनते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Anda dapat membuka dan membaca buku, dan posisi baca tetap disimpan di setiap buku, tetapi perubahan pada pustaka itu sendiri tidak disimpan sampai Anda memilih salah satu opsi di bawah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Puoi aprire e leggere i libri, e le posizioni di lettura vengono ancora salvate con ogni libro, ma le modifiche alla libreria stessa non vengono salvate finché non scegli una delle opzioni qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブックを開いて読むことができ、読書位置もブックごとに保存されますが、ライブラリ自体の変更は、下のオプションのいずれかを選択するまで保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책을 열어 읽을 수 있고 읽기 위치도 책마다 계속 저장되지만, 아래 옵션 중 하나를 선택하기 전까지는 보관함 자체의 변경 사항이 저장되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Je kunt boeken openen en lezen en leesposities worden nog steeds bij elk boek bewaard, maar wijzigingen in de bibliotheek zelf worden pas bewaard als je een van de onderstaande opties kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Możesz otwierać i czytać książki, a pozycje czytania nadal są zapisywane z każdą książką, ale zmiany w samej bibliotece nie są zapisywane, dopóki nie wybierzesz jednej z poniższych opcji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Você pode abrir e ler livros, e as posições de leitura ainda são salvas com cada livro, mas as alterações da própria biblioteca não são salvas até você escolher uma das opções abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вы можете открывать и читать книги, позиции чтения по-прежнему сохраняются вместе с каждой книгой, но изменения самой библиотеки не сохраняются, пока вы не выберете один из вариантов ниже."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du kan öppna och läsa böcker, och läspositioner sparas fortfarande med varje bok, men ändringar i själva biblioteket sparas inte förrän du väljer ett av alternativen nedan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เปิดและอ่านหนังสือได้ และตำแหน่งการอ่านยังบันทึกไว้กับหนังสือแต่ละเล่ม แต่การเปลี่ยนแปลงของไลบรารีเองจะไม่ถูกบันทึกจนกว่าจะเลือกหนึ่งในตัวเลือกด้านล่าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitapları açıp okuyabilirsiniz ve okuma konumları hâlâ her kitapla birlikte kaydedilir, ancak kitaplığın kendisinde yapılan değişiklikler aşağıdaki seçeneklerden birini seçene kadar kaydedilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ви можете відкривати й читати книги, а позиції читання, як і раніше, зберігаються з кожною книгою, але зміни самої бібліотеки не зберігаються, доки ви не виберете один із варіантів нижче."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آپ کتابیں کھول اور پڑھ سکتے ہیں، اور مطالعے کی پوزیشنیں اب بھی ہر کتاب کے ساتھ محفوظ ہوتی ہیں، لیکن لائبریری کی اپنی تبدیلیاں اس وقت تک محفوظ نہیں ہوتیں جب تک آپ نیچے دیے گئے اختیارات میں سے کوئی منتخب نہ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bạn có thể mở và đọc sách, và vị trí đọc vẫn được lưu cùng mỗi sách, nhưng các thay đổi của chính thư viện sẽ không được lưu cho đến khi bạn chọn một trong các tùy chọn bên dưới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "你可以打开和阅读图书，阅读位置也仍会随每本图书存储，但在你选取下面的某个选项之前，资料库本身的更改不会被存储。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "你可以打開並閱讀書籍，閱讀位置也仍會與每本書一起儲存，但在你選擇以下其中一個選項之前，不會儲存書庫本身的更改。"
          }
        }
      }
    },
    "libraryIndexRecovery.summary.settings" : {
      "comment" : "First sentence of the library index recovery sheet: what the unreadable file holds.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّرت على TextMouth قراءة فهرس مكتبته، وهو الملف الذي يسجّل مجلداتك وإعدادات الفرز وترتيب كتبك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth তার লাইব্রেরি সূচক পড়তে পারেনি, যে ফাইলে আপনার ফোল্ডার, সাজানোর সেটিংস এবং বইয়ের ক্রম লেখা থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth konnte den Bibliotheksindex nicht lesen, die Datei mit deinen Ordnern, Sortiereinstellungen und der Reihenfolge deiner Bücher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth could not read its library index, the file that records your folders, sort settings, and the order of your books."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no pudo leer el índice de la biblioteca, el archivo que guarda tus carpetas, los ajustes de orden y el orden de tus libros."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth نتوانست نمایه‌ی کتابخانه خود را بخواند، فایلی که پوشه‌ها، تنظیمات مرتب‌سازی و ترتیب کتاب‌های شما را ثبت می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth n’a pas pu lire l’index de sa bibliothèque, le fichier qui enregistre vos dossiers, vos réglages de tri et l’ordre de vos livres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth לא הצליח לקרוא את אינדקס הספרייה שלו, הקובץ ששומר את התיקיות, הגדרות המיון וסדר הספרים שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth अपना लाइब्रेरी इंडेक्स नहीं पढ़ सका, वह फ़ाइल जिसमें आपके फ़ोल्डर, क्रम सेटिंग और पुस्तकों का क्रम दर्ज रहता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tidak dapat membaca indeks pustakanya, file yang mencatat folder, pengaturan urutan, dan urutan buku Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non ha potuto leggere l’indice della libreria, il file che registra le tue cartelle, le impostazioni di ordinamento e l’ordine dei tuoi libri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth はライブラリインデックス（フォルダ、並べ替えの設定、ブックの順序を記録するファイル）を読み取れませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 폴더, 정렬 설정, 책 순서를 기록하는 파일인 보관함 색인을 읽을 수 없었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kon de bibliotheekindex niet lezen, het bestand dat je mappen, sorteerinstellingen en de volgorde van je boeken bijhoudt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth nie mógł odczytać indeksu biblioteki, czyli pliku, który zapisuje Twoje foldery, ustawienia sortowania i kolejność książek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não conseguiu ler o índice da biblioteca, o arquivo que registra suas pastas, seus ajustes de ordenação e a ordem dos seus livros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не удалось прочитать индекс библиотеки — файл, в котором записаны ваши папки, настройки сортировки и порядок книг."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kunde inte läsa sitt biblioteksindex, filen som lagrar dina mappar, sorteringsinställningar och böckernas ordning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth อ่านดัชนีไลบรารีไม่ได้ ซึ่งเป็นไฟล์ที่บันทึกโฟลเดอร์ การตั้งค่าการเรียงลำดับ และลำดับหนังสือของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth, klasörlerinizi, sıralama ayarlarınızı ve kitaplarınızın sırasını kaydeden dosya olan kitaplık dizinini okuyamadı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не вдалося прочитати індекс бібліотеки — файл, у якому записано ваші папки, параметри сортування й порядок книг."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth اپنا لائبریری انڈیکس نہیں پڑھ سکا، وہ فائل جس میں آپ کے فولڈرز، ترتیب دینے کی ترتیبات اور کتابوں کی ترتیب درج ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth không đọc được chỉ mục thư viện, tệp ghi lại các thư mục, cài đặt sắp xếp và thứ tự sách của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 无法读取其资料库索引，该文件记录了你的文件夹、排序设置和图书的顺序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 無法讀取它的書庫索引，也就是記錄你的檔案夾、排序設定和書籍順序的檔案。"
          }
        }
      }
    },
    "libraryIndexRecovery.summary.temporary" : {
      "comment" : "Second sentence of the library index recovery sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعرض المكتبة الآن قائمة مؤقتة أُعيد بناؤها من الكتب الموجودة على القرص."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "লাইব্রেরি এখন ডিস্কের বই থেকে পুনর্নির্মিত একটি অস্থায়ী তালিকা দেখাচ্ছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Bibliothek zeigt jetzt eine vorläufige Liste, die aus den Büchern auf dem Datenträger neu aufgebaut wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The library now shows a temporary list rebuilt from the books on disk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La biblioteca ahora muestra una lista temporal reconstruida a partir de los libros del disco."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتابخانه اکنون فهرستی موقت را نشان می‌دهد که از کتاب‌های روی دیسک بازسازی شده است."
          }
        },
        "fr" : {
          "stringUnit" : {
