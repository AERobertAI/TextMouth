    "common.thereIsAFileAtValue" : {
      "comment" : "First sentence of why the chosen location can't be used: a file is there. %@ is the path.\nWhy the library can't be used: a file sits where the library's folder should be. %@ is the path.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
