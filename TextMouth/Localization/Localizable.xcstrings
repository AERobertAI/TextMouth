    "While TextMouth was copying its data, %@ was changed to lead to %@ instead of %@." : {
      "comment" : "First sentence of why a move of the data directory did not finish: the new location's link was changed while the data was copied. %1$@ is the link's path; %2$@ is where it leads now; %3$@ is where it led before.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Während TextMouth seine Daten kopierte, wurde %1$@ so geändert, dass es zu %2$@ statt zu %3$@ führt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "While TextMouth was copying its data, %1$@ was changed to lead to %2$@ instead of %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mientras TextMouth copiaba sus datos, %1$@ se cambió para llevar a %2$@ en lugar de %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pendant que TextMouth copiait ses données, %1$@ a été modifié pour mener à %2$@ au lieu de %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mentre TextMouth copiava i suoi dati, %@ è stato modificato in modo da portare a %@ invece che a %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Enquanto o TextMouth copiava os dados, %1$@ foi alterado para levar a %2$@ em vez de %3$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Пока TextMouth копировал данные, %1$@ был изменён: теперь он ведёт в %2$@ вместо %3$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Поки TextMouth копіював свої дані, %1$@ змінили так, що воно веде до %2$@ замість %3$@."
