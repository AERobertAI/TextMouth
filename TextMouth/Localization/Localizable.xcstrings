    "speechExport.pitchHint" : {
      "comment" : "The hint of the Pitch slider in the Export dialog's spoken audio options.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مدى ارتفاع طبقة الصوت في الملف. تبدأ بطبقة صوت الكتاب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফাইলে ভয়েস কত উঁচু শোনায়। এটি বইয়ের পিচ থেকে শুরু হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wie hoch die Stimme in der Datei klingt. Voreingestellt ist die Tonhöhe des Buchs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How high the voice sounds in the file. It starts at the book's pitch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Qué tan aguda suena la voz en el archivo. Empieza con el tono del libro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "زیر و بمی صدا در فایل. از زیر و بمی کتاب شروع می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hauteur de la voix dans le fichier. Elle part de la hauteur du livre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כמה גבוה הקול נשמע בקובץ. מתחיל בגובה הצליל של הספר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ाइल में आवाज़ कितनी ऊँची लगती है। यह पुस्तक की पिच से शुरू होती है।"
          }
        },
        "id" : {
