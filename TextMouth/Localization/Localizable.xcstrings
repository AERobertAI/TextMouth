    },
    "There's no library in %@ to use, and none to move there while the library isn't available." : {
      "comment" : "First sentence of why the chosen folder can't be used: it holds no library and there is none to move. %@ is the folder's path.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا توجد مكتبة في %@ لاستخدامها، ولا مكتبة لنقلها إليه بينما المكتبة غير متاحة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@-এ ব্যবহারের মতো কোনো লাইব্রেরি নেই, আর লাইব্রেরি উপলব্ধ না থাকায় সেখানে সরানোর মতোও কিছু নেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "In %@ gibt es keine Bibliothek zu verwenden, und es gibt keine zum Verschieben dorthin, solange die Bibliothek nicht verfügbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay ninguna biblioteca en %@ que usar, ni ninguna que trasladar allí mientras la biblioteca no está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il n’y a pas de bibliothèque à utiliser dans %@, ni de bibliothèque à y déplacer tant que la bibliothèque n’est pas disponible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ में उपयोग करने के लिए कोई लाइब्रेरी नहीं है, और लाइब्रेरी के उपलब्ध न होने पर वहाँ ले जाने के लिए भी कोई नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tidak ada pustaka di %@ untuk dipakai, dan tidak ada yang dapat dipindahkan ke sana selama pustaka tidak tersedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "In %@ non c’è nessuna libreria da usare, e non ce n’è nessuna da spostare lì mentre la libreria non è disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@には使用できるライブラリがなく、ライブラリが利用できない間は移動するものもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@에는 사용할 보관함이 없고, 보관함을 사용할 수 없는 동안에는 그곳으로 옮길 보관함도 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não há biblioteca em %@ para usar, nem uma para mover para lá enquanto a biblioteca não está disponível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В %@ нет библиотеки, которую можно использовать, и нет той, которую можно туда переместить, пока библиотека недоступна."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "У %@ немає бібліотеки для використання, і немає чого туди переміщувати, поки бібліотека недоступна."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 中没有可使用的资料库，而在资料库不可用时也没有可移到那里的资料库。"
          }
        }
      }
    },
    "There's nothing to redo." : {
      "comment" : "Said by the audio editor's Redo when nothing has been undone.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا شيء لإعادته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es gibt nichts zu wiederholen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay nada que rehacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il n’y a rien à rétablir."
          }
