    "settings.continueNextExplanation" : {
      "comment" : "Explanation under the When book ends pop-up in the Playback settings. %@ is the title of the pop-up's choice that plays the next book, as the pop-up shows it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يشغّل “%@” الكتاب التالي في المجلد نفسه بحسب ترتيب الفرز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” একই ফোল্ডারের পরের বইটি সাজানোর ক্রম অনুযায়ী চালায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%@“ gibt das nächste Buch im selben Ordner nach der Sortierreihenfolge wieder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" plays the next book in the same folder by sort order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” reproduce el siguiente libro de la misma carpeta, en orden de clasificación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%@» کتاب بعدی را در همان پوشه، بر اساس ترتیب مرتب‌سازی، پخش می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "« %@ » lit le livre suivant du même dossier, selon l’ordre de tri."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” מנגן את הספר הבא באותה תיקייה לפי סדר המיון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” क्रमबद्ध क्रम में उसी फ़ोल्डर की अगली पुस्तक चलाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” memutar buku berikutnya di folder yang sama berdasarkan urutan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” riproduce il libro successivo nella stessa cartella, in base all’ordinamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」を選ぶと、並べ替えの順で同じフォルダ内の次のブックを再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” 선택 시 같은 폴더에서 정렬 순서상 다음 책을 재생합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” speelt het volgende boek in dezelfde map af, in de sorteervolgorde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%@” odtwarza następną książkę w tym samym folderze według kolejności sortowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” reproduz o próximo livro da mesma pasta, conforme a ordenação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%@» воспроизводит следующую книгу в той же папке по порядку сортировки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "”%@” spelar upp nästa bok i samma mapp i sorteringsordning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” จะเล่นหนังสือเล่มถัดไปในโฟลเดอร์เดียวกันตามลำดับการจัดเรียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@”, aynı klasördeki sonraki kitabı sıralama düzenine göre oynatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%@» відтворює наступну книгу в тій самій папці за порядком сортування."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” اسی فولڈر میں ترتیب کے مطابق اگلی کتاب چلاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” phát sách tiếp theo trong cùng thư mục theo thứ tự sắp xếp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@”会按排序顺序播放同一文件夹中的下一本图书。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」會依排序順序播放同一檔案夾中的下一本書。"
          }
        }
      }
    },
    "settings.defaultPitchExplanation" : {
      "comment" : "Explanation under the default pitch slider in the Voice settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "طبقة الصوت الافتراضية للكتب الجديدة. القيمة 1.0 هي الطبيعية. يمكن لكل كتاب تجاوزها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "নতুন বইয়ের ডিফল্ট পিচ। 1.0 হলো স্বাভাবিক। প্রতিটি বই এটি নিজের মতো বদলাতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Standard-Tonhöhe für neue Bücher. 1,0 ist normal. Jedes Buch kann sie überschreiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Default pitch for new books. 1.0 is normal. Each book can override this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tono predeterminado para libros nuevos. 1.0 es normal. Cada libro puede cambiarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "زیر و بمی پیش‌فرض برای کتاب‌های جدید. 1.0 عادی است. هر کتاب می‌تواند آن را تغییر دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hauteur par défaut pour les nouveaux livres. 1,0 est la valeur normale. Chaque livre peut la remplacer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "גובה צליל ברירת מחדל לספרים חדשים. 1.0 הוא רגיל. כל ספר יכול לעקוף זאת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "नई पुस्तकों के लिए डिफ़ॉल्ट पिच। 1.0 सामान्य है। हर पुस्तक इसे बदल सकती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nada default untuk buku baru. 1.0 adalah normal. Setiap buku dapat menggantinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tono predefinito per i nuovi libri. 1,0 è normale. Ogni libro può sostituirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "新しいブックのデフォルトのピッチです。1.0 が標準です。ブックごとに上書きできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "새 책의 기본 음높이입니다. 1.0이 보통입니다. 책마다 이 값을 변경할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Standaardtoonhoogte voor nieuwe boeken. 1,0 is normaal. Elk boek kan hiervan afwijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Domyślna wysokość głosu dla nowych książek. 1,0 oznacza normalną. Każda książka może ją zastąpić własną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tom padrão para livros novos. 1,0 é o normal. Cada livro pode substituí-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Высота тона по умолчанию для новых книг. 1,0 — обычная. Для каждой книги можно задать свою."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Standardtonhöjd för nya böcker. 1.0 är normalt. Varje bok kan åsidosätta den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ความสูงต่ำของเสียงเริ่มต้นสำหรับหนังสือใหม่ 1.0 คือปกติ หนังสือแต่ละเล่มกำหนดค่าเองได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yeni kitaplar için varsayılan perde. 1,0 normaldir. Her kitap bunu geçersiz kılabilir."
