    "libraryFolderPicker.cancelNewFolderHint" : {
      "comment" : "Hint of the button, in a folder chooser, that closes the new folder's fields: the folder chosen in the pop-up stays chosen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يغلق حقول المجلد الجديد ويُبقي المجلد المحدد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "নতুন ফোল্ডারের ঘর বন্ধ করে এবং বেছে নেওয়া ফোল্ডার রাখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Schließt die Felder des neuen Ordners und behält den gewählten Ordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closes the new folder's fields and keeps the folder chosen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cierra los campos de la carpeta nueva y conserva la carpeta elegida."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فیلدهای پوشه‌ی جدید را می‌بندد و پوشه‌ی انتخاب‌شده را نگه می‌دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ferme les champs du nouveau dossier et conserve le dossier choisi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "סוגר את שדות התיקייה החדשה ומשאיר את התיקייה שנבחרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "नए फ़ोल्डर के फ़ील्ड बंद करता है और चुना हुआ फ़ोल्डर रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menutup kolom folder baru dan mempertahankan folder yang dipilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chiude i campi della nuova cartella e mantiene la cartella scelta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "新規フォルダの入力欄を閉じ、選択したフォルダはそのままにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "새 폴더 입력란을 닫고 선택한 폴더를 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sluit de velden voor de nieuwe map en behoudt de gekozen map."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zamyka pola nowego folderu i zachowuje wybrany folder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fecha os campos da nova pasta e mantém a pasta escolhida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Закрывает поля новой папки и сохраняет выбранную папку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stänger fälten för den nya mappen och behåller den valda mappen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ปิดช่องของโฟลเดอร์ใหม่และคงโฟลเดอร์ที่เลือกไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yeni klasörün alanlarını kapatır ve seçili klasörü korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Закриває поля нової папки й залишає вибрану папку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نئے فولڈر کے خانے بند کرتا ہے اور منتخب کردہ فولڈر برقرار رکھتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đóng các trường thư mục mới và giữ thư mục đã chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "关闭新建文件夹的字段，并保留所选文件夹。"
          }
