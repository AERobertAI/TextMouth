            "value" : "El libro no tiene un paquete para guardar su texto."
          }
        }
      }
    },
    "The book has no timed transcript to write as captions." : {
      "comment" : "Why a book's captions could not be exported, after the file's name in a failure sentence.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El libro no tiene ninguna transcripción con tiempos que escribir como subtítulos."
