    },
    "The book is open in a reader. Close it, then save again." : {
      "comment" : "Said when saving the edited audio is refused because a reader has the book open and plays the file the save would replace."
    },
    "The book's audio holds edits its history lost, so they stay, to save or undo next time you edit this book." : {
      "comment" : "Said when the audio editor's Discard can't reach the audio as it was saved: the edits stay."
    },
    "The books are in %@." : {
