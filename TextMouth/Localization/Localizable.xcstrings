          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kies hoe je %@ uit de bibliotheek wilt weghalen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wybierz, jak usunąć z biblioteki: %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
