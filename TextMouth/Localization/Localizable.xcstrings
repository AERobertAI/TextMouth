    "bookManifestEdit.noManifest" : {
      "comment" : "Message when the user asks to edit the manifest of a book that is not an audiobook of tracks. %@ is the book's title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ليس كتابًا صوتيًا من مقاطع، لذا ليس فيه ملف بيان لتحريره."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ট্র্যাকের অডিওবুক নয়, তাই সম্পাদনার মতো কোনো ম্যানিফেস্ট নেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ist kein Hörbuch aus Tracks und hat daher kein Manifest zum Bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ isn't an audiobook of tracks, so it has no manifest to edit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no es un audiolibro de pistas, así que no tiene manifiesto para editar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ کتاب صوتی متشکل از تراک نیست، بنابراین مانیفستی برای ویرایش ندارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ n’est pas un livre audio composé de pistes, il n’a donc aucun manifeste à modifier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ אינו ספר שמע המורכב מרצועות, ולכן אין בו מניפסט לעריכה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ट्रैक वाली ऑडियोबुक नहीं है, इसलिए संपादित करने के लिए उसका कोई मैनिफ़ेस्ट नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ bukan buku audio berisi trek, sehingga tidak memiliki manifes untuk diedit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ non è un audiolibro di tracce, quindi non ha un manifest da modificare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@はトラックで構成されたオーディオブックではないため、編集するマニフェストがありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@은(는) 트랙으로 이루어진 오디오북이 아니므로 편집할 매니페스트가 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ is geen luisterboek met tracks, dus er is geen manifest om te wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ nie jest audiobookiem złożonym ze ścieżek, więc nie ma manifestu do edycji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ não é um audiolivro de faixas, portanto não tem manifesto para editar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%@» — не аудиокнига из дорожек, поэтому у неё нет манифеста для изменения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ är ingen ljudbok med spår, så det finns inget manifest att redigera."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ไม่ใช่หนังสือเสียงที่แบ่งเป็นแทร็ก จึงไม่มีแมนิเฟสต์ให้แก้ไข"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ parçalardan oluşan bir sesli kitap değil, bu yüzden düzenlenecek bir manifesti yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ — не аудіокнига з доріжками, тому в ній немає маніфесту для редагування."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ٹریکس پر مشتمل آڈیو بک نہیں ہے، اس لیے اس میں ترمیم کے لیے کوئی مینی فیسٹ نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ không phải là sách nói gồm các bản âm thanh, nên không có tệp kê khai để sửa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 不是由音轨组成的有声书，因此没有可编辑的清单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 不是由音軌組成的有聲書，因此沒有可編輯的資訊清單。"
          }
        }
      }
    },
    "bookManifestEdit.notTaken" : {
      "comment" : "Announcement after an edited manifest.json was refused. %1$@ is the reason, a whole sentence in English that names what is wrong inside the file and may stay in English; %2$@ is the book's title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يُحدَّث ملف البيان: %1$@ أصلح ذلك في محررك ثم احفظ مرة أخرى، وإلى ذلك الحين يحتفظ %2$@ بعناوينه الرئيسية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ম্যানিফেস্ট হালনাগাদ হয়নি: %1$@ আপনার এডিটরে ঠিক করে আবার সংরক্ষণ করুন; তার আগে পর্যন্ত %2$@ তার হেডিং রাখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Manifest nicht aktualisiert: %1$@ Korrigiere es in deinem Editor und sichere erneut; bis dahin behält %2$@ seine Überschriften."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manifest not updated: %@ Fix it in your editor and save again; until then, %@ keeps its headings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Manifiesto no actualizado: %1$@ Corrígelo en tu editor y guarda de nuevo; hasta entonces, %2$@ conserva sus encabezados."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مانیفست به‌روزرسانی نشد: %1$@ آن را در ویرایشگر خود اصلاح کنید و دوباره ذخیره کنید؛ تا آن زمان %2$@ سرفصل‌های خود را نگه می‌دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Manifeste non mis à jour : %@ Corrigez-le dans votre éditeur et enregistrez à nouveau ; d’ici là, %@ conserve ses en-têtes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "המניפסט לא עודכן: %1$@ תקן אותו בעורך ושמור שוב; עד אז הכותרות של %2$@ נשארות כפי שהן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "मैनिफ़ेस्ट अपडेट नहीं हुआ: %1$@ इसे अपने एडिटर में ठीक करें और फिर से सहेजें; तब तक %2$@ अपनी हेडिंग बनाए रखती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Manifes tidak diperbarui: %1$@ Perbaiki di editor Anda dan simpan lagi; sampai saat itu, %2$@ tetap memakai tajuknya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Manifest non aggiornato: %@ Correggilo nel tuo editor e salva di nuovo; fino ad allora, %@ conserva le sue intestazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "マニフェストは更新されませんでした：%1$@ エディタで修正してから、もう一度保存してください。それまで、%2$@は見出しを維持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "매니페스트가 업데이트되지 않음: %1$@ 편집기에서 수정한 다음 다시 저장하십시오. 그때까지 %2$@은(는) 표제를 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Manifest niet bijgewerkt: %@ Los het op in je editor en bewaar opnieuw; tot die tijd behoudt %@ zijn koppen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Manifest nie został zaktualizowany: %1$@ Popraw go w edytorze i zachowaj ponownie; do tego czasu %2$@ zachowuje swoje nagłówki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Manifesto não atualizado: %1$@ Corrija-o no seu editor e salve de novo; até lá, %2$@ mantém seus cabeçalhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Манифест не обновлён: %1$@ Исправьте его в редакторе и сохраните снова; до тех пор у «%2$@» остаются прежние заголовки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Manifestet uppdaterades inte: %@ Rätta det i din redigerare och spara igen; tills dess behåller %@ sina rubriker."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ยังไม่ได้อัปเดตแมนิเฟสต์: %1$@ แก้ไขในตัวแก้ไขของคุณแล้วบันทึกอีกครั้ง ระหว่างนี้ %2$@ จะยังคงหัวข้อเดิมไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Manifest güncellenmedi: %1$@ Düzenleyicinizde düzeltip yeniden kaydedin; o zamana kadar %2$@ kitabı başlıklarını korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Маніфест не оновлено: %1$@ Виправте його в редакторі й збережіть знову; до того часу «%2$@» зберігає свої заголовки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مینی فیسٹ اپ ڈیٹ نہیں ہوا: %1$@ اسے اپنے ایڈیٹر میں درست کر کے دوبارہ محفوظ کریں؛ تب تک %2$@ کی سرخیاں جوں کی توں رہیں گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chưa cập nhật tệp kê khai: %1$@ Hãy sửa trong trình soạn thảo của bạn rồi lưu lại; cho đến lúc đó, %2$@ giữ nguyên các đề mục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "清单未更新：%1$@ 请在编辑器中修正后再次存储；在此之前，%2$@ 保持其章节标题不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "資訊清單未更新：%1$@ 請在編輯器中修正後再次儲存；在此之前，%2$@ 會保留原有標題。"
          }
        }
      }
    },
