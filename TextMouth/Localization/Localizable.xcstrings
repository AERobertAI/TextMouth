    "feed.deleteFeedRefused.indexNotWritten" : {
      "comment" : "Why Delete Feed did nothing: the library could not be saved first. %@ is the feed's title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّر على TextMouth حفظ المكتبة قبل حذف الموجز “%@”، لذا لم يُحذف شيء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth “%@” ফিড মোছার আগে লাইব্রেরি সংরক্ষণ করতে পারেনি, তাই কিছুই মোছা হয়নি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth konnte die Bibliothek vor dem Löschen des Feeds „%@“ nicht sichern, daher wurde nichts gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth couldn't save the library before deleting the feed “%@”, so nothing was deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no pudo guardar la biblioteca antes de eliminar el canal “%@”, así que no se eliminó nada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth پیش از حذف فید «%@» نتوانست کتابخانه را ذخیره کند، پس چیزی حذف نشد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth n’a pas pu enregistrer la bibliothèque avant de supprimer le flux « %@ », donc rien n’a été supprimé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth לא הצליח לשמור את הספרייה לפני מחיקת הערוץ “%@”, ולכן דבר לא נמחק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ीड “%@” को मिटाने से पहले TextMouth लाइब्रेरी नहीं सहेज सका, इसलिए कुछ भी नहीं मिटाया गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tidak dapat menyimpan pustaka sebelum menghapus feed “%@”, jadi tidak ada yang dihapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non ha potuto salvare la libreria prima di eliminare il feed “%@”, quindi non è stato eliminato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth はフィード「%@」を削除する前にライブラリを保存できなかったため、何も削除されませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 피드 “%@”을(를) 삭제하기 전에 보관함을 저장하지 못해 아무것도 삭제하지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kon de bibliotheek niet bewaren voordat de feed “%@” werd verwijderd, dus er is niets verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth nie zdołał zapisać biblioteki przed usunięciem kanału „%@”, więc nic nie zostało usunięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não conseguiu salvar a biblioteca antes de excluir o feed “%@”, então nada foi excluído."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не смог сохранить библиотеку перед удалением ленты «%@», поэтому ничего не удалено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
