          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth đang đọc lại văn bản của thư viện. Hãy thử lại khi xong."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 正在重新读取资料库的文本。请在其完成后重试。"
