                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Aún comparando: %lld segundos hasta ahora. Pulsa Escape para detener."
                }
              }
            }
          }
        },
        "it" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Confronto ancora in corso: %lld di secondi finora. Premi Esc per interrompere."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Confronto ancora in corso: %lld secondo finora. Premi Esc per interrompere."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Confronto ancora in corso: %lld secondi finora. Premi Esc per interrompere."
                }
              }
            }
          }
        }
      }
    },
    "Still downloading, %@ elapsed." : {
      "comment" : "Spoken every so often while a download shows no percentage. %@ is the time waited, spoken, such as \"1 minute, 5 seconds\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aún se está descargando, %@ transcurridos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Download ancora in corso, tempo trascorso: %@."
          }
        }
      }
    },
    "Still finding the pauses. Try again in a moment." : {
      "comment" : "Said when a pause command is used in the audio editor while the pauses are still being found.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Pausen werden noch gesucht. Versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aún se están buscando las pausas. Inténtalo de nuevo en un momento."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sto ancora cercando le pause. Riprova tra un momento."
          }
        }
      }
    },
    "Still starting: %@" : {
      "comment" : "VoiceOver announcement when Play is pressed while the next book is still opening. %@ is the next book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aún iniciando: %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ancora in avvio: %@"
          }
        }
      }
    },
    "Still working on the last change." : {
      "comment" : "Said when an audio editor command would change the audio while another change, a save, or an export is under way.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die letzte Änderung wird noch bearbeitet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aún se está procesando el último cambio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sto ancora elaborando l’ultima modifica."
          }
        }
      }
    },
    "Still working. Close once the change is done." : {
      "comment" : "Said when the audio editor's window can't close because a change, save, or export is under way.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wird noch bearbeitet. Schließe, sobald die Änderung abgeschlossen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aún en proceso. Cierra cuando termine el cambio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elaborazione in corso. Chiudi quando la modifica è finita."
          }
        }
      }
    },
    "Stop" : {
      "comment" : "A choice of the Reading List's When a book ends pop-up button: when a book opened from the list ends, stop there.\nA choice of the When a Book Ends picker: the book stops at its end, finished. Play then says it is finished.\nA choice of the pop-up button that sets what happens when an item ends: stop when it ends.\nButton of the Compare Libraries sheet that stops the comparison.\nName of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Stop\".\nName of a keyboard shortcut action, listed in Settings in the Record window group and read by VoiceOver. Stops the recording.\nName of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Stops playback in the audio editor.\nThe button in the Export dialog that stops an export under way.\nTitle of the button in the Record window that stops recording and saves it.\nTitle of the button that stops a running search in the Search Library window.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detener"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompi"
          }
        }
      }
    },
    "Stop At" : {
      "comment" : "Heading of the sleep timer sheet's section of timers that stop at a place in the book: End of heading and End of book.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detener en"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompi a"
          }
        }
      }
    },
    "Stop Comparing" : {
      "comment" : "Button in Storage settings that stops the comparison made before Use This Library.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detener comparación"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompi confronto"
          }
        }
      }
    },
    "Stop Keeping %lld Books on This Mac" : {
      "comment" : "Library menu command that stops keeping the selected books' files downloaded on this Mac. %lld is the number of books selected.",
      "localizations" : {
        "en" : {
