        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth заново читает текст библиотеки. Повторите попытку, когда это закончится."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth знову читає текст бібліотеки. Повторіть спробу, коли це завершиться."
          }
        },
        "zh-Hans" : {
