    "Reset to Normal Speed" : {
      "comment" : "Button of an audiobook's own settings sheet that sets its speed back to normal."
    },
    "Reset to default location" : {
      "comment" : "VoiceOver label of the Reset to Default button in Storage settings."
    },
    "Reset to global end-of-book setting" : {
      "comment" : "What VoiceOver calls the button that removes the book's own end of book choice."
    },
    "Reset to normal audio speed" : {
      "comment" : "What VoiceOver calls the button that sets an audiobook's speed back to normal."
