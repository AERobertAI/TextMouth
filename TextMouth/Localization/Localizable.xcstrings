            "value" : "Dem aus %@ umgewandelten Audio konnte kein Name gegeben werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo poner nombre al audio convertido de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’audio converti à partir de %@ n’a pas pu recevoir son nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non è stato possibile dare il suo nome all’audio convertito da %@."
