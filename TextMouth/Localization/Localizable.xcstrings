    },
    "The book's audio as it was before its first edit, which TextMouth keeps while the Original audio setting does." : {
      "comment" : "The hint of the Original audio checkbox in the Export dialog. \"Original audio\" is the name of a setting.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
