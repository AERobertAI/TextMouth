          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Direktori saat ini akan disimpan sebagai data pemulihan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La cartella attuale verrà conservata come dati di ripristino."
