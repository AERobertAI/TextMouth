    "transcription.transcriptInCloud" : {
      "comment" : "Line of the Transcribe Audio sheet when the book's transcript file has not been downloaded from iCloud to this Mac.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "النسخة النصية موجودة في iCloud فقط، لذا يتركها TextMouth. نزّل الكتاب ثم حاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ট্রান্সক্রিপ্ট শুধু iCloud-এ আছে, তাই TextMouth সেটিতে হাত দেয় না। বইটি ডাউনলোড করুন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript ist nur in iCloud, daher lässt TextMouth es unverändert. Lade das Buch herunter und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The transcript is only in iCloud, so TextMouth leaves it. Download the book, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcripción solo está en iCloud, así que TextMouth no la toca. Descarga el libro y vuelve a intentarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "رونوشت فقط در iCloud است، پس TextMouth به آن دست نمی‌زند. کتاب را بارگیری کنید، سپس دوباره تلاش کنید."
