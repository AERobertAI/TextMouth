          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このフィードのフォルダは、ライブラリにありません。別のフォルダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 피드의 폴더가 더 이상 보관함에 없습니다. 다른 폴더를 선택하십시오."
