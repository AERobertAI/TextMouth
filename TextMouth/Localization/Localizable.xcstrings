      }
    },
    "phoneImport.downloadFailed" : {
      "comment" : "What VoiceOver says when a file's download from iCloud stalled and the import was cancelled. %@ is the file's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّر تنزيل “%@” من iCloud. تحقق من الاتصال، ثم أضفه مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” iCloud থেকে ডাউনলোড করা যায়নি। সংযোগ পরীক্ষা করুন, তারপর আবার যোগ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%@“ konnte nicht aus iCloud heruntergeladen werden. Prüfe die Verbindung und füge die Datei dann erneut hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” couldn't be downloaded from iCloud. Check the connection, then add it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo descargar “%@” desde iCloud. Comprueba la conexión y vuelve a agregarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%@» از iCloud بارگیری نشد. اتصال را بررسی کنید، سپس دوباره آن را اضافه کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "« %@ » n’a pas pu être téléchargé depuis iCloud. Vérifiez la connexion, puis ajoutez-le de nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא ניתן היה להוריד את “%@” מ-iCloud. בדוק את החיבור, ואז הוסף אותו שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
