          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth %1$@ (%2$@)-এর লাইব্রেরি ব্যবহার বন্ধ করবে এবং তার বদলে %3$@-এর লাইব্রেরি খুলবে।"
