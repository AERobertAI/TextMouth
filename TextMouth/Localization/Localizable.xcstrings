        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लाइब्रेरी की पहचान फ़ाइल इस Mac पर है, लेकिन उसका इंडेक्स, %1$@, %2$@ से अभी नहीं आया है।"
