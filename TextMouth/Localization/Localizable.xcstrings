    "Your copy of the rules is empty. Edit Rules… opens it to add some." : {
      "comment" : "Line of the Clean Up Transcript sheet when the user's own rules file holds no rule. Edit Rules… is the name of a button of the sheet.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نسختك من القواعد فارغة. يفتحها “تحرير القواعد…” لإضافة بعضها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deine Kopie der Regeln ist leer. „Regeln bearbeiten…“ öffnet sie, damit du welche hinzufügst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tu copia de las reglas está vacía. Editar reglas… la abre para agregar algunas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Votre copie des règles est vide. Modifier les règles… l’ouvre pour en ajouter."
          }
        },
        "hi" : {
          "stringUnit" : {
