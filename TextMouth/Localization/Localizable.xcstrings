    "removalPreferences.trashPreference.permanently" : {
      "comment" : "Second sentence of the hint of the setting that moves deleted files to the Trash: what happens with the setting off.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عند الإيقاف، تُحذف ملفاته نهائيًا ولا يمكن استردادها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বন্ধ থাকলে এর ফাইল স্থায়ীভাবে মুছে যায় এবং পুনরুদ্ধার করা যায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wenn ausgeschaltet, werden die Dateien endgültig gelöscht und lassen sich nicht wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, its files are deleted permanently and cannot be recovered."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si está desactivado, sus archivos se eliminan de forma permanente y no se pueden recuperar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "وقتی خاموش باشد، فایل‌های آن برای همیشه حذف می‌شوند و قابل بازیابی نیستند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si désactivé, ses fichiers sont supprimés définitivement et ne peuvent pas être récupérés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כשכבוי, הקבצים שלו נמחקים לצמיתות ואי אפשר לשחזר אותם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "बंद होने पर, इसकी फ़ाइलें स्थायी रूप से मिटा दी जाती हैं और वापस नहीं पाई जा सकतीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saat nonaktif, file-nya dihapus secara permanen dan tidak dapat dipulihkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se disattivata, i file del libro vengono eliminati definitivamente e non possono essere recuperati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オフにすると、ファイルは完全に削除され、復元できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "꺼져 있으면 파일이 영구 삭제되며 복구할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Als dit uitstaat, worden de bestanden definitief verwijderd en kunnen ze niet worden hersteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gdy ta opcja jest wyłączona, pliki są trwale usuwane i nie można ich odzyskać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quando desativado, os arquivos são excluídos permanentemente e não podem ser recuperados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Если выключено, файлы удаляются навсегда, и их нельзя восстановить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "När den är avstängd raderas filerna permanent och kan inte återställas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เมื่อปิด ไฟล์ของหนังสือจะถูกลบอย่างถาวรและกู้คืนไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kapalıyken dosyaları kalıcı olarak silinir ve kurtarılamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо вимкнено, файли видаляються остаточно й не підлягають відновленню."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آف ہونے پر اس کی فائلیں مستقل طور پر حذف ہو جاتی ہیں اور بحال نہیں کی جا سکتیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Khi tắt, các tệp bị xóa vĩnh viễn và không thể khôi phục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "关闭后，其文件会被永久删除且无法恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "關閉時，檔案會被永久刪除且無法復原。"
          }
        }
      }
    },
    "removalPreferences.trashPreference.recover" : {
      "comment" : "First sentence of the hint of the setting that moves deleted files to the Trash: what happens with the setting on.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عند التشغيل، تذهب ملفات الكتاب المحذوف إلى سلة المهملات، حيث يمكنك استردادها إلى أن تُفرَّغ السلة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "চালু থাকলে মুছে ফেলা বইয়ের ফাইল ট্র্যাশে যায়, যেখানে ট্র্যাশ খালি করার আগ পর্যন্ত আপনি সেগুলো পুনরুদ্ধার করতে পারেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wenn eingeschaltet, kommen die Dateien eines gelöschten Buchs in den Papierkorb, wo du sie bis zum Leeren des Papierkorbs wiederherstellen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, a deleted book's files go to the Trash, where you can recover them until the Trash is emptied."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si está activado, los archivos de un libro eliminado van a la Papelera, donde puedes recuperarlos hasta que se vacíe."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "وقتی روشن باشد، فایل‌های کتاب حذف‌شده به سطل زباله می‌روند، جایی که تا خالی شدن سطل می‌توانید آن‌ها را بازیابی کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si activé, les fichiers d’un livre supprimé vont dans la corbeille, où vous pouvez les récupérer jusqu’à ce qu’elle soit vidée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כשמופעל, קבצי ספר שנמחק עוברים לאשפה, ואפשר לשחזר אותם עד שהאשפה מתרוקנת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चालू होने पर, मिटाई गई पुस्तक की फ़ाइलें ट्रैश में चली जाती हैं, जहाँ ट्रैश खाली होने तक आप उन्हें वापस पा सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saat aktif, file buku yang dihapus dipindahkan ke Tempat Sampah, tempat Anda dapat memulihkannya sampai Tempat Sampah dikosongkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se attiva, i file di un libro eliminato vanno nel Cestino, dove puoi recuperarli finché il Cestino non viene svuotato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オンにすると、削除したブックのファイルはゴミ箱に入り、ゴミ箱を空にするまで復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "켜져 있으면 삭제한 책의 파일이 휴지통으로 이동되며, 휴지통을 비우기 전까지 복구할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Als dit aanstaat, gaan de bestanden van een verwijderd boek naar de prullenmand, waar je ze kunt herstellen totdat de prullenmand is geleegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gdy ta opcja jest włączona, pliki usuniętej książki trafiają do kosza, skąd można je odzyskać do czasu opróżnienia kosza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quando ativado, os arquivos de um livro excluído vão para a Lixeira, onde você pode recuperá-los até que ela seja esvaziada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Если включено, файлы удалённой книги перемещаются в Корзину, откуда их можно восстановить, пока Корзина не очищена."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "När den är på läggs en raderad boks filer i papperskorgen, där du kan återställa dem tills papperskorgen töms."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เมื่อเปิด ไฟล์ของหนังสือที่ลบจะไปที่ถังขยะ ซึ่งกู้คืนได้จนกว่าจะล้างถังขยะ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Açıkken silinen bir kitabın dosyaları, Çöp Sepeti boşaltılana kadar kurtarabileceğiniz Çöp Sepetine gider."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо увімкнено, файли видаленої книги потрапляють до Кошика, де їх можна відновити, доки Кошик не очищено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آن ہونے پر حذف کی گئی کتاب کی فائلیں ٹریش میں چلی جاتی ہیں، جہاں سے آپ انہیں ٹریش خالی ہونے تک بحال کر سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Khi bật, tệp của sách đã xóa được chuyển vào Thùng rác, nơi bạn có thể khôi phục cho đến khi Thùng rác được dọn sạch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "开启后，已删除图书的文件会移到废纸篓，在清倒废纸篓之前你都可以恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "開啟時，已刪除書籍的檔案會移到垃圾桶，在清空垃圾桶之前都可以復原。"
          }
        }
      }
    },
    "repeatedSymbolStyle.optionTitle.leaveOut" : {
