          }
        }
      }
    },
    "mediaControls.notHeld" : {
      "comment" : "Announcement when Release Media Controls is chosen in a window whose book does not hold the media controls, so nothing changed. It begins like the announcement Media controls released, so the two are told apart from their first words.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يتم التخلي عن عناصر التحكم في الوسائط: هذا الكتاب لا يحتفظ بها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "মিডিয়া নিয়ন্ত্রণ ছেড়ে দেওয়া হয়নি: এই বই সেগুলো ধরে রাখেনি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mediensteuerung nicht freigegeben: Dieses Buch hat sie nicht belegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Media controls not released: this book does not hold them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Controles multimedia no liberados: este libro no los tiene."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کنترل‌های رسانه آزاد نشدند: این کتاب آن‌ها را در اختیار ندارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Commandes multimédias non libérées : ce livre ne les détient pas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "פקדי המדיה לא שוחררו: הספר הזה לא מחזיק בהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कोई मीडिया कंट्रोल नहीं छोड़ा गया: यह पुस्तक उन्हें नहीं रखती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kontrol media tidak dilepaskan: buku ini tidak memegangnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Controlli multimediali non rilasciati: questo libro non li detiene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "メディアコントロールを解放しませんでした：このブックは保持していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "미디어 컨트롤이 해제되지 않음: 이 책은 미디어 컨트롤을 가지고 있지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mediabediening niet vrijgegeven: dit boek heeft ze niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie zwolniono elementów sterowania multimediami: ta książka ich nie kontroluje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Controles de mídia não liberados: este livro não os possui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Медиаклавиши не освобождены: эта книга их не удерживает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mediekontrollerna släpptes inte: den här boken har dem inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไม่ได้ปล่อยตัวควบคุมสื่อ: หนังสือเล่มนี้ไม่ได้ใช้ตัวควบคุมสื่ออยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Medya denetimleri bırakılmadı: bu kitap onları tutmuyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Керування медіа не звільнено: ця книга його не утримує."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "میڈیا کنٹرولز نہیں چھوڑے گئے: یہ کتاب انہیں نہیں رکھتی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chưa trả lại điều khiển phương tiện: sách này không giữ chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "未释放媒体控制：此图书未持有它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "未釋放媒體控制：這本書沒有持有它們。"
          }
        }
      }
    },
