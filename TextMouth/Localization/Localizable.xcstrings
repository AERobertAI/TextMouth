    "audioEditingSettings.ffmpegHint" : {
      "comment" : "Hint of the Use ffmpeg for filters switch in Storage settings. %@ is the folder path where the ffmpeg program was found. ffmpeg is the program's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "موجود في %@. عند تفعيله، تعمل مرشحات المحرر عبر ffmpeg، بكل المرشحات المتاحة فيه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@-এ পাওয়া গেছে। চালু থাকলে এডিটরের ফিল্টার ffmpeg দিয়ে চলে, এর প্রতিটি ফিল্টারসহ।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gefunden unter %@. Wenn aktiviert, laufen die Filter des Editors über ffmpeg, mit allen Filtern, die es hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Found at %@. When on, the editor's filters run through ffmpeg, with every filter it has."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se encontró en %@. Si está activado, los filtros del editor se ejecutan con ffmpeg, con todos los filtros que tiene."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "در %@ پیدا شد. وقتی روشن است، فیلترهای ویرایشگر با همه فیلترهایی که ffmpeg دارد، از طریق آن اجرا می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trouvé à %@. Si l’option est activée, les filtres de l’éditeur passent par ffmpeg, avec tous ses filtres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "נמצא ב-%@. כשהאפשרות פועלת, המסננים של העורך רצים דרך ffmpeg, עם כל המסננים שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ पर मिला। चालू होने पर, एडिटर के फ़िल्टर ffmpeg से चलते हैं, उसके सभी फ़िल्टर के साथ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ditemukan di %@. Jika aktif, filter editor dijalankan melalui ffmpeg, dengan setiap filter yang dimilikinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trovato in %@. Se attivo, i filtri dell’editor passano da ffmpeg, con tutti i suoi filtri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "場所：%@。オンにすると、エディタのフィルタは ffmpeg で実行され、ffmpeg のすべてのフィルタを使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@에 있습니다. 켜면 편집기의 필터가 ffmpeg을 통해 실행되며, ffmpeg의 모든 필터를 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gevonden op %@. Als dit aanstaat, lopen de filters van de editor via ffmpeg, met alle filters die het heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Znaleziono w: %@. Gdy ta opcja jest włączona, filtry edytora działają przez ffmpeg, ze wszystkimi jego filtrami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Encontrado em %@. Quando ativado, os filtros do editor são executados pelo ffmpeg, com todos os filtros dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Найден в %@. Если включено, фильтры редактора выполняются через ffmpeg со всеми его фильтрами."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hittades i %@. När det är på körs redigerarens filter via ffmpeg, med alla filter som den har."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "พบที่ %@ เมื่อเปิด ตัวกรองของตัวแก้ไขจะทำงานผ่าน ffmpeg พร้อมตัวกรองทุกตัวที่มี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ konumunda bulundu. Açıkken düzenleyicinin filtreleri, ffmpeg'in sahip olduğu tüm filtrelerle ffmpeg üzerinden çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Знайдено в %@. Якщо увімкнено, фільтри редактора працюють через ffmpeg, з усіма його фільтрами."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ پر ملا۔ آن ہو تو ایڈیٹر کے فلٹرز ffmpeg کے ذریعے چلتے ہیں، اس کے ہر فلٹر کے ساتھ۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tìm thấy tại %@. Khi bật, các bộ lọc của trình sửa âm thanh chạy qua ffmpeg, với mọi bộ lọc mà ffmpeg có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "位于 %@。打开后，编辑器的滤波器会通过 ffmpeg 运行，可使用其全部滤波器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "位於 %@。開啟時，編輯器的濾波器會透過 ffmpeg 執行，並可使用它的所有濾波器。"
          }
        }
      }
    },
