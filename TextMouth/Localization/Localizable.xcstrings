        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’episodio esce dall’elenco per sempre; il libro in cui è diventato nella tua libreria resta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O episódio sai da lista de vez; o livro em que ele se tornou na sua biblioteca permanece."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Выпуск навсегда исчезает из списка; книга, в которую он превратился в вашей библиотеке, остаётся."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Епізод остаточно зникає зі списку; книга, якою він став у вашій бібліотеці, залишається."
          }
        }
      }
    },
    "The existing copy's files are deleted permanently and cannot be recovered." : {
      "comment" : "Part of the question asked about a duplicate book: where the library's copy goes when replaced and files are deleted permanently.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Dateien der vorhandenen Kopie werden endgültig gelöscht und lassen sich nicht wiederherstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los archivos de la copia existente se eliminan de forma permanente y no se pueden recuperar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les fichiers de la copie existante sont supprimés définitivement et ne peuvent pas être récupérés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I file della copia esistente vengono eliminati definitivamente e non possono essere recuperati."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Os arquivos da cópia existente são excluídos permanentemente e não podem ser recuperados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файлы существующей копии удаляются безвозвратно, восстановить их будет нельзя."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файли наявної копії видаляються назавжди, відновити їх неможливо."
          }
        }
      }
    },
    "The existing copy's files go to the Trash, but putting them back won't return that copy to your library." : {
      "comment" : "Part of the question asked about a duplicate book: where the library's copy goes when replaced and files go to the Trash.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Dateien der vorhandenen Kopie kommen in den Papierkorb, aber ein Zurücklegen bringt diese Kopie nicht in deine Bibliothek zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los archivos de la copia existente van a la Papelera, pero volver a colocarlos no devolverá esa copia a tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les fichiers de la copie existante vont dans la corbeille, mais les remettre ne ramènera pas cette copie dans votre bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I file della copia esistente vanno nel Cestino, ma rimetterli a posto non riporterà quella copia nella tua libreria."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Os arquivos da cópia existente vão para a Lixeira, mas recolocá-los não devolverá essa cópia à sua biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файлы существующей копии перемещаются в Корзину, но если вернуть их оттуда, эта копия в вашу библиотеку не вернётся."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файли наявної копії потрапляють до Кошика, але їх повернення не поверне цю копію до вашої бібліотеки."
          }
        }
      }
    },
    "The export was stopped before the rest." : {
      "comment" : "A sentence of what an export says once it ends: it was stopped after it wrote some items.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Export wurde vor dem Rest gestoppt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La exportación se detuvo antes de terminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’exportation a été arrêtée avant le reste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’esportazione è stata interrotta prima del resto."
          }
