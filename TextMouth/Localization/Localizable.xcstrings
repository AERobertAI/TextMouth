    "shortcutRefusal.notOnePressWithCommandOrControl" : {
      "comment" : "The reason, said after \"not recorded\", why a keyboard shortcut cannot be a menu command's or a button's: it must be one press of a key held with Command or Control. Lower case, since it follows a colon.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اختصار أمر القائمة هو ضغطة واحدة على مفتاح مع Command أو Control"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "মেনু কমান্ডের শর্টকাট হলো কমান্ড বা কন্ট্রোল-সহ একটি কী একবার চাপা"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "der Kurzbefehl eines Menübefehls ist ein einzelner Tastendruck mit Befehl oder Control"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "a menu command's shortcut is one press of a key with Command or Control"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "el atajo de un comando de menú es una sola pulsación de una tecla con Comando o Control"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "میان‌بر فرمان منو یک بار فشردن کلیدی همراه با Command یا Control است"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "le raccourci d’une commande de menu est un seul appui sur une touche avec Commande ou Contrôle"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הקיצור של פקודת תפריט הוא לחיצה אחת על מקש עם Command או Control"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "मेनू कमांड का शॉर्टकट कमांड या कंट्रोल के साथ एक कुंजी का एक बार दबाना होता है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "pintasan perintah menu adalah satu penekanan tombol bersama Command atau Control"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "la scorciatoia di una voce di menu è la pressione di un tasto con Comando o Control"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "メニューコマンドのショートカットは、コマンドまたはコントロールを押しながらキーを1回押すものです"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "메뉴 명령의 단축키는 Command 또는 Control과 함께 누르는 키 한 번이어야 합니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "het toetsenbordcommando van een menuonderdeel is één druk op een toets met Command of Control"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "skrót polecenia menu to jedno naciśnięcie klawisza z Command lub Control"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "o atalho de um comando de menu é um único pressionamento de uma tecla com Comando ou Controle"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "сочетание команды меню — это одно нажатие клавиши вместе с Command или Control"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ett menykommandos genväg är ett tryck på en tangent med Kommando eller Control"
