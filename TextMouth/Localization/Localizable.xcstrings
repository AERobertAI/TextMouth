    },
    "TextMouth couldn't save its list of this feed's downloads, so the download was kept. Try again once the library can be saved." : {
      "comment" : "Why a feed episode's download could not be deleted: the list of the feed's downloads could not be saved.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth konnte seine Liste der Downloads dieses Feeds nicht sichern, daher blieb der Download erhalten. Versuche es erneut, sobald die Bibliothek gesichert werden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no pudo guardar su lista de las descargas de este canal, así que se conservó la descarga. Inténtalo de nuevo cuando se pueda guardar la biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth n’a pas pu enregistrer sa liste des téléchargements de ce flux, donc le téléchargement a été conservé. Réessayez quand la bibliothèque pourra être enregistrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non ha potuto salvare il suo elenco dei download di questo feed, quindi il download è stato conservato. Riprova quando la libreria potrà essere salvata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não conseguiu salvar a lista de downloads deste feed, então o download foi mantido. Tente novamente quando a biblioteca puder ser salva."
          }
        }
      }
    },
