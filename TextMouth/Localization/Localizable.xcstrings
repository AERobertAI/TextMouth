    "storageSettings.redoMessage.extracts" : {
      "comment" : "First sentence of the Redo Text Extraction question.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعيد هذا استخراج النص المخزّن مؤقتًا لكل كتاب، وقد يستغرق ذلك بعض الوقت في مكتبة كبيرة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এটি প্রতিটি বইয়ের ক্যাশ করা টেক্সট আবার নিষ্কাশন করে, যা বড় লাইব্রেরির ক্ষেত্রে কিছুটা সময় নিতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dadurch wird der zwischengespeicherte Text jedes Buchs neu extrahiert, was bei einer großen Bibliothek eine Weile dauern kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This re-extracts the cached text of every book, which may take a while for a large library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esto vuelve a extraer el texto en caché de cada libro, lo que puede tardar un poco en una biblioteca grande."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "این کار متن ذخیره‌شده هر کتاب را دوباره استخراج می‌کند که برای کتابخانه‌ای بزرگ ممکن است کمی طول بکشد."
