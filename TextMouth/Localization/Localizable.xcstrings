    "readerCloud.waitingForSync" : {
      "comment" : "Shown and spoken when the book's files have not arrived from the sync service. %1$@ is the book's title; %2$@ is the cloud service's name, or \"The cloud service\" when it is unknown.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يصل %@ إلى هذا الـ Mac بعد. ربما لا يزال %@ يزامنه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ এখনো এই Mac-এ পৌঁছায়নি। %2$@ হয়তো এখনো এটি সিঙ্ক করছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ist noch nicht auf diesem Mac angekommen. %2$@ synchronisiert es möglicherweise noch."
          }
        },
        "en" : {
          "stringUnit" : {
