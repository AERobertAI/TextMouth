          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@: niektóre zmiany nie są zapisane, a przełączenie bibliotek spowodowałoby ich utratę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
