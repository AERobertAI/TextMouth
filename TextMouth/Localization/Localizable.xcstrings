        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Diese XML-Datei ist weder ein DTBook-Buch noch ein Word-2003-XML-Dokument noch eine PEF-Brailledatei, die einzigen XML-Arten, die TextMouth liest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This XML file is not a DTBook book, a Word 2003 XML document, or a PEF braille file, the only XML TextMouth reads."
