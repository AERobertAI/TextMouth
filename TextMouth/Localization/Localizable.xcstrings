    "feed.notificationsRefused" : {
      "comment" : "What the notifications setting's help says while macOS does not allow TextMouth to post notifications. System Settings and Notifications are macOS's own names, in the language of macOS.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يملك TextMouth إذنًا بإرسال الإشعارات. فعّلها في إعدادات النظام، الإشعارات، TextMouth."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth-কে বিজ্ঞপ্তি পাঠানোর অনুমতি দেওয়া হয়নি। সিস্টেম সেটিংস, বিজ্ঞপ্তি, TextMouth-এ সেগুলো চালু করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth darf keine Mitteilungen senden. Schalte sie unter Systemeinstellungen, Mitteilungen, TextMouth ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth isn't allowed to post notifications. Turn them on in System Settings, Notifications, TextMouth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no tiene permiso para enviar notificaciones. Actívalas en Ajustes del Sistema, Notificaciones, TextMouth."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth اجازه ارسال اعلان ندارد. آن‌ها را در System Settings، Notifications، TextMouth روشن کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth n’est pas autorisé à envoyer des notifications. Activez-les dans Réglages Système, Notifications, TextMouth."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth אינו מורשה לשלוח עדכונים. הפעל אותם בהגדרות המערכת, “עדכונים”, “TextMouth”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth को सूचनाएँ भेजने की अनुमति नहीं है। उन्हें सिस्टम सेटिंग, सूचनाएँ, TextMouth में चालू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tidak diizinkan menampilkan notifikasi. Aktifkan di Pengaturan Sistem, Pemberitahuan, TextMouth."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non può inviare notifiche. Attivale in Impostazioni di Sistema, Notifiche, TextMouth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は通知を送信できません。「システム設定」の「通知」で、TextMouth の通知をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 알림을 보낼 수 없도록 설정되어 있습니다. 시스템 설정, 알림, TextMouth 순으로 이동해 켜십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth mag geen meldingen plaatsen. Schakel ze in via Systeeminstellingen, Berichtgeving, TextMouth."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth nie ma zezwolenia na wyświetlanie powiadomień. Włącz je w: Ustawienia systemowe, Powiadomienia, TextMouth."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não tem permissão para enviar notificações. Ative-as em Ajustes do Sistema, Notificações, TextMouth."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не разрешено показывать уведомления. Включите их в разделе «Системные настройки», «Уведомления», «TextMouth»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth får inte skicka notiser. Slå på dem i Systeminställningar, Notiser, TextMouth."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ไม่ได้รับอนุญาตให้ส่งการแจ้งเตือน เปิดการแจ้งเตือนในการตั้งค่าระบบ การแจ้งเตือน TextMouth"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth'un bildirim göndermesine izin verilmiyor. Bildirimleri Sistem Ayarları, Bildirimler, TextMouth bölümünde açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не має дозволу надсилати сповіщення. Увімкніть їх: Системні параметри, Сповіщення, TextMouth."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth کو اطلاعات بھیجنے کی اجازت نہیں ہے۔ انہیں سسٹم ترتیبات، اطلاعات، TextMouth میں آن کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth không được phép gửi thông báo. Hãy bật chúng trong Cài đặt hệ thống, Thông báo, TextMouth."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 未获准发送通知。请在“系统设置”的“通知”中，于“TextMouth”打开通知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 未獲允許發送通知。請在「系統設定」的「通知」中，於「TextMouth」開啟。"
          }
        }
      }
    },
