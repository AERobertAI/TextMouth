    "feedSettings.perFeedNote" : {
      "comment" : "The note under the Feeds tab's settings. The first %@ is the name of the List and download choice; the second is the name of the Feed Info sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يمكن أن يكون لكل موجز اختياره الخاص لـ %1$@ وعدد أيامه الخاص قبل حذف التنزيلات التي تم تشغيلها، في %2$@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@-এ প্রতিটি ফিডের নিজস্ব %1$@ পছন্দ এবং শোনা ডাউনলোড মোছার আগের নিজস্ব দিনসংখ্যা রাখা যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Feed kann unter %2$@ eine eigene Auswahl für %1$@ und eine eigene Anzahl Tage bis zum Löschen wiedergegebener Downloads haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A feed can have its own %@ choice and its own days before deleting played downloads, in its %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un canal puede tener su propia opción de %1$@ y sus propios días antes de eliminar las descargas reproducidas, en su %2$@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هر فید می‌تواند در %2$@ خود، انتخاب %1$@ و تعداد روزهای پیش از حذف بارگیری‌های پخش‌شده‌ی خودش را داشته باشد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un flux peut avoir son propre choix %1$@ et son propre nombre de jours avant la suppression des téléchargements écoutés, dans %2$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לערוץ יכולה להיות בחירת “%1$@” משלו ומספר ימים משלו עד למחיקת הורדות שהושמעו, ב“%2$@”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "हर फ़ीड का अपना %1$@ विकल्प और चलाए गए डाउनलोड मिटाने से पहले के अपने दिन हो सकते हैं; ये उसके %2$@ में होते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Setiap feed dapat memiliki pilihan %1$@ sendiri dan jumlah hari sendiri sebelum unduhan yang sudah diputar dihapus, di %2$@-nya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un feed può avere una propria scelta %1$@ e un proprio numero di giorni prima dell’eliminazione dei download riprodotti, nel foglio %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "各フィードは、%2$@で、独自の「%1$@」の選択と、再生済みのダウンロードを削除するまでの日数を設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "피드마다 %2$@에서 %1$@ 선택과 재생한 다운로드를 삭제하기까지의 일수를 따로 지정할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Een feed kan een eigen keuze voor %1$@ hebben en een eigen aantal dagen voor het verwijderen van afgespeelde downloads, in de %2$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kanał może mieć własny wybór %1$@ i własną liczbę dni przed usunięciem odtworzonych pobranych plików, w oknie %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um feed pode ter a própria opção de %1$@ e os próprios dias antes de excluir downloads reproduzidos, em %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "У ленты могут быть собственный выбор %1$@ и собственное число дней до удаления прослушанных загрузок — в листе %2$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
