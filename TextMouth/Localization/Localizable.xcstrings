          }
        }
      }
    },
    "A transcript is being attached to %@. Transcribe it once that finishes." : {
      "comment" : "Alert shown when Transcribe Audio is chosen for an audiobook that a transcript is being attached to. %@ is the audiobook's title.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يجري إرفاق نسخة نصية بـ%@. فرّغ صوته بعد اكتمال ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "An %@ wird gerade ein Transkript angehängt. Transkribiere es, sobald das fertig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se está adjuntando una transcripción a %@. Transcríbelo cuando termine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une transcription est en train d’être jointe à %@. Transcrivez-le une fois l’opération terminée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ में ट्रांसक्रिप्ट संलग्न की जा रही है। इसके पूरा होने पर इसे ट्रांसक्राइब करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transkrip sedang dilampirkan ke %@. Transkripsikan setelah selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si sta allegando una trascrizione al libro %@. Trascrivilo al termine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@に文字起こしを添付しています。完了してから文字起こししてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@에 대본을 첨부하는 중입니다. 끝난 후에 대본을 만드십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uma transcrição está sendo anexada a %@. Transcreva o áudio quando ela terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "К аудиокниге «%@» сейчас прикрепляется расшифровка. Расшифруйте её аудио после завершения."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "До %@ прикріплюється транскрипція. Транскрибуйте аудіо, коли це завершиться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "正在向“%@”附加文字稿。附加完成后再转录。"
          }
        }
      }
    },
    "A view holds at most %lld conditions." : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. Its hint at the limit, when it is dimmed. Placeholders in order: LibraryViewFilter.conditionLimit.",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "يحتوي العرض على %lld شروط كحد أقصى."
                }
              },
              "many" : {
