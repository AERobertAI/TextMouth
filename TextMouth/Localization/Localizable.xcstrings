    "feedThreshold.refreshInterval.choose" : {
      "comment" : "VoiceOver hint of the checkbox that turns the refresh interval off. The first %@ is the name of the Check Feed command; the second is the name of the Refresh All Feeds command.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا تتحدّث الموجزات إلا عند فتح TextMouth، إن كان ذلك مفعّلًا، وعند اختيار %1$@ أو %2$@"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফিড শুধু চালু হওয়ার সময়, তা চালু থাকলে, এবং আপনি %1$@ বা %2$@ বেছে নিলে রিফ্রেশ হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Feeds werden nur beim Start aktualisiert, falls das eingeschaltet ist, und wenn du %1$@ oder %2$@ wählst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feeds refresh only at launch, if that is on, and when you choose %@ or %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los canales solo se actualizan al abrir TextMouth, si eso está activado, y cuando eliges %1$@ o %2$@"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فیدها فقط هنگام راه‌اندازی، اگر روشن باشد، و وقتی %1$@ یا %2$@ را انتخاب کنید تازه‌سازی می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les flux ne s’actualisent qu’au lancement, si cette option est activée, et lorsque vous choisissez %1$@ ou %2$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הערוצים מתרעננים רק בעת ההפעלה, אם האפשרות פועלת, וכשבוחרים ב“%1$@” או ב“%2$@”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ीड केवल लॉन्च पर, यदि वह चालू है, और तब रीफ़्रेश होते हैं जब आप “%1$@” या “%2$@” चुनते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Feed hanya disegarkan saat peluncuran, jika itu aktif, dan saat Anda memilih %1$@ atau %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I feed si aggiornano solo all’avvio, se è attivo, e quando scegli %1$@ o %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フィードは、起動時（オンの場合）と、「%1$@」または「%2$@」を選択したときにだけ更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "피드는 실행할 때(해당 설정이 켜져 있는 경우)와 %1$@ 또는 %2$@을(를) 선택할 때만 새로 고쳐집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Feeds worden alleen bij het starten ververst, als dat aanstaat, en wanneer je %1$@ of %2$@ kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kanały odświeżają się tylko przy uruchomieniu, jeśli ta opcja jest włączona, i gdy wybierzesz %1$@ lub %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Os feeds são atualizados apenas na abertura, se isso estiver ativado, e quando você escolhe %1$@ ou %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ленты обновляются только при запуске, если это включено, и когда вы выбираете %1$@ или %2$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Flöden uppdateras bara vid start, om det är på, och när du väljer %1$@ eller %2$@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ฟีดจะรีเฟรชเฉพาะเมื่อเปิดแอปหากเปิดใช้ตัวเลือกนั้นไว้ และเมื่อคุณเลือก %1$@ หรือ %2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beslemeler yalnızca açılışta (bu ayar açıksa) ve şunlardan birini seçtiğinizde yenilenir: %1$@ veya %2$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Стрічки оновлюються лише під час запуску, якщо це увімкнено, і коли ви вибираєте «%1$@» або «%2$@»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فیڈز صرف آغاز پر ریفریش ہوتی ہیں، اگر وہ آن ہے، اور جب آپ %1$@ یا %2$@ منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nguồn cấp chỉ làm mới khi mở ứng dụng, nếu tùy chọn đó bật, và khi bạn chọn %1$@ hoặc %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "订阅源仅在启动时（如已开启）以及你选取“%1$@”或“%2$@”时刷新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
