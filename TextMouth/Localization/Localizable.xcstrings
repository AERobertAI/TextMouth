    "audioEditor.noPresets" : {
      "comment" : "Shown in the audio editor's Apply Filter sheet when there are no filter presets. \"Storage settings\" and \"Audio Editing\" are the names of a settings tab and its group.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا توجد إعدادات مسبقة للمرشحات. أضف بعضها في إعدادات التخزين، ضمن تحرير الصوت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "কোনো ফিল্টার প্রিসেট নেই। স্টোরেজ সেটিংসে অডিও সম্পাদনার অধীনে কিছু যোগ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Keine Filtervoreinstellungen. Füge in den Speichereinstellungen unter „Audiobearbeitung“ welche hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No filter presets. Add some in Storage settings, under Audio Editing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay preajustes de filtros. Agrega algunos en los ajustes de Almacenamiento, en Edición de audio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پیش‌تنظیم فیلتری نیست. در تنظیمات ذخیره‌سازی، در بخش «ویرایش صدا»، چند پیش‌تنظیم اضافه کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucun préréglage de filtre. Ajoutez-en dans les réglages Stockage, sous Édition audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אין הגדרות מוכנות של מסננים. ניתן להוסיף בהגדרות האחסון, תחת “עריכת שמע”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कोई फ़िल्टर प्रीसेट नहीं है। संग्रहण सेटिंग में, ऑडियो संपादन के अंतर्गत कुछ जोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tidak ada preset filter. Tambahkan di pengaturan Penyimpanan, di bawah Pengeditan Audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nessun preset di filtro. Aggiungine nelle impostazioni di Archiviazione, sotto Modifica dell’audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フィルタプリセットがありません。ストレージ設定の「オーディオ編集」で追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "필터 프리셋이 없습니다. 저장 공간 설정의 오디오 편집에서 추가하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Geen filtervoorinstellingen. Voeg ze toe in de instellingen voor Opslag, onder Audiobewerking."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Brak ustawień wstępnych filtrów. Dodaj je w ustawieniach: Pamięć, Edycja dźwięku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nenhuma predefinição de filtro. Adicione algumas nos ajustes de Armazenamento, em Edição de áudio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Нет пресетов фильтров. Добавьте их в настройках хранилища, в разделе «Редактирование аудио»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Inga filterförinställningar. Lägg till några i inställningarna för Lagring, under Ljudredigering."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไม่มีค่าที่ตั้งไว้ล่วงหน้าของตัวกรอง ให้เพิ่มในการตั้งค่าที่เก็บข้อมูล ใต้การแก้ไขเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Filtre hazır ayarı yok. Depolama ayarlarında, Ses Düzenleme altında ekleyin."
          }
        },
