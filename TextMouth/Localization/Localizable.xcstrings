    "brailleExport.numbersHint" : {
      "comment" : "The hint of the Braille page numbers switch in the Export dialog's braille options.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحدد ما إذا كان السطر الأخير من كل صفحة يحمل رقم صفحة برايل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "প্রতিটি পৃষ্ঠার শেষ লাইনে এর ব্রেইল পৃষ্ঠা নম্বর থাকবে কি না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ob die letzte Zeile jeder Seite ihre Braille-Seitenzahl trägt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether each page's last line carries its braille page number."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si la última línea de cada página lleva su número de página braille."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اینکه آخرین خط هر صفحه شماره صفحه‌ی بریل آن را دارد یا نه."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Indique si la dernière ligne de chaque page porte son numéro de page braille."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "האם בשורה האחרונה של כל עמוד יופיע מספר עמוד הברייל שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "क्या हर पृष्ठ की अंतिम पंक्ति में उसका ब्रेल पृष्ठ क्रमांक हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apakah baris terakhir setiap halaman memuat nomor halaman braille-nya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Indica se l’ultima riga di ogni pagina riporta il suo numero di pagina braille."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "各ページの最後の行に、点字のページ番号を付けるかどうかです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "각 페이지의 마지막 줄에 점자 페이지 번호를 넣을지 여부입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Of de laatste regel van elke pagina het braillepaginanummer bevat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Czy ostatni wiersz każdej strony zawiera numer strony w braille’u."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se a última linha de cada página traz o número da página em braille."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Указывает, ставится ли номер страницы Брайля в последней строке каждой страницы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Om varje sidas sista rad har sitt sidnummer i punktskrift."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ระบุว่าบรรทัดสุดท้ายของแต่ละหน้ามีเลขหน้าอักษรเบรลล์หรือไม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Her sayfanın son satırının braille sayfa numarasını taşıyıp taşımayacağı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Чи містить останній рядок кожної сторінки її брайлівський номер."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آیا ہر صفحے کی آخری سطر پر اس کا بریل صفحہ نمبر ہو۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cho biết dòng cuối của mỗi trang có mang số trang braille hay không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "每页最后一行是否带有其盲文页码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "每頁最後一行是否帶有其點字頁碼。"
          }
        }
      }
    },
