                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "La lectura del audio tardó más de %lld minuto; TextMouth dejó de esperar."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "La lectura del audio tardó más de %lld minutos; TextMouth dejó de esperar."
                }
              }
