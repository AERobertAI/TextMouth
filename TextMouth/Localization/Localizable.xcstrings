          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transkriptionen sträcker sig till %1$@, förbi ljudets slut vid %2$@, så den hör till annat ljud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ข้อความถอดเสียงยาวถึง %1$@ เกินจุดสิ้นสุดของเสียงที่ %2$@ จึงเป็นของเสียงอื่น"
