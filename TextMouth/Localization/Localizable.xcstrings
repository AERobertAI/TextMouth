          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在“我在哪里”朗读结束时播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在「我在哪裡？」說完時播放。"
          }
        }
      }
    },
