          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is being transcribed. Clean up its transcript once that finishes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ se está transcribiendo. Limpia su transcripción cuando termine."
