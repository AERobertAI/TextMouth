        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Там недостатньо вільного місця для бібліотеки: потрібно %1$@, вільно %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
