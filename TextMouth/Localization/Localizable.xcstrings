    "protection.rememberFailed" : {
      "comment" : "Said when the Keychain would not keep a book's password; the book opens anyway.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّر حفظ كلمة المرور في سلسلة المفاتيح. الكتاب مفتوح."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "কিচেইনে পাসওয়ার্ড রাখা যায়নি। বইটি খোলা আছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Passwort konnte nicht im Schlüsselbund gesichert werden. Das Buch ist geöffnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The password could not be kept in the Keychain. The book is open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo guardar la contraseña en el llavero. El libro está abierto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "گذرواژه در زنجیره کلید نگه داشته نشد. کتاب باز است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le mot de passe n’a pas pu être gardé dans le trousseau. Le livre est ouvert."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא ניתן היה לשמור את הסיסמה בצרור המפתחות. הספר פתוח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पासवर्ड कीचेन में नहीं रखा जा सका। पुस्तक खुली है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kata sandi tidak dapat disimpan di Rantai Kunci. Buku terbuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non è stato possibile conservare la password nel portachiavi. Il libro è aperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "パスワードをキーチェーンに保存できませんでした。ブックは開いています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "암호를 키체인에 보관하지 못했습니다. 책은 열려 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Het wachtwoord kon niet in de sleutelhanger worden bewaard. Het boek is geopend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie udało się zapisać hasła w pęku kluczy. Książka jest otwarta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não foi possível guardar a senha no chaveiro. O livro está aberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не удалось сохранить пароль в связке ключей. Книга открыта."
          }
        },
        "sv" : {
          "stringUnit" : {
