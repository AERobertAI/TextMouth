    "legacyMigrationError.copyDiffers" : {
      "comment" : "Why a book could not move into the current library format: the copy differed from the original.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم تطابق النسخة المنشأة في المكتبة الأصل، لذا تم التخلص من النسخة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "লাইব্রেরিতে তৈরি কপিটি মূলের সঙ্গে মেলেনি, তাই কপিটি বাতিল করা হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die in der Bibliothek erstellte Kopie stimmte nicht mit dem Original überein, daher wurde die Kopie verworfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The copy made in the library did not match the original, so the copy was discarded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La copia hecha en la biblioteca no coincidía con el original, así que se descartó."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نسخه ساخته‌شده در کتابخانه با فایل اصلی مطابقت نداشت، بنابراین نسخه دور انداخته شد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La copie faite dans la bibliothèque ne correspondait pas à l’original ; elle a donc été abandonnée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "העותק שנוצר בספרייה לא תאם למקור, ולכן העותק הושלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लाइब्रेरी में बनाई गई प्रति मूल से मेल नहीं खाई, इसलिए प्रति को छोड़ दिया गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Salinan yang dibuat di pustaka tidak cocok dengan aslinya, jadi salinan dibuang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La copia creata nella libreria non corrispondeva all’originale, quindi è stata scartata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ライブラリ内で作成したコピーが元のファイルと一致しなかったため、コピーを破棄しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관함에 만든 사본이 원본과 일치하지 않아 사본을 폐기했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De kopie in de bibliotheek kwam niet overeen met het origineel, dus de kopie is weggegooid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kopia wykonana w bibliotece nie zgadzała się z oryginałem, więc ją odrzucono."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A cópia feita na biblioteca não correspondeu ao original, então foi descartada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Копия, сделанная в библиотеке, не совпала с оригиналом, поэтому она отброшена."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kopian som gjordes i biblioteket stämde inte med originalet, så kopian kastades."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "สำเนาที่สร้างในไลบรารีไม่ตรงกับต้นฉบับ จึงทิ้งสำเนานั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitaplıkta yapılan kopya orijinal dosyayla eşleşmedi; bu yüzden kopya atıldı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Копія, створена в бібліотеці, не збіглася з оригіналом, тому її відхилено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لائبریری میں بنائی گئی کاپی اصل سے میل نہیں کھاتی تھی، اس لیے کاپی ترک کر دی گئی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bản sao tạo trong thư viện không khớp với bản gốc, nên bản sao đã bị loại bỏ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在资料库中制作的副本与原件不一致，因此已丢弃该副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "書庫中製作的副本與原始檔案不符，因此已捨棄該副本。"
          }
        }
      }
    },
