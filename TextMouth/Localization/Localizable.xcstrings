    "feedSearchError.message.unreadableAnswer" : {
      "comment" : "Why a podcast search failed: the directory's answer could not be read.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أرسل دليل البودكاست ردًا لا يستطيع TextMouth قراءته. حاول مرة أخرى لاحقًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পডকাস্ট ডিরেক্টরি এমন উত্তর পাঠিয়েছে যা TextMouth পড়তে পারে না। পরে আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Podcast-Verzeichnis hat eine Antwort gesendet, die TextMouth nicht lesen kann. Versuche es später erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The podcast directory sent an answer TextMouth can't read. Try again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
