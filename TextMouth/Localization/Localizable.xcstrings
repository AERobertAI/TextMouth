    "brailleSettings.contractionHint" : {
      "comment" : "The hint of the contraction pop-up in the Braille tab of Settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحدد ما إذا كان برايل ذلك الرمز مختصرًا، أي يكتب الكلمات الشائعة ومجموعات الحروف بخلايا أقل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সেই কোডের ব্রেইল সংক্ষিপ্ত কি না, যা প্রচলিত শব্দ ও অক্ষরগুচ্ছ কম সেলে লেখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ob dieser Code Kurzschrift verwendet, die gebräuchliche Wörter und Buchstabengruppen mit weniger Zellen schreibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether that code's braille is contracted, which writes common words and letter groups in fewer cells."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si el braille de ese código está contraído, lo que escribe palabras y grupos de letras comunes con menos celdas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اینکه بریل آن کد فشرده است یا نه، که کلمه‌های رایج و گروه‌های حرف را در خانه‌های کمتری می‌نویسد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Indique si le braille de ce code est abrégé, ce qui écrit les mots courants et les groupes de lettres avec moins de cellules."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "האם הברייל של הקוד הזה מקוצר, כלומר כותב מילים נפוצות וקבוצות אותיות בפחות תאים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "क्या उस कोड की ब्रेल संक्षिप्त हो, जो आम शब्दों और अक्षर-समूहों को कम सेल में लिखती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apakah braille kode itu disingkat, yang menulis kata umum dan kelompok huruf dengan lebih sedikit sel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Indica se il braille di quel codice è contratto, cioè scrive le parole comuni e i gruppi di lettere con meno celle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "その点字コードが縮約されるかどうかです。縮約すると、よく使う語や文字の並びが、少ないセルで書かれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "해당 코드의 점자를 축약할지 여부로, 축약하면 흔한 단어와 글자 묶음을 더 적은 셀로 씁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Of het braille van die code verkort is, waarbij gangbare woorden en lettergroepen in minder cellen worden geschreven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Czy braille tej tabeli jest skrócony, co zapisuje popularne słowa i grupy liter w mniejszej liczbie komórek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se o braille desse código é contraído, o que escreve palavras e grupos de letras comuns em menos células."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сокращается ли Брайль этого кода: сокращённый Брайль записывает частые слова и группы букв меньшим числом ячеек."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Om punktskriften i den koden är kortskrift, vilket skriver vanliga ord och bokstavsgrupper med färre celler."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ระบุว่าอักษรเบรลล์ของรหัสนั้นเป็นแบบย่อหรือไม่ ซึ่งเขียนคำที่ใช้บ่อยและกลุ่มตัวอักษรด้วยเซลล์ที่น้อยลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu kodla yazılan braille'in kısaltmalı olup olmadığı; kısaltmalı braille yaygın kelimeleri ve harf gruplarını daha az hücreyle yazar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Чи брайль цього коду скорочений, що записує поширені слова й групи літер меншою кількістю комірок."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آیا اس کوڈ کی بریل مختصر ہو، جس سے عام الفاظ اور حروف کے گروہ کم سیلز میں لکھے جاتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cho biết braille của mã đó có được viết tắt hay không, tức là viết các từ thông dụng và nhóm chữ cái bằng ít ô hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "该盲文码的盲文是否缩写，缩写会用更少的单元写出常见词和字母组合。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "該點字碼的點字是否縮寫，縮寫會以較少的點字格寫出常用字詞和字母組合。"
          }
        }
      }
    },
