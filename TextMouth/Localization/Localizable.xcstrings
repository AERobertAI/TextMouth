    "transcription.cleanedUpTranscript" : {
      "comment" : "Line of the Transcribe Audio sheet warning that transcribing again replaces the cleanup the user applied. %@ is a date, such as \"October 5, 2026\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نظّفت هذه النسخة النصية في %@. يؤدي التفريغ مرة أخرى إلى استبدال التنظيف."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আপনি এই ট্রান্সক্রিপ্ট %@ তারিখে পরিষ্কার করেছেন। আবার ট্রান্সক্রাইব করলে পরিষ্কার করা অংশ প্রতিস্থাপিত হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du hast dieses Transkript am %@ bereinigt. Erneutes Transkribieren ersetzt die Bereinigung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You cleaned up this transcript on %@. Transcribing again replaces the cleanup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Limpiaste esta transcripción el %@. Volver a transcribir reemplaza la limpieza."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "شما این رونوشت را در %@ تمیز کردید. رونویسی دوباره پاک‌سازی را جایگزین می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vous avez nettoyé cette transcription le %@. Une nouvelle transcription remplace le nettoyage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ניקית את התמליל הזה בתאריך %@. תמלול חוזר מחליף את הניקוי."
