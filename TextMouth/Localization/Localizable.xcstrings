    "settings.rewindUnitHint" : {
      "comment" : "VoiceOver hint of the Rewind to pop-up in the Playback settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عند استئناف التشغيل، يرجّع إلى بداية هذه الوحدة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "প্লেব্যাক আবার শুরুর সময় এই ইউনিটের শুরুতে পিছিয়ে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
