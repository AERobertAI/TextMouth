            "value" : "%1$@を%3$lld件中%2$lld番目に移動しました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@을(를) %3$lld개 중 %2$lld번째로 이동했습니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ is verplaatst naar positie %2$lld van %3$lld"
