        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ডেটা কপি করার সময় %1$@-কে %3$@-এর বদলে %2$@-এ নিয়ে যাওয়ার মতো করে বদলানো হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Während TextMouth seine Daten kopierte, wurde %1$@ so geändert, dass es zu %2$@ statt zu %3$@ führt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While TextMouth was copying its data, %@ was changed to lead to %@ instead of %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mientras TextMouth copiaba sus datos, %1$@ se cambió para llevar a %2$@ en lugar de %3$@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هنگامی که TextMouth داده‌های خود را کپی می‌کرد، %1$@ تغییر کرد تا به جای %3$@ به %2$@ برسد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pendant que TextMouth copiait ses données, %1$@ a été modifié pour mener à %2$@ au lieu de %3$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בזמן ש-TextMouth העתיק את הנתונים שלו, %1$@ שונה כך שיוביל אל %2$@ במקום אל %3$@."
