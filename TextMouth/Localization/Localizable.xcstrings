    },
    "But %@ also holds %lld books a newer TextMouth added: they are kept where they are, and so is every folder that holds one." : {
      "comment" : "Last sentence of the second confirmation that deletes a folder, when the folder holds books that a newer TextMouth added. %1$@ is the folder's name in quotation marks and %2$lld is how many books, a count.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "But %@ also holds %lld book a newer TextMouth added: it is kept where it is, and so is every folder that holds it."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "But %@ also holds %lld books a newer TextMouth added: they are kept where they are, and so is every folder that holds one."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Pero %1$@ también contiene %2$lld de libros que agregó una versión más reciente de TextMouth: se conservan donde están, y también cada carpeta que contiene alguno."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Pero %1$@ también contiene %2$lld libro que agregó una versión más reciente de TextMouth: se conserva donde está, y también cada carpeta que lo contiene."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Pero %1$@ también contiene %2$lld libros que agregó una versión más reciente de TextMouth: se conservan donde están, y también cada carpeta que contiene alguno."
                }
              }
            }
          }
        }
      }
    },
