    "The next article could not be downloaded, so playback stopped." : {
      "comment" : "First sentence of the VoiceOver announcement when Next in Folder could not download the next feed article while a book was playing, so playback was paused. A sentence with the reason follows it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der nächste Artikel konnte nicht heruntergeladen werden, daher wurde die Wiedergabe gestoppt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo descargar el siguiente artículo, así que la reproducción se detuvo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le prochain article n’a pas pu être téléchargé, donc la lecture s’est arrêtée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non è stato possibile scaricare l’articolo successivo, quindi la riproduzione si è interrotta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O próximo artigo não pôde ser baixado, então a reprodução parou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не удалось загрузить следующую статью, поэтому воспроизведение остановлено."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Наступну статтю не вдалося завантажити, тому відтворення зупинено."
