          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "編集内容を、ブックのオーディオファイルに、ブックが使っているフォーマットで保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책이 사용하는 포맷으로 편집 내용을 책의 오디오 파일에 저장합니다."
