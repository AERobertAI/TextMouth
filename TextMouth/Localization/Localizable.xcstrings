    "libraryComparison.identityMarker.compared" : {
      "comment" : "Last clause of a sentence about an unread file in Compare Libraries: the consequence for the identity marker, after a comma.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لذا لا يستطيع TextMouth معرفة ما إذا كانت النسختان مكتبة واحدة، ولم يقارن شيئًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "তাই দুটি কপি একই লাইব্রেরি কিনা TextMouth বলতে পারে না, এবং কিছুই তুলনা করেনি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "daher kann TextMouth nicht feststellen, ob die beiden Kopien dieselbe Bibliothek sind, und hat nichts verglichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "so TextMouth can't tell whether the two copies are one library, and compared nothing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "así que TextMouth no puede saber si las dos copias son una misma biblioteca, y no comparó nada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بنابراین TextMouth نمی‌تواند تشخیص دهد که دو نسخه یک کتابخانه‌اند یا نه، و چیزی را مقایسه نکرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "donc TextMouth ne peut pas déterminer si les deux copies sont la même bibliothèque, et n’a rien comparé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ולכן TextMouth אינו יכול לדעת אם שני העותקים הם ספרייה אחת, ולא השווה דבר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसलिए TextMouth यह नहीं बता सकता कि दोनों कॉपी एक ही लाइब्रेरी हैं या नहीं, और उसने किसी चीज़ की तुलना नहीं की।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "sehingga TextMouth tidak dapat memastikan apakah kedua salinan adalah satu pustaka, dan tidak membandingkan apa pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "quindi TextMouth non può stabilire se le due copie sono un’unica libreria e non ha confrontato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は2つのコピーが1つのライブラリかどうかを判断できず、何も比較しませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "그래서 TextMouth는 두 사본이 하나의 보관함인지 알 수 없어 아무것도 비교하지 못했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "dus TextMouth kan niet bepalen of de twee kopieën één bibliotheek zijn en heeft niets vergeleken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "więc TextMouth nie może stwierdzić, czy obie kopie to jedna biblioteka, i niczego nie porównał."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "então o TextMouth não consegue saber se as duas cópias são uma mesma biblioteca, e não comparou nada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "поэтому TextMouth не может определить, одна ли это библиотека в двух копиях, и ничего не сравнивалось."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "så TextMouth kan inte avgöra om de två kopiorna är ett och samma bibliotek, och jämförde ingenting."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth จึงบอกไม่ได้ว่าสำเนาทั้งสองเป็นไลบรารีเดียวกันหรือไม่ และไม่ได้เปรียบเทียบอะไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "bu yüzden TextMouth iki kopyanın tek bir kitaplık olup olmadığını anlayamadı ve hiçbir şeyi karşılaştırmadı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "тому TextMouth не може визначити, чи є ці дві копії однією бібліотекою, і нічого не порівнювалося."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس لیے TextMouth یہ نہیں بتا سکتا کہ دونوں کاپیاں ایک ہی لائبریری ہیں یا نہیں، اور اس نے کسی چیز کا موازنہ نہیں کیا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "nên TextMouth không thể biết hai bản có phải là một thư viện hay không, và đã không so sánh gì."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "因此 TextMouth 无法判断这两个副本是否为同一个资料库，也未进行任何比较。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "因此 TextMouth 無法判斷這兩份副本是否為同一個書庫，也沒有比較任何項目。"
          }
        }
      }
    },
