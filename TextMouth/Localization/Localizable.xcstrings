        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "চালু থাকলে প্যাটার্নে শব্দের সীমানার জন্য \\b ব্যবহার করুন"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wenn aktiviert, verwende \\b im Muster für Wortgrenzen."
