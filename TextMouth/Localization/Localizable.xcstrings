        }
      }
    },
    "audioEditor.closingReader" : {
      "comment" : "Said as a book's reader window is closed before the audio editor opens on the book. %@ is the book's title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جارٍ إغلاق القارئ الخاص بـ%@ لأن التحرير يغيّر صوته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@-এর রিডার বন্ধ করা হচ্ছে, কারণ সম্পাদনা এর অডিও বদলে দেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
