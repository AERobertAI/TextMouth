    "An option of the %@ filter has a value but no name." : {
      "comment" : "Problem found in a typed filter chain: an equals sign with nothing before it, in one filter's options. %@ is the filter's name, such as volume.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eine Option des Filters „%@“ hat einen Wert, aber keinen Namen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una opción del filtro %@ tiene valor pero no nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une option du filtre %@ a une valeur mais pas de nom."
          }
        },
        "it" : {
          "stringUnit" : {
