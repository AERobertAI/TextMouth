        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يفتح %@ في نافذة قارئ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffnet %@ in einer Leseansicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre %@ en una ventana del lector."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ouvre %@ dans une fenêtre de lecteur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ को रीडर विंडो में खोलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuka %@ di jendela pembaca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apre %@ in una finestra del lettore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@をリーダウインドウで開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@을(를) 리더 윈도우에서 엽니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre %@ em uma janela do leitor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Открывает «%@» в окне чтения."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відкриває %@ у вікні читання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在阅读器窗口中打开“%@”。"
          }
        }
      }
    },
    "Opens %@, the folder the logs are written to now, in Finder." : {
      "comment" : "VoiceOver hint and tooltip of the Show Logs in Finder button. %@ is the folder's full path, which stays as written.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يفتح %@، وهو المجلد الذي تُكتب إليه السجلات الآن، في Finder."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বর্তমানে লগ যে ফোল্ডারে লেখা হচ্ছে, সেই %@ Finder-এ খোলে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffnet %@, den Ordner, in den die Protokolle jetzt geschrieben werden, im Finder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre en Finder %@, la carpeta donde se escriben ahora los registros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ouvre %@, le dossier où les journaux sont écrits actuellement, dans le Finder."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लॉग जिस फ़ोल्डर में अभी लिखे जाते हैं, उस %@ को Finder में खोलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuka %@, folder tempat log ditulis sekarang, di Finder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apre nel Finder %@, la cartella in cui vengono scritti ora i registri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "現在ログが書き込まれているフォルダ %@ を Finder で開きます。"
