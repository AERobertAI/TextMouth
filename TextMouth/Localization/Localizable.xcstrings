              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Die Audiodatei %@ hat %lld Kanäle, gibt aber nicht an, welcher welcher ist, daher kann TextMouth sie nicht auf Stereo mischen."
