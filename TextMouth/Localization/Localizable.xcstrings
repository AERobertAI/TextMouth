            "value" : "Исходный файл сохранён: TextMouth импортировал из архива «%2$@» только книгу DAISY «%1$@»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Оригінальний файл збережено: TextMouth імпортував з архіву «%2$@» лише книгу DAISY «%1$@»."
          }
