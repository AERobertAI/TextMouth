    "The disk is almost full, so recording stopped. What was recorded is kept." : {
      "comment" : "Error in the Record window when the disk filled up while recording.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "القرص ممتلئ تقريبًا، لذا توقف التسجيل. تم الاحتفاظ بما سُجّل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Speicherplatz ist fast voll, daher wurde die Aufnahme gestoppt. Das Aufgenommene bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El disco está casi lleno, así que la grabación se detuvo. Lo grabado se conserva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le disque est presque plein, donc l’enregistrement s’est arrêté. Ce qui a été enregistré est conservé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "डिस्क लगभग भर गई है, इसलिए रिकॉर्डिंग रुक गई। जो रिकॉर्ड हुआ वह सुरक्षित है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disk hampir penuh, sehingga perekaman berhenti. Hasil rekaman tetap disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il disco è quasi pieno, quindi la registrazione si è interrotta. Quanto registrato è stato conservato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ディスクの空き容量がわずかなため、録音を停止しました。録音済みの内容は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "디스크가 거의 가득 차서 녹음이 중지되었습니다. 녹음된 내용은 보관됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O disco está quase cheio, então a gravação parou. O que foi gravado foi mantido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Диск почти заполнен, поэтому запись остановлена. Записанное сохранено."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Диск майже заповнений, тому запис зупинено. Записане збережено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "磁盘几乎已满，因此录音已停止。已录制的内容会保留。"
          }
        }
      }
    },
    "The disk is too full to keep this audio for pasting." : {
      "comment" : "Said when the disk is too full to keep the audio cut or copied in the audio editor for Paste.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "القرص ممتلئ جدًا بحيث لا يمكن الاحتفاظ بهذا الصوت للصق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Speicherplatz reicht nicht, um dieses Audio zum Einsetzen aufzubewahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El disco está demasiado lleno para conservar este audio y pegarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le disque est trop plein pour garder cet audio en vue de le coller."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस ऑडियो को पेस्ट करने के लिए रखने हेतु डिस्क बहुत भरी है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disk terlalu penuh untuk menyimpan audio ini untuk ditempel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il disco è troppo pieno per conservare questo audio per Incolla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ディスクがいっぱいで、ペースト用にこのオーディオを保持できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "디스크가 너무 가득 차서 붙여넣기용 오디오를 보관할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O disco está cheio demais para guardar este áudio para colar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "На диске слишком мало места, чтобы хранить это аудио для вставки."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Диск надто заповнений, щоб зберегти це аудіо для вставлення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "磁盘太满，无法保留此音频以供粘贴。"
          }
        }
      }
    },
    "The disk lacks room: this needs about %@, and TextMouth keeps %@ free. Free some space, then export again." : {
      "comment" : "Why a spoken audio export was refused: the disk is too full. %1$@ is the space the export needs and %2$@ the space TextMouth always keeps free, each a size such as 1 GB.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Datenträger hat nicht genug Platz: Dafür werden etwa %1$@ benötigt, und TextMouth hält %2$@ frei. Gib etwas Speicherplatz frei und exportiere dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The disk lacks room: this needs about %1$@, and TextMouth keeps %2$@ free. Free some space, then export again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay espacio suficiente en el disco: esto necesita unos %1$@, y TextMouth mantiene libres %2$@. Libera espacio y vuelve a exportar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le disque manque de place : il faut environ %1$@, et TextMouth garde %2$@ de libre. Libérez de l’espace, puis exportez de nouveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "डिस्क में जगह कम है: इसके लिए लगभग %1$@ चाहिए, और TextMouth %2$@ ख़ाली रखता है। कुछ जगह ख़ाली करें, फिर दोबारा निर्यात करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ruang disk tidak cukup: ini memerlukan sekitar %1$@, dan TextMouth menyisakan %2$@ kosong. Kosongkan sebagian ruang, lalu ekspor lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Spazio insufficiente sul disco: servono circa %1$@ e TextMouth ne mantiene %2$@ liberi. Libera dello spazio, poi esporta di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ディスクの空き容量が足りません：これには約%1$@が必要で、TextMouth は%2$@を空けておきます。容量を空けてから、もう一度書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "디스크 공간이 부족합니다. 약 %1$@이(가) 필요하며 TextMouth는 %2$@을(를) 여유 공간으로 유지합니다. 공간을 확보한 다음 다시 내보내십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O disco não tem espaço: isto precisa de cerca de %1$@, e o TextMouth mantém %2$@ livres. Libere espaço e exporte de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "На диске не хватает места: нужно около %1$@, а TextMouth оставляет свободными %2$@. Освободите место и экспортируйте снова."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "На диску бракує місця: потрібно близько %1$@, а TextMouth залишає вільними %2$@. Звільніть місце, а потім експортуйте знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "磁盘空间不足：这需要约 %1$@，而 TextMouth 会保持 %2$@ 可用。请释放一些空间，然后再次导出。"
          }
        }
      }
    },
