    "Tries again to save every change that could not be saved" : {
      "comment" : "VoiceOver hint of the Retry Saving button in Storage settings.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعيد محاولة حفظ كل تغيير تعذّر حفظه"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সংরক্ষণ করা যায়নি এমন প্রতিটি পরিবর্তন আবার সংরক্ষণের চেষ্টা করে"
          }
        },
        "de" : {
