    "originalFileDeletion.deleteAfterImport" : {
      "comment" : "Caption in Storage settings under the choice that deletes the original file after an import, while files are deleted permanently.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سيُحذف الملف الأصلي نهائيًا بعد استيراد ناجح."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সফল আমদানির পর মূল ফাইলটি স্থায়ীভাবে মুছে ফেলা হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Originaldatei wird nach einem erfolgreichen Import endgültig gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The original file will be permanently deleted after a successful import."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo original se eliminará de forma permanente tras una importación correcta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فایل اصلی پس از وارد کردن موفق برای همیشه حذف می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le fichier d’origine sera supprimé définitivement après une importation réussie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
