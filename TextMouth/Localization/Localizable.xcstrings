            "value" : "Nhãn và dấu chấm phẩy cần ffmpeg. Các bộ lọc riêng của TextMouth chỉ nhận một chuỗi phân tách bằng dấu phẩy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
