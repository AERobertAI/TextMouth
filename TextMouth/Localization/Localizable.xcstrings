        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "डेटा फ़ोल्डर नहीं मिल रहा, इसलिए जब तक वह वापस नहीं आता, लॉग %@ में जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
