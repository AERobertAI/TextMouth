          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "চালু থাকলে হেডিং, বুকমার্ক বা অনুসন্ধানের ফলাফলে যাওয়ার পর প্লেব্যাক নিজে থেকে শুরু হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wenn aktiviert, startet die Wiedergabe automatisch nach dem Sprung zu einer Überschrift, einem Lesezeichen oder einem Suchergebnis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, playback starts automatically after jumping to a heading, bookmark, or search result"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si está activado, la reproducción empieza automáticamente después de saltar a un encabezado, un marcador o un resultado de búsqueda"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اگر روشن باشد، پخش پس از رفتن به یک سرفصل، نشانک یا نتیجه جست‌وجو به‌طور خودکار شروع می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si activé, la lecture démarre automatiquement après un saut vers un en-tête, un signet ou un résultat de recherche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כשמופעל, הניגון מתחיל אוטומטית לאחר קפיצה לכותרת, לסימנייה או לתוצאת חיפוש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सक्षम होने पर, किसी हेडिंग, बुकमार्क या खोज परिणाम पर जाने के बाद प्लेबैक अपने आप शुरू होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jika aktif, pemutaran dimulai otomatis setelah melompat ke tajuk, markah, atau hasil pencarian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se attivo, la riproduzione si avvia automaticamente dopo il passaggio a un’intestazione, un segnalibro o un risultato di ricerca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オンにすると、見出し、ブックマーク、検索結果に移動したあと、自動的に再生が始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "활성화하면 표제, 북마크 또는 검색 결과로 이동한 후 자동으로 재생이 시작됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Indien ingeschakeld begint het afspelen automatisch na het springen naar een kop, bladwijzer of zoekresultaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Po włączeniu odtwarzanie rozpoczyna się automatycznie po przejściu do nagłówka, zakładki lub wyniku wyszukiwania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quando ativado, a reprodução começa automaticamente depois de ir para um cabeçalho, um marcador ou um resultado de busca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Если включено, воспроизведение начинается автоматически после перехода к заголовку, закладке или результату поиска."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "När det är aktiverat börjar uppspelningen automatiskt efter ett hopp till en rubrik, ett bokmärke eller ett sökresultat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เมื่อเปิดใช้ การเล่นจะเริ่มอัตโนมัติหลังข้ามไปยังหัวข้อ ที่คั่นหน้า หรือผลการค้นหา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Etkinleştirildiğinde, bir başlığa, yer imine veya arama sonucuna gidildikten sonra oynatma otomatik olarak başlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо увімкнено, відтворення починається автоматично після переходу до заголовка, закладки або результату пошуку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فعال ہونے پر، کسی سرخی، بک مارک یا تلاش کے نتیجے پر جانے کے بعد پلے بیک خود بخود شروع ہو جاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Khi bật, phát lại tự động bắt đầu sau khi chuyển đến một đề mục, dấu trang hoặc kết quả tìm kiếm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "启用后，跳转到章节标题、书签或搜索结果后会自动开始播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "啟用後，前往標題、書籤或搜尋結果後會自動開始播放。"
          }
        }
      }
    },
