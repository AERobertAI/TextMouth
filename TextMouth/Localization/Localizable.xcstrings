        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 만화책 압축 파일에는 TextMouth가 읽을 수 있는 %@개보다 많은 이미지가 들어 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
