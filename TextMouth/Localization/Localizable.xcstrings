    },
    "An episode's details come from its feed; %@ makes it a book you can edit." : {
      "comment" : "The line under the heading of an episode's read-only Book Information sheet: why nothing can be changed, and the way out. %@ is the name of the Move to Library command.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los detalles de un episodio provienen de su canal; %@ lo convierte en un libro que puedes editar."
