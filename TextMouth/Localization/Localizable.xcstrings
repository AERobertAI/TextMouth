    "readingList.orderHint" : {
      "comment" : "VoiceOver hint of the Reading List Order item of the Reading List's Sort menu. Move Book Up and Move Book Down are commands of the Library menu.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحافظ على الترتيب الذي ضبطته بواسطة “نقل الكتاب لأعلى” أو “نقل الكتاب لأسفل” أو السحب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“বইটি উপরে নিন”, “বইটি নিচে নিন” বা টেনে এনে আপনার ঠিক করা ক্রম রাখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Behält die Reihenfolge bei, die du mit „Buch nach oben verschieben“, „Buch nach unten verschieben“ oder durch Ziehen festgelegt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps the order you set with Move Book Up, Move Book Down, or dragging."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mantiene el orden que fijas con Mover libro hacia arriba, Mover libro hacia abajo o arrastrando."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ترتیبی را که با «انتقال کتاب به بالا»، «انتقال کتاب به پایین» یا کشیدن تعیین کرده‌اید نگه می‌دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Garde l’ordre que vous avez défini avec Monter le livre, Descendre le livre ou par glisser-déposer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "שומר את הסדר שקבעת עם “העבר ספר למעלה”, “העבר ספר למטה” או בגרירה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“पुस्तक ऊपर ले जाएँ”, “पुस्तक नीचे ले जाएँ” या खींचकर आपका तय किया हुआ क्रम बनाए रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mempertahankan urutan yang Anda atur dengan Pindahkan Buku ke Atas, Pindahkan Buku ke Bawah, atau dengan menyeret."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mantiene l’ordine impostato con Sposta libro in alto, Sposta libro in basso o trascinando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「ブックを上へ移動」「ブックを下へ移動」またはドラッグで設定した順序を保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책을 위로 이동, 책을 아래로 이동 또는 드래그로 설정한 순서를 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Behoudt de volgorde die je hebt ingesteld met Verplaats boek omhoog, Verplaats boek omlaag of slepen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zachowuje kolejność ustawioną przez Przenieś książkę w górę, Przenieś książkę w dół lub przeciąganie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mantém a ordem definida com Mover livro para cima, Mover livro para baixo ou arrastando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сохраняет порядок, заданный командами «Переместить книгу вверх» и «Переместить книгу вниз» или перетаскиванием."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Behåller ordningen du ställt in med ”Flytta boken uppåt”, ”Flytta boken nedåt” eller genom att dra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "คงลำดับที่คุณตั้งไว้โดยใช้คำสั่ง ย้ายหนังสือขึ้น ย้ายหนังสือลง หรือการลาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitabı Yukarı Taşı, Kitabı Aşağı Taşı veya sürükleyerek belirlediğiniz sırayı korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Зберігає порядок, який ви задали командами «Перемістити книгу вгору», «Перемістити книгу вниз» або перетягуванням."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "وہ ترتیب برقرار رکھتا ہے جو آپ نے “کتاب اوپر منتقل کریں”، “کتاب نیچے منتقل کریں” یا گھسیٹ کر بنائی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Giữ thứ tự bạn đã đặt bằng các lệnh Di chuyển sách lên, Di chuyển sách xuống, hoặc bằng cách kéo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "保留你用“上移图书”、“下移图书”或拖移设定的顺序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "保留你用「將書籍上移」、「將書籍下移」或拖移所設定的順序。"
          }
        }
      }
    },
