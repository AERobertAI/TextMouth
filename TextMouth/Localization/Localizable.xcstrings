        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo libro non conserva alcun audio originale: le modifiche salvate cambiano direttamente il suo audio e poi non si possono annullare."
          }
        }
      }
    },
    "This book was exported from TextMouth as text only." : {
      "comment" : "The first sentence of the accessibility summary written into an exported EPUB.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este libro se exportó desde TextMouth solo como texto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo libro è stato esportato da TextMouth solo come testo."
          }
        }
      }
    },
    "This book was not opened from the reading list." : {
      "comment" : "VoiceOver announcement when Next in Reading List or Previous in Reading List is used in a reader whose book was not opened from the reading list.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este libro no se abrió desde la lista de lectura."
