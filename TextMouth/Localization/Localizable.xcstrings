    "storageWorkWait.sentence.unsaved" : {
      "comment" : "Why a failed save stays unsaved: TextMouth is switching to another library. \"They\" is the changes that could not be saved.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يُعاد فتح TextMouth على مكتبة أخرى، لذا تبقى غير محفوظة في هذه المكتبة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth অন্য একটি লাইব্রেরিতে আবার খুলছে, তাই এই লাইব্রেরিতে সেগুলো অসংরক্ষিত থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth wird erneut mit einer anderen Bibliothek geöffnet, daher bleiben sie in dieser ungesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth is opening again on another library, so they stay unsaved in this one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth se está abriendo de nuevo con otra biblioteca, así que siguen sin guardarse en esta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth دوباره روی کتابخانه‌ای دیگر باز می‌شود، بنابراین آن‌ها در این کتابخانه ذخیره‌نشده می‌مانند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth se rouvre sur une autre bibliothèque ; elles restent donc non enregistrées dans celle-ci."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth נפתח מחדש עם ספרייה אחרת, ולכן הם נשארים לא שמורים בזו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth दूसरी लाइब्रेरी पर फिर से खुल रहा है, इसलिए वे इसमें बिना सहेजे रह जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
