    "recording.noSound" : {
      "comment" : "Said by the Record window when a recording has held nothing but silence for a few seconds. %@ is the name of the microphone.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يصدر صوت من %@. تأكد من أن الميكروفون يعمل وغير مكتوم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ থেকে কোনো শব্দ আসছে না। মাইক্রোফোন চালু আছে এবং মিউট করা নেই কি না দেখুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kein Ton von %@. Prüfe, ob das Mikrofon eingeschaltet und nicht stummgeschaltet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No sound from %@. Check that the microphone is on and not muted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay sonido de %@. Comprueba que el micrófono esté encendido y no silenciado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صدایی از %@ نمی‌آید. بررسی کنید که میکروفون روشن باشد و بی‌صدا نشده باشد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucun son de %@. Vérifiez que le microphone est allumé et non coupé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אין צליל מ-%@. ודא שהמיקרופון פועל ואינו מושתק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ से कोई ध्वनि नहीं आ रही। जाँचें कि माइक्रोफ़ोन चालू है और म्यूट नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tidak ada suara dari %@. Pastikan mikrofon menyala dan tidak dibisukan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nessun suono da %@. Controlla che il microfono sia acceso e non silenziato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@から音が入っていません。マイクがオンで、ミュートされていないことを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@에서 소리가 들어오지 않습니다. 마이크가 켜져 있고 음소거되지 않았는지 확인하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Geen geluid van %@. Controleer of de microfoon aanstaat en niet is gedempt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Brak dźwięku z mikrofonu %@. Sprawdź, czy mikrofon jest włączony i nie jest wyciszony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nenhum som de %@. Verifique se o microfone está ligado e não está silenciado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Нет звука от микрофона «%@». Проверьте, что микрофон включён и звук не отключён."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Inget ljud från %@. Kontrollera att mikrofonen är påslagen och att ljudet inte är avstängt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไม่มีเสียงจาก %@ ตรวจสอบว่าไมโครโฟนเปิดอยู่และไม่ได้ปิดเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ üzerinden ses gelmiyor. Mikrofonun açık olduğunu ve sessize alınmadığını denetleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Від %@ немає звуку. Перевірте, що мікрофон увімкнено й звук не вимкнено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ سے کوئی آواز نہیں آ رہی۔ جانچ لیں کہ مائیکروفون آن ہے اور خاموش نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không có âm thanh từ %@. Hãy kiểm tra micrô đã bật và chưa bị tắt tiếng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "没有从 %@ 收到声音。请检查麦克风是否已打开且未静音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 沒有聲音。請檢查麥克風是否已開啟且未靜音。"
          }
        }
      }
    },
    "recording.openInReaderHint" : {
      "comment" : "VoiceOver hint of the Open in Reader button of the Record window. %@ is the saved recording's title.",
