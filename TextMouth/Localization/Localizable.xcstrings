        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 是訂閱源的項目，訂閱源的項目無法移動。"
          }
        }
      }
    },
    "manualBookOrder.noArrangedOrder.choose" : {
      "comment" : "Second sentence of the announcement when Move Book Up or Move Book Down is used in a folder that is not in manual order. %@ is the name of the Manual Order sort, a choice in the Sort menu.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اختر %@ من قائمة الترتيب، ثم حاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সাজানোর মেনুতে %@ বেছে নিন, তারপর আবার চেষ্টা করুন।"
