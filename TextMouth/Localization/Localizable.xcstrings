            "value" : "濾波器預設組合"
          }
        }
      }
    },
    "audioFilterRunner.coefficients.frequency" : {
      "comment" : "What a frequency option of a filter accepts, said at the end of a refusal such as \"The highpass filter's frequency can't be “x”: <this>.\" Written without its full stop. %@ is half the audio's sample rate, in hertz, written without digit grouping.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أدخل تردّدًا أقل من نصف معدل أخذ العينات للصوت، %@ هرتز"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "অডিওর স্যাম্পল রেটের অর্ধেকের নিচে একটি ফ্রিকোয়েন্সি দিন, %@ Hz"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "gib eine Frequenz unterhalb der halben Abtastrate des Audios an, %@ Hz"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "give a frequency below half the audio's sample rate, %@ Hz"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "indica una frecuencia por debajo de la mitad de la tasa de muestreo del audio, %@ Hz"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بسامدی کمتر از نصف نرخ نمونه‌برداری صدا، یعنی %@ هرتز، وارد کنید"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "indiquez une fréquence inférieure à la moitié de la fréquence d’échantillonnage de l’audio, %@ Hz"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הזן תדר מתחת למחצית קצב הדגימה של השמע, %@ הרץ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ऑडियो की सैंपल दर के आधे से कम फ़्रीक्वेंसी दें, %@ Hz"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "berikan frekuensi di bawah setengah laju sampel audio, %@ Hz"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "indica una frequenza inferiore a metà della frequenza di campionamento dell’audio, %@ Hz"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オーディオのサンプルレートの半分（%@ Hz）未満の周波数を指定してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "오디오 샘플 레이트의 절반(%@ Hz) 미만인 주파수를 지정하십시오"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "geef een frequentie onder de helft van de samplefrequentie van de audio, %@ Hz"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "podaj częstotliwość poniżej połowy częstotliwości próbkowania dźwięku, %@ Hz"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "informe uma frequência abaixo da metade da taxa de amostragem do áudio, %@ Hz"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "укажите частоту ниже половины частоты дискретизации аудио, %@ Гц"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ange en frekvens under hälften av ljudets samplingsfrekvens, %@ Hz"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ระบุความถี่ที่ต่ำกว่าครึ่งหนึ่งของอัตราสุ่มตัวอย่างของเสียง คือ %@ Hz"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "sesin örnekleme hızının yarısından düşük bir frekans verin, %@ Hz"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "вкажіть частоту нижче за половину частоти дискретизації аудіо, %@ Гц"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ایسی فریکوئنسی دیں جو آڈیو کے سیمپل ریٹ کے آدھے سے کم ہو، %@ Hz"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "hãy nhập tần số dưới một nửa tốc độ lấy mẫu của âm thanh, %@ Hz"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "请给出低于音频采样率一半（%@ Hz）的频率"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "請提供低於音訊取樣率一半的頻率，也就是 %@ Hz 以下"
          }
        }
      }
    },
    "audioFilterRunner.coefficients.narrower" : {
      "comment" : "What a width option of a filter accepts, said at the end of a refusal such as \"The equalizer filter's width can't be “x”: <this>.\" Written without its full stop. %@ is the filter's frequency in hertz, already written.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أدخل عرضًا أضيق، لأن هذا العرض لا ينتج مرشحًا صالحًا للاستخدام عند %@ هرتز"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আরও সংকীর্ণ প্রস্থ দিন, কারণ এটি %@ Hz-এ ব্যবহারযোগ্য কোনো ফিল্টার বানায় না"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "gib eine schmalere Breite an, da diese bei %@ Hz keinen brauchbaren Filter ergibt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "give a narrower width, since this one makes no usable filter at %@ Hz"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "indica un ancho menor, ya que este no produce un filtro utilizable a %@ Hz"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عرض باریک‌تری وارد کنید، چون این عرض در %@ هرتز فیلتر قابل استفاده‌ای نمی‌سازد"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "indiquez une largeur plus étroite, car celle-ci ne donne aucun filtre utilisable à %@ Hz"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הזן רוחב צר יותר, כי הרוחב הזה אינו יוצר מסנן שמיש ב-%@ הרץ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कम चौड़ाई दें, क्योंकि यह चौड़ाई %@ Hz पर कोई उपयोगी फ़िल्टर नहीं बनाती"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "berikan lebar yang lebih sempit, karena lebar ini tidak menghasilkan filter yang dapat dipakai pada %@ Hz"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "indica una larghezza minore, perché questa non produce alcun filtro utilizzabile a %@ Hz"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "この幅では %@ Hz で使えるフィルタにならないため、もっと狭い幅を指定してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "더 좁은 폭을 지정하십시오. 이 폭으로는 %@ Hz에서 사용할 수 있는 필터가 만들어지지 않습니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "geef een smallere breedte, want deze levert bij %@ Hz geen bruikbaar filter op"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "podaj węższą szerokość, ponieważ ta nie daje użytecznego filtra przy %@ Hz"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "informe uma largura menor, pois esta não gera um filtro utilizável em %@ Hz"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "укажите более узкую ширину: при частоте %@ Гц с такой шириной фильтр не получится"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ange en smalare bredd, eftersom den här inte ger något användbart filter vid %@ Hz"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ระบุความกว้างที่แคบกว่านี้ เพราะค่านี้ใช้เป็นตัวกรองที่ %@ Hz ไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "daha dar bir genişlik verin; bu genişlik %@ Hz'de kullanılabilir bir filtre oluşturmuyor"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "вкажіть вужчу ширину, бо ця не дає придатного фільтра на %@ Гц"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کم چوڑائی دیں، کیونکہ یہ چوڑائی %@ Hz پر کوئی قابل استعمال فلٹر نہیں بناتی"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "hãy nhập độ rộng hẹp hơn, vì độ rộng này không tạo ra bộ lọc dùng được tại %@ Hz"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "请给出更窄的宽度，因为此宽度在 %@ Hz 下无法构成可用的滤波器"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "請提供較窄的寬度，因為這個寬度在 %@ Hz 無法形成可用的濾波器"
          }
        }
      }
    },
    "audioInputPermissionError.denied" : {
      "comment" : "Error in the Record window when macOS has denied TextMouth the microphone. Names the places in System Settings, as macOS words them, where the user can allow it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "غير مسموح لـ TextMouth باستخدام الميكروفون. فعّله في إعدادات النظام، الخصوصية والأمن، الميكروفون."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth-কে মাইক্রোফোন ব্যবহারের অনুমতি দেওয়া হয়নি। সিস্টেম সেটিংস, গোপনীয়তা ও নিরাপত্তা, মাইক্রোফোনে এটি চালু করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth darf das Mikrofon nicht verwenden. Aktiviere es in den Systemeinstellungen unter „Datenschutz & Sicherheit“, „Mikrofon“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth isn't allowed to use the microphone. Turn it on in System Settings, Privacy & Security, Microphone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no tiene permiso para usar el micrófono. Actívalo en Ajustes del Sistema, Privacidad y seguridad, Micrófono."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth اجازه استفاده از میکروفون را ندارد. آن را در System Settings، Privacy & Security، Microphone روشن کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth n’a pas l’autorisation d’utiliser le microphone. Activez-la dans Réglages Système, Confidentialité et sécurité, Microphone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ל-TextMouth אין הרשאה להשתמש במיקרופון. הפעל אותה בהגדרות המערכת, “פרטיות ואבטחה”, “מיקרופון”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth को माइक्रोफ़ोन इस्तेमाल करने की अनुमति नहीं है। इसे सिस्टम सेटिंग, गोपनीयता और सुरक्षा, माइक्रोफ़ोन में चालू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tidak diizinkan memakai mikrofon. Aktifkan di Pengaturan Sistem, Privasi & Keamanan, Mikrofon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non può usare il microfono. Attivalo in Impostazioni di Sistema, Privacy e sicurezza, Microfono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth はマイクの使用を許可されていません。「システム設定」の「プライバシーとセキュリティ」の「マイク」でオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 마이크를 사용할 수 있도록 허용되어 있지 않습니다. 시스템 설정, 개인정보 보호 및 보안, 마이크에서 켜십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth mag de microfoon niet gebruiken. Schakel dit in via Systeeminstellingen, Privacy en beveiliging, Microfoon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth nie ma dostępu do mikrofonu. Włącz go w: Ustawienia systemowe, Prywatność i ochrona, Mikrofon."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não tem permissão para usar o microfone. Ative em Ajustes do Sistema, Privacidade e Segurança, Microfone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не разрешено использовать микрофон. Включите доступ в разделе «Системные настройки», «Конфиденциальность и безопасность», «Микрофон»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth får inte använda mikrofonen. Slå på det i Systeminställningar, Integritet och säkerhet, Mikrofon."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ไม่ได้รับอนุญาตให้ใช้ไมโครโฟน ให้เปิดในการตั้งค่าระบบ ความเป็นส่วนตัวและความปลอดภัย ไมโครโฟน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth'un mikrofonu kullanmasına izin verilmedi. Sistem Ayarları, Gizlilik ve Güvenlik, Mikrofon bölümünden açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не має дозволу користуватися мікрофоном. Увімкніть його: Системні параметри, Приватність і безпека, Мікрофон."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth کو مائیکروفون استعمال کرنے کی اجازت نہیں ہے۔ اسے سسٹم ترتیبات، رازداری اور سلامتی، مائیکروفون میں آن کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth không được phép dùng micrô. Hãy bật trong Cài đặt hệ thống, Quyền riêng tư & Bảo mật, Micrô."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 无权使用麦克风。请在“系统设置”的“隐私与安全性”中，于“麦克风”打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 未獲允許使用麥克風。請在「系統設定」的「隱私權與安全性」中，於「麥克風」開啟。"
          }
        }
      }
    },
    "audioInputPermissionError.restricted" : {
      "comment" : "Error in the Record window when something other than the user, a device management profile or Screen Time, keeps TextMouth from using the microphone.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يسمح هذا الـ Mac لـ TextMouth باستخدام الميكروفون: ملف تعريف لإدارة الأجهزة أو مدة استخدام الجهاز يقيّده."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই Mac TextMouth-কে মাইক্রোফোন ব্যবহার করতে দেয় না: একটি ডিভাইস ম্যানেজমেন্ট প্রোফাইল বা স্ক্রিন টাইম এটি সীমিত করেছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieser Mac erlaubt TextMouth nicht, das Mikrofon zu verwenden: Ein Geräteverwaltungsprofil oder die Bildschirmzeit schränkt es ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac doesn't allow TextMouth to use the microphone: a device management profile or Screen Time restricts it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta Mac no permite que TextMouth use el micrófono: un perfil de administración de dispositivos o Tiempo en pantalla lo restringe."
          }
        },
