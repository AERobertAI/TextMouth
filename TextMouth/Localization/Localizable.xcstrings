    "substitutions.regexHint" : {
      "comment" : "VoiceOver hint of the Regular expression switch in the substitution rule editor. \\b is regular expression syntax and stays as written.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عند التفعيل، استخدم \\b في النمط لحدود الكلمات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "চালু থাকলে প্যাটার্নে শব্দের সীমানার জন্য \\b ব্যবহার করা যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wenn aktiviert, verwende \\b im Muster für Wortgrenzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, use \\b in the pattern for word boundaries"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si está activado, usa \\b en el patrón para los límites de palabra"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اگر روشن باشد، برای مرز کلمه‌ها در الگو از \\b استفاده کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si activé, utilisez \\b dans le motif pour les limites de mot."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כשמופעל, השתמש ב-\\b בתבנית לגבולות מילים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सक्षम होने पर, शब्द की सीमाओं के लिए पैटर्न में \\b का उपयोग करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jika aktif, gunakan \\b dalam pola untuk batas kata."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se attivo, usa \\b nel modello per indicare i confini di parola."
          }
        },
        "ja" : {
          "stringUnit" : {
