    "Another view is already named %@. Choose another name." : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. Save's problem with a name another view has. Placeholders in order: name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يوجد عرض آخر باسم %@. اختر اسمًا آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eine andere Ansicht heißt bereits %@. Wähle einen anderen Namen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ya hay otra vista llamada %@. Elige otro nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une autre vue s’appelle déjà %@. Choisissez un autre nom."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "एक और दृश्य का नाम पहले से %@ है। कोई दूसरा नाम चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tampilan lain sudah bernama %@. Pilih nama lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un’altra vista si chiama già %@. Scegli un altro nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "すでに%@という名前の別のビューがあります。別の名前を選択してください。"
