        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cao độ mặc định cho sách mới. 1.0 là bình thường. Mỗi sách có thể ghi đè giá trị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
