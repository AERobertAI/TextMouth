    "sync.anotherStore" : {
      "comment" : "Shown when the sync folder now belongs to another library's sync. Join Sync Folder is a button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحتوي مجلد المزامنة الآن على مزامنة مكتبة أخرى. اختر «الانضمام إلى مجلد المزامنة» مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সিঙ্ক ফোল্ডারে এখন অন্য একটি লাইব্রেরির সিঙ্ক আছে। আবার “সিঙ্ক ফোল্ডারে যোগ দিন” বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Synchronisierungsordner enthält jetzt die Synchronisierung einer anderen Bibliothek. Wähle erneut „Synchronisierungsordner beitreten“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sync folder now holds another library's sync. Choose Join Sync Folder again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La carpeta de sincronización ahora contiene la sincronización de otra biblioteca. Elige Unirse a la carpeta de sincronización otra vez."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پوشهٔ همگام‌سازی اکنون همگام‌سازی کتابخانهٔ دیگری را دارد. دوباره «پیوستن به پوشهٔ همگام‌سازی» را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le dossier de synchronisation contient maintenant la synchronisation d’une autre bibliothèque. Choisissez de nouveau Rejoindre le dossier de synchronisation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "תיקיית הסנכרון מכילה כעת סנכרון של ספרייה אחרת. בחר שוב ב-“הצטרף לתיקיית סנכרון”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सिंक फ़ोल्डर में अब किसी दूसरी लाइब्रेरी का सिंक है। “सिंक फ़ोल्डर से जुड़ें” फिर से चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Folder sinkronisasi kini berisi sinkronisasi pustaka lain. Pilih Gabung ke Folder Sinkronisasi lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La cartella di sincronizzazione ora contiene la sincronizzazione di un’altra libreria. Scegli di nuovo Unisciti alla cartella di sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "同期フォルダに、別のライブラリの同期データが入っています。「同期フォルダに参加」をもう一度選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "동기화 폴더에 다른 보관함의 동기화 내용이 들어 있습니다. “동기화 폴더에 참여”를 다시 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De synchronisatiemap bevat nu de synchronisatie van een andere bibliotheek. Kies opnieuw Sluit aan bij synchronisatiemap."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Folder synchronizacji zawiera teraz synchronizację innej biblioteki. Wybierz ponownie Dołącz do folderu synchronizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A pasta de sincronização agora contém a sincronização de outra biblioteca. Escolha Entrar na pasta de sincronização novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В папке синхронизации теперь синхронизация другой библиотеки. Выберите «Подключиться к папке синхронизации» ещё раз."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Synkroniseringsmappen innehåller nu ett annat biblioteks synkronisering. Välj Anslut till synkroniseringsmapp igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "โฟลเดอร์ซิงค์ตอนนี้มีการซิงค์ของไลบรารีอื่นอยู่ เลือก “เข้าร่วมโฟลเดอร์ซิงค์” อีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eşzamanlama klasörü artık başka bir kitaplığın eşzamanlamasını içeriyor. Eşzamanlama Klasörüne Katıl seçeneğini yeniden seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "У папці синхронізації тепер синхронізація іншої бібліотеки. Виберіть ще раз «Приєднатися до папки синхронізації»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سنک فولڈر میں اب کسی اور لائبریری کا سنک ہے۔ “سنک فولڈر میں شامل ہوں” دوبارہ منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thư mục đồng bộ hiện chứa bản đồng bộ của một thư viện khác. Hãy chọn lại Tham gia thư mục đồng bộ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "同步文件夹现在存放的是另一个资料库的同步内容。请再次选取“加入同步文件夹”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "同步檔案夾現在存放的是另一個書庫的同步內容。請再次選擇「加入同步檔案夾」。"
          }
        }
      }
    },
