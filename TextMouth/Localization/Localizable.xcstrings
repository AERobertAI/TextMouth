    "transcription.attachPanelMessage" : {
      "comment" : "Message of the file panel opened by Attach Transcript. %@ is the audiobook's title. WebVTT and SubRip are subtitle file formats, and .vtt and .srt their file extensions.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اختر نسخة نصية لـ%@ بصيغة WebVTT (.vtt) أو SubRip (.srt)، موقّتة من بداية صوته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@-এর একটি WebVTT (.vtt) বা SubRip (.srt) ট্রান্সক্রিপ্ট বেছে নিন, যার সময় অডিওর শুরু থেকে গোনা।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wähle ein WebVTT-Transkript (.vtt) oder SubRip-Transkript (.srt) von %@, mit Zeitangaben ab dem Anfang des Audios."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a WebVTT (.vtt) or SubRip (.srt) transcript of %@, timed from the start of its audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige una transcripción WebVTT (.vtt) o SubRip (.srt) de %@, con tiempos desde el inicio de su audio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "رونوشت WebVTT (.vtt) یا SubRip (.srt) را برای %@ انتخاب کنید که از ابتدای صدای آن زمان‌بندی شده باشد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisissez une transcription WebVTT (.vtt) ou SubRip (.srt) de %@, minutée à partir du début de son audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בחר תמליל WebVTT (.vtt) או SubRip (.srt) של %@, בתזמון מתחילת השמע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ की WebVTT (.vtt) या SubRip (.srt) ट्रांसक्रिप्ट चुनें, जिसका समय उसके ऑडियो की शुरुआत से गिना गया हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pilih transkrip WebVTT (.vtt) atau SubRip (.srt) untuk %@, dengan waktu dihitung dari awal audionya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scegli una trascrizione WebVTT (.vtt) o SubRip (.srt) di %@, temporizzata dall’inizio dell’audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@の、オーディオの先頭からの時刻が付いた WebVTT（.vtt）または SubRip（.srt）形式の文字起こしを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "오디오 시작부터 시간이 지정된 %@의 WebVTT(.vtt) 또는 SubRip(.srt) 대본을 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kies een WebVTT-transcriptie (.vtt) of SubRip-transcriptie (.srt) van %@, getimed vanaf het begin van de audio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wybierz transkrypcję WebVTT (.vtt) lub SubRip (.srt) audiobooka %@, z czasem liczonym od początku jego dźwięku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escolha uma transcrição WebVTT (.vtt) ou SubRip (.srt) de %@, com tempos contados a partir do início do áudio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Выберите расшифровку аудиокниги «%@» в формате WebVTT (.vtt) или SubRip (.srt) с временными метками от начала аудио."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Välj en transkription av %@ i WebVTT-format (.vtt) eller SubRip-format (.srt), tidsatt från ljudets början."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เลือกข้อความถอดเสียง WebVTT (.vtt) หรือ SubRip (.srt) ของ %@ ที่กำหนดเวลานับจากจุดเริ่มต้นของเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ için, sesin başından itibaren zamanlanmış bir WebVTT (.vtt) veya SubRip (.srt) transkripti seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Виберіть транскрипцію %@ у форматі WebVTT (.vtt) або SubRip (.srt) із часом, відліченим від початку аудіо."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ کا WebVTT (vtt) یا SubRip (srt) ٹرانسکرپٹ منتخب کریں، جس کا وقت اس کے آڈیو کی ابتدا سے ناپا گیا ہو۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chọn bản chép lời WebVTT (.vtt) hoặc SubRip (.srt) của %@, có mốc thời gian tính từ đầu âm thanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "为“%@”选取一个 WebVTT（.vtt）或 SubRip（.srt）文字稿，时间从其音频开头算起。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "請選擇「%@」的 WebVTT（.vtt）或 SubRip（.srt）逐字稿，時間需從其音訊開頭起算。"
          }
        }
      }
    },
