    "miscellaneousSettings.restartGestureExplanation" : {
      "comment" : "Explanation under the Enable restart-timer gesture switch in the Miscellaneous settings. AirPods is a product name and stays as written.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تجريبي. تسلسل من مفاتيح الوسائط أو عناصر تحكم AirPods خلال فترة زمنية قصيرة يعيد تفعيل آخر مؤقت نوم، وهو مفيد بعد انتهاء أحدها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পরীক্ষামূলক। অল্প সময়ের মধ্যে মিডিয়া কী বা AirPods নিয়ন্ত্রণের একটি ক্রম শেষ স্লিপ টাইমারটি আবার চালু করে, যা মেয়াদ শেষ হওয়ার পর কাজে আসে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Experimentell. Eine Folge von Befehlen über Medientasten oder AirPods innerhalb kurzer Zeit startet den zuletzt verwendeten Einschlaf-Timer neu – praktisch, nachdem er abgelaufen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimental. A sequence of media keys or AirPods controls within a short time window re-arms the last sleep timer, handy after one expires."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Experimental. Una secuencia de teclas multimedia o controles de AirPods dentro de una ventana de tiempo corta reactiva el último temporizador de apagado, útil cuando uno acaba de expirar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آزمایشی. دنباله‌ای از کلیدهای رسانه یا کنترل‌های AirPods در یک بازه زمانی کوتاه، آخرین زمان‌سنج خواب را دوباره شروع می‌کند؛ پس از پایان یک زمان‌سنج مفید است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Expérimental. Une séquence de touches multimédias ou de commandes AirPods dans une courte fenêtre de temps réarme le dernier minuteur de mise en veille, pratique après son expiration."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ניסיוני. רצף של מקשי מדיה או פקדי AirPods בחלון זמן קצר מפעיל מחדש את טיימר השינה האחרון, שימושי אחרי שאחד פג."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "प्रायोगिक। थोड़े समय के भीतर मीडिया कीज़ या AirPods कंट्रोल का क्रम पिछले स्लीप टाइमर को फिर से सक्रिय कर देता है, जो किसी टाइमर के समाप्त होने के बाद काम आता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eksperimental. Urutan tombol media atau kontrol AirPods dalam jangka waktu singkat mengaktifkan kembali timer tidur terakhir, berguna setelah timer berakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sperimentale. Una sequenza di tasti multimediali o di controlli degli AirPods in un breve intervallo di tempo riattiva l’ultimo timer di spegnimento, utile dopo che uno è scaduto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "実験的機能。短い時間内にメディアキーまたは AirPods の操作を順に行うと、直前のスリープタイマーを再設定します。タイマーが切れたあとに便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "실험적 기능입니다. 짧은 시간 안에 미디어 키 또는 AirPods 제어를 순서대로 사용하면 마지막 취침 타이머를 다시 설정합니다. 타이머가 끝난 후에 편리합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Experimenteel. Een reeks mediatoetsen of AirPods-bedieningen binnen korte tijd activeert de laatste slaaptimer opnieuw, handig nadat er een is verlopen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Funkcja eksperymentalna. Sekwencja klawiszy multimedialnych lub elementów sterujących AirPods w krótkim czasie ponownie włącza ostatni wyłącznik czasowy, co jest przydatne po jego wygaśnięciu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Experimental. Uma sequência de teclas de mídia ou de controles dos AirPods em uma curta janela de tempo rearma o último timer de repouso, o que ajuda depois que um expira."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Экспериментальная функция. Последовательность клавиш мультимедиа или жестов AirPods за короткое время заново включает последний таймер сна — удобно, когда он только что сработал."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Experimentell. En sekvens av mediatangenter eller AirPods-kontroller inom ett kort tidsfönster återaktiverar den senaste insomningstimern, bra när en timer har gått ut."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ฟีเจอร์ทดลอง ลำดับปุ่มสื่อหรือตัวควบคุม AirPods ภายในช่วงเวลาสั้น ๆ จะตั้งตัวตั้งเวลาปิดครั้งล่าสุดใหม่ ใช้สะดวกหลังตัวตั้งเวลาหมดลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deneysel. Kısa bir süre içinde bir dizi medya tuşu veya AirPods denetimi, son uyku zamanlayıcısını yeniden kurar; bir zamanlayıcı bittiğinde işe yarar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Експериментальна функція. Послідовність медіаклавіш або елементів керування AirPods за короткий проміжок часу знову запускає останній таймер сну, що зручно після його спрацювання."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تجرباتی۔ مختصر وقت میں میڈیا کیز یا AirPods کنٹرولز کی ترتیب آخری سلیپ ٹائمر کو دوبارہ لگا دیتی ہے، جو ٹائمر ختم ہونے کے بعد کام آتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thử nghiệm. Một chuỗi phím đa phương tiện hoặc điều khiển AirPods trong một khoảng thời gian ngắn sẽ khởi động lại hẹn giờ ngủ gần nhất, tiện khi một bộ hẹn giờ vừa hết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "实验性功能。在短时间内依次使用媒体键或 AirPods 控制，会重新启用上一个睡眠定时器，适合在定时器到期后使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "實驗性功能。在短時間內連續按下媒體按鍵或操作 AirPods，會重新啟用上一個睡眠計時器，在計時器到期後很方便。"
          }
        }
      }
    },
