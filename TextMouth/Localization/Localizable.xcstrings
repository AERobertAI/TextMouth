          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Микрофон не подключён. Подключите его, чтобы записывать поверх."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
