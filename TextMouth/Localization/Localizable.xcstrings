    "Edit Text has stopped for %@, since a new copy replaced it." : {
      "comment" : "First sentence of the announcement when an Edit Text session ends because Replace Existing put a new copy in the book's place. %@ is the book's title. Edit Text is a menu command.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "توقف تحرير النص لـ %@ لأن نسخة جديدة حلّت محله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„Text bearbeiten“ wurde für %@ beendet, weil eine neue Kopie ihn ersetzt hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Editar texto se detuvo para %@, porque una copia nueva lo reemplazó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Modifier le texte s’est arrêté pour %@, car une nouvelle copie l’a remplacé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ के लिए \"टेक्स्ट संपादित करें\" रुक गया है, क्योंकि उसकी जगह नई प्रति आ गई है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Edit Teks dihentikan untuk %@, karena salinan baru menggantikannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Modifica testo si è interrotto per %@, perché una nuova copia l’ha sostituito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "新しいコピーに置き換えられたため、%@のテキスト編集を終了しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "새 사본이 대체했으므로 %@의 텍스트 편집이 중지되었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A edição do texto de %@ foi interrompida, pois uma nova cópia tomou seu lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Изменение текста для «%@» остановлено, так как новая копия заменила прежнюю."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Редагування тексту «%@» зупинено, бо його замінила нова копія."
          }
