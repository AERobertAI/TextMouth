          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "وقتی انتخاب شده باشد، تطابق‌ها باید حروف بزرگ و کوچک یکسان داشته باشند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si coché, les correspondances doivent respecter les majuscules et minuscules."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כשמסומן, ההתאמות חייבות להשתמש באותן אותיות רישיות וקטנות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चालू होने पर, मिलान में बड़े-छोटे अक्षर समान होने चाहिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saat dicentang, kecocokan harus menggunakan huruf besar dan kecil yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se selezionata, le corrispondenze devono usare le stesse maiuscole e minuscole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オンにすると、一致は大文字と小文字が同じでなければなりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "선택하면 일치 항목에 대소문자가 같아야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Indien aangevinkt moeten treffers dezelfde hoofdletters en kleine letters hebben."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gdy ta opcja jest zaznaczona, trafienia muszą mieć taką samą wielkość liter."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quando marcada, as correspondências precisam usar as mesmas maiúsculas e minúsculas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Если флажок установлен, совпадения должны иметь тот же регистр букв."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "När den är markerad måste träffarna ha samma stora och små bokstäver."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เมื่อเลือกไว้ รายการที่ตรงกันต้องมีตัวพิมพ์ใหญ่เล็กเหมือนกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "İşaretliyken eşleşmeler aynı büyük ve küçük harfleri kullanmalıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо позначено, у збігах враховується регістр літер."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جب منتخب ہو تو مماثلتوں میں بڑے اور چھوٹے حروف ایک جیسے ہونے چاہییں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Khi chọn, các kết quả khớp phải có cùng chữ hoa và chữ thường."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "勾选后，匹配项必须使用相同的大小写。"
