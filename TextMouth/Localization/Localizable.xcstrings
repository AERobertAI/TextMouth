            "value" : "Bleiben vorerst (%1$@), bis die Kopien in iCloud Drive bestätigt sind: %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staying on %@ for now, until iCloud Drive's copies are confirmed: %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se quedan en %1$@ por ahora, hasta confirmar las copias de iCloud Drive: %2$@."
