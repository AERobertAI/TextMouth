    "storageSettings.redoExtractionHint" : {
      "comment" : "VoiceOver hint of the Redo Text Extraction button in Storage settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعيد استخراج النص المخزّن مؤقتًا من كل الكتب. مفيد بعد إصلاحات المحلل أو تحسينات التنسيقات."
          }
