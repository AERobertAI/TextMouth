        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "<!-- page: … -->는 각각 페이지가 시작되는 위치를 표시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cada <!-- page: … --> marca onde uma página começa."
