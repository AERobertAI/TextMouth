          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A gravação como foi feita, antes de qualquer edição."
          }
        }
      }
    },
    "The recording couldn't be converted to an audiobook file." : {
      "comment" : "Error in the Record window when saving: the recording could not be encoded as an audiobook file.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Aufnahme konnte nicht in eine Hörbuchdatei umgewandelt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo convertir la grabación en un archivo de audiolibro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’enregistrement n’a pas pu être converti en fichier de livre audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile convertire la registrazione in un file audiolibro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não foi possível converter a gravação em um arquivo de audiolivro."
          }
        }
      }
    },
    "The recording couldn't be finished properly. What was recorded is kept." : {
      "comment" : "Error in the Record window when stopping could not finish the recording's file properly.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Aufnahme konnte nicht ordnungsgemäß abgeschlossen werden. Das Aufgenommene bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo terminar bien la grabación. Lo grabado se conserva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’enregistrement n’a pas pu être terminé correctement. Ce qui a été enregistré est conservé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile completare correttamente la registrazione. Quanto registrato è stato conservato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não foi possível finalizar a gravação corretamente. O que foi gravado foi mantido."
          }
        }
      }
    },
    "The recording couldn't be saved: %@ It is kept; choose %@ or %@." : {
      "comment" : "Status line and announcement of the Record window when saving a recording failed. %1$@ is the reason, a whole sentence that ends with its own full stop, %2$@ is the title of the button that tries again, and %3$@ is the title of the button that deletes the recording.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Aufnahme konnte nicht gesichert werden: %1$@ Sie bleibt erhalten; wähle „%2$@“ oder „%3$@“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The recording couldn't be saved: %1$@ It is kept; choose %2$@ or %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo guardar la grabación: %1$@ Se conserva; elige %2$@ o %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’enregistrement n’a pas pu être enregistré : %1$@ Il est conservé ; choisissez %2$@ ou %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile salvare la registrazione: %1$@ È stata conservata; scegli %2$@ oppure %3$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não foi possível salvar a gravação: %1$@ Ela foi mantida; escolha %2$@ ou %3$@."
          }
        }
      }
    },
    "The recording lasts %@." : {
      "comment" : "Second sentence of that refusal. %@ is the recording's length spoken in words, such as \"9 hours, 41 minutes, 7 seconds\".",
      "localizations" : {
