      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يُحتسب The Hobbit تحت الحرف H عند الكتابة. تحتفظ القائمة بترتيبها وتعرض كل عنوان كما كُتب."
          }
        },
        "bn" : {
          "stringUnit" : {
