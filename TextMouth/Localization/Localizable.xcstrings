          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mikrofon yang terakhir dipakai TextMouth tidak tersambung, sehingga rekaman memakai %@."
          }
        },
        "it" : {
          "stringUnit" : {
