    "daisyArchive.originalKept.audio" : {
      "comment" : "Notice after the audio of a DAISY book was imported from an archive that keeps its text, so the original file was kept. %1$@ is the book's title and %2$@ the archive's file name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم الاحتفاظ بالملف الأصلي: استورد TextMouth صوت “%1$@” من الأرشيف “%2$@”، والأرشيف هو النسخة الوحيدة من نصه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "মূল ফাইলটি রাখা হয়েছে: TextMouth “%2$@” আর্কাইভ থেকে “%1$@”-এর অডিও আমদানি করেছে, এবং আর্কাইভটিই এর টেক্সটের একমাত্র কপি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Originaldatei wurde behalten: TextMouth hat das Audio von „%1$@“ aus dem Archiv „%2$@“ importiert, und das Archiv ist die einzige Kopie seines Textes."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The original file was kept: TextMouth imported the audio of “%@” from the archive “%@”, and the archive is the only copy of its text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se conservó el archivo original: TextMouth importó el audio de “%1$@” del archivo comprimido “%2$@”, y ese archivo es la única copia de su texto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فایل اصلی نگه داشته شد: TextMouth صدای «%1$@» را از آرشیو «%2$@» وارد کرد و آرشیو تنها نسخه متن آن است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le fichier d’origine a été conservé : TextMouth a importé l’audio de « %1$@ » depuis l’archive « %2$@ », et l’archive est la seule copie de son texte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "קובץ המקור נשמר: TextMouth ייבא את השמע של “%1$@” מהארכיון “%2$@”, והארכיון הוא העותק היחיד של הטקסט שלו."
          }
        },
        "hi" : {
