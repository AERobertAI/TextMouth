          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth vai abrir a biblioteca em %1$@ em vez da que está em %2$@, que não está disponível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
