        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth نے %1$@ روک دیا کیونکہ %2$@، اور TextMouth کے بند ہو کر دوبارہ کھلنے تک دوبارہ کوشش نہیں کرے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth đã dừng %1$@ vì %2$@, và sẽ không thử lại cho đến khi TextMouth được đóng rồi mở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 已停止 %1$@，因为 %2$@，在 TextMouth 关闭并重新打开之前不会重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 已停止 %1$@，原因是 %2$@，在 TextMouth 關閉並重新打開之前不會再試。"
          }
        }
      }
    },
    "inProcessEngine.refused" : {
      "comment" : "Said when a library call inside the iPhone app is refused because an earlier one was abandoned for taking too long. %@ is the work's name, such as \"the braille translation\" (English until its area converts). Read after an import's own words.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أوقف TextMouth %@ سابقًا لأن العملية استغرقت وقتًا طويلًا، ولن يحاول مرة أخرى حتى يُغلق TextMouth ويُفتح من جديد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth আগে %@ থামিয়ে দিয়েছে কারণ এতে অনেক সময় লাগছিল, এবং TextMouth বন্ধ করে আবার না খোলা পর্যন্ত আর চেষ্টা করবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth hat %@ zuvor gestoppt, weil es zu lange dauerte, und versucht es erst wieder, wenn TextMouth beendet und neu geöffnet wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth stopped %@ earlier because it took too long, and won't try again until TextMouth is closed and opened again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth detuvo antes %@ porque tardaba demasiado, y no volverá a intentarlo hasta que cierres y vuelvas a abrir TextMouth."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth پیش‌تر %@ را متوقف کرد چون زمان زیادی می‌گرفت، و تا زمانی که TextMouth بسته و دوباره باز نشود دوباره تلاش نمی‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth a arrêté %@ plus tôt parce que cela prenait trop de temps, et ne réessaiera pas avant que TextMouth soit fermé puis rouvert."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth עצר את %@ קודם כי זה לקח יותר מדי זמן, ולא ינסה שוב עד שייסגר וייפתח מחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ने %@ पहले इसलिए रोक दिया था क्योंकि उसमें बहुत समय लग रहा था, और TextMouth बंद करके दोबारा खोलने तक फिर से प्रयास नहीं करेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth menghentikan %@ sebelumnya karena terlalu lama, dan tidak akan mencoba lagi sampai TextMouth ditutup dan dibuka kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ha interrotto %@ prima perché richiedeva troppo tempo, e non riproverà finché TextMouth non verrà chiuso e riaperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は、先に%@に時間がかかりすぎて中止したため、TextMouth を閉じてもう一度開くまで再試行しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@이(가) 너무 오래 걸려 TextMouth가 이전에 중지했으며, TextMouth를 닫았다가 다시 열 때까지 다시 시도하지 않습니다."
