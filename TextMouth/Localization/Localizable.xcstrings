    "nextBookWindow.unavailableHint.article" : {
      "comment" : "VoiceOver hint of the dimmed Open the next article in pop-up button in a news feed's Feed Info: when it can be used.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "متاح فقط عندما تنتقل مقالات هذا الموجز إلى مقالة أخرى عند انتهاء إحداها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "শুধু তখনই পাওয়া যায় যখন এই ফিডের নিবন্ধগুলো একটি শেষ হলে অন্য নিবন্ধে এগিয়ে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nur verfügbar, solange die Artikel dieses Feeds am Ende zu einem anderen Artikel weitergehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Available only while this feed's articles go on to another article when one ends"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disponible solo mientras los artículos de este canal pasan a otro artículo al terminar uno"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فقط وقتی در دسترس است که مقاله‌های این فید پس از پایان یک مقاله به مقاله‌ای دیگر بروند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
