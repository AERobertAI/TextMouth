          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 데이터를 복사하는 동안 %@에 다른 것이 놓였습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
