    "audioEditor.noMarkers" : {
      "comment" : "Shown in the audio editor's list when no marker has been dropped. \"Add Marker\" is the name of the command.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا توجد علامات بعد. يضع الأمر “إضافة علامة” واحدة عند المؤشر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এখনও কোনো মার্কার নেই। “মার্কার যোগ করুন” বেছে নিলে কার্সরের জায়গায় একটি মার্কার রাখা হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Noch keine Marker. „Marker hinzufügen“ setzt einen am Cursor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No markers yet. Add Marker drops one at the cursor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aún no hay marcas. Agregar marca coloca una en el cursor."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هنوز علامتی نیست. «افزودن علامت» یکی را در محل مکان‌نما می‌گذارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucun marqueur pour l’instant. Ajouter un marqueur en dépose un au curseur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אין עדיין נקודות ציון. “הוסף נקודת ציון” מניח אחת בסמן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "अभी कोई मार्कर नहीं है। “मार्कर जोड़ें” कर्सर पर एक मार्कर लगाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Belum ada penanda. Pilih Tambah Penanda untuk memasang satu di posisi kursor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ancora nessun marcatore. Il comando Aggiungi marcatore ne inserisce uno nella posizione del cursore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "マーカーはまだありません。「マーカーを追加」でカーソルの位置に置けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "아직 마커가 없습니다. 마커 추가를 선택하면 커서 위치에 마커가 놓입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nog geen markeringen. Met Voeg markering toe plaats je er een bij de cursor."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Brak znaczników. Dodaj znacznik wstawia jeden przy kursorze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nenhuma marca ainda. Adicionar marca coloca uma no cursor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Меток пока нет. Команда «Добавить метку» ставит метку в позиции курсора."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Inga ljudmärken än. Lägg till ljudmärke sätter ett vid markören."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ยังไม่มีเครื่องหมาย คำสั่ง เพิ่มเครื่องหมาย จะวางเครื่องหมายที่เคอร์เซอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Henüz işaret yok. İşaret Ekle, imleç konumuna bir işaret bırakır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Міток поки немає. «Додати мітку» ставить мітку в місці курсора."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ابھی کوئی مارکر نہیں۔ “مارکر شامل کریں” کرسر پر ایک لگا دیتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chưa có điểm đánh dấu nào. Lệnh Thêm điểm đánh dấu sẽ đặt một điểm tại con trỏ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "尚无标记。“添加标记”会在光标处放置一个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "尚無標記。使用「加入標記」可在游標處放置一個。"
          }
        }
      }
    },
    "audioEditor.noMicrophone" : {
      "comment" : "Said by the audio editor's Punch In when no microphone is connected.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يوجد ميكروفون متصل. وصّل ميكروفونًا للتسجيل فوق التحديد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "কোনো মাইক্রোফোন সংযুক্ত নেই। রেকর্ড করে বসাতে একটি সংযুক্ত করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es ist kein Mikrofon verbunden. Verbinde eines, um darüber aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No microphone is connected. Connect one to punch in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay ningún micrófono conectado. Conecta uno para grabar encima."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "میکروفونی وصل نیست. برای ضبط روی انتخاب، یکی وصل کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucun microphone n’est connecté. Connectez-en un pour enregistrer par-dessus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא מחובר מיקרופון. חבר אחד כדי להקליט מעל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कोई माइक्रोफ़ोन कनेक्ट नहीं है। चयन पर रिकॉर्ड करने के लिए कोई माइक्रोफ़ोन कनेक्ट करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tidak ada mikrofon yang tersambung. Sambungkan satu untuk Rekam Menimpa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nessun microfono collegato. Collegane uno per registrare sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "マイクが接続されていません。上書き録音するには接続してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "연결된 마이크가 없습니다. 덮어 녹음하려면 마이크를 연결하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Er is geen microfoon aangesloten. Sluit er een aan om erover op te nemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie podłączono mikrofonu. Podłącz mikrofon, aby użyć funkcji Nagraj w miejscu zaznaczenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
