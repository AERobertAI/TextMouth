          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "편집 기록이 클라우드에만 있고 아직 이 Mac에는 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De bewerkingsgeschiedenis staat alleen in de cloud, nog niet op deze Mac."
          }
        },
        "pl" : {
          "stringUnit" : {
