        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo libro non è stato aperto dall’elenco di lettura."
          }
        }
      }
    },
    "This book was removed from the library, but its bookInfo.json file could not be deleted. It stays out of the library:" : {
      "comment" : "Heading of the error alert's list when Remove from Library Only removed one book but could not delete the bookInfo.json file in its package. bookInfo.json is a file name. The book's title and the reason follow on the next line.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este libro se quitó de la biblioteca, pero no se pudo eliminar su archivo bookInfo.json. Sigue fuera de la biblioteca:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo libro è stato rimosso dalla libreria, ma non è stato possibile eliminare il suo file bookInfo.json. Resta fuori dalla libreria:"
          }
        }
      }
    },
    "This book's audio could not be converted from Ogg to AAC. TextMouth tries again the next time it starts." : {
      "comment" : "What Play says for a book whose Ogg audio failed to convert at this launch.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo convertir el audio de este libro de Ogg a AAC. TextMouth volverá a intentarlo la próxima vez que se inicie."
          }
        }
      }
    },
    "This book's audio is being converted from Ogg to AAC. It plays when that ends." : {
      "comment" : "What Play says while the book's Ogg audio is being converted to AAC.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El audio de este libro se está convirtiendo de Ogg a AAC. Se reproducirá cuando termine."
          }
        }
      }
    },
    "This book's audio needs converting from Ogg to AAC. TextMouth is converting it now, and it plays when that ends." : {
      "comment" : "What Play says for a book found still in Ogg, whose conversion TextMouth starts.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
