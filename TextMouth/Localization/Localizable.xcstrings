    "libraryRemovalError.couldNotMarkPackage" : {
      "comment" : "First sentence of the error shown when Remove from Library Only cannot mark the book's package, so the book stays in the library. %@ is the package's folder name. The sentence that says why follows it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يتمكن TextMouth من تسجيل الإزالة في حزمة الكتاب، %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth বইটির প্যাকেজ %@-এ অপসারণের কথা লিখে রাখতে পারেনি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth konnte die Entfernung nicht im Paket %@ vermerken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth could not record the removal in its package, %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no pudo registrar la eliminación en su paquete, %@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth نتوانست حذف را در بسته‌ی کتاب، %@، ثبت کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth n’a pas pu enregistrer le retrait dans son paquet, %@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth לא הצליח לתעד את ההסרה בחבילה %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth हटाने की जानकारी उसके पैकेज %@ में दर्ज नहीं कर सका।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tidak dapat mencatat pembuangan di paketnya, %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non è riuscito a registrare la rimozione nel suo pacchetto, %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は、パッケージ%@に取り除いた記録を書き込めませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 패키지 %@에 제거를 기록하지 못했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kon de verwijdering niet vastleggen in het pakket %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth nie mógł zapisać usunięcia w pakiecie książki: %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não conseguiu registrar a remoção em seu pacote, %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не удалось записать удаление в пакете %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kunde inte registrera borttagningen i bokens paket, %@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth บันทึกการนำออกในแพ็กเกจ %@ ไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kaldırmayı paketine kaydedemedi: %@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не вдалося записати вилучення в пакет %@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth کتاب کے پیکیج %@ میں ہٹانے کا اندراج نہیں کر سکا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth không thể ghi lại việc gỡ trong gói của sách, %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 无法在其包 %@ 中记录移除操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 無法在書籍的套件 %@ 中記錄這次移除。"
          }
        }
      }
    },
    "libraryRemoveCommand.accessibilityHint" : {
      "comment" : "VoiceOver hint of the Remove button when it asks first. %@ is what deleting the files does, such as \"move the files to the Trash\" or \"delete the files permanently\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يسأل عما إذا كان سيتم %@ أو الاحتفاظ بها في مجلد مكتبة TextMouth."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "জিজ্ঞেস করে: %@, নাকি TextMouth লাইব্রেরি ফোল্ডারে রাখা হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fragt, ob du %@ oder sie im Bibliotheksordner von TextMouth behalten möchtest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asks whether to %@ or keep them in the TextMouth library folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pregunta si quieres %@ o conservarlos en la carpeta de la biblioteca de TextMouth."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "می‌پرسد که آیا %@ انجام شود یا فایل‌ها در پوشه‌ی کتابخانه‌ی TextMouth نگه داشته شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Demande s’il faut %@, ou les conserver dans le dossier de la bibliothèque TextMouth."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "שואל אם %@ או להשאיר אותם בתיקיית הספרייה של TextMouth."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पूछता है कि %@ है या उन्हें TextMouth लाइब्रेरी फ़ोल्डर में रखना है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menanyakan apakah akan %@ atau tetap menyimpannya di folder pustaka TextMouth."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chiede se %@ o conservarli nella cartella della libreria di TextMouth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@か、TextMouth のライブラリフォルダに残すかを確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@할지 TextMouth 보관함 폴더에 유지할지 묻습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vraagt of je %@ wilt of ze in de bibliotheekmap van TextMouth wilt bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pyta, czy wybrać %@, czy zachować je w folderze biblioteki TextMouth."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pergunta se você quer %@ ou mantê-los na pasta da biblioteca do TextMouth."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Спрашивает, нужно ли %@ или оставить их в папке библиотеки TextMouth."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Frågar om du vill %@ eller behålla dem i TextMouths biblioteksmapp."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ถามว่าจะ%@ หรือเก็บไว้ในโฟลเดอร์ไลบรารี TextMouth"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hangisini istediğinizi sorar: %@ veya dosyaları TextMouth kitaplık klasöründe tut."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Запитує, чи %@, чи залишити їх у папці бібліотеки TextMouth."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پوچھتا ہے کہ %@ ہے یا انہیں TextMouth کے لائبریری فولڈر میں رکھنا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hỏi xem nên %@ hay giữ chúng trong thư mục thư viện TextMouth."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "询问是否%@，或保留在 TextMouth 资料库文件夹中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "詢問要%@，還是保留在 TextMouth 書庫檔案夾中。"
          }
        }
      }
    },
    "libraryRemoveCommand.accessibilityLabel" : {
      "comment" : "VoiceOver label of the Remove button when it asks how to remove before it removes anything. %@ is what is removed, such as \"“Notes”\" or \"3 books\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "إزالة %@ من المكتبة"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ লাইব্রেরি থেকে সরান"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ aus der Bibliothek entfernen"
          }
        },
        "en" : {
          "stringUnit" : {
