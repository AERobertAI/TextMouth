    "shortcutsSettings.letterNavigationNote" : {
      "comment" : "Note in the Shortcuts tab of Settings. In a Library window, a letter key pressed with no other key jumps to the first book or folder starting with that letter, so a shortcut made of a letter alone, such as W, cannot work in a Library window.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "في نوافذ المكتبة، ينتقل حرف وحده إلى أول كتاب أو مجلد يبدأ به، لذا فالاختصار المكوَّن من حرف وحده، مثل W، يعمل في النوافذ الأخرى فقط."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "লাইব্রেরি উইন্ডোতে একটি অক্ষর একা চাপলে সেই অক্ষর দিয়ে শুরু হওয়া প্রথম বই বা ফোল্ডারে যায়, তাই W-এর মতো একক অক্ষরের শর্টকাট শুধু অন্য উইন্ডোতে কাজ করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "In Bibliotheksfenstern springt ein einzelner Buchstabe zum ersten Buch oder Ordner, der damit beginnt. Ein Kurzbefehl aus einem einzelnen Buchstaben, etwa W, funktioniert daher nur in anderen Fenstern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Library windows, a letter alone moves to the first book or folder starting with it, so a shortcut that is a letter alone, such as W, works only in other windows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En las ventanas de la biblioteca, una letra sola va al primer libro o carpeta que empieza con ella, así que un atajo que es una sola letra, como W, funciona únicamente en otras ventanas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "در پنجره‌های کتابخانه، فشردن یک حرف به‌تنهایی به اولین کتاب یا پوشه‌ای که با آن حرف شروع می‌شود می‌رود؛ پس میان‌بری که فقط یک حرف است، مانند W، فقط در پنجره‌های دیگر کار می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dans les fenêtres de la bibliothèque, une lettre seule passe au premier livre ou dossier qui commence par elle ; un raccourci constitué d’une lettre seule, comme W, ne fonctionne donc que dans les autres fenêtres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בחלונות הספרייה, אות בודדת עוברת לספר או לתיקייה הראשונים שמתחילים בה, ולכן קיצור שהוא אות בודדת, כגון W, פועל רק בחלונות אחרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लाइब्रेरी विंडो में अकेला अक्षर दबाने पर उस अक्षर से शुरू होने वाली पहली पुस्तक या फ़ोल्डर पर जाया जाता है, इसलिए केवल एक अक्षर वाला शॉर्टकट, जैसे W, सिर्फ़ दूसरी विंडो में काम करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Di jendela Pustaka, satu huruf saja akan pindah ke buku atau folder pertama yang diawali huruf itu, sehingga pintasan berupa satu huruf saja, seperti W, hanya berfungsi di jendela lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nelle finestre della libreria, una lettera da sola porta al primo libro o alla prima cartella che inizia con essa, quindi una scorciatoia fatta di una sola lettera, come W, funziona solo nelle altre finestre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ライブラリのウインドウでは、文字キーだけを押すと、その文字で始まる最初のブックまたはフォルダに移動します。そのため、Wなど文字だけのショートカットは、ほかのウインドウでのみ使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관함 윈도우에서는 문자 키만 누르면 그 문자로 시작하는 첫 번째 책이나 폴더로 이동하므로, W처럼 문자 하나로 된 단축키는 다른 윈도우에서만 작동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "In bibliotheekvensters springt een losse letter naar het eerste boek of de eerste map die ermee begint, dus een toetsenbordcommando dat alleen een letter is, zoals W, werkt alleen in andere vensters."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "W oknach biblioteki sama litera przenosi do pierwszej książki lub folderu zaczynającego się od niej, więc skrót będący samą literą, na przykład W, działa tylko w innych oknach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nas janelas da biblioteca, uma letra sozinha vai para o primeiro livro ou pasta que começa com ela; por isso, um atalho que é uma letra sozinha, como W, só funciona em outras janelas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В окнах библиотеки нажатая буква выбирает первую книгу или папку, название которой с неё начинается, поэтому сочетание из одной буквы, например W, работает только в других окнах."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I biblioteksfönster hoppar en enskild bokstav till den första boken eller mappen som börjar med den, så en genväg som bara är en bokstav, till exempel W, fungerar bara i andra fönster."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ในหน้าต่างไลบรารี การกดตัวอักษรเพียงตัวเดียวจะไปที่หนังสือหรือโฟลเดอร์แรกที่ขึ้นต้นด้วยตัวอักษรนั้น ทางลัดที่เป็นตัวอักษรตัวเดียว เช่น W จึงใช้ได้เฉพาะในหน้าต่างอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitaplık pencerelerinde tek başına bir harf, onunla başlayan ilk kitaba ya da klasöre gider; bu yüzden W gibi tek harfli bir kısayol yalnızca diğer pencerelerde çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "У вікнах бібліотеки натискання самої літери переводить до першої книги або папки, що починається з неї, тому комбінація з однієї літери, як-от W, працює лише в інших вікнах."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لائبریری کی ونڈوز میں، اکیلا حرف اس سے شروع ہونے والی پہلی کتاب یا فولڈر پر لے جاتا ہے، اس لیے اکیلے حرف والا شارٹ کٹ، جیسے W، صرف دوسری ونڈوز میں کام کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trong cửa sổ Thư viện, nhấn riêng một chữ cái sẽ chuyển đến sách hoặc thư mục đầu tiên bắt đầu bằng chữ đó, nên phím tắt gồm một chữ cái đơn lẻ, chẳng hạn W, chỉ hoạt động trong các cửa sổ khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在资料库窗口中，单独按一个字母会移到以该字母开头的第一本图书或第一个文件夹，因此只由一个字母（如 W）构成的快捷键只在其他窗口中有效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在書庫視窗中，單獨按一個字母會移到第一本以該字母開頭的書籍或檔案夾，因此單獨由字母組成的快速鍵（例如 W）只能在其他視窗中使用。"
          }
        }
      }
    },
