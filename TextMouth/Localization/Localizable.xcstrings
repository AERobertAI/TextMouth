    "No new books in “%@”: all %lld were already in your library." : {
      "comment" : "What the library says as an archive holds three or more books, all of which the library already has. %1$@ is the archive's name and %2$lld the number of books.",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Keine neuen Bücher in „%@“: %lld Buch war bereits in deiner Bibliothek."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Keine neuen Bücher in „%@“: Alle %lld waren bereits in deiner Bibliothek."
