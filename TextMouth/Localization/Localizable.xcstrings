            "state" : "machine_translated",
            "value" : "Przesuwa kursor do tyłu o jedną sekundę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Move o cursor um segundo para trás."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сдвигает курсор назад на одну секунду."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Flyttar markören bakåt en sekund."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เลื่อนเคอร์เซอร์ย้อนกลับหนึ่งวินาที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "İmleci bir saniye geri taşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Переміщує курсор назад на одну секунду."
