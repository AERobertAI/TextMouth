    "sync.fetch.cellularHint" : {
      "comment" : "Added after the stalled-download sentence when the connection is cellular or a hotspot. iCloud Drive has a setting that stops it using cellular data.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "إذا تعذّر على iCloud Drive استخدام بيانات الجوّال، فاتصل بشبكة Wi‑Fi."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive মোবাইল ডেটা ব্যবহার করতে না পারলে Wi-Fi-এ সংযুক্ত হন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wenn iCloud Drive kein Mobilfunknetz verwenden darf, verbinde dich mit einem WLAN."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If iCloud Drive can't use cellular data, connect to Wi-Fi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si iCloud Drive no puede usar datos móviles, conéctate a una red Wi-Fi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اگر iCloud Drive نمی‌تواند از داده تلفن همراه استفاده کند، به Wi-Fi وصل شوید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si iCloud Drive ne peut pas utiliser les données cellulaires, connectez-vous au Wi-Fi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אם iCloud Drive אינו יכול להשתמש בנתונים סלולריים, התחבר ל-Wi-Fi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "अगर iCloud Drive सेल्युलर डेटा इस्तेमाल नहीं कर सकता, तो Wi-Fi से जुड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jika iCloud Drive tidak dapat memakai data seluler, sambungkan ke Wi-Fi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se iCloud Drive non può usare i dati cellulare, connettiti al Wi-Fi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive がモバイルデータ通信を使えない場合は、Wi-Fi に接続してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive가 셀룰러 데이터를 사용할 수 없으면 Wi-Fi에 연결하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Als iCloud Drive geen mobiele data mag gebruiken, maak dan verbinding met wifi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jeśli iCloud Drive nie może używać danych komórkowych, połącz się z Wi-Fi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se o iCloud Drive não puder usar dados celulares, conecte-se ao Wi-Fi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Если iCloud Drive не может использовать сотовые данные, подключитесь к Wi-Fi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Om iCloud Drive inte kan använda mobildata, anslut till Wi-Fi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หาก iCloud Drive ใช้ข้อมูลเซลลูลาร์ไม่ได้ ให้เชื่อมต่อ Wi-Fi"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive hücresel veriyi kullanamıyorsa Wi-Fi’ye bağlanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо iCloud Drive не може використовувати стільниковий зв’язок, підключіться до Wi-Fi."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اگر iCloud Drive سیلولر ڈیٹا استعمال نہیں کر سکتا تو Wi-Fi سے جڑیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nếu iCloud Drive không dùng được dữ liệu di động, hãy kết nối Wi-Fi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "如果 iCloud 云盘无法使用蜂窝数据，请连接 Wi-Fi。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "如果 iCloud Drive 無法使用行動數據，請連接 Wi-Fi。"
          }
        }
      }
    },
    "sync.fetch.stalled" : {
      "comment" : "Why a book's download from the sync folder stopped: iCloud Drive stopped sending its files. Said in the download view.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "توقف iCloud Drive عن إرسال ملفات هذا الكتاب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive এই বইয়ের ফাইল পাঠানো বন্ধ করে দিয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive hat aufgehört, die Dateien dieses Buchs zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive stopped sending this book's files."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive dejó de enviar los archivos de este libro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive ارسال فایل‌های این کتاب را متوقف کرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive a cessé d’envoyer les fichiers de ce livre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive הפסיק לשלוח את הקבצים של הספר הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive ने इस पुस्तक की फ़ाइलें भेजना बंद कर दिया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive berhenti mengirim berkas buku ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive ha smesso di inviare i file di questo libro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive がこの本のファイルの送信を停止しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
