        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یہ %@ کو حذف کرتا ہے: یہ ٹریش میں جاتا ہے، جہاں ٹریش خالی ہونے تک آپ اسے بحال کر سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thao tác này xóa %@: mục này được chuyển vào Thùng rác, nơi bạn có thể khôi phục cho đến khi dọn sạch Thùng rác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
