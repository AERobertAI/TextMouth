          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ریکارڈنگ درست طور پر مکمل نہیں ہو سکی۔ جو ریکارڈ ہو چکا وہ محفوظ ہے۔"
