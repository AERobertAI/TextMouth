    "librarySearch.stopHint" : {
      "comment" : "VoiceOver hint of the Stop button of the Search Library window.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يوقف البحث مع الإبقاء على المطابقات التي وُجدت حتى الآن."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "অনুসন্ধান থামায়, এ পর্যন্ত পাওয়া মিলগুলো রেখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppt die Suche und behält die bisher gefundenen Treffer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops the search, keeping the matches found so far"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detiene la búsqueda y conserva las coincidencias encontradas hasta ahora"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جست‌وجو را متوقف می‌کند و تطابق‌های یافت‌شده تا اینجا را نگه می‌دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrête la recherche en gardant les correspondances trouvées jusqu’ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "עוצר את החיפוש ושומר את ההתאמות שנמצאו עד כה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "खोज रोकता है और अब तक मिले मिलान रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menghentikan pencarian, mempertahankan kecocokan yang ditemukan sejauh ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe la ricerca, mantenendo le corrispondenze trovate finora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "検索を停止し、これまでに見つかった一致を残します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "검색을 중지하고 지금까지 찾은 일치 항목을 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stopt het zoeken en behoudt de treffers die tot nu toe zijn gevonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zatrzymuje wyszukiwanie, zachowując dotychczasowe trafienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para a busca, mantendo as correspondências encontradas até agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Останавливает поиск, сохраняя найденные совпадения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppar sökningen och behåller träffarna som hittats hittills."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หยุดการค้นหาและเก็บรายการที่ตรงกันที่พบไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aramayı durdurur, o ana kadar bulunan eşleşmeleri korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Зупиняє пошук, зберігаючи знайдені збіги."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تلاش روکتا ہے اور اب تک ملی مماثلتیں رکھتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dừng tìm kiếm, giữ lại các kết quả khớp đã tìm thấy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止搜索，并保留目前已找到的匹配项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止搜尋，保留目前已找到的符合項目。"
          }
        }
      }
    },
    "librarySearch.stopped" : {
      "comment" : "Opening of the Search Library status after the user stopped a search, followed by what it had found. %1$@ is the number of books searched, and %2$@ is the count of all the books with its noun, such as \"750 books\". Ends with a colon.",
