    "protection.partlyOpened" : {
      "comment" : "Said when a typed password opened some of the protected books being added but not all.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم تفتح كلمة المرور هذه بعض الكتب. جرّب أخرى، أو اختر استيراد مقفلة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই পাসওয়ার্ডে কিছু বই খোলেনি। অন্যটি চেষ্টা করুন, অথবা লক করা অবস্থায় আমদানি করুন বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mit diesem Passwort ließen sich einige Bücher nicht öffnen. Versuchen Sie ein anderes oder wählen Sie „Gesperrt importieren“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some books did not open with this password. Try another, or choose Import Locked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Algunos libros no se abrieron con esta contraseña. Prueba otra o elige Importar bloqueados."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "برخی کتاب‌ها با این گذرواژه باز نشدند. گذرواژه دیگری امتحان کنید یا «درون‌ریزی قفل‌شده» را بزنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Certains livres ne se sont pas ouverts avec ce mot de passe. Essayez-en un autre ou choisissez Importer verrouillés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "חלק מהספרים לא נפתחו עם הסיסמה הזו. נסו אחרת או בחרו ייבוא כשהם נעולים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कुछ पुस्तकें इस पासवर्ड से नहीं खुलीं। कोई और आज़माएँ, या लॉक रखकर आयात करें चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beberapa buku tidak terbuka dengan kata sandi ini. Coba yang lain, atau pilih Impor terkunci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alcuni libri non si sono aperti con questa password. Provane un'altra o scegli Importa bloccati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このパスワードでは開けないブックがありました。別のパスワードを試すか、「ロックしたまま読み込む」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 암호로 열리지 않은 책이 있습니다. 다른 암호를 시도하거나 ‘잠긴 채로 가져오기’를 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sommige boeken gingen niet open met dit wachtwoord. Probeer een ander of kies Vergrendeld importeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Niektóre książki nie otworzyły się tym hasłem. Spróbuj innego lub wybierz Importuj zablokowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alguns livros não abriram com esta senha. Tente outra ou escolha Importar bloqueados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Некоторые книги не открылись с этим паролем. Попробуйте другой или выберите «Импортировать заблокированными»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vissa böcker gick inte att öppna med det här lösenordet. Försök med ett annat eller välj Importera låsta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หนังสือบางเล่มเปิดด้วยรหัสผ่านนี้ไม่ได้ ลองรหัสอื่น หรือเลือกนำเข้าแบบล็อก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bazı kitaplar bu parolayla açılmadı. Başka bir parola deneyin veya Kilitli İçe Aktar’ı seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Деякі книги не відкрилися з цим паролем. Спробуйте інший або виберіть «Імпортувати заблокованими»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کچھ کتابیں اس پاس ورڈ سے نہیں کھلیں۔ کوئی اور آزمائیں، یا مقفل درآمد کریں چنیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Một số sách không mở được bằng mật khẩu này. Hãy thử mật khẩu khác, hoặc chọn Nhập ở trạng thái khóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "有些图书无法用此密码打开。请尝试其他密码，或选择“以锁定状态导入”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "有些書無法用此密碼開啟。請嘗試其他密碼，或選擇「以鎖定狀態匯入」。"
          }
        }
      }
    },
