    "htmlExportWriter.hint" : {
      "comment" : "The hint of the Convert to picker in the Export dialog while HTML is chosen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صفحة ويب بنص الكتاب، مع قائمة محتويات فيها رابط لكل عنوان رئيسي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইয়ের লেখার একটি ওয়েব পেজ, যাতে প্রতিটি হেডিংয়ের লিঙ্কসহ একটি সূচি থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eine Webseite mit dem Text des Buchs und einem Inhaltsverzeichnis, das auf jede Überschrift verweist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A web page of the book's text, with a contents list linking each heading."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una página web con el texto del libro y una lista de contenidos que enlaza cada encabezado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یک صفحه‌ی وب از متن کتاب، با فهرستی که به هر سرفصل پیوند می‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une page web du texte du livre, avec une table des matières qui renvoie à chaque en-tête."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "דף אינטרנט עם טקסט הספר, ועם רשימת תוכן שמקשרת לכל כותרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पुस्तक के टेक्स्ट का एक वेब पेज, जिसकी विषय-सूची हर हेडिंग से जुड़ी होती है।"
          }
        },
        "id" : {
          "stringUnit" : {
