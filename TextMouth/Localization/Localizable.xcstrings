    "audioEditError.historyFromNewerVersion" : {
      "comment" : "Said when the book's saved edit history was written by a later version of TextMouth than this one.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "حرّر إصدار أحدث من TextMouth هذا الصوت، لذا يترك هذا الإصدار تعديلاته كما هي."
