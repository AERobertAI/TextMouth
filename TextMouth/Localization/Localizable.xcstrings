          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie udało się odczytać historii edycji. Kopia została zachowana w pakiecie książki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não foi possível ler o histórico de edições. Uma cópia foi mantida no pacote do livro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Историю правок не удалось прочитать. Копия сохранена в пакете книги."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Redigeringshistoriken kunde inte läsas. En kopia sparades i bokens paket."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "อ่านประวัติการแก้ไขไม่ได้ เก็บสำเนาไว้ในแพ็กเกจของหนังสือแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Düzenleme geçmişi okunamadı. Kitabın paketinde bir kopya saklandı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не вдалося прочитати історію правок. Копію збережено в пакеті книги."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ترامیم کی سرگزشت پڑھی نہیں جا سکی۔ ایک کاپی کتاب کے پیکیج میں رکھی گئی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không thể đọc lịch sử chỉnh sửa. Một bản sao đã được giữ trong gói của sách."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "无法读取编辑历史记录。副本已保留在图书的包中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "無法讀取編輯歷史紀錄。書籍的套件中已保留一份副本。"
          }
        }
      }
    },
    "audioEditError.missingAudio" : {
      "comment" : "Said when an audio file that the edits need is missing. %@ is its path inside the book's package.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ملف الصوت “%@” الذي تحتاجه التعديلات مفقود من الكتاب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সম্পাদনার জন্য দরকারি অডিও ফাইল “%@” বইয়ে নেই।"
          }
        },
        "de" : {
          "stringUnit" : {
