            "value" : "TextMouth daha önce çok uzun sürdüğü için şunu durdurdu: %@. TextMouth kapatılıp yeniden açılana kadar tekrar denemeyecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth раніше зупинив %@, бо це тривало надто довго, і не спробує знову, доки TextMouth не буде закрито й відкрито знову."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth نے پہلے %@ روک دیا تھا کیونکہ اس میں بہت وقت لگ رہا تھا، اور TextMouth کے بند ہو کر دوبارہ کھلنے تک دوبارہ کوشش نہیں کرے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth đã dừng %@ trước đó vì mất quá nhiều thời gian, và sẽ không thử lại cho đến khi TextMouth được đóng rồi mở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 先前已停止 %@，因为耗时过长，在 TextMouth 关闭并重新打开之前不会重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 先前因耗時過長而停止了 %@，在 TextMouth 關閉並重新打開之前不會再試。"
          }
        }
      }
    },
    "indexNotSaved.errorDescription" : {
      "comment" : "Error shown when Replace Existing could not save the library's index, which must name the new copy before the old one goes. Nothing was replaced.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يتمكن TextMouth من حفظ فهرس المكتبة، فترك النسختين كما هما."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth লাইব্রেরির সূচক সংরক্ষণ করতে পারেনি, তাই দুটি কপিই যেমন আছে তেমনই রেখেছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth konnte den Bibliotheksindex nicht sichern und hat beide Kopien unverändert gelassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth couldn't save the library's index, so it left both copies as they are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no pudo guardar el índice de la biblioteca, así que dejó ambas copias como están."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth نتوانست نمایه‌ی کتابخانه را ذخیره کند، بنابراین هر دو نسخه را همان‌طور که بودند گذاشت."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth n’a pas pu enregistrer l’index de la bibliothèque, donc il a laissé les deux copies telles quelles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth לא הצליח לשמור את אינדקס הספרייה, ולכן השאיר את שני העותקים כפי שהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth लाइब्रेरी का इंडेक्स सहेज नहीं सका, इसलिए उसने दोनों कॉपी जैसी थीं वैसी ही छोड़ दीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tidak dapat menyimpan indeks pustaka, jadi kedua salinan dibiarkan apa adanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non è riuscito a salvare l’indice della libreria, quindi ha lasciato entrambe le copie come sono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth はライブラリインデックスを保存できなかったため、どちらのコピーもそのままにしました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 보관함 색인을 저장하지 못해 두 사본을 그대로 두었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kon de bibliotheekindex niet bewaren, dus blijven beide kopieën zoals ze zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth nie mógł zapisać indeksu biblioteki, więc obie kopie pozostawił bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não conseguiu salvar o índice da biblioteca, então deixou as duas cópias como estão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не удалось сохранить индекс библиотеки, поэтому обе копии оставлены как есть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kunde inte spara bibliotekets index, så båda kopiorna lämnades som de var."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth บันทึกดัชนีของไลบรารีไม่ได้ จึงปล่อยทั้งสองสำเนาไว้ตามเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kitaplığın dizinini kaydedemedi, bu yüzden iki kopyayı da olduğu gibi bıraktı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не вдалося зберегти індекс бібліотеки, тому обидві копії залишено без змін."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth لائبریری کا انڈیکس محفوظ نہیں کر سکا، اس لیے اس نے دونوں کاپیاں جیسی تھیں ویسی ہی رہنے دیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth không thể lưu chỉ mục của thư viện, nên đã để nguyên cả hai bản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 无法存储资料库的索引，因此两个副本都保持原样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 無法儲存書庫的索引，因此兩份副本都維持原樣。"
          }
        }
      }
    },
