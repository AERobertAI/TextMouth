        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Salva a biblioteca temporária como o novo índice, com a lista de leitura e os ajustes de ordenação que o TextMouth conseguiu ler."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сохраняет временную библиотеку как новый индекс вместе со списком для чтения и настройками сортировки, которые TextMouth смог прочитать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sparar det tillfälliga biblioteket som det nya indexet, med läslistan och sorteringsinställningarna som TextMouth kunde läsa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "บันทึกไลบรารีชั่วคราวเป็นดัชนีใหม่ พร้อมรายการอ่านและการตั้งค่าการเรียงลำดับที่ TextMouth อ่านได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Geçici kitaplığı, TextMouth'un okuyabildiği okuma listesi ve sıralama ayarlarıyla yeni dizin olarak kaydeder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Зберігає тимчасову бібліотеку як новий індекс зі списком читання та параметрами сортування, які TextMouth вдалося прочитати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عارضی لائبریری کو نئے انڈیکس کے طور پر محفوظ کرتا ہے، مطالعے کی فہرست اور ترتیب دینے کی ان ترتیبات کے ساتھ جو TextMouth پڑھ سکا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lưu thư viện tạm thời làm chỉ mục mới, cùng với danh sách đọc và cài đặt sắp xếp mà TextMouth đọc được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "将临时资料库存储为新索引，其中包含 TextMouth 能够读取的阅读列表和排序设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "將暫存書庫儲存為新索引，並包含 TextMouth 能讀取的閱讀列表和排序設定。"
          }
        }
      }
    },
