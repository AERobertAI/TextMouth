    "leadingArticle.description.partOfTitle" : {
      "comment" : "Describes the Leading Articles choice Part of the Title, under the pop-up. The Hobbit is the example title; the T's are the books sorted under the letter T.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تُفرز العناوين ويُعثر عليها بالكتابة كما هي مكتوبة: يقع The Hobbit بين العناوين التي تبدأ بالحرف T."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "শিরোনাম যেভাবে লেখা আছে সেভাবেই সাজানো হয় এবং টাইপ করে খোঁজা যায়: The Hobbit T-এর মধ্যে থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Titel werden so sortiert und per Tippen gefunden, wie sie geschrieben sind: „The Hobbit“ steht unter T."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titles sort, and are found by typing, as they are written: The Hobbit is among the T's."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los títulos se ordenan, y se encuentran al escribir, tal como están escritos: The Hobbit está entre las T."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عنوان‌ها همان‌طور که نوشته شده‌اند مرتب می‌شوند و با تایپ پیدا می‌شوند: The Hobbit بین عنوان‌های T است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les titres sont triés, et trouvés à la saisie, tels qu’ils sont écrits : The Hobbit se trouve parmi les T."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "שמות הספרים ממוינים ונמצאים בהקלדה כפי שהם כתובים: The Hobbit נמצא בין ה-T."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "शीर्षक वैसे ही क्रमबद्ध होते हैं, और टाइप करके वैसे ही खोजे जाते हैं, जैसे वे लिखे हैं: The Hobbit T वाले शीर्षकों में आता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Judul diurutkan, dan ditemukan dengan mengetik, seperti tertulis: The Hobbit ada di antara huruf T."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I titoli vengono ordinati, e trovati digitando, come sono scritti: The Hobbit è tra le T."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "タイトルは書かれたとおりに並べ替えられ、入力でも見つかります。「The Hobbit」は T の項目の中にあります。"
          }
        },
        "ko" : {
