    "%@ holds two versions of a file of this book, so its download can't be removed." : {
      "comment" : "First sentence of why Remove Download was refused: the cloud service holds conflicting versions. %@ is the cloud service's name, or \"The cloud service\" when it is unknown.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ enthält zwei Versionen einer Datei dieses Buchs, daher kann der Download nicht entfernt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ guarda dos versiones de un archivo de este libro, así que no se puede quitar su descarga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ contient deux versions d’un fichier de ce livre ; son téléchargement ne peut donc pas être retiré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ contiene due versioni di un file di questo libro, quindi il suo download non può essere rimosso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ contém duas versões de um arquivo deste livro; por isso, o download não pode ser removido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ хранит две версии файла этой книги, поэтому загрузку нельзя убрать."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ містить дві версії файлу цієї книги, тому її завантаження не можна вилучити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 存有这本图书某个文件的两个版本，因此无法移除其下载内容。"
          }
        }
      }
    },
    "%@ in" : {
