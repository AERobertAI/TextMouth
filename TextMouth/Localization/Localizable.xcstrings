    "feed.deleteItemMessage.article" : {
      "comment" : "First sentence of the confirmation before an article that was moved into the library is deleted from its feed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تغادر المقالة القائمة نهائيًا؛ ويبقى الكتاب الذي صارت إليه في مكتبتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "নিবন্ধটি চিরতরে তালিকা থেকে চলে যায়; আপনার লাইব্রেরিতে এটি থেকে তৈরি হওয়া বইটি থেকে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Artikel verschwindet für immer aus der Liste; das Buch, das daraus in deiner Bibliothek wurde, bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The article leaves the list for good; the book it became in your library stays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El artículo sale de la lista para siempre; el libro en que se convirtió en tu biblioteca se queda."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مقاله برای همیشه از فهرست خارج می‌شود؛ کتابی که از آن در کتابخانه‌ی شما ساخته شده است می‌ماند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’article quitte définitivement la liste ; le livre qu’il est devenu dans votre bibliothèque reste."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הכתבה עוזבת את הרשימה לצמיתות; הספר שנוצר ממנה בספרייה שלך נשאר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लेख हमेशा के लिए सूची से हट जाता है; उससे बनी पुस्तक आपकी लाइब्रेरी में बनी रहती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Artikel ini dihapus dari daftar untuk selamanya; buku hasilnya di pustaka Anda tetap ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’articolo esce dall’elenco per sempre; il libro in cui si è trasformato resta nella tua libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "記事は一覧から完全に消えますが、ライブラリ内でブックになったものは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "기사가 목록에서 완전히 사라지지만, 보관함에서 책이 된 항목은 그대로 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Het artikel verdwijnt voorgoed uit de lijst; het boek dat ervan is gemaakt, blijft in je bibliotheek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Artykuł znika z listy na stałe; książka, którą się stał w Twojej bibliotece, zostaje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O artigo sai da lista de vez; o livro em que ele se transformou na sua biblioteca permanece."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Статья навсегда исчезает из списка; книга, в которую она превратилась в вашей библиотеке, остаётся."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Artikeln försvinner för gott från listan; boken som den blev i ditt bibliotek finns kvar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "บทความจะออกจากรายการอย่างถาวร ส่วนหนังสือที่ได้จากบทความในไลบรารีของคุณจะยังอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Makale listeden kalıcı olarak çıkar; kitaplığınızda olan kitabı kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Стаття остаточно зникає зі списку; книга, якою вона стала у вашій бібліотеці, залишається."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مضمون ہمیشہ کے لیے فہرست سے نکل جاتا ہے؛ جو کتاب وہ آپ کی لائبریری میں بنا وہ رہتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bài viết rời khỏi danh sách vĩnh viễn; sách được tạo từ bài viết này trong thư viện của bạn vẫn còn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "该文章会永久从列表中移除；由它转成的图书仍会保留在你的资料库中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此文章會從列表中永久移除；它在你書庫中轉成的書籍會保留。"
          }
        }
      }
    },
    "feed.deleteItemMessage.articleDownload" : {
      "comment" : "First sentence of the confirmation before an article is deleted from its feed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تغادر المقالة القائمة نهائيًا، ويُحذف تنزيلها إن وُجد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "নিবন্ধটি চিরতরে তালিকা থেকে চলে যায়, এবং এর কোনো ডাউনলোড থাকলে তা মুছে ফেলা হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Artikel verschwindet für immer aus der Liste, und sein Download, falls vorhanden, wird gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The article leaves the list for good, and its download, if any, is deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El artículo sale de la lista para siempre, y su descarga, si la tiene, se elimina."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مقاله برای همیشه از فهرست خارج می‌شود و بارگیری آن، اگر باشد، حذف می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’article quitte définitivement la liste, et son téléchargement, s’il y en a un, est supprimé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הכתבה עוזבת את הרשימה לצמיתות, וההורדה שלה, אם יש, נמחקת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लेख हमेशा के लिए सूची से हट जाता है, और उसका डाउनलोड, यदि है, मिटा दिया जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Artikel ini dihapus dari daftar untuk selamanya, dan unduhannya, jika ada, ikut dihapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’articolo esce dall’elenco per sempre e il suo download, se c’è, viene eliminato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "記事は一覧から完全に消え、ダウンロードがある場合は削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "기사가 목록에서 완전히 사라지며, 다운로드가 있으면 함께 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Het artikel verdwijnt voorgoed uit de lijst en de download, als die er is, wordt verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Artykuł znika z listy na stałe, a jego pobrany plik, jeśli jest, zostaje usunięty."
