    "bookmarkPanelView.addBookmarkHint" : {
      "comment" : "VoiceOver hint of the Bookmarks list's Add Bookmark button: it opens the step where an optional note is written, then the bookmark is added where the book is being read.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يطلب ملاحظة اختيارية، ثم يعلّم موضع القراءة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "একটি ঐচ্ছিক নোট চায়, তারপর পড়ার অবস্থান চিহ্নিত করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fragt nach einer optionalen Notiz und setzt dann ein Lesezeichen an der Leseposition."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asks for an optional note, then marks the reading position."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pide una nota opcional y luego marca la posición de lectura."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یادداشتی اختیاری می‌خواهد، سپس موقعیت مطالعه را علامت می‌زند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Demande une note facultative, puis marque la position de lecture."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מבקש הערה אופציונלית, ואז מסמן את מיקום הקריאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "एक वैकल्पिक नोट माँगता है, फिर पठन स्थिति पर चिह्न लगाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Meminta catatan opsional, lalu menandai posisi baca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chiede una nota facoltativa, poi segna la posizione di lettura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "メモ（任意）の入力を求めてから、現在の読書位置にしるしを付けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "메모(선택 사항)를 입력받은 다음 읽기 위치에 북마크를 추가합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vraagt om een optionele notitie en markeert dan de leespositie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Prosi o opcjonalną notatkę, a potem oznacza pozycję czytania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pede uma nota opcional e depois marca a posição de leitura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Запрашивает необязательную заметку, затем отмечает позицию чтения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Frågar efter en valfri anteckning och markerar sedan läspositionen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ให้ใส่โน้ตได้หากต้องการ แล้วคั่นตำแหน่งการอ่าน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "İsteğe bağlı bir not ister, sonra okuma konumunu işaretler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Запитує необов’язкову нотатку, потім позначає місце читання."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ایک اختیاری نوٹ مانگتا ہے، پھر مطالعے کی پوزیشن پر نشان لگاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mời bạn nhập ghi chú nếu muốn, rồi đánh dấu vị trí đọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "会询问可选的备注，然后标记阅读位置。"
          }
        },
        "zh-Hant" : {
