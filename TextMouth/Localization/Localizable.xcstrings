        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ can't be made, because the folder that would hold it, %@, can't be found."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se puede crear %1$@ porque no se encuentra la carpeta que lo contendría, %2$@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ساخته نمی‌شود، چون پوشه‌ای که باید آن را نگه دارد، یعنی %2$@، پیدا نمی‌شود."
