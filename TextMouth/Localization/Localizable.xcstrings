        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Klasörüne yazılabildiğinden emin olun, sonra tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Переконайтеся, що в її папку можна записувати, і повторіть спробу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یقینی بنائیں کہ اس کے فولڈر میں لکھا جا سکتا ہے، پھر دوبارہ کوشش کریں۔"
