    "feed.unsubscribeHint.downloads" : {
      "comment" : "VoiceOver hint of the Unsubscribe button in Feed Info when it acts at once.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يتوقف عن الفحص؛ يبقى الموجز وتنزيلاته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "চেক করা বন্ধ করে; ফিড ও এর ডাউনলোড থেকে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beendet die Prüfung; der Feed und seine Downloads bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops checking; the feed and its downloads stay"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deja de revisar; el canal y sus descargas se quedan"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بررسی را متوقف می‌کند؛ فید و بارگیری‌هایش می‌مانند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cesse de vérifier ce flux, qui reste avec ses téléchargements."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מפסיק לבדוק; הערוץ וההורדות שלו נשארים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "जाँचना बंद कर देता है; फ़ीड और उसके डाउनलोड बने रहते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Berhenti memeriksa; feed dan unduhannya tetap ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Smette di controllare; il feed e i suoi download restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このフィードの確認を停止します。フィードとそのダウンロードは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "확인을 중단합니다. 피드와 다운로드는 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stopt met controleren; de feed en de downloads blijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Przestaje sprawdzać; kanał i jego pobrane pliki zostają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deixa de verificar; o feed e os downloads dele permanecem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Прекращает проверку; лента и её загрузки остаются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Slutar kontrollera; flödet och dess nedladdningar finns kvar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หยุดตรวจสอบ ฟีดและรายการดาวน์โหลดของฟีดยังอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Denetlemeyi durdurur; besleme ve indirmeleri kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Припиняє перевірку; стрічка та її завантаження залишаються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "چیک کرنا روک دیتا ہے؛ فیڈ اور اس کے ڈاؤن لوڈز رہتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dừng kiểm tra; nguồn cấp và các bản tải về của nó vẫn còn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止检查；订阅源及其下载内容会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止檢查；訂閱源與其下載項目會保留。"
          }
        }
      }
    },
    "feed.unsubscribeHint.first" : {
      "comment" : "VoiceOver hint of the Unsubscribe button in Feed Info when it asks a question first.",
      "extractionState" : "manual",
