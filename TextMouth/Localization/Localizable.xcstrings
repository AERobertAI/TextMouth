    "libraryFileWait.confirmation.identity.arrives" : {
      "comment" : "Last sentence of the question asked before restoring the library's identity file. %@ is the cloud service's name, or \"the cloud\" when it is unknown.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "إذا وصل الملف من %@ لاحقًا، فإنه يحدد المكتبة نفسها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফাইলটি পরে %@ থেকে এলে তা একই লাইব্রেরিকে নির্দেশ করবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wenn die Datei später von %@ eintrifft, bezeichnet sie dieselbe Bibliothek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the file arrives from %@ later, it names the same library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si el archivo llega más tarde desde %@, identifica la misma biblioteca."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اگر فایل بعداً از %@ برسد، همان کتابخانه را نام می‌برد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si le fichier arrive plus tard depuis %@, il désigne la même bibliothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אם הקובץ יגיע בהמשך דרך %@, הוא יציין את אותה ספרייה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "यदि फ़ाइल बाद में %@ से आती है, तो वह उसी लाइब्रेरी को दर्शाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
