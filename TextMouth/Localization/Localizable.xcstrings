    "brailleFileCode.checkedNote" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. What the alert says first of a choice to or from Unicode braille patterns, which the re-read checks byte by byte before it changes anything (BrailleBookReader.requireReadable(_:as:)), so a wrong one is refused at its first line (review of October 30, finding 5): a file not written in the code named codeName, the one chosen, is refused, and nothing changes. \"If the file is not written in Unicode braille patterns, TextMouth refuses it, and nothing changes.\". Placeholders in order: codeName.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "إذا لم يكن الملف مكتوبًا بترميز %@، يرفضه TextMouth ولا يتغير شيء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফাইলটি %@-এ লেখা না হলে TextMouth সেটি প্রত্যাখ্যান করে, এবং কিছুই বদলায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wenn die Datei nicht in %@ geschrieben ist, lehnt TextMouth sie ab, und nichts ändert sich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the file is not written in %@, TextMouth refuses it, and nothing changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si el archivo no está escrito en %@, TextMouth lo rechaza y no cambia nada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اگر فایل به %@ نوشته نشده باشد، TextMouth آن را نمی‌پذیرد و چیزی تغییر نمی‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si le fichier n’est pas écrit en %@, TextMouth le refuse, et rien ne change."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אם הקובץ אינו כתוב ב-%@, TextMouth דוחה אותו, ושום דבר אינו משתנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "यदि फ़ाइल %@ में नहीं लिखी है, तो TextMouth उसे अस्वीकार कर देता है और कुछ नहीं बदलता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jika file tidak ditulis dalam %@, TextMouth menolaknya, dan tidak ada yang berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se il file non è scritto in %@, TextMouth lo rifiuta e non cambia nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ファイルが%@で書かれていない場合、TextMouth はそれを受け付けず、何も変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "파일이 %@ 형식으로 작성되지 않았으면 TextMouth가 파일을 거부하며 아무것도 변경되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Als het bestand niet in %@ is geschreven, weigert TextMouth het en verandert er niets."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jeśli plik nie jest zapisany w %@, TextMouth go odrzuci i nic się nie zmieni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se o arquivo não estiver escrito em %@, o TextMouth o recusa e nada muda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Если файл не записан в «%@», TextMouth отклонит его, и ничего не изменится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Om filen inte är skriven i %@ avvisar TextMouth den, och inget ändras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หากไฟล์ไม่ได้เขียนด้วย %@ TextMouth จะปฏิเสธไฟล์นั้นและไม่มีอะไรเปลี่ยนแปลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dosya %@ olarak yazılmamışsa TextMouth onu reddeder ve hiçbir şey değişmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо файл не записано в «%@», TextMouth відхилить його, і нічого не зміниться."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اگر فائل %@ میں نہیں لکھی گئی تو TextMouth اسے مسترد کر دیتا ہے، اور کچھ تبدیل نہیں ہوتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nếu tệp không được viết bằng %@, TextMouth sẽ từ chối nó và không có gì thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "如果文件不是以 %@ 写成的，TextMouth 会拒绝读取，并且不会更改任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "如果檔案不是以 %@ 撰寫，TextMouth 會拒絕讀取，且不會有任何更改。"
          }
        }
      }
    },
    "brailleFileCode.notReadableRefusal" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. Why the book titled bookTitle was not read again with the braille file characters named codeName: its file is not braille in them, as reason, the reader's own sentence (BrailleFileError), says, and nothing changed. It has the shape of an encoding's refusal (TextEncodingWording.notValidRefusal(bookTitle:encoding:)): \"“Ledger” can't be read as Eurobraille, six-dot (German-speaking countries): Line 3 holds the control character U+0007, which is not Eurobraille. Nothing was changed.\". Placeholders in order: bookTitle, codeName, reason.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
