        }
      }
    },
    "textImportPolicy.reloadFailedAnnouncement.choose" : {
      "comment" : "Second sentence of the announcement when Reload from Editor could not read the editor's file back: what to do. %1$@ is the name of the Reload from Editor button. %2$@ is the name of the Open in Editor button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "احفظ الملف في المحرر، ثم اختر %1$@ مرة أخرى، أو اختر %2$@ للبدء من جديد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এডিটরে ফাইলটি সংরক্ষণ করুন, তারপর আবার “%1$@” বেছে নিন, অথবা নতুন করে শুরু করতে “%2$@” বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sichere die Datei im Editor und wähle dann erneut %1$@, oder wähle %2$@, um neu zu beginnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save the file in the editor, then choose %@ again, or choose %@ to start again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Guarda el archivo en el editor y elige %1$@ de nuevo, o elige %2$@ para empezar otra vez."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فایل را در ویرایشگر ذخیره کنید و دوباره %1$@ را انتخاب کنید، یا برای شروع دوباره %2$@ را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Enregistrez le fichier dans l’éditeur, puis choisissez de nouveau %@, ou choisissez %@ pour recommencer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "שמור את הקובץ בעורך ואז בחר שוב “%1$@”, או בחר “%2$@” כדי להתחיל מחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "एडिटर में फ़ाइल सहेजें, फिर “%1$@” दोबारा चुनें, या शुरू से करने के लिए “%2$@” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Simpan file di editor, lalu pilih %@ lagi, atau pilih %@ untuk memulai dari awal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Salva il file nell’editor, poi scegli di nuovo %@, oppure scegli %@ per ricominciare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "エディタでファイルを保存してから、もう一度「%1$@」を選択するか、「%2$@」を選択してやり直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "편집기에서 파일을 저장한 다음 %1$@을(를) 다시 선택하거나, %2$@을(를) 선택하여 처음부터 다시 시작하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bewaar het bestand in de editor en kies opnieuw %@, of kies %@ om opnieuw te beginnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zachowaj plik w edytorze, a potem ponownie wybierz: %1$@, albo wybierz: %2$@, aby zacząć od nowa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Salve o arquivo no editor e escolha %1$@ novamente, ou escolha %2$@ para recomeçar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сохраните файл в редакторе и снова выберите «%1$@» или выберите «%2$@», чтобы начать заново."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Spara filen i redigeraren och välj sedan %@ igen, eller välj %@ för att börja om."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "บันทึกไฟล์ในตัวแก้ไข แล้วเลือก %1$@ อีกครั้ง หรือเลือก %2$@ เพื่อเริ่มใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dosyayı düzenleyicide kaydedin, sonra “%1$@” düğmesini yeniden seçin veya baştan başlamak için “%2$@” düğmesini seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Збережіть файл у редакторі та знову виберіть «%1$@» або виберіть «%2$@», щоб почати спочатку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ایڈیٹر میں فائل محفوظ کریں، پھر “%1$@” دوبارہ منتخب کریں، یا نئے سرے سے شروع کرنے کے لیے “%2$@” منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hãy lưu tệp trong trình soạn thảo, rồi chọn lại %1$@, hoặc chọn %2$@ để bắt đầu lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "请在编辑器中存储文件，然后再次选取“%1$@”，或选取“%2$@”重新开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "請在編輯器中儲存檔案，然後再次選擇 %1$@，或選擇 %2$@ 重新開始。"
          }
        }
      }
    },
    "textImportPolicy.reloadMayBeMisread.characters" : {
      "comment" : "First sentence of the note after Reload from Editor read a file whose text encoding nothing in it tells.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أُعيد تحميل النص، لكن ملف المحرر لا يذكر ترميزه، لذا قد تكون بعض الأحرف خاطئة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "টেক্সট আবার লোড হয়েছে, কিন্তু এডিটরের ফাইল কোন এনকোডিংয়ে আছে তা বলে না, তাই কিছু অক্ষর ভুল হতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Text wurde neu geladen, aber die Datei des Editors gibt nicht an, in welcher Codierung sie vorliegt, daher sind einige Zeichen möglicherweise falsch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The text was reloaded, but the editor's file does not say what encoding it is in, so some characters may be wrong."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se recargó el texto, pero el archivo del editor no indica en qué codificación está, así que algunos caracteres pueden ser incorrectos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "متن بازخوانی شد، اما فایل ویرایشگر نمی‌گوید با چه کدگذاری‌ای نوشته شده، بنابراین ممکن است برخی نویسه‌ها نادرست باشند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le texte a été rechargé, mais le fichier de l’éditeur n’indique pas son encodage, donc certains caractères peuvent être erronés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הטקסט נטען מחדש, אבל קובץ העורך אינו מציין באיזה קידוד הוא כתוב, ולכן ייתכן שחלק מהתווים שגויים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "टेक्स्ट फिर से लोड हुआ, लेकिन एडिटर की फ़ाइल यह नहीं बताती कि वह किस एन्कोडिंग में है, इसलिए कुछ वर्ण गलत हो सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Teks dimuat ulang, tetapi file editor tidak menyebutkan pengodeannya, jadi beberapa karakter mungkin salah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo è stato ricaricato, ma il file dell’editor non indica in quale codifica sia, quindi alcuni caratteri potrebbero essere errati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "テキストを再読み込みしましたが、エディタのファイルには文字エンコーディングが示されていないため、一部の文字が正しくない場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "텍스트를 다시 불러왔지만 편집기의 파일에 인코딩 정보가 없어 일부 문자가 잘못될 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De tekst is opnieuw geladen, maar het bestand van de editor geeft niet aan in welke codering het staat, dus sommige tekens kunnen onjuist zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tekst wczytano ponownie, ale plik edytora nie podaje kodowania, więc niektóre znaki mogą być nieprawidłowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O texto foi recarregado, mas o arquivo do editor não diz em que codificação está, então alguns caracteres podem estar errados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Текст перезагружен, но файл редактора не указывает кодировку, поэтому некоторые символы могут быть неверными."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texten lästes in igen, men redigerarens fil anger inte vilken teckenkodning den har, så vissa tecken kan vara fel."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "โหลดข้อความซ้ำแล้ว แต่ไฟล์ของตัวแก้ไขไม่ได้ระบุการเข้ารหัส อักขระบางตัวจึงอาจผิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Metin yeniden yüklendi, ancak düzenleyicinin dosyası hangi kodlamada olduğunu söylemiyor, bu yüzden bazı karakterler yanlış olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Текст перезавантажено, але у файлі редактора не вказано кодування, тому деякі символи можуть бути неправильними."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "متن دوبارہ لوڈ ہو گیا، لیکن ایڈیٹر کی فائل یہ نہیں بتاتی کہ وہ کس انکوڈنگ میں ہے، اس لیے کچھ حروف غلط ہو سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Văn bản đã được tải lại, nhưng tệp của trình soạn thảo không cho biết nó dùng bảng mã nào, nên một số ký tự có thể sai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文本已重新载入，但编辑器的文件没有说明其所用编码，因此部分字符可能有误。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文字已重新載入，但編輯器的檔案沒有說明其編碼，因此部分字元可能有誤。"
          }
        }
      }
    },
    "textImportPolicy.reloadMayBeMisread.choose" : {
      "comment" : "Second sentence of the note after Reload from Editor read a file whose text encoding nothing in it tells: what to do. UTF-8 is the name of a text encoding. %@ is the name of the Reload from Editor button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تحقق من النص، أو احفظ الملف في المحرر بترميز UTF-8 ثم اختر %@ مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "টেক্সট পরীক্ষা করুন, অথবা এডিটরে ফাইলটি UTF-8 হিসেবে সংরক্ষণ করে আবার “%@” বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Prüfe den Text oder sichere die Datei im Editor als UTF-8 und wähle erneut %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the text, or save the file in the editor as UTF-8 and choose %@ again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Revisa el texto, o guarda el archivo en el editor como UTF-8 y elige %@ de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "متن را بررسی کنید، یا فایل را در ویرایشگر با UTF-8 ذخیره کنید و دوباره %@ را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vérifiez le texte, ou enregistrez le fichier dans l’éditeur en UTF-8 et choisissez de nouveau %@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בדוק את הטקסט, או שמור את הקובץ בעורך כ-UTF-8 ובחר שוב “%@”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "टेक्स्ट जाँचें, या फ़ाइल को एडिटर में UTF-8 के रूप में सहेजें और फिर से “%@” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Periksa teksnya, atau simpan file di editor sebagai UTF-8 lalu pilih %@ lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Controlla il testo, oppure salva il file nell’editor come UTF-8 e scegli di nuovo %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "テキストを確認するか、ファイルをエディタで UTF-8 として保存してから、もう一度「%@」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "텍스트를 확인하거나 편집기에서 파일을 UTF-8로 저장한 다음 %@을(를) 다시 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Controleer de tekst, of bewaar het bestand in de editor als UTF-8 en kies opnieuw %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sprawdź tekst albo zachowaj plik w edytorze jako UTF-8 i ponownie wybierz: %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Verifique o texto ou salve o arquivo no editor como UTF-8 e escolha %@ novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Проверьте текст или сохраните файл в редакторе в кодировке UTF-8 и снова выберите «%@»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kontrollera texten, eller spara filen i redigeraren som UTF-8 och välj %@ igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตรวจสอบข้อความ หรือบันทึกไฟล์ในตัวแก้ไขเป็น UTF-8 แล้วเลือก %@ อีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Metni kontrol edin veya dosyayı düzenleyicide UTF-8 olarak kaydedin ve “%@” düğmesini yeniden seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Перевірте текст або збережіть файл у редакторі як UTF-8 і знову виберіть %@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "متن کو جانچیں، یا فائل کو ایڈیٹر میں UTF-8 کے طور پر محفوظ کریں اور “%@” دوبارہ منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hãy kiểm tra văn bản, hoặc lưu tệp trong trình soạn thảo dưới dạng UTF-8 rồi chọn lại %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "请检查文本，或将编辑器中的文件存储为 UTF-8，然后再次选取“%@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "請檢查文字，或在編輯器中將檔案儲存為 UTF-8，然後再次選擇 %@。"
          }
        }
      }
    },
