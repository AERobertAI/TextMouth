        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не дає відтворенню поновлюватися, коли навушники відключаються"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "耳机断开时阻止播放自动恢复。"
          }
        }
      }
    },
    "Stops playing, and goes back to where playing began." : {
      "comment" : "Hint of the audio editor's Stop button.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppt die Wiedergabe und geht zurück dorthin, wo sie begann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detiene la reproducción y vuelve a donde empezó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrête la lecture et revient où elle avait commencé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe la riproduzione e torna al punto da cui è iniziata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para a reprodução e volta ao ponto onde ela começou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Останавливает воспроизведение и возвращается туда, где оно началось."
          }
        }
      }
    },
    "Stops recording and saves it in your library as an audiobook." : {
      "comment" : "VoiceOver hint of the Stop button in the Record window.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppt die Aufnahme und sichert sie als Hörbuch in deiner Bibliothek."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detiene la grabación y la guarda en tu biblioteca como audiolibro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrête l’enregistrement et l’enregistre dans votre bibliothèque comme livre audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe la registrazione e la salva nella tua libreria come audiolibro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para a gravação e a salva na sua biblioteca como audiolivro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Останавливает запись и сохраняет её в вашей библиотеке как аудиокнигу."
          }
        }
      }
    },
    "Stops saying the code was guessed. The book is not read again." : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Code wird nicht mehr als erraten bezeichnet. Das Buch wird nicht erneut gelesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deja de decir que el código fue deducido. El libro no se vuelve a leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cesse d’indiquer que le code a été deviné. Le livre n’est pas relu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Smette di dire che il codice è stato dedotto. Il libro non viene riletto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para de dizer que o código foi deduzido. O livro não é lido novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Больше не сообщает, что код определён автоматически. Книга не читается заново."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Більше не повідомляє, що код припущено. Книгу не буде прочитано знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "不再说明此编码为推测所得。不会重新读取图书。"
          }
        }
      }
    },
    "Stops the download. Nothing is installed." : {
      "comment" : "VoiceOver hint of the Cancel Download button.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppt den Download. Es wird nichts installiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detiene la descarga. No se instala nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrête le téléchargement. Rien n’est installé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe il download. Non viene installato nulla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe o download. Nada é instalado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Останавливает загрузку. Ничего не устанавливается."
          }
        }
      }
    },
    "Stops the export and keeps the chapters already spoken until TextMouth quits, a different spoken audio export starts, or the book's voice, text, substitutions, or pauses change. Exporting the same range at the same speed and pitch goes on from them." : {
      "comment" : "The hint of the Stop button in the Export dialog while a spoken audio export runs.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppt den Export und behält die bereits gesprochenen Kapitel, bis TextMouth beendet wird, ein anderer gesprochener Audioexport beginnt oder Stimme, Text, Ersetzungen oder Pausen des Buchs sich ändern. Ein Export desselben Bereichs mit derselben Geschwindigkeit und Tonhöhe setzt dort fort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detiene la exportación y conserva los capítulos ya leídos hasta que TextMouth se cierre, comience otra exportación de audio hablado, o cambien la voz, el texto, las sustituciones o las pausas del libro. Si exportas el mismo intervalo con la misma velocidad y el mismo tono, continúa desde ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrête l’exportation et conserve les chapitres déjà lus jusqu’à ce que TextMouth se ferme, qu’une autre exportation audio parlée démarre, ou que la voix, le texte, les substitutions ou les pauses du livre changent. Exporter la même plage à la même vitesse et à la même hauteur reprend à partir d’eux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe l’esportazione e conserva i capitoli già letti fino a quando TextMouth non viene chiuso, non inizia un’altra esportazione dell’audio parlato o non cambiano la voce, il testo, le sostituzioni o le pause del libro. Esportando lo stesso intervallo con la stessa velocità e lo stesso tono si prosegue da quelli."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe a exportação e mantém os capítulos já falados até o TextMouth fechar, outra exportação de áudio falado começar ou a voz, o texto, as substituições ou as pausas do livro mudarem. Exportar o mesmo intervalo com a mesma velocidade e o mesmo tom continua a partir deles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Останавливает экспорт и сохраняет уже озвученные главы до выхода из TextMouth, начала другого экспорта озвученного аудио или изменения голоса, текста, замен или пауз книги. Экспорт того же диапазона с теми же скоростью и высотой тона продолжится с них."
          }
        }
      }
    },
    "Stops the export. The file being made is not kept." : {
      "comment" : "The hint of the Stop button in the Export dialog.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppt den Export. Die Datei, die gerade erstellt wird, wird nicht behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detiene la exportación. El archivo que se estaba creando no se conserva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrête l’exportation. Le fichier en cours de création n’est pas conservé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe l’esportazione. Il file in creazione non viene conservato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe a exportação. O arquivo que está sendo criado não é mantido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Останавливает экспорт. Создаваемый файл не сохраняется."
          }
        }
      }
    },
    "Stops the import under way and those waiting. Books already imported stay." : {
      "comment" : "VoiceOver hint of the import overlay's Cancel button.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
