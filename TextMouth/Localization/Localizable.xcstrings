        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 是订阅源的项目，订阅源的项目无法移动。"
          }
        }
      }
    },
    "%@ is being transcribed. Cancel it, or attach the transcript once it finishes." : {
      "comment" : "Alert shown when Attach Transcript is chosen for an audiobook that is being transcribed. %@ is the audiobook's title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ wird gerade transkribiert. Brich den Vorgang ab oder hänge das Transkript an, sobald er fertig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ se está transcribiendo. Cancélalo o adjunta la transcripción cuando termine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ est en cours de transcription. Annulez-la, ou joignez la transcription une fois qu’elle est terminée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il libro %@ è in fase di trascrizione. Annullala, oppure allega la trascrizione al termine."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ está sendo transcrito. Cancele a transcrição ou anexe a transcrição quando ela terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Аудиокнига «%@» сейчас расшифровывается. Отмените расшифровку или прикрепите расшифровку после её завершения."
          }
        }
      }
    },
    "%@ is being transcribed. Cancel it, or delete the transcript once it finishes." : {
      "comment" : "Alert shown when Delete Transcript is chosen for an audiobook that is being transcribed. %@ is the audiobook's title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
