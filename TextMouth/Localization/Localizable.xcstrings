          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ao retomar a reprodução, retrocede até o início desta unidade"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "При возобновлении воспроизведения перематывает к началу этой единицы"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Під час відновлення відтворення перемотувати до початку цієї одиниці"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
