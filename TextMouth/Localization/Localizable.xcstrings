    "audioEditor.applyPreviewsFirstHint" : {
      "comment" : "Hint of the audio editor's Apply button while a press would play a preview first.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
