    "bookExport.settingHint" : {
      "comment" : "The hint of the Playback settings checkbox that shows the Export button in the reader's toolbar. \"File, Export\" is the menu command.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يضيف زر تصدير إلى شريط أدوات كل قارئ. يعمل الأمر ملف، تصدير في الحالتين."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "প্রতিটি রিডারের টুলবারে একটি রপ্তানি বোতাম যোগ করে। ফাইল মেনুর “রপ্তানি করুন…” যেকোনো ক্ষেত্রেই কাজ করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fügt der Symbolleiste jeder Leseansicht eine Taste „Exportieren“ hinzu. „Ablage“, „Exportieren“ funktioniert in beiden Fällen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds an Export button to each reader's toolbar. File, Export works either way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Agrega un botón Exportar a la barra de herramientas de cada lector. Archivo, Exportar funciona de las dos maneras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یک دکمه «صادر کردن» به نوار ابزار هر کتاب‌خوان اضافه می‌کند. «فایل»، «صادر کردن» در هر حال کار می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ajoute un bouton Exporter à la barre d’outils de chaque lecteur. La commande Fichier, Exporter fonctionne dans les deux cas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מוסיף לסרגל הכלים של כל קורא לחצן “ייצא”. הפקודה “קובץ”, “ייצא” פועלת בכל מקרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "हर रीडर के टूलबार में एक निर्यात बटन जोड़ता है। “फ़ाइल” मेनू का “निर्यात करें” दोनों तरह से काम करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menambahkan tombol Ekspor ke bar alat setiap pembaca. File, Ekspor tetap berfungsi dalam kedua kasus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aggiunge un pulsante Esporta alla barra degli strumenti di ogni lettore. File, Esporta funziona in entrambi i casi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "各リーダのツールバーに「書き出す」ボタンを追加します。「ファイル」メニューの「書き出す」は、どちらの場合も使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "각 리더의 도구 막대에 내보내기 버튼을 추가합니다. 파일 메뉴의 내보내기는 어느 쪽이든 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voegt een knop Exporteer toe aan de knoppenbalk van elke lezer. Archief, Exporteer werkt in beide gevallen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dodaje przycisk Eksportuj do paska narzędzi każdego czytnika. Plik, Eksportuj działa w obu przypadkach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Adiciona um botão Exportar à barra de ferramentas de cada leitor. Arquivo, Exportar funciona de qualquer forma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Добавляет кнопку «Экспортировать» на панель инструментов каждого окна чтения. Команда меню «Файл», «Экспортировать» работает и без неё."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lägger till en Exportera-knapp i varje läsares verktygsfält. ”Arkiv”, ”Exportera” fungerar i båda fallen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เพิ่มปุ่มส่งออกในแถบเครื่องมือของตัวอ่านแต่ละตัว ไฟล์ ส่งออก ใช้ได้เช่นกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Her okuyucunun araç çubuğuna bir Dışa Aktar düğmesi ekler. Dosya, Dışa Aktar her iki durumda da çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Додає кнопку «Експортувати» на панель інструментів кожного вікна читання. Команда «Експортувати» в меню «Файл» працює в обох випадках."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ہر ریڈر کے ٹول بار میں برآمد کا بٹن شامل کرتا ہے۔ مینو “فائل” میں “برآمد کریں…” دونوں صورتوں میں کام کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thêm nút Xuất vào thanh công cụ của mỗi trình đọc. Tệp, Xuất vẫn dùng được trong cả hai trường hợp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在每个阅读器的工具栏中添加“导出”按钮。使用“文件”菜单中的“导出”同样可以导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在每個閱讀器的工具列加入「輸出」按鈕。無論是否加入，「檔案」選單中的「輸出」都可以使用。"
          }
        }
      }
    },
