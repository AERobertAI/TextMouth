    "libraryViewModel.quitOpenAgain" : {
      "comment" : "Last sentence of the message when Use This Library could not open TextMouth again: what to do.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
