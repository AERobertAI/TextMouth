    "libraryViewsSettings.deleted" : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). What VoiceOver says once a view is deleted, naming the view selected now and its place (finding 13): \"Deleted Mine. Feeds selected, 6 of 6.\". Placeholders in order: name, selected, number, count.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم حذف %1$@. تم تحديد %2$@، %3$lld من %4$lld."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ মুছে ফেলা হয়েছে। %2$@ নির্বাচিত, %4$lldটির মধ্যে %3$lld।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ gelöscht. %2$@ ausgewählt, %3$lld von %4$lld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleted %@. %@ selected, %lld of %lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se eliminó %1$@. Seleccionada ahora: %2$@, %3$lld de %4$lld."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ حذف شد. %@ انتخاب شد، %lld از %lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vue %@ supprimée. Vue %@ sélectionnée, %lld sur %lld."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בוצעה מחיקה של %1$@. נבחר: %2$@, %3$lld מתוך %4$lld."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ मिटाया गया। %2$@ चयनित, %4$lld में से %3$lld।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ dihapus. %@ dipilih, %lld dari %lld."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eliminata la vista %@. Selezionata la vista %@, %lld di %lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@を削除しました。%2$@を選択中、%4$lld件中%3$lld件目。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 삭제됨. %2$@ 선택됨, %4$lld개 중 %3$lld번째."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ verwijderd. %@ geselecteerd, %lld van %lld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usunięto widok %1$@. Zaznaczono: %2$@, %3$lld z %4$lld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Visualização %1$@ excluída. Agora selecionada: %2$@, %3$lld de %4$lld."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Удалено: %1$@. Выбрано: %2$@, %3$lld из %4$lld."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ raderades. %@ markerad, %lld av %lld."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ลบ %1$@ แล้ว, เลือก %2$@ แล้ว, %3$lld จาก %4$lld"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ silindi. %2$@ seçili, %4$lld içinden %3$lld."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Видалено: %1$@. Вибрано: %2$@, %3$lld з %4$lld."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ حذف کیا گیا۔ %2$@ منتخب، %4$lld میں سے %3$lld۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đã xóa %1$@. %2$@ được chọn, %3$lld trên %4$lld."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
