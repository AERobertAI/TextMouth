                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "(%lld books not yet opened)"
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "(%lld de libros aún sin abrir)"
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "(%lld libro aún sin abrir)"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "(%lld libros aún sin abrir)"
                }
              }
            }
