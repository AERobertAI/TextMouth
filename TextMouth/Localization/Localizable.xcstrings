        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth نمی‌تواند فایل صوتی %1$@ را بخواند، زیرا %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
