    "audioEditor.explanation.editorPaste" : {
      "comment" : "Hint of the audio editor's Paste button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يلصق عند المؤشر، أو فوق التحديد. بعد القص مباشرة ينقل الصوت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "কার্সরের জায়গায় বা নির্বাচনের ওপর পেস্ট করে। কাটার ঠিক পরে এটি অডিও সরিয়ে দেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Setzt am Cursor oder über der Auswahl ein. Direkt nach „Ausschneiden“ verschiebt es das Audio."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastes at the cursor, or over the selection. Right after a cut, it moves the audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pega en el cursor o sobre la selección. Justo después de cortar, mueve el audio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "در محل مکان‌نما یا روی انتخاب می‌چسباند. بلافاصله پس از برش، صدا را جابه‌جا می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Colle au curseur, ou sur la sélection. Juste après une coupure, déplace l’audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מדביק בסמן, או על הבחירה. מיד לאחר גזירה הוא מעביר את השמע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कर्सर पर, या चयन के ऊपर पेस्ट करता है। काटने के तुरंत बाद, यह ऑडियो को ले जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menempel di posisi kursor, atau menimpa pilihan. Tepat setelah memotong, audio dipindahkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Incolla nella posizione del cursore o sopra la selezione. Subito dopo un taglio, sposta l’audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "カーソルの位置に、または選択範囲の上にペーストします。カットの直後は、オーディオを移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "커서 위치나 선택 영역 위에 붙여넣습니다. 잘라낸 직후에는 오디오를 이동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Plakt bij de cursor of over de selectie. Direct na knippen verplaatst het de audio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wkleja przy kursorze albo w miejsce zaznaczenia. Zaraz po wycięciu przenosi dźwięk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cola no cursor ou sobre a seleção. Logo depois de cortar, move o áudio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вставляет в позиции курсора или поверх выделенного. Сразу после вырезания перемещает аудио."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Klistrar in vid markören, eller över markeringen. Direkt efter en utklippning flyttar det ljudet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "วางที่เคอร์เซอร์ หรือทับส่วนที่เลือก หากวางทันทีหลังตัด จะเป็นการย้ายเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "İmleç konumuna veya seçimin üzerine yapıştırır. Kesmeden hemen sonra sesi taşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вставляє в місці курсора або поверх виділення. Одразу після вирізання переміщує аудіо."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کرسر پر، یا انتخاب کی جگہ، چسپاں کرتا ہے۔ کاٹنے کے فوراً بعد یہ آڈیو کو منتقل کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dán tại con trỏ, hoặc đè lên vùng chọn. Ngay sau khi cắt, thao tác này di chuyển âm thanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在光标处粘贴，或替换所选内容。剪切后立即粘贴会移动音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "貼在游標處，或取代選取範圍。剪下後立刻貼上，會移動該段音訊。"
          }
        }
      }
    },
