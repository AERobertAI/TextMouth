    "Turn off writing to the file, or download the book first." : {
      "comment" : "Second sentence of the message when Save in Book Information is refused because the book's EPUB file is only in the cloud: what to do.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أوقف الكتابة في الملف، أو نزّل الكتاب أولًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Schalte das Schreiben in die Datei aus oder lade das Buch zuerst herunter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Desactiva la escritura en el archivo o descarga primero el libro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Désactivez l’écriture dans le fichier, ou téléchargez d’abord le livre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ाइल में लिखना बंद करें, या पहले पुस्तक डाउनलोड करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Matikan penulisan ke file, atau unduh buku terlebih dahulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disattiva la scrittura nel file, oppure scarica prima il libro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ファイルへの書き込みをオフにするか、先にブックをダウンロードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "파일에 쓰기를 끄거나 먼저 책을 다운로드하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
