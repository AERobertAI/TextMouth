    "%@: %lld new articles." : {
      "comment" : "A sentence of the alert after a refresh brought new articles: one feed's arrivals. %@ is the feed's title; %lld is how many new articles.\nWhat VoiceOver says once Check Feed found new articles. %@ is the feed's title; %lld is how many new articles.",
      "localizations" : {
