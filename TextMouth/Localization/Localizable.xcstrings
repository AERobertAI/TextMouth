    "feedSubscribeError.message.folderMissing" : {
      "comment" : "Why Subscribe refused: the folder chosen for the feed was removed from the library.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يعد المجلد المختار لهذا الموجز في المكتبة. اختر مجلدًا آخر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই ফিডের জন্য বেছে নেওয়া ফোল্ডার আর লাইব্রেরিতে নেই। অন্য একটি ফোল্ডার বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der für diesen Feed gewählte Ordner ist nicht mehr in der Bibliothek. Wähle einen anderen Ordner."
          }
        },
        "en" : {
          "stringUnit" : {
