    "shortcutsSettings.nowWaits" : {
      "comment" : "Announced by VoiceOver after a key's double press was given to an action: the key's single press now waits a moment before it acts, in case a second press follows. %1$@ is the key in words, such as \"J\", and %2$@ is the name of the action of its single press.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ينتظر الآن قبل %2$@، تحسبًا لضغطه مرتين."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ এখন “%2$@” চালানোর আগে অপেক্ষা করে, কারণ এটি দুইবার চাপা হতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ wartet jetzt kurz, bevor %2$@ ausgeführt wird, falls die Taste zweimal gedrückt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ now waits before %@, in case it is pressed twice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ahora espera antes de %2$@, por si se pulsa dos veces."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ اکنون پیش از اجرای %2$@ کمی منتظر می‌ماند، چون ممکن است دو بار فشرده شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ attend désormais avant l’action « %@ », au cas où on appuierait deux fois dessus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ממתין כעת לפני %2$@, למקרה שתתבצע לחיצה שנייה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ अब %2$@ से पहले थोड़ा रुकता है, कहीं उसे दो बार न दबाया जाए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ kini menunggu sebelum %2$@, kalau-kalau ditekan dua kali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ora attende un attimo prima di eseguire %@, nel caso venga premuto due volte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@を1回押すと、続けて押される場合に備えて、「%2$@」の前に少し待ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이제 %1$@ 키를 한 번 누르면 두 번 누를 때를 대비해 %2$@ 실행 전에 잠시 기다립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ wacht nu even met %@, voor het geval de toets twee keer wordt ingedrukt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Skrót %1$@ czeka teraz chwilę przed wykonaniem działania %2$@, na wypadek gdyby został naciśnięty dwukrotnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A tecla %1$@ agora espera antes de %2$@, caso seja pressionada duas vezes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ теперь ждёт перед действием «%2$@» на случай двойного нажатия."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ väntar nu innan ”%@” utförs, ifall tangenten trycks två gånger."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ จะรอสักครู่ก่อน%2$@ เผื่อกดสองครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ artık %2$@ işleminden önce bekliyor, çünkü iki kez basılabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ тепер чекає, перш ніж виконати «%2$@», на випадок подвійного натискання."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ کا ایک بار دبانا اب %2$@ سے پہلے انتظار کرتا ہے، کیونکہ اسے دو بار بھی دبایا جا سکتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ bây giờ sẽ đợi một chút trước khi %2$@, phòng khi được nhấn hai lần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 现在会在 %2$@ 之前稍等片刻，以防被按两次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 現在會稍候一下才執行 %2$@，以防連按兩次。"
          }
        }
      }
    },
    "shortcutsSettings.recordHint" : {
