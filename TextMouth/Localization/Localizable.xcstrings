        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "使うには、ブックを開いて、「ブック」メニューから「%@」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
