    "libraryViewModel.makeDAISYFolderPanel.audiobook" : {
      "comment" : "Message of the panel that chooses folders to import. ncc.html and .opf are file names inside a DAISY book.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اختر كل مجلد تريد استيراده: مجلد كتاب DAISY، وفيه ملف ncc.html أو .opf، أو مجلد مقاطع صوتية يصبح كتابًا صوتيًا واحدًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আমদানির জন্য প্রতিটি ফোল্ডার বেছে নিন: ncc.html বা .opf ফাইলসহ একটি DAISY বইয়ের ফোল্ডার, অথবা অডিও ট্র্যাকের একটি ফোল্ডার, যা একটি অডিওবুক হয়ে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wähle jeden Ordner, der importiert werden soll: den Ordner eines DAISY-Buchs mit seiner Datei ncc.html oder .opf oder einen Ordner mit Audiotracks, aus dem ein Hörbuch wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose each folder to import: a DAISY book's folder, with its ncc.html or .opf file, or a folder of audio tracks, which becomes one audiobook."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige cada carpeta que quieras importar: la carpeta de un libro DAISY, con su archivo ncc.html o .opf, o una carpeta de pistas de audio, que se convierte en un solo audiolibro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هر پوشه را برای وارد کردن انتخاب کنید: پوشه‌ی کتاب DAISY همراه با فایل ncc.html یا .opf، یا پوشه‌ای از تراک‌های صوتی که یک کتاب صوتی می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisissez chaque dossier à importer : le dossier d’un livre DAISY, avec son fichier ncc.html ou .opf, ou un dossier de pistes audio, qui devient un livre audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בחר כל תיקייה לייבוא: תיקיית ספר DAISY, עם קובץ ncc.html או .opf, או תיקייה של רצועות שמע, שהופכת לספר שמע אחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आयात करने के लिए हर फ़ोल्डर चुनें: DAISY पुस्तक का फ़ोल्डर, जिसमें उसकी ncc.html या .opf फ़ाइल हो, या ऑडियो ट्रैक का फ़ोल्डर, जो एक ऑडियोबुक बन जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pilih setiap folder yang akan diimpor: folder buku DAISY, dengan file ncc.html atau .opf-nya, atau folder berisi trek audio, yang menjadi satu buku audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scegli ogni cartella da importare: la cartella di un libro DAISY, con il suo file ncc.html o .opf, o una cartella di tracce audio, che diventa un solo audiolibro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "読み込むフォルダを選択してください。ncc.html または .opf ファイルのある DAISY ブックのフォルダ、またはオーディオトラックのフォルダ（1つのオーディオブックになります）を選択できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "가져올 폴더를 각각 선택하십시오. ncc.html 또는 .opf 파일이 있는 DAISY 책 폴더나, 하나의 오디오북이 되는 오디오 트랙 폴더를 선택할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kies elke map om te importeren: de map van een DAISY-boek, met het bestand ncc.html of .opf, of een map met audiotracks, die één luisterboek wordt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wybierz każdy folder do zaimportowania: folder książki DAISY z plikiem ncc.html lub .opf albo folder ze ścieżkami audio, który stanie się jednym audiobookiem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escolha cada pasta a importar: a pasta de um livro DAISY, com seu arquivo ncc.html ou .opf, ou uma pasta de faixas de áudio, que se torna um audiolivro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Выберите каждую папку для импорта: папку книги DAISY с файлом ncc.html или .opf либо папку с аудиодорожками, которая станет одной аудиокнигой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Välj varje mapp som ska importeras: en DAISY-boks mapp med dess ncc.html- eller .opf-fil, eller en mapp med ljudspår, som blir en ljudbok."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เลือกแต่ละโฟลเดอร์ที่จะนำเข้า: โฟลเดอร์ของหนังสือ DAISY ที่มีไฟล์ ncc.html หรือ .opf หรือโฟลเดอร์ของแทร็กเสียง ซึ่งจะกลายเป็นหนังสือเสียงหนึ่งเล่ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "İçe aktarılacak her klasörü seçin: ncc.html veya .opf dosyası olan bir DAISY kitabının klasörü ya da tek bir sesli kitap olacak bir ses parçaları klasörü."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Виберіть кожну папку для імпорту: папку книги DAISY з файлом ncc.html або .opf чи папку з аудіодоріжками, яка стане однією аудіокнигою."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "درآمد کرنے کے لیے ہر فولڈر منتخب کریں: DAISY کتاب کا فولڈر، جس میں اس کی ncc.html یا opf فائل ہو، یا آڈیو ٹریکس کا فولڈر، جو ایک آڈیو بک بنتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chọn từng thư mục cần nhập: thư mục của một sách DAISY, có tệp ncc.html hoặc .opf, hoặc một thư mục các bản âm thanh, sẽ thành một sách nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "选取要导入的每个文件夹：DAISY 图书的文件夹（含 ncc.html 或 .opf 文件），或音轨文件夹（将成为一本有声书）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
