    "The feed stays in your library with its settings and %@, and %@ checks it again." : {
      "comment" : "A sentence of the confirmation before Unsubscribe: the feed stays, with its settings and its downloads. The first %@ is the downloads, such as \"its 2 downloaded episodes\"; the second is the name of the Resubscribe command.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Feed bleibt in deiner Bibliothek, behält seine Einstellungen und %1$@, und mit %2$@ wird er erneut geprüft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The feed stays in your library with its settings and %1$@, and %2$@ checks it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El canal se queda en tu biblioteca con sus ajustes y %1$@, y %2$@ lo vuelve a revisar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le flux reste dans votre bibliothèque avec ses réglages et %1$@, et la commande %2$@ le vérifie de nouveau."
          }
        },
        "hi" : {
          "stringUnit" : {
