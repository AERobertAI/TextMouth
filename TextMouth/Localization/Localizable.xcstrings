        }
      }
    },
    "TextMouth is opening again on another library, so they stay unsaved in this one." : {
      "comment" : "Why a failed save stays unsaved: TextMouth is switching to another library. \"They\" is the changes that could not be saved.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يُعاد فتح TextMouth على مكتبة أخرى، لذا تبقى غير محفوظة في هذه المكتبة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth অন্য একটি লাইব্রেরিতে আবার খুলছে, তাই এই লাইব্রেরিতে সেগুলো অসংরক্ষিত থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth wird erneut mit einer anderen Bibliothek geöffnet, daher bleiben sie in dieser ungesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth se está abriendo de nuevo con otra biblioteca, así que siguen sin guardarse en esta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth se rouvre sur une autre bibliothèque ; elles restent donc non enregistrées dans celle-ci."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth दूसरी लाइब्रेरी पर फिर से खुल रहा है, इसलिए वे इसमें असहेजे रहते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth akan terbuka lagi pada pustaka lain, jadi semuanya tetap tidak tersimpan di pustaka ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth si sta riaprendo su un’altra libreria, quindi restano non salvate in questa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は別のライブラリで開き直すため、それらはこのライブラリでは未保存のままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 다른 보관함으로 다시 열리므로 이 보관함에서는 저장되지 않은 채로 남습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth está abrindo de novo em outra biblioteca, então elas continuam sem salvar nesta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth снова открывается с другой библиотекой, поэтому в этой они остаются несохранёнными."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth знову відкривається з іншою бібліотекою, тому в цій вони залишаються незбереженими."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 正在另一个资料库上重新打开，因此它们在此资料库中保持未存储。"
          }
        }
      }
    },
    "TextMouth is opening again on another library, so they stay where they are in this one." : {
      "comment" : "Why a failed move of files stays undone: TextMouth is switching to another library. \"They\" is the files.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يُعاد فتح TextMouth على مكتبة أخرى، لذا تبقى في أماكنها في هذه المكتبة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth অন্য একটি লাইব্রেরিতে আবার খুলছে, তাই এই লাইব্রেরিতে সেগুলো যেখানে আছে সেখানেই থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
