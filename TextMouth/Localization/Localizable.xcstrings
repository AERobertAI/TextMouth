    "bookTextEdit.heldReason.wordsWithoutSentences" : {
      "comment" : "Reason after a colon: the user added words to a chapter of a transcript that has no speech; begins in lower case.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يضيف كلمات إلى فصل لا كلام فيه، ولا يمكن الاحتفاظ بها. أزلها واحفظ مرة أخرى، فيظهر النص."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এটি এমন একটি অধ্যায়ে শব্দ যোগ করেছে যাতে কথা নেই, সেখানে সেগুলো রাখা যায় না। সেগুলো সরিয়ে আবার সংরক্ষণ করুন, তাহলে টেক্সট দেখা যাবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "er fügt einem Kapitel ohne gesprochenen Text Wörter hinzu, die dort nicht behalten werden können. Entferne sie und sichere erneut, dann wird der Text angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "it adds words to a chapter with no speech, where they can't be kept. Remove them and save again, and the text shows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "agrega palabras a un capítulo sin voz, donde no se pueden conservar. Quítalas y guarda de nuevo, y el texto se mostrará."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کلمه‌هایی به فصلی بدون گفتار اضافه می‌کند که قابل نگه‌داری نیستند. آن‌ها را بردارید و دوباره ذخیره کنید، تا متن نمایش داده شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "il ajoute des mots à un chapitre sans parole, où ils ne peuvent pas être conservés. Retirez-les et enregistrez à nouveau, et le texte s’affiche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הוא מוסיף מילים לפרק ללא דיבור, שבו לא ניתן לשמור אותן. הסר אותן ושמור שוב, והטקסט יוצג."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "वह ऐसे अध्याय में शब्द जोड़ता है जिसमें कुछ भी बोला नहीं गया है, जहाँ उन्हें रखा नहीं जा सकता। उन्हें हटाएँ और फिर से सहेजें, तब टेक्स्ट दिखेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "teks itu menambahkan kata ke bab tanpa ucapan, sehingga tidak dapat disimpan. Buang kata itu lalu simpan lagi, maka teks akan tampil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "la trascrizione aggiunge parole a un capitolo senza parlato, dove non possono essere conservate. Rimuovile e salva di nuovo, e il testo viene mostrato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "音声のないチャプタに単語が追加されており、保持できません。取り除いてもう一度保存すると、テキストが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "음성이 없는 챕터에 단어가 추가되었으며, 이 단어는 보관할 수 없습니다. 제거하고 다시 저장하면 텍스트가 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "het voegt woorden toe aan een hoofdstuk zonder spraak, waar ze niet kunnen worden bewaard. Haal ze weg en bewaar opnieuw, en de tekst verschijnt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "edytowana transkrypcja dodaje słowa do rozdziału bez mowy, w którym nie można ich zachować. Usuń je i zachowaj ponownie, a tekst się pokaże."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ele adiciona palavras a um capítulo sem fala, onde elas não podem ser mantidas. Remova-as e salve de novo, e o texto será exibido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "в него добавлены слова в главу без речи, где их нельзя сохранить. Уберите их и сохраните снова, и текст появится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "den lägger till ord i ett kapitel utan tal, där de inte kan behållas. Ta bort dem och spara igen, så visas texten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เพิ่มคำในบทที่ไม่มีเสียงพูด ซึ่งเก็บคำเหล่านั้นไว้ไม่ได้ นำคำออกแล้วบันทึกอีกครั้ง แล้วข้อความจะแสดง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "konuşması olmayan bir bölüme kelime ekliyor; bunlar saklanamaz. Kaldırıp yeniden kaydedin, böylece metin görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "до розділу без мовлення додано слова, яких не можна зберегти. Вилучіть їх і збережіть знову, і текст з’явиться."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس نے ایسے باب میں الفاظ شامل کیے ہیں جس میں کوئی تقریر نہیں، جہاں وہ رکھے نہیں جا سکتے۔ انہیں ہٹا کر دوبارہ محفوظ کریں، اور متن دکھائی دے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "nó thêm từ vào một chương không có lời nói, nơi chúng không thể được giữ lại. Hãy gỡ chúng rồi lưu lại để văn bản hiện ra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "它在没有语音的章节中添加了文字，这些文字无法保留。请移除后再次存储，文本便会显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "它在沒有語音的章節中加入了文字，這些文字無法保留。請移除後再次儲存，文字便會顯示。"
          }
        }
      }
    },
    "bookTextEdit.kept.content" : {
      "comment" : "Sentence saying that no backup of the user's edited text could be made. content.md is the file name of the book's text and stays as written.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
