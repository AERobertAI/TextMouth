            "value" : "पुस्तक की फ़ाइलें अभी इस Mac पर नहीं हैं। हो सकता है कि उन्हें सिंक करने का काम %@ में अब भी चल रहा हो।"
          }
        },
        "id" : {
          "stringUnit" : {
