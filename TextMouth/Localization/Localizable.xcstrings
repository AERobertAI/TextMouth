          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "録音中、%1$@、レベル%2$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "녹음 중, %1$@, 레벨 %2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gravando, %1$@, nível %2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Запись, %1$@, уровень %2$@"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Запис, %1$@, рівень %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "正在录音，%1$@，电平 %2$@"
          }
        }
      }
    },
    "Recording. Stop or discard it with Clear Selection, then close." : {
      "comment" : "Said when the audio editor's window can't close because a punch-in records. \"Clear Selection\" is the name of a command.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جارٍ التسجيل. أوقفه أو تجاهله باستخدام “إلغاء التحديد”، ثم أغلق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aufnahme läuft. Stoppe oder verwirf sie mit „Auswahl aufheben“ und schließe dann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Grabando. Detén la grabación o descártala con Quitar selección y luego cierra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Enregistrement en cours. Arrêtez-le ou abandonnez-le avec Désélectionner, puis fermez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "रिकॉर्डिंग हो रही है। “रोकें” से इसे रोकें या “चयन हटाएँ” से त्याग दें, फिर बंद करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sedang merekam. Hentikan atau buang dengan Kosongkan Pilihan, lalu tutup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Registrazione in corso. Interrompila o scartala con Deseleziona, poi chiudi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "録音中です。「選択解除」で停止または破棄してから、閉じてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "녹음 중입니다. 중지하거나 선택 해제로 폐기한 다음 닫으십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gravando. Pare ou descarte com Desmarcar seleção e depois feche."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Идёт запись. Остановите её или отбросьте командой «Снять выделение», затем закройте окно."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Іде запис. Зупиніть його або відхиліть командою «Зняти виділення», потім закрийте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "正在录音。请先用“取消选择”停止或放弃录音，然后再关闭。"
          }
        }
      }
    },
    "Recording. Stop the recording first." : {
      "comment" : "Said when an audio editor command other than the punch-in's own is chosen while a punch-in records.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جارٍ التسجيل. أوقف التسجيل أولًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aufnahme läuft. Stoppe zuerst die Aufnahme."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Grabando. Detén primero la grabación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Enregistrement en cours. Arrêtez d’abord l’enregistrement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "रिकॉर्डिंग हो रही है। पहले रिकॉर्डिंग रोकें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sedang merekam. Hentikan perekaman terlebih dahulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Registrazione in corso. Interrompi prima la registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "録音中です。先に録音を停止してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "녹음 중입니다. 먼저 녹음을 중지하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
