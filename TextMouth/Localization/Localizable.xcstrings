            "value" : "TextMouth は、%@で変更したテキストをそのまま残しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 %@에서 변경한 텍스트를 그대로 두었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth manteve o texto que você alterou em %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth оставил изменённый вами текст книги «%@»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth залишив без змін текст, який ви змінили в «%@»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 保留了你在 %@ 中所做的文本更改。"
          }
        }
      }
    },
    "TextMouth left it there and is still using %@." : {
      "comment" : "Second sentence of why a move of the data directory did not finish, when one item appeared: TextMouth left the item and kept using the current data directory. %@ is the current data directory's path.\nSecond sentence of why a move of the data directory did not finish: TextMouth left what was put there and kept using the current data directory. %@ is the current data directory's path.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تركه TextMouth هناك ولا يزال يستخدم %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth সেটি সেখানেই রেখেছে এবং এখনো %@ ব্যবহার করছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
