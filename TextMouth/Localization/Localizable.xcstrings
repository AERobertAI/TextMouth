    "removalMode.failureHeading.bookDeleted" : {
      "comment" : "Heading over the one book that could not be deleted permanently. A line about it follows.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّر حذف هذا الكتاب وهو باقٍ في المكتبة:"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই বইটি মুছে ফেলা যায়নি এবং লাইব্রেরিতে রয়ে গেছে:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieses Buch konnte nicht gelöscht werden und bleibt in der Bibliothek:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This book could not be deleted and remains in the library:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este libro no se pudo eliminar y permanece en la biblioteca:"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "این کتاب حذف نشد و در کتابخانه می‌ماند:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce livre n’a pas pu être supprimé et reste dans la bibliothèque :"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא ניתן היה למחוק את הספר הזה והוא נשאר בספרייה:"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "यह पुस्तक मिटाई नहीं जा सकी और लाइब्रेरी में बनी है:"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Buku ini tidak dapat dihapus dan tetap ada di pustaka:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile eliminare questo libro, che resta nella libreria:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このブックは削除できず、ライブラリに残っています："
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 책을 삭제할 수 없어 보관함에 남아 있습니다:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dit boek kon niet definitief worden verwijderd en blijft in de bibliotheek:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tej książki nie udało się usunąć; pozostaje w bibliotece:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este livro não pôde ser excluído e permanece na biblioteca:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Эту книгу не удалось удалить, и она осталась в библиотеке:"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Den här boken kunde inte raderas och finns kvar i biblioteket:"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ลบหนังสือเล่มนี้ไม่ได้ และยังอยู่ในไลบรารี:"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
