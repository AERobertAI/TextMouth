          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kiest wat een boek dat uit de lijst is geopend, doet als het eindigt."
          }
        },
        "pl" : {
          "stringUnit" : {
