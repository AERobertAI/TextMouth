    "failure.changedTable.brailleLiblouisSince" : {
      "comment" : "Why a book is not read with its braille table again: the table changed. %1$@ is the table's name as macOS gives it, %2$@ the liblouis version the book was read with, and %3$@ the version now.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تغيّر جدول برايل “%1$@” الخاص بهذا الـ Mac من liblouis %2$@ إلى %3$@ منذ قراءة الكتاب، لذا يحتفظ TextMouth بنص الكتاب كما كان."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই Mac-এর ব্রেইল টেবিল “%1$@” বইটি পড়ার পর liblouis %2$@ থেকে %3$@-এ বদলেছে, তাই TextMouth বইয়ের টেক্সট যেমন ছিল তেমনই রাখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Brailletabelle „%1$@“ dieses Mac hat sich seit dem Lesen des Buchs von liblouis %2$@ auf %3$@ geändert, daher behält TextMouth den Text des Buchs, wie er war."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac's braille table “%@” changed from liblouis %@ to %@ since the book was read, so TextMouth keeps the book's text as it was."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La tabla de braille “%1$@” de esta Mac cambió de liblouis %2$@ a %3$@ desde que se leyó el libro, así que TextMouth conserva el texto del libro tal como estaba."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جدول بریل «%1$@» این Mac از زمان خوانده شدن کتاب از liblouis %2$@ به %3$@ تغییر کرده است، بنابراین TextMouth متن کتاب را همان‌طور که بود نگه می‌دارد."
          }
        },
        "fr" : {
