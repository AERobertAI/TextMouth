    "Already at the end." : {
      "comment" : "Said when a step forward in the audio editor can go no further."
    },
    "Already at the start." : {
      "comment" : "Said when a step back in the audio editor can go no further."
    },
    "Also write the markers as Audacity labels" : {
      "comment" : "Label of the checkbox in the audio editor's Export Audio sheet that writes the markers as a label file too. Audacity is the name of an audio editing program."
    },
    "An episode in its feed can't be edited." : {
      "comment" : "Said when Edit Audio… reaches a podcast episode that lives in its feed's folder, which can't be edited."
    },
    "An option of the %@ filter has a value but no name." : {
      "comment" : "Problem found in a typed filter chain: an equals sign with nothing before it, in one filter's options. %@ is the filter's name, such as volume."
    },
    "An unknown error occurred." : {
      "comment" : "Message of an alert about a problem, when nothing more is known about it."
    },
    "Apple Lossless (M4A)" : {
      "comment" : "Name of an audio file format in the audio editor's Export format list and in messages about a save: M4A files holding Apple Lossless audio. Apple Lossless is Apple's name for the codec."
    },
    "Applied %@ to %@." : {
      "comment" : "Said as a filter has been applied to a selection in the audio editor. %1$@ is the filter preset's name and %2$@ the selection's length in words.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Applied %1$@ to %2$@."
          }
        }
      }
    },
    "Applied %@ to all of the audio." : {
      "comment" : "Said as a filter has been applied to the whole audio in the audio editor. %@ is the filter preset's name."
    },
    "Applies the filter." : {
      "comment" : "Hint of the audio editor's Apply button while a press applies the filter."
    },
    "Apply" : {
      "comment" : "Button of the audio editor's Apply Filter sheet that applies the filter."
    },
    "Apply Filter" : {
      "comment" : "Name of an edit, as the Undo and Redo menu items say it after \"Undo\" or \"Redo\"; also the title of the audio editor's filter sheet."
    },
    "Apply Filter lists these in this order. Each is a chain of filters in ffmpeg's syntax, such as highpass=f=80,volume=3dB. TextMouth runs its own filters, plus every ffmpeg filter when ffmpeg is installed and turned on above." : {
      "comment" : "Explains the filter presets sheet. Apply Filter is the audio editor's command. \"highpass=f=80,volume=3dB\" is filter syntax and stays as it is. ffmpeg is the name of a program. \"turned on above\" refers to the Use ffmpeg for filters switch in Storage settings."
    },
    "Apply Filter plays a preview first, and applies when you choose Apply again." : {
      "comment" : "Hint of the Preview filters before applying switch in Storage settings. Apply Filter and Apply are the audio editor's command and button."
    },
    "Apply to" : {
      "comment" : "Label of the choice in the audio editor's Apply Filter sheet of what to filter: the selection or the whole file."
    },
    "Applying %@." : {
      "comment" : "Said as a filter begins to be applied in the audio editor. %@ is the filter preset's name."
    },
