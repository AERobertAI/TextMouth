    "libraryViewEditor.newViewHint" : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. Its hint.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ينشئ عرضًا خاصًا بك من الشروط التي تختارها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আপনার বেছে নেওয়া শর্ত থেকে নিজের একটি ভিউ তৈরি করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Erstellt aus den gewählten Bedingungen eine eigene Ansicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makes a view of your own from the conditions you choose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Crea una vista propia con las condiciones que elijas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "از شرط‌هایی که انتخاب می‌کنید نمای خودتان را می‌سازد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Crée votre propre vue à partir des conditions que vous choisissez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "יוצר תצוגה משלך מהתנאים שתבחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आपकी चुनी हुई शर्तों से आपका अपना दृश्य बनाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuat tampilan Anda sendiri dari kondisi yang Anda pilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Crea una vista tua dalle condizioni che scegli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選択した条件から、自分用のビューを作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "선택한 조건으로 나만의 보기를 만듭니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Maakt een eigen weergave met de voorwaarden die je kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tworzy własny widok z wybranych warunków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cria uma visualização sua com as condições que você escolher."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Создаёт ваше представление из выбранных условий."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Skapar en egen vy av de villkor du väljer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "สร้างมุมมองของคุณเองจากเงื่อนไขที่เลือก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Seçtiğiniz koşullardan kendi görünümünüzü oluşturur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Створює власний вигляд за вибраними вами умовами."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آپ کی منتخب کردہ شرائط سے اپنا منظر بناتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tạo chế độ xem của riêng bạn từ các điều kiện bạn chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "根据你选取的条件创建你自己的视图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "依你選擇的條件製作你自己的顯示方式。"
          }
        }
      }
    },
    "libraryViewEditor.noConditions" : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. What the editor says while the view has no condition.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بلا شروط: يسرد العرض كل عنصر من الأنواع المختارة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "কোনো শর্ত নেই: ভিউটি বেছে নেওয়া ধরনের প্রতিটি আইটেম তালিকাভুক্ত করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Keine Bedingungen: Die Ansicht listet jeden Eintrag der gewählten Arten auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No conditions: the view lists every item of the kinds chosen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sin condiciones: la vista muestra todos los elementos de los tipos elegidos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بدون شرط: نما همه‌ی موارد از انواع انتخاب‌شده را فهرست می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucune condition : la vue liste tous les éléments des types choisis."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אין תנאים: התצוגה מציגה כל פריט מהסוגים שנבחרו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कोई शर्त नहीं: दृश्य चुने गए प्रकारों के हर आइटम को सूचीबद्ध करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tanpa kondisi: tampilan mencantumkan setiap item dari jenis yang dipilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nessuna condizione: la vista elenca ogni elemento dei tipi scelti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "条件なし：選択した種類のすべての項目がビューに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "조건 없음: 보기는 선택한 종류의 모든 항목을 나열합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Geen voorwaarden: de weergave toont elk onderdeel van de gekozen soorten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Brak warunków: widok wyświetla każdą pozycję wybranych rodzajów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sem condições: a visualização lista todos os itens dos tipos escolhidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Условий нет: представление показывает все элементы выбранных типов."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Inga villkor: vyn listar varje objekt av de valda slagen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไม่มีเงื่อนไข: มุมมองจะแสดงทุกรายการของประเภทที่เลือก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Koşul yok: görünüm, seçilen türlerdeki her öğeyi listeler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Умов немає: вигляд показує всі елементи вибраних типів."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کوئی شرط نہیں: منظر منتخب کی گئی اقسام کے ہر آئٹم کی فہرست دیتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không có điều kiện: chế độ xem liệt kê mọi mục thuộc các loại đã chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "没有条件：视图会列出所选类型的每个项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "沒有條件：此顯示方式會列出所選種類的每個項目。"
          }
        }
      }
    },
    "libraryViewEditor.nothingListed" : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. Save's problem with no kind listed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
