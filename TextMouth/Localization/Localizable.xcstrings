    "Could not save metadata: “%@” is no longer in the library." : {
      "comment" : "First sentence of the message when the book being edited left the library. %@ is the book's title."
    },
    "Could not save: the book's title is empty." : {
      "comment" : "First sentence of the message when Save is pressed after the book's title was emptied."
    },
    "Couldn't open the manifest of %@: %@" : {
      "comment" : "Message when the app that edits a manifest.json could not be opened. %1$@ is the book's title; %2$@ is the reason from the system.",
