            "value" : "Biblioteka w %@ jest niedostępna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A biblioteca em %@ não está disponível."
          }
        },
        "ru" : {
