          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เก็บไว้ในพวงกุญแจของอุปกรณ์นี้ TextMouth จึงไม่ถามอีกสำหรับหนังสือเล่มนี้"
