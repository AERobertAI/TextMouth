        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth इस फ़ीड के डाउनलोड की अपनी सूची नहीं सहेज सका, इसलिए डाउनलोड रखा गया। लाइब्रेरी सहेजे जा सकने पर फिर से प्रयास करें।"
