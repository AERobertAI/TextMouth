          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は%1$@のライブラリ（%2$@）の使用をやめ、代わりに%3$@のライブラリを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
