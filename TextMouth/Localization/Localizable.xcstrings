    "readerPage.showInReaderHint" : {
      "comment" : "Hint and caption of the Playback setting that shows the page on the reader screen. \"Page 12 of 300\" is an example of how the page is shown.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعرض الصفحة التي تُقرأ، مثل الصفحة 12 من 300، بجانب النسبة المئوية، للكتب التي تضم أكثر من صفحة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "একাধিক পৃষ্ঠার বইয়ের জন্য শতাংশের পাশে যে পৃষ্ঠা পড়া হচ্ছে তা দেখায়, যেমন 300 পৃষ্ঠার মধ্যে পৃষ্ঠা 12।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zeigt die gelesene Seite, etwa „Seite 12 von 300“, neben dem Prozentwert an, bei Büchern mit mehr als einer Seite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the page being read, such as Page 12 of 300, beside the percent, for books of more than one page."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Muestra la página que se lee, como Página 12 de 300, junto al porcentaje, en libros de más de una página."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صفحه‌ای را که خوانده می‌شود، مانند «صفحه 12 از 300»، کنار درصد نشان می‌دهد، برای کتاب‌هایی با بیش از یک صفحه."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Affiche la page lue, par exemple « Page 12 sur 300 », à côté du pourcentage, pour les livres de plus d’une page."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מציג את העמוד הנקרא, כגון עמוד 12 מתוך 300, לצד האחוז, בספרים שיש בהם יותר מעמוד אחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "एक से अधिक पृष्ठ वाली पुस्तकों के लिए, प्रतिशत के पास पढ़ा जा रहा पृष्ठ दिखाता है, जैसे 300 में से पृष्ठ 12।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menampilkan halaman yang sedang dibaca, seperti Halaman 12 dari 300, di samping persentase, untuk buku dengan lebih dari satu halaman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mostra la pagina in lettura, ad esempio Pagina 12 di 300, accanto alla percentuale, per i libri di più pagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ページが複数あるブックで、「300ページ中12ページ」などの読み上げ中のページを、パーセントの隣に表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "한 페이지가 넘는 책에서 읽고 있는 페이지(예: 300페이지 중 12페이지)를 퍼센트 옆에 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toont de pagina die wordt gelezen, zoals Pagina 12 van 300, naast het percentage, voor boeken met meer dan één pagina."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pokazuje czytaną stronę, na przykład Strona 12 z 300, obok wartości procentowej, w książkach składających się z więcej niż jednej strony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mostra a página que está sendo lida, como Página 12 de 300, ao lado da porcentagem, para livros com mais de uma página."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Показывает читаемую страницу, например «Страница 12 из 300», рядом с процентом для книг из нескольких страниц."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Visar sidan som läses, till exempel sidan 12 av 300, bredvid procenttalet, för böcker med mer än en sida."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "แสดงหน้าที่กำลังอ่าน เช่น หน้า 12 จาก 300 ไว้ข้างเปอร์เซ็นต์ สำหรับหนังสือที่มีหลายหน้า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Birden çok sayfası olan kitaplarda, Sayfa 12 / 300 gibi okunan sayfayı yüzdenin yanında gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Показує сторінку, яку читають, наприклад «Сторінка 12 з 300», поруч із відсотком для книг більш ніж з однією сторінкою."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اگر کتاب میں ایک سے زیادہ صفحات ہوں تو فیصد کے ساتھ پڑھا جانے والا صفحہ، جیسے 300 میں سے صفحہ 12، دکھاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hiển thị trang đang đọc, chẳng hạn Trang 12 trên 300, bên cạnh phần trăm, cho sách có nhiều hơn một trang."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在百分比旁显示正在阅读的页码（如第 12 页，共 300 页），适用于多页图书。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在百分比旁顯示正在閱讀的頁碼，例如「第 12 頁，共 300 頁」，適用於超過一頁的書籍。"
          }
        }
      }
    },
