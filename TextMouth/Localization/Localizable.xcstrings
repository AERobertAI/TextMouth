    "textEncoding.unknownChoice.version" : {
      "comment" : "First sentence of why a book set to an unknown text encoding cannot be read. %1$@ names the book, as in “Ledger”, and %2$@ is the encoding's stored identifier.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم ضبط قراءة %1$@ بترميز النص “%2$@”، وهذا الإصدار من TextMouth لا يستطيع قراءته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ “%2$@” হিসেবে পড়ার জন্য সেট করা আছে, কিন্তু TextMouth-এর এই সংস্করণ সেই টেক্সট এনকোডিং পড়তে পারে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ soll als „%2$@“ gelesen werden, eine Textcodierung, die diese Version von TextMouth nicht lesen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is set to be read as “%@”, a text encoding this version of TextMouth can't read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ está configurado para leerse como “%2$@”, una codificación de texto que esta versión de TextMouth no puede leer."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ طوری تنظیم شده که با «%2$@» خوانده شود، کدگذاری متنی که این نسخه از TextMouth نمی‌تواند بخواند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ est réglé pour être lu en « %@ », un encodage de texte que cette version de TextMouth ne peut pas lire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ מוגדר להיקרא כ-“%2$@”, קידוד טקסט שהגרסה הזו של TextMouth אינה יכולה לקרוא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ को “%2$@” के रूप में पढ़ने के लिए सेट किया गया है, जो TextMouth का यह वर्ज़न नहीं पढ़ सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ diatur untuk dibaca sebagai “%@”, pengodean teks yang tidak dapat dibaca oleh versi TextMouth ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ è impostato per essere letto come “%@”, una codifica del testo che questa versione di TextMouth non sa leggere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@は「%2$@」として読み込む設定ですが、このバージョンの TextMouth ではこの文字エンコーディングを読み込めません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@은(는) “%2$@” 텍스트 인코딩으로 읽도록 설정되어 있지만, 이 TextMouth 버전에서는 읽을 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ is ingesteld om te worden gelezen als “%@”, een tekstcodering die deze versie van TextMouth niet kan lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dla %1$@ ustawiono odczyt jako „%2$@”, czyli kodowanie tekstu, którego ta wersja TextMouth nie potrafi odczytać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A leitura de %1$@ está definida como “%2$@”, uma codificação de texto que esta versão do TextMouth não consegue ler."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Для книги %1$@ выбрано чтение в кодировке «%2$@», которую эта версия TextMouth не поддерживает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ är inställd på att läsas som ”%@”, en teckenkodning som den här versionen av TextMouth inte kan läsa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ถูกตั้งให้อ่านเป็น “%2$@” ซึ่งเป็นการเข้ารหัสข้อความที่ TextMouth เวอร์ชันนี้อ่านไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
