        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mỗi nguồn cấp có thể có lựa chọn %1$@ riêng và số ngày riêng trước khi xóa các bản tải về đã phát, trong %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "每个订阅源都可以在其“%2$@”中设置自己的“%1$@”选项，以及删除已播放下载内容前的天数。"
