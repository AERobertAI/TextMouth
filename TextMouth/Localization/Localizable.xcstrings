    "settings.showBookmarkHint" : {
      "comment" : "VoiceOver hint of the Show bookmark button checkbox in the Playback settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يضيف إشارة مرجعية عند الموضع الحالي أو يزيلها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বর্তমান অবস্থানে একটি বুকমার্ক যোগ করে বা সরায়।"
          }
        },
        "de" : {
          "stringUnit" : {
