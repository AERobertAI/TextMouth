    "storageLocation.booksNeedingNewerTextMouth.need" : {
      "comment" : "Storage settings note: several books of the library were added by a newer TextMouth, which this one keeps but can't show. %lld is how many books.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عدد الكتب في هذه المكتبة التي تحتاج إلى إصدار أحدث من TextMouth: %lld. يُحتفظ بها كما هي، لكنها لا تُعرض."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই লাইব্রেরির %lldটি বইয়ের জন্য TextMouth-এর নতুন সংস্করণ দরকার। সেগুলো যেমন আছে তেমনই রাখা হয়েছে, কিন্তু দেখানো হচ্ছে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%lld Bücher in dieser Bibliothek benötigen eine neuere Version von TextMouth. Sie bleiben unverändert erhalten, werden aber nicht angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld books in this library need a newer version of TextMouth. They are kept as they are, but not shown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%lld libros de esta biblioteca necesitan una versión más reciente de TextMouth. Se conservan tal como están, pero no se muestran."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%lld کتاب این کتابخانه به نسخه جدیدتری از TextMouth نیاز دارند. آن‌ها همان‌طور که هستند نگه داشته می‌شوند، اما نمایش داده نمی‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%lld livres de cette bibliothèque nécessitent une version plus récente de TextMouth. Ils sont conservés tels quels, mais ne sont pas affichés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%lld ספרים בספרייה הזו דורשים גרסה חדשה יותר של TextMouth. הם נשמרים כפי שהם, אך לא מוצגים."
          }
        },
