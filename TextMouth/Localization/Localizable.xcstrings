        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "क्रमबद्ध करें मेनू में %@ चुनें, और फिर से प्रयास करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pilih %@ di menu Urutkan, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scegli %@ nel menu Ordina, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「並べ替え」メニューで%@を選択してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "정렬 메뉴에서 %@을(를) 선택한 다음 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
