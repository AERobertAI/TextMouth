    "Sleep timer: %lld seconds remaining" : {
      "comment" : "VoiceOver announcement as the sleep timer's countdown passes a milestone under a minute. %lld is the seconds left (30 or 10).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Temporizador de apagado: quedan %lld segundos"
          }
        }
      }
    },
    "Smart mode" : {
      "comment" : "Title of the checkbox in the Playback settings that makes playback rewind only after a long enough pause."
    },
    "Smart rewind mode" : {
      "comment" : "VoiceOver label of the Smart mode checkbox in the Playback settings."
    },
    "Some Changes Could Not Be Saved" : {
      "comment" : "Title of the alert shown when TextMouth is asked to quit while some changes could not be written to disk."
    },
    "Some Files Not Imported" : {
      "comment" : "Title of the library's alert as a ZIP batch that added at least one book ends having left some files out: a file failed or the batch was cancelled. Title case."
    },
    "Some changes are not saved." : {
      "comment" : "Sentence that replaces a claim of success when some changes could not be saved. The failure notices follow."
    },
    "Some changes to this book haven't been uploaded to %@ yet, so its download can't be removed." : {
      "comment" : "First sentence of why Remove Download was refused: some changes are not uploaded. %@ is the cloud service's name, or \"the cloud service\" when it is unknown."
    },
    "Some details appear once the book is downloaded." : {
      "comment" : "Note in Book Information when the book's file is only in the cloud, so the sheet shows the details the library keeps and the others wait for a download."
    },
    "Some files of “%@” are only in the cloud, and replacing it now would leave them behind. Download the book, then choose %@ again." : {
      "comment" : "Why Replace Existing waits: some files of the library's copy are only in the cloud. %1$@ is the book's title. %2$@ is the name of the Replace Existing button, which the sentence asks the user to choose again.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Some files of “%1$@” are only in the cloud, and replacing it now would leave them behind. Download the book, then choose %2$@ again."
          }
        }
      }
    },
    "Some of the library's files are in %@ and aren't on this Mac yet." : {
      "comment" : "Why the library can't be used yet: some of its files are only in the cloud. %@ is the cloud service's name, or \"the cloud\" when it is unknown."
    },
    "Sort" : {
      "comment" : "Title of the Library window's toolbar menu that chooses how the books are sorted."
    },
    "Sort Ascending" : {
      "comment" : "Title of the Sort menu's command that reverses the sort, while the books are sorted descending. It switches them to ascending."
    },
    "Sort By" : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. The sort field pop-up's label."
    },
    "Sort Descending" : {
      "comment" : "Title of the Sort menu's command that reverses the sort, while the books are sorted ascending. It switches them to descending."
    },
    "Sort books by %@" : {
      "comment" : "Spoken label of the Sort button. %@ is the current sort, such as \"Title, ascending\" or \"Manual Order\".\nVoiceOver label of the Library's Sort button while the Reading List shows. %@ is the name of the Reading List's order, Reading List Order.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ordenar libros por %@"
          }
        }
      }
    },
    "Sort feeds by Title" : {
      "comment" : "Text of the Library window's View pop-up and Go to View. The Sort button's spoken label in a view listing only feeds."
    },
    "Sorted by %@" : {
      "comment" : "VoiceOver announcement after the Reading List's order was chosen in its Sort menu. %@ is the order's name, Reading List Order.\nVoiceOver announcement after the sort changes. %@ is the new sort, such as \"Author, descending\" or \"Manual Order\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ordenado por %@"
          }
        }
      }
    },
    "Sounds" : {
      "comment" : "Name of the Settings tab for the sounds played for playback events."
    },
    "Space" : {
      "comment" : "Name of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Space\"."
    },
    "Speak Download Progress" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Information group and read by VoiceOver. Speaks how far the feed downloads under way have got. Also the title of the menu command of the same name."
    },
    "Speak Full Info" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Information group and read by VoiceOver. Speaks the full summary of the selected book, folder or feed. Also the title of the menu command of the same name."
    },
    "Speak Import Progress" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Information group and read by VoiceOver. Speaks how far the imports under way have got. Also the title of the menu command of the same name."
    },
    "Speak Info" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Information group and read by VoiceOver. Speaks a short summary of the selected book, folder or feed. Also the title of the menu command of the same name."
    },
    "Speak Selection" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Speaks what is selected, with its length."
    },
    "Speaking chapter %@ of %@…" : {
      "comment" : "The progress of a spoken audio export while it speaks the chapters. %1$@ is the number of the chapter being spoken and %2$@ the number of chapters, both written without digit grouping.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Speaking chapter %1$@ of %2$@…"
          }
        }
      }
    },
    "Speech from the Mac's voices is for personal, non-commercial use, under Apple's licence." : {
      "comment" : "The line in the Export dialog's spoken audio options about the licence the Mac's voices come with."
    },
    "Speed" : {
      "comment" : "Heading of the voice sheet's speed group, and what VoiceOver calls its speed slider.\nThe label of the slider in the Export dialog's spoken audio options that sets how fast the voice speaks."
    },
    "Speed: %@" : {
