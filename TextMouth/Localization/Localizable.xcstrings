    "sync.status.shortOfRoom" : {
      "comment" : "A line of the sync status: this device has no room for books it would download. %1$@ is a count of books, such as \"3 books\"; %2$@ is \"this Mac\" or \"this iPhone\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا توجد مساحة على %1$@ لتنزيل %2$@. تبقى الكتب الموجودة هنا بالفعل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@-এ %2$@ ডাউনলোড করার মতো জায়গা নেই। যে বইগুলো আগে থেকেই এখানে আছে, সেগুলো থাকছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es ist nicht genug Platz (%1$@), um %2$@ herunterzuladen. Die bereits vorhandenen Bücher bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There isn't room on %@ to download %@. The books already here stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay espacio en %1$@ para descargar %2$@. Los libros que ya están aquí se quedan."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "در %1$@ جایی برای بارگیری %2$@ نیست. کتاب‌هایی که از قبل اینجا هستند می‌مانند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il n’y a pas assez de place sur %1$@ pour télécharger %2$@. Les livres déjà présents restent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אין מקום ב-%1$@ כדי להוריד %2$@. הספרים שכבר נמצאים כאן נשארים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ पर %2$@ डाउनलोड करने की जगह नहीं है। जो पुस्तकें पहले से यहाँ हैं, वे बनी रहती हैं।"
