            "value" : "وضع %@ جانبًا نسخة متعارضة من %@: “%@”، في %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@-এর একটি সংঘাতপূর্ণ কপি আলাদা করে রেখেছে: “%3$@”, %4$@-এ।"
