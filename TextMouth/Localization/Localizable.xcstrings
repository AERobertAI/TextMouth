            "value" : "已停止。回到 %@。"
          }
        }
      }
    },
    "Stopping the library move before quitting." : {
      "comment" : "Announcement when TextMouth is asked to quit during a move of the library.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جارٍ إيقاف نقل المكتبة قبل الإنهاء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "প্রস্থানের আগে লাইব্রেরি স্থানান্তর থামানো হচ্ছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Verschieben der Bibliothek wird vor dem Beenden gestoppt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deteniendo el traslado de la biblioteca antes de salir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrêt du déplacement de la bibliothèque avant de quitter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "बाहर निकलने से पहले लाइब्रेरी का स्थानांतरण रोका जा रहा है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menghentikan pemindahan pustaka sebelum keluar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interruzione dello spostamento della libreria prima di uscire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "終了前にライブラリの移動を停止しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "종료하기 전에 보관함 이동을 중지하는 중입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Parando a movimentação da biblioteca antes de encerrar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Перемещение библиотеки останавливается перед завершением."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Припинення переміщення бібліотеки перед виходом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "退出前正在停止资料库移动。"
          }
        }
      }
    },
    "Stops checking; the feed and its downloads stay" : {
      "comment" : "VoiceOver hint of the Unsubscribe button in Feed Info when it acts at once.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beendet die Prüfung; der Feed und seine Downloads bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deja de revisar; el canal y sus descargas se quedan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cesse de vérifier ; le flux et ses téléchargements restent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "जाँचना बंद कर देता है; फ़ीड और उसके डाउनलोड बने रहते हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Berhenti memeriksa; feed dan unduhannya tetap ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Smette di controllare; il feed e i suoi download restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "チェックを停止します。フィードとそのダウンロードは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "확인을 중단합니다. 피드와 다운로드는 그대로 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deixa de verificar; o feed e os downloads dele permanecem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Прекращает проверку; лента и её загрузки остаются."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Припиняє перевірку; стрічка та її завантаження залишаються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止检查；订阅源及其下载内容会保留。"
          }
        }
      }
    },
    "Stops comparing. Nothing in either copy has been changed." : {
      "comment" : "VoiceOver hint of the Stop button of the Compare Libraries sheet.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يوقف المقارنة. لم يتغير أي شيء في أي من النسختين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppt den Vergleich. In keiner der Kopien wurde etwas geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detiene la comparación. No se ha cambiado nada en ninguna de las copias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrête la comparaison. Aucune des copies n’a été modifiée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "तुलना रोकता है। किसी भी कॉपी में कुछ नहीं बदला गया है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menghentikan perbandingan. Tidak ada yang diubah di salinan mana pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe il confronto. Nessuna delle due copie è stata modificata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "比較を停止します。どちらのコピーも変更されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "비교를 중단합니다. 어느 사본도 변경되지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para a comparação. Nada em nenhuma das cópias foi alterado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Останавливает сравнение. В обеих копиях ничего не изменено."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Зупиняє порівняння. Жодна з копій не змінилася."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止比较。两个副本中的内容都未更改。"
          }
        }
      }
    },
    "Stops every feed download, including those waiting, and deletes what they had downloaded." : {
      "comment" : "What VoiceOver says the feed downloads section's Cancel button does: it stops every feed download and deletes what they had downloaded.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppt alle Feed-Downloads, auch die wartenden, und löscht, was bereits heruntergeladen wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detiene todas las descargas de canales, incluidas las que esperan, y elimina lo que habían descargado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrête tous les téléchargements de flux, y compris ceux en attente, et supprime ce qu’ils avaient téléchargé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "प्रतीक्षा में रखे डाउनलोड समेत हर फ़ीड डाउनलोड रोक देता है, और जो डाउनलोड हो चुका था उसे मिटा देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menghentikan setiap unduhan feed, termasuk yang menunggu, dan menghapus apa yang sudah diunduh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe ogni download di feed, compresi quelli in attesa, ed elimina ciò che avevano scaricato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "待機中のものを含むすべてのフィードのダウンロードを停止し、ダウンロード済みの内容を削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "대기 중인 다운로드를 포함해 모든 피드 다운로드를 중지하고, 다운로드된 내용을 삭제합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe todos os downloads de feeds, inclusive os que aguardam, e exclui o que eles já haviam baixado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Останавливает все загрузки лент, в том числе ожидающие, и удаляет то, что они успели загрузить."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Зупиняє всі завантаження зі стрічок, зокрема ті, що очікують, і видаляє вже завантажене."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止所有订阅源下载（包括正在等待的），并删除它们已下载的内容。"
          }
        }
      }
    },
    "Stops moving the library. The library stays where it is, and nothing is changed." : {
      "comment" : "VoiceOver hint of the button that cancels the move of the library.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يوقف نقل المكتبة. تبقى المكتبة حيث هي، ولا يتغير أي شيء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "লাইব্রেরি স্থানান্তর থামায়। লাইব্রেরি যেখানে আছে সেখানেই থাকে, কিছুই বদলায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppt das Verschieben der Bibliothek. Die Bibliothek bleibt, wo sie ist, und nichts wird geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detiene el traslado de la biblioteca. La biblioteca queda donde está y no se cambia nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrête le déplacement de la bibliothèque. La bibliothèque reste où elle est, et rien n’est modifié."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लाइब्रेरी को ले जाना रोकता है। लाइब्रेरी जहाँ है वहीं रहती है, और कुछ नहीं बदलता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menghentikan pemindahan pustaka. Pustaka tetap di tempatnya, dan tidak ada yang diubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe lo spostamento della libreria. La libreria resta dov’è e nulla viene modificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ライブラリの移動を停止します。ライブラリはそのままで、何も変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관함 이동을 중지합니다. 보관함은 그대로 있으며 아무것도 변경되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para de mover a biblioteca. A biblioteca fica onde está, e nada é alterado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Останавливает перемещение библиотеки. Библиотека остаётся на месте, ничего не меняется."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Зупиняє переміщення бібліотеки. Бібліотека залишається на місці, і нічого не змінюється."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止移动资料库。资料库保持原位，不做任何更改。"
          }
        }
      }
    },
    "Stops playback resuming when headphones disconnect" : {
      "comment" : "VoiceOver hint of the Enable Bluetooth monitoring switch in the Miscellaneous settings.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يمنع استئناف التشغيل عند قطع اتصال سماعات الرأس"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "হেডফোন বিচ্ছিন্ন হলে প্লেব্যাক আবার শুরু হওয়া আটকায়"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Verhindert, dass die Wiedergabe fortgesetzt wird, wenn Kopfhörer getrennt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Evita que la reproducción se reanude cuando se desconectan los audífonos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Empêche la lecture de reprendre quand les écouteurs sont déconnectés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "हेडफ़ोन डिस्कनेक्ट होने पर प्लेबैक का फिर शुरू होना रोकता है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menghentikan pemutaran yang berlanjut saat headphone terputus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impedisce la ripresa della riproduzione quando le cuffie si disconnettono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ヘッドフォンの接続が切れたときに再生が再開しないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "헤드폰 연결이 해제될 때 재생이 다시 시작되지 않게 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impede que a reprodução seja retomada quando os fones se desconectam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не даёт воспроизведению возобновляться при отключении наушников."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не дає відтворенню продовжуватися, коли навушники відключаються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "耳机断开时阻止播放自动恢复。"
          }
        }
      }
    },
    "Stops playing, and goes back to where playing began." : {
      "comment" : "Hint of the audio editor's Stop button.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يوقف التشغيل، ويعود إلى حيث بدأ التشغيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppt die Wiedergabe und geht zurück dorthin, wo sie begann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detiene la reproducción y vuelve a donde empezó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrête la lecture et revient où elle avait commencé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चलाना रोकता है, और जहाँ से चलना शुरू हुआ था वहाँ वापस जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menghentikan pemutaran, dan kembali ke tempat pemutaran dimulai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe la riproduzione e torna al punto da cui è iniziata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "再生を停止し、再生を始めた位置に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
