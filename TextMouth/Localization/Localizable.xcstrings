    },
    "TextMouth moved %lld new copies of duplicate books to the Trash, because the questions whether to keep them as duplicates were never answered before TextMouth closed. To get them back, open the Trash and choose Put Back." : {
      "comment" : "Alert after the launch moved the new copies of four or more duplicate books to the Trash, because their questions were never answered. %lld is the number of books. \"Put Back\" is Finder's command in the Trash.",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "TextMouth hat %lld neue Kopie doppelter Bücher in den Papierkorb verschoben, weil die Fragen, ob sie als Duplikate behalten werden sollen, nicht beantwortet wurden, bevor TextMouth sich schloss. Öffne den Papierkorb und wähle „Zurücklegen“, um sie zurückzuholen."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "TextMouth hat %lld neue Kopien doppelter Bücher in den Papierkorb verschoben, weil die Fragen, ob sie als Duplikate behalten werden sollen, nicht beantwortet wurden, bevor TextMouth sich schloss. Öffne den Papierkorb und wähle „Zurücklegen“, um sie zurückzuholen."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "TextMouth moved %lld new copy of duplicate books to the Trash, because the questions whether to keep them as duplicates were never answered before TextMouth closed. To get them back, open the Trash and choose Put Back."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "TextMouth moved %lld new copies of duplicate books to the Trash, because the questions whether to keep them as duplicates were never answered before TextMouth closed. To get them back, open the Trash and choose Put Back."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "TextMouth movió %lld de copias nuevas de libros duplicados a la Papelera, porque no se respondieron las preguntas sobre si conservarlos como duplicados antes de que TextMouth se cerrara. Para recuperarlos, abre la Papelera y elige Volver a colocar."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "TextMouth movió %lld copia nueva de libros duplicados a la Papelera, porque no se respondieron las preguntas sobre si conservarlos como duplicados antes de que TextMouth se cerrara. Para recuperarlos, abre la Papelera y elige Volver a colocar."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "TextMouth movió %lld copias nuevas de libros duplicados a la Papelera, porque no se respondieron las preguntas sobre si conservarlos como duplicados antes de que TextMouth se cerrara. Para recuperarlos, abre la Papelera y elige Volver a colocar."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "TextMouth a placé %lld de nouvelles copies de livres en double dans la corbeille, car les questions pour savoir s’il fallait les conserver comme doublons sont restées sans réponse avant la fermeture de TextMouth. Pour les récupérer, ouvrez la corbeille et choisissez Remettre."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "TextMouth a placé %lld nouvelle copie d’un livre en double dans la corbeille, car la question de la conserver comme doublon est restée sans réponse avant la fermeture de TextMouth. Pour la récupérer, ouvrez la corbeille et choisissez Remettre."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "TextMouth a placé %lld nouvelles copies de livres en double dans la corbeille, car les questions pour savoir s’il fallait les conserver comme doublons sont restées sans réponse avant la fermeture de TextMouth. Pour les récupérer, ouvrez la corbeille et choisissez Remettre."
                }
              }
            }
          }
        },
        "it" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "TextMouth ha spostato nel Cestino %lld di nuove copie di libri duplicati, perché le domande se conservarli come duplicati non hanno avuto risposta prima della chiusura di TextMouth. Per recuperarli, apri il Cestino e scegli Rimetti a posto."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "TextMouth ha spostato nel Cestino %lld nuova copia di libri duplicati, perché le domande se conservarli come duplicati non hanno avuto risposta prima della chiusura di TextMouth. Per recuperarli, apri il Cestino e scegli Rimetti a posto."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "TextMouth ha spostato nel Cestino %lld nuove copie di libri duplicati, perché le domande se conservarli come duplicati non hanno avuto risposta prima della chiusura di TextMouth. Per recuperarli, apri il Cestino e scegli Rimetti a posto."
                }
              }
            }
          }
        },
        "pt-BR" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "O TextMouth moveu %lld de novas cópias de livros duplicados para a Lixeira, porque as perguntas sobre mantê-las como duplicatas não foram respondidas antes de o TextMouth fechar. Para recuperá-las, abra a Lixeira e escolha Recolocar."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "O TextMouth moveu %lld nova cópia de um livro duplicado para a Lixeira, porque a pergunta sobre mantê-la como duplicata não foi respondida antes de o TextMouth fechar. Para recuperá-la, abra a Lixeira e escolha Recolocar."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "O TextMouth moveu %lld novas cópias de livros duplicados para a Lixeira, porque as perguntas sobre mantê-las como duplicatas não foram respondidas antes de o TextMouth fechar. Para recuperá-las, abra a Lixeira e escolha Recolocar."
                }
              }
            }
          }
        }
      }
    },
    "TextMouth moved the new copies of %@ to the Trash, because the questions whether to keep them as duplicates were never answered before TextMouth closed. To get them back, open the Trash and choose Put Back." : {
      "comment" : "Alert after the launch moved the new copies of two or three duplicate books to the Trash, because their questions were never answered. %@ is their titles in curly quotes, listed as a sentence lists them. \"Put Back\" is Finder's command in the Trash.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth hat die neuen Kopien von %@ in den Papierkorb verschoben, weil die Fragen, ob sie als Duplikate behalten werden sollen, nicht beantwortet wurden, bevor TextMouth sich schloss. Öffne den Papierkorb und wähle „Zurücklegen“, um sie zurückzuholen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth movió a la Papelera las copias nuevas de %@, porque no se respondieron las preguntas sobre si conservarlos como duplicados antes de que TextMouth se cerrara. Para recuperarlos, abre la Papelera y elige Volver a colocar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth a placé les nouvelles copies de %@ dans la corbeille, car les questions pour savoir s’il fallait les conserver comme doublons sont restées sans réponse avant la fermeture de TextMouth. Pour les récupérer, ouvrez la corbeille et choisissez Remettre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ha spostato nel Cestino le nuove copie di %@, perché le domande se conservarli come duplicati non hanno avuto risposta prima della chiusura di TextMouth. Per recuperarli, apri il Cestino e scegli Rimetti a posto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth moveu para a Lixeira as novas cópias de %@, porque as perguntas sobre mantê-las como duplicatas não foram respondidas antes de o TextMouth fechar. Para recuperá-las, abra a Lixeira e escolha Recolocar."
          }
        }
      }
    },
    "TextMouth moved the new copy of “%@” to the Trash, because the question whether to keep it as a duplicate was never answered before TextMouth closed. To get it back, open the Trash and choose Put Back." : {
      "comment" : "Alert after the launch moved the new copy of one duplicate book to the Trash, because its question was never answered. %@ is the book's title. \"Put Back\" is Finder's command in the Trash.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth hat die neue Kopie von „%@“ in den Papierkorb verschoben, weil die Frage, ob sie als Duplikat behalten werden soll, nicht beantwortet wurde, bevor TextMouth sich schloss. Öffne den Papierkorb und wähle „Zurücklegen“, um sie zurückzuholen."
          }
        },
        "es" : {
          "stringUnit" : {
