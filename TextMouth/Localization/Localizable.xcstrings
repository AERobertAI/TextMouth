    "speechExportsUnderWay.quitWork.export" : {
      "comment" : "One item of the list in the message of a quit that waits for work to finish (\"TextMouth is finishing up before it quits: ...\"): one spoken audio export is being stopped.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "إيقاف عملية تصدير صوتي منطوق مع الاحتفاظ بالفصول التي أنهتها"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "একটি স্পিচ রপ্তানি থামানো হচ্ছে, তার শেষ করা অধ্যায় রেখে"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppen eines Sprachexports, ohne die fertigen Kapitel zu verlieren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "stopping a speech export with the chapters it finished kept"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "deteniendo una exportación de voz y conservando los capítulos que terminó"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "توقف یک صادر کردن گفتار با نگه داشتن فصل‌هایی که تمام کرده است"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "arrêt d’une exportation vocale avec conservation des chapitres terminés"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "עוצר ייצוא שמע מוקרא ושומר את הפרקים שסיים"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "एक स्पीच निर्यात रोकना, पूरे हो चुके अध्यायों को रखते हुए"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
