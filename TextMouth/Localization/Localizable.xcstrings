    "Switching loses the changes TextMouth couldn't save while the library isn't available." : {
      "comment" : "Sentence in the question asked before switching libraries: changes that could not be saved are lost. The failure notices follow.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يؤدي التبديل إلى فقدان التغييرات التي لم يتمكن TextMouth من حفظها بينما المكتبة غير متاحة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "লাইব্রেরি উপলব্ধ না থাকার সময় TextMouth যে পরিবর্তনগুলো সংরক্ষণ করতে পারেনি, লাইব্রেরি বদলালে সেগুলো হারিয়ে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beim Wechseln gehen die Änderungen verloren, die TextMouth nicht sichern konnte, während die Bibliothek nicht verfügbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Al cambiar, se pierden los cambios que TextMouth no pudo guardar mientras la biblioteca no está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Changer de bibliothèque fait perdre les modifications que TextMouth n’a pas pu enregistrer tant que la bibliothèque n’est pas disponible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "बदलने से वे बदलाव खो जाते हैं जिन्हें लाइब्रेरी के उपलब्ध न होने पर TextMouth सहेज नहीं सका।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Berpindah menghilangkan perubahan yang tidak dapat disimpan TextMouth selama pustaka tidak tersedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il cambio fa perdere le modifiche che TextMouth non ha potuto salvare mentre la libreria non è disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "切り替えると、ライブラリが利用できない間に TextMouth が保存できなかった変更は失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "전환하면 보관함을 사용할 수 없는 동안 TextMouth가 저장하지 못한 변경 사항을 잃게 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trocar de biblioteca perde as alterações que o TextMouth não conseguiu salvar enquanto a biblioteca não está disponível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "При смене теряются изменения, которые TextMouth не удалось сохранить, пока библиотека недоступна."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Перемикання втрачає зміни, які TextMouth не вдалося зберегти, поки бібліотека недоступна."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "切换会丢失资料库不可用期间 TextMouth 无法存储的更改。"
          }
        }
      }
    },
