    "Speech paused: the voice did not start. Press Play to try again." : {
      "comment" : "Announcement when the voice did not start a passage, even on fresh synthesizers, so speech paused there. Play is the name of a button.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sprachausgabe pausiert: Die Stimme hat nicht begonnen. Drücke „Wiedergeben“, um es erneut zu versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lectura en pausa: la voz no arrancó. Pulsa Reproducir para intentarlo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voix en pause : la voix n’a pas démarré. Appuyez sur Lire pour réessayer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "स्पीच पॉज़ हुई: आवाज़ शुरू नहीं हुई। फिर से आज़माने के लिए चलाएँ दबाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ucapan dijeda: suara tidak mulai. Tekan Putar untuk mencoba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lettura in pausa: la voce non è partita. Premi Riproduci per riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "読み上げを一時停止しました：声が始まりませんでした。「再生」を押してもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "음성이 일시 정지됨: 음성이 시작되지 않았습니다. 재생을 눌러 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fala pausada: a voz não começou. Pressione Reproduzir para tentar novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Речь приостановлена: голос не запустился. Нажмите «Воспроизвести», чтобы повторить попытку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Озвучення призупинено: голос не запустився. Натисніть «Відтворити», щоб спробувати знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "朗读已暂停：语音未能开始。按“播放”重试。"
          }
        }
      }
    },
    "Speech stopped at character %@ of %@ in the chapter." : {
      "comment" : "A line of the speech refusal report. %1$@ is the character offset where speech stopped and %2$@ the chapter's length in characters, each written without digit grouping like the speech log's offsets.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Sprachausgabe stoppte bei Zeichen %1$@ von %2$@ im Kapitel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Speech stopped at character %1$@ of %2$@ in the chapter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La voz se detuvo en el carácter %1$@ de %2$@ del capítulo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La voix s’est arrêtée au caractère %1$@ sur %2$@ dans le chapitre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "अध्याय के %2$@ वर्णों में से वर्ण %1$@ पर स्पीच रुकी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ucapan berhenti di karakter %1$@ dari %2$@ dalam bab."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lettura interrotta al carattere %1$@ di %2$@ nel capitolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "読み上げは、章の%2$@文字中%1$@文字目で停止しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "챕터에서 %2$@자 중 %1$@번째 문자에서 음성이 중지되었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
