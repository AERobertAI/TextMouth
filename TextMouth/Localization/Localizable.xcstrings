    "audioParseError.startsBeforeEarlierSection" : {
      "comment" : "First sentence of why an audiobook could not be imported: a section starts before another section that comes earlier in the book and is in the same audio file. %1$@ and %4$@ are sections, such as \"heading “Tide Tables”\" or \"untitled heading 3\" (masculine noun phrases in English, without their article); %2$@ and %5$@ are how far into the file each starts, spoken times; %3$@ is the file's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يبدأ %1$@ عند %2$@ من “%3$@”، قبل %4$@ الأسبق الذي يبدأ عند %5$@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ “%3$@”-এ %2$@ থেকে শুরু হয়, যা আগের %4$@-এর শুরুর (%5$@) আগে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die %1$@ beginnt bei %2$@ in der Datei „%3$@“ und damit früher als die vorangehende %4$@, die bei %5$@ beginnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %@ starts %@ into “%@”, before the earlier %@, which starts %@ in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El %1$@ empieza %2$@ después del inicio de “%3$@”, antes del %4$@ anterior, que empieza %5$@ después del inicio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ در زمان %2$@ از «%3$@» شروع می‌شود، یعنی پیش از %4$@ که زودتر می‌آید و در زمان %5$@ آغاز می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pour la section (%1$@), le début se situe à %2$@ dans « %3$@ », avant la section précédente (%4$@), qui commence à %5$@."
          }
        },
        "he" : {
          "stringUnit" : {
