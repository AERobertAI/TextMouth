    "libraryCloud.howToLetGo.reading" : {
      "comment" : "Last sentence of why Stop Keeping on This Mac cannot let a book go: the reading list keeps it. %@ is the name of the Reading List's option that keeps its books downloaded, as the option shows it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لإيقاف الاحتفاظ به، أزله من قائمة القراءة، أو ألغِ تحديد %@ في خيارات قائمة القراءة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এটিকে ছেড়ে দিতে পড়ার তালিকা থেকে সরান, অথবা পড়ার তালিকার বিকল্পে “%@” অচিহ্নিত করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um es freizugeben, nimm es von der Leseliste oder deaktiviere %@ in den Optionen der Leseliste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To let it go, take it off the reading list, or clear %@ in the Reading List's options."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para liberarlo, quítalo de la lista de lectura, o desactiva %@ en las opciones de la lista de lectura."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "برای رها کردن آن، آن را از فهرست مطالعه بردارید، یا %@ را در گزینه‌های فهرست مطالعه پاک کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pour qu’il ne soit plus conservé, retirez-le de la liste de lecture, ou décochez %@ dans les options de la liste de lecture."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כדי לשחרר אותו, הסר אותו מרשימת הקריאה, או בטל את הסימון של “%@” באפשרויות של רשימת הקריאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "उसे जाने देने के लिए, उसे रीडिंग लिस्ट से हटाएँ, या रीडिंग लिस्ट के विकल्पों में %@ को अचयनित करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Untuk melepasnya, keluarkan dari daftar bacaan, atau matikan %@ di opsi Daftar Bacaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Per non mantenerlo più su questo Mac, toglilo dall’elenco di lettura, oppure disattiva %@ nelle opzioni dell’elenco di lettura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "この Mac での保持を解除するには、リーディングリストから外すか、リーディングリストのオプションで「%@」の選択を解除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관을 해제하려면 읽기 목록에서 제거하거나 읽기 목록 옵션에서 %@을(를) 해제하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Haal het van de leeslijst af of schakel %@ uit bij de opties van de leeslijst om het los te laten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aby ją zwolnić, zdejmij ją z listy czytelniczej albo odznacz %@ w opcjach listy czytelniczej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para liberá-lo, tire-o da lista de leitura ou desmarque %@ nas opções da Lista de leitura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Чтобы она не хранилась на этом Mac, уберите её из списка для чтения или снимите отметку «%@» в параметрах списка для чтения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "För att släppa den, ta bort den från läslistan eller avmarkera ”%@” i läslistans alternativ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หากต้องการเลิกเก็บ ให้นำออกจากรายการอ่าน หรือล้าง %@ ในตัวเลือกของรายการอ่าน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bırakmak için onu okuma listesinden çıkarın veya Okuma Listesi seçeneklerinde “%@” seçeneğinin işaretini kaldırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Щоб вона перестала зберігатися, вилучіть її зі списку читання або зніміть позначку «%@» у параметрах списку читання."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اسے چھوڑنے کے لیے، اسے مطالعے کی فہرست سے ہٹائیں، یا مطالعے کی فہرست کے اختیارات میں “%@” آف کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Để ngừng giữ nó, hãy gỡ nó khỏi danh sách đọc, hoặc bỏ chọn %@ trong tùy chọn của Danh sách đọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "要让它不再保留，请将它从阅读列表中移除，或在阅读列表的选项中取消勾选 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "若要讓它釋出，請將它從閱讀列表中移除，或在閱讀列表的選項中取消勾選 %@。"
          }
        }
      }
    },
