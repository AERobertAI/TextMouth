    "dataDirectoryMigrationError.bookOutside" : {
      "comment" : "First sentence of why a move of the data directory was refused. %1$@ is the book's title; %2$@ is the path where its file is stored.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "الكتاب %@ مخزّن في %@، خارج مجلد البيانات، لذا لا يشمله النقل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ বইটি ডেটা ডিরেক্টরির বাইরে %2$@-এ সংরক্ষিত, তাই স্থানান্তর এটি বহন করতে পারে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Buch %1$@ liegt unter %2$@, außerhalb des Datenordners, daher kann das Verschieben es nicht mitnehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The book %@ is stored at %@, outside the data directory, so the move cannot carry it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El libro %1$@ está guardado en %2$@, fuera del directorio de datos, así que el traslado no puede llevarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب %1$@ در %2$@، بیرون از دایرکتوری داده، ذخیره شده است، بنابراین انتقال نمی‌تواند آن را ببرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le livre %1$@ est stocké dans %2$@, en dehors du dossier de données, donc le déplacement ne peut pas l’emporter."
          }
        },
        "he" : {
          "stringUnit" : {
