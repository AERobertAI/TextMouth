        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Salvataggio di %1$@ di audio come %2$@, il formato che questo libro mantiene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@のオーディオを、ブックが使うフォーマット（%2$@）で保存しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "오디오 %1$@을(를) 이 책이 사용하는 포맷인 %2$@(으)로 저장하는 중입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ audio wordt bewaard als %2$@, het formaat dat dit boek gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zachowywanie dźwięku (%1$@) jako %2$@, w obecnym formacie tej książki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Salvando %1$@ de áudio como %2$@, o formato que este livro mantém."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сохранение аудио длительностью %1$@ в формате %2$@, в котором книга хранит аудио."
