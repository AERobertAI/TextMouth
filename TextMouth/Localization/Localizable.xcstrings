    "shortcutsSettings.tryDoublePressHint" : {
      "comment" : "VoiceOver hint of the Try a Double Press button: for five seconds key presses are not shortcuts, and TextMouth says whether two presses were a double press.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لمدة خمس ثوانٍ، لا تُعد الضغطتان التاليتان اختصارين، ويقول TextMouth ما إذا كانتا ضغطة مزدوجة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পাঁচ সেকেন্ড ধরে পরের দুটি কী চাপ শর্টকাট নয়; সেগুলো দুইবার চাপা হলো কি না TextMouth জানায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Für fünf Sekunden sind die nächsten zwei Tastendrücke keine Kurzbefehle; TextMouth sagt, ob sie ein Doppeldruck sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For five seconds, the next two key presses are not shortcuts; TextMouth says whether they make a double press."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Durante cinco segundos, las dos próximas pulsaciones de tecla no son atajos; TextMouth dice si forman una doble pulsación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تا پنج ثانیه، دو فشردن بعدی کلید میان‌بر نیستند؛ TextMouth می‌گوید آیا دوبار فشردن حساب شد یا نه."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pendant cinq secondes, les deux prochains appuis sur une touche ne sont pas des raccourcis ; TextMouth dit s’ils forment un double appui."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "למשך חמש שניות, שתי הלחיצות הבאות על מקשים אינן קיצורים; TextMouth אומר אם הן מהוות לחיצה כפולה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पाँच सेकंड तक अगली दो बार कुंजी दबाने पर शॉर्टकट नहीं चलते; TextMouth बताता है कि यह दो बार दबाना माना गया या नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Selama lima detik, dua penekanan tombol berikutnya bukan pintasan; TextMouth menyebutkan apakah keduanya merupakan tekan ganda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Per cinque secondi, le prossime due pressioni di tasto non attivano scorciatoie; TextMouth dice se formano una doppia pressione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "5秒間、次の2回のキー操作はショートカットとして扱われません。TextMouth は、それがダブルプレスになったかどうかを伝えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "5초 동안 다음 두 번의 키 입력은 단축키로 처리되지 않으며, TextMouth가 두 번 누르기에 해당하는지 알려 줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gedurende vijf seconden zijn de volgende twee toetsaanslagen geen toetsenbordcommando's; TextMouth zegt of ze een dubbele druk vormen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Przez pięć sekund dwa następne naciśnięcia klawiszy nie są skrótami; TextMouth mówi, czy były podwójnym naciśnięciem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Por cinco segundos, os próximos dois pressionamentos de tecla não são atalhos; o TextMouth diz se formam um pressionamento duplo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В течение пяти секунд следующие два нажатия клавиш не считаются сочетаниями; TextMouth сообщает, были ли они двойным нажатием."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Under fem sekunder räknas nästa två tangenttryck inte som genvägar; TextMouth säger om de blir ett dubbeltryck."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ใน 5 วินาที การกดแป้นสองครั้งถัดไปจะไม่ใช่ทางลัด TextMouth จะบอกว่าเป็นการกดสองครั้งหรือไม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beş saniye boyunca sonraki iki tuşa basış kısayol sayılmaz; TextMouth bunların çift basma olup olmadığını söyler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Протягом п’яти секунд наступні два натискання клавіш не є комбінаціями; TextMouth скаже, чи вони склали подвійне натискання."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پانچ سیکنڈ تک اگلی دو بار کلید دبانے سے کوئی شارٹ کٹ نہیں چلتا؛ TextMouth بتاتا ہے کہ ان سے دوہرا دبانا بنتا ہے یا نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trong năm giây, hai lần nhấn phím tiếp theo không phải là phím tắt; TextMouth cho biết chúng có tạo thành nhấn đúp không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "接下来五秒内，按下的两个键不会触发快捷键；TextMouth 会告诉你它们是否构成连按两次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "接下來五秒內，接著的兩次按鍵不會觸發快速鍵；TextMouth 會說明它們是否構成連按兩次。"
          }
        }
      }
    },
