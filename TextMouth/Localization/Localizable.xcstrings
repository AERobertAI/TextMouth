          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブックを再生します。ブックは終わりで自動的に停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책을 재생합니다. 어차피 끝에서 멈춥니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Speelt het boek af; het stopt sowieso aan het einde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Odtwarza książkę; i tak zatrzymuje się na jej końcu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
