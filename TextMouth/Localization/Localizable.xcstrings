            "value" : "এই রেকর্ডিং %@ ফোল্ডারে অডিওবুক হিসেবে সংরক্ষণ করে, রেকর্ডের সময় অনুযায়ী শিরোনাম দিয়ে।"
          }
        },
        "de" : {
          "stringUnit" : {
