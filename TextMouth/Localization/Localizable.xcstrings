          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’audio è solo nel cloud, non ancora su questo Mac."
          }
        }
      }
    },
    "The audio isn't ready to play yet." : {
      "comment" : "Said when Play is pressed in the audio editor before the edited audio is ready, or after it couldn't be made ready.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
