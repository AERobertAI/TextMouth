            "value" : "TextMouth sudah menunggunya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth lo ha atteso."
          }
        },
        "ja" : {
          "stringUnit" : {
