          }
        }
      }
    },
    "The data directory's Logs folder can't be written (%@), so logs go to %@ until it can." : {
      "comment" : "The line under the Log location pop-up in the Storage settings while the data directory's Logs folder cannot be written. %1$@ is the reason the system gives, which may be in English, and %2$@ is the folder's full path, which stays as written.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّرت الكتابة في مجلد السجلات بمجلد البيانات (%@)، لذا تُكتب السجلات في %@ إلى أن تصبح الكتابة ممكنة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ডেটা ডিরেক্টরির লগ ফোল্ডারে লেখা যাচ্ছে না (%1$@), তাই লেখা না যাওয়া পর্যন্ত লগ %2$@-এ যাবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "In den Ordner „Logs“ des Datenordners kann nicht geschrieben werden (%1$@), daher gehen die Protokolle nach %2$@, bis es wieder geht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The data directory's Logs folder can't be written (%1$@), so logs go to %2$@ until it can."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se puede escribir en la carpeta Logs del directorio de datos (%1$@), así que los registros van a %2$@ hasta que se pueda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le dossier Journaux du dossier de données n’est pas accessible en écriture (%1$@) ; les journaux vont donc dans %2$@ jusqu’à ce qu’il le soit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "डेटा फ़ोल्डर के Logs फ़ोल्डर में लिखा नहीं जा सकता (%1$@), इसलिए जब तक लिखा न जा सके, लॉग %2$@ में जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
