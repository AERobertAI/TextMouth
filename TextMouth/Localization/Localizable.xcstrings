    "phoneReader.returnHint" : {
      "comment" : "Hint of the iPhone reader's Return button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعود إلى حيث بدأ آخر انتقال."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "শেষবার যেখান থেকে সরে গিয়েছিলেন, সেখানে ফিরে যায়।"
