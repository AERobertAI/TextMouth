    "Its place, bookmarks, and transcript, if it has any, are kept, and it can be downloaded again." : {
      "comment" : "Sentence about one deleted download: what the listener left in it is kept, and it can be downloaded again.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Seine Position, Lesezeichen und sein Transkript, falls vorhanden, bleiben erhalten, und es kann erneut heruntergeladen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Su lugar, sus marcadores y su transcripción, si la tiene, se conservan, y se puede descargar de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sa position, ses signets et sa transcription, s’il en a, sont conservés, et il peut être téléchargé de nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La sua posizione, i segnalibri e la trascrizione, se ne ha una, vengono conservati e può essere scaricato di nuovo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sua posição, seus marcadores e sua transcrição, se tiver, são mantidos, e ele pode ser baixado novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Место, закладки и расшифровка, если она есть, сохраняются, и книгу можно загрузить снова."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Його місце, закладки та транскрипція, якщо вони є, зберігаються, і його можна завантажити знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "它的位置、书签以及文字稿（如果有）都会保留，并且可以再次下载。"
          }
        }
      }
    },
    "Its reading index could not be saved, so TextMouth will build it again later." : {
      "comment" : "First sentence of a warning about a book that moved into the current library format: its reading index will be built again later.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sein Leseindex konnte nicht gesichert werden, daher baut TextMouth ihn später neu auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo guardar su índice de lectura, así que TextMouth lo creará de nuevo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Son index de lecture n’a pas pu être enregistré, donc TextMouth le reconstruira plus tard."
