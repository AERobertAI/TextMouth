        }
      }
    },
    "TextMouth has no rules of its own: none was right in every book tested. Edit Rules… opens your copy, where you can add rules, such as a name the recognizer always spells another way." : {
      "comment" : "Line of the Clean Up Transcript sheet when the rules that come with the app are empty. Edit Rules… is the name of a button of the sheet.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth hat keine eigenen Regeln: Keine war in allen getesteten Büchern richtig. „Regeln bearbeiten …“ öffnet deine Kopie, in der du Regeln hinzufügen kannst, etwa für einen Namen, den die Erkennung immer anders schreibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no tiene reglas propias: ninguna fue correcta en todos los libros probados. Editar reglas… abre tu copia, donde puedes agregar reglas, como un nombre que el reconocedor siempre escribe de otra manera."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non ha regole proprie: nessuna andava bene in ogni libro provato. Modifica regole… apre la tua copia, dove puoi aggiungere regole, come un nome che il riconoscimento scrive sempre in un altro modo."
          }
        }
      }
    },
    "TextMouth hasn't merged it or removed it." : {
      "comment" : "Last sentence of the report of a conflicting copy: nothing was done with it. \"It\" is the copy.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no la ha combinado ni la ha quitado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non l’ha unita né rimossa."
          }
        }
      }
    },
    "TextMouth hasn't read the latest save yet." : {
      "comment" : "Reason after a colon: a rebuild left the book's text alone because the latest save of the edited text is not read yet.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth aún no ha leído el último guardado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non ha ancora letto l’ultimo salvataggio."
          }
        }
      }
    },
    "TextMouth hasn't read this book's headings yet. Open the book once, then export again." : {
      "comment" : "Why a book's headings could not be exported, after the file's name in a failure sentence such as \"Couldn't export Headings: ...\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth aún no ha leído los encabezados de este libro. Abre el libro una vez y vuelve a exportar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non ha ancora letto le intestazioni di questo libro. Apri il libro una volta, poi esporta di nuovo."
          }
        }
      }
    },
    "TextMouth is already moving its data directory." : {
      "comment" : "First sentence of why an operation was refused: the library is already being moved.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ya está moviendo su directorio de datos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth sta già spostando la sua cartella dei dati."
          }
        }
      }
    },
    "TextMouth is already transcribing %@. Try again when that finishes." : {
      "comment" : "Error shown when a transcription is started while another runs. %@ is the title of the audiobook being transcribed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth transkribiert bereits %@. Versuche es erneut, wenn das fertig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ya está transcribiendo %@. Inténtalo de nuevo cuando termine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth sta già trascrivendo %@. Riprova quando ha finito."
          }
        }
      }
    },
    "TextMouth is also open on “%@” (active %lld minutes ago)." : {
      "comment" : "First sentence of the warning that another Mac has this library open. %1$@ is that Mac's name; %2$lld is how many minutes ago it was last active.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "TextMouth is also open on “%@” (active %lld minute ago)."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "TextMouth is also open on “%@” (active %lld minutes ago)."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "TextMouth también está abierto en «%1$@» (activo hace %2$lld de minutos)."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
