    "feed.unsubscribeMessage.staysLibrary" : {
      "comment" : "A sentence of the confirmation before Unsubscribe: the feed stays, with its settings. %@ is the name of the Resubscribe command.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يبقى الموجز في مكتبتك مع إعداداته، ويفحصه %@ مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফিডটি তার সেটিংসসহ আপনার লাইব্রেরিতে থাকে, এবং %@ বেছে নিলে এটি আবার চেক করা হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Feed bleibt mit seinen Einstellungen in deiner Bibliothek, und mit %@ wird er erneut geprüft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The feed stays in your library with its settings, and %@ checks it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El canal se queda en tu biblioteca con sus ajustes, y %@ lo vuelve a revisar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فید با تنظیماتش در کتابخانه‌ی شما می‌ماند و %@ دوباره آن را بررسی می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le flux reste dans votre bibliothèque avec ses réglages, et la commande %@ le vérifie de nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הערוץ נשאר בספרייה שלך עם ההגדרות שלו, ובחירה ב“%@” תבדוק אותו שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ीड अपनी सेटिंग के साथ आपकी लाइब्रेरी में बना रहता है, और “%@” उसे फिर से जाँचता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Feed tetap ada di pustaka Anda beserta pengaturannya, dan %@ memeriksanya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il feed resta nella tua libreria con le sue impostazioni; scegli %@ per riprendere a controllarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フィードは、設定とともにライブラリに残ります。%@を選択すると、もう一度確認されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "피드는 설정과 함께 보관함에 남습니다. %@은(는) 피드를 다시 확인합니다."
          }
        },
        "nl" : {
