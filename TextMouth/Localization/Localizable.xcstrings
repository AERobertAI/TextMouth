{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ adds a bookmark at the current position." : {
      "comment" : "Help under \"No bookmarks yet.\" in the Bookmarks list. %@ is the keyboard shortcut that adds a bookmark, spelled out in words, such as Command + B."
    },
    "%@ adds one at the current position." : {
      "comment" : "Help under \"No bookmarks yet.\" in the Bookmarks list, when the add command has no keyboard shortcut. %@ is the name of the Add Bookmark button above the list."
    },
    "%@ is already in the reading list." : {
      "comment" : "VoiceOver announcement when Add to Reading List added nothing: the one book selected is on the list already. %@ is the book's title."
    },
    "%@ isn't in the reading list." : {
      "comment" : "VoiceOver announcement when Remove from Reading List took nothing off: the one book selected is not on the list. %@ is the book's title."
    },
    "%@ remaining" : {
      "comment" : "The sleep timer's state as VoiceOver reads it after \"Sleep timer:\" while it counts down. %@ is the time left in minutes and seconds, such as 4:59."
    },
    "%lld books were already in it." : {
      "comment" : "Second sentence of the announcement after books were added to the reading list: some chosen were on it already. %lld is how many.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld book was already in it."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld books were already in it."
                }
              }
            }
          }
        }
      }
    },
    "%lld books were not in it." : {
      "comment" : "Second sentence of the announcement after books were taken off the reading list: some chosen were not on it. %lld is how many.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld book was not in it."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld books were not in it."
                }
              }
            }
          }
        }
      }
    },
    "%lld minutes" : {
      "comment" : "A sleep timer's length, as its preset button and the custom minutes' value say it, such as \"10 minutes\". %lld is the number of minutes.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld minute"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld minutes"
                }
              }
            }
          }
        }
      }
    },
    "A New Window" : {
      "comment" : "A choice of the Open the next book in pop-up button (Settings, Playback; Feed Info; Folder Settings): the next book opens in a window of its own, and this one stays."
    },
    "A new timer replaces the one running." : {
      "comment" : "Note under the sleep timer sheet's New Timer heading while a timer runs: setting one of the timers below stops it."
    },
    "Add" : {
      "comment" : "Button of the panel for adding a bookmark: adds it, with the note written."
    },
    "Add %lld Books to Reading List" : {
      "comment" : "Context menu item for the books selected in the Library: adds them to the reading list. Title case. %lld is the number of books selected.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Add %lld Book to Reading List"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Add %lld Books to Reading List"
                }
              }
            }
          }
        }
      }
    },
    "Add %lld books to the reading list" : {
      "comment" : "VoiceOver label of the Library's edit-mode bar button that adds the selected books to the reading list. %lld is the number of books selected.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Add %lld book to the reading list"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Add %lld books to the reading list"
                }
              }
            }
          }
        }
      }
    },
    "Add Bookmark" : {
      "comment" : "Button of the Bookmarks list that adds a bookmark at the reading position, and the heading of the panel where its note is written."
    },
    "Added %lld books to the reading list." : {
      "comment" : "VoiceOver announcement after several books were added to the reading list. %lld is the number of books added."
    },
    "Added to reading list: %@" : {
      "comment" : "VoiceOver announcement after one book was added to the reading list. %@ is the book's title."
    },
    "Adds the selected books to the end of the reading list." : {
      "comment" : "VoiceOver hint of the Library's edit-mode bar button Add to Reading List."
    },
    "Adjust minutes" : {
      "comment" : "VoiceOver label of the stepper beside the sleep timer sheet's custom minutes field."
    },
    "Available only while this feed's articles go on to another article when one ends" : {
      "comment" : "VoiceOver hint of the dimmed Open the next article in pop-up button in a news feed's Feed Info: when it can be used."
    },
    "Available only while this feed's episodes go on to another episode when one ends" : {
      "comment" : "VoiceOver hint of the dimmed Open the next episode in pop-up button in a podcast feed's Feed Info: when it can be used."
    },
    "Available only while this feed's items go on to another item when one ends" : {
      "comment" : "VoiceOver hint of the dimmed Open the next item in pop-up button in a feed's Feed Info: when it can be used."
    },
    "Available only while this folder's books go on to another book when one ends" : {
      "comment" : "VoiceOver hint of the dimmed Open the next book in pop-up button in a folder's settings: when it can be used."
    },
    "Bookmark %lld" : {
      "comment" : "A bookmark's name, by its number: the first line of its row in the Bookmarks list, and what VoiceOver says after a move to it. %lld is the bookmark's number."
    },
    "Bookmark %lld added" : {
      "comment" : "VoiceOver announcement after a bookmark was added at the reading position. %lld is the new bookmark's number."
    },
    "Bookmark %lld removed" : {
      "comment" : "VoiceOver announcement after the bookmark command removed the bookmark at the reading position. %lld is that bookmark's number."
    },
    "Bookmark %lld, %@, Note: %@, added %@" : {
      "comment" : "VoiceOver label of a bookmark's row in the Bookmarks list and its rotor. %1$lld is the bookmark's number; %2$@ the heading it is under; %3$@ its note, written by the listener; %4$@ the day it was added, such as October 9, 2026.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bookmark %1$lld, %2$@, Note: %3$@, added %4$@"
          }
        }
      }
    },
    "Bookmark %lld, %@, added %@" : {
      "comment" : "VoiceOver label of a bookmark's row in the Bookmarks list and its rotor, for a bookmark with no note. %1$lld is the bookmark's number; %2$@ the heading it is under; %3$@ the day it was added, such as October 9, 2026.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bookmark %1$lld, %2$@, added %3$@"
          }
        }
      }
    },
    "Bookmark %lld, Note: %@, added %@" : {
      "comment" : "VoiceOver label of a bookmark's row in the Bookmarks list and its rotor, for a bookmark under no heading. %1$lld is the bookmark's number; %2$@ its note, written by the listener; %3$@ the day it was added, such as October 9, 2026.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bookmark %1$lld, Note: %2$@, added %3$@"
          }
        }
      }
    },
    "Bookmark %lld, added %@" : {
      "comment" : "VoiceOver label of a bookmark's row in the Bookmarks list and its rotor, for a bookmark with no note under no heading. %1$lld is the bookmark's number; %2$@ the day it was added, such as October 9, 2026.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bookmark %1$lld, added %2$@"
          }
        }
      }
    },
    "Bookmark note" : {
      "comment" : "VoiceOver label of the note field when adding a bookmark or editing its note."
    },
    "Bookmarks" : {
      "comment" : "Title of the Bookmarks list over a book's reader, read by VoiceOver as its heading; also the name of the list's VoiceOver rotor."
    },
    "Cancel" : {
      "comment" : "Button that leaves the panel for adding a bookmark or editing its note, changing nothing."
    },
    "Cancel Timer" : {
      "comment" : "Button of the sleep timer sheet that stops the running timer."
    },
    "Chooses what a book opened from the list does when it ends." : {
      "comment" : "VoiceOver hint of the Reading List's When a book ends pop-up button."
    },
    "Chooses where the next book opens: in this window or a new one. A book open in another window comes forward, and with %@, this window closes." : {
      "comment" : "VoiceOver hint of the Open the next book in pop-up button in Settings, Playback, also shown under it. %@ is the name of its choice This Window."
    },
    "Chooses where this feed's next article opens." : {
      "comment" : "VoiceOver hint of the Open the next article in pop-up button in a news feed's Feed Info."
    },
    "Chooses where this feed's next episode opens." : {
      "comment" : "VoiceOver hint of the Open the next episode in pop-up button in a podcast feed's Feed Info."
    },
    "Chooses where this feed's next item opens." : {
      "comment" : "VoiceOver hint of the Open the next item in pop-up button in a feed's Feed Info."
    },
    "Chooses where this folder's next book opens." : {
      "comment" : "VoiceOver hint of the Open the next book in pop-up button in a folder's settings."
    },
    "Close" : {
      "comment" : "Button that closes a sheet, such as the sleep timer sheet over a book's reader."
    },
    "Could not add the bookmark: “%@” is no longer in the library." : {
      "comment" : "VoiceOver announcement when a bookmark could not be added because the book left the library while its reader was open. %@ is the book's title, in quotation marks."
    },
    "Could not remove the bookmark: “%@” is no longer in the library." : {
      "comment" : "VoiceOver announcement when a bookmark could not be removed because the book left the library while its reader was open. %@ is the book's title, in quotation marks."
    },
    "Current Timer" : {
      "comment" : "Heading of the sleep timer sheet's section about the timer running now."
    },
    "Custom minutes" : {
      "comment" : "VoiceOver label of the sleep timer sheet's field of a custom number of minutes."
    },
    "Custom:" : {
      "comment" : "Shown before the sleep timer sheet's field of a custom number of minutes. Hidden from VoiceOver, which reads the field's label."
    },
    "Delete" : {
      "comment" : "A command on a bookmark of the Bookmarks list, as a button beside its row, a VoiceOver action, and a context menu item: deletes the bookmark."
    },
    "Delete bookmark %lld" : {
      "comment" : "VoiceOver label of the button beside a bookmark's row that deletes it. %lld is the bookmark's number."
    },
    "Done" : {
      "comment" : "Button that closes the Bookmarks list over a book's reader."
    },
    "Download cancelled, so playback stopped." : {
      "comment" : "VoiceOver announcement when the listener cancelled the download of a feed's next episode or article, which playback was waiting for."
    },
    "Downloading the next article: %@" : {
      "comment" : "A sentence of the announcement as a feed's article ends: the next article is being downloaded. %@ is that article's title."
    },
    "Downloading the next episode: %@" : {
      "comment" : "A sentence of the announcement as a feed's episode ends: the next episode is being downloaded. %@ is that episode's title."
    },
    "Edit Bookmark %lld" : {
      "comment" : "Heading of the panel for editing a bookmark's note. %lld is the bookmark's number."
    },
    "Edit Note" : {
      "comment" : "A command on a bookmark of the Bookmarks list, as a button beside its row, a VoiceOver action, and a context menu item: edits the bookmark's note."
    },
    "Edit note for bookmark %lld" : {
      "comment" : "VoiceOver label of the button beside a bookmark's row that edits its note. %lld is the bookmark's number."
    },
    "End of book" : {
      "comment" : "Name of the sleep timer that stops where the book ends: its button in the sleep timer sheet, and the timer's state in the reader."
    },
    "End of heading" : {
      "comment" : "Name of the sleep timer that stops where the heading playing ends: its button in the sleep timer sheet, and the timer's state in the reader."
    },
    "End of the reading list" : {
      "comment" : "A sentence of the announcement as a book read from the reading list ends, after \"Finished: <title>.\": no book follows it below. Written without its full stop."
    },
    "Every book above it in the reading list is finished" : {
      "comment" : "A sentence of the announcement as a book read from the reading list ends while the list plays upward: the books above it are all finished, and the list passes over finished books. Written without its full stop."
    },
    "Every book after it in the folder is finished" : {
      "comment" : "A sentence of the announcement as a book ends, after \"Finished: <title>.\": every book after it in its library folder is finished, so none plays. Written without its full stop."
    },
    "Every book before it in the folder is finished" : {
      "comment" : "A sentence of the announcement as a book ends, in a folder or feed that plays the book above: every book before it is finished, so none plays. Written without its full stop."
    },
    "Every book below it in the reading list is finished" : {
      "comment" : "A sentence of the announcement as a book read from the reading list ends, after \"Finished: <title>.\": the books below it are all finished, and the list passes over finished books. Written without its full stop."
    },
    "Fading out" : {
      "comment" : "The sleep timer's state while it fades the sound out before pausing, shown in the sleep timer sheet and the reader."
    },
    "Finished" : {
      "comment" : "How far a finished book has got, shown and spoken in place of its percent: in the library's row, Speak Info, Where Am I?, and Copy Reading Position."
    },
    "Finished: %@" : {
      "comment" : "VoiceOver announcement as a book ends with no book to follow it. %@ is the book's title. Sentences saying why may follow it."
    },
    "Go To" : {
      "comment" : "A command on a bookmark of the Bookmarks list, as a VoiceOver action and a context menu item: moves the book to the bookmark."
    },
    "Go to bookmark %lld" : {
      "comment" : "VoiceOver label of a button that moves the book to a bookmark. %lld is the bookmark's number."
    },
    "Goes to this bookmark and closes the list." : {
      "comment" : "VoiceOver hint of a bookmark's row in the Bookmarks list."
    },
    "In reading list" : {
      "comment" : "Part of a library row's VoiceOver label, after the book's title and author: the book is on the reading list."
    },
    "Keep these books on this Mac" : {
      "comment" : "Checkbox of the Reading List's options bar, shown while the library is in iCloud: keep the list's books downloaded on this Mac."
    },
    "Keeps the list's books downloaded on this Mac alone. Clearing it removes no download." : {
      "comment" : "VoiceOver hint of the Reading List's Keep these books on this Mac checkbox: a choice of this Mac's alone."
    },
    "Keeps the order you set with Move Book Up, Move Book Down, or dragging." : {
      "comment" : "VoiceOver hint of the Reading List Order item of the Reading List's Sort menu. Move Book Up and Move Book Down are commands of the Library menu."
    },
    "Marks the reading position." : {
      "comment" : "VoiceOver hint of the Bookmarks list's Add Bookmark button: the bookmark is added where the book is being read."
    },
    "Metadata updated" : {
      "comment" : "VoiceOver announcement after an audiobook's edited title, artist, album, genre, or year was saved."
    },
    "Minutes" : {
      "comment" : "Placeholder of the sleep timer sheet's field of a custom number of minutes."
    },
    "New Timer" : {
      "comment" : "Heading of the sleep timer sheet's section of timers to set: the minute presets and a custom number of minutes."
    },
    "Next book not started because of the sleep timer" : {
      "comment" : "A sentence of the announcement as a book ends, after \"Finished: <title>.\": the next book was not started, because the sleep timer would not stop it. Written without its full stop."
    },
    "No bookmarks yet." : {
      "comment" : "Shown and read in the Bookmarks list of a book with no bookmark. A sentence saying how to add one follows it."
    },
    "No more books in folder" : {
      "comment" : "A sentence of the announcement as a book ends, after \"Finished: <title>.\": its library folder has no book after it. Written without its full stop."
    },
    "No next book in the reading list." : {
      "comment" : "VoiceOver announcement when Next in Reading List finds no book below this one."
    },
    "No next book in the reading list: every book below this one is finished." : {
      "comment" : "VoiceOver announcement when Next in Reading List finds only finished books below this one, which the list passes over."
    },
    "No previous book in the reading list." : {
      "comment" : "VoiceOver announcement when Previous in Reading List finds no book above this one."
    },
    "No previous book in the reading list: every book above this one is finished." : {
      "comment" : "VoiceOver announcement when Previous in Reading List finds only finished books above this one, which the list passes over."
    },
    "No previous sleep timer to restart." : {
      "comment" : "VoiceOver announcement when the Restart Sleep Timer command finds no timer was ever set."
    },
    "None of the %lld selected books is in the reading list." : {
      "comment" : "VoiceOver announcement when Remove from Reading List took nothing off: no book selected is on the list. %lld is the number of books selected (two or more)."
    },
    "Not restarted because of the sleep timer" : {
      "comment" : "A sentence of the announcement as a book set to loop ends: it did not start again, because the sleep timer stopped it. Written without its full stop."
    },
    "Note" : {
      "comment" : "Placeholder of the note field when editing a bookmark's note."
    },
    "Note (optional)" : {
      "comment" : "Placeholder of the note field when adding a bookmark."
    },
    "Off" : {
      "comment" : "VoiceOver value of the iPhone reader's Sleep Timer button while no sleep timer runs."
    },
    "Open the next article in" : {
      "comment" : "Label of the pop-up button in a news feed's Feed Info, choosing where the feed's next article opens."
    },
    "Open the next book in" : {
      "comment" : "Label of the pop-up button in Settings, Playback, and in a folder's settings, choosing where the next book opens; its choices are This Window and A New Window."
    },
    "Open the next episode in" : {
      "comment" : "Label of the pop-up button in a podcast feed's Feed Info, choosing where the feed's next episode opens."
    },
    "Open the next item in" : {
      "comment" : "Label of the pop-up button in a feed's Feed Info, choosing where the feed's next item opens."
    },
    "Opening: %@" : {
      "comment" : "VoiceOver announcement as Next in Reading List or Previous in Reading List opens a book without playing it. %@ is the book's title."
    },
    "Passes over finished books when a book from the list ends." : {
      "comment" : "VoiceOver hint of the Reading List's Skip finished books checkbox."
    },
    "Pause playback after:" : {
      "comment" : "Note under the sleep timer sheet's New Timer heading while no timer runs; the minute presets follow it, such as 10 minutes."
    },
    "Play the book above" : {
      "comment" : "A choice of the Reading List's When a book ends pop-up button: when a book opened from the list ends, play the book above it in the list."
    },
    "Play the book below" : {
      "comment" : "A choice of the Reading List's When a book ends pop-up button: when a book opened from the list ends, play the book below it in the list."
    },
    "Plays the book and pauses before it starts again." : {
      "comment" : "VoiceOver hint and help tag of the sleep timer sheet's End of book button, for a book set to start again from its beginning when it ends."
    },
    "Plays the book and pauses before the next book." : {
      "comment" : "VoiceOver hint and help tag of the sleep timer sheet's End of book button, for a book set to go on to the next book when it ends."
    },
    "Plays the book until the next heading." : {
      "comment" : "VoiceOver hint and help tag of the sleep timer sheet's End of heading button: the book plays, and pauses where the next heading begins."
    },
    "Plays the book." : {
      "comment" : "VoiceOver hint of the sleep timer sheet's minute presets and Set button: setting the timer also plays the book."
    },
    "Plays the book; it stops at its end anyway." : {
      "comment" : "VoiceOver hint and help tag of the sleep timer sheet's End of book button, for a book that stops at its end on its own, so the timer adds nothing there."
    },
    "Reading List" : {
      "comment" : "The start of the window title of a book read from the reading list, before a colon and the book's title, in place of \"Book\"; also the name of the Library's Reading List."
    },
    "Reading List Order" : {
      "comment" : "Name of the order the Reading List shows its books in, the one the listener arranges: the only item of its Sort menu."
    },
    "Reading list, book %lld of %lld" : {
      "comment" : "Where a book read from the reading list stands in it, in the reader's header and in Where Am I?. %1$lld is the book's place in the list; %2$lld how many books the list holds.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reading list, book %1$lld of %2$lld"
          }
        }
      }
    },
    "Remove %lld Books from Reading List" : {
      "comment" : "Context menu item for the books selected in the Library: takes them off the reading list. Title case. %lld is the number of books selected.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Remove %lld Book from Reading List"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Remove %lld Books from Reading List"
                }
              }
            }
          }
        }
      }
    },
    "Remove %lld books from the reading list" : {
      "comment" : "VoiceOver label of the Library's edit-mode bar button that takes the selected books off the reading list. %lld is the number of books selected.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Remove %lld book from the reading list"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Remove %lld books from the reading list"
                }
              }
            }
          }
        }
      }
    },
    "Remove Bookmark %lld?" : {
      "comment" : "Title of the iPhone's question before a bookmark with a note is removed; the note is shown under it. %lld is the bookmark's number."
    },
    "Remove books when finished" : {
      "comment" : "Checkbox of the Reading List's options bar: take each book off the list once it is finished."
    },
    "Removed %lld books from the reading list." : {
      "comment" : "VoiceOver announcement after several books were taken off the reading list. %lld is the number of books taken off."
    },
    "Removed from reading list: %@" : {
      "comment" : "VoiceOver announcement after one book was taken off the reading list. %@ is the book's title."
    },
    "Reset Timer" : {
      "comment" : "Button of the sleep timer sheet that starts the running timer again from its whole length."
    },
    "Restarting: %@" : {
      "comment" : "VoiceOver announcement as a book set to loop starts again from its beginning. %@ is the book's title."
    },
    "Restarts the timer at its full length." : {
      "comment" : "VoiceOver hint of the sleep timer sheet's Reset Timer button: the running timer starts again from the length it was set to."
    },
    "Returned to previous position" : {
      "comment" : "VoiceOver announcement after the Return command moved the book back to where it was before the last jump to a heading, bookmark, or search result."
    },
    "Returns to the book." : {
      "comment" : "VoiceOver hint of the sleep timer sheet's Close button: closing the sheet goes back to the book's reader."
    },
    "Save" : {
      "comment" : "Button of the panel for editing a bookmark's note: keeps the note."
    },
    "Set" : {
      "comment" : "Button after the sleep timer sheet's custom minutes field: sets a timer for those minutes."
    },
    "Set timer for %lld minutes" : {
      "comment" : "VoiceOver label of a sleep timer button that sets a timer of so many minutes. %lld is the number of minutes.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Set timer for %lld minute"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Set timer for %lld minutes"
                }
              }
            }
          }
        }
      }
    },
    "Skip finished books" : {
      "comment" : "Checkbox of the Reading List's options bar: when a book opened from the list ends, pass over the finished books."
    },
    "Sleep Timer" : {
      "comment" : "Title of the sleep timer sheet over a book's reader, read by VoiceOver as its heading."
    },
    "Sleep timer cancelled, because the next book could not be opened." : {
      "comment" : "VoiceOver announcement, after the reason a book failed to open: the sleep timer that was to go on with that book has stopped."
    },
    "Sleep timer cancelled, because you moved to another book while it faded out." : {
      "comment" : "VoiceOver announcement after \"Starting: <title>\": moving to another book while the sleep timer was fading the sound out ended the timer."
    },
    "Sleep timer cancelled." : {
      "comment" : "VoiceOver announcement after the Cancel Timer button stopped the sleep timer."
    },
    "Sleep timer expired" : {
      "comment" : "A sentence of the announcement as a book ends, after \"Finished: <title>.\": the sleep timer stopped playback there. Written without its full stop, which is added after it."
    },
    "Sleep timer expired at the end of the heading. Playback paused." : {
      "comment" : "VoiceOver announcement as a sleep timer set to End of heading pauses the book where the heading ends."
    },
    "Sleep timer expired. Playback paused." : {
      "comment" : "VoiceOver announcement as a sleep timer of so many minutes runs out and pauses the book."
    },
    "Sleep timer: %@" : {
      "comment" : "VoiceOver label of the sleep timer's status in the reader and the sleep timer sheet. %@ is the timer's state, such as \"4:59 remaining\" or \"stops at the end of this heading\"."
    },
    "Sleep timer: %@." : {
      "comment" : "VoiceOver announcement after a sleep timer that stops at a place was set. %@ says where it stops, such as \"stops at the end of this heading\"."
    },
    "Sleep timer: %lld minutes remaining" : {
      "comment" : "VoiceOver announcement as the sleep timer's countdown passes a milestone. %lld is the whole minutes left (5 or 1).",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Sleep timer: %lld minute remaining"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Sleep timer: %lld minutes remaining"
                }
              }
            }
          }
        }
      }
    },
    "Sleep timer: %lld seconds remaining" : {
      "comment" : "VoiceOver announcement as the sleep timer's countdown passes a milestone under a minute. %lld is the seconds left (30 or 10)."
    },
    "Sort books by %@" : {
      "comment" : "VoiceOver label of the Library's Sort button while the Reading List shows. %@ is the name of the Reading List's order, Reading List Order."
    },
    "Sorted by %@" : {
      "comment" : "VoiceOver announcement after the Reading List's order was chosen in its Sort menu. %@ is the order's name, Reading List Order."
    },
    "Start of the reading list" : {
      "comment" : "A sentence of the announcement as a book read from the reading list ends while the list plays upward: no book above it. Written without its full stop."
    },
    "Starting again: %@" : {
      "comment" : "VoiceOver announcement as Play starts a finished book over from its beginning. %@ is the book's title."
    },
    "Starting: %@" : {
      "comment" : "VoiceOver announcement as the next book starts playing after one ends. %@ is the next book's title."
    },
    "Still starting: %@" : {
      "comment" : "VoiceOver announcement when Play is pressed while the next book is still opening. %@ is the next book's title."
    },
    "Stop" : {
      "comment" : "A choice of the Reading List's When a book ends pop-up button: when a book opened from the list ends, stop there."
    },
    "Stop At" : {
      "comment" : "Heading of the sleep timer sheet's section of timers that stop at a place in the book: End of heading and End of book."
    },
    "Stop at the end of the book" : {
      "comment" : "VoiceOver label of the sleep timer sheet's End of book button, which sets a timer that stops where the book ends."
    },
    "Stop at the end of this heading" : {
      "comment" : "VoiceOver label of the sleep timer sheet's End of heading button, which sets a timer that stops where the heading playing ends."
    },
    "Take it off the reading list, or clear %@ in the Reading List's options" : {
      "comment" : "Advice that begins a sentence of the iCloud library's messages, on letting go of a book this Mac keeps for the reading list; the sentence goes on after it. %@ is the name of the checkbox Keep these books on this Mac."
    },
    "Take them off the reading list, or clear %@ in the Reading List's options" : {
      "comment" : "Advice that begins a sentence of the iCloud library's messages, on letting go of several books this Mac keeps for the reading list; the sentence goes on after it. %@ is the name of the checkbox Keep these books on this Mac."
    },
    "Takes %lld to %lld minutes." : {
      "comment" : "VoiceOver hint of the sleep timer sheet's custom minutes field: the fewest and most minutes it takes. %1$lld is the fewest (1); %2$lld the most (480).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Takes %1$lld to %2$lld minutes."
          }
        }
      }
    },
    "Takes each finished book off the list when its window moves on or closes. Books finished before stay." : {
      "comment" : "VoiceOver hint of the Reading List's Remove books when finished checkbox."
    },
    "Takes the selected books off the reading list. They stay in the library." : {
      "comment" : "VoiceOver hint of the Library's edit-mode bar button Remove from Reading List."
    },
    "TextMouth is not downloading right now." : {
      "comment" : "Why the download of a feed's next episode did not start: the app is quitting or the feed is being deleted. Said after \"The next episode could not be downloaded, so playback stopped.\""
    },
    "The %lld selected books are already in the reading list." : {
      "comment" : "VoiceOver announcement when Add to Reading List added nothing: every book selected is on the list already. %lld is the number of books selected (two or more)."
    },
    "The book is in %@." : {
      "comment" : "Second sentence of the announcement after an import at the Reading List added one book to it: the library folder the book went to. %@ is the folder's path, such as Essays/Sea, or Library Root."
    },
    "The books are in %@." : {
      "comment" : "Second sentence of the announcement after an import at the Reading List added several books to it: the library folder they went to. %@ is the folder's path, such as Essays/Sea, or Library Root."
    },
    "The next article could not be downloaded, so playback stopped. %@" : {
      "comment" : "VoiceOver announcement when the download of a feed's next article failed. %@ is the download's own sentence saying why."
