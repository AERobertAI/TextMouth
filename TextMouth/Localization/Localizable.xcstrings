    "transcription.notAnAudiobook" : {
      "comment" : "Alert shown when Transcribe Audio is chosen for a book that is text, not audio. %@ is the book's title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ليس كتابًا صوتيًا؛ يمكن تفريغ الكتب الصوتية فقط."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ অডিওবুক নয়; শুধু অডিওবুক ট্রান্সক্রাইব করা যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ist kein Hörbuch; nur Hörbücher können transkribiert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ isn't an audiobook; only audiobooks can be transcribed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no es un audiolibro; solo se pueden transcribir audiolibros."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ کتاب صوتی نیست؛ فقط کتاب‌های صوتی را می‌توان رونویسی کرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ n’est pas un livre audio ; seuls les livres audio peuvent être transcrits."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ אינו ספר שמע; ניתן לתמלל ספרי שמע בלבד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ऑडियोबुक नहीं है; केवल ऑडियोबुक ट्रांसक्राइब की जा सकती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ bukan buku audio; hanya buku audio yang dapat ditranskripsikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il libro %@ non è un audiolibro: si possono trascrivere solo gli audiolibri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@はオーディオブックではないため、文字起こしできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@은(는) 오디오북이 아닙니다. 대본은 오디오북에 대해서만 만들 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ is geen luisterboek; alleen luisterboeken kunnen worden getranscribeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Książka %@ nie jest audiobookiem; transkrybować można tylko audiobooki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ não é um audiolivro; só audiolivros podem ser transcritos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%@» не аудиокнига: расшифровать можно только аудиокниги."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ är inte en ljudbok. Bara ljudböcker kan transkriberas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ไม่ใช่หนังสือเสียง ถอดเสียงได้เฉพาะหนังสือเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ sesli kitap değil; yalnızca sesli kitaplar yazıya dökülebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ не є аудіокнигою; транскрибувати можна лише аудіокниги."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ آڈیو بک نہیں ہے؛ صرف آڈیو بکس کو ٹرانسکرائب کیا جا سکتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ không phải sách nói; chỉ sách nói mới có thể được chép lời."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@”不是有声书；只有有声书可以转录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」不是有聲書；只有有聲書可以轉錄。"
          }
        }
      }
    },
    "transcription.offerHint" : {
      "comment" : "VoiceOver hint of the checkbox that offers transcribing after an import. Transcribe Audio is the command's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يسأل بعد استيراد كل كتاب صوتي عما إذا كان يجب تفريغه. عند الإيقاف، لا تُفرَّغ الكتب الصوتية إلا بالأمر “تفريغ الصوت”."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "প্রতিটি অডিওবুক আমদানির পর জিজ্ঞেস করে সেটি ট্রান্সক্রাইব করা হবে কি না। বন্ধ থাকলে অডিওবুক শুধু “অডিও ট্রান্সক্রাইব করুন” দিয়ে ট্রান্সক্রাইব হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fragt nach jedem Hörbuchimport, ob es transkribiert werden soll. Ist die Option aus, werden Hörbücher nur mit „Audio transkribieren“ transkribiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asks after each audiobook import whether to transcribe it. Off, audiobooks are transcribed only with Transcribe Audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pregunta tras cada importación de un audiolibro si quieres transcribirlo. Si está desactivado, los audiolibros solo se transcriben con Transcribir audio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پس از هر وارد کردن کتاب صوتی می‌پرسد که آیا رونویسی شود. وقتی خاموش است، کتاب‌های صوتی فقط با «رونویسی صدا» رونویسی می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Demande après chaque importation de livre audio s’il faut le transcrire. Si l’option est désactivée, les livres audio ne sont transcrits qu’avec Transcrire l’audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "שואל אחרי כל ייבוא של ספר שמע אם לתמלל אותו. כשכבוי, ספרי שמע מתומללים רק באמצעות “תמלל שמע”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "हर ऑडियोबुक आयात के बाद पूछता है कि उसे ट्रांसक्राइब करना है या नहीं। बंद होने पर, ऑडियोबुक केवल “ऑडियो ट्रांसक्राइब करें” से ट्रांसक्राइब होती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menanyakan setelah setiap impor buku audio apakah akan ditranskripsikan. Jika nonaktif, buku audio hanya ditranskripsikan dengan Transkripsikan Audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chiede dopo ogni importazione di un audiolibro se trascriverlo. Se è disattivato, gli audiolibri vengono trascritti solo con Trascrivi audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オーディオブックを読み込むたびに、文字起こしするかどうかを確認します。オフのときは、「オーディオを文字起こし」を選んだ場合にだけ文字起こしされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "오디오북을 가져올 때마다 대본을 만들지 묻습니다. 끄면 오디오 대본 만들기를 선택할 때만 대본을 만듭니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vraagt na elke import van een luisterboek of het moet worden getranscribeerd. Als dit uitstaat, worden luisterboeken alleen getranscribeerd met Transcribeer audio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Po każdym imporcie audiobooka pyta, czy go transkrybować. Gdy ta opcja jest wyłączona, audiobooki są transkrybowane tylko poleceniem Transkrybuj dźwięk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pergunta, após cada importação de audiolivro, se ele deve ser transcrito. Quando desativado, os audiolivros só são transcritos com Transcrever áudio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "После каждого импорта аудиокниги спрашивает, расшифровывать ли её. Если выключено, аудиокниги расшифровываются только командой «Расшифровать аудио»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Frågar efter varje import av en ljudbok om den ska transkriberas. När det här är avstängt transkriberas ljudböcker bara med Transkribera ljud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ถามหลังนำเข้าหนังสือเสียงแต่ละเล่มว่าจะถอดเสียงหรือไม่ เมื่อปิด จะถอดเสียงหนังสือเสียงเฉพาะเมื่อคุณเลือกคำสั่ง ถอดเสียงจากไฟล์เสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Her sesli kitap içe aktarıldıktan sonra yazıya dökülüp dökülmeyeceğini sorar. Kapalıysa sesli kitaplar yalnızca Sesi Yazıya Dök ile yazıya dökülür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Після кожного імпорту аудіокниги питає, чи транскрибувати її. Якщо вимкнено, аудіокниги транскрибуються лише командою «Транскрибувати аудіо»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ہر آڈیو بک درآمد کرنے کے بعد پوچھتا ہے کہ اسے ٹرانسکرائب کرنا ہے یا نہیں۔ آف ہو تو آڈیو بکس صرف “آڈیو ٹرانسکرائب کریں” سے ٹرانسکرائب ہوتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hỏi sau mỗi lần nhập sách nói xem có chép lời hay không. Khi tắt, sách nói chỉ được chép lời bằng lệnh Chép lời âm thanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "每次导入有声书后询问是否转录。关闭后，有声书仅通过“转录音频”转录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "每次輸入有聲書後詢問是否要轉錄。關閉時，只有使用「轉錄音訊」才會轉錄有聲書。"
          }
        }
      }
    },
