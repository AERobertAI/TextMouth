    "audioEditor.cutTooLongToPaste" : {
      "comment" : "Said by the audio editor's Paste when the audio cut was too long to keep for pasting.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "طويل جدًا بحيث لا يمكن الاحتفاظ به للصق. لنقله، الصق مباشرة بعد القص."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পেস্টের জন্য রাখতে খুব দীর্ঘ। সরাতে চাইলে কাটার ঠিক পরেই পেস্ট করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zu lang, um zum Einsetzen aufbewahrt zu werden. Um es zu verschieben, setze direkt nach dem Ausschneiden ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too long to keep for pasting. To move it, paste right after cutting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es demasiado larga para conservarla y pegarla. Para moverla, pega justo después de cortar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "برای نگه داشتن برای چسباندن بیش از حد طولانی است. برای انتقال آن، بلافاصله پس از برش بچسبانید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trop long pour être gardé en vue de le coller. Pour le déplacer, collez juste après avoir coupé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ארוך מדי לשמירה להדבקה. כדי להעביר אותו, הדבק מיד לאחר הגזירה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "यह इतना लंबा है कि पेस्ट के लिए रखा नहीं जा सकता। इसे ले जाने के लिए, काटने के तुरंत बाद पेस्ट करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Terlalu panjang untuk disimpan agar dapat ditempel. Untuk memindahkannya, tempel tepat setelah memotong."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Troppo lungo per essere conservato per Incolla. Per spostarlo, incolla subito dopo averlo tagliato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ペースト用に保持するには長すぎます。移動するには、カットの直後にペーストしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "붙여넣기용으로 보관하기에는 너무 깁니다. 이동하려면 잘라낸 직후에 붙여넣으십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Te lang om te bewaren voor plakken. Plak direct na het knippen om het te verplaatsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Za długie, aby zachować do wklejenia. Aby je przenieść, wklej zaraz po wycięciu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Longo demais para guardar para colar. Para movê-lo, cole logo depois de cortar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Фрагмент слишком длинный, чтобы хранить его для вставки. Чтобы переместить его, вставьте сразу после вырезания."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "För långt för att behållas för inklistring. Om du vill flytta det, klistra in direkt efter utklippningen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ยาวเกินไปที่จะเก็บไว้สำหรับวาง หากต้องการย้าย ให้วางทันทีหลังตัด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yapıştırmak için saklanamayacak kadar uzun. Taşımak için kestikten hemen sonra yapıştırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Завелике для збереження перед вставленням. Щоб перемістити, вставте одразу після вирізання."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "چسپاں کرنے کے لیے رکھنے کو بہت لمبا ہے۔ اسے منتقل کرنے کے لیے کاٹنے کے فوراً بعد چسپاں کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quá dài nên không thể giữ lại để dán. Để di chuyển, hãy dán ngay sau khi cắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "太长，无法保留以供粘贴。要移动它，请在剪切后立即粘贴。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "太長，無法保留以供貼上。若要移動它，請在剪下後立刻貼上。"
          }
        }
      }
    },
    "audioEditor.discardKept" : {
      "comment" : "Said when the audio editor's Discard can't reach the audio as it was saved: the edits stay.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحتوي صوت الكتاب على تعديلات فقدها سجلّها، لذا تبقى، لتحفظها أو تتراجع عنها في المرة التالية التي تحرّر فيها هذا الكتاب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইয়ের অডিওতে এমন সম্পাদনা আছে, যা সম্পাদনার ইতিহাসে আর নেই; তাই সেগুলো থেকে যায়, পরের বার এই বই সম্পাদনা করলে সংরক্ষণ বা পূর্বাবস্থায় ফেরানোর জন্য।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Audio des Buchs enthält Bearbeitungen, die sein Verlauf verloren hat; sie bleiben erhalten, damit du sie beim nächsten Bearbeiten dieses Buchs sicherst oder widerrufst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The book's audio holds edits its history lost, so they stay, to save or undo next time you edit this book."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El audio del libro contiene ediciones que su historial perdió, así que se quedan, para guardarlas o deshacerlas la próxima vez que edites este libro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صدای کتاب ویرایش‌هایی دارد که تاریخچه‌اش از دست داده است، پس می‌مانند تا دفعه بعد که این کتاب را ویرایش می‌کنید، ذخیره یا واگرد شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’audio du livre contient des modifications que son historique a perdues ; elles restent, pour être enregistrées ou annulées la prochaine fois que vous modifiez ce livre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "השמע של הספר כולל עריכות שההיסטוריה שלו איבדה, ולכן הן נשארות, כדי לשמור או לבטל אותן בפעם הבאה שתערוך את הספר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पुस्तक के ऑडियो में ऐसे संपादन हैं जिन्हें उसका इतिहास भूल गया, इसलिए वे रहते हैं; अगली बार इस पुस्तक को संपादित करने पर उन्हें सहेजें या पूर्ववत करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Audio buku memuat edit yang hilang dari riwayatnya, jadi edit itu tetap ada, untuk disimpan atau diurungkan saat Anda mengedit buku ini lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’audio del libro contiene modifiche che la sua cronologia ha perso, quindi restano, da salvare o annullare la prossima volta che modifichi questo libro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブックのオーディオには、履歴から失われた編集が含まれています。編集は残るので、次回このブックを編集するときに保存または取り消せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책의 오디오에 기록이 사라진 편집이 들어 있어 그대로 유지되며, 다음에 이 책을 편집할 때 저장하거나 취소할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De audio van het boek bevat bewerkingen die de geschiedenis kwijt is, dus ze blijven staan, om te bewaren of ongedaan te maken de volgende keer dat je dit boek wijzigt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dźwięk książki zawiera edycje, których historia została utracona, więc pozostają, aby je zachować lub cofnąć przy następnej edycji tej książki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O áudio do livro contém edições que o histórico perdeu, então elas permanecem, para salvar ou desfazer na próxima vez que você editar este livro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Аудио книги содержит правки, которых нет в истории, поэтому они остаются: их можно сохранить или отменить при следующем изменении этой книги."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bokens ljud innehåller redigeringar som historiken tappade, så de ligger kvar, för att sparas eller ångras nästa gång du redigerar den här boken."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เสียงของหนังสือมีการแก้ไขที่ประวัติสูญหาย จึงคงไว้ เพื่อบันทึกหรือเลิกทำเมื่อแก้ไขหนังสือเล่มนี้ครั้งหน้า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitabın sesinde geçmişinin kaybettiği düzenlemeler var; bu yüzden kalıyorlar ve bu kitabı bir sonraki düzenlediğinizde kaydedebilir veya geri alabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Аудіо книги містить правки, яких немає в історії, тому вони залишаються, щоб ви зберегли або скасували їх наступного разу, коли редагуватимете цю книгу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب کے آڈیو میں ایسی ترامیم ہیں جو اس کی سرگزشت سے کھو گئیں، اس لیے وہ رہتی ہیں، تاکہ اس کتاب میں اگلی بار ترمیم کرتے وقت انہیں محفوظ یا کالعدم کیا جا سکے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Âm thanh của sách có các chỉnh sửa mà lịch sử của nó đã mất, nên chúng vẫn được giữ, để lưu hoặc hoàn tác lần sau khi bạn sửa sách này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "图书的音频中有其历史记录已丢失的编辑，因此它们会保留，供你下次编辑此图书时存储或撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "這本書的音訊中有歷史紀錄已遺失的編輯，因此會保留，讓你在下次編輯這本書時儲存或還原。"
          }
        }
      }
    },
    "audioEditor.diskTooFullToKeepClip" : {
      "comment" : "Said when the disk is too full to keep the audio cut or copied in the audio editor for Paste.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "القرص ممتلئ جدًا بحيث لا يمكن الاحتفاظ بهذا الصوت للصق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পেস্টের জন্য এই অডিও রাখার মতো ডিস্কে জায়গা নেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Speicherplatz reicht nicht, um dieses Audio zum Einsetzen aufzubewahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The disk is too full to keep this audio for pasting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El disco está demasiado lleno para conservar este audio y pegarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "دیسک برای نگه داشتن این صدا برای چسباندن بیش از حد پر است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le disque est trop plein pour garder cet audio en vue de le coller."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הדיסק מלא מדי כדי לשמור את השמע הזה להדבקה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "डिस्क इतनी भरी है कि इस ऑडियो को पेस्ट के लिए रखा नहीं जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disk terlalu penuh untuk menyimpan audio ini agar dapat ditempel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il disco è troppo pieno per conservare questo audio per Incolla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ディスクがいっぱいで、ペースト用にこのオーディオを保持できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
