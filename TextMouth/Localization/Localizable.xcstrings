          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hij verschijnt opnieuw als het probleem terugkomt nadat het is verdwenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pojawi się ponownie, jeśli problem wróci po ustąpieniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
