    "substitutions.replacementHint" : {
      "comment" : "VoiceOver hint of the replacement field in the substitution rule editor. $1 and $2 are written as in regular expressions and stay as written.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "في التعبير النمطي، تُعيد علامة الدولار مع رقم المجموعة، مثل $1 أو $2، النص الذي طابقته تلك المجموعة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "রেগুলার এক্সপ্রেশনে ডলার চিহ্ন ও গ্রুপের নম্বর, যেমন $1 বা $2, সেই গ্রুপ যা মিলেছিল তা ফিরিয়ে আনে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "In einem regulären Ausdruck setzen ein Dollarzeichen und die Nummer einer Gruppe, wie in $1 oder $2, wieder ein, was diese Gruppe gefunden hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a regular expression, a dollar sign and a group's number, as in $1 or $2, put back what that group matched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En una expresión regular, un signo de dólar seguido del número de un grupo, como $1 o $2, repone lo que ese grupo encontró."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "در یک عبارت منظم، علامت دلار و شماره یک گروه، مانند $1 یا $2، آنچه را که آن گروه تطبیق داده بود برمی‌گرداند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dans une expression régulière, un signe dollar et le numéro d’un groupe, comme $1 ou $2, rétablissent le texte trouvé par ce groupe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בביטוי רגולרי, סימן דולר ומספר קבוצה, כמו $1 או $2, מחזירים את מה שהקבוצה התאימה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "रेगुलर एक्सप्रेशन में, डॉलर चिह्न और किसी समूह की संख्या, जैसे $1 या $2, उस समूह से मिले टेक्स्ट को वापस रखते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dalam ekspresi reguler, tanda dolar dan nomor grup, seperti $1 atau $2, memasukkan kembali apa yang dicocokkan grup itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "In un’espressione regolare, il simbolo del dollaro seguito dal numero di un gruppo, come $1 o $2, reinserisce il testo trovato da quel gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "正規表現では、ドル記号とグループの番号（$1 や $2 など）は、そのグループに一致した内容に置き換わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "정규식에서 달러 기호와 그룹 번호(예: $1 또는 $2)는 해당 그룹이 일치한 내용을 다시 넣습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "In een reguliere expressie zet een dollarteken met het nummer van een groep, zoals $1 of $2, terug wat die groep heeft gevonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "W wyrażeniu regularnym znak dolara i numer grupy, jak $1 lub $2, przywracają tekst dopasowany przez tę grupę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Em uma expressão regular, um cifrão seguido do número de um grupo, como $1 ou $2, recoloca o que esse grupo encontrou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В регулярном выражении знак доллара и номер группы, как в $1 или $2, возвращают то, что совпало с этой группой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I ett reguljärt uttryck sätter ett dollartecken och en grupps nummer, som $1 eller $2, tillbaka det som gruppen matchade."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ในนิพจน์ทั่วไป เครื่องหมายดอลลาร์ตามด้วยหมายเลขกลุ่ม เช่น $1 หรือ $2 จะใส่ข้อความที่กลุ่มนั้นจับคู่ไว้กลับเข้ามา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Düzenli ifadede, dolar işareti ve bir grubun numarası ($1 veya $2 gibi), o grubun eşleştirdiğini geri koyar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "У регулярному виразі знак долара й номер групи, як-от $1 або $2, підставляють те, що відповідало цій групі."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ریگولر ایکسپریشن میں ڈالر کا نشان اور کسی گروپ کا نمبر، جیسے $1 یا $2، اس گروپ سے مماثل متن کو واپس رکھ دیتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trong biểu thức chính quy, dấu đô la và số của một nhóm, như $1 hoặc $2, sẽ chèn lại phần mà nhóm đó đã khớp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在正则表达式中，美元符号加分组编号（如 $1 或 $2）会放回该分组所匹配的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在正規表示式中，美元符號加上群組編號（如 $1 或 $2）會放回該群組所符合的內容。"
          }
        }
      }
    },
    "substitutions.replacementLabel" : {
      "comment" : "VoiceOver label of the replacement field in the substitution rule editor.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نص الاستبدال. اتركه فارغًا لتخطي النص المطابق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "প্রতিস্থাপনের টেক্সট। মিলে যাওয়া টেক্সট এড়াতে খালি রাখুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ersetzungstext. Leer lassen, um gefundenen Text zu überspringen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replacement text. Leave empty to skip matched text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texto de reemplazo. Déjalo vacío para omitir el texto encontrado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "متن جایگزین. برای صرف‌نظر از متن تطبیق‌یافته، خالی بگذارید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texte de remplacement. Laissez vide pour ignorer le texte trouvé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "טקסט ההחלפה. השאר ריק כדי לדלג על טקסט שהותאם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "प्रतिस्थापन टेक्स्ट। मिले टेक्स्ट को छोड़ने के लिए खाली रखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Teks pengganti. Kosongkan untuk melewati teks yang cocok."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Testo di sostituzione. Lascia vuoto per ignorare il testo trovato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "置換後のテキスト。空にすると一致したテキストをスキップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "대체 텍스트입니다. 비워 두면 일치한 텍스트를 건너뜁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vervangende tekst. Laat leeg om de gevonden tekst over te slaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tekst zamiennika. Pozostaw puste, aby pominąć dopasowany tekst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texto de substituição. Deixe vazio para omitir o texto encontrado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Текст замены. Оставьте пустым, чтобы пропустить найденный текст."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ersättningstext. Lämna tomt för att hoppa över matchad text."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ข้อความแทนที่ เว้นว่างไว้เพื่อข้ามข้อความที่จับคู่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yerine konacak metin. Eşleşen metni atlamak için boş bırakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Текст заміни. Залиште порожнім, щоб пропустити знайдений текст."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "متبادل متن۔ مماثل متن چھوڑنے کے لیے خالی رکھیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Văn bản thay thế. Để trống để bỏ qua văn bản khớp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "替换文本。留空则跳过匹配的文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "取代文字。留空則略過符合的文字。"
          }
        }
      }
    },
