        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A transcrição está apenas na nuvem. Os detalhes aparecem depois que o livro é baixado."
          }
        }
      }
    },
    "The transcript of %@ can't be read. If the book is only in the cloud, download it and try again." : {
      "comment" : "Alert shown when Clean Up Transcript is chosen for an audiobook whose transcript cannot be read. %@ is the audiobook's title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript von %@ kann nicht gelesen werden. Wenn das Buch nur in der Cloud ist, lade es herunter und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se puede leer la transcripción de %@. Si el libro solo está en la nube, descárgalo y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcription de %@ ne peut pas être lue. Si le livre est seulement dans le cloud, téléchargez-le et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile leggere la trascrizione di %@. Se il libro è solo nel cloud, scaricalo e riprova."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não foi possível ler a transcrição de %@. Se o livro está apenas na nuvem, baixe-o e tente novamente."
          }
        }
      }
    },
    "The transcript runs to %@, past the audio's end at %@, so it is for other audio." : {
      "comment" : "Error shown when an attached transcript file's times run past the end of the book's audio. %1$@ is where the transcript ends and %2$@ where the audio ends, each a length of time in words such as \"1 hour, 2 minutes, 5 seconds\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript reicht bis %1$@, über das Ende des Audios bei %2$@ hinaus, gehört also zu anderem Audio."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The transcript runs to %1$@, past the audio's end at %2$@, so it is for other audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcripción llega hasta %1$@, más allá del final del audio en %2$@, así que es de otro audio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcription va jusqu’à %1$@, au-delà de la fin de l’audio à %2$@, donc elle correspond à un autre audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La trascrizione arriva a %1$@, oltre la fine dell’audio a %2$@, quindi è per un altro audio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A transcrição vai até %1$@, além do fim do áudio em %2$@, então é de outro áudio."
          }
        }
      }
    },
    "The transcript's files could not be examined once they were written." : {
      "comment" : "Error shown when TextMouth could not check the audio files after writing a transcript for them.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Dateien des Transkripts konnten nach dem Schreiben nicht geprüft werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudieron examinar los archivos de la transcripción una vez escritos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les fichiers de la transcription n’ont pas pu être examinés après leur écriture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile esaminare i file della trascrizione dopo averli scritti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não foi possível examinar os arquivos da transcrição depois de gravados."
          }
        }
      }
    },
    "The transcript's text as %@, made from its Markdown." : {
      "comment" : "The hint of the Transcript checkbox in the Export dialog while its text is written by a text writer. %@ is the writer's name, such as HTML or RTF.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Text des Transkripts als %@, erstellt aus seinem Markdown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto de la transcripción como %@, creado a partir de su Markdown."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le texte de la transcription en %@, créé à partir de son Markdown."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo della trascrizione come %@, ricavato dal suo Markdown."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O texto da transcrição como %@, feito a partir do Markdown dela."
          }
        }
      }
    },
    "The transcript's text didn't read back as one chapter per chapter of the book." : {
      "comment" : "Error shown when the text written from a transcript did not have one chapter for each chapter of the audiobook.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Text des Transkripts ergab beim Zurücklesen nicht ein Kapitel pro Kapitel des Buchs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto de la transcripción no se leyó de vuelta como un capítulo por cada capítulo del libro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le texte de la transcription ne se relit pas comme un chapitre pour chaque chapitre du livre."
          }
        },
        "it" : {
          "stringUnit" : {
