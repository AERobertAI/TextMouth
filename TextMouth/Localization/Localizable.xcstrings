      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ينتمي إلى موجزه ما دام منزَّلًا. %@ يزيل ملفه ويحتفظ بموضعه وإشاراته المرجعية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ডাউনলোড থাকা অবস্থায় এটি তার ফিডের অংশ। %@ বেছে নিলে এর ফাইল সরানো হয়, আর এর অবস্থান ও বুকমার্ক থেকে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es gehört zu seinem Feed, solange es heruntergeladen ist. %@ entfernt die Datei und behält die Stelle und die Lesezeichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It belongs to its feed while it is downloaded. %@ removes its file and keeps its place and bookmarks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pertenece a su canal mientras está descargado. %@ quita su archivo y conserva su lugar y sus marcadores."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تا وقتی بارگیری شده است، به فید خود تعلق دارد. %@ فایل آن را برمی‌دارد و جایگاه و نشانک‌هایش را نگه می‌دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il appartient à son flux tant qu’il est téléchargé. %@ retire son fichier et conserve sa position et ses signets."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הוא שייך לערוץ שלו כל עוד ההורדה שלו קיימת. “%@” מסיר את הקובץ שלו ושומר את מיקום הקריאה ואת הסימניות שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "जब तक वह डाउनलोड है, वह अपने फ़ीड का हिस्सा है। “%@” उसकी फ़ाइल हटाता है और उसका स्थान तथा बुकमार्क रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ini milik feed-nya selama masih berupa unduhan. %@ membuang file-nya dan mempertahankan posisi serta markahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Appartiene al suo feed finché è scaricato. Il comando %@ rimuove il suo file e conserva il punto di lettura e i segnalibri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ダウンロードされている間は、フィードに属します。「%@」を選択すると、ファイルは取り除かれ、位置とブックマークは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "다운로드되어 있는 동안에는 피드에 속해 있습니다. %@은(는) 파일을 제거하고 위치와 북마크는 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Het hoort bij de feed zolang het is gedownload. %@ verwijdert het bestand en bewaart de plek en de bladwijzers."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dopóki jest pobrana, należy do swojego kanału. %@ usuwa jej plik i zachowuje miejsce oraz zakładki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ele pertence ao feed enquanto está baixado. %@ remove o arquivo dele e mantém a posição e os marcadores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Пока книга загружена, она принадлежит своей ленте. %@ удаляет её файл и сохраняет позицию чтения и закладки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Den tillhör sitt flöde medan den är hämtad. %@ tar bort dess fil men behåller dess läsposition och bokmärken."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "รายการนี้เป็นของฟีดตราบใดที่ยังดาวน์โหลดไว้ คำสั่ง %@ จะนำไฟล์ออกโดยเก็บตำแหน่งและที่คั่นหน้าไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "İndirilmiş olduğu sürece beslemesine aittir. %@ komutu, dosyasını kaldırır ama yerini ve yer imlerini saklar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вона належить своїй стрічці, поки її завантажено. «%@» вилучає її файл і зберігає місце та закладки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جب تک یہ ڈاؤن لوڈ شدہ ہے، یہ اپنی فیڈ سے تعلق رکھتی ہے۔ %@ اس کی فائل ہٹاتا ہے اور اس کی جگہ اور بک مارکس رکھتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nó thuộc về nguồn cấp của nó khi đã được tải về. %@ gỡ tệp của nó và giữ lại vị trí đọc cùng các dấu trang."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "它作为下载内容属于其订阅源。“%@”会移除其文件，但保留其位置和书签。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "它作為下載項目，屬於其訂閱源。「%@」會移除其檔案，並保留其位置與書籤。"
          }
        }
      }
    },
