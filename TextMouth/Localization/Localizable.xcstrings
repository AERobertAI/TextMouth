    "storageWorkWait.sentence.betweenFolders" : {
      "comment" : "Why a failed save waits: it runs when books have been moved between folders. \"Them\" is the changes that could not be saved.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحفظها TextMouth بعد انتهاء نقل الكتب بين المجلدات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফোল্ডারগুলোর মধ্যে বই সরানো শেষ হলে TextMouth সেগুলো সংরক্ষণ করবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth sichert sie, sobald es das Verschieben von Büchern zwischen Ordnern beendet hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth saves them once it has finished moving books between folders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth los guarda cuando termine de mover libros entre carpetas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth پس از پایان انتقال کتاب‌ها بین پوشه‌ها، آن‌ها را ذخیره می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth les enregistre dès qu’il a fini de déplacer des livres entre des dossiers."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth שומר אותם כשיסיים להעביר ספרים בין תיקיות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पुस्तकों को फ़ोल्डरों के बीच ले जाना पूरा करने के बाद TextMouth उन्हें सहेजता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth menyimpannya setelah selesai memindahkan buku antar folder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth le salva quando ha finito di spostare i libri tra le cartelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フォルダ間のブックの移動が終わったら、TextMouth はそれらを保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
