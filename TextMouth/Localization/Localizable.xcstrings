    "libraryComparison.sentence.record" : {
      "comment" : "Last clause of a sentence about an unread file in Compare Libraries: the consequence for a book's record, after a comma.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لذا أُخذ موضعه وإشاراته المرجعية هناك من فهرس المكتبة وحده."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "তাই সেখানে এর অবস্থান ও বুকমার্ক শুধু লাইব্রেরি সূচক থেকে নেওয়া হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "daher wurden seine Position und seine Lesezeichen dort allein aus dem Bibliotheksindex übernommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "so its place and bookmarks there were taken from the library index alone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "así que su lugar y sus marcadores allí se tomaron solo del índice de la biblioteca."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بنابراین مکان و نشانک‌های آن در آنجا فقط از نمایه‌ی کتابخانه گرفته شد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "donc sa position et ses signets ont été tirés du seul index de la bibliothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ולכן המקום והסימניות שלו שם נלקחו מאינדקס הספרייה בלבד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसलिए वहाँ इसका स्थान और बुकमार्क केवल लाइब्रेरी इंडेक्स से लिए गए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "sehingga posisi dan markahnya di sana hanya diambil dari indeks pustaka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "quindi la sua posizione e i segnalibri sono stati presi solo dall’indice della libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "そのため、そこでの位置とブックマークはライブラリインデックスのみから取得しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "그래서 해당 위치와 북마크는 보관함 색인만으로 가져왔습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "dus de leespositie en bladwijzers daar zijn alleen uit de bibliotheekindex gehaald."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "więc pozycję czytania i zakładki w tej książce pobrano wyłącznie z indeksu biblioteki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "então a posição e os marcadores do livro ali foram tirados apenas do índice da biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "поэтому позиция чтения и закладки там взяты только из индекса библиотеки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "så dess plats och bokmärken där hämtades enbart från biblioteksindexet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "จึงนำตำแหน่งและที่คั่นหน้าของหนังสือในนั้นมาจากดัชนีไลบรารีเพียงอย่างเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "bu yüzden oradaki yeri ve yer imleri yalnızca kitaplık dizininden alındı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "тому позицію та закладки цієї книги там узято лише з індексу бібліотеки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس لیے وہاں اس کا مقام اور بک مارکس صرف لائبریری انڈیکس سے لیے گئے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "nên vị trí và dấu trang của nó ở đó chỉ được lấy từ chỉ mục thư viện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "因此那里的位置和书签仅取自资料库索引。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "因此其位置和書籤是僅從書庫索引取得的。"
          }
        }
      }
    },
