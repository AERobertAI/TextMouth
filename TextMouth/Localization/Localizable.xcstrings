    "settings.punctuationLevelsExplanation" : {
      "comment" : "Explanation under the punctuation pause level slider in the Playback settings. %1$@ to %4$@ are the names of levels 0 to 3, as the slider speaks them: Off, Subtle, Moderate, and Heavy. The words in parentheses say what pauses at that level.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "0 = %@، 1 = %@ (نقاط)، 2 = %@ (+ فواصل)، 3 = %@ (+ فواصل الفقرات)"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "0 = %1$@, 1 = %2$@ (দাঁড়ি), 2 = %3$@ (+ কমা), 3 = %4$@ (+ অনুচ্ছেদ বিরতি)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "0 = %1$@, 1 = %2$@ (Punkte), 2 = %3$@ (+ Kommas), 3 = %4$@ (+ Absatzumbrüche)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 = %@, 1 = %@ (periods), 2 = %@ (+ commas), 3 = %@ (+ paragraph breaks)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "0 = %1$@, 1 = %2$@ (puntos), 2 = %3$@ (+ comas), 3 = %4$@ (+ saltos de párrafo)"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "0 = %1$@، 1 = %2$@ (نقطه‌ها)، 2 = %3$@ (+ ویرگول‌ها)، 3 = %4$@ (+ شکست پاراگراف‌ها)"
          }
        },
