    },
    "Two different keys, not a double press." : {
      "comment" : "Announced by VoiceOver at the end of a trial of the double press time when the two presses were of different keys.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مفتاحان مختلفان، وليست ضغطة مزدوجة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zwei verschiedene Tasten, kein Doppeldruck."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dos teclas distintas, no una doble pulsación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deux touches différentes, pas un double appui."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "दो अलग-अलग कुंजियाँ, दो बार दबाना नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dua tombol berbeda, bukan tekan ganda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Due tasti diversi, non una doppia pressione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "異なる2つのキーで、ダブルプレスではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "서로 다른 두 키이며 두 번 누르기가 아닙니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Duas teclas diferentes, não um pressionamento duplo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Две разные клавиши, а не двойное нажатие."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Дві різні клавіші, а не подвійне натискання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "两个不同的键，不是连按两次。"
          }
        }
      }
    },
    "Two presses, %@ apart. Set the time above %@ to count them as one." : {
      "comment" : "Announced by VoiceOver at the end of a trial of the double press time when the two presses were too far apart for the time set. Both %1$@ and %2$@ are the time between the presses, such as \"0.7 seconds\"; the listener should set the double press time above it.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ضغطتان بينهما %1$@. اضبط المهلة على أكثر من %2$@ لتُحسبا ضغطة واحدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zwei Tastendrücke im Abstand von %1$@. Stelle die Zeit höher als %2$@ ein, damit sie als einer zählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Two presses, %1$@ apart. Set the time above %2$@ to count them as one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dos pulsaciones, separadas por %1$@. Sube el tiempo por encima de %2$@ para contarlas como una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deux appuis, espacés de %@. Réglez le délai au-dessus de %@ pour les compter comme un seul."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "दो बार दबाया गया, बीच में %1$@ का अंतर। उन्हें एक गिनने के लिए समय को %2$@ से अधिक पर सेट करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dua penekanan, berjarak %1$@. Setel waktu di atas %2$@ agar dihitung sebagai satu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Due pressioni a distanza di %@. Imposta un tempo superiore a %@ per contarle come una sola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "2回の押下の間隔は%1$@でした。2回を1回と数えるには、時間を%2$@より長くしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "두 번 누른 간격은 %1$@입니다. 한 번으로 인식하려면 시간을 %2$@보다 크게 설정하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dois pressionamentos, com %1$@ de intervalo. Defina o tempo acima de %2$@ para contá-los como um só."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Два нажатия с интервалом %1$@. Установите время больше, чем %2$@, чтобы считать их двойным нажатием."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Два натискання з інтервалом %1$@. Встановіть час понад %2$@, щоб зарахувати їх як подвійне натискання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
