        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ان شرائط اور ترتیب کے ساتھ اپنا منظر بناتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tạo chế độ xem của riêng bạn với các điều kiện và cách sắp xếp này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "用这些条件和排序创建你自己的视图。"
