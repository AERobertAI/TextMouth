    "Pitch: %@" : {
      "comment" : "Caption above the voice sheet's pitch slider. %@ is the pitch, such as 1.0x."
    },
    "Plain Text" : {
      "comment" : "Name of the book format of a plain text file (.txt), shown in a book's information, the format column, and the duplicate finder."
    },
    "Plain http: others can read or change what this feed sends." : {
      "comment" : "The note in Feed Info about a feed whose address uses plain http, which is not encrypted. Plain http is a term; keep it."
    },
    "Play" : {
      "comment" : "Label of the button that starts playing the book.\nLabel of the reader's play and pause button while the book is not playing; it plays."
    },
    "Play / Pause" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Playback group and read by VoiceOver. Starts or pauses reading aloud or playing the book. Also the title of the menu command of the same name.\nName of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Starts or pauses playback in the audio editor."
    },
    "Play Selection" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Plays only the selection."
    },
    "Play half a second after each move" : {
      "comment" : "Label of the switch in Storage settings (Audio Editing) that makes the audio editor play half a second at the cursor after each move."
    },
    "Play the book above" : {
      "comment" : "A choice of the Reading List's When a book ends pop-up button: when a book opened from the list ends, play the book above it in the list.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproducir el libro de arriba"
