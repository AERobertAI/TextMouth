          }
        }
      }
    },
    "The transcript, with its text as Markdown for an audiobook." : {
      "comment" : "The hint of the Transcript checkbox in the Export dialog.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript, mit seinem Text als Markdown für ein Hörbuch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcripción, con su texto como Markdown para un audiolibro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcription, avec son texte en Markdown pour un livre audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
