    "Applies only to a view that lists episodes or articles." : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. Its hint while the view lists no episodes or articles, when it is dimmed (review of October 31, 2026, finding 6).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ينطبق فقط على عرض يسرد حلقات أو مقالات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gilt nur für eine Ansicht, die Folgen oder Artikel auflistet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se aplica solo a una vista que muestra episodios o artículos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "S’applique seulement à une vue qui liste des épisodes ou des articles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "केवल उस दृश्य पर लागू होता है जो एपिसोड या लेख सूचीबद्ध करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hanya berlaku untuk tampilan yang mencantumkan episode atau artikel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si applica solo a una vista che elenca episodi o articoli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "エピソードまたは記事を表示するビューにのみ適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "에피소드나 기사를 나열하는 보기에만 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
