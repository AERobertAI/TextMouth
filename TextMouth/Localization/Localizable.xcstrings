    "feedDownloadProgress.cancelled.other" : {
      "comment" : "Announced as Cancel stops several feed downloads. %lld is how many, the rule's waiting downloads among them.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "تم إيقاف %lld تنزيلات للموجزات."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "تم إيقاف %lld تنزيلًا للموجزات."
                }
              },
              "one" : {
                "stringUnit" : {
