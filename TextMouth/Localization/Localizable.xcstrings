    "feedThreshold.deleteAfterPlaying.finishes" : {
      "comment" : "VoiceOver hint of the delete-after-playing number field and stepper. The range is the limits of the number, in days.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عدد الأيام بعد انتهاء الحلقة قبل حذف تنزيلها، من 0 (فورًا) إلى 365؛ والحلقة المفتوحة في القارئ تنتظر حتى تُغلق"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "একটি পর্ব শেষ হওয়ার পর এর ডাউনলোড মোছার আগে দিনের সংখ্যা, 0 (এখনই) থেকে 365; রিডারে খোলা থাকলে বন্ধ হওয়া পর্যন্ত অপেক্ষা করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tage nach Ende einer Folge bis zum Löschen ihres Downloads, von 0 (sofort) bis 365; ein in einer Leseansicht geöffneter Download wartet, bis sie geschlossen wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Days after an episode finishes before its download is deleted, from 0 (at once) to 365; one open in a reader waits until it closes"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Días que pasan después de que termina un episodio antes de eliminar su descarga, de 0 (de inmediato) a 365; uno abierto en un lector espera hasta que se cierre"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعداد روزها پس از پایان یک قسمت تا حذف بارگیری آن، از 0 (بلافاصله) تا 365؛ قسمتی که در کتاب‌خوان باز است تا بسته شدن آن منتظر می‌ماند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nombre de jours après la fin d’un épisode avant la suppression de son téléchargement, de 0 (immédiatement) à 365 ; un épisode ouvert dans un lecteur attend sa fermeture."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מספר הימים שאחרי סיום אפיזודה עד למחיקת ההורדה שלה, מ-0 (מיד) עד 365; אפיזודה הפתוחה בקורא ממתינה עד לסגירתה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "एपिसोड समाप्त होने के बाद उसका डाउनलोड मिटाने से पहले के दिन, 0 (तुरंत) से 365 तक; रीडर में खुला डाउनलोड उसके बंद होने तक रुकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jumlah hari setelah episode selesai sebelum unduhannya dihapus, dari 0 (langsung) hingga 365; unduhan yang terbuka di pembaca menunggu hingga ditutup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Giorni dopo la fine di un episodio prima che il suo download venga eliminato, da 0 (subito) a 365; se è aperto in un lettore, attende che venga chiuso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "エピソードの再生が終わってからダウンロードを削除するまでの日数で、0（すぐに削除）から365までです。リーダで開いているものは、閉じるまで待ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "에피소드 재생이 끝난 후 다운로드를 삭제하기까지의 일수(0은 즉시, 최대 365). 리더에서 열려 있으면 닫힐 때까지 기다립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aantal dagen na het einde van een aflevering voordat de download wordt verwijderd, van 0 (meteen) tot 365; een download die in een lezer openstaat, wacht tot die wordt gesloten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Liczba dni po zakończeniu odcinka, po których jego pobrany plik jest usuwany, od 0 (od razu) do 365; plik otwarty w czytniku czeka do zamknięcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dias após o fim de um episódio antes de o download ser excluído, de 0 (imediatamente) a 365; um aberto em um leitor espera até ser fechado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Число дней после окончания выпуска до удаления его загрузки, от 0 (сразу) до 365; загрузка, открытая в окне чтения, ждёт, пока окно закроется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Antal dagar efter att ett avsnitt har spelats klart innan dess nedladdning raderas, från 0 (direkt) till 365; en som är öppen i en läsare väntar tills den stängs."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "จำนวนวันหลังตอนเล่นจบก่อนลบการดาวน์โหลด ตั้งแต่ 0 (ทันที) ถึง 365 ตอนที่เปิดอยู่ในตัวอ่านจะรอจนกว่าจะปิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bir podcast bölümü bittikten sonra indirmesinin silineceği gün sayısı, 0 (hemen) ile 365 arası; bir okuyucuda açık olan, kapanana kadar bekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Кількість днів після завершення епізоду до видалення його завантаження, від 0 (одразу) до 365; завантаження, відкрите у вікні читання, чекає, доки його закриють."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ایپی سوڈ ختم ہونے کے بعد اس کا ڈاؤن لوڈ حذف ہونے سے پہلے کے دن، 0 (فوراً) سے 365 تک؛ ریڈر میں کھلا ہوا ڈاؤن لوڈ اس کے بند ہونے تک انتظار کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Số ngày sau khi một tập phát xong thì bản tải về của nó bị xóa, từ 0 (ngay lập tức) đến 365; tập đang mở trong trình đọc sẽ chờ đến khi đóng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "单集播放完毕后，隔多少天删除其下载内容，范围为 0（立即）到 365；在阅读器中打开的内容会等到关闭后再删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "單集播放完畢後，刪除其下載項目前等待的天數，從 0（立即）到 365；在閱讀器中打開的單集會等到關閉後才刪除。"
          }
        }
      }
    },
