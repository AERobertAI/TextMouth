        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O diretório de podcasts recusou a busca; ele permite cerca de 20 por minuto. Aguarde um minuto e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Каталог подкастов отклонил поиск: он допускает около 20 запросов в минуту. Подождите минуту и повторите попытку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Каталог подкастів відхилив пошук: він дозволяє близько 20 на хвилину. Зачекайте хвилину й спробуйте знову."
