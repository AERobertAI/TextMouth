    "readingList.editBarHint.add" : {
      "comment" : "VoiceOver hint of the Library's edit-mode bar button Add to Reading List.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يضيف الكتب المحددة إلى نهاية قائمة القراءة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "নির্বাচিত বইগুলো পড়ার তালিকার শেষে যোগ করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fügt die ausgewählten Bücher am Ende der Leseliste hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds the selected books to the end of the reading list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Agrega los libros seleccionados al final de la lista de lectura."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب‌های انتخاب‌شده را به انتهای فهرست مطالعه اضافه می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ajoute les livres sélectionnés à la fin de la liste de lecture."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מוסיף את הספרים שנבחרו לסוף רשימת הקריאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चुनी हुई पुस्तकों को रीडिंग लिस्ट के अंत में जोड़ता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menambahkan buku yang dipilih ke akhir daftar bacaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aggiunge i libri selezionati alla fine dell’elenco di lettura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選択したブックをリーディングリストの末尾に追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "선택한 책을 읽기 목록의 끝에 추가합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voegt de geselecteerde boeken toe aan het einde van de leeslijst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dodaje zaznaczone książki na koniec listy czytelniczej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Adiciona os livros selecionados ao fim da lista de leitura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Добавляет выбранные книги в конец списка для чтения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lägger till de markerade böckerna sist i läslistan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เพิ่มหนังสือที่เลือกไว้ที่ท้ายรายการอ่าน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Seçili kitapları okuma listesinin sonuna ekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Додає вибрані книги в кінець списку читання."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "منتخب کتابوں کو مطالعے کی فہرست کے اختتام میں شامل کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thêm các sách đã chọn vào cuối danh sách đọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "将所选图书添加到阅读列表末尾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "將所選書籍加入閱讀列表的末尾。"
          }
        }
      }
    },
    "readingList.editBarHint.remove" : {
      "comment" : "VoiceOver hint of the Library's edit-mode bar button Remove from Reading List.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يزيل الكتب المحددة من قائمة القراءة. تبقى في المكتبة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "নির্বাচিত বইগুলো পড়ার তালিকা থেকে সরায়। সেগুলো লাইব্রেরিতে থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Entfernt die ausgewählten Bücher aus der Leseliste. Sie bleiben in der Bibliothek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takes the selected books off the reading list. They stay in the library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quita los libros seleccionados de la lista de lectura. Siguen en la biblioteca."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب‌های انتخاب‌شده را از فهرست مطالعه برمی‌دارد. آن‌ها در کتابخانه می‌مانند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Retire les livres sélectionnés de la liste de lecture. Ils restent dans la bibliothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מסיר את הספרים שנבחרו מרשימת הקריאה. הם נשארים בספרייה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चुनी हुई पुस्तकों को रीडिंग लिस्ट से हटाता है। वे लाइब्रेरी में बनी रहती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuang buku yang dipilih dari daftar bacaan. Buku tetap ada di pustaka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toglie i libri selezionati dall’elenco di lettura. Restano nella libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選択したブックをリーディングリストから取り除きます。ライブラリには残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "선택한 책을 읽기 목록에서 제거합니다. 책은 보관함에 그대로 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Haalt de geselecteerde boeken van de leeslijst. Ze blijven in de bibliotheek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usuwa zaznaczone książki z listy czytelniczej. Zostają w bibliotece."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tira os livros selecionados da lista de leitura. Eles permanecem na biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Убирает выбранные книги из списка для чтения. В библиотеке они остаются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tar bort de markerade böckerna från läslistan. De finns kvar i biblioteket."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "นำหนังสือที่เลือกไว้ออกจากรายการอ่าน หนังสือจะยังอยู่ในไลบรารี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Seçili kitapları okuma listesinden kaldırır. Kitaplıkta kalırlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вилучає вибрані книги зі списку читання. Вони залишаються в бібліотеці."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "منتخب کتابوں کو مطالعے کی فہرست سے ہٹاتا ہے۔ وہ لائبریری میں رہتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gỡ các sách đã chọn khỏi danh sách đọc. Các sách vẫn ở trong thư viện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "将所选图书从阅读列表移除。它们仍保留在资料库中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "將所選的書從閱讀列表中移除。它們仍保留在書庫中。"
          }
        }
      }
    },
