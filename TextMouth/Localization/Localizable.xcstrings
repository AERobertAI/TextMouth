    "shortcutsSettings.resetAllAlertMessage" : {
      "comment" : "Message of the alert that asks the listener to confirm resetting every keyboard shortcut to its default: the shortcuts they changed are lost.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعود كل الاختصارات والأماكن التي تعمل فيها إلى الإعدادات الافتراضية. وتُفقد مفاتيحك الخاصة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সব শর্টকাট এবং সেগুলো যেখানে কাজ করে তা ডিফল্টে ফিরে যাবে। আপনার নিজের দেওয়া কীগুলো হারিয়ে যাবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alle Kurzbefehle und ihr Geltungsbereich werden auf die Standardwerte zurückgesetzt. Deine eigenen Tasten gehen verloren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every shortcut and where it works go back to the defaults. Your own keys are lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Todos los atajos y dónde funcionan vuelven a los valores predeterminados. Se perderán las teclas que elegiste."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "همه میان‌برها و محل کارکردشان به پیش‌فرض برمی‌گردند. کلیدهای شخصی شما از بین می‌روند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tous les raccourcis et leur portée reviennent aux valeurs par défaut. Vos propres touches sont perdues."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כל הקיצורים והמקומות שבהם הם פועלים חוזרים לברירות המחדל. המקשים שהגדרת בעצמך יאבדו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "हर शॉर्टकट और उसका कार्य-क्षेत्र डिफ़ॉल्ट पर लौट जाता है। आपकी अपनी कुंजियाँ खो जाएँगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Semua pintasan dan tempat berfungsinya dikembalikan ke default. Tombol buatan Anda akan hilang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tutte le scorciatoie e le finestre in cui funzionano tornano ai valori predefiniti. I tasti che hai scelto andranno persi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "すべてのショートカットとその動作場所がデフォルトに戻ります。自分で設定したキーは失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "모든 단축키와 작동 범위가 기본값으로 돌아갑니다. 직접 지정한 키는 사라집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alle toetsenbordcommando's en waar ze werken worden teruggezet naar de standaardwaarden. Je eigen toetsen gaan verloren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wszystkie skróty i miejsca ich działania wracają do ustawień domyślnych. Własne klawisze zostaną utracone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Todos os atalhos e os locais onde funcionam voltam aos padrões. Suas teclas personalizadas serão perdidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Все сочетания и места их работы вернутся к значениям по умолчанию. Ваши собственные клавиши будут потеряны."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alla genvägar och var de fungerar återställs till standard. Dina egna tangenter går förlorade."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ทางลัดทั้งหมดและหน้าต่างที่ใช้งานได้จะกลับเป็นค่าเริ่มต้น แป้นที่คุณตั้งเองจะหายไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tüm kısayollar ve çalıştıkları yerler varsayılana döner. Kendi tuşlarınız kaybolur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Усі комбінації та місця їхньої дії повертаються до типових. Ваші власні клавіші буде втрачено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ہر شارٹ کٹ اور اس کے کام کرنے کی جگہ ڈیفالٹ پر لوٹ جائیں گے۔ آپ کی اپنی کلیدیں ختم ہو جائیں گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mọi phím tắt và nơi chúng hoạt động trở về mặc định. Các phím của riêng bạn sẽ mất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "所有快捷键及其适用范围都会恢复为默认设置。你自己设置的键将会丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "所有快速鍵及其適用範圍都會恢復為預設值，你自訂的按鍵將會遺失。"
          }
        }
      }
    },
