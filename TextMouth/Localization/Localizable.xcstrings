    "bookCloudError.stalled.running" : {
      "comment" : "Second sentence of why a book download stopped: the likely causes. \"It\" is the cloud service.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ربما تكون الخدمة متوقفة مؤقتًا أو مسجّلة الخروج أو ليست قيد التشغيل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এটি বিরতিতে, সাইন আউট অবস্থায় বা চালু না-ও থাকতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Dienst ist möglicherweise pausiert, abgemeldet oder läuft nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It may be paused, signed out, or not running."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Puede estar en pausa, con la sesión cerrada o sin ejecutarse."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ممکن است متوقف شده باشد، از حساب خود خارج شده باشد یا در حال اجرا نباشد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
