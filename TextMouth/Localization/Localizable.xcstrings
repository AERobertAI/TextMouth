          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "У этой книги нет допустимого управляемого пакета. Уберите её только из библиотеки или исправьте её хранилище перед удалением."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
