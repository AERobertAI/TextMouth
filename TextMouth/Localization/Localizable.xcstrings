    "sync.lastHeard" : {
      "comment" : "A line of the Sync status. The first %@ names a device, such as \"iPhone\", and the second is a time written by the system, such as \"9:40 AM\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آخر اتصال بـ %@ كان في %@."
