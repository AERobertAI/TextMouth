    "speechRenderFailure.unusableVoice" : {
      "comment" : "Why a spoken audio export was refused: the book's voice can't be recorded. %@ is the name of the Voice button in the book's reader.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يمكن تسجيل صوت الكتاب في ملف. اختر صوتًا آخر بزر %@ في القارئ، ثم صدّر مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইয়ের ভয়েস ফাইলে রেকর্ড করা যায় না। রিডারের %@ বোতাম দিয়ে অন্য একটি ভয়েস বেছে নিন, তারপর আবার রপ্তানি করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Stimme des Buchs kann nicht in eine Datei aufgenommen werden. Wähle mit der Taste „%@“ in der Leseansicht eine andere Stimme und exportiere dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The book's voice can't be recorded to a file. Choose another voice with the %@ button in the reader, then export again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La voz del libro no se puede grabar en un archivo. Elige otra voz con el botón %@ del lector y vuelve a exportar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صدای کتاب را نمی‌توان در فایل ضبط کرد. با دکمه %@ در کتاب‌خوان صدای دیگری انتخاب کنید، سپس دوباره صادر کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La voix du livre ne peut pas être enregistrée dans un fichier. Choisissez une autre voix avec le bouton %@ du lecteur, puis exportez de nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אי אפשר להקליט את קול הספר לקובץ. בחר קול אחר עם הלחצן %@ בקורא, ואז ייצא שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पुस्तक की आवाज़ फ़ाइल में रिकॉर्ड नहीं की जा सकती। रीडर में “%@” बटन से कोई दूसरी आवाज़ चुनें, फिर दोबारा निर्यात करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Suara buku tidak dapat direkam ke file. Pilih suara lain dengan tombol %@ di pembaca, lalu ekspor lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La voce del libro non può essere registrata in un file. Scegli un’altra voce con il pulsante %@ nel lettore, poi esporta di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブックの声はファイルに録音できません。リーダの「%@」ボタンで別の声を選んでから、もう一度書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책의 음성은 파일로 녹음할 수 없습니다. 리더의 %@ 버튼으로 다른 음성을 선택한 다음 다시 내보내십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De stem van het boek kan niet naar een bestand worden opgenomen. Kies een andere stem met de knop %@ in de lezer en exporteer daarna opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Głosu książki nie można nagrać do pliku. Wybierz inny głos przyciskiem %@ w czytniku, a potem wyeksportuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A voz do livro não pode ser gravada em um arquivo. Escolha outra voz com o botão %@ no leitor e exporte de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Голос книги нельзя записать в файл. Выберите другой голос кнопкой «%@» в окне чтения, затем экспортируйте снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bokens röst kan inte spelas in till en fil. Välj en annan röst med knappen ”%@” i läsaren och exportera sedan igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "บันทึกเสียงของหนังสือลงไฟล์ไม่ได้ เลือกเสียงอื่นด้วยปุ่ม %@ ในตัวอ่าน แล้วส่งออกอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitabın sesi dosyaya kaydedilemiyor. Okuyucudaki “%@” düğmesiyle başka bir ses seçin, sonra yeniden dışa aktarın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Голос книги не можна записати у файл. Виберіть інший голос кнопкою «%@» у вікні читання, а потім експортуйте знову."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب کی آواز فائل میں ریکارڈ نہیں کی جا سکتی۔ ریڈر میں “%@” بٹن سے کوئی دوسری آواز منتخب کریں، پھر دوبارہ برآمد کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không thể ghi giọng nói của sách vào tệp. Hãy chọn giọng khác bằng nút %@ trong trình đọc, rồi xuất lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "图书的语音无法录制到文件。请使用阅读器中的“%@”按钮选取另一种语音，然后再次导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此書的語音無法錄製到檔案。請用閱讀器中的「%@」按鈕選擇其他語音，然後再次輸出。"
          }
        }
      }
    },
    "speechService.engineRefusedAnnouncement" : {
      "comment" : "Announcement when the Mac's speech engine refused a text twice and speech ended where it was, in a window with no report sheet to say so.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "توقف النطق: رفض محرك النطق في Mac هذا النص."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "স্পিচ থেমেছে: Mac-এর স্পিচ ইঞ্জিন এই টেক্সট প্রত্যাখ্যান করেছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vorlesen gestoppt: Die Sprachausgabe des Mac hat diesen Text abgelehnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speech stopped: the Mac's speech engine refused this text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lectura detenida: el motor de voz de la Mac rechazó este texto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "گفتار متوقف شد: موتور گفتار Mac این متن را رد کرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voix arrêtée : le moteur vocal du Mac a refusé ce texte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הדיבור נעצר: מנוע הדיבור של Mac סירב לטקסט הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "स्पीच रुक गई: Mac के स्पीच इंजन ने इस टेक्स्ट को अस्वीकार कर दिया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ucapan berhenti: mesin ucapan Mac menolak teks ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lettura interrotta: il motore vocale del Mac ha rifiutato questo testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "読み上げを停止しました：Mac の読み上げエンジンがこのテキストを拒否しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "음성이 중지됨: Mac 음성 엔진이 이 텍스트를 거부했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Spraak gestopt: de spraakengine van de Mac heeft deze tekst geweigerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mowa zatrzymana: mechanizm mowy komputera Mac odrzucił ten tekst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fala interrompida: o mecanismo de fala do Mac recusou este texto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Речь остановлена: речевой движок Mac отклонил этот текст."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uppläsningen stoppades: Mac-datorns talmotor avvisade den här texten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "การอ่านออกเสียงหยุดลง: เครื่องมืออ่านออกเสียงของ Mac ปฏิเสธข้อความนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Konuşma durdu: Mac'in konuşma motoru bu metni reddetti."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Озвучення зупинено: система озвучення Mac відхилила цей текст."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اسپیچ رک گئی: Mac کے اسپیچ انجن نے اس متن کو مسترد کر دیا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Giọng đọc đã dừng: bộ máy đọc của máy Mac từ chối văn bản này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "朗读已停止：Mac 的朗读引擎拒绝了此文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "朗讀已停止：Mac 的語音引擎拒絕了這段文字。"
          }
        }
      }
    },
