    "persistenceFailureBannerRowView.returnsIfProblem" : {
      "comment" : "Last sentence of the VoiceOver hint of the failure banner's Dismiss button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يظهر مرة أخرى إذا عادت المشكلة بعد زوالها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সমস্যা মিটে যাওয়ার পর আবার দেখা দিলে এটি আবার আসে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Er erscheint erneut, wenn das Problem nach dem Verschwinden wiederkehrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It appears again if the problem returns after it clears."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vuelve a aparecer si el problema regresa después de resolverse."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اگر مشکل پس از رفع دوباره برگردد، دوباره ظاهر می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il réapparaît si le problème revient après avoir disparu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "היא תופיע שוב אם הבעיה תחזור לאחר שנעלמה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "समस्या दूर होने के बाद यदि वह लौटती है, तो यह फिर दिखाई देती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Muncul lagi jika masalah kembali setelah teratasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ricompare se il problema si ripresenta dopo essere stato risolto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
