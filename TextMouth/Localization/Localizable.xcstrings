      "comment" : "VoiceOver label of the Add Rule button in the Substitutions settings."
    },
    "Add bookmark" : {
      "comment" : "What VoiceOver says for the playback bar's bookmark button while no bookmark is at the place being read; it adds one."
    },
    "Add gesture step" : {
      "comment" : "VoiceOver label of the button that adds a step to the restart gesture in the Miscellaneous settings."
    },
    "Add rules to change how text is spoken. They apply top to bottom." : {
      "comment" : "Shown under \"No substitution rules.\" in the Substitutions settings."
    },
    "Add shortcut" : {
      "comment" : "Label of the button, in a keyboard shortcut action's row in Settings, that adds one more key to the action."
    },
    "Add step" : {
      "comment" : "Title of the button that adds a step to the restart gesture in the Miscellaneous settings."
    },
    "Add to Library" : {
      "comment" : "Button of the New Book from Text sheet that adds the new book to the library.\nHeading and navigation title of the sheet that lists the ways to add to the library. Title case.\nTitle of the Library toolbar button that opens the sheet of ways to add to the library. Title case.\nVoiceOver label of the Library toolbar button that opens the sheet of ways to add to the library. Title case."
    },
    "Add to Reading List" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Library group and read by VoiceOver. Adds the selected books to the end of the reading list. Also the title of the menu command of the same name."
    },
    "Added" : {
      "comment" : "Name of the book information sheet's row that shows the date the book was added to the library."
    },
    "Added %@" : {
      "comment" : "Said as a filter preset is added. %@ is the preset's name.\nSpeak Info: the part of a book's full summary that says when it was added. %@ is a date or time, such as \"today\" or \"3 days ago\"."
    },
    "Added %@, %lld of %lld." : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. What VoiceOver says once a new view is added, with its place. Placeholders in order: name, number, count.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Added %1$@, %2$lld of %3$lld."
