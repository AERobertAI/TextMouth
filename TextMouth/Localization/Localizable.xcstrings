        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ n’a pas indiqué que la copie de ce livre sur ce Mac est la plus récente ; son téléchargement ne peut donc pas être retiré."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ने यह नहीं बताया कि इस Mac पर इस पुस्तक की प्रति नवीनतम है, इसलिए उसका डाउनलोड नहीं हटाया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ tidak menyatakan bahwa salinan buku ini di Mac ini adalah yang terbaru, sehingga unduhannya tidak dapat dibuang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ non ha confermato che la copia di questo libro su questo Mac è la più recente, quindi il suo download non può essere rimosso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "この Mac にあるブックのコピーが最新かどうかを%@が示さないため、ダウンロードを取り除けません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@이(가) 이 Mac에 있는 이 책의 사본이 최신이라고 알려 주지 않아 다운로드를 제거할 수 없습니다."
          }
