    "kfxError.noFlowingText" : {
      "comment" : "Why a Kindle (KFX) book could not be imported: its pages are fixed layouts or pictures, as in a comic or a print replica, with no text that flows.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ليس في كتاب Kindle هذا نص متدفق، كما في القصص المصورة أو النسخ المطبوعة المطابقة، لذا لا يستطيع TextMouth قراءته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই Kindle বইয়ে ফ্লো করা টেক্সট নেই, যেমন কমিক বা প্রিন্ট রেপ্লিকায়, তাই TextMouth এটি পড়তে পারে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieses Kindle-Buch hat keinen fließenden Text, wie bei einem Comic oder einer Druckreplik, daher kann TextMouth es nicht lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Kindle book has no flowing text, as in a comic or print replica, so TextMouth can't read it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este libro de Kindle no tiene texto fluido, como un cómic o una réplica impresa, así que TextMouth no puede leerlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "این کتاب Kindle متن روان ندارد، مانند کمیک یا نسخه چاپی عین‌به‌عین، بنابراین TextMouth نمی‌تواند آن را بخواند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce livre Kindle n’a pas de texte fluide, comme dans une bande dessinée ou une réplique d’imprimé, donc TextMouth ne peut pas le lire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בספר Kindle זה אין טקסט זורם, כמו בקומיקס או בשכפול של ספר מודפס, ולכן TextMouth אינו יכול לקרוא אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस Kindle पुस्तक में बहने वाला टेक्स्ट नहीं है, जैसा कॉमिक या प्रिंट प्रतिकृति में होता है, इसलिए TextMouth इसे नहीं पढ़ सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Buku Kindle ini tidak memiliki teks yang mengalir, seperti pada komik atau replika cetak, sehingga TextMouth tidak dapat membacanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo libro Kindle non ha testo scorrevole, come in un fumetto o in una replica della stampa, quindi TextMouth non può leggerlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "この Kindle ブックには、コミックや印刷物のレプリカのように、流れるテキストがないため、TextMouth は読み取れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 Kindle 책은 만화나 인쇄본 복제본처럼 흐르는 텍스트가 없어 TextMouth가 읽을 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dit Kindle-boek heeft geen doorlopende tekst, zoals in een strip of een exacte afdrukkopie, dus TextMouth kan het niet lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ta książka Kindle nie ma płynnego tekstu, jak w komiksie lub replice wydruku, więc TextMouth nie może jej odczytać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este livro Kindle não tem texto fluido, como acontece em quadrinhos ou réplicas de impressos, então o TextMouth não consegue lê-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В этой книге Kindle нет текста с плавающей вёрсткой, как в комиксах или копиях печатных изданий, поэтому TextMouth не может её прочитать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Den här Kindle-boken har ingen flytande text, som i en serietidning eller en tryckkopia, så TextMouth kan inte läsa den."
