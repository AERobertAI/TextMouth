    "pageImage.notAPicture" : {
      "comment" : "Why a file was refused at import: its bytes are no picture at all. Two sentences.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّرت قراءة هذا الملف كصورة. قد يكون تالفًا، أو من نوع آخر من الملفات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই ফাইলটি ছবি হিসেবে পড়া যায়নি। এটি ক্ষতিগ্রস্ত হতে পারে, অথবা অন্য ধরনের ফাইল হতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Diese Datei konnte nicht als Bild gelesen werden. Sie ist möglicherweise beschädigt oder hat ein anderes Format."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This file could not be read as a picture. It may be damaged, or another kind of file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo leer este archivo como imagen. Puede estar dañado, o ser otro tipo de archivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "این فایل را نمی‌توان به‌صورت تصویر خواند. ممکن است آسیب دیده باشد یا نوع دیگری از فایل باشد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
