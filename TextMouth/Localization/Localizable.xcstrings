    "phoneExport.anotherExportRuns" : {
      "comment" : "The hint of the dimmed Export button on the iPhone's Export sheet while another export is running.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يجري تصدير آخر. بطاقته في أعلى المكتبة."
