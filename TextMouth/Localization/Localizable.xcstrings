        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "RAR कॉमिक के पृष्ठों को CBZ कॉमिक के रूप में फिर से पैक करें, फिर उन्हें आयात करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
