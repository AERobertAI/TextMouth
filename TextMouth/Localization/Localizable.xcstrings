            "value" : "Пресету фільтра потрібна назва."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "滤波器预设需要一个名称。"
          }
        }
      }
    },
    "A folder name can't be empty, \".\" or \"..\", end in \".tmb\", or be reserved by TextMouth." : {
      "comment" : "Error shown when a folder's new name is refused: the name is empty, is a single or double dot, ends in .tmb, or is one TextMouth keeps for itself. The quoted pieces are literal text.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يمكن أن يكون اسم المجلد فارغًا أو \".\" أو \"..\"، أو ينتهي بـ \".tmb\"، أو يكون محجوزًا لـ TextMouth."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Ordnername darf nicht leer, „.“ oder „..“ sein, nicht auf „.tmb“ enden und nicht von TextMouth reserviert sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El nombre de una carpeta no puede estar vacío, ser \".\" ni \"..\", terminar en \".tmb\" ni estar reservado por TextMouth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le nom d’un dossier ne peut pas être vide, « . » ou « .. », se terminer par « .tmb », ni être réservé par TextMouth."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ोल्डर का नाम खाली, \".\" या \"..\" नहीं हो सकता, \".tmb\" पर समाप्त नहीं हो सकता, और TextMouth के लिए आरक्षित नहीं हो सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nama folder tidak boleh kosong, \".\" atau \"..\", diakhiri dengan \".tmb\", atau dicadangkan oleh TextMouth."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il nome di una cartella non può essere vuoto, “.” o “..”, terminare con “.tmb” né essere riservato da TextMouth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フォルダ名には、空の名前、「.」、「..」、「.tmb」で終わる名前、TextMouth が予約している名前は使えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "폴더 이름은 비어 있거나 “.” 또는 “..”이거나 “.tmb”로 끝나거나 TextMouth가 예약한 이름일 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O nome de uma pasta não pode ser vazio, “.” ou “..”, terminar em “.tmb” nem ser reservado pelo TextMouth."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Имя папки не может быть пустым, равным «.» или «..», оканчиваться на «.tmb» или быть зарезервированным в TextMouth."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Назва папки не може бути порожньою, «.» чи «..», закінчуватися на «.tmb» або бути зарезервованою TextMouth."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文件夹名称不能为空，不能是“.”或“..”，不能以“.tmb”结尾，也不能是 TextMouth 保留的名称。"
          }
        }
      }
    },
    "A folder named %@ already exists in %@." : {
      "comment" : "Error shown when a folder's new name or place is taken. %1$@ is the existing folder's name, in straight double quotes. %2$@ is where it is: its folder's location in straight double quotes, or the name of the library's top level.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يوجد مجلد باسم %1$@ بالفعل في %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Ordner namens %1$@ ist bereits in %2$@ vorhanden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A folder named %1$@ already exists in %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ya existe una carpeta llamada %1$@ en %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un dossier nommé %@ existe déjà dans %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@ में %1$@ नाम का फ़ोल्डर पहले से मौजूद है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Folder bernama %@ sudah ada di %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esiste già una cartella chiamata %@ in %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%1$@」という名前のフォルダはすでに%2$@にあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@에 %1$@ 폴더가 이미 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Já existe uma pasta chamada %1$@ em %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Папка с именем %1$@ уже есть в %2$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Папка з назвою %1$@ уже є в %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@ 中已存在名为 %1$@ 的文件夹。"
          }
        }
      }
    },
    "A library in the cloud can take a while: its cloud-only files are downloaded to this Mac to be read." : {
      "comment" : "Sentence of what the Compare Libraries sheet says while it works: a library kept in a cloud drive is slow because files that are only in the cloud are downloaded first.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "قد تستغرق المكتبة في السحابة وقتًا: إذ يتم تنزيل ملفاتها الموجودة في السحابة فقط إلى هذا الـ Mac لقراءتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eine Bibliothek in der Cloud kann eine Weile dauern: Ihre nur in der Cloud liegenden Dateien werden zum Lesen auf diesen Mac geladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una biblioteca en la nube puede tardar: sus archivos que solo están en la nube se descargan en esta Mac para leerlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une bibliothèque dans le cloud peut prendre du temps : ses fichiers qui ne sont que dans le cloud sont téléchargés sur ce Mac pour être lus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "क्लाउड में मौजूद लाइब्रेरी में समय लग सकता है: पढ़ने के लिए उसकी केवल-क्लाउड फ़ाइलें इस Mac पर डाउनलोड की जाती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pustaka di cloud dapat memerlukan waktu: file yang hanya ada di cloud diunduh ke Mac ini untuk dibaca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una libreria nel cloud può richiedere del tempo: i suoi file presenti solo nel cloud vengono scaricati su questo Mac per essere letti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "クラウド上のライブラリは時間がかかることがあります。クラウドにしかないファイルは、読み込むためにこの Mac にダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "클라우드에 있는 보관함은 시간이 걸릴 수 있습니다. 클라우드에만 있는 파일을 이 Mac으로 다운로드해 읽어야 하기 때문입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uma biblioteca na nuvem pode demorar: os arquivos que estão só na nuvem são baixados para este Mac para serem lidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Библиотека в облаке может обрабатываться долго: файлы, которые есть только в облаке, сначала загружаются на этот Mac, чтобы их прочитать."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Бібліотека в хмарі може завантажуватися довго: файли, що є лише в хмарі, завантажуються на цей Mac для читання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "云端资料库可能需要较长时间：仅存在于云端的文件会先下载到这台 Mac 才能读取。"
          }
        }
      }
    },
    "A limit chooses among books, episodes, and articles, never feeds." : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. Show at Most's hint while the view lists feeds alone, when it is dimmed (finding 6).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يختار الحد من بين الكتب والحلقات والمقالات، ولا يختار الموجزات أبدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Limit wählt unter Büchern, Folgen und Artikeln aus, nie unter Feeds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un límite elige entre libros, episodios y artículos, nunca canales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une limite choisit parmi les livres, les épisodes et les articles, jamais les flux."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सीमा पुस्तकों, एपिसोड और लेखों में से चुनती है, फ़ीड में से कभी नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Batas memilih di antara buku, episode, dan artikel, bukan feed."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un limite sceglie tra libri, episodi e articoli, mai tra i feed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "制限で選べるのは、ブック、エピソード、記事です。フィードは選べません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "제한은 책, 에피소드, 기사 중에서 선택하며 피드는 선택하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um limite escolhe entre livros, episódios e artigos, nunca feeds."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ограничение выбирает только книги, выпуски и статьи, но не ленты."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Обмеження вибирає серед книг, епізодів і статей, але не стрічок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "限制只在图书、单集和文章中选取，不涉及订阅源。"
          }
        }
      }
    },
    "A managed package named %@ already exists." : {
      "comment" : "Why a TextMouth package could not be imported: the library already holds a package of that name. %@ is the package's name.",
      "localizations" : {
        "de" : {
