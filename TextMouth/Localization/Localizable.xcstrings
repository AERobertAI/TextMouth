          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "זוהה לפי הבייטים שלו"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "उसके बाइट से पहचानी गई"
          }
        },
        "id" : {
