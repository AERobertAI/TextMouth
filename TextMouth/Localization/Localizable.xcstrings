        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La cartella non è più nella libreria. Potrebbe essere stata spostata, rinominata o eliminata in un’altra finestra."
          }
        }
      }
    },
    "The folder is not a DAISY book: it has no ncc.html or .opf file at its top level." : {
      "comment" : "Why a folder could not be imported as a DAISY book: it holds no navigation file (ncc.html) and no package file (.opf) at its top level. ncc.html and .opf are file names and stay as they are.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
