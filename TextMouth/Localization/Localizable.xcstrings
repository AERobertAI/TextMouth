          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Стрічка залишається у вашій бібліотеці з налаштуваннями та такими завантаженнями: %1$@; %2$@ знову перевіряє її."
