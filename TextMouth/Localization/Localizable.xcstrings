    "libraryViewModel.message.switching" : {
      "comment" : "First sentence of why Use This Library was refused: changes could not be saved yet. %@ is the failure's lead-in, \"Failed to switch libraries\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@: بعض التغييرات غير محفوظة، وسيؤدي تبديل المكتبات إلى فقدانها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@: কিছু পরিবর্তন সংরক্ষিত হয়নি, আর লাইব্রেরি বদলালে সেগুলো হারিয়ে যাবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@: Einige Änderungen sind nicht gesichert, und beim Wechseln der Bibliothek würden sie verloren gehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: Some changes are not saved, and switching libraries would lose them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@: hay cambios sin guardar, y se perderían al cambiar de biblioteca."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@: برخی تغییرات ذخیره نشده‌اند و تعویض کتابخانه آن‌ها را از دست می‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ : des modifications ne sont pas enregistrées, et elles seraient perdues si vous changiez de bibliothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@: חלק מהשינויים לא נשמרו, והם יאבדו בהחלפת הספרייה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@: कुछ बदलाव सहेजे नहीं गए हैं, और लाइब्रेरी बदलने से वे खो जाएँगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@: Beberapa perubahan belum tersimpan, dan berpindah pustaka akan menghilangkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@: alcune modifiche non sono salvate e il cambio di libreria le perderebbe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@：一部の変更が保存されておらず、ライブラリを切り替えると失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@: 일부 변경 사항이 저장되지 않았으며, 보관함을 전환하면 잃게 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
