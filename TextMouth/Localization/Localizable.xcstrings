    "feed.addressHelp" : {
      "comment" : "The line under the address field of the Add Feed sheet. .rss and .xml are file extensions.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عنوان موجز، مثل رابط ينتهي بـ .rss أو .xml، أو صفحة ويب تذكر موجزها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফিডের ঠিকানা, যেমন .rss বা .xml দিয়ে শেষ হওয়া লিঙ্ক, অথবা এমন ওয়েব পৃষ্ঠা যা তার ফিডের ঠিকানা জানায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eine Feed-Adresse, etwa ein Link, der auf .rss oder .xml endet, oder eine Webseite, die ihren Feed nennt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A feed address, such as a link ending in .rss or .xml, or a web page that names its feed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una dirección de canal, como un enlace que termina en .rss o .xml, o una página web que indica su canal."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نشانی فید، مانند پیوندی که به .rss یا .xml ختم می‌شود، یا صفحه‌ی وبی که فید خود را معرفی می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une adresse de flux, comme un lien se terminant par .rss ou .xml, ou une page web qui indique son flux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כתובת של ערוץ, כמו קישור שמסתיים ב-.rss או ב-.xml, או דף אינטרנט שמציין את הערוץ שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ीड का पता, जैसे .rss या .xml पर समाप्त होने वाला लिंक, या ऐसा वेब पृष्ठ जो अपने फ़ीड का पता बताता हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alamat feed, seperti tautan yang berakhir dengan .rss atau .xml, atau halaman web yang menyebutkan feed-nya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un indirizzo di feed, come un link che termina con .rss o .xml, o una pagina web che indica il suo feed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フィードのアドレス（.rss や .xml で終わるリンクなど）、またはフィードを示す Web ページ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "피드 주소(.rss 또는 .xml로 끝나는 링크 등) 또는 피드를 알려 주는 웹 페이지입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Een feedadres, zoals een link die eindigt op .rss of .xml, of een webpagina die de feed noemt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Adres kanału, na przykład link kończący się na .rss lub .xml, albo strona internetowa wskazująca swój kanał."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um endereço de feed, como um link terminado em .rss ou .xml, ou uma página da web que indique o feed."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Адрес ленты, например ссылка, которая заканчивается на .rss или .xml, или веб-страница, где указана её лента."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En flödesadress, till exempel en länk som slutar på .rss eller .xml, eller en webbsida som anger sitt flöde."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ที่อยู่ของฟีด เช่น ลิงก์ที่ลงท้ายด้วย .rss หรือ .xml หรือหน้าเว็บที่ระบุฟีดของตน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bir besleme adresi, örneğin .rss veya .xml ile biten bir bağlantı ya da beslemesini belirten bir web sayfası."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Адреса стрічки, наприклад посилання, що закінчується на .rss або .xml, або вебсторінка, яка вказує свою стрічку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فیڈ کا پتا، جیسے rss یا xml پر ختم ہونے والا لنک، یا ایسا ویب صفحہ جو اپنی فیڈ کی طرف اشارہ کرتا ہو۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Địa chỉ nguồn cấp, như liên kết kết thúc bằng .rss hoặc .xml, hoặc trang web có liên kết đến nguồn cấp của nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "订阅源地址，例如以 .rss 或 .xml 结尾的链接，或指明其订阅源的网页。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "訂閱源網址，例如以 .rss 或 .xml 結尾的連結，或是列出其訂閱源的網頁。"
          }
        }
      }
    },
    "feed.addressHint" : {
      "comment" : "VoiceOver hint of the field where the listener types a feed's address. Return is the Return key.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اكتب أو الصق عنوان موجز أو صفحة ويب، ثم اضغط Return"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফিড বা ওয়েব পৃষ্ঠার ঠিকানা টাইপ বা পেস্ট করার পর রিটার্ন চাপতে হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gib die Adresse eines Feeds oder einer Webseite ein oder füge sie ein und drücke dann Return."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type or paste a feed or web page address, then press Return"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escribe o pega la dirección de un canal o de una página web y pulsa Retorno"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نشانی فید یا صفحه‌ی وب را تایپ کنید یا بچسبانید، سپس Return را فشار دهید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saisissez ou collez l’adresse d’un flux ou d’une page web, puis appuyez sur Retour."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הקלד או הדבק כתובת של ערוץ או של דף אינטרנט, ואז הקש Return."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ीड या वेब पृष्ठ का पता टाइप करें या पेस्ट करें, फिर रिटर्न दबाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ketik atau tempel alamat feed atau halaman web, lalu tekan Return."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Digita o incolla l’indirizzo di un feed o di una pagina web, poi premi Invio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フィードまたは Web ページのアドレスを入力またはペーストして、Return キーを押します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "피드나 웹 페이지 주소를 입력하거나 붙여넣은 다음 Return 키를 누르십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Typ of plak het adres van een feed of webpagina en druk op Return."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wpisz lub wklej adres kanału lub strony internetowej, a potem naciśnij Return."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Digite ou cole o endereço de um feed ou de uma página da web e pressione Return."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Введите или вставьте адрес ленты или веб-страницы, затем нажмите Return."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Skriv eller klistra in adressen till ett flöde eller en webbsida och tryck sedan på Retur."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "พิมพ์หรือวางที่อยู่ฟีดหรือหน้าเว็บ แล้วกด Return"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bir besleme veya web sayfası adresi yazın ya da yapıştırın, sonra Return tuşuna basın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Введіть або вставте адресу стрічки чи вебсторінки, а потім натисніть Return."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فیڈ یا ویب صفحے کا پتا ٹائپ کریں یا پیسٹ کریں، پھر ریٹرن دبائیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nhập hoặc dán địa chỉ nguồn cấp hoặc trang web, rồi nhấn Return."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "输入或粘贴订阅源或网页的地址，然后按 Return 键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "輸入或貼上訂閱源或網頁的網址，然後按下 Return。"
          }
        }
      }
    },
