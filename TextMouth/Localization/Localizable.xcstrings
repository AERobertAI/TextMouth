    "Rename" : {
      "comment" : "Button of a marker's row in the audio editor's list that gives the marker a name.\nButton that gives the folder the new name."
    },
    "Rename Folder" : {
      "comment" : "Heading and window title of the sheet that renames a folder."
    },
    "Rename Folder..." : {
      "comment" : "Item of a folder's menu that opens the sheet that renames the folder. The three dots mean a sheet opens."
    },
    "Renaming the folder..." : {
      "comment" : "Status shown and spoken in the Rename Folder sheet while the folder's books' packages move to the new name. The three dots mean it is in progress."
    },
    "Repack the pages of RAR comics as CBZ comics, then import those." : {
      "comment" : "Advice after the refusal of a comic whose pages are in a RAR archive."
    },
    "Replace %@" : {
      "comment" : "Name of an edit, as the Undo and Redo menu items say it after \"Undo\" or \"Redo\": replacing a stretch of audio with a new recording. %@ is the replaced length in title-cased words, such as \"2.5 Seconds\"."
    },
    "Replace Existing" : {
      "comment" : "Title and VoiceOver label of the button of the duplicate-book question that replaces the copy in the library. Title case."
    },
    "Replace Transcript" : {
      "comment" : "Button of the question asked before a transcript from a file replaces an audiobook's transcript, which replaces it."
    },
    "Replace the Transcript of %@?" : {
      "comment" : "Title of the question asked before a transcript from a file replaces an audiobook's transcript. %@ is the audiobook's title."
    },
    "Replace with: %@" : {
      "comment" : "A part of a substitution rule's spoken summary. %@ is the replacement text."
    },
    "Replaced %@ with %@ of new recording, which is selected." : {
      "comment" : "Said as a punch-in recording replaces the selection in the audio editor. %1$@ is the length replaced and %2$@ the length of the new recording, both in words.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Replaced %1$@ with %2$@ of new recording, which is selected."
          }
        }
      }
    },
    "Replaced “%@”." : {
      "comment" : "First sentence of the announcement after Replace Existing put the new copy in place of a book and kept the old copy's text beside the new text. %@ is the book's title. A sentence about where the earlier text is kept follows."
    },
    "Replacement (empty to skip)" : {
      "comment" : "Placeholder of the field that holds a substitution rule's replacement text in the rule editor. Leaving it empty removes the matched text."
    },
    "Replacement text. Leave empty to skip matched text." : {
      "comment" : "VoiceOver label of the replacement field in the substitution rule editor."
    },
    "Replaces the text with the text on the clipboard" : {
      "comment" : "Hint of the Paste from Clipboard button of the New Book from Text sheet."
    },
    "Replacing keeps the existing copy's reading position and bookmarks, moved to their words in the new text where found, and its settings, folder, and place on the reading list. An edit of its text is kept as a copy beside the new text, not applied." : {
      "comment" : "Part of the question asked about a duplicate book that is read from text: what Replace Existing keeps of the library's copy. \"The existing copy\" is the library's copy."
    },
    "Replacing keeps the existing copy's reading position, bookmarks, settings, folder, and place on the reading list, and its transcript when the audio is the same, rather than the transcript file found beside the new copy's audio." : {
      "comment" : "Part of the question asked about a duplicate audiobook whose new copy came with a transcript file beside its audio: Replace Existing keeps the library copy's own transcript over that file. \"The existing copy\" is the library's copy. A sentence about what is not kept follows."
    },
    "Replacing keeps the existing copy's reading position, bookmarks, settings, folder, and place on the reading list, and its transcript when the audio is the same." : {
      "comment" : "Part of the question asked about a duplicate audiobook: what Replace Existing keeps of the library's copy. \"The existing copy\" is the library's copy. A sentence about what is not kept follows."
    },
    "Replacing keeps the existing copy's reading position, bookmarks, settings, folder, and place on the reading list." : {
      "comment" : "Part of the question asked about a duplicate audiobook whose new copy came with a transcript file beside its audio: what Replace Existing keeps of the library's copy. \"The existing copy\" is the library's copy. Sentences about the transcript and what is not kept follow."
    },
    "Replacing kept the existing copy's transcript." : {
      "comment" : "The reason, in a notice after an import, that a transcript file beside the audio was not attached: Replace Existing kept the existing copy's own transcript."
    },
    "Replacing “%@”. This can take a moment." : {
      "comment" : "VoiceOver announcement as Replace Existing begins for a duplicate book; the sheet's buttons are dimmed until it is done. %@ is the book's title."
    },
    "Reset" : {
      "comment" : "Button of an alert that confirms resetting every keyboard shortcut to its default.\nName of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Reset\".\nName of a premade filter preset's Reset button, also its VoiceOver action and context menu item: puts the preset back as it came.\nTitle of the button that goes ahead in the question asked before the Substitutions settings replace every rule with the defaults."
    },
    "Reset %@ to Default" : {
      "comment" : "VoiceOver label of the Reset to Default button in the row of a keyboard shortcut action. %@ is the action's name."
    },
    "Reset & Move" : {
      "comment" : "Button of the Reset to Default Location question that moves the library."
    },
    "Reset All to Defaults" : {
      "comment" : "Button in the filter presets sheet that puts back TextMouth's premade presets."
    },
    "Reset Keyboard Shortcuts?" : {
      "comment" : "Title of the alert that asks the listener to confirm resetting every keyboard shortcut to its default."
    },
    "Reset Text Rules to Defaults?" : {
      "comment" : "Title of the question asked before the Substitutions settings replace every rule with the defaults."
    },
    "Reset Timer" : {
      "comment" : "Button of the sleep timer sheet that starts the running timer again from its whole length.",
