    "A book that's only in %@ needs an internet connection to open." : {
      "comment" : "What using a library in a cloud folder means. %@ is the cloud service's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "الكتاب الموجود في %@ فقط يحتاج إلى اتصال بالإنترنت لفتحه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "যে বই শুধু %@-এ আছে, তা খুলতে ইন্টারনেট সংযোগ লাগে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Buch, das nur in %@ liegt, braucht zum Öffnen eine Internetverbindung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un libro que solo está en %@ necesita conexión a internet para abrirse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un livre qui se trouve uniquement dans %@ nécessite une connexion à Internet pour être ouvert."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "जो पुस्तक केवल %@ में है, उसे खोलने के लिए इंटरनेट कनेक्शन चाहिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Buku yang hanya ada di %@ memerlukan koneksi internet untuk dibuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un libro che si trova solo in %@ richiede una connessione a internet per essere aperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@にだけあるブックを開くには、インターネット接続が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@에만 있는 책을 열려면 인터넷 연결이 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um livro que está apenas em %@ precisa de conexão com a internet para ser aberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Чтобы открыть книгу, которая есть только в облаке (%@), нужно подключение к интернету."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Щоб відкрити книгу, яка є лише в хмарі (%@), потрібне підключення до інтернету."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "仅存在于 %@ 的图书需要连接互联网才能打开。"
