          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth perguntará se deseja mover o arquivo original para a Lixeira após cada importação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "После каждого импорта вас будут спрашивать, перемещать ли исходный файл в Корзину."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Після кожного імпорту вас запитуватимуть, чи перемістити оригінальний файл до Кошика."
          }
        }
      }
    },
    "You're already subscribed to %@." : {
      "comment" : "Why Subscribe refused: the feed is already in the library. %@ is the feed's title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
