    "textEncoding.placesSentence.bookmarks" : {
      "comment" : "First sentence of what a re-read does to the listener's place and bookmarks.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ينتقل موضعك وإشاراتك المرجعية مع كلماتها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আপনার অবস্থান ও বুকমার্ক নিজ নিজ শব্দের সঙ্গে সরে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deine Position und deine Lesezeichen wandern mit ihren Wörtern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your place and bookmarks move with their words."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tu lugar y tus marcadores se mueven con sus palabras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مکان و نشانک‌های شما همراه با کلمه‌هایشان جابه‌جا می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Votre position et vos signets suivent leurs mots."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "המקום והסימניות שלך עוברים עם המילים שלהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आपका स्थान और बुकमार्क उनके शब्दों के साथ चलते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Posisi dan markah Anda berpindah bersama kata-katanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La tua posizione e i segnalibri si spostano con le loro parole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "場所とブックマークは、対応する単語に合わせて移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "현재 위치와 북마크는 해당 단어와 함께 이동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Je leespositie en bladwijzers gaan mee met hun woorden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pozycja czytania i zakładki przenoszą się razem ze swoimi słowami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sua posição e seus marcadores se movem com as palavras deles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ваша позиция чтения и закладки перемещаются вместе со своими словами."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Din plats och dina bokmärken flyttas med sina ord."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตำแหน่งและที่คั่นหน้าจะย้ายตามคำของตน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yeriniz ve yer imleriniz kelimeleriyle birlikte taşınır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ваша позиція та закладки переміщуються разом зі своїми словами."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آپ کا مقام اور بک مارکس اپنے الفاظ کے ساتھ منتقل ہوتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vị trí và dấu trang của bạn di chuyển cùng với các từ của chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "你的位置和书签会随其字词一起移动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "你的位置和書籤會隨其文字移動。"
          }
        }
      }
    },
    "textEncoding.placesSentence.whereNoneTheir" : {
      "comment" : "Second sentence of what a re-read does to the listener's place and bookmarks, without an example.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عندما لا تبقى أي من كلماتها، يذهب كل منها إلى النقطة نفسها تقريبًا في فصله، أو إلى أقرب مقطع تشترك فيه القراءتان."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "যেখানে এগুলোর কোনো শব্দই আর থাকে না, সেখানে প্রতিটি তার অধ্যায়ের প্রায় একই জায়গায় যায়, অথবা আগের ও নতুন টেক্সটে মিল থাকা নিকটতম অংশে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wo keines ihrer Wörter mehr vorhanden ist, geht jedes etwa an dieselbe Stelle im Kapitel oder zur nächstgelegenen Passage, die beide Lesefassungen gemeinsam haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where none of their words are left, each goes to about the same point in its chapter, or to the nearest passage the two readings share."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Donde no queda ninguna de sus palabras, cada uno va aproximadamente al mismo punto de su capítulo, o al pasaje más cercano que comparten las dos lecturas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هر جا هیچ‌کدام از کلمه‌های آن‌ها نمانده باشد، هر کدام تقریباً به همان نقطه‌ی فصل خودش می‌رود، یا به نزدیک‌ترین بخشی که دو متن در آن مشترک‌اند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Là où il ne reste aucun de leurs mots, chacun va à peu près au même point de son chapitre, ou au passage le plus proche commun aux deux textes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כשלא נותרה אף אחת מהמילים שלהם, כל אחד מהם עובר לאותה נקודה בערך בפרק שלו, או לקטע הקרוב ביותר ששתי הקריאות חולקות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "जहाँ उनका कोई शब्द नहीं बचता, वहाँ हर एक अपने अध्याय में लगभग उसी बिंदु पर जाता है, या उन दोनों रीडिंग के साझा निकटतम अंश पर।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jika kata-katanya tidak tersisa lagi, masing-masing berpindah ke titik yang kira-kira sama di babnya, atau ke bagian terdekat yang ada di kedua pembacaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quando non resta nessuna delle loro parole, ognuno va circa allo stesso punto del suo capitolo, o al passaggio più vicino che le due letture hanno in comune."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "単語が1つも残っていない場合、それぞれは章内のほぼ同じ位置、または2つの読み込み結果が共有する最も近い箇所に移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "단어가 하나도 남지 않으면 각 항목은 해당 챕터의 거의 같은 지점이나 두 읽기 결과에 공통된 가장 가까운 구절로 이동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Als er geen van hun woorden meer over is, gaat elk naar ongeveer hetzelfde punt in het hoofdstuk, of naar de dichtstbijzijnde passage die de twee leesversies delen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jeśli nie zostało żadne z ich słów, każda pozycja trafia mniej więcej w to samo miejsce rozdziału albo do najbliższego fragmentu wspólnego dla obu odczytów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Onde não resta nenhuma das palavras deles, cada um vai para aproximadamente o mesmo ponto do seu capítulo ou para a passagem mais próxima que as duas leituras compartilham."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Если слов, к которым они привязаны, не осталось, каждая из них переходит примерно в ту же точку своей главы или в ближайший фрагмент, общий для двух прочтений."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Där inget av deras ord finns kvar går var och en till ungefär samma punkt i sitt kapitel, eller till det närmaste stycke som de två läsningarna delar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หากไม่เหลือคำเดิมของรายการเหล่านั้นเลย แต่ละรายการจะไปที่จุดเดียวกันโดยประมาณในบทของตน หรือไปที่ข้อความช่วงที่ใกล้ที่สุดซึ่งข้อความทั้งสองฉบับมีร่วมกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kelimelerinden hiçbiri kalmadığında, her biri bölümünde yaklaşık aynı noktaya ya da iki metnin ortak olduğu en yakın pasaja gider."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо не залишилося жодного з їхніх слів, кожна з них переходить приблизно на те саме місце в розділі або до найближчого уривка, спільного для старого й нового тексту."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جہاں ان کا کوئی لفظ باقی نہ رہے، ہر ایک اپنے باب میں تقریباً اسی مقام پر، یا دونوں ریڈنگز کے مشترک قریب ترین حصے پر چلا جاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Khi không còn từ nào của chúng, mỗi mục chuyển đến khoảng cùng điểm trong chương của nó, hoặc đến đoạn gần nhất mà cả hai bản văn bản đều có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "若它们的字词都没有保留，则每个位置会移到其章节中大致相同的点，或移到两次阅读共有的最近段落。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "當它們的字詞都不剩時，各自會移到章節中大約相同的位置，或兩種讀取結果共有的最近段落。"
          }
        }
      }
    },
