    "dataDirectoryUnavailability.whatToCheck.offline" : {
      "comment" : "What to check when the library's files could not come from iCloud Drive. Try Again is the name of a button on the same screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "قد يكون iCloud Drive متوقفًا أو لم يُسجَّل الدخول إليه، أو قد يكون هذا الـ Mac غير متصل بالإنترنت. تحقق من ذلك، ثم اختر “إعادة المحاولة”."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive বন্ধ বা সাইন আউট থাকতে পারে, অথবা এই Mac অফলাইনে থাকতে পারে। তা দেখুন, তারপর “আবার চেষ্টা করুন” বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive ist möglicherweise ausgeschaltet oder abgemeldet, oder dieser Mac ist offline. Prüfe das und wähle dann „Erneut versuchen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive may be turned off or signed out, or this Mac may be offline. Check that, then choose Try Again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Puede que iCloud Drive esté desactivado o con la sesión cerrada, o que esta Mac no tenga conexión. Compruébalo y luego elige Reintentar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive ممکن است خاموش یا از حساب خارج شده باشد، یا این Mac آفلاین باشد. این را بررسی کنید، سپس «تلاش دوباره» را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive est peut-être désactivé ou déconnecté, ou ce Mac est peut-être hors ligne. Vérifiez-le, puis choisissez Réessayer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ייתכן ש-iCloud Drive כבוי או שהחשבון מנותק, או שה-Mac הזה לא מחובר לאינטרנט. בדוק זאת, ואז בחר “נסה שוב”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive बंद या साइन आउट हो सकता है, या यह Mac ऑफ़लाइन हो सकता है। इसे जाँचें, फिर “फिर से प्रयास करें” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive mungkin dimatikan atau Anda sudah keluar dari iCloud, atau Mac ini mungkin offline. Periksa hal itu, lalu pilih Coba Lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive potrebbe essere disattivato o potresti non aver effettuato l’accesso, oppure questo Mac potrebbe essere offline. Controlla, poi scegli Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive がオフ、またはサインアウトしているか、この Mac がオフラインの可能性があります。確認してから、「再試行」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive가 꺼져 있거나 로그아웃되었을 수 있고, 이 Mac이 오프라인일 수도 있습니다. 확인한 다음 다시 시도를 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive staat misschien uit of is afgemeld, of deze Mac is offline. Controleer dat en kies dan Probeer opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Możliwe, że funkcja iCloud Drive jest wyłączona, logowanie do niej wygasło albo ten komputer Mac jest offline. Sprawdź to, a następnie wybierz Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O iCloud Drive pode estar desativado ou sem login, ou este Mac pode estar off-line. Verifique isso e escolha Tentar novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Возможно, iCloud Drive отключён или не выполнен вход, либо этот Mac не в сети. Проверьте это и выберите «Повторить попытку»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive kan vara avstängt eller utloggat, eller så kan den här Mac-datorn vara offline. Kontrollera det och välj sedan Försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive อาจปิดอยู่หรือออกจากระบบอยู่ หรือ Mac เครื่องนี้อาจออฟไลน์ ตรวจสอบสิ่งนั้น แล้วเลือก ลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive kapalı veya oturumu kapatılmış olabilir ya da bu Mac çevrimdışı olabilir. Bunu denetleyin, sonra Tekrar Dene düğmesini seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive може бути вимкнено, або ви вийшли з облікового запису, або цей Mac не в мережі. Перевірте це, а потім виберіть «Повторити»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ہو سکتا ہے iCloud Drive بند ہو یا سائن آؤٹ ہو، یا یہ Mac آف لائن ہو۔ اسے جانچیں، پھر “دوبارہ کوشش کریں” منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive có thể đã bị tắt hoặc đã đăng xuất, hoặc máy Mac này có thể đang ngoại tuyến. Hãy kiểm tra, rồi chọn Thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud 云盘可能已关闭或已退出登录，或者这台 Mac 可能处于离线状态。请检查这些，然后选取“重试”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive 可能已關閉或已登出，或是這部 Mac 可能已離線。請檢查，然後選擇「重試」。"
          }
        }
      }
    },
    "dataDirectoryUnavailability.whatToCheck.running" : {
      "comment" : "What to check when the library's files could not come from a cloud service. %@ is the service's name, or \"the cloud service\" when it is unknown. Try Again is the name of a button on the same screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تأكد من أن %@ قيد التشغيل وأن هذا الـ Mac متصل بالإنترنت، ثم اختر “إعادة المحاولة”."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ চালু আছে কি না এবং এই Mac অনলাইনে আছে কি না দেখুন, তারপর “আবার চেষ্টা করুন” বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Prüfe, ob bei %@ alles läuft und dieser Mac online ist, und wähle dann „Erneut versuchen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check that %@ is running and that this Mac is online, then choose Try Again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Comprueba que %@ se esté ejecutando y que esta Mac tenga conexión, y luego elige Reintentar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بررسی کنید که %@ در حال اجرا باشد و این Mac آنلاین باشد، سپس «تلاش دوباره» را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vérifiez que %@ fonctionne et que ce Mac est en ligne, puis choisissez Réessayer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בדוק אם %@ פועל ואם ה-Mac הזה מחובר לאינטרנט, ואז בחר “נסה שוב”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "जाँचें कि %@ चल रहा है और यह Mac ऑनलाइन है, फिर “फिर से प्रयास करें” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pastikan %@ berjalan dan Mac ini online, lalu pilih Coba Lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Controlla che %@ sia in esecuzione e che questo Mac sia online, poi scegli Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@が起動していて、この Mac がオンラインであることを確認してから、「再試行」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@이(가) 실행 중이고 이 Mac이 온라인 상태인지 확인한 다음 다시 시도를 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Controleer of %@ actief is en of deze Mac online is, en kies dan Probeer opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sprawdź, czy %@ działa i czy ten komputer Mac jest online, a następnie wybierz Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Verifique se %@ está em execução e se este Mac está conectado à internet; depois, escolha Tentar novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Проверьте, что %@ работает и что этот Mac подключён к интернету, затем выберите «Повторить попытку»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kontrollera att %@ körs och att den här Mac-datorn är online, och välj sedan Försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตรวจสอบว่า %@ ทำงานอยู่และ Mac เครื่องนี้ออนไลน์ แล้วเลือก ลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ çalışıyor mu, bu Mac çevrimiçi mi, denetleyin; sonra “Tekrar Dene” düğmesini seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Перевірте, чи %@ запущено і чи цей Mac має доступ до інтернету, а потім виберіть «Повторити»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یقینی بنائیں کہ %@ چل رہا ہے اور یہ Mac آن لائن ہے، پھر “دوبارہ کوشش کریں” منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kiểm tra xem %@ có đang chạy và máy Mac này có trực tuyến không, rồi chọn Thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "请检查 %@ 是否正在运行以及这台 Mac 是否已联网，然后选取“重试”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "請檢查 %@ 是否正在執行，以及這部 Mac 是否已連線，然後選擇「重試」。"
          }
        }
      }
    },
    "dataDirectoryUnavailable.anotherFolderPointer" : {
      "comment" : "Sentence on the Library Not Available screen that points to the way to another library. Settings and Storage are the names of the settings window and its tab; %1$@ and %2$@ are the names of two buttons in Storage settings, as they show them.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لاستخدام مجلد آخر، افتح الإعدادات، ثم التخزين، واختر %@ أو %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "অন্য ফোল্ডার ব্যবহার করতে সেটিংস, স্টোরেজ খুলুন এবং “%1$@” বা “%2$@” বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um einen anderen Ordner zu verwenden, öffne die Einstellungen, wähle „Speicher“ und dann %1$@ oder %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To use another folder, open Settings, Storage, and choose %@ or %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para usar otra carpeta, abre Almacenamiento en Ajustes y elige %1$@ o %2$@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "برای استفاده از پوشه‌ای دیگر، تنظیمات و سپس ذخیره‌سازی را باز کنید و %1$@ یا %2$@ را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pour utiliser un autre dossier, ouvrez Réglages, Stockage, et choisissez %1$@ ou %2$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כדי להשתמש בתיקייה אחרת, פתח את הלשונית “אחסון” בהגדרות, ואז בחר “%1$@” או “%2$@”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "किसी दूसरे फ़ोल्डर का उपयोग करने के लिए, सेटिंग, संग्रहण खोलें, और “%1$@” या “%2$@” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Untuk memakai folder lain, buka Pengaturan, Penyimpanan, dan pilih %1$@ atau %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Per usare un’altra cartella, apri Impostazioni, Archiviazione e scegli %@ o %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "別のフォルダを使うには、「設定」の「ストレージ」を開き、「%1$@」または「%2$@」を選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "다른 폴더를 사용하려면 설정에서 저장 공간을 열고 %1$@ 또는 %2$@을(를) 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Om een andere map te gebruiken, open je Opslag in Instellingen en kies je %1$@ of %2$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aby użyć innego folderu, otwórz Ustawienia, przejdź do sekcji Pamięć i wybierz %1$@ lub %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para usar outra pasta, abra Ajustes, Armazenamento e escolha %1$@ ou %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Чтобы использовать другую папку, откройте «Настройки», «Хранилище» и выберите «%1$@» или «%2$@»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "För att använda en annan mapp, öppna ”Inställningar”, ”Lagring”, och välj %1$@ eller %2$@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หากต้องการใช้โฟลเดอร์อื่น ให้เปิดการตั้งค่า ที่เก็บข้อมูล แล้วเลือก %@ หรือ %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Başka bir klasör kullanmak için Ayarları açın, Depolama sekmesini seçin ve “%1$@” veya “%2$@” seçeneğini seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Щоб використати іншу папку, відкрийте «Налаштування», вкладку «Сховище» і виберіть «%1$@» або «%2$@»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کوئی اور فولڈر استعمال کرنے کے لیے ترتیبات کھولیں، اسٹوریج میں جائیں، اور “%1$@” یا “%2$@” منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Để dùng thư mục khác, mở Cài đặt, Bộ nhớ, và chọn %1$@ hoặc %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "要使用其他文件夹，请打开“设置”的“存储”，然后选取 %1$@ 或 %2$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "若要使用其他檔案夾，請打開「設定」，選擇「儲存空間」，然後選擇 %1$@ 或 %2$@。"
          }
        }
      }
    },
