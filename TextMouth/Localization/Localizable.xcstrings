        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sekcja (%1$@) zaczyna się na pozycji %2$@ pliku „%3$@”, przed wcześniejszą sekcją (%4$@), która zaczyna się na pozycji %5$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O %1$@ começa aos %2$@ de “%3$@”, antes do %4$@ anterior, que começa aos %5$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В аудиокниге %1$@ начинается на отметке %2$@ файла «%3$@», то есть раньше, чем %4$@, который идёт в книге раньше и начинается на отметке %5$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sektionen med %@ börjar %@ in i ”%@”, före den tidigare sektionen med %@, som börjar %@ in."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ เริ่มที่ %2$@ ของ “%3$@” ก่อน %4$@ ที่อยู่ก่อนหน้า ซึ่งเริ่มที่ %5$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@, “%3$@” dosyasında %2$@ konumunda başlıyor, ama kitapta daha önce gelen %4$@, %5$@ konumunda başlıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ починається через %2$@ від початку файлу «%3$@», хоча раніше в книзі йде %4$@, що починається через %5$@."
          }
