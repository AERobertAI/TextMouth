    "feed.itemPolicyQuietNote" : {
      "comment" : "The note under the List and download controls: when a change takes effect. %@ is the name of the List and download choice.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تتبع القائمة تغيير %@ فورًا؛ أما ما يُنزَّل أو يُزال فينتظر إلى أن يمضي على التغيير عشر ثوانٍ، ثم يعلنه VoiceOver."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ বদলালে তালিকা তখনই তা অনুসরণ করে; কী ডাউনলোড হবে বা সরানো হবে, তা বদলটি দশ সেকেন্ড টিকে থাকা পর্যন্ত অপেক্ষা করে, আর তখন VoiceOver তা জানায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Liste folgt einer Änderung von %@ sofort; was heruntergeladen wird oder entfällt, wartet, bis die Änderung zehn Sekunden bestanden hat, und VoiceOver sagt es dann an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The list follows a change of %@ at once; what downloads or goes waits until the change has stayed for ten seconds, and VoiceOver announces it then."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La lista sigue de inmediato un cambio de %@; lo que se descarga o se elimina espera a que el cambio lleve diez segundos, y VoiceOver lo anuncia entonces."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فهرست بی‌درنگ از تغییر %@ پیروی می‌کند؛ آنچه بارگیری می‌شود یا برداشته می‌شود تا ده ثانیه پس از ماندگار شدن تغییر منتظر می‌ماند و VoiceOver آن زمان آن را اعلام می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La liste suit tout de suite un changement de %@ ; ce qui se télécharge ou disparaît attend que le changement soit resté dix secondes, puis VoiceOver l’annonce."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הרשימה מתעדכנת מיד לפי שינוי ב“%@”; הורדות והסרות ממתינות עד שהשינוי נשאר בתוקף עשר שניות, ואז VoiceOver מכריז עליו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सूची “%@” के बदलाव का तुरंत पालन करती है; क्या डाउनलोड होता है या हटता है, यह तब होता है जब बदलाव दस सेकंड तक बना रहे, और VoiceOver तब उसकी घोषणा करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Daftar langsung mengikuti perubahan %@; apa yang diunduh atau dihapus menunggu sampai perubahan bertahan selama sepuluh detik, lalu VoiceOver mengumumkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’elenco segue subito una modifica di %@; ciò che viene scaricato o rimosso attende che la modifica resti invariata per dieci secondi, e VoiceOver lo annuncia allora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」を変更すると、一覧にはすぐに反映されます。ダウンロードされるものや削除されるものは、変更から10秒間そのままになるまで待ち、そのときに VoiceOver が読み上げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@을(를) 바꾸면 목록에 즉시 반영됩니다. 다운로드되거나 사라지는 항목은 변경이 10초 동안 유지된 다음 처리되며, 그때 VoiceOver가 알려 줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De lijst volgt een wijziging van %@ meteen; wat wordt gedownload of verdwijnt, wacht tot de wijziging tien seconden van kracht is, en VoiceOver kondigt het dan aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lista od razu uwzględnia zmianę ustawienia %@; to, co ma być pobrane lub usunięte, czeka, aż zmiana utrzyma się przez dziesięć sekund, a wtedy VoiceOver ją ogłasza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A lista acompanha uma mudança de %@ imediatamente; o que é baixado ou removido espera até a mudança permanecer por dez segundos, e o VoiceOver a anuncia nesse momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Список меняется сразу при изменении параметра %@; загрузка и удаление ждут, пока изменение не продержится десять секунд, и тогда VoiceOver объявляет о них."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Listan följer en ändring av %@ direkt; det som hämtas eller tas bort väntar tills ändringen har stått kvar i tio sekunder, och då meddelar VoiceOver det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "รายการจะเปลี่ยนตามการเปลี่ยน %@ ทันที สิ่งที่ดาวน์โหลดหรือถูกนำออกจะรอจนกว่าการเปลี่ยนจะคงอยู่สิบวินาที แล้ว VoiceOver จะประกาศ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Liste, %@ ayarındaki bir değişikliği hemen izler; indirilecekler ve kaldırılacaklar ise değişiklik on saniye boyunca aynı kalana kadar bekler ve VoiceOver bunları o zaman duyurur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Список одразу відображає зміну параметра «%@»; те, що завантажується або видаляється, чекає, поки зміна не триватиме десять секунд, і тоді VoiceOver оголошує її."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فہرست %@ کی تبدیلی کے ساتھ فوراً بدل جاتی ہے؛ جو ڈاؤن لوڈ ہوتا ہے یا ہٹتا ہے وہ اس وقت تک انتظار کرتا ہے جب تک تبدیلی دس سیکنڈ تک قائم نہ رہے، اور VoiceOver اسی وقت اس کا اعلان کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Danh sách theo kịp thay đổi của %@ ngay lập tức; những gì được tải về hoặc bị gỡ đi sẽ chờ đến khi thay đổi giữ nguyên mười giây, và VoiceOver sẽ thông báo vào lúc đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "列表会随“%@”的更改立即更新；要下载或移除的内容会等到更改保持十秒后再处理，届时 VoiceOver 会播报。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "列表會立即跟隨「%@」的更改；要下載或移除的內容會等到更改維持十秒後才處理，屆時 VoiceOver 會宣布。"
          }
        }
      }
    },
