    "storageLocation.useDefaultHint" : {
      "comment" : "VoiceOver hint of the Use Default Location button in Storage settings. ~/.TextMouth is the default folder's path and stays as written.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يفتح المكتبة في الموقع الافتراضي، ~/.TextMouth، أو يبدأ مكتبة جديدة هناك، بدلًا من المكتبة غير المتاحة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "যে লাইব্রেরি উপলব্ধ নেই তার বদলে ডিফল্ট অবস্থান ~/.TextMouth-এর লাইব্রেরি খোলে, বা সেখানে নতুন একটি শুরু করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffnet die Bibliothek am Standardort ~/.TextMouth oder legt dort eine neue an, statt der nicht verfügbaren Bibliothek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens the library in the default location, ~/.TextMouth, or starts a new one there, instead of the library that isn't available."
          }
        },
