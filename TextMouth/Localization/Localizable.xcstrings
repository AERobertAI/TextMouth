    },
    "The server %@ couldn't be found." : {
      "comment" : "Why a feed item's download failed: no server answers at its address. %@ is the server's host name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se encontró el servidor %@."
