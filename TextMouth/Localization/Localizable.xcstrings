          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo riporta tutti i dati da %@ alla posizione predefinita, %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "すべてのデータを%1$@からデフォルトの場所%2$@に戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@의 모든 데이터를 기본 위치 %2$@(으)로 이동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
