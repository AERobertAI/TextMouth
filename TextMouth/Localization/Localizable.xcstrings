          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "无法从 iCloud 下载“%@”。请检查连接，然后再次添加。"
          }
        }
      }
    },
    "“%@” couldn't be read: %@." : {
