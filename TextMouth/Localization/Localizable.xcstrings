        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ no tiene palabras, así que el cursor está %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ n’a aucun mot, le curseur est donc %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ non contiene parole, quindi il cursore è %@."
          }
