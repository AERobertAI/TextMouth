    "textEncoding.extractionRefusal" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. Why a book can't be read again while the library's text is being read again (the launch batch, Redo Text Extraction), in the words TextMouth uses while its storage work is held (StorageBusyError).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعيد TextMouth قراءة نص المكتبة. حاول مرة أخرى عند انتهاء ذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth লাইব্রেরির টেক্সট আবার পড়ছে। সেটি শেষ হলে আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth liest gerade den Text der Bibliothek erneut. Versuche es erneut, wenn das beendet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth is reading the library's text again. Try again when that finishes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth está volviendo a leer el texto de la biblioteca. Inténtalo de nuevo cuando termine."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth در حال خواندن دوباره‌ی متن کتابخانه است. پس از پایان آن دوباره تلاش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth relit le texte de la bibliothèque. Réessayez quand ce sera terminé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth קורא שוב את הטקסט של הספרייה. נסה שוב כשזה יסתיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth लाइब्रेरी का टेक्स्ट फिर से पढ़ रहा है। इसके पूरा होने पर फिर से प्रयास करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth sedang membaca ulang teks pustaka. Coba lagi setelah selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth sta rileggendo il testo della libreria. Riprova quando ha finito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth はライブラリのテキストを読み込み直しています。完了してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 보관함의 텍스트를 다시 읽는 중입니다. 완료되면 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth leest de tekst van de bibliotheek opnieuw. Probeer het opnieuw als dat klaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ponownie odczytuje tekst biblioteki. Spróbuj ponownie po zakończeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
