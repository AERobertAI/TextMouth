    "audioSampleForm.refusal" : {
      "comment" : "Refuses an audio file whose samples TextMouth can't decode, which is not damaged. %1$@ is the file's name and %2$@ its sample form, such as \"64-bit integer\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يستخدم “%1$@” عينات %2$@ لا يستطيع TextMouth تشغيلها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” %2$@ স্যাম্পল ব্যবহার করে, যা TextMouth চালাতে পারে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%1$@“ verwendet %2$@-Samples, die TextMouth nicht wiedergeben kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” uses %@ samples, which TextMouth can't play."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” usa muestras %2$@, que TextMouth no puede reproducir."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%1$@» از نمونه‌های %2$@ استفاده می‌کند که TextMouth نمی‌تواند پخش کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "« %1$@ » utilise des échantillons %2$@, que TextMouth ne peut pas lire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” משתמש בדגימות %2$@, ש-TextMouth אינו יכול לנגן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” में %2$@ सैंपल हैं, जिन्हें TextMouth नहीं चला सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” memakai sampel %2$@, yang tidak dapat diputar TextMouth."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” usa campioni %2$@, che TextMouth non può riprodurre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%1$@」は、TextMouth が再生できない%2$@サンプルを使っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@”은(는) TextMouth가 재생할 수 없는 %2$@ 샘플을 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” gebruikt samples van %2$@, die TextMouth niet kan afspelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%1$@” używa próbek %2$@, których TextMouth nie może odtworzyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” usa amostras %2$@, que o TextMouth não consegue reproduzir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%1$@» использует отсчёты (%2$@), которые TextMouth не может воспроизвести."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "”%1$@” använder sampel av typen %2$@, som TextMouth inte kan spela upp."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” ใช้ข้อมูลเสียงแบบ%2$@ ซึ่ง TextMouth เล่นไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@”, TextMouth'un oynatamadığı %2$@ örnekler kullanıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Семпли у файлі «%1$@» — %2$@, а такі TextMouth не може відтворити."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” میں %2$@ سیمپلز ہیں، جنہیں TextMouth نہیں چلا سکتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” dùng mẫu %2$@, mà TextMouth không thể phát."
          }
        },
        "zh-Hans" : {
