    "Playback stopped because TextMouth's memory grew to %@ GB while the audio played, a fault in macOS's audio." : {
      "comment" : "Message on the Mac when playback was stopped because the app's memory kept growing. %@ is the memory reached, a number such as 3.2, before \"GB\" (gigabytes); macOS is the name of the Mac's system.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La reproducción se detuvo porque la memoria de TextMouth creció hasta %@ GB mientras sonaba el audio, un fallo del audio de macOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Riproduzione interrotta perché la memoria di TextMouth è arrivata a %@ GB durante la riproduzione dell’audio, un difetto dell’audio di macOS."
          }
        }
      }
    },
    "Playback stopped because TextMouth's memory grew to %@ GB while the audio played, a fault in the system's audio." : {
      "comment" : "Message on the iPhone when playback was stopped because the app's memory kept growing. %@ is the memory reached, a number such as 3.2, before \"GB\" (gigabytes).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La reproducción se detuvo porque la memoria de TextMouth creció hasta %@ GB mientras sonaba el audio, un fallo del audio del sistema."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Riproduzione interrotta perché la memoria di TextMouth è arrivata a %@ GB durante la riproduzione dell’audio, un difetto dell’audio del sistema."
          }
        }
      }
    },
    "Playback stopped: the audio stopped responding. Press Play to try again; if it stops again, quit and reopen TextMouth." : {
      "comment" : "Message when playback was stopped because the system's audio stopped responding. Play is the name of a button; TextMouth is the app's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La reproducción se detuvo: el audio dejó de responder. Pulsa Reproducir para volver a intentarlo; si se detiene otra vez, cierra TextMouth y ábrelo de nuevo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Riproduzione interrotta: l’audio ha smesso di rispondere. Premi Riproduci per riprovare; se si interrompe di nuovo, esci da TextMouth e riaprilo."
          }
        }
      }
    },
