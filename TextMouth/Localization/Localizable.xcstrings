                  "value" : "يعرض أحدث %lld مما لم تشغّله، وكل تنزيل. لا ينزّل إلا ما تطلبه؛ وتحتفظ الباقية بسجلاتها وتعود عندما تعرض المزيد."
                }
              }
            }
          }
        },
        "bn" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "আপনি চালাননি এমন সবচেয়ে নতুন %lldটি পর্ব এবং সব ডাউনলোড তালিকাভুক্ত করে। শুধু আপনি যা চান তা ডাউনলোড করে; বাকিগুলোর রেকর্ড থেকে যায়, আর আপনি বেশি তালিকাভুক্ত করলে সেগুলো ফিরে আসে।"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "আপনি চালাননি এমন সবচেয়ে নতুন %lldটি পর্ব এবং সব ডাউনলোড তালিকাভুক্ত করে। শুধু আপনি যা চান তা ডাউনলোড করে; বাকিগুলোর রেকর্ড থেকে যায়, আর আপনি বেশি তালিকাভুক্ত করলে সেগুলো ফিরে আসে।"
                }
              }
            }
          }
        },
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Listet den neuesten Eintrag, den du noch nicht wiedergegeben hast, und alle Downloads. Lädt nur herunter, was du anforderst; die übrigen bleiben gespeichert und kommen zurück, wenn du mehr auflistest."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Listet die neuesten %lld, die du noch nicht wiedergegeben hast, und alle Downloads. Lädt nur herunter, was du anforderst; die übrigen bleiben gespeichert und kommen zurück, wenn du mehr auflistest."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Lists the newest %lld you haven't played, and every download. Downloads only what you ask for; the others keep their records and return when you list more."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
