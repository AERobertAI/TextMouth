    },
    "The refused text begins here, at character %@." : {
      "comment" : "A line of the speech refusal report, just before the refused text. %@ is the character offset where it begins, written without digit grouping.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto rechazado empieza aquí, en el carácter %@."
          }
        }
      }
    },
    "The refused text ends here, at character %@." : {
      "comment" : "A line of the speech refusal report, just after the refused text. %@ is the character offset where it ends, written without digit grouping.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto rechazado termina aquí, en el carácter %@."
          }
        }
      }
    },
    "The refused text goes on past this passage, to character %@." : {
      "comment" : "A line of the speech refusal report: the refused text goes on past the passage shown. %@ is the character offset where it ends, written without digit grouping.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto rechazado continúa después de este pasaje, hasta el carácter %@."
          }
