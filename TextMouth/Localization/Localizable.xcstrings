    "storage.cantMadeBecause" : {
      "comment" : "Why the chosen location can't be used: the folder that would hold it is missing. %1$@ is the chosen path; %2$@ is the missing folder's path.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّر إنشاء %@ لأن المجلد الذي سيحتويه، %@، غير موجود."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ তৈরি করা যাবে না, কারণ যে ফোল্ডারে এটি থাকত, সেই %2$@ খুঁজে পাওয়া যাচ্ছে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ kann nicht erstellt werden, weil der Ordner dafür, %2$@, nicht gefunden wird."
          }
