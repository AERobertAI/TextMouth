    },
    "This book keeps its original audio until the book is removed." : {
      "comment" : "Said as a book's original audio policy is set to keep the original until the book is removed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieses Buch bewahrt sein Originalaudio auf, bis das Buch entfernt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este libro conserva su audio original hasta que se quita el libro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo libro conserva il suo audio originale finché il libro non viene rimosso."
          }
        }
      }
    },
    "This book keeps no original audio: saved edits change its audio in place, and can't be undone after." : {
      "comment" : "Said as a book's original audio policy is set to keep no original.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieses Buch bewahrt kein Originalaudio auf: Gesicherte Bearbeitungen ändern sein Audio direkt und können danach nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
