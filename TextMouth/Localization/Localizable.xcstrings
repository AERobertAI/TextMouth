    "sync.sectionSummary" : {
      "comment" : "Explains the Sync section: the library stays the same on the Mac and the iPhone, through iCloud Drive.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تُبقي كتبك ومواضع قراءتك وإشاراتك المرجعية متطابقة على الـ Mac وعلى الـ iPhone، عبر iCloud Drive."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive-এর মাধ্যমে আপনার Mac ও iPhone-এ আপনার বই, পড়ার অবস্থান ও বুকমার্ক এক রাখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hält deine Bücher, Lesepositionen und Lesezeichen auf Mac und iPhone gleich, über iCloud Drive."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps your books, places, and bookmarks the same on your Mac and iPhone, through iCloud Drive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mantiene tus libros, posiciones de lectura y marcadores iguales en tu Mac y tu iPhone, mediante iCloud Drive."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب‌ها، موقعیت‌های مطالعه و نشانک‌های شما را از طریق iCloud Drive در Mac و iPhone یکسان نگه می‌دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Garde vos livres, vos positions de lecture et vos signets identiques sur votre Mac et votre iPhone, grâce à iCloud Drive."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "שומר על אותם ספרים, מיקומי קריאה וסימניות ב-Mac וב-iPhone שלך, דרך iCloud Drive."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive के ज़रिए आपकी पुस्तकें, पठन स्थितियाँ और बुकमार्क आपके Mac और iPhone पर एक जैसे रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menjaga buku, posisi baca, dan markah Anda tetap sama di Mac dan iPhone, lewat iCloud Drive."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mantiene uguali i tuoi libri, le posizioni di lettura e i segnalibri su Mac e iPhone, tramite iCloud Drive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive を使って、Mac と iPhone で、ブック、読み取り位置、ブックマークを同じ状態に保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive를 통해 Mac과 iPhone에서 책, 읽기 위치, 북마크를 똑같이 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Houdt je boeken, leesposities en bladwijzers gelijk op je Mac en iPhone, via iCloud Drive."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Utrzymuje takie same książki, pozycje czytania i zakładki na komputerze Mac i na urządzeniu iPhone, przez iCloud Drive."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mantém seus livros, posições de leitura e marcadores iguais no seu Mac e no seu iPhone, pelo iCloud Drive."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Поддерживает одинаковыми ваши книги, позиции чтения и закладки на Mac и iPhone через iCloud Drive."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Håller dina böcker, läspositioner och bokmärken likadana på din Mac och iPhone, via iCloud Drive."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ทำให้หนังสือ ตำแหน่งการอ่าน และที่คั่นหน้าของคุณเหมือนกันบน Mac และ iPhone ผ่าน iCloud Drive"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive aracılığıyla kitaplarınızı, okuma konumlarınızı ve yer imlerinizi Mac ve iPhone'unuzda aynı tutar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Підтримує однаковими ваші книги, позиції читання та закладки на Mac і iPhone через iCloud Drive."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive کے ذریعے آپ کی کتابیں، مطالعے کی پوزیشنیں اور بک مارک آپ کے Mac اور iPhone پر یکساں رکھتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Giữ sách, vị trí đọc và dấu trang của bạn giống nhau trên máy Mac và iPhone, qua iCloud Drive."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "通过 iCloud 云盘，让你的图书、阅读位置和书签在 Mac 和 iPhone 上保持一致。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "透過 iCloud Drive，讓你的書籍、閱讀位置和書籤在 Mac 和 iPhone 上保持一致。"
          }
        }
      }
    },
