    "playbackControls.unitsValue" : {
      "comment" : "What VoiceOver says for the value of the menu that holds separate navigation units. %1$@ is the forward unit and %2$@ the backward unit, each such as \"15 seconds\" or \"Sentence\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "وحدة التنقل للأمام: %1$@؛ وحدة التنقل للخلف: %2$@"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এগিয়ে যাওয়ার নেভিগেশন ইউনিট: %1$@; পিছিয়ে যাওয়ার নেভিগেশন ইউনিট: %2$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Navigationseinheit vorwärts: %1$@; Navigationseinheit rückwärts: %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forward navigation unit: %@; backward navigation unit: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Unidad de navegación hacia adelante: %1$@; unidad de navegación hacia atrás: %2$@"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "واحد پیمایش به جلو: %1$@؛ واحد پیمایش به عقب: %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Unité de navigation avant : %@ ; unité de navigation arrière : %@"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "יחידת ניווט קדימה: %1$@; יחידת ניווט אחורה: %2$@"
          }
        },
        "hi" : {
