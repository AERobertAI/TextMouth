    "interfaceTextFile.outdatedLine" : {
      "comment" : "One line in the list under Interface Language. The first %@ is the ID of a line the person changed (such as common.sleepTimer), the second the language's name. The English the line was written against has changed since, and the person's line still applies.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "راجع السطر %@ في %@. تغيّرت إنجليزيته منذ كتبته، ولا يزال سطرك ساريًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@-এ লাইন %1$@ যাচাই করুন। আপনি লেখার পর এর ইংরেজি বদলে গেছে, এবং আপনার লাইন এখনও প্রযোজ্য।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Prüfen Sie Zeile %@ in %@. Ihr englischer Text hat sich geändert, seit Sie sie geschrieben haben; Ihre Zeile gilt weiterhin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check line %@ in %@. Its English has changed since you wrote it, and your line still applies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Revisa la línea %@ en %@. Su inglés ha cambiado desde que la escribiste, y tu línea sigue aplicándose."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "خط %@ را در %@ بررسی کنید. انگلیسی آن از زمانی که نوشتید تغییر کرده است و خط شما همچنان اعمال می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vérifiez la ligne %@ en %@. Son anglais a changé depuis que vous l’avez écrite, et votre ligne s’applique toujours."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בדוק את השורה %@ ב%@. האנגלית שלה השתנתה מאז שכתבת אותה, והשורה שלך עדיין חלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@ में पंक्ति %1$@ जाँचें। इसकी अंग्रेज़ी आपके लिखने के बाद बदल गई है, और आपकी पंक्ति अब भी लागू है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Periksa baris %@ dalam %@. Bahasa Inggrisnya berubah sejak Anda menulisnya, dan baris Anda masih berlaku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Controlla la riga %@ in %@. Il suo inglese è cambiato da quando l’hai scritta e la tua riga si applica ancora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@の行%1$@を確認してください。英語は書いたあとに変わっていますが、あなたの行は引き続き使われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@의 줄 %1$@을(를) 확인하세요. 영어는 작성한 뒤에 바뀌었지만 내 줄은 계속 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Controleer regel %@ in %@. Het Engels ervan is veranderd sinds je hem schreef, en je regel geldt nog steeds."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sprawdź wiersz %@ w języku %@. Jego angielski tekst zmienił się od czasu, gdy go napisałeś, a Twój wiersz nadal obowiązuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Confira a linha %@ em %@. O inglês dela mudou desde que você a escreveu, e a sua linha continua valendo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Проверьте строку %@ на языке «%@». Её английский текст изменился с тех пор, как вы её написали, а ваша строка по-прежнему действует."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kontrollera raden %@ i %@. Dess engelska har ändrats sedan du skrev den, och din rad gäller fortfarande."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตรวจบรรทัด %@ ใน%@ ข้อความภาษาอังกฤษของบรรทัดนี้เปลี่ยนไปตั้งแต่คุณเขียน และบรรทัดของคุณยังมีผลอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ satırını (%@) denetleyin. İngilizcesi siz yazdıktan sonra değişti ve satırınız hâlâ geçerli."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Перевірте рядок %@ мовою «%@». Його англійський текст змінився відтоді, як ви його написали, а ваш рядок і далі діє."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لائن %@ (%@ میں) جانچیں۔ اس کی انگریزی آپ کے لکھنے کے بعد بدل گئی ہے، اور آپ کی لائن اب بھی لاگو ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hãy kiểm tra dòng %@ trong %@. Tiếng Anh của dòng này đã thay đổi kể từ khi bạn viết, và dòng của bạn vẫn có hiệu lực."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "请检查%2$@中的行 %1$@。其英文在您写下之后已更改，您的行仍然适用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "請檢查%2$@中的行 %1$@。其英文在您寫下之後已變更，您的行仍然適用。"
          }
        }
      }
    },
    "interfaceTextFile.problem.notAFile" : {
      "comment" : "The reason the file of the person's own interface lines could not be used: its name holds something that is not a file (a folder, for example), so the lines already in use stay.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اسم الملف يشير إلى شيء ليس ملفًا، لذا تبقى الأسطر المستخدَمة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফাইলের নামটি এমন কিছুর যা ফাইল নয়, তাই ব্যবহারে থাকা লাইনগুলো থেকে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Name der Datei gehört zu etwas, das keine Datei ist, deshalb bleiben die verwendeten Zeilen bestehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file's name holds something that is not a file, so the lines in use stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El nombre del archivo corresponde a algo que no es un archivo, así que se mantienen las líneas en uso."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نام فایل به چیزی اشاره دارد که فایل نیست، پس خط‌های در حال استفاده می‌مانند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le nom du fichier désigne autre chose qu’un fichier ; les lignes utilisées sont donc conservées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "שם הקובץ מתייחס למשהו שאינו קובץ, ולכן השורות בשימוש נשארות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
