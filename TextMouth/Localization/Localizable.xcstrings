            "value" : "%1$@ در کتابخانه‌ی شما است، اما اشتراکش لغو شده است. برای بررسی دوباره، %2$@ را در ردیف آن یا در %3$@ انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
