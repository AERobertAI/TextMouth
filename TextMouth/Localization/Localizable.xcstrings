          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Открывает настройки конфиденциальности микрофона в Системных настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
