              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Cuando faltan %lld minutos o menos, descarga el siguiente episodio si aún no está en esta Mac"
                }
              }
            }
          }
        }
      }
    },
    "When %lld minutes or less are left, downloads the next item if it is not on this Mac yet" : {
      "comment" : "VoiceOver hint of the Download the next item switch in a feed's Feed Info. %lld is the number of minutes left that start the download.",
      "localizations" : {
