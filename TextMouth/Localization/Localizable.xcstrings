    "bookExport.chapterListChoiceHint.audacity" : {
      "comment" : "The hint of the Headings checkbox in the Export dialog while Audacity labels are chosen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نص كل عنوان رئيسي وبدايته، كتسميات Audacity، لكتاب بملف صوتي واحد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "প্রতিটি হেডিংয়ের শিরোনাম ও শুরু, Audacity লেবেল হিসেবে, একটিমাত্র অডিও ফাইলের বইয়ের জন্য।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Titel und Anfang jeder Überschrift als Audacity-Labels, für ein Buch mit einer Audiodatei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each heading's title and start, as Audacity labels, for a book with one audio file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El título y el inicio de cada encabezado, como etiquetas de Audacity, para un libro con un solo archivo de audio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عنوان و آغاز هر سرفصل، به‌صورت برچسب‌های Audacity، برای کتابی با یک فایل صوتی."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le titre et le début de chaque en-tête, en étiquettes Audacity, pour un livre d’un seul fichier audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "השם וההתחלה של כל כותרת, כתוויות Audacity, לספר עם קובץ שמע אחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "हर हेडिंग का शीर्षक और शुरुआत, Audacity लेबल के रूप में, एक ऑडियो फ़ाइल वाली पुस्तक के लिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Judul dan awal setiap tajuk, sebagai label Audacity, untuk buku dengan satu file audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Titolo e inizio di ogni intestazione, come etichette di Audacity, per un libro con un solo file audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "各見出しのタイトルと開始位置を、Audacity のラベルとして書き出します。オーディオファイルが1つのブック用です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "각 표제의 제목과 시작 위치를 Audacity 레이블로 저장합니다. 오디오 파일이 하나인 책에 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De titel en het begin van elke kop, als Audacity-labels, voor een boek met één audiobestand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tytuł i początek każdego nagłówka, jako etykiety Audacity, dla książki z jednym plikiem audio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O título e o início de cada cabeçalho, como rótulos do Audacity, para um livro com um único arquivo de áudio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Название и начало каждого заголовка в виде меток Audacity для книги с одним аудиофайлом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Varje rubriks titel och starttid, som Audacity-etiketter, för en bok med en ljudfil."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ชื่อและจุดเริ่มต้นของแต่ละหัวข้อ เป็นป้ายกำกับ Audacity สำหรับหนังสือที่มีไฟล์เสียงไฟล์เดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Her başlığın metni ve başlangıcı, tek ses dosyalı bir kitap için Audacity etiketleri olarak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Назва й початок кожного заголовка як мітки Audacity, для книги з одним аудіофайлом."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ہر سرخی کا عنوان اور آغاز، Audacity لیبلز کی صورت میں، ایک آڈیو فائل والی کتاب کے لیے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tiêu đề và điểm bắt đầu của mỗi đề mục, dưới dạng nhãn Audacity, cho sách có một tệp âm thanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "每个章节标题的文字和起点，存为 Audacity 标签，适用于只有一个音频文件的图书。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "將每個標題的文字和起點寫成 Audacity 標籤，適用於只有一個音訊檔案的書籍。"
          }
        }
      }
    },
