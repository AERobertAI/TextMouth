          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ditempatkan %@ pada %@ dan %@ pada %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
