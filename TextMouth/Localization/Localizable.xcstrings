            "value" : "এতে ফিড %@-এর ফোল্ডারগুলো আছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Er enthält die Ordner der Feeds %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It holds the folders of the feeds %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Contiene las carpetas de los canales %@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پوشه‌های فیدهای %@ را در خود دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il contient les dossiers des flux %@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "היא מכילה את תיקיות הערוצים %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसमें फ़ीड %@ के फ़ोल्डर हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Folder itu berisi folder dari feed %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Contiene le cartelle dei feed %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フィード%@のフォルダが含まれています。"
          }
        },
        "ko" : {
          "stringUnit" : {
