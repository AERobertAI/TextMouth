    "audioEditor.chapterExplanation" : {
      "comment" : "Explains the title field of the audio editor's Insert Chapter Marker sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عنوان لعلامة فصل عند المؤشر. إذا وُجدت علامة هناك، تتم إعادة تسميتها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "কার্সরের জায়গার অধ্যায় মার্কারের শিরোনাম। সেখানে একটি থাকলে তার নাম বদলে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Titel für eine Kapitelmarke am Cursor. Eine vorhandene wird umbenannt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Title for a chapter marker at the cursor. One already there is renamed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Título de una marca de capítulo en el cursor. Si ya hay una, se renombra."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عنوان برای علامت فصل در محل مکان‌نما. اگر یکی از قبل آنجا باشد، نام آن تغییر می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Titre d’un marqueur de chapitre au curseur. S’il y en a déjà un, il est renommé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כותרת לנקודת ציון של פרק בסמן. אם כבר יש שם אחת, שמה משתנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कर्सर पर अध्याय मार्कर का शीर्षक। वहाँ पहले से मौजूद मार्कर का नाम बदल दिया जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Judul penanda bab di posisi kursor. Penanda yang sudah ada di sana akan diganti namanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Titolo per un marcatore di capitolo nella posizione del cursore. Se ce n’è già uno, viene rinominato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "カーソルの位置のチャプタマーカーのタイトルです。すでにある場合は名前が変更されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "커서 위치에 놓을 챕터 마커의 제목입니다. 이미 있으면 이름이 변경됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Titel voor een hoofdstukmarkering bij de cursor. Een markering die er al staat, krijgt deze titel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tytuł znacznika rozdziału przy kursorze. Istniejący znacznik w tym miejscu zostanie przemianowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Título de uma marca de capítulo no cursor. Se já houver uma ali, ela é renomeada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Название метки главы в позиции курсора. Уже существующая метка будет переименована."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Titel för ett kapitelmärke vid markören. Ett som redan finns där byter namn."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ชื่อของเครื่องหมายบทที่เคอร์เซอร์ หากมีอยู่แล้วจะเปลี่ยนชื่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "İmleç konumundaki bir bölüm işaretinin başlığı. Orada zaten varsa yeniden adlandırılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Назва мітки розділу в місці курсора. Наявну мітку буде перейменовано."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کرسر پر باب مارکر کا عنوان۔ وہاں پہلے سے موجود ہو تو اس کا نام بدل دیا جاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tiêu đề cho điểm đánh dấu chương tại con trỏ. Điểm đã có ở đó sẽ được đổi tên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "光标处章节标记的标题。已有的章节标记会被重新命名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "游標處章節標記的標題。若該處已有章節標記，會將它重新命名。"
          }
        }
      }
    },
    "audioEditor.chapterMarkersNotWritten" : {
