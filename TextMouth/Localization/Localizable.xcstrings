    "storageWorkWait.sentence.savesMoveEnds" : {
      "comment" : "Why a failed save waits: it runs when the move of the data directory ends. \"Them\" is the changes that could not be saved.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحفظها TextMouth بمجرد انتهاء نقل مجلد بياناته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ডেটা ডিরেক্টরির স্থানান্তর শেষ হলে TextMouth সেগুলো সংরক্ষণ করবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
