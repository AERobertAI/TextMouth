    "audioEditingSettings.presetsHint" : {
      "comment" : "Hint of the Filter Presets button in Storage settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يفتح الإعدادات المسبقة للمرشحات، للتحرير أو الإضافة أو إعادة الترتيب أو الحذف أو إعادة الضبط."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফিল্টার প্রিসেট খোলে, যেখানে সম্পাদনা, যোগ, ক্রম পরিবর্তন, মোছা বা রিসেট করা যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffnet die Filtervoreinstellungen, um sie zu bearbeiten, hinzuzufügen, umzusortieren, zu löschen oder zurückzusetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens the filter presets, to edit, add, reorder, delete, or reset."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre los preajustes de filtros, para editarlos, agregarlos, reordenarlos, eliminarlos o restablecerlos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پیش‌تنظیم‌های فیلتر را باز می‌کند تا ویرایش، اضافه، مرتب، حذف یا بازنشانی کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ouvre les préréglages de filtre, pour les modifier, ajouter, réorganiser, supprimer ou rétablir."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "פותח את ההגדרות המוכנות של מסננים, לעריכה, להוספה, לשינוי סדר, למחיקה או לאיפוס."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़िल्टर प्रीसेट खोलता है; इन्हें संपादित करने, जोड़ने, क्रम बदलने, मिटाने या रीसेट करने के लिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuka preset filter, untuk mengedit, menambah, mengurutkan ulang, menghapus, atau menyetel ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apre i preset dei filtri, per modificarli, aggiungerli, riordinarli, eliminarli o ripristinarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フィルタプリセットを開き、編集、追加、並べ替え、削除、リセットができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "필터 프리셋을 열어 편집, 추가, 순서 변경, 삭제, 재설정을 할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Opent de filtervoorinstellingen, om te wijzigen, toe te voegen, te herschikken, te verwijderen of opnieuw in te stellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Otwiera ustawienia wstępne filtrów, aby je edytować, dodawać, zmieniać ich kolejność, usuwać lub przywracać domyślne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre as predefinições de filtro, para editar, adicionar, reordenar, excluir ou restaurar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Открывает пресеты фильтров: их можно изменить, добавить, переупорядочить, удалить или сбросить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öppnar filterförinställningarna, för att redigera, lägga till, ordna om, radera eller återställa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เปิดค่าที่ตั้งไว้ล่วงหน้าของตัวกรอง เพื่อแก้ไข เพิ่ม จัดลำดับใหม่ ลบ หรือรีเซ็ต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Filtre hazır ayarlarını açar; düzenlemek, eklemek, yeniden sıralamak, silmek veya sıfırlamak için."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відкриває пресети фільтрів, щоб редагувати, додавати, змінювати порядок, видаляти або скидати їх."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فلٹر پری سیٹس کھولتا ہے، تاکہ ان میں ترمیم، اضافہ، ترتیب میں تبدیلی، حذف یا ری سیٹ کیا جا سکے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mở các giá trị đặt sẵn của bộ lọc, để sửa, thêm, sắp xếp lại, xóa hoặc đặt lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "打开滤波器预设，以便编辑、添加、重新排序、删除或重置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "打開濾波器預設組合，可編輯、加入、重新排序、刪除或重置。"
          }
        }
      }
    },
    "audioEditingSettings.previewFiltersHint" : {
      "comment" : "Hint of the Preview filters before applying switch in Storage settings. Apply Filter and Apply are the audio editor's command and button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يشغّل “تطبيق مرشح” معاينة أولًا، ثم يطبّق المرشح عند اختيار “تطبيق” مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“ফিল্টার প্রয়োগ” আগে একটি প্রিভিউ চালায়, এবং আপনি আবার “প্রয়োগ করুন” বেছে নিলে প্রয়োগ করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„Filter anwenden“ gibt zuerst eine Vorschau wieder und wendet den Filter an, wenn du erneut „Anwenden“ wählst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply Filter plays a preview first, and applies when you choose Apply again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aplicar filtro reproduce primero una vista previa y aplica el filtro cuando eliges Aplicar de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«اعمال فیلتر» ابتدا پیش‌نمایشی پخش می‌کند و وقتی دوباره «اعمال» را انتخاب کنید، فیلتر را اعمال می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Appliquer le filtre lit d’abord un aperçu, puis applique le filtre quand vous choisissez Appliquer à nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“החל מסנן” מנגן תחילה תצוגה מקדימה, ומחיל את המסנן כשתבחר שוב ב“החל”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“फ़िल्टर लागू करें” पहले पूर्वावलोकन चलाता है, और “लागू करें” दोबारा चुनने पर फ़िल्टर लागू करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Terapkan Filter memutar pratinjau terlebih dahulu, dan menerapkan filter saat Anda memilih Terapkan lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il comando Applica filtro riproduce prima un’anteprima e applica il filtro quando scegli di nuovo Applica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「フィルタを適用」は先にプレビューを再生し、もう一度「適用」を選ぶと適用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "필터 적용은 먼저 미리 듣기를 재생하고, 적용을 다시 선택하면 적용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pas filter toe speelt eerst een voorvertoning af en past het filter toe wanneer je opnieuw Pas toe kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zastosuj filtr najpierw odtwarza podgląd, a stosuje filtr, gdy ponownie wybierzesz Zastosuj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aplicar filtro reproduz uma prévia primeiro e aplica quando você escolhe Aplicar de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Команда «Применить фильтр» сначала воспроизводит предварительный фрагмент, а применяет фильтр, когда вы снова выбираете «Применить»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tillämpa filter spelar först upp en förhandsvisning och tillämpar när du väljer Tillämpa igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "คำสั่ง ใช้ตัวกรอง จะเล่นตัวอย่างก่อน และใช้ตัวกรองเมื่อคุณเลือก นำไปใช้ อีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Filtreyi Uygula önce bir önizleme oynatır; Uygula'yı yeniden seçtiğinizde filtreyi uygular."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«Застосувати фільтр» спершу відтворює попередній перегляд, а застосовує, коли ви знову виберете «Застосувати»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“فلٹر لاگو کریں” پہلے پیش منظر چلاتا ہے، اور جب آپ دوبارہ “لاگو کریں” منتخب کریں تب لاگو کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lệnh Áp dụng bộ lọc phát bản nghe thử trước, và chỉ áp dụng khi bạn chọn Áp dụng lần nữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“应用滤波器”会先播放预览，再次选取“应用”后才会应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「套用濾波器」會先播放預覽，再次選擇「套用」時才會套用。"
          }
        }
      }
    },
