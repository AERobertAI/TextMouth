    "passwordProtectedDocument.error.without" : {
      "comment" : "Last sentence of why a password-protected document could not be imported: what to do.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "احفظ نسخة بلا كلمة مرور، ثم استورد تلك النسخة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পাসওয়ার্ড ছাড়া একটি কপি সংরক্ষণ করুন, তারপর সেই কপি আমদানি করুন।"
