    "bookTextEdit.heldReason.nestedTooDeeply.chapter" : {
      "comment" : "Reason after a colon, for a book whose edited text nests one chapter too deeply; begins in lower case. %1$@ is the chapter's number, an identifier written without digit grouping; %2$@ is a clause such as \"nests more than 20 levels deep\", written by another part of the app.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فصله %1$@ %2$@، ولا يستطيع TextMouth قراءته بأمان. بسّط بنيته واحفظ مرة أخرى، أو تراجع عن التغيير، فيُفتح الكتاب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এর অধ্যায় %1$@ %2$@, যা TextMouth নিরাপদে পড়তে পারে না। এটি সমতল করে আবার সংরক্ষণ করুন, বা পরিবর্তনটি পূর্বাবস্থায় ফেরান, তাহলে বইটি খুলবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "sein Kapitel %1$@ %2$@, was TextMouth nicht sicher lesen kann. Verringere die Verschachtelung und sichere erneut oder mache die Änderung rückgängig, dann öffnet sich das Buch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "its chapter %@ %@, which TextMouth can't read safely. Flatten it and save again, or undo the change, and the book opens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "su capítulo %1$@ %2$@, algo que TextMouth no puede leer de forma segura. Simplifícalo y guarda de nuevo, o deshaz el cambio, y el libro se abrirá."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فصل %1$@ آن %2$@ و TextMouth نمی‌تواند آن را با ایمنی بخواند. آن را ساده کنید و دوباره ذخیره کنید، یا تغییر را واگرد کنید، تا کتاب باز شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "son chapitre %@ %@, ce que TextMouth ne peut pas lire en toute sécurité. Réduisez cette imbrication et enregistrez à nouveau, ou annulez la modification, et le livre s’ouvre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הפרק %1$@ שלו %2$@, ש-TextMouth לא יכול לקרוא בבטחה. צמצם את הקינון ושמור שוב, או בטל את השינוי, והספר ייפתח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "उसका अध्याय %1$@ %2$@, जिसे TextMouth सुरक्षित रूप से नहीं पढ़ सकता। उसे सरल करके फिर से सहेजें, या बदलाव पूर्ववत करें, तब पुस्तक खुल जाएगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "bab %1$@ %2$@, yang tidak dapat dibaca TextMouth dengan aman. Ratakan lalu simpan lagi, atau urungkan perubahan, maka buku akan terbuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
