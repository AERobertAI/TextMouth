        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ n’a aucune transcription à rechercher. Transcrivez-le d’abord avec Transcrire l’audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אין ל-%@ תמליל לחיפוש. קודם יש לתמלל אותו באמצעות “תמלל שמע”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ में खोजने के लिए कोई ट्रांसक्रिप्ट नहीं है। पहले “ऑडियो ट्रांसक्राइब करें” से उसे ट्रांसक्राइब करें।"
