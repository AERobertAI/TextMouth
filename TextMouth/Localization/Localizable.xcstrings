    "repeatedSymbolsSettingsView.resetHint" : {
      "comment" : "VoiceOver hint of the button in Settings, Text, Repeated Symbols that restores the standard list of symbols.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يستعيد القائمة المعتادة: رموز ASCII والنقاط النقطية والشرطات ونقاط الحذف وخطوط رسم الإطارات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আদর্শ তালিকা পুনরুদ্ধার করে: ASCII চিহ্ন, বুলেট, ড্যাশ, এলিপসিস এবং বক্স-ড্রয়িং লাইন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stellt die Standardliste wieder her: die ASCII-Symbole, Aufzählungszeichen, Striche, die Auslassungspunkte und Rahmenlinien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restores the standard list: the ASCII symbols, bullets, dashes, the ellipsis, and box-drawing lines"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Restaura la lista estándar: los símbolos ASCII, viñetas, guiones, los puntos suspensivos y las líneas de dibujo de cuadros"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فهرست استاندارد را بازمی‌گرداند: نمادهای ASCII، گلوله‌ها، خط‌تیره‌ها، سه‌نقطه و خطوط جعبه‌ای."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rétablit la liste standard : les symboles ASCII, les puces, les tirets, les points de suspension et les lignes de tracé de cadre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "משחזר את הרשימה הרגילה: סמלי ASCII, תבליטים, מקפים, שלוש נקודות וקווי מסגרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "मानक सूची बहाल करता है: ASCII प्रतीक, बुलेट, डैश, इलिप्सिस और बॉक्स-ड्रॉइंग रेखाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Memulihkan daftar standar: simbol ASCII, butir, tanda pisah, elipsis, dan garis kotak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ripristina l’elenco standard: simboli ASCII, punti elenco, trattini, puntini di sospensione e linee di riquadro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "標準のリストに戻します：ASCII 記号、箇条書きの記号、ダッシュ、省略記号、罫線。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ASCII 기호, 글머리 기호, 대시, 줄임표, 상자 그리기 선으로 된 표준 목록을 복원합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Herstelt de standaardlijst: de ASCII-symbolen, opsommingstekens, streepjes, het beletselteken en lijnen om vakken te tekenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Przywraca standardową listę: symbole ASCII, punktory, myślniki, wielokropek i linie ramek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Restaura a lista padrão: os símbolos ASCII, marcadores, travessões, as reticências e linhas de desenho de caixa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Восстанавливает стандартный список: символы ASCII, маркеры, тире, многоточие и линии для рисования рамок."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Återställer standardlistan: ASCII-symboler, punkter, tankstreck, ellipsen och ramlinjer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "คืนรายการมาตรฐาน: สัญลักษณ์ ASCII จุดนำหน้ารายการ เครื่องหมายขีด จุดไข่ปลา และเส้นกรอบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Standart listeyi geri yükler: ASCII simgeleri, madde işaretleri, tireler, üç nokta ve çerçeve çizgileri."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відновлює стандартний список: символи ASCII, маркери, тире, три крапки та псевдографічні лінії."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "معیاری فہرست بحال کرتا ہے: ASCII علامات، بلٹس، ڈیشز، ایلپسس اور باکس ڈرائنگ لائنیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Khôi phục danh sách chuẩn: các ký hiệu ASCII, dấu đầu dòng, dấu gạch ngang, dấu chấm lửng và các đường kẻ khung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "恢复标准列表：ASCII 符号、项目符号、破折号、省略号和制表线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
