        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il file di identità della libreria è su questo Mac, ma il suo indice, %@, non è arrivato tramite %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo de identidade da biblioteca está neste Mac, mas o índice dela, %1$@, não chegou de %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл идентификатора библиотеки есть на этом Mac, но её индекс, %1$@, не поступил через %2$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл ідентичності бібліотеки є на цьому Mac, але її індекс, %1$@, не надійшов (джерело: %2$@)."
