          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Тепер файл книги називається «%@», бо TextMouth не може записувати в старому форматі."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اب اس کی فائل “%@” ہے، کیونکہ TextMouth اس کا پرانا فارمیٹ نہیں لکھ سکتا۔"
          }
        },
        "vi" : {
