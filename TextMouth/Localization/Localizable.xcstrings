            "value" : "ההחלפה שומרת את מיקום הקריאה, הסימניות, ההגדרות, התיקייה והמקום ברשימת הקריאה של העותק הקיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "बदलने पर मौजूदा प्रति की पठन स्थिति, बुकमार्क, सेटिंग, फ़ोल्डर और रीडिंग लिस्ट में उसकी जगह रखी जाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Penggantian mempertahankan posisi baca, markah, pengaturan, folder, dan posisi salinan yang ada di Daftar Bacaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La sostituzione conserva la posizione di lettura, i segnalibri, le impostazioni, la cartella e la posizione nell’elenco di lettura della copia esistente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "置き換えても、既存のコピーの読み上げ位置、ブックマーク、設定、フォルダ、リーディングリストでの位置は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "대체하면 기존 사본의 읽기 위치, 북마크, 설정, 폴더, 읽기 목록 위치가 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bij vervangen blijven de leespositie, bladwijzers, instellingen, map en plaats op de leeslijst van de bestaande kopie behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zastąpienie zachowuje pozycję czytania, zakładki, ustawienia, folder i miejsce na liście czytelniczej istniejącej kopii."
