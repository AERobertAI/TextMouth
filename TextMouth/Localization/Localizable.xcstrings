    "transcription.transcribeWhileAttaching" : {
      "comment" : "Alert shown when Transcribe Audio is chosen for an audiobook that a transcript is being attached to. %@ is the audiobook's title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يجري إرفاق نسخة نصية بـ%@. فرّغ صوته بعد اكتمال ذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@-এ একটি ট্রান্সক্রিপ্ট সংযুক্ত করা হচ্ছে। সেটি শেষ হলে এটি ট্রান্সক্রাইব করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "An %@ wird gerade ein Transkript angehängt. Transkribiere es, sobald das fertig ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A transcript is being attached to %@. Transcribe it once that finishes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se está adjuntando una transcripción a %@. Transcríbelo cuando termine."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "رونوشتی در حال پیوست شدن به %@ است. پس از پایان کار، صدا را رونویسی کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
