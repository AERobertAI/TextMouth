    "bookExportDeepChapter.cancelHint" : {
      "comment" : "The hint of the Cancel Export button in the alert an export shows when a chapter nests too deeply.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يوقف التصدير بالكامل. تبقى الملفات التي كُتبت بالفعل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পুরো রপ্তানি বন্ধ করে। যেসব ফাইল ইতিমধ্যে লেখা হয়েছে সেগুলো থাকবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppt den gesamten Export. Bereits geschriebene Dateien bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops the whole export. Files already written stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detiene toda la exportación. Los archivos ya escritos se conservan."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کل صادر کردن را متوقف می‌کند. فایل‌هایی که پیش‌تر نوشته شده‌اند می‌مانند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrête toute l’exportation. Les fichiers déjà écrits sont conservés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "עוצר את הייצוא כולו. קבצים שכבר נכתבו נשארים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पूरे निर्यात को रोकता है। लिखी जा चुकी फ़ाइलें बनी रहती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menghentikan seluruh ekspor. File yang sudah ditulis tetap ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe l’intera esportazione. I file già scritti restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "書き出し全体を停止します。書き出し済みのファイルは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "전체 내보내기를 중지합니다. 이미 작성된 파일은 그대로 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stopt de hele export. Bestanden die al zijn geschreven, blijven staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zatrzymuje cały eksport. Pliki, które już zapisano, zostają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe toda a exportação. Os arquivos já gravados permanecem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Останавливает весь экспорт. Уже записанные файлы остаются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppar hela exporten. Redan skrivna filer finns kvar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หยุดการส่งออกทั้งหมด ไฟล์ที่เขียนไปแล้วจะยังอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dışa aktarmanın tamamını durdurur. Önceden yazılan dosyalar kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Зупиняє весь експорт. Уже записані файли залишаються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پوری برآمد روکتا ہے۔ لکھی جا چکی فائلیں برقرار رہتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dừng toàn bộ quá trình xuất. Các tệp đã ghi vẫn được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止整个导出。已写入的文件会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止整個輸出。已寫入的檔案會保留。"
          }
        }
      }
    },
