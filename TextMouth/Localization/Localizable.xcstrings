    "Skip Forward" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Playback group and read by VoiceOver. Moves forward by the current navigation unit, such as a sentence or a paragraph. Also the title of the menu command of the same name.\nTitle of the pop-up in the Playback settings that chooses what the skip forward button moves by."
    },
    "Skip Section" : {
      "comment" : "Name of a heading row's command that makes speech skip the section, as a VoiceOver action and a context menu item."
    },
    "Skip backward unit" : {
      "comment" : "VoiceOver label of the Skip Backward pop-up in the Playback settings."
    },
    "Skip backward: %@" : {
      "comment" : "What VoiceOver says for the playback bar's skip backward button. %@ is the unit it skips by, such as \"15 seconds\" or \"Sentence\"."
    },
    "Skip finished books" : {
      "comment" : "Checkbox of the Reading List's options bar: when a book opened from the list ends, pass over the finished books.",
