    },
    "The file %@ stopped responding." : {
      "comment" : "A sentence telling playback of an audio file stopped responding. %@ is the file's name, such as 03.mp3.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo %@ dejó de responder."
          }
        }
      }
    },
    "The file %@ was stopped because TextMouth's memory grew too large." : {
      "comment" : "A sentence telling TextMouth stopped an audio file to protect the Mac. %@ is the file's name, such as 03.mp3.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo %@ se detuvo porque la memoria de TextMouth creció demasiado."
          }
        }
      }
    },
    "The file could not be read. %@" : {
      "comment" : "Why the library index could not be loaded: a read error. %@ is the system's own description of the error.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo leer el archivo. %@"
          }
