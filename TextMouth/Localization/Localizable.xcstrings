    },
    "With \"%@\", Play on a finished book says it is finished; with \"%@\", Play starts it again from the beginning." : {
      "comment" : "Caption under the When book ends picker in Settings, Playback. %1$@ and %2$@ are the names of two of the picker's choices, as the picker shows them (Stop, and Stop, and Play Starts Over); Play is the reader's Play button.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "With \"%1$@\", Play on a finished book says it is finished; with \"%2$@\", Play starts it again from the beginning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con “%1$@”, Play en un libro terminado avisa que ya está terminado; con “%2$@”, Play lo vuelve a empezar desde el principio."
          }
        }
      }
    },
    "You cleaned it up on %@." : {
      "comment" : "Sentence of Book Information's Transcript detail saying when the user cleaned up the transcript. %@ is a date, such as \"October 5, 2026\"."
    },
    "You cleaned up this transcript on %@. Transcribing again replaces the cleanup." : {
      "comment" : "Line of the Transcribe Audio sheet warning that transcribing again replaces the cleanup the user applied. %@ is a date, such as \"October 5, 2026\"."
    },
    "You edited it on %@." : {
      "comment" : "Sentence of Book Information's Transcript detail saying when the user edited the transcript. %@ is a date, such as \"October 5, 2026\"."
    },
    "You edited the transcript on %@, after the cleanup. Undo Cleanup undoes those edits too." : {
      "comment" : "Line of the Clean Up Transcript sheet warning that undoing the cleanup also undoes the user's later edits. %@ is a date, such as \"October 5, 2026\". Undo Cleanup is the name of a button of the sheet."
    },
    "You edited this transcript on %@. Transcribing again replaces your edits." : {
      "comment" : "Line of the Transcribe Audio sheet warning that transcribing again replaces the user's own edits. %@ is a date, such as \"October 5, 2026\"."
    },
    "Your copy of the rules is empty. Edit Rules… opens it to add some." : {
      "comment" : "Line of the Clean Up Transcript sheet when the user's own rules file holds no rule. Edit Rules… is the name of a button of the sheet."
    },
    "Your copy of the rules is only in the cloud, so TextMouth asked for it and uses its own meanwhile." : {
      "comment" : "Line of the Clean Up Transcript sheet when the user's own rules file has not been downloaded from the cloud drive yet."
    },
    "Your edits to the transcript are deleted too." : {
      "comment" : "Last sentence of the question asked before a transcript is deleted, when the user had edited it."
    },
    "Your edits to the transcript are replaced too." : {
      "comment" : "Sentence of the question asked before a transcript from a file replaces the book's, when the user had edited it."
    },
    "Your library is empty. Add to Library adds a book." : {
      "comment" : "The only row of an empty library. \"Add to Library\" is the name of the button that adds a book, so keep it the same as that button's label."
    },
    "Your rules file can't be used: %@. TextMouth keeps it and a copy, and uses its own rules until you correct it." : {
      "comment" : "Line of the Clean Up Transcript sheet when the user's own rules file is damaged. %@ is the reason, a short technical phrase in English."
    },
    "about %@" : {
      "comment" : "A time estimate, said after \"Time to transcribe:\" or inside a sentence. %@ is a length of time in words, such as \"6 minutes\" or \"1 hour, 5 minutes\"."
    },
    "about 140 MB" : {
      "comment" : "The approximate size of one language's speech model, said in the Download button's label. MB means megabytes."
    },
    "all %lld files" : {
      "comment" : "End of the transcription progress bar's spoken value once every audio file is transcribed, after \"100 percent, \". %lld is the number of files.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "all %lld file"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "all %lld files"
                }
              }
            }
          }
        }
      }
    },
    "downloading" : {
      "comment" : "Status of a language's speech model that is downloading now, said after the language's name in the Transcribe Audio sheet."
    },
    "fading out" : {
      "comment" : "The sleep timer's state as VoiceOver reads it after \"Sleep timer:\" while the timer fades the sound out. Lowercase, since it follows a colon.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "bajando el volumen"
          }
        }
      }
    },
    "file %lld of %lld" : {
      "comment" : "End of the transcription progress bar's spoken value, after \"40 percent, \", saying which audio file is being transcribed. %1$lld is that file's place, from 1; %2$lld is the number of files.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "file %1$lld of %2$lld"
          }
        }
      }
    },
    "installed" : {
      "comment" : "Status of a language's speech model that is on this Mac, said after the language's name in the Transcribe Audio sheet and Settings."
    },
    "less than a minute" : {
      "comment" : "A time estimate, said after \"Time to transcribe:\" or inside a sentence, for a transcription that takes under 45 seconds."
    },
    "min" : {
      "comment" : "Short for minutes, shown after the sleep timer sheet's custom minutes field. Hidden from VoiceOver.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "min"
          }
        }
      }
    },
    "needs download" : {
      "comment" : "Status of a language's speech model that is not on this Mac yet, said after the language's name in the Transcribe Audio sheet and Settings."
    },
    "not supported" : {
      "comment" : "Status of a language that the speech recognizer cannot transcribe, said after the language's name in the Transcribe Audio sheet and Settings."
    },
    "stops at the end of the book" : {
      "comment" : "The state of a sleep timer set to End of book, as VoiceOver reads it after \"Sleep timer:\". Lowercase, since it follows a colon.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "se detiene al final del libro"
          }
        }
      }
    },
    "stops at the end of this heading" : {
      "comment" : "The state of a sleep timer set to End of heading, as VoiceOver reads it after \"Sleep timer:\". Lowercase, since it follows a colon.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "se detiene al final de este encabezado"
          }
        }
      }
    },
    "“%@” becomes “%@”, inside words too: %@." : {
      "comment" : "Heading of one rule's changes in the Clean Up Transcript sheet, for a rule that also changes the text inside longer words. %1$@ is the text the rule looks for; %2$@ is the text it puts in its place; %3$@ is the number of corrections, such as \"4 corrections\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” becomes “%2$@”, inside words too: %3$@."
          }
        }
      }
    },
    "“%@” becomes “%@”: %@." : {
      "comment" : "Heading of one rule's changes in the Clean Up Transcript sheet. %1$@ is the text the rule looks for; %2$@ is the text it puts in its place; %3$@ is the number of corrections, such as \"4 corrections\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” becomes “%2$@”: %3$@."
          }
        }
      }
    },
    "“%@” beside the audio wasn't attached: %@" : {
      "comment" : "Notice after an import: a transcript file found beside the audio was not attached. %1$@ is the file's name; %2$@ is the reason, a sentence.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” beside the audio wasn't attached: %2$@"
          }
        }
      }
    },
    "“%@” couldn't be read: %@." : {
      "comment" : "Error shown when an audio file cannot be read. %1$@ is the audio file's name; %2$@ is the reason, a short phrase in English.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” couldn't be read: %2$@."
          }
        }
      }
    },
    "“%@” is only in the cloud. Download the book, then transcribe it." : {
      "comment" : "Error shown when an audio file has not been downloaded from the cloud drive. %@ is the audio file's name."
    },
    "“%@” was imported, with %@ of audio." : {
      "comment" : "First sentence of the question offering to transcribe a new audiobook. %1$@ is the audiobook's title; %2$@ is its length in words, such as \"6 hours, 12 minutes\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” was imported, with %2$@ of audio."
          }
        }
      }
    },
    "“%@” was imported." : {
      "comment" : "First sentence of the question offering to transcribe a new audiobook whose length is not known. %@ is the audiobook's title."
    },
    "“%@” wasn't attached to %@: %@" : {
      "comment" : "Alert, and what VoiceOver hears, when a chosen file was not attached as a transcript. %1$@ is the file's name; %2$@ is the audiobook's title; %3$@ is the reason, a sentence.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” wasn't attached to %2$@: %3$@"
          }
        }
      }
    }
  },
  "version" : "1.0"
}