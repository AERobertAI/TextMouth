            "value" : "לא ניתן להירשם ל-%@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ की सदस्यता नहीं ली जा सकी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tidak dapat berlangganan %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile iscriversi a %@."
          }
        },
        "ja" : {
          "stringUnit" : {
