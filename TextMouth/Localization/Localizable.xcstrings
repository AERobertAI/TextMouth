    "libraryIndexArrangement.notRead.previous" : {
      "comment" : "Part of the outcome of saving a rebuilt library index: the sort settings could not be kept from the old index.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّرت على TextMouth قراءة إعدادات الفرز في الفهرس السابق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth আগের সূচকের সাজানোর সেটিংস পড়তে পারেনি।"
          }
        },
        "de" : {
