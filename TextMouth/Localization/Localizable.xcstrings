    "settings.defaultSpeedExplanation" : {
      "comment" : "Explanation under the default speed slider in the Voice settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "السرعة الافتراضية للكتب الجديدة. يمكن لكل كتاب تجاوزها بسرعته الخاصة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "নতুন বইয়ের ডিফল্ট গতি। প্রতিটি বই নিজের গতি দিয়ে এটি বদলাতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Standardgeschwindigkeit für neue Bücher. Jedes Buch kann sie mit seiner eigenen Geschwindigkeit überschreiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Default speed for new books. Each book can override this with its own speed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Velocidad predeterminada para libros nuevos. Cada libro puede cambiarla con su propia velocidad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سرعت پیش‌فرض برای کتاب‌های جدید. هر کتاب می‌تواند آن را با سرعت خودش جایگزین کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vitesse par défaut pour les nouveaux livres. Chaque livre peut la remplacer par sa propre vitesse."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מהירות ברירת מחדל לספרים חדשים. כל ספר יכול לעקוף אותה במהירות משלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "नई पुस्तकों के लिए डिफ़ॉल्ट गति। हर पुस्तक इसे अपनी गति से बदल सकती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kecepatan default untuk buku baru. Setiap buku dapat menggantinya dengan kecepatannya sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Velocità predefinita per i nuovi libri. Ogni libro può sostituirla con la propria velocità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "新しいブックのデフォルトの速度です。ブックごとに独自の速度で上書きできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "새 책의 기본 속도입니다. 책마다 자체 속도로 변경할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Standaardsnelheid voor nieuwe boeken. Elk boek kan een eigen snelheid hebben."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Domyślna prędkość dla nowych książek. Każda książka może ją zastąpić własną prędkością."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Velocidade padrão para livros novos. Cada livro pode substituí-la por uma velocidade própria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Скорость по умолчанию для новых книг. Для каждой книги можно задать свою."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Standardhastighet för nya böcker. Varje bok kan åsidosätta den med sin egen hastighet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ความเร็วเริ่มต้นสำหรับหนังสือใหม่ หนังสือแต่ละเล่มกำหนดความเร็วของตัวเองได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yeni kitaplar için varsayılan hız. Her kitap bunu kendi hızıyla geçersiz kılabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Типова швидкість для нових книг. Кожна книга може замінити її власною швидкістю."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نئی کتابوں کے لیے ڈیفالٹ رفتار۔ ہر کتاب اسے اپنی رفتار سے تبدیل کر سکتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tốc độ mặc định cho sách mới. Mỗi sách có thể ghi đè bằng tốc độ riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "新图书的默认速度。每本图书都可以用自己的速度覆盖此设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "新書籍的預設速度。每本書都可以用自己的速度覆寫。"
          }
        }
      }
    },
