    "readerViewModel.memoryRunawayMessage.macos" : {
      "comment" : "Message on the Mac when playback was stopped because the app's memory kept growing. %@ is the memory reached, a number such as 3.2, before \"GB\" (gigabytes); macOS is the name of the Mac's system.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "توقف التشغيل لأن ذاكرة TextMouth ازدادت إلى %@ غيغابايت أثناء تشغيل الصوت، وهذا خلل في صوت macOS."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "প্লেব্যাক বন্ধ হয়েছে, কারণ অডিও চলার সময় TextMouth-এর মেমোরি %@ GB-তে পৌঁছেছে, যা macOS-এর অডিওর একটি ত্রুটি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Wiedergabe wurde angehalten, weil der Speicher von TextMouth auf %@ GB angewachsen ist, während das Audio lief – ein Fehler im Audiosystem von macOS."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playback stopped because TextMouth's memory grew to %@ GB while the audio played, a fault in macOS's audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La reproducción se detuvo porque la memoria de TextMouth creció hasta %@ GB mientras sonaba el audio, un fallo del audio de macOS."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پخش متوقف شد، زیرا حافظه TextMouth هنگام پخش صدا به %@ گیگابایت رسید؛ این خطایی در صدای macOS است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La lecture s’est arrêtée, car la mémoire de TextMouth a atteint %@ Go pendant la lecture de l’audio, un défaut de l’audio de macOS."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הניגון נעצר כי הזיכרון של TextMouth גדל ל-%@ GB בזמן ניגון השמע, תקלה בשמע של macOS."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "प्लेबैक रुक गया, क्योंकि ऑडियो चलते समय TextMouth की मेमोरी %@ GB तक बढ़ गई, जो macOS के ऑडियो की खराबी है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pemutaran dihentikan karena memori TextMouth bertambah hingga %@ GB saat audio diputar, akibat kesalahan pada audio macOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Riproduzione interrotta perché la memoria di TextMouth è arrivata a %@ GB durante la riproduzione dell’audio, un difetto dell’audio di macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オーディオの再生中に TextMouth のメモリが%@ GB まで増えたため、再生を停止しました。macOS のオーディオの不具合です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "오디오 재생 중 TextMouth의 메모리가 %@GB로 늘어나 재생이 중지되었습니다. macOS 오디오의 결함입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Afspelen is gestopt, omdat het geheugen van TextMouth tijdens het afspelen is gegroeid tot %@ GB, een fout in de audio van macOS."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Odtwarzanie zatrzymano, ponieważ podczas odtwarzania dźwięku pamięć zajmowana przez TextMouth wzrosła do %@ GB, co jest błędem dźwięku w macOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A reprodução foi interrompida porque a memória do TextMouth cresceu até %@ GB durante a reprodução do áudio, uma falha do áudio do macOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Воспроизведение остановлено: память TextMouth выросла до %@ ГБ во время воспроизведения звука из-за сбоя в звуковой системе macOS."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uppspelningen stoppades eftersom TextMouths minne växte till %@ GB medan ljudet spelades, ett fel i macOS ljud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "การเล่นหยุดลง เพราะหน่วยความจำของ TextMouth เพิ่มขึ้นเป็น %@ GB ขณะเล่นเสียง ซึ่งเป็นข้อบกพร่องของระบบเสียงใน macOS"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Oynatma durduruldu: ses çalarken TextMouth'un belleği büyüdü ve %@ GB oldu; bu, macOS'in ses sistemindeki bir hatadır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відтворення зупинено, бо пам’ять TextMouth зросла до %@ ГБ під час відтворення аудіо — це помилка аудіосистеми macOS."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پلے بیک رک گیا کیونکہ آڈیو چلتے ہوئے TextMouth کی میموری %@ GB تک بڑھ گئی، جو macOS کے آڈیو کی خرابی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đã dừng phát vì bộ nhớ của TextMouth tăng lên %@ GB trong khi phát âm thanh; đây là lỗi âm thanh của macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "播放已停止，因为音频播放期间 TextMouth 的内存增长到 %@ GB，这是 macOS 音频的故障。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "播放已停止，因為 TextMouth 的記憶體在播放音訊時增加到 %@ GB，這是 macOS 音訊的問題。"
          }
        }
      }
    },
