          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Descarta la copia nueva. La biblioteca queda como estaba."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
