        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ को ऊपर नहीं ले जाया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ tidak dapat dipindahkan ke atas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ non può essere spostato più in alto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@はこれ以上上に移動できません。"
