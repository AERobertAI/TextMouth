    "%@: Some changes are not saved, and switching libraries would lose them." : {
      "comment" : "First sentence of why Use This Library was refused: changes could not be saved yet. %@ is the failure's lead-in, \"Failed to switch libraries\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@: Einige Änderungen sind nicht gesichert, und beim Wechseln der Bibliothek würden sie verloren gehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@: Hay cambios sin guardar, y cambiar de biblioteca los perdería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ : des modifications ne sont pas enregistrées, et changer de bibliothèque les perdrait."
          }
        },
        "it" : {
          "stringUnit" : {
