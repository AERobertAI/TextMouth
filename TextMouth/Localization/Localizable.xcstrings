          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ est en cours de transcription. Nettoyez sa transcription une fois qu’elle est terminée."
          }
        },
        "it" : {
          "stringUnit" : {
