        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth écrit %@ avec l’identité que ce Mac connaît pour la bibliothèque, puis l’ouvre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth scrive %@ con l’identità che questo Mac conosce per la libreria e la apre."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth grava %@ com a identidade que este Mac conhece para a biblioteca e a abre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth запишет %@ с идентификатором, который этот Mac знает для библиотеки, и откроет её."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
