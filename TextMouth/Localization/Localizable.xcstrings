        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” è troppo grande per essere letto."
          }
        }
      }
    },
    "“%@” isn't a filter's name." : {
      "comment" : "Problem found in a typed filter chain: the text before an equals sign is not a filter's name. %@ is that text.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%@“ ist kein Filtername."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” no es el nombre de un filtro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” non è il nome di un filtro."
          }
        }
      }
    },
    "“%@” keeps %@." : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. What VoiceOver hears when the listener keeps a guessed code by choosing it again: the book and the code, now the listener's own. Placeholders in order: bookTitle, codeName.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” keeps %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” conserva %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%@» mantiene %@."
          }
        }
      }
    },
    "“%@” matches “%@”, already in your library. Replace the existing copy, or keep both as separate books?" : {
      "comment" : "First paragraph of the question asked when a book just imported matches one in the library. %1$@ is the new copy's file name (or its title when it came from no file) and %2$@ the title of the library's copy.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” matches “%2$@”, already in your library. Replace the existing copy, or keep both as separate books?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” coincide con “%2$@”, que ya está en tu biblioteca. ¿Quieres reemplazar la copia existente o conservar ambas como libros separados?"
          }
        }
      }
    },
    "“%@” needs %@ free" : {
      "comment" : "A book's need for free disk space, inside the alert about Ogg audio that waits for space. %1$@ is the book's title and %2$@ the free space it needs, with its unit, such as \"4.2 GB\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” needs %2$@ free"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” necesita %2$@ libres"
          }
        }
      }
    },
    "“%@” no longer waits to download; it downloads when you choose %@." : {
      "comment" : "What VoiceOver says once Cancel Download took back a download that waited. The first %@ is the title; the second is the name of the Download command.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” no longer waits to download; it downloads when you choose %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” ya no espera para descargarse; se descargará cuando elijas %2$@."
          }
        }
      }
    },
    "“%@” uses %@ samples, which TextMouth can't play." : {
      "comment" : "Refuses an audio file whose samples TextMouth can't decode, which is not damaged. %1$@ is the file's name and %2$@ its sample form, such as \"64-bit integer\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%1$@“ verwendet %2$@-Samples, die TextMouth nicht wiedergeben kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” uses %2$@ samples, which TextMouth can't play."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” usa muestras %2$@, que TextMouth no puede reproducir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” usa campioni %2$@, che TextMouth non può riprodurre."
          }
        }
      }
    },
    "“%@” uses XML entities of its own, which TextMouth does not read." : {
      "comment" : "Message of the alert when a pronunciation lexicon declares XML entities, which are refused for safety. %@ is the file's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%@» usa entidades XML propias, que TextMouth no lee."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” usa entità XML proprie, che TextMouth non legge."
          }
        }
      }
    },
    "“%@” was imported, with %@ of audio." : {
      "comment" : "First sentence of the question offering to transcribe a new audiobook. %1$@ is the audiobook's title; %2$@ is its length in words, such as \"6 hours, 12 minutes\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%1$@“ wurde importiert, mit %2$@ Audio."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” was imported, with %2$@ of audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se importó “%1$@”, con %2$@ de audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” è stato importato, con %2$@ di audio."
          }
        }
      }
