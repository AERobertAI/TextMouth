    "Each <!-- page: … --> marks where a page begins." : {
      "comment" : "Third sentence of the Edit Text explanation. \"<!-- page: … -->\" is the literal text of a page marker in the file; it stays exactly as written.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحدد كل <!-- page: … --> مكان بداية صفحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jedes <!-- page: … --> markiert den Beginn einer Seite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cada <!-- page: … --> marca dónde empieza una página."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chaque <!-- page: … --> marque le début d’une page."
          }
