          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Закрывается окно чтения книги «%@», так как редактирование изменяет её аудио."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stänger läsaren för %@, eftersom redigering ändrar dess ljud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "กำลังปิดตัวอ่านของ %@ เพราะการแก้ไขจะเปลี่ยนเสียงของหนังสือ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Düzenleme sesi değiştirdiğinden %@ okuyucusu kapatılıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Закриття вікна читання для %@, бо редагування змінює аудіо книги."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ کا ریڈر بند کیا جا رہا ہے، کیونکہ ترمیم سے اس کا آڈیو بدل جاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đang đóng trình đọc của %@, vì việc chỉnh sửa làm thay đổi âm thanh của sách."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "正在关闭“%@”的阅读器，因为编辑会更改其音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "正在關閉「%@」的閱讀器，因為編輯會更改其音訊。"
          }
        }
      }
    },
