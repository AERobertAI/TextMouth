        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "如果問題在消失後再次出現，它會再次顯示。"
          }
        }
      }
    },
    "persistenceFailureCenter.announceRetryOutcome" : {
      "comment" : "Announcement when retrying a failed save failed again. The failure notices follow.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم تنجح “إعادة المحاولة”."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আবার চেষ্টা সফল হয়নি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der erneute Versuch ist fehlgeschlagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retry did not succeed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El reintento no tuvo éxito."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تلاش دوباره موفق نبود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le nouvel essai a échoué."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הניסיון החוזר לא הצליח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फिर से प्रयास सफल नहीं हुआ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
