        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcripción solo está en iCloud, así que TextMouth no la toca. Descarga el libro y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcription est seulement dans iCloud, donc TextMouth n’y touche pas. Téléchargez le livre, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La trascrizione è solo in iCloud, quindi TextMouth non la tocca. Scarica il libro, poi riprova."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A transcrição está apenas no iCloud, então o TextMouth a deixa como está. Baixe o livro e tente novamente."
          }
        }
      }
    },
    "The transcript is only in the cloud. Its details appear once the book is downloaded." : {
      "comment" : "Book Information's Transcript detail when the transcript file has not been downloaded from the cloud drive.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript ist nur in der Cloud. Seine Details erscheinen, sobald das Buch heruntergeladen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcripción solo está en la nube. Sus detalles aparecen cuando se descarga el libro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcription est seulement dans le cloud. Ses détails apparaissent une fois le livre téléchargé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La trascrizione è solo nel cloud. I suoi dettagli compaiono quando il libro viene scaricato."
