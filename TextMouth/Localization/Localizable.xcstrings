    "interfaceLanguage.hint" : {
      "comment" : "VoiceOver hint of the interface language picker. It says that the choice applies at once.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يختار لغة قوائم TextMouth ونوافذه ورسائله. يُطبَّق التغيير فورًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth-এর মেনু, উইন্ডো ও বার্তার ভাষা বেছে নেয়। পরিবর্তন সঙ্গে সঙ্গে কার্যকর হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wählt die Sprache der Menüs, Fenster und Meldungen von TextMouth. Die Änderung gilt sofort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chooses the language of TextMouth's menus, windows, and messages. The change applies at once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige el idioma de los menús, las ventanas y los mensajes de TextMouth. El cambio se aplica al instante."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "زبان منوها، پنجره‌ها و پیام‌های TextMouth را انتخاب می‌کند. تغییر بی‌درنگ اعمال می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisit la langue des menus, des fenêtres et des messages de TextMouth. Le changement s’applique immédiatement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בוחר את השפה של התפריטים, החלונות וההודעות של TextMouth. השינוי חל מיד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth के मेनू, विंडो और संदेशों की भाषा चुनता है। बदलाव तुरंत लागू होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Memilih bahasa menu, jendela, dan pesan TextMouth. Perubahan langsung berlaku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sceglie la lingua dei menu, delle finestre e dei messaggi di TextMouth. La modifica si applica subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth のメニュー、ウインドウ、メッセージの言語を選びます。変更はすぐに反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth의 메뉴, 윈도우, 메시지 언어를 선택합니다. 변경 사항은 즉시 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kiest de taal van de menu’s, vensters en berichten van TextMouth. De wijziging geldt meteen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wybiera język menu, okien i komunikatów TextMouth. Zmiana działa od razu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escolhe o idioma dos menus, das janelas e das mensagens do TextMouth. A mudança é aplicada na hora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Выбирает язык меню, окон и сообщений TextMouth. Изменение применяется сразу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Väljer språket för TextMouths menyer, fönster och meddelanden. Ändringen gäller direkt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เลือกภาษาของเมนู หน้าต่าง และข้อความของ TextMouth การเปลี่ยนแปลงมีผลทันที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth'un menülerinin, pencerelerinin ve iletilerinin dilini seçer. Değişiklik hemen uygulanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вибирає мову меню, вікон і повідомлень TextMouth. Зміна застосовується одразу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth کے مینو، ونڈوز اور پیغامات کی زبان منتخب کرتا ہے۔ تبدیلی فوراً لاگو ہوتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chọn ngôn ngữ cho menu, cửa sổ và thông báo của TextMouth. Thay đổi có hiệu lực ngay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "选取 TextMouth 的菜单、窗口和信息所用的语言。更改会立即生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選取 TextMouth 的選單、視窗和訊息所用的語言。更改會立即生效。"
          }
        }
      }
    },
