    "audioFilterPresetError.fileArrived" : {
      "comment" : "Said when a filter preset change is not made because the presets file synced in from another Mac while the premade presets stood in for it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "وصلت للتو إعدادات مسبقة من Mac آخر وحلّت محل هذه. أعد إجراء التغيير."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "অন্য একটি Mac থেকে প্রিসেট এইমাত্র এসে এগুলো প্রতিস্থাপন করেছে। পরিবর্তনটি আবার করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voreinstellungen von einem anderen Mac sind gerade eingetroffen und haben diese ersetzt. Nimm die Änderung erneut vor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presets from another Mac just arrived and replaced these. Make the change again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Llegaron preajustes de otra Mac y reemplazaron estos. Vuelve a hacer el cambio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پیش‌تنظیم‌هایی از Mac دیگری همین حالا رسیدند و جای این‌ها را گرفتند. تغییر را دوباره انجام دهید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Des préréglages d’un autre Mac viennent d’arriver et ont remplacé ceux-ci. Refaites la modification."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הגדרות מוכנות ממחשב Mac אחר הגיעו כעת והחליפו את אלה. בצע את השינוי שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "दूसरे Mac से प्रीसेट अभी-अभी आए और इनकी जगह ले ली। बदलाव दोबारा करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Preset dari Mac lain baru saja tiba dan menggantikan preset ini. Lakukan perubahan lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sono appena arrivati preset da un altro Mac, che hanno sostituito questi. Rifai la modifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ほかの Mac から届いたプリセットがこれらを置き換えました。もう一度変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "다른 Mac의 프리셋이 방금 도착해 이 프리셋을 대체했습니다. 변경을 다시 하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voorinstellingen van een andere Mac zijn net binnengekomen en hebben deze vervangen. Maak de wijziging opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ustawienia wstępne z innego komputera Mac właśnie dotarły i zastąpiły te. Wprowadź zmianę ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Predefinições de outro Mac acabaram de chegar e substituíram estas. Faça a alteração de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Только что пришли пресеты с другого Mac и заменили текущие. Повторите изменение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Förinställningar från en annan Mac kom just och ersatte dessa. Gör ändringen igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ค่าที่ตั้งไว้ล่วงหน้าจาก Mac เครื่องอื่นเพิ่งมาถึงและแทนที่รายการเหล่านี้ ให้เปลี่ยนอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Başka bir Mac'ten az önce hazır ayarlar geldi ve bunların yerini aldı. Değişikliği yeniden yapın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Пресети з іншого Mac щойно надійшли й замінили ці. Внесіть зміну знову."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "دوسرے Mac سے پری سیٹس ابھی آئے اور انہوں نے ان کی جگہ لے لی۔ تبدیلی دوبارہ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Các giá trị đặt sẵn từ máy Mac khác vừa đến và đã thay thế các giá trị này. Hãy thực hiện lại thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "来自另一台 Mac 的预设刚刚同步过来，并替换了这些预设。请重新进行更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "另一部 Mac 的預設組合剛剛同步過來並取代了這些。請再次進行更改。"
          }
        }
      }
    },
    "audioFilterPresetError.libraryUnavailable" : {
      "comment" : "Said when the filter presets can't be saved because the library's data folder can't be used.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
