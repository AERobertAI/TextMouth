    "feedSubscribeError.message.unsubscribedAlready" : {
      "comment" : "Why Subscribe refused: the feed is in the library but unsubscribed. The first %@ is the feed's title; the second is the name of the Resubscribe command; the third is the name of the Feed Info sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ في مكتبتك لكن اشتراكه ملغى. اختر %2$@ في صفه، أو في %3$@، لفحصه مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ আপনার লাইব্রেরিতে আছে, সাবস্ক্রিপশন বাতিল করা অবস্থায়। আবার চেক করতে এর সারিতে বা এর %3$@-এ %2$@ বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ist in deiner Bibliothek, aber abbestellt. Wähle %2$@ in der Zeile oder unter %3$@, um den Feed erneut zu prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is in your library, unsubscribed. Choose %@ on its row, or in its %@, to check it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
