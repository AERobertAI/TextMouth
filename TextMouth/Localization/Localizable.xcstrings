          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não conseguiu verificar a tabela “%1$@” deste Mac: %2$@. Escolha-a de novo para tentar outra vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не смог проверить таблицу этого Mac «%1$@»: %2$@. Выберите её снова, чтобы повторить."
          }
        }
      }
    },
    "TextMouth could not check whether to move it to the Trash." : {
      "comment" : "Why a book's original was kept: TextMouth could not read the choice about the Trash. \"It\" is the original file.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth konnte nicht prüfen, ob es in den Papierkorb gelegt werden soll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no pudo comprobar si debía moverlo a la Papelera."
