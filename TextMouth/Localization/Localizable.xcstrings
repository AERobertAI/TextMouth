          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non può convertire «%@»: una parte del suo audio è in un blocco troppo grande da decodificare."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não consegue converter “%@”: parte do som dele está em um bloco grande demais para decodificar."
          }
        }
      }
    },
    "TextMouth can't play this kind of file (%@)." : {
      "comment" : "Why a feed's episode could not be downloaded: the file is of a kind TextMouth does not play. %@ is the file's type or extension, such as audio/x-flac.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kann diese Dateiart nicht wiedergeben (%@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede reproducir este tipo de archivo (%@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ne peut pas lire ce type de fichier (%@)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non può riprodurre questo tipo di file (%@)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não consegue reproduzir este tipo de arquivo (%@)."
          }
        }
      }
    },
    "TextMouth can't read the audio file %@ because %@." : {
      "comment" : "Why an audio file could not be converted at import: it is of a format TextMouth reads, in a form it refuses. %1$@ is the file's name and %2$@ the reason, a clause in English that follows \"because\" and has no full stop.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TextMouth can't read the audio file %1$@ because %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede leer el archivo de audio %1$@ porque %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ne peut pas lire le fichier audio %@ car %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non può leggere il file audio %@ perché %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não consegue ler o arquivo de áudio %1$@ porque %2$@."
          }
        }
      }
    },
    "TextMouth can't read the folder %@: %@." : {
      "comment" : "Why the chosen folder can't be used: it can't be read. %1$@ is the folder's path; %2$@ is the reason in a few words, such as \"permission denied\", with no full stop.\nWhy the library can't be used: its folder can't be read. %1$@ is the folder's path; %2$@ is the reason in a few words, such as \"permission denied\", with no full stop.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kann den Ordner %1$@ nicht lesen: %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TextMouth can't read the folder %1$@: %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede leer la carpeta %1$@: %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ne peut pas lire le dossier %1$@ : %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non riesce a leggere la cartella %@: %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não consegue ler a pasta %1$@: %2$@."
          }
        }
      }
    },
    "TextMouth can't read this kind of picture (%@). Save it as a PNG or JPEG, then import that copy." : {
      "comment" : "Why a picture was refused at import: a kind of picture the system knows but TextMouth does not decode. %@ is the system's description of the kind, such as \"DNG image\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kann diese Bildart nicht lesen (%@). Sichere das Bild als PNG oder JPEG und importiere dann diese Kopie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede leer este tipo de imagen (%@). Guárdala como PNG o JPEG y luego importa esa copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ne peut pas lire ce type d’image (%@). Enregistrez-la en PNG ou JPEG, puis importez cette copie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non può leggere questo tipo di immagine (%@). Salvala come PNG o JPEG, poi importa quella copia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não consegue ler este tipo de imagem (%@). Salve-a como PNG ou JPEG e depois importe essa cópia."
          }
        }
      }
    },
    "TextMouth can't read “%@” as %@. It may be damaged, or named for another format." : {
      "comment" : "Why a file was not imported: its bytes are not of the format its name says, or are damaged. %1$@ is the file's name and %2$@ the name of the format its name says, such as WMA or AVI video.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kann „%1$@“ nicht als %2$@ lesen. Die Datei ist möglicherweise beschädigt oder nach einem anderen Format benannt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TextMouth can't read “%1$@” as %2$@. It may be damaged, or named for another format."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede leer “%1$@” como %2$@. Puede estar dañado o tener el nombre de otro formato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ne peut pas lire « %1$@ » comme %2$@. Il est peut-être endommagé, ou nommé pour un autre format."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non può leggere «%1$@» come %2$@. Potrebbe essere danneggiato, o avere il nome di un altro formato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não consegue ler “%1$@” como %2$@. Ele pode estar danificado ou ter o nome de outro formato."
          }
        }
      }
    },
    "TextMouth can't safely read the file “%@” in this book, because it defines entities of its own." : {
      "comment" : "First sentence of why a file inside an EPUB or DAISY book was refused: it defines XML entities of its own, which could make it far larger when read. %@ is the file's path inside the book.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede leer de forma segura el archivo “%@” de este libro, porque define entidades propias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ne peut pas lire en toute sécurité le fichier « %@ » de ce livre, car il définit ses propres entités."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non può leggere in sicurezza il file “%@” in questo libro, perché definisce entità proprie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não consegue ler com segurança o arquivo “%@” deste livro, porque ele define entidades próprias."
          }
        }
      }
    },
    "TextMouth can't safely read the file “%@” in this book, because it is written in the %@ encoding." : {
      "comment" : "First sentence of why a file inside an EPUB or DAISY book was refused: it is in a text encoding TextMouth cannot see through. %1$@ is the file's path inside the book and %2$@ the encoding's name as the file declares it.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TextMouth can't safely read the file “%1$@” in this book, because it is written in the %2$@ encoding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede leer de forma segura el archivo “%1$@” de este libro, porque está escrito en la codificación %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ne peut pas lire en toute sécurité le fichier « %@ » de ce livre, car il est écrit dans l’encodage %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non può leggere in sicurezza il file “%@” in questo libro, perché è scritto nella codifica %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
