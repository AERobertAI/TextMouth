        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La copia era già completa quando è stato premuto Annulla, quindi lo spostamento è proseguito."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A cópia já estava completa quando Cancelar foi pressionado, então a movimentação prosseguiu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Копирование уже завершилось, когда была нажата отмена, поэтому перемещение выполнено."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Копію вже було завершено, коли натиснули «Скасувати», тому переміщення виконано."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "按下“取消”时副本已经完成，因此移动继续进行。"
          }
        }
      }
    },
    "The correction file %@ is damaged or belongs to another recording, so %@ could not be converted." : {
      "comment" : "Why a hybrid WavPack file could not be converted at import: the correction file beside it (the same name ending in .wvc) is damaged or belongs to another recording. %1$@ is the correction file's name and %2$@ the WavPack file's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Korrekturdatei %1$@ ist beschädigt oder gehört zu einer anderen Aufnahme, daher konnte %2$@ nicht konvertiert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The correction file %1$@ is damaged or belongs to another recording, so %2$@ could not be converted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo de corrección %1$@ está dañado o pertenece a otra grabación, así que no se pudo convertir %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le fichier de correction %@ est endommagé ou appartient à un autre enregistrement, donc %@ n’a pas pu être converti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il file di correzione %@ è danneggiato o appartiene a un’altra registrazione, quindi non è stato possibile convertire %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo de correção %1$@ está danificado ou pertence a outra gravação, então não foi possível converter %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл коррекции %1$@ повреждён или относится к другой записи, поэтому %2$@ не удалось преобразовать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "校正文件 %1$@ 已损坏或属于另一段录音，因此无法转换 %2$@。"
          }
        }
      }
    },
    "The cue sheet “%@” is too large to read." : {
      "comment" : "Refusal of a cue sheet that is larger than TextMouth reads. %@ is the cue sheet's file name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Cue-Sheet „%@“ ist zu groß zum Lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo CUE “%@” es demasiado grande para leerlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le fichier CUE « %@ » est trop volumineux pour être lu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il cue sheet “%@” è troppo grande per essere letto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo cue “%@” é grande demais para ser lido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл CUE «%@» слишком велик, чтобы его прочитать."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл CUE «%@» завеликий для читання."
          }
        }
      }
    },
    "The cue sheet “%@” names none of the audio beside it, so its headings were not used." : {
      "comment" : "Notice that a cue sheet of an imported folder or archive was not used, because it names none of the audio beside it. %@ is the cue sheet's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Cue-Sheet „%@“ nennt keine der daneben liegenden Audiodateien, daher wurden seine Überschriften nicht verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo CUE “%@” no nombra ningún audio junto a él, así que no se usaron sus encabezados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le fichier CUE « %@ » ne désigne aucun des fichiers audio voisins, donc ses en-têtes n’ont pas été utilisés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il cue sheet “%@” non nomina nessuno degli audio accanto a esso, quindi le sue intestazioni non sono state usate."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo cue “%@” não cita nenhum dos áudios ao lado dele, então os cabeçalhos dele não foram usados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл CUE «%@» не называет ни одного соседнего аудиофайла, поэтому его заголовки не использованы."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл CUE «%@» не називає жодного аудіо поруч, тож його заголовки не використано."
          }
        }
      }
    },
    "The current data directory does not exist." : {
      "comment" : "Why a move of the data directory was refused: the folder it would move from is missing.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der aktuelle Datenordner existiert nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El directorio de datos actual no existe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le dossier de données actuel n’existe pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La cartella dei dati attuale non esiste."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A pasta de dados atual não existe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Текущий каталог данных не существует."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Поточного каталогу даних не існує."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "当前数据目录不存在。"
          }
        }
      }
    },
    "The current directory will be retained as recovery data." : {
      "comment" : "Last sentence of the question asked before moving the library: the old folder is kept.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der aktuelle Ordner wird als Wiederherstellungsdaten behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El directorio actual se conservará como datos de recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le dossier actuel sera conservé comme données de récupération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La cartella attuale verrà conservata come dati di ripristino."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A pasta atual será mantida como dados de recuperação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Текущий каталог будет сохранён как данные для восстановления."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Поточний каталог буде збережено як дані відновлення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "当前目录将作为恢复数据保留。"
          }
        }
      }
    },
    "The cursor is %@." : {
      "comment" : "Announcement after Go to Page when the cursor is not on the page typed and there is no known reason. %@ says where the cursor is, such as \"on page 52\" or \"before page 1\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Cursor steht %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El cursor está %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le curseur est %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il cursore è %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O cursor está %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Курсор %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "光标%@。"
          }
        }
      }
    },
    "The data directory has no Logs folder, so logs go to %@ until it has one." : {
      "comment" : "The line under the Log location pop-up in the Storage settings while the data directory has no Logs folder. %@ is the folder's full path, which stays as written.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Datenordner hat keinen Ordner „Logs“, daher gehen die Protokolle nach %@, bis er einen hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El directorio de datos no tiene carpeta Logs, así que los registros van a %@ hasta que la tenga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le dossier de données n’a pas de dossier Journaux ; les journaux vont donc dans %@ jusqu’à ce qu’il en ait un."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La cartella dei dati non ha una cartella Registri, quindi i registri vanno in %@ finché non ne avrà una."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A pasta de dados não tem uma pasta Logs, então os registros vão para %@ até que ela exista."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В каталоге данных нет папки Logs, поэтому журналы пишутся в %@, пока её нет."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "У каталозі даних немає папки Logs, тому журнали записуються в %@, доки її не буде."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "数据目录没有“日志”文件夹，因此日志会写入 %@，直到它有该文件夹为止。"
          }
        }
      }
    },
    "The data directory is missing, so logs go to %@ until it is back." : {
      "comment" : "The line under the Log location pop-up in the Storage settings while the data directory is missing. %@ is the folder's full path, which stays as written.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Datenordner fehlt, daher gehen die Protokolle nach %@, bis er wieder da ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Falta el directorio de datos, así que los registros van a %@ hasta que vuelva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le dossier de données est introuvable ; les journaux vont donc dans %@ jusqu’à son retour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La cartella dei dati manca, quindi i registri vanno in %@ finché non torna disponibile."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A pasta de dados está ausente, então os registros vão para %@ até que ela volte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Каталог данных отсутствует, поэтому журналы пишутся в %@, пока он не вернётся."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Каталог даних відсутній, тому журнали записуються в %@, доки його не буде."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "数据目录缺失，因此日志会写入 %@，直到它恢复为止。"
          }
        }
      }
    },
    "The data directory's Logs folder can't be written (%@), so logs go to %@ until it can." : {
      "comment" : "The line under the Log location pop-up in the Storage settings while the data directory's Logs folder cannot be written. %1$@ is the reason the system gives, which may be in English, and %2$@ is the folder's full path, which stays as written.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "In den Ordner „Logs“ des Datenordners kann nicht geschrieben werden (%1$@), daher gehen die Protokolle nach %2$@, bis es wieder geht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The data directory's Logs folder can't be written (%1$@), so logs go to %2$@ until it can."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se puede escribir en la carpeta Logs del directorio de datos (%1$@), así que los registros van a %2$@ hasta que se pueda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le dossier Journaux du dossier de données n’est pas accessible en écriture (%1$@) ; les journaux vont donc dans %2$@ jusqu’à ce qu’il le soit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non è possibile scrivere nella cartella Registri della cartella dei dati (%@), quindi i registri vanno in %@ finché non sarà possibile."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não é possível gravar na pasta Logs da pasta de dados (%1$@), então os registros vão para %2$@ até que seja possível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В папку Logs каталога данных нельзя записывать (%1$@), поэтому журналы пишутся в %2$@, пока это не станет возможным."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "У папку Logs каталогу даних не можна записувати (%1$@), тому журнали записуються в %2$@, доки це не стане можливим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "无法写入数据目录的“日志”文件夹（%1$@），因此日志会写入 %2$@，直到可以写入为止。"
          }
        }
      }
    },
    "The destination folder %@ is no longer in the library." : {
      "comment" : "Error shown when a move is refused because the folder it goes into is gone from the library. %@ is that folder's location, in straight double quotes.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
