    "playbackControls.unitHelp" : {
      "comment" : "Help text of the playback bar's menu that sets the one unit by which this book moves forward and backward.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تغيير وحدة التنقل للأمام وللخلف لهذا الكتاب"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই বইয়ের এগিয়ে ও পিছিয়ে যাওয়ার নেভিগেশন ইউনিট পরিবর্তন করুন"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Navigationseinheit dieses Buchs für Vorwärts und Rückwärts ändern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change this book's forward and backward navigation unit"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cambia la unidad de navegación de este libro, hacia adelante y hacia atrás"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تغییر واحد پیمایش به جلو و به عقب این کتاب"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Modifie l’unité de navigation avant et arrière de ce livre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "שנה את יחידת הניווט קדימה ואחורה של ספר זה"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस पुस्तक की आगे और पीछे जाने की नेविगेशन इकाई बदलें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ubah unit navigasi maju dan mundur buku ini"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cambia l’unità di navigazione avanti e indietro di questo libro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このブックの前方と後方の移動単位を変更します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 책의 앞뒤 탐색 단위를 변경합니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wijzigt de navigatie-eenheid voor vooruit en achteruit van dit boek"
