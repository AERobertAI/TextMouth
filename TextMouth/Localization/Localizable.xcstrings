    "encryptedArchive.protected" : {
      "comment" : "Why a ZIP archive could not be imported: its files are protected by a password, which TextMouth cannot use. %@ is the names of the files it could not read, in quotes.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أرشيف ZIP هذا محمي بكلمة مرور. تعذّرت قراءة %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই ZIP আর্কাইভটি পাসওয়ার্ড দিয়ে সুরক্ষিত। %@ পড়া যায়নি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieses ZIP-Archiv ist durch ein Passwort geschützt. %@ konnte nicht gelesen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This ZIP archive is protected by a password. It couldn't read %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
