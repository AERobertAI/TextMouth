    "removalMode.filesClause.trashRecoverEmptied" : {
      "comment" : "A clause about several books' files when they are moved to the Trash, inside a sentence of a removal confirmation.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تذهب ملفاتها إلى سلة المهملات، حيث يمكنك استردادها إلى أن تُفرَّغ السلة"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এগুলোর ফাইল ট্র্যাশে যায়, যেখানে ট্র্যাশ খালি করার আগ পর্যন্ত আপনি সেগুলো পুনরুদ্ধার করতে পারেন"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ihre Dateien kommen in den Papierkorb, wo du sie bis zum Leeren des Papierkorbs wiederherstellen kannst"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "their files go to the Trash, where you can recover them until the Trash is emptied"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "sus archivos van a la Papelera, donde puedes recuperarlos hasta que se vacíe"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فایل‌های آن‌ها به سطل زباله می‌روند، جایی که تا خالی شدن سطل می‌توانید آن‌ها را بازیابی کنید"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "leurs fichiers vont dans la corbeille, où vous pouvez les récupérer jusqu’à ce qu’elle soit vidée"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הקבצים שלהם עוברים לאשפה, ואפשר לשחזר אותם עד שהאשפה מתרוקנת"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इनकी फ़ाइलें ट्रैश में चली जाती हैं, जहाँ ट्रैश खाली होने तक आप उन्हें वापस पा सकते हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "file-nya dipindahkan ke Tempat Sampah, tempat Anda dapat memulihkannya sampai Tempat Sampah dikosongkan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "i loro file vanno nel Cestino, dove puoi recuperarli finché il Cestino non viene svuotato"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ファイルはゴミ箱に入り、ゴミ箱を空にするまで復元できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "해당 파일이 휴지통으로 이동되며, 휴지통을 비우기 전까지 복구할 수 있습니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "gaan hun bestanden naar de prullenmand, waar je ze kunt herstellen totdat de prullenmand is geleegd"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ich pliki trafiają do kosza, skąd można je odzyskać do czasu opróżnienia kosza"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "os arquivos deles vão para a Lixeira, onde você pode recuperá-los até que ela seja esvaziada"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "их файлы перемещаются в Корзину, откуда их можно восстановить, пока Корзина не очищена"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "deras filer läggs i papperskorgen, där du kan återställa dem tills papperskorgen töms"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไฟล์ของหนังสือทั้งหมดจะไปที่ถังขยะ ซึ่งกู้คืนได้จนกว่าจะล้างถังขยะ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "dosyaları, Çöp Sepeti boşaltılana kadar kurtarabileceğiniz Çöp Sepetine gider"
          }
        },
        "uk" : {
          "stringUnit" : {
