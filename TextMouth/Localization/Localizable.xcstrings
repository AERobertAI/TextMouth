    "bookTextEdit.earlierTextKept" : {
      "comment" : "Sentence saying where a backup of a book's earlier text was kept. %@ is a file name such as content.md.edited-20261024T123012Z, which stays as written.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "حُفظ نصه السابق باسم %@ في حزمة الكتاب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এর আগের টেক্সট বইয়ের প্যাকেজে %@ নামে রাখা হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sein früherer Text wurde als %@ im Paket des Buchs aufbewahrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its earlier text was kept as %@, in the book's package."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Su texto anterior se conservó como %@, en el paquete del libro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "متن قبلی آن با نام %@ در بسته‌ی کتاب نگه داشته شد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Son texte précédent a été conservé sous le nom %@, dans le paquet du livre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
