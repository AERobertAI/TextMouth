    "Restarts the most recent sleep timer with a sequence of media-control presses" : {
      "comment" : "VoiceOver hint of the Enable restart-timer gesture switch in the Miscellaneous settings.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعيد تشغيل أحدث مؤقت نوم بتسلسل من ضغطات التحكم في الوسائط"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "মিডিয়া-নিয়ন্ত্রণ প্রেসের একটি ক্রম দিয়ে সাম্প্রতিকতম স্লিপ টাইমার আবার চালু করে"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Startet den letzten Einschlaf-Timer mit einer Folge von Medientasten neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reinicia el temporizador de apagado más reciente con una secuencia de pulsaciones de control multimedia"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Redémarre le dernier minuteur de mise en veille avec une séquence d’appuis sur les commandes multimédias."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "मीडिया-कंट्रोल प्रेस के क्रम से सबसे हाल का स्लीप टाइमर फिर से शुरू करता है"
