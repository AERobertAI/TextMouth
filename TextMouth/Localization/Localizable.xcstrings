    },
    "Publisher" : {
      "comment" : "Name of the book information sheet's field for a book's publisher; VoiceOver reads it as the field's label."
    },
    "Punch In" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Records new audio over the selection."
    },
    "Punctuation Pauses" : {
      "comment" : "Heading of the punctuation pause group in the Playback settings."
    },
    "Punctuation pause level" : {
      "comment" : "VoiceOver label of the punctuation pause level slider in the Playback settings."
    },
    "Punctuation pauses: %@" : {
      "comment" : "The punctuation pause level shown above its slider in the Playback settings. %@ is the level's name, such as Subtle."
    },
    "Put the feed's folder in" : {
      "comment" : "Caption of the folder picker of the Add Feed sheet: the library folder that will hold the feed's own folder."
    },
    "Put the feeds' folders in" : {
      "comment" : "Caption of the folder picker of the Import OPML sheet: the library folder that will hold each feed's own folder."
    },
    "Puts back TextMouth's premade presets, removing the ones you added." : {
      "comment" : "Hint of the Reset All to Defaults button in the filter presets sheet."
    },
    "Puts back the transcript as it was before the last cleanup." : {
      "comment" : "VoiceOver hint of the Undo Cleanup button of the Clean Up Transcript sheet."
    },
    "Puts the new copy in place of the one already in the library, keeping only the existing copy's folder and place on the reading list." : {
      "comment" : "VoiceOver hint of the Replace Existing button of the duplicate-book question, when one copy is an audiobook and the other is not. \"The existing copy\" is the copy in the library."
    },
    "Puts the new copy in place of the one already in the library, keeping the existing copy's reading position, bookmarks, and settings." : {
      "comment" : "VoiceOver hint of the Replace Existing button of the duplicate-book question, when both copies are of one kind. \"The existing copy\" is the copy in the library."
    },
    "Putting back the transcript from before…" : {
      "comment" : "Line of the Clean Up Transcript sheet while it puts back the transcript from before the cleanup."
    },
    "Quality" : {
      "comment" : "Label of the selected voice's quality in the Voice settings, such as Enhanced."
    },
    "Question Mark" : {
      "comment" : "Name of the punctuation key \"?\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Question Mark\"."
    },
    "Quieter" : {
      "comment" : "Title of a premade audio filter preset: lowers the volume by 6 decibels."
    },
    "Quit Anyway" : {
      "comment" : "Button of the unsaved-changes alert that quits TextMouth and leaves the changes unsaved."
    },
    "Quit TextMouth" : {
      "comment" : "Button of the library index recovery sheet that quits TextMouth.\nButton of the warning that TextMouth is open on another Mac: quits TextMouth.\nButton on the Library Not Available screen that quits TextMouth.\nName of the application menu's Quit command, in a sentence saying why a keyboard shortcut cannot take its key."
    },
    "Quit TextMouth and open it again." : {
      "comment" : "Last sentence of the message when Use This Library could not open TextMouth again: what to do."
