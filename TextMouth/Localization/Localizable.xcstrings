    "soundEffectsSettings.eventHint.whereAmIEnd" : {
      "comment" : "VoiceOver hint of the pop-up button that chooses the sound for the end of the Where Am I announcement. Where Am I is the name of a command.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يُشغَّل عند انتهاء نطق “أين أنا؟”."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“আমি কোথায়?” বলা শেষ হলে বাজে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wird wiedergegeben, wenn „Wo bin ich?“ zu Ende gesprochen hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plays when Where Am I finishes speaking"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Suena cuando ¿Dónde estoy? termina de hablar"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "وقتی «کجا هستم؟» گفتن را تمام می‌کند پخش می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se joue quand Où suis-je ? finit de parler."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מתנגן כשהפקודה “איפה אני?” מסיימת להקריא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ध्वनि तब बजती है जब “मैं कहाँ हूँ?” बोलना ख़त्म करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Diputar saat Di mana saya? selesai berbicara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si attiva quando Dove sono? finisce di parlare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「ここはどこ？」の読み上げが終わると鳴ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“내 위치는?” 안내가 끝날 때 재생됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wordt afgespeeld wanneer Waar ben ik? klaar is met spreken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Odtwarza się po zakończeniu wypowiedzi Gdzie jestem?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toca quando Onde estou? termina de falar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Звучит, когда «Где я?» заканчивает говорить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Spelas upp när ”Var är jag?” har läst klart."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เล่นเมื่อ ฉันอยู่ที่ไหน พูดจบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Neredeyim? konuşmayı bitirdiğinde çalar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відтворюється, коли «Де я?» закінчує говорити."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جب “میں کہاں ہوں؟” بولنا ختم کرتا ہے تو چلتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
