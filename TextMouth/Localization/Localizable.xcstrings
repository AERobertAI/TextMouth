    "importDecision.replacedCopySentence.putting" : {
      "comment" : "Part of the question asked about a duplicate book: where the library's copy goes when replaced and files go to the Trash.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تنتقل ملفات النسخة الموجودة إلى سلة المهملات، لكن إرجاعها لن يعيد تلك النسخة إلى مكتبتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
