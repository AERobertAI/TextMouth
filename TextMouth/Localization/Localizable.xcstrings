    "interfaceTextFile.editVersionUnknown" : {
      "comment" : "VoiceOver announcement when Edit Interface Text found a file of the person's own lines whose version it does not know. It left the file as it was and opened it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "إصدار الملف ليس إصدارًا يعرفه TextMouth، لذا تُرك كما هو."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফাইলের সংস্করণ TextMouth-এর চেনা নয়, তাই এটি যেমন ছিল তেমনই রাখা হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Version der Datei ist TextMouth nicht bekannt, deshalb blieb sie unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file's version is not one TextMouth knows, so it was left as it is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La versión del archivo no es una que TextMouth conozca, así que se dejó como estaba."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
