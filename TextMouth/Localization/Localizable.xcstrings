    "eightDotCell.errorDescription.brailleTable" : {
      "comment" : "Why braille could not be written to a BRF or PEF file: the braille table writes a character with an eight-dot cell. %@ is the print character. BRF and PEF are braille file formats.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يكتب جدول برايل “%@” كخلية من ثماني نقاط، بينما ملفات BRF و PEF في TextMouth من ست نقاط فقط."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ব্রেইল টেবিল “%@” আট-ডটের একটি সেল হিসেবে লেখে, কিন্তু TextMouth-এর BRF ও PEF ফাইল শুধু ছয়-ডটের।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Brailletabelle schreibt „%@“ als Achtpunktzelle, aber die BRF- und PEF-Dateien von TextMouth sind nur sechspunktig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The braille table writes “%@” as an eight-dot cell, but TextMouth's BRF and PEF files are six-dot only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La tabla de braille escribe “%@” como una celda de ocho puntos, pero los archivos BRF y PEF de TextMouth son solo de seis puntos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جدول بریل «%@» را به‌صورت خانه هشت‌نقطه‌ای می‌نویسد، اما فایل‌های BRF و PEF در TextMouth فقط شش‌نقطه‌ای هستند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La table braille écrit « %@ » comme une cellule à huit points, mais les fichiers BRF et PEF de TextMouth n’ont que six points."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "טבלת הברייל כותבת את “%@” כתא בן שמונה נקודות, אבל קבצי BRF ו-PEF של TextMouth הם בני שש נקודות בלבד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ब्रेल टेबल “%@” को आठ-बिंदु वाले सेल के रूप में लिखती है, लेकिन TextMouth की BRF और PEF फ़ाइलें केवल छह-बिंदु वाली हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tabel braille menulis “%@” sebagai sel delapan titik, tetapi file BRF dan PEF TextMouth hanya enam titik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La tabella braille scrive “%@” come cella a otto punti, ma i file BRF e PEF di TextMouth sono solo a sei punti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "この点字表は「%@」を8点のセルで出力しますが、TextMouth の BRF と PEF ファイルは6点のみです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "점자표가 “%@”을(를) 8점 셀로 쓰지만, TextMouth의 BRF 및 PEF 파일은 6점만 지원합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De brailletabel schrijft “%@” als een cel met acht punten, maar de BRF- en PEF-bestanden van TextMouth hebben alleen zes punten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tabela Braille’a zapisuje „%@” jako komórkę ośmiopunktową, ale pliki BRF i PEF w TextMouth są tylko sześciopunktowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A tabela braille escreve “%@” como uma célula de oito pontos, mas os arquivos BRF e PEF do TextMouth têm apenas seis pontos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Таблица Брайля записывает «%@» восьмиточечной ячейкой, а файлы BRF и PEF в TextMouth только шеститочечные."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Punktskriftstabellen skriver ”%@” som en åttapunktscell, men BRF- och PEF-filer från TextMouth har bara sex punkter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตารางอักษรเบรลล์เขียน “%@” เป็นเซลล์แปดจุด แต่ไฟล์ BRF และ PEF ของ TextMouth เป็นแบบหกจุดเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Braille tablosu “%@” karakterini sekiz noktalı bir hücre olarak yazıyor, ancak TextMouth'un BRF ve PEF dosyaları yalnızca altı noktalıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Брайлівська таблиця записує «%@» як восьмикрапкову комірку, але файли BRF і PEF у TextMouth лише шестикрапкові."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بریل جدول “%@” کو آٹھ نقطوں کے سیل کے طور پر لکھتا ہے، لیکن TextMouth کی BRF اور PEF فائلیں صرف چھ نقطوں کی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bảng braille ghi “%@” thành một ô tám chấm, nhưng các tệp BRF và PEF của TextMouth chỉ dùng sáu chấm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "该盲文表将“%@”写成八点盲文单元，而 TextMouth 的 BRF 和 PEF 文件只支持六点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此點字表將「%@」寫成八點點字格，但 TextMouth 的 BRF 和 PEF 檔案只支援六點。"
          }
        }
      }
    },
