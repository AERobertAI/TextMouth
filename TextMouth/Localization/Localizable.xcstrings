        }
      }
    },
    "transcriptCleanup.noTranscript" : {
      "comment" : "Alert shown when Clean Up Transcript is chosen for an audiobook with no transcript. %@ is the audiobook's title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا تتضمن %@ نسخة نصية لتنظيفها. ابدأ أولًا بتفريغ الصوت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@-এর কোনো ট্রান্সক্রিপ্ট নেই যা পরিষ্কার করা যায়। আগে এর অডিও ট্রান্সক্রাইব করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ hat kein Transkript zum Bereinigen. Transkribiere zuerst das Audio."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ has no transcript to clean up. Transcribe its audio first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no tiene una transcripción que limpiar. Transcribe primero su audio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ رونوشتی برای تمیز کردن ندارد. ابتدا صدای آن را رونویسی کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ n’a aucune transcription à nettoyer. Transcrivez d’abord son audio."
