    "Add Bookmark" : {
      "comment" : "Button of the Bookmarks list that adds a bookmark at the reading position, and the heading of the panel where its note is written.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Agregar marcador"
          }
        }
      }
    },
    "Add Feed…" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Library group and read by VoiceOver. Subscribes to a podcast or news feed. Also the title of the menu command of the same name."
    },
    "Add Marker" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Adds a marker at the current position."
    },
    "Add shortcut" : {
      "comment" : "Label of the button, in a keyboard shortcut action's row in Settings, that adds one more key to the action."
    },
    "Add to Reading List" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Library group and read by VoiceOver. Adds the selected books to the end of the reading list. Also the title of the menu command of the same name."
    },
    "Added %lld books to the reading list." : {
      "comment" : "VoiceOver announcement after several books were added to the reading list. %lld is the number of books added.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se agregaron %lld libros a la lista de lectura."
          }
        }
      }
    },
    "Added to reading list: %@" : {
      "comment" : "VoiceOver announcement after one book was added to the reading list. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Agregado a la lista de lectura: %@"
          }
        }
      }
    },
    "Adds the selected books to the end of the reading list." : {
      "comment" : "VoiceOver hint of the Library's edit-mode bar button Add to Reading List.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Agrega los libros seleccionados al final de la lista de lectura."
          }
        }
      }
    },
    "Adjust minutes" : {
      "comment" : "VoiceOver label of the stepper beside the sleep timer sheet's custom minutes field.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ajustar minutos"
          }
        }
      }
    },
    "Ampersand" : {
      "comment" : "Name of the punctuation key \"&\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Ampersand\"."
    },
    "An unknown error occurred." : {
      "comment" : "Message of an alert about a problem, when nothing more is known about it."
    },
    "Apostrophe" : {
      "comment" : "Name of the punctuation key \"'\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Apostrophe\"."
    },
    "Apply Filter…" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Opens the choice of audio filters to apply to the selection."
    },
    "Articles (%lld)" : {
      "comment" : "The header of a list's news articles, with their count: \"Articles (3)\". %lld is the number of articles.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Articles (%lld)"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Articles (%lld)"
                }
              }
            }
          }
        }
      }
    },
    "Asks for an optional note, then marks the reading position." : {
      "comment" : "VoiceOver hint of the Bookmarks list's Add Bookmark button: it opens the step where an optional note is written, then the bookmark is added where the book is being read.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pide una nota opcional y luego marca la posición de lectura."
          }
        }
      }
    },
    "Asterisk" : {
      "comment" : "Name of the punctuation key \"*\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Asterisk\"."
    },
    "At Sign" : {
      "comment" : "Name of the punctuation key \"@\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + At Sign\"."
    },
    "Audio Editor" : {
      "comment" : "Heading of the group of the audio editor's keyboard shortcuts in Settings."
    },
    "Audio Info…" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Shows information about the audio, such as its format and length."
    },
    "Available only while this feed's articles go on to another article when one ends" : {
      "comment" : "VoiceOver hint of the dimmed Open the next article in pop-up button in a news feed's Feed Info: when it can be used.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disponible solo mientras los artículos de este canal pasan a otro artículo al terminar uno"
          }
        }
      }
    },
    "Available only while this feed's episodes go on to another episode when one ends" : {
      "comment" : "VoiceOver hint of the dimmed Open the next episode in pop-up button in a podcast feed's Feed Info: when it can be used.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disponible solo mientras los episodios de este canal pasan a otro episodio al terminar uno"
          }
        }
      }
    },
    "Available only while this feed's items go on to another item when one ends" : {
      "comment" : "VoiceOver hint of the dimmed Open the next item in pop-up button in a feed's Feed Info: when it can be used.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disponible solo mientras los elementos de este canal pasan a otro elemento al terminar uno"
          }
        }
      }
    },
    "Available only while this folder's books go on to another book when one ends" : {
      "comment" : "VoiceOver hint of the dimmed Open the next book in pop-up button in a folder's settings: when it can be used.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
