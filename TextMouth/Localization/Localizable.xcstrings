    "readerCloud.chapterNotDownloaded" : {
      "comment" : "Spoken when a chapter's download is cancelled. %1$@ is the chapter's number, an identifier written without digit grouping; %2$@ is the book's title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "الفصل %@ من %@ غير منزّل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@-এর অধ্যায় %1$@ ডাউনলোড করা নেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kapitel %1$@ von %2$@ ist nicht heruntergeladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chapter %@ of %@ isn't downloaded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El capítulo %1$@ de %2$@ no está descargado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فصل %1$@ از %2$@ بارگیری نشده است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le chapitre %1$@ de %2$@ n’est pas téléchargé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "פרק %1$@ מתוך %2$@ לא הורד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@ का अध्याय %1$@ डाउनलोड नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bab %1$@ dari %2$@ belum diunduh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il capitolo %@ di %@ non è scaricato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@のチャプタ%1$@はダウンロードされていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@의 챕터 %1$@이(가) 다운로드되지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hoofdstuk %1$@ van %2$@ is niet gedownload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rozdział %1$@ książki %2$@ nie jest pobrany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O capítulo %1$@ de %2$@ não está baixado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Глава %1$@ книги «%2$@» не загружена."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kapitel %1$@ i %2$@ är inte hämtat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "บทที่ %@ ของ %@ ไม่ได้ดาวน์โหลดไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@ kitabının %1$@ numaralı bölümü indirilmedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Розділ %1$@ із %2$@ не завантажено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@ کا باب %1$@ ڈاؤن لوڈ نہیں ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chương %1$@ của %2$@ chưa được tải về."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@ 的第 %1$@ 章尚未下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%2$@」的第 %1$@ 章未下載。"
          }
        }
      }
    },
