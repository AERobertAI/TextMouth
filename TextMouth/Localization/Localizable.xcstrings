    "shortcutsSettings.resetToDefaultHint" : {
      "comment" : "VoiceOver hint of the Reset to Default button of one keyboard shortcut action: the action goes back to the default keys, and later versions of TextMouth may change them.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يستعيد الاختصارات الافتراضية لهذا الإجراء، وهي تتبع تغييرات الإصدارات اللاحقة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই কাজের ডিফল্ট শর্টকাট ফিরিয়ে আনে, যা পরবর্তী সংস্করণের পরিবর্তন অনুসরণ করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stellt die Standard-Kurzbefehle dieser Aktion wieder her, die den Änderungen späterer Versionen folgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restores this action's default shortcuts, which follow later releases' changes"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Restaura los atajos predeterminados de esta acción, que siguen los cambios de versiones futuras"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "میان‌برهای پیش‌فرض این کنش را برمی‌گرداند که با تغییرهای نسخه‌های بعدی همراه می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rétablit les raccourcis par défaut de cette action, qui suivent les changements des versions ultérieures."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "משחזר את קיצורי ברירת המחדל של פעולה זו, שעוקבים אחר שינויים בגרסאות עתידיות."
