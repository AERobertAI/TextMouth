    "phoneAudio.cannotPlayNow" : {
      "comment" : "Announcement when Play fails on the iPhone because a phone call or another app holds the audio.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّر التشغيل: مكالمة أو تطبيق آخر يستخدم الصوت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "চালানো যাচ্ছে না: একটি কল বা অন্য একটি অ্যাপ অডিও ব্যবহার করছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wiedergabe nicht möglich: Ein Anruf oder eine andere App nutzt das Audio."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't play: a call or another app is using the audio."
          }
        },
