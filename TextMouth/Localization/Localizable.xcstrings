    "Chooses what the Library lists." : {
      "comment" : "Hint of the iPhone Library's row that chooses which view of the library is listed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Legt fest, was die Bibliothek auflistet."
          }
        },
        "es" : {
