    "libraryComparison.newerCopySentence.differ" : {
      "comment" : "Sentence of Use This Library's account: the copies differ, but neither has newer places or books the other lacks.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا تحتوي أي منهما على أماكن أو كتب أحدث ليست لدى الأخرى، لكنهما تختلفان من نواحٍ أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "কোনোটিতেই নতুন অবস্থান বা অন্যটিতে নেই এমন বই নেই, তবে অন্যান্য দিক থেকে কপি দুটি আলাদা।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Keine hat neuere Positionen oder Bücher, die der anderen fehlen, aber sie unterscheiden sich auf andere Weise."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neither has newer places or books the other lacks, but they differ in other ways."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ninguna tiene lugares más recientes ni libros que falten en la otra, pero difieren en otros aspectos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هیچ‌کدام نه مکان جدیدتری دارد و نه کتابی که دیگری نداشته باشد، اما از جهت‌های دیگر با هم فرق دارند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucune n’a de positions plus récentes ni de livres que l’autre n’a pas, mais elles diffèrent par d’autres points."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לאף אחד מהם אין מקומות חדשים יותר או ספרים שחסרים בשני, אבל הם נבדלים בדרכים אחרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "किसी में भी दूसरी कॉपी में न मिलने वाले नए स्थान या पुस्तकें नहीं हैं, लेकिन वे दूसरे तरीकों से अलग हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tidak ada salinan yang memiliki posisi lebih baru atau buku yang tidak dimiliki salinan lain, tetapi keduanya berbeda dalam hal lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nessuna delle due ha posizioni più recenti o libri che l’altra non ha, ma differiscono per altri aspetti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "どちらにも、もう一方にない新しい位置やブックはありませんが、ほかの点で異なります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "어느 쪽에도 상대에 없는 더 새로운 위치나 책은 없지만, 다른 점에서 차이가 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Geen van beide heeft nieuwere leesposities of boeken die de andere mist, maar ze verschillen op andere punten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Żadna nie ma nowszych miejsc ani książek, których brakuje drugiej, ale różnią się pod innymi względami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nenhuma das duas tem posições ou livros mais recentes que a outra não tenha, mas elas diferem de outras maneiras."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ни в одной нет более новых позиций чтения или книг, которых нет в другой, но они различаются в другом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ingen av dem har nyare platser eller böcker som den andra saknar, men de skiljer sig åt på andra sätt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไม่มีสำเนาใดมีตำแหน่งที่ใหม่กว่าหรือหนังสือที่อีกสำเนาไม่มี แต่ต่างกันในด้านอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hiçbirinde diğerinde olmayan daha yeni yerler veya kitaplar yok, ancak başka açılardan farklılar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Жодна копія не має новіших місць чи книг, яких немає в іншій, але вони відрізняються в інших аспектах."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کسی بھی کاپی میں زیادہ نئے مقامات یا ایسی کتابیں نہیں جو دوسری میں نہ ہوں، لیکن دونوں دوسرے طریقوں سے مختلف ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cả hai đều không có vị trí hay sách mới hơn mà bên kia không có, nhưng chúng khác nhau ở những điểm khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "两者都没有对方缺少的较新位置或图书，但在其他方面有所不同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "雙方都沒有另一方所缺少的較新位置或書籍，但在其他方面有差異。"
          }
        }
      }
    },
