            "value" : "TextMouth “%@” को नहीं बदल सकता: उसकी ध्वनि बीच में अपनी दर या चैनल इतने बदल देती है कि वह उन्हें नहीं सँभाल पाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tidak dapat mengonversi “%@”: laju atau saluran suaranya berubah di tengah, lebih dari yang dapat diikuti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
