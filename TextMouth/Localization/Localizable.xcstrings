        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Як швидко голос говорить у файлі. Починається зі швидкості книги."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "语音在文件中朗读的快慢。初始值为图书的速度。"
          }
        }
      }
    },
    "How high the voice sounds in the file. It starts at the book's pitch." : {
      "comment" : "The hint of the Pitch slider in the Export dialog's spoken audio options.",
      "localizations" : {
        "de" : {
