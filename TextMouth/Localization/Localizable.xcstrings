    "originalFileDeletion.asking.permanently" : {
      "comment" : "Caption in Storage settings under the choice that asks about the original file after each import, while files are deleted permanently.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ستُسأل بعد كل استيراد عمّا إذا كنت تريد حذف الملف الأصلي نهائيًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "প্রতিটি আমদানির পর মূল ফাইলটি স্থায়ীভাবে মুছবেন কি না, তা আপনাকে জিজ্ঞাসা করা হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nach jedem Import wirst du gefragt, ob die Originaldatei endgültig gelöscht werden soll."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will be asked whether to delete the original file permanently after each import."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se te preguntará si eliminar el archivo original de forma permanente después de cada importación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پس از هر وارد کردن پرسیده می‌شود که فایل اصلی برای همیشه حذف شود یا نه."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "On vous demandera après chaque importation si le fichier d’origine doit être supprimé définitivement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "תישאל אם למחוק את קובץ המקור לצמיתות לאחר כל ייבוא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "हर आयात के बाद आपसे पूछा जाएगा कि मूल फ़ाइल को स्थायी रूप से मिटाना है या नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Anda akan ditanya apakah file asli akan dihapus secara permanen setelah setiap impor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ti verrà chiesto se eliminare definitivamente il file originale dopo ogni importazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "読み込みのたびに、元のファイルを完全に削除するかどうかを確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "가져오기를 할 때마다 원본 파일을 영구적으로 삭제할지 묻습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Na elke import vraagt TextMouth of je het originele bestand definitief wilt verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Po każdym imporcie pojawi się pytanie, czy usunąć oryginalny plik na stałe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth perguntará se deseja excluir o arquivo original permanentemente após cada importação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "После каждого импорта вас будут спрашивать, удалять ли исходный файл безвозвратно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du får frågan om originalfilen ska raderas permanent efter varje import."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth จะถามว่าจะลบไฟล์ต้นฉบับอย่างถาวรหรือไม่หลังการนำเข้าแต่ละครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Her içe aktarmadan sonra orijinal dosyanın kalıcı olarak silinip silinmeyeceği sorulur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Після кожного імпорту вас запитуватимуть, чи видаляти оригінальний файл остаточно."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ہر درآمد کے بعد آپ سے پوچھا جائے گا کہ اصل فائل مستقل طور پر حذف کی جائے یا نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bạn sẽ được hỏi có xóa vĩnh viễn tệp gốc hay không sau mỗi lần nhập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "每次导入后都会询问你是否要永久删除原始文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "每次輸入後，系統會詢問你是否要永久刪除原始檔案。"
          }
        }
      }
    },
