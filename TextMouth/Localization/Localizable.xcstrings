            "value" : "Codifica del testo: %@"
          }
        }
      }
    },
    "Text extraction progress: %lld of %lld" : {
      "comment" : "VoiceOver label of the progress of Redo Text Extraction. %1$lld is how many books are done; %2$lld is how many books there are.",
      "localizations" : {
