    "daisyPackageError.referenceOutsidePackageFix" : {
      "comment" : "Last sentence of why a DAISY book kept as loose files could not be imported: the rule about files outside its folder.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يمكن استيراد الملفات الموجودة داخل المجلد فقط."
