    "The reading list is empty. To add a book, choose Add to Reading List from its actions." : {
      "comment" : "The only row of the iPhone's empty Reading List. \"Add to Reading List\" is the name of a book's action, so keep it the same as that action's label.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Leseliste ist leer. Um ein Buch hinzuzufügen, wähle bei seinen Aktionen „Zur Leseliste hinzufügen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La lista de lectura está vacía. Para agregar un libro, elige Agregar a la lista de lectura en sus acciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La liste de lecture est vide. Pour ajouter un livre, choisissez Ajouter à la liste de lecture dans ses actions."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "रीडिंग लिस्ट ख़ाली है। पुस्तक जोड़ने के लिए उसकी क्रियाओं से रीडिंग लिस्ट में जोड़ें चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Daftar bacaan kosong. Untuk menambahkan buku, pilih Tambahkan ke Daftar Bacaan dari tindakannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’elenco di lettura è vuoto. Per aggiungere un libro, scegli Aggiungi all’elenco di lettura dalle sue azioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "リーディングリストは空です。ブックを追加するには、そのアクションから「リーディングリストに追加」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "읽기 목록이 비어 있습니다. 책을 추가하려면 해당 책의 동작에서 읽기 목록에 추가를 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A lista de leitura está vazia. Para adicionar um livro, escolha Adicionar à lista de leitura em suas ações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Список для чтения пуст. Чтобы добавить книгу, выберите «Добавить в список для чтения» в её действиях."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Список читання порожній. Щоб додати книгу, виберіть «Додати до списку читання» в її діях."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "阅读列表为空。要添加图书，请从其操作中选取“添加到阅读列表”。"
          }
        }
      }
    },
    "The reading list is empty. To add a book, choose Add to Reading List from its context menu, its VoiceOver actions, or the Library menu." : {
      "comment" : "Shown and read as the only row of the Reading List while it holds no book. Add to Reading List is the name of the command in the Library menu.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Leseliste ist leer. Um ein Buch hinzuzufügen, wähle „Zur Leseliste hinzufügen“ in seinem Kontextmenü, in seinen VoiceOver-Aktionen oder im Menü „Bibliothek“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La lista de lectura está vacía. Para agregar un libro, elige Agregar a la lista de lectura en su menú contextual, sus acciones de VoiceOver o el menú Biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La liste de lecture est vide. Pour ajouter un livre, choisissez Ajouter à la liste de lecture dans son menu contextuel, ses actions VoiceOver ou le menu Bibliothèque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "रीडिंग लिस्ट ख़ाली है। पुस्तक जोड़ने के लिए उसके संदर्भ मेनू, उसकी VoiceOver क्रियाओं या लाइब्रेरी मेनू से रीडिंग लिस्ट में जोड़ें चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Daftar bacaan kosong. Untuk menambahkan buku, pilih Tambahkan ke Daftar Bacaan dari menu konteksnya, tindakan VoiceOver, atau menu Pustaka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’elenco di lettura è vuoto. Per aggiungere un libro, scegli Aggiungi all’elenco di lettura dal suo menu contestuale, dalle sue azioni di VoiceOver o dal menu Libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "リーディングリストは空です。ブックを追加するには、コンテキストメニュー、VoiceOver のアクション、またはライブラリメニューから「リーディングリストに追加」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "읽기 목록이 비어 있습니다. 책을 추가하려면 컨텍스트 메뉴, VoiceOver 동작 또는 보관함 메뉴에서 읽기 목록에 추가를 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A lista de leitura está vazia. Para adicionar um livro, escolha Adicionar à lista de leitura no menu de contexto dele, nas ações do VoiceOver ou no menu Biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Список для чтения пуст. Чтобы добавить книгу, выберите «Добавить в список для чтения» в её контекстном меню, действиях VoiceOver или меню «Библиотека»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Список читання порожній. Щоб додати книгу, виберіть «Додати до списку читання» в її контекстному меню, її діях VoiceOver або в меню «Бібліотека»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "阅读列表为空。要添加图书，请从其上下文菜单、VoiceOver 操作或“资料库”菜单中选取“添加到阅读列表”。"
          }
        }
      }
    },
    "The reading list is set to stop when a book ends" : {
      "comment" : "A sentence of the announcement as a book read from the reading list ends, after \"Finished: <title>.\": the list's When a book ends is Stop. Written without its full stop.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Leseliste ist so eingestellt, dass sie stoppt, wenn ein Buch endet"
