    "audioEditor.revertNoOriginal" : {
      "comment" : "Said by the audio editor's Revert to Original when the book keeps no original audio.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يُحتفظ بالأصل، لذا لا يمكن الرجوع إليه. يتراجع الأمر “تراجع” عن التعديلات منذ آخر حفظ."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "মূল অডিও রাখা হয়নি, তাই আগের অবস্থায় ফেরা যায় না। “পূর্বাবস্থায় ফেরান” দিয়ে শেষ সংরক্ষণের পরের সম্পাদনাগুলো ফেরানো যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es wird kein Original aufbewahrt, daher kann nicht zurückgesetzt werden. „Widerrufen“ nimmt Bearbeitungen seit dem letzten Sichern zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No original is kept, so it can't be reverted. Undo takes back edits since the last save."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se conserva ningún original, así que no se puede revertir. Deshacer anula las ediciones desde el último guardado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صدای اصلی نگه داشته نشده است، پس بازگردانی ممکن نیست. «واگرد» ویرایش‌های پس از آخرین ذخیره را پس می‌گیرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucun original n’est conservé, donc le retour à l’original est impossible. Annuler défait les modifications faites depuis le dernier enregistrement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא נשמר מקור, ולכן אי אפשר לשחזר אותו. “בטל פעולה” מבטל עריכות מאז השמירה האחרונה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कोई मूल ऑडियो नहीं रखा गया है, इसलिए मूल स्थिति में नहीं लौटा जा सकता। पिछली बार सहेजने के बाद के संपादन “पूर्ववत करें” से वापस लिए जा सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Audio asli tidak disimpan, sehingga tidak dapat dikembalikan ke semula. Pilih Urungkan untuk menarik kembali edit sejak penyimpanan terakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non viene conservato alcun originale, quindi non si può ripristinare. Con Annulla si annullano le modifiche dall’ultimo salvataggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "元のオーディオが保持されていないため、元の状態には戻せません。「取り消す」で、最後の保存以降の編集を取り消せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "원본이 보관되어 있지 않아 되돌릴 수 없습니다. 실행 취소는 마지막 저장 이후의 편집만 취소합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Er wordt geen origineel bewaard, dus terugkeren is niet mogelijk. Met Maak ongedaan maak je bewerkingen sinds de laatste keer bewaren ongedaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie zachowano oryginału, więc nie można go przywrócić. Cofnij cofa edycje od ostatniego zachowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nenhum original é mantido, então não é possível reverter. Desfazer anula as edições feitas desde o último salvamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Оригинал не хранится, поэтому вернуть его нельзя. Команда «Отменить» отменяет правки, сделанные после последнего сохранения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Inget original behålls, så det går inte att återgå. Ångra tar tillbaka redigeringar sedan den senaste sparningen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไม่ได้เก็บต้นฉบับ จึงย้อนกลับไม่ได้ คำสั่ง เลิกทำ จะยกเลิกการแก้ไขตั้งแต่การบันทึกครั้งล่าสุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Orijinal saklanmadığından eski haline döndürülemez. Geri Al, son kaydetmeden beri yapılan düzenlemeleri geri alır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Оригінал не збережено, тому повернутися до нього не можна. «Відмінити» скасовує правки від останнього збереження."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کوئی اصل نہیں رکھا گیا، اس لیے اصل حالت پر نہیں لایا جا سکتا۔ “کالعدم کریں” آخری بار محفوظ کرنے کے بعد کی ترامیم واپس لیتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không giữ bản gốc nào, nên không thể hoàn nguyên. Hoàn tác sẽ đảo ngược các chỉnh sửa kể từ lần lưu gần nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "没有保留原始音频，因此无法还原。“撤销”可取消上次存储之后的编辑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "沒有保留原始檔，因此無法回復。「還原」可以取消上次儲存以來的編輯。"
          }
        }
      }
    },
