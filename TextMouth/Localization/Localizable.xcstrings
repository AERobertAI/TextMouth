    "fileImportService.libraryAlreadyHad" : {
      "comment" : "Warning about a book that moved into the current library format. %1$@ is the name of the package that already held other content; %2$@ is the name of the new package; %3$@ is the path where the original file was kept.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "كان في المكتبة محتوى مختلف تحت اسم حزمته، %@، لذا خُزّن في حزمة جديدة، %@، وتم الاحتفاظ بملفه الأصلي في %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "লাইব্রেরির প্যাকেজ নাম %1$@-এর অধীনে আগে থেকেই ভিন্ন বিষয়বস্তু ছিল, তাই এটি নতুন প্যাকেজ %2$@-এ রাখা হয়েছে এবং এর মূল ফাইল %3$@-এ রাখা হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Bibliothek hatte unter ihrem Paketnamen %1$@ bereits anderen Inhalt, daher wurde das Buch in einem neuen Paket, %2$@, gespeichert, und seine Originaldatei wurde unter %3$@ aufbewahrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The library already had different content under its package name, %@, so it was stored in a new package, %@, and its original file was kept at %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La biblioteca ya tenía contenido distinto con el nombre de paquete %1$@, así que se guardó en un paquete nuevo, %2$@, y su archivo original se conservó en %3$@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتابخانه از قبل محتوای متفاوتی با نام بسته‌ی این کتاب، %1$@، داشت، بنابراین کتاب در بسته‌ای جدید، %2$@، ذخیره شد و فایل اصلی آن در %3$@ نگه داشته شد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La bibliothèque contenait déjà un contenu différent sous le nom de paquet %1$@ ; il a donc été stocké dans un nouveau paquet, %2$@, et son fichier d’origine a été conservé dans %3$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בספרייה כבר היה תוכן אחר תחת שם החבילה שלו, %1$@, ולכן הוא נשמר בחבילה חדשה, %2$@, וקובץ המקור שלו נשמר בנתיב %3$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लाइब्रेरी में उसके पैकेज नाम, %1$@, के अंतर्गत पहले से अलग सामग्री थी, इसलिए उसे नए पैकेज, %2$@, में रखा गया, और उसकी मूल फ़ाइल %3$@ पर रखी गई।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pustaka sudah memiliki konten berbeda dengan nama paket %1$@, jadi buku disimpan di paket baru, %2$@, dan file aslinya disimpan di %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La libreria aveva già un contenuto diverso con il nome del suo pacchetto, %@, quindi il libro è stato archiviato in un nuovo pacchetto, %@, e il suo file originale è stato conservato in %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ライブラリには、パッケージ名%1$@で別の内容がすでにあったため、新しいパッケージ%2$@に保存し、元のファイルは%3$@に残しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관함의 패키지 이름 %1$@에 이미 다른 내용이 있어 새 패키지 %2$@에 저장했으며, 원본 파일은 %3$@에 보관했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De bibliotheek had al andere inhoud onder de pakketnaam %1$@, dus het boek is opgeslagen in een nieuw pakket, %2$@, en het originele bestand is bewaard op %3$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Biblioteka miała już inną zawartość pod nazwą pakietu %1$@, więc książkę zapisano w nowym pakiecie %2$@, a jej oryginalny plik zachowano w %3$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A biblioteca já tinha conteúdo diferente com o nome de pacote %1$@, então ele foi guardado em um novo pacote, %2$@, e o arquivo original foi mantido em %3$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В библиотеке под именем пакета %1$@ уже было другое содержимое, поэтому книга сохранена в новом пакете %2$@, а её исходный файл оставлен в %3$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Biblioteket hade redan annat innehåll under sitt paketnamn, %1$@, så det lagrades i ett nytt paket, %2$@, och dess originalfil behölls på %3$@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไลบรารีมีเนื้อหาอื่นอยู่แล้วภายใต้ชื่อแพ็กเกจ %@ จึงเก็บไว้ในแพ็กเกจใหม่ %@ และเก็บไฟล์ต้นฉบับไว้ที่ %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitaplıkta paket adı (%1$@) altında zaten farklı içerik vardı; bu yüzden yeni bir pakette (%2$@) saklandı ve orijinal dosyası şurada tutuldu: %3$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "У бібліотеці вже був інший вміст під назвою пакета %1$@, тому книгу збережено в новому пакеті %2$@, а її оригінальний файл залишено в %3$@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لائبریری میں اس کے پیکیج کے نام، %1$@، کے تحت پہلے سے مختلف مواد موجود تھا، اس لیے اسے نئے پیکیج، %2$@، میں رکھا گیا، اور اس کی اصل فائل %3$@ پر رکھی گئی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thư viện đã có nội dung khác dưới tên gói của nó, %1$@, nên nó được lưu trong một gói mới, %2$@, và tệp gốc của nó được giữ tại %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "资料库的包名称 %1$@ 下已有不同的内容，因此已将其存储到新的包 %2$@ 中，其原始文件保留在 %3$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "書庫中已有其他內容使用它的套件名稱 %1$@，因此它存放在新的套件 %2$@ 中，原始檔案保留在 %3$@。"
          }
        }
      }
    },
