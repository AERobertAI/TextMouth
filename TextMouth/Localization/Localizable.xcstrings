        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta ventana"
          }
        }
      }
    },
    "This XML file is not a DTBook book, a Word 2003 XML document, or a PEF braille file, the only XML TextMouth reads." : {
      "comment" : "Why an XML file was refused at import: its root element is not one of the three kinds TextMouth reads. DTBook, Word 2003 XML, and PEF are format names."
    },
    "This article has no description." : {
      "comment" : "What Show Description says for an article that has no description."
    },
    "This audio has no chapter markers." : {
      "comment" : "Said by the audio editor's chapter commands when the audio has no chapter markers."
    },
    "This audiobook has no audio to transcribe." : {
      "comment" : "Error shown when transcription is tried for an audiobook with no audio file."
    },
    "This book could not be deleted and remains in the library:" : {
      "comment" : "Heading over the one book that could not be deleted permanently. A line about it follows."
    },
    "This book could not be moved to the Trash and remains in the library:" : {
      "comment" : "Heading over the one book that could not be moved to the Trash. A line about it follows."
    },
    "This book could not be removed from the library and remains in it:" : {
      "comment" : "Heading of the error alert's list when Remove from Library Only could not mark one book's package, so it stays in the library. The book's title and the reason follow on the next line.\nHeading over the one book that could not be removed from the library. A line about it follows."
    },
    "This book follows the global setting now." : {
      "comment" : "Said as a book's original audio policy is set to follow the global setting. A sentence saying what that setting does follows."
    },
    "This book has %lld pages, from %@ to %@." : {
      "comment" : "First sentence of the Go to Page field's hint. %1$lld is the number of pages in the book; %2$@ is the first page's label and %3$@ the last page's label, identifiers such as i or 300 written without digit grouping.",
