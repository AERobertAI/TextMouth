      "comment" : "Name of the book information sheet's field for a book's publisher; VoiceOver reads it as the field's label."
    },
    "Punch In" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Records new audio over the selection."
    },
    "Punctuation Pauses" : {
      "comment" : "Heading of the punctuation pause group in the Playback settings."
    },
    "Punctuation pause level" : {
