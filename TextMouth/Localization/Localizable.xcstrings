          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O índice de leitura dele não pôde ser salvo, então o TextMouth vai criá-lo de novo mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не удалось сохранить её индекс чтения, поэтому TextMouth построит его позже."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Її індекс читання не вдалося зберегти, тому TextMouth побудує його знову пізніше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
