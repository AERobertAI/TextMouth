          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "0 = %1$@, 1 = %2$@ (pontos finais), 2 = %3$@ (+ vírgulas), 3 = %4$@ (+ quebras de parágrafo)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "0 = %1$@, 1 = %2$@ (точки), 2 = %3$@ (+ запятые), 3 = %4$@ (+ разрывы абзацев)"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "0 = %1$@, 1 = %2$@ (крапки), 2 = %3$@ (+ коми), 3 = %4$@ (+ розриви абзаців)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "0 = %1$@，1 = %2$@（句号），2 = %3$@（加逗号），3 = %4$@（加段落分隔）"
          }
        }
      }
    },
    "1 book in this library needs a newer version of TextMouth. It is kept as it is, but not shown." : {
      "comment" : "Storage settings note: one book of the library was added by a newer TextMouth, which this one keeps but can't show.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "1 Buch in dieser Bibliothek benötigt eine neuere Version von TextMouth. Es bleibt unverändert erhalten, wird aber nicht angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "1 libro de esta biblioteca necesita una versión más reciente de TextMouth. Se conserva tal como está, pero no se muestra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "1 livre de cette bibliothèque nécessite une version plus récente de TextMouth. Il est conservé tel quel, mais n’est pas affiché."
