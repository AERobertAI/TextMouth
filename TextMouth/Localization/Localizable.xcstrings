          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scegli una trascrizione WebVTT (.vtt) o SubRip (.srt) di %@, temporizzata dall’inizio dell’audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@の WebVTT（.vtt）または SubRip（.srt）形式の文字起こしを選んでください。時刻はオーディオの先頭からのものにします。"
