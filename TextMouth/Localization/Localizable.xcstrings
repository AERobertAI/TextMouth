          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ neue Aufnahme eingefügt und ausgewählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se insertó una grabación nueva de %@, que queda seleccionada."
          }
        },
