          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "มีมุมมองอื่นชื่อ %@ เปลี่ยนชื่อมุมมองนั้นก่อน แล้วค่อยคืนค่ามุมมองนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Başka bir görünümün adı %@. Önce onu yeniden adlandırın, sonra bu görünümü geri yükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Інший вигляд має назву %@. Спершу перейменуйте його, а потім відновіть цей вигляд."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ نام کا ایک اور منظر موجود ہے۔ پہلے اس کا نام تبدیل کریں، پھر اس منظر کو بحال کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đã có chế độ xem khác tên %@. Hãy đổi tên chế độ xem đó trước, rồi khôi phục chế độ xem này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "另一个视图名为 %@。请先重新命名该视图，再恢复此视图。"
