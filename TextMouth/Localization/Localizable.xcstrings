    "markupRefusal.getAnotherCopyAdvice" : {
      "comment" : "Last sentence of why a file was refused for its markup: what to do.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "احصل على نسخة أخرى من الملف، أو احفظه بتنسيق آخر، ثم استورده مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফাইলের আরেকটি কপি সংগ্রহ করুন বা অন্য ফরম্যাটে সংরক্ষণ করুন, তারপর আবার আমদানি করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Besorge dir eine andere Kopie der Datei oder sichere sie in einem anderen Format und importiere sie dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get another copy of the file, or save it in another format, then import it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Consigue otra copia del archivo, o guárdalo en otro formato, y vuelve a importarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نسخه دیگری از فایل بگیرید یا آن را با قالب دیگری ذخیره کنید، سپس دوباره وارد کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Procurez-vous une autre copie du fichier, ou enregistrez-le dans un autre format, puis importez-le à nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "השג עותק אחר של הקובץ, או שמור אותו בפורמט אחר, ואז ייבא אותו שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ाइल की दूसरी प्रति प्राप्त करें, या उसे किसी दूसरे फ़ॉर्मैट में सहेजें, फिर उसे दोबारा आयात करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dapatkan salinan file yang lain, atau simpan dalam format lain, lalu impor lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Procurati un’altra copia del file, oppure salvalo in un altro formato, poi importalo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ファイルの別のコピーを入手するか、別のフォーマットで保存してから、もう一度読み込んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "파일의 다른 사본을 구하거나 다른 포맷으로 저장한 다음 다시 가져오십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zorg voor een andere kopie van het bestand, of bewaar het in een ander formaat, en importeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pobierz inną kopię pliku lub zachowaj go w innym formacie, a następnie zaimportuj go ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Obtenha outra cópia do arquivo, ou salve-o em outro formato, e importe-o novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
