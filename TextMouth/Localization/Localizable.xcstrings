          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ зберігається на цьому Mac для списку читання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 因在阅读列表中而保留在这台 Mac 上。"
          }
        }
      }
    },
    "%@ is no longer in the library." : {
      "comment" : "Announcement when the book of a search match has left the library since the search. %@ is the book's title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
