          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta visualização é como o TextMouth a criou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Это представление такое, каким его создал TextMouth."
          }
        },
        "uk" : {
          "stringUnit" : {
