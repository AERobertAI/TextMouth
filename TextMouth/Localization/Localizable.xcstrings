        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kapitel som sparas i en vecka: alla, det vill säga %@. De finns kvar tills en annan export av uppläst ljud startar eller bokens röst, text, ersättningar eller pauser ändras. Om du vill göra ljudfilen av dem exporterar du samma intervall med samma hastighet och tonhöjd."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "บทที่เก็บไว้หนึ่งสัปดาห์: ทั้งหมด คือ %@ บทเหล่านี้จะอยู่จนกว่าการส่งออกเสียงอ่านครั้งอื่นจะเริ่ม หรือเสียง ข้อความ การแทนที่ หรือช่วงหยุดของหนังสือเปลี่ยนไป หากต้องการสร้างไฟล์เสียงจากบทเหล่านั้น ให้ส่งออกช่วงเดียวกันด้วยความเร็วและความสูงต่ำของเสียงเท่าเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bir hafta saklanan bölümler: hepsi, yani %@. Farklı bir seslendirilmiş ses dışa aktarması başlayana veya kitabın sesi, metni, değiştirmeleri ya da duraklamaları değişene kadar kalırlar. Bunlardan ses dosyasını oluşturmak için aynı aralığı aynı hız ve perdeyle dışa aktarın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Розділи, збережені на тиждень: усі, тобто %@. Вони залишаються до початку іншого експорту озвученого аудіо або зміни голосу, тексту, замін чи пауз книги. Щоб створити з них аудіофайл, експортуйте той самий діапазон з тією самою швидкістю й висотою тону."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ایک ہفتے کے لیے رکھے گئے ابواب: تمام، یعنی %@۔ یہ اس وقت تک رہتے ہیں جب تک کوئی دوسری بولی گئی آڈیو برآمد شروع نہ ہو یا کتاب کی آواز، متن، تبدیلی کے اصول یا وقفے نہ بدلیں۔ ان سے آڈیو فائل بنانے کے لیے اسی رفتار اور پچ پر وہی حد برآمد کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Các chương được giữ trong một tuần: tất cả, tức là %@. Chúng được giữ cho đến khi một lần xuất âm thanh đọc khác bắt đầu, hoặc giọng nói, văn bản, quy tắc thay thế hay quãng nghỉ của sách thay đổi. Để tạo tệp âm thanh từ các chương này, hãy xuất cùng phạm vi với cùng tốc độ và cao độ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "保留一周的章节：全部，共 %@ 章。它们会保留到开始另一次朗读音频导出，或图书的语音、文本、替换或停顿发生变化。若要用它们制作音频文件，请以同样的速度和音调导出相同范围。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "保留一週的章節：全部，共 %@ 章。它們會保留到開始另一次語音音訊輸出，或書籍的語音、文字、取代規則或停頓更改為止。若要用它們製作音訊檔案，請以相同的速度和音調輸出相同範圍。"
          }
        }
      }
    },
    "speechExport.licence" : {
      "comment" : "The line in the Export dialog's spoken audio options about the licence the Mac's voices come with.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نطق أصوات Mac مخصص للاستخدام الشخصي غير التجاري، بموجب ترخيص Apple."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mac-এর ভয়েস থেকে স্পিচ Apple-এর লাইসেন্সের অধীনে ব্যক্তিগত, অবাণিজ্যিক ব্যবহারের জন্য।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Sprachausgabe der Stimmen des Mac ist für den persönlichen, nicht kommerziellen Gebrauch bestimmt, gemäß der Lizenz von Apple."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speech from the Mac's voices is for personal, non-commercial use, under Apple's licence."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El audio de las voces de la Mac es para uso personal y no comercial, según la licencia de Apple."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "گفتار صداهای Mac برای استفاده شخصی و غیرتجاری است، تحت مجوز Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les voix du Mac sont destinées à un usage personnel et non commercial, selon la licence d’Apple."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "דיבור מהקולות של Mac מיועד לשימוש אישי ולא מסחרי, לפי הרישיון של Apple."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mac की आवाज़ों से बनी स्पीच व्यक्तिगत, गैर-व्यावसायिक उपयोग के लिए है, Apple के लाइसेंस के तहत।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ucapan dari suara Mac hanya untuk penggunaan pribadi dan nonkomersial, berdasarkan lisensi Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La sintesi vocale delle voci del Mac è per uso personale e non commerciale, secondo la licenza di Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mac の声による読み上げは、Apple のライセンスに基づき、個人的かつ非営利の目的でのみ使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mac의 음성으로 만든 오디오는 Apple 라이선스에 따라 개인적인 비상업적 용도로만 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Spraak van de stemmen van de Mac is voor persoonlijk, niet-commercieel gebruik, onder de licentie van Apple."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mowa generowana przez głosy komputera Mac jest przeznaczona do użytku osobistego i niekomercyjnego, zgodnie z licencją Apple."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A fala das vozes do Mac é para uso pessoal e não comercial, sob a licença da Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Речь, созданная голосами Mac, предназначена для личного некоммерческого использования по лицензии Apple."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tal från Mac-datorns röster är för personligt, icke-kommersiellt bruk, enligt licensen från Apple."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "การอ่านออกเสียงจากเสียงของ Mac ใช้ส่วนตัวและไม่ใช่เชิงพาณิชย์ตามใบอนุญาตของ Apple"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mac'in seslerinden gelen konuşma, Apple lisansı uyarınca kişisel ve ticari olmayan kullanım içindir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Озвучення голосами Mac призначене для особистого некомерційного використання згідно з ліцензією Apple."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mac کی آوازوں کی اسپیچ Apple کے لائسنس کے تحت ذاتی، غیر تجارتی استعمال کے لیے ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Giọng đọc từ các giọng nói của máy Mac chỉ dành cho mục đích cá nhân, phi thương mại, theo giấy phép của Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mac 语音的朗读内容仅供个人非商业用途，须遵循 Apple 的许可。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mac 語音的朗讀內容僅供個人非商業用途，須遵守 Apple 的授權。"
          }
        }
      }
    },
