        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth moveu a nova cópia de “%@” para a Lixeira, porque a pergunta sobre mantê-la como duplicata não foi respondida antes de o TextMouth fechar. Para recuperá-la, abra a Lixeira e escolha Recolocar."
          }
        }
      }
    },
    "TextMouth moves them back once it has finished moving books between folders." : {
      "comment" : "Why a failed move of files waits: it runs when books have been moved between folders. \"Them\" is the files.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth verschiebt sie zurück, sobald es das Verschieben von Büchern zwischen Ordnern beendet hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth los devuelve cuando termine de mover libros entre carpetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth les remet en place dès qu’il a fini de déplacer des livres entre des dossiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth li sposta di nuovo quando ha finito di spostare i libri tra le cartelle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth os move de volta quando terminar de mover livros entre pastas."
          }
        }
      }
    },
    "TextMouth moves them back once it has finished rebuilding its data directory." : {
