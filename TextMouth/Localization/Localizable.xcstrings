    "Next in Folder" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Navigation group and read by VoiceOver. Goes to the next book in the same folder or feed. Also the title of the menu command of the same name."
    },
    "Next in Reading List" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Navigation group and read by VoiceOver. Opens the next book in the reading list. Also the title of the menu command of the same name."
    },
    "Next paragraph" : {
      "comment" : "Announcement after the reader moved to the next paragraph."
    },
    "Next section" : {
      "comment" : "Announcement after a sentence or paragraph move crossed into the next section of the book, when no heading names it."
    },
    "Next sentence" : {
      "comment" : "Announcement after the reader moved to the next sentence."
    },
    "No book in the library has text to search." : {
      "comment" : "Status line of the Search Library window when no book in the library has text that can be searched."
    },
    "No book is loaded." : {
      "comment" : "What Where Am I? says when no book is open."
    },
    "No bookmarks yet." : {
      "comment" : "Shown and read in the Bookmarks list of a book with no bookmark. A sentence saying how to add one follows it.",
