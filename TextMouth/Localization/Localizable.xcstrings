          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth перестанет использовать библиотеку в %1$@ (%2$@) и откроет вместо неё библиотеку в %3$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth припинить використовувати бібліотеку в %1$@ (%2$@) і відкриє натомість бібліотеку в %3$@."
          }
