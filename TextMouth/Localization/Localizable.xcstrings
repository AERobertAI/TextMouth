          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Se deshacen %lld de ediciones. Rehacer las recupera hasta que hagas otra edición."
