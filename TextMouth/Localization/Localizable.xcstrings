{
  "sourceLanguage" : "en",
  "strings" : {
    "\"%@\" plays the next book in the same folder by sort order." : {
      "comment" : "Explanation under the When book ends pop-up in the Playback settings. %@ is the title of the pop-up's choice that plays the next book, as the pop-up shows it."
    },
    "%@ %@" : {
      "comment" : "Announcement of the microphone level every few seconds while recording. %1$@ is the level's label and %2$@ is the level in words, such as \"minus 12 decibels, good\".\nJoins two whole sentences into one text. %1$@ is the first sentence and %2$@ the second. English puts a space between them; Japanese and Chinese join sentences with no space at all, so change only the separator.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ (%@)" : {
      "comment" : "The second choice of the Log location pop-up in the Storage settings. %1$@ is the choice's name, and %2$@ is the folder's name on this Mac, a path that stays as written, such as ~/Library/Logs/TextMouth.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@)"
          }
        }
      }
    },
    "%@ adds a bookmark at the current position." : {
      "comment" : "Help under \"No bookmarks yet.\" in the Bookmarks list. %@ is the keyboard shortcut that adds a bookmark, spelled out in words, such as Command + B.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ agrega un marcador en la posición actual."
          }
        }
      }
    },
    "%@ adds one at the current position." : {
      "comment" : "Help under \"No bookmarks yet.\" in the Bookmarks list, when the add command has no keyboard shortcut. %@ is the name of the Add Bookmark button above the list.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ agrega uno en la posición actual."
          }
        }
      }
    },
    "%@ by %@" : {
      "comment" : "The shared title and author of a group of duplicate books that match by both, in the group's heading. %1$@ is the title and %2$@ is the author.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ by %2$@"
          }
        }
      }
    },
    "%@ deleted" : {
      "comment" : "Announcement after a substitution rule is deleted. %@ is the rule's name."
    },
    "%@ has no transcript text to search now, because %@" : {
      "comment" : "Said instead of opening Search in Book when the book's audio changed after its transcript was made. %1$@ is the book's title and %2$@ is the reason, a whole sentence that ends with its own full stop.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has no transcript text to search now, because %2$@"
          }
        }
      }
    },
    "%@ has no transcript text to search now, because its edited text can't be used: %@" : {
      "comment" : "Said instead of opening Search in Book when the book's edited transcript text was held back. %1$@ is the book's title and %2$@ is the reason, a whole sentence that ends with its own full stop.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has no transcript text to search now, because its edited text can't be used: %2$@"
          }
        }
      }
    },
    "%@ has no transcript text to search now." : {
      "comment" : "Said instead of opening Search in Book when a book's transcript text cannot be searched and no reason is known. %@ is the book's title."
    },
    "%@ has no transcript to search." : {
      "comment" : "Said instead of opening Search in Book for an audiobook that has no transcript, where TextMouth cannot make one. %@ is the book's title."
    },
    "%@ has no transcript to search. Transcribe it first, with Transcribe Audio." : {
      "comment" : "Said instead of opening Search in Book for an audiobook that has no transcript yet. %@ is the book's title. Transcribe Audio is the name of a command in the Book menu."
    },
    "%@ is already in the reading list." : {
      "comment" : "VoiceOver announcement when Add to Reading List added nothing: the one book selected is on the list already. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ya está en la lista de lectura."
          }
        }
      }
    },
    "%@ is no longer in the library." : {
      "comment" : "Announcement when the book of a search match has left the library since the search. %@ is the book's title."
    },
    "%@ isn't available, so TextMouth can't record from it. Choose another microphone." : {
      "comment" : "Error in the Record window when the chosen microphone is not available. %@ is the microphone's name."
    },
    "%@ isn't in the reading list." : {
      "comment" : "VoiceOver announcement when Remove from Reading List took nothing off: the one book selected is not on the list. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no está en la lista de lectura."
          }
        }
      }
    },
    "%@ moved to position %@ of %@" : {
      "comment" : "Announcement after a substitution rule moves in the list. %1$@ is the rule's name, %2$@ is its new place counting from one, and %3$@ is how many rules the list holds.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ moved to position %2$@ of %3$@"
          }
        }
      }
    },
    "%@ not recording" : {
      "comment" : "Announcement of the microphone level while nothing is recording. %@ is the level's label."
    },
    "%@ remaining" : {
      "comment" : "The sleep timer's state as VoiceOver reads it after \"Sleep timer:\" while it counts down. %@ is the time left in minutes and seconds, such as 4:59.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "quedan %@"
          }
        }
      }
    },
    "%@ seconds" : {
      "comment" : "A length of time in seconds with one decimal digit, such as \"0.5 seconds\". %@ is the already formatted number."
    },
    "%@ silent" : {
      "comment" : "Announcement of the microphone level when no sound reaches TextMouth. %@ is the level's label."
    },
    "%@ was connected, so recordings use it." : {
      "comment" : "Said by the Record window when a microphone connects and recordings now use it. %@ is the microphone's name."
    },
    "%@ was connected; choose it in the %@ pop-up to record from it." : {
      "comment" : "Said by the Record window when one microphone connects and is added to the Microphone pop-up. %1$@ is the microphone's name and %2$@ is the pop-up's label.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ was connected; choose it in the %2$@ pop-up to record from it."
          }
        }
      }
    },
    "%@ was disconnected, so recording stopped. What was recorded until then is kept." : {
      "comment" : "Error in the Record window when the microphone was unplugged while recording. %@ is the microphone's name."
    },
    "%@ was disconnected, so recordings use %@." : {
      "comment" : "Said by the Record window when the chosen microphone is unplugged and another takes its place. %1$@ is the microphone that went away and %2$@ is the one recordings use now.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ was disconnected, so recordings use %2$@."
          }
        }
      }
    },
    "%@ was disconnected. Connect a microphone to record." : {
      "comment" : "Said by the Record window when the chosen microphone is unplugged and no other is connected. %@ is the microphone's name."
    },
    "%@ were connected; choose one in the %@ pop-up to record from it." : {
      "comment" : "Said by the Record window when several microphones connect and are added to the Microphone pop-up. %1$@ is their names as a list and %2$@ is the pop-up's label.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ were connected; choose one in the %2$@ pop-up to record from it."
          }
        }
      }
    },
    "%@, %@" : {
      "comment" : "Joins two parts of a label with a comma. %1$@ is the text so far and %2$@ the next part. English puts a comma and a space between them.\nThe microphone level spoken in the Record window. %1$@ is the level in decibels in words, such as \"minus 12 decibels\", and %2$@ is a word for how loud that is, such as \"good\".\nThe right side of a row in the Library views settings: whether the view is built in or custom, then when it shows. %1$@ is built in or custom and %2$@ is its visibility, such as \"always\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%@, %@ quality" : {
      "comment" : "VoiceOver label of a voice in the voice pop-up. %1$@ is the voice's name and %2$@ is its quality, such as Enhanced.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@ quality"
          }
        }
      }
    },
    "%@, %@, in %@" : {
      "comment" : "VoiceOver label of a search match: the match in its text, where it is in the book, then the book. %1$@ is the match in its surrounding text, %2$@ is its place, such as a chapter's title, and %3$@ is the book's title.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@, in %3$@"
          }
        }
      }
    },
    "%@, and %lld in all" : {
      "comment" : "Note on a finished search's status: the list also stops after this many matches in all. %1$@ is the note \"showing up to 20 in each book\", and %2$lld is the number of matches shown in all.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@, and %lld in all"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@, and %lld in all"
                }
              }
            }
          }
        }
      }
    },
    "%@, at %@" : {
      "comment" : "VoiceOver label and rotor entry of a search result in a transcribed audiobook. %1$@ is the match with its context and place, and %2$@ is the time it is heard, spoken.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, at %2$@"
          }
        }
      }
    },
    "%@, at %@ into book" : {
      "comment" : "VoiceOver label of a search result placed by an estimated time. %1$@ is the match with its context and place, and %2$@ is the time into the book, spoken.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, at %2$@ into book"
          }
        }
      }
    },
    "%@, at %@ percent of book" : {
      "comment" : "VoiceOver label of a search result placed by percentage. %1$@ is the match with its context and place, and %2$@ is the percentage through the book with one decimal digit, such as 12.5.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, at %2$@ percent of book"
          }
        }
      }
    },
    "%@, by %@" : {
      "comment" : "A book's title and author in a search result's heading. %1$@ is the book's title and %2$@ its author.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, by %2$@"
          }
        }
      }
    },
    "%@, by %@, %@, in %@, added %@" : {
      "comment" : "A duplicate book's row, spoken and shown as one label in Find Duplicate Books. %1$@ is the title, %2$@ the author, %3$@ the format, %4$@ the library folder it is in, and %5$@ the date it was added.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, by %2$@, %3$@, in %4$@, added %5$@"
          }
        }
      }
    },
    "%@, in %@" : {
      "comment" : "VoiceOver label of a search match whose place in the book is unknown. %1$@ is the match in its surrounding text, and %2$@ is the book's title.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, in %2$@"
          }
        }
      }
    },
    "%@, then %@" : {
      "comment" : "Joins two steps of the restart gesture's summary in the Miscellaneous settings. %1$@ is the steps so far and %2$@ is the next step, such as \"Previous track, then Play\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, then %2$@"
          }
        }
      }
    },
    "%@: %@" : {
      "comment" : "A label and its value on one line, such as \"Elapsed: 1:04\". %1$@ is the label and %2$@ its value. English puts a colon and a space between them.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@"
          }
        }
      }
    },
    "%@: %@ dB peak, %@ dB average, %@" : {
      "comment" : "The microphone level line of the Record window while recording. %1$@ is the level's label, %2$@ is the loudest sample's level in decibels with a minus sign, %3$@ is the average level in decibels, and %4$@ is a word for how loud that is, such as \"good\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@ dB peak, %3$@ dB average, %4$@"
          }
        }
      }
    },
    "%@: %lld matches" : {
      "comment" : "A book's heading over its search matches. %1$@ is the book's title, with its author when known, and %2$lld is the number of matches.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@: %lld match"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@: %lld matches"
                }
              }
            }
          }
        }
      }
    },
    "%@: more than %lld matches" : {
      "comment" : "A book's heading over its search matches when the count stopped at its limit. %1$@ is the book's title, with its author when known, and %2$lld is the number of matches.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@: more than %lld match"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@: more than %lld matches"
                }
              }
            }
          }
        }
      }
    },
    "%@: not recording" : {
      "comment" : "The microphone level line of the Record window while nothing is recording. %@ is the level's label."
    },
    "%@: silent" : {
      "comment" : "The microphone level line of the Record window when no sound reaches TextMouth. %@ is the level's label."
    },
    "%@; %@" : {
      "comment" : "Joins two parts of a status line with a semicolon. %1$@ is the text so far and %2$@ the next part. English puts a semicolon and a space between them.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@; %2$@"
          }
        }
      }
    },
    "%lld articles" : {
      "comment" : "A count of news articles in a list, counted beside books. %lld is the number of articles.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld article"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld articles"
                }
              }
            }
          }
        }
      }
    },
    "%lld bookmarks" : {
      "comment" : "A count of bookmarks standing alone, as Speak Info and a feed item's row say it. %lld is the number of bookmarks.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld bookmark"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld bookmarks"
                }
              }
            }
          }
        }
      }
    },
    "%lld books" : {
      "comment" : "A count of books standing alone, such as a library summary. %lld is the number of books.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld book"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld books"
                }
              }
            }
          }
        }
      }
    },
    "%lld books couldn't be read" : {
      "comment" : "Note on a finished search's status: the text of some books could not be read. %lld is the number of those books. Starts with a number and follows a semicolon.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld book couldn't be read"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld books couldn't be read"
                }
              }
            }
          }
        }
      }
    },
    "%lld books in the cloud weren't searched" : {
      "comment" : "Note on a finished search's status: some books are only in the cloud, and a search never downloads them. %lld is the number of those books. Starts with a number and follows a semicolon.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld book in the cloud wasn't searched"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld books in the cloud weren't searched"
                }
              }
            }
          }
        }
      }
    },
    "%lld books were already in it." : {
      "comment" : "Second sentence of the announcement after books were added to the reading list: some chosen were on it already. %lld is how many.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld book was already in it."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld books were already in it."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "%lld de libros ya estaban en ella."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "%lld libro ya estaba en ella."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "%lld libros ya estaban en ella."
                }
              }
            }
          }
        }
      }
    },
    "%lld books were not in it." : {
      "comment" : "Second sentence of the announcement after books were taken off the reading list: some chosen were not on it. %lld is how many.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld book was not in it."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld books were not in it."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "%lld de libros no estaban en ella."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "%lld libro no estaba en ella."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "%lld libros no estaban en ella."
                }
              }
            }
          }
        }
      }
    },
    "%lld decibels" : {
      "comment" : "A sound level in decibels, spoken, in the Record window. %lld is the number of decibels.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld decibel"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld decibels"
                }
              }
            }
          }
        }
      }
    },
    "%lld default rules" : {
      "comment" : "A count of TextMouth's default substitution rules inside a longer sentence. %lld is the number of default rules.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld default rule"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld default rules"
                }
              }
            }
          }
        }
      }
    },
    "%lld duplicate groups found" : {
      "comment" : "Spoken and read when a scan of Find Duplicate Books ends. %lld is the number of groups of duplicate books found.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld duplicate group found"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld duplicate groups found"
                }
              }
            }
          }
        }
      }
    },
    "%lld episodes" : {
      "comment" : "A count of podcast episodes in a list, counted beside books. %lld is the number of episodes.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld episode"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld episodes"
                }
              }
            }
          }
        }
      }
    },
    "%lld feeds" : {
      "comment" : "A count of podcast and news feeds standing alone, such as a library summary. %lld is the number of feeds.",
      "localizations" : {
        "en" : {
          "variations" : {
