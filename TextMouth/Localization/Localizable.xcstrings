    "Restart Sleep Timer" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Panels group and read by VoiceOver. Starts the sleep timer again with its last length."
    },
    "Restart Sleep Timer Gesture" : {
      "comment" : "Heading of the experimental restart gesture group in the Miscellaneous settings."
