        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فایل‌های کتاب هنوز روی این Mac نیستند. %@ ممکن است هنوز در حال همگام‌سازی آن‌ها باشد."
          }
        },
        "fr" : {
