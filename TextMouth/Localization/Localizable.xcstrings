    "importProgress.noBookInFolder" : {
      "comment" : "What the library says as a folder chosen to import holds no DAISY book and no audio tracks. %@ is the folder's name. A sentence about what it holds follows.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا تحتوي “%@” على كتاب DAISY ولا على مقاطع صوتية تُستورد ككتاب واحد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@”-এ একটি বই হিসেবে আমদানি করার মতো কোনো DAISY বই বা অডিও ট্র্যাক নেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%@“ enthält kein DAISY-Buch und keine Audiotracks, die sich als ein Buch importieren lassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” holds no DAISY book and no audio tracks to import as one book."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” no contiene ningún libro DAISY ni pistas de audio para importar como un solo libro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%@» کتاب DAISY یا تراک صوتی برای وارد کردن به‌صورت یک کتاب ندارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "« %@ » ne contient ni livre DAISY ni piste audio à importer comme un seul livre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” אינו מכיל ספר DAISY ולא רצועות שמע לייבוא כספר אחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” में कोई DAISY पुस्तक या ऑडियो ट्रैक नहीं है जिसे एक पुस्तक के रूप में आयात किया जा सके।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” tidak berisi buku DAISY maupun trek audio untuk diimpor sebagai satu buku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” non contiene alcun libro DAISY né tracce audio da importare come un unico libro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」には、1冊のブックとして読み込める DAISY ブックもオーディオトラックもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@”에는 책으로 가져올 DAISY 책이나 오디오 트랙이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” bevat geen DAISY-boek en geen audiotracks om als één boek te importeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%@” nie zawiera książki DAISY ani ścieżek audio do zaimportowania jako jedna książka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” não contém nenhum livro DAISY nem faixas de áudio para importar como um livro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В «%@» нет ни книги DAISY, ни аудиодорожек, которые можно импортировать как одну книгу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "”%@” innehåller ingen DAISY-bok och inga ljudspår som kan importeras som en bok."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” ไม่มีหนังสือ DAISY และไม่มีแทร็กเสียงที่จะนำเข้าเป็นหนังสือหนึ่งเล่ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” içinde tek kitap olarak içe aktarılacak DAISY kitabı veya ses parçası yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "У «%@» немає ні книги DAISY, ні аудіодоріжок, які можна імпортувати як одну книгу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” میں کوئی DAISY کتاب یا آڈیو ٹریکس نہیں جنہیں ایک کتاب کے طور پر درآمد کیا جا سکے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” không chứa sách DAISY nào và không có bản âm thanh nào để nhập thành một sách."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@”中没有可作为一本图书导入的 DAISY 图书或音轨。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」中沒有可輸入為一本書的 DAISY 書籍或音軌。"
          }
        }
      }
    },
