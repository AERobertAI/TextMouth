            "value" : "O arquivo cue “%@” não cita nenhum dos áudios ao lado dele, então os cabeçalhos dele não foram usados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл CUE «%@» не называет ни одного соседнего аудиофайла, поэтому его заголовки не использованы."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл CUE «%@» не називає жодного аудіо поруч, тож його заголовки не використано."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "CUE 文件“%@”没有指明其旁边的任何音频，因此未使用其章节标题。"
          }
        }
      }
    },
    "The current data directory does not exist." : {
