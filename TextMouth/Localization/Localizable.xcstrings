      }
    },
    "%@ waits for a network without data limits to refresh by itself." : {
      "comment" : "Why a feed's automatic refresh did not run now: the network has data limits. %@ is the feed's title or server.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ wartet auf ein Netzwerk ohne Datenlimit, um sich selbst zu aktualisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ espera una red sin límites de datos para actualizarse por sí solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ attend un réseau sans limite de données pour s’actualiser tout seul."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ अपने आप रीफ़्रेश होने के लिए डेटा सीमा रहित नेटवर्क की प्रतीक्षा करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ menunggu jaringan tanpa batas data untuk menyegarkan sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ attende una rete senza limiti di dati per aggiornarsi da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@は、データ量の制限がないネットワークになると自動的に更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@의 자동 새로 고침은 데이터 제한이 없는 네트워크를 기다리고 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ espera por uma rede sem limite de dados para atualizar sozinho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ждёт сети без ограничений трафика, чтобы обновиться самостоятельно."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ чекає на мережу без обмежень даних, щоб оновитися самостійно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 会等待不受数据流量限制的网络，再自动刷新。"
          }
        }
      }
    },
    "%@ was connected, so recordings use it." : {
      "comment" : "Said by the Record window when a microphone connects and recordings now use it. %@ is the microphone's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم توصيل %@، لذا تستخدمه التسجيلات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ wurde verbunden, daher wird es für Aufnahmen verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ se conectó, así que las grabaciones lo usan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Microphone connecté : %@. Les enregistrements l’utilisent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ को कनेक्ट किया गया, इसलिए रिकॉर्डिंग में इसका उपयोग होगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ tersambung, sehingga rekaman memakainya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Microfono %@ collegato: le registrazioni lo usano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@が接続されたため、録音で使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@이(가) 연결되어 이제 녹음에 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ foi conectado, então as gravações passam a usá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Микрофон «%@» подключён, теперь запись ведётся с него."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Мікрофон %@ підключено, тож записи використовують його."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 已连接，录音将使用它。"
          }
        }
      }
    },
    "%@ was connected; choose it in the %@ pop-up to record from it." : {
      "comment" : "Said by the Record window when one microphone connects and is added to the Microphone pop-up. %1$@ is the microphone's name and %2$@ is the pop-up's label.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم توصيل %1$@؛ اختره من قائمة %2$@ المنبثقة للتسجيل منه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ wurde verbunden; wähle es im Einblendmenü „%2$@“ aus, um damit aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ was connected; choose it in the %2$@ pop-up to record from it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ se conectó; elígelo en el menú emergente %2$@ para grabar con él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Microphone connecté : %1$@. Pour l’utiliser, choisissez-le dans le menu local %2$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ को कनेक्ट किया गया; इससे रिकॉर्ड करने के लिए %2$@ पॉप-अप में इसे चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ tersambung; pilih di menu pop-up %2$@ untuk merekam darinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Microfono %1$@ collegato; scegli questo microfono nel menu a comparsa %2$@ per registrare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@が接続されました。録音するには、「%2$@」ポップアップメニューで選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@이(가) 연결되었습니다. 이 마이크로 녹음하려면 %2$@ 팝업 메뉴에서 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ foi conectado; escolha-o no menu local %2$@ para gravar com ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Микрофон «%1$@» подключён. Выберите его во всплывающем меню «%2$@», чтобы вести с него запись."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Мікрофон %1$@ підключено; виберіть його в спливному меню «%2$@», щоб записувати з нього."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 已连接；请在“%2$@”弹出式菜单中选取它以用其录音。"
          }
        }
      }
    },
    "%@ was disconnected, so recording stopped. What was recorded is kept." : {
      "comment" : "Error in the Record window when the microphone was unplugged while recording. %@ is the microphone's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم فصل %@، لذا توقف التسجيل. تم الاحتفاظ بما سُجّل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ wurde getrennt, daher wurde die Aufnahme gestoppt. Das Aufgenommene bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ se desconectó, así que la grabación se detuvo. Lo grabado se conserva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Microphone déconnecté : %@. L’enregistrement s’est arrêté. Ce qui a été enregistré est conservé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ को डिस्कनेक्ट किया गया, इसलिए रिकॉर्डिंग रुक गई। जो रिकॉर्ड हुआ वह सुरक्षित है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ terputus, sehingga perekaman berhenti. Hasil rekaman tetap disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Microfono %@ scollegato, quindi la registrazione si è interrotta. Quanto registrato è stato conservato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@の接続が解除されたため、録音を停止しました。録音済みの内容は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 연결이 끊겨 녹음이 중지되었습니다. 녹음된 내용은 보관됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ foi desconectado, então a gravação parou. O que foi gravado foi mantido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Микрофон «%@» отключён, запись остановлена. Записанное сохранено."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Мікрофон %@ відключено, тому запис зупинено. Записане збережено."
          }
