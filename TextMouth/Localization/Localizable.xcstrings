            "value" : "TextMouth l’a laissé là et utilise toujours %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ने उसे वहीं छोड़ दिया और अब भी %@ का उपयोग कर रहा है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth membiarkannya di sana dan masih memakai %@."
          }
        },
        "it" : {
          "stringUnit" : {
