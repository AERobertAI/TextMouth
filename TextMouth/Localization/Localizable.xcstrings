          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This moves all data from %@ back to the default location, %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esto mueve todos los datos de %1$@ de vuelta a la ubicación predeterminada, %2$@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "این کار همه داده‌ها را از %1$@ به مکان پیش‌فرض، %2$@، برمی‌گرداند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
