      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يتوسع الأرشيف إلى %@، لكن القرص الذي يحتوي على مكتبة TextMouth لا يتوفر فيه سوى %@ من المساحة الخالية، ويُبقي TextMouth %@ منها خالية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আর্কাইভটি %1$@ পর্যন্ত বড় হয়, কিন্তু TextMouth লাইব্রেরি যে ডিস্কে আছে তাতে মাত্র %2$@ খালি আছে, আর TextMouth তার %3$@ খালি রাখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Archiv wird auf %1$@ entpackt, aber auf dem Datenträger mit der TextMouth-Bibliothek sind nur %2$@ frei, und TextMouth hält %3$@ davon frei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archive expands to %@, but the disk holding the TextMouth library has only %@ free, and TextMouth keeps %@ of it free."
