          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A cópia migrada não tem o conteúdo de %@."
          }
        }
      }
    },
    "The migrated library index could not be validated." : {
      "comment" : "Why a move of the data directory failed: the copied library index did not pass its check.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der migrierte Suchindex der Bibliothek konnte nicht geprüft werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo validar el índice migrado de la biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’index de bibliothèque migré n’a pas pu être validé."
