            "value" : "Closing ends the recording. %1$@ saves it as an audiobook, %2$@ deletes it, and %3$@ keeps recording."
          }
        }
      }
    },
    "Colon" : {
      "comment" : "Name of the punctuation key \":\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Colon\"."
    },
    "Comma" : {
      "comment" : "Name of the punctuation key \",\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Comma\"."
    },
    "Command" : {
      "comment" : "Name of the Command modifier key, spoken or brailled in a keyboard shortcut such as \"Command + I\"."
    },
    "Comparing" : {
      "comment" : "VoiceOver label of the progress bar of the Compare Libraries sheet while the two copies of the library are being compared."
    },
    "Connect a microphone to record." : {
      "comment" : "Status line of the Record window while no microphone is connected."
    },
    "Continue" : {
      "comment" : "Button of the Edit Text explanation alert that goes on to open the text in the editor. Return presses it."
    },
    "Continue to Next Book" : {
      "comment" : "A choice of the When a Book Ends picker: the next book in the folder plays."
