        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Setiap <!-- page: … --> menandai awal sebuah halaman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ogni <!-- page: … --> indica dove inizia una pagina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "<!-- page: … -->は、ページの始まりを示します。"
