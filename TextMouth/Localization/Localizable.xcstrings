    "phoneImport.convertedAudioRefusal" : {
      "comment" : "First sentence of the refusal of an audio file the iPhone can't convert. %1$@ is the file's quoted name, or \"This file\". %2$@ is the audio format's name, as in \"Ogg\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ بصيغة %2$@، ولا يستطيع TextMouth على iPhone تشغيله بعد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@ ফরম্যাটে আছে, যা iPhone-এ TextMouth এখনও চালাতে পারে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ liegt als %2$@ vor, was TextMouth auf dem iPhone noch nicht wiedergeben kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is in %@, which TextMouth on iPhone can't play yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ está en %2$@, que TextMouth en el iPhone aún no puede reproducir."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ در قالب %2$@ است که TextMouth در iPhone هنوز نمی‌تواند پخش کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ est au format %2$@, que TextMouth sur iPhone ne peut pas encore lire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ הוא בפורמט %2$@, ש-TextMouth ב-iPhone עדיין לא יכול לנגן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@ में है, जिसे iPhone पर TextMouth अभी नहीं चला सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ dalam format %2$@, yang belum dapat diputar TextMouth di iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ è in %2$@, che TextMouth su iPhone non può ancora riprodurre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@は%2$@形式で、iPhone 版の TextMouth ではまだ再生できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@은(는) %2$@ 형식이며, iPhone용 TextMouth는 아직 재생할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ is in het formaat %2$@, dat TextMouth op de iPhone nog niet kan afspelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ jest w formacie %2$@, którego TextMouth na urządzeniu iPhone jeszcze nie potrafi odtworzyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ está em %2$@, que o TextMouth no iPhone ainda não consegue reproduzir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ в формате %2$@, который TextMouth на iPhone пока не может воспроизвести."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ är i formatet %2$@, som TextMouth på iPhone inte kan spela upp än."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ อยู่ในรูปแบบ %2$@ ซึ่ง TextMouth บน iPhone ยังเล่นไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@, %2$@ biçiminde ve iPhone'daki TextMouth bunu henüz oynatamıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ — у форматі %2$@, який TextMouth на iPhone поки не може відтворити."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@ میں ہے، جسے iPhone پر TextMouth ابھی نہیں چلا سکتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ở định dạng %2$@, mà TextMouth trên iPhone chưa thể phát."
