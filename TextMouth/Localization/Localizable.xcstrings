          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escolha a pasta para a qual exportar. Nova pasta cria uma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Выберите папку для экспорта. «Новая папка» создаёт новую."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Välj mappen att exportera till. Med ”Ny mapp” skapar du en."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เลือกโฟลเดอร์ที่จะส่งออกไป โฟลเดอร์ใหม่ จะสร้างโฟลเดอร์ให้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
