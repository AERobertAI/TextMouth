          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ada di pustaka Anda, tetapi tidak lagi dilanggan. Pilih %2$@ pada barisnya, atau di %3$@, untuk memeriksanya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ è nella tua libreria, ma l’iscrizione è annullata. Scegli %2$@ nella sua riga, o nel foglio %3$@, per riprendere a controllarlo."
