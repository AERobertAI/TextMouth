    "endOfBook.nextBookNotStartedNote" : {
      "comment" : "A sentence of the announcement as a book ends, after \"Finished: <title>.\": the next book was not started, because the sleep timer would not stop it. Written without its full stop.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يبدأ الكتاب التالي بسبب مؤقت النوم"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "স্লিপ টাইমারের কারণে পরের বই শুরু হয়নি"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nächstes Buch wegen des Einschlaf-Timers nicht gestartet"
