    "folderOperationConflict.folderNotFound" : {
      "comment" : "Error shown when a folder edit is refused because the folder is gone from the library.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يعد المجلد في المكتبة. ربما نُقل أو أُعيدت تسميته أو حُذف في نافذة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফোল্ডারটি আর লাইব্রেরিতে নেই। এটি অন্য কোনো উইন্ডোতে সরানো, নাম পরিবর্তন বা মুছে ফেলা হয়ে থাকতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Ordner ist nicht mehr in der Bibliothek. Er wurde möglicherweise in einem anderen Fenster verschoben, umbenannt oder gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The folder is no longer in the library. It may have been moved, renamed, or deleted in another window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La carpeta ya no está en la biblioteca. Puede que se haya movido, renombrado o eliminado en otra ventana."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پوشه دیگر در کتابخانه نیست. ممکن است در پنجره‌ی دیگری جابه‌جا، تغییر نام یا حذف شده باشد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le dossier n’est plus dans la bibliothèque. Il a peut-être été déplacé, renommé ou supprimé dans une autre fenêtre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "התיקייה כבר אינה בספרייה. ייתכן שהועברה, שונה שמה או נמחקה בחלון אחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ोल्डर अब लाइब्रेरी में नहीं है। हो सकता है उसे किसी दूसरी विंडो में ले जाया गया हो, उसका नाम बदला गया हो, या उसे मिटा दिया गया हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Folder tidak lagi ada di pustaka. Folder mungkin telah dipindahkan, diganti namanya, atau dihapus di jendela lain."
          }
        },
        "it" : {
          "stringUnit" : {
