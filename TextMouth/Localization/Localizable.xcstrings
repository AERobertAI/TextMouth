    "sync.status.outOfSpace" : {
      "comment" : "The Sync status when iCloud Drive is full. The first %@ is a phrase counting changes (\"3 changes\"), the second counts books (\"138 books\"), and the third names the device (\"this Mac\" or \"this iPhone\"), whose library is unchanged.",
