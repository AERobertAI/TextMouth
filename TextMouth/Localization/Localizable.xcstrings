    "textEncodingError.invalidForDeclaredEncoding" : {
      "comment" : "First sentence of why a file could not be imported: an HTML file declares a text encoding its bytes are not valid in. %1$@ is the file's name and %2$@ the encoding's name as the file spells it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "الملف “%1$@” يعلن ترميز النص “%2$@”، لكنه يحتوي على بايتات غير صالحة في هذا الترميز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” ফাইলটি “%2$@” টেক্সট এনকোডিং ঘোষণা করে, কিন্তু এতে এমন বাইট আছে যা ওই এনকোডিংয়ে বৈধ নয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Datei „%1$@“ deklariert die Textcodierung „%2$@“, enthält aber Bytes, die in dieser Codierung ungültig sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file “%@” declares the text encoding “%@”, but it holds bytes that are not valid in that encoding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo “%1$@” declara la codificación de texto “%2$@”, pero contiene bytes que no son válidos en esa codificación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فایل «%1$@» کدگذاری متن «%2$@» را اعلام می‌کند، اما بایت‌هایی دارد که در آن کدگذاری معتبر نیستند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le fichier « %@ » déclare l’encodage de texte « %@ », mais il contient des octets non valides dans cet encodage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הקובץ “%1$@” מצהיר על קידוד הטקסט “%2$@”, אך הוא מכיל בתים שאינם תקפים בקידוד זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ाइल “%1$@” टेक्स्ट एन्कोडिंग “%2$@” बताती है, लेकिन उसमें ऐसे बाइट हैं जो उस एन्कोडिंग में मान्य नहीं हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "File “%1$@” mendeklarasikan enkode teks “%2$@”, tetapi berisi byte yang tidak valid dalam enkode itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il file “%@” dichiara la codifica del testo “%@”, ma contiene byte non validi in quella codifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ファイル「%1$@」はテキストエンコーディング「%2$@」を宣言していますが、そのエンコーディングでは無効なバイトが含まれています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” 파일이 텍스트 인코딩 “%2$@”을(를) 선언하지만, 그 인코딩에서 유효하지 않은 바이트가 들어 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Het bestand “%@” geeft de tekstcodering “%@” op, maar bevat bytes die in die codering niet geldig zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Plik „%1$@” deklaruje kodowanie tekstu „%2$@”, ale zawiera bajty nieprawidłowe w tym kodowaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo “%1$@” declara a codificação de texto “%2$@”, mas contém bytes que não são válidos nessa codificação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В файле «%1$@» указана кодировка текста «%2$@», но он содержит байты, недопустимые в этой кодировке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Filen ”%@” anger teckenkodningen ”%@”, men innehåller byte som inte är giltiga i den kodningen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไฟล์ “%1$@” ระบุการเข้ารหัสข้อความ “%2$@” แต่มีไบต์ที่ไม่ถูกต้องในการเข้ารหัสนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” dosyası “%2$@” metin kodlamasını belirtiyor, ama bu kodlamada geçerli olmayan baytlar içeriyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл «%1$@» оголошує кодування тексту «%2$@», але містить байти, недійсні в цьому кодуванні."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فائل “%1$@” ٹیکسٹ انکوڈنگ “%2$@” ظاہر کرتی ہے، لیکن اس میں ایسے بائٹس ہیں جو اس انکوڈنگ میں درست نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tệp “%1$@” khai báo bảng mã văn bản “%2$@”, nhưng chứa các byte không hợp lệ trong bảng mã đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文件“%1$@”声明的文本编码为“%2$@”，但其中含有该编码中无效的字节。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "檔案「%1$@」宣告的文字編碼為「%2$@」，但其中含有在該編碼中無效的位元組。"
          }
        }
      }
    },
    "textEncodingError.invalidForMarkedEncoding" : {
      "comment" : "First sentence of why a file could not be imported: it begins with the byte-order mark of a Unicode encoding, but the bytes after it are not valid in that encoding. %1$@ is the file's name; %2$@ and %3$@ are both the encoding's standard name, such as UTF-16LE, which stays as it is.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "الملف “%1$@” تالف أو غير مكتمل: يبدأ بعلامة ترتيب البايتات %2$@، لكن بقية الملف ليست نص %3$@ صالحًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” ফাইলটি ক্ষতিগ্রস্ত বা অসম্পূর্ণ: এটি %2$@ বাইট-অর্ডার মার্ক দিয়ে শুরু হয়েছে, কিন্তু বাকিটা বৈধ %3$@ টেক্সট নয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Datei „%1$@“ ist beschädigt oder unvollständig: Sie beginnt mit einer %2$@-Byte-Order-Mark, der Rest ist aber kein gültiger %3$@-Text."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file “%@” is damaged or incomplete: it begins with a %@ byte-order mark, but the rest is not valid %@ text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo “%1$@” está dañado o incompleto: empieza con una marca de orden de bytes %2$@, pero el resto no es texto %3$@ válido."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فایل «%1$@» آسیب دیده یا ناقص است: با نشانه ترتیب بایت %2$@ شروع می‌شود، اما بقیه آن متن %3$@ معتبر نیست."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le fichier « %1$@ » est endommagé ou incomplet : il commence par une marque d’ordre des octets %2$@, mais le reste n’est pas du texte %3$@ valide."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
