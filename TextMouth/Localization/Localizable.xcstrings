    },
    "feed.folderGoesToo" : {
      "comment" : "A sentence of the confirmation before Delete Feed: the feed's library folder is deleted too when it holds nothing else. %@ is the folder's path.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يُحذف مجلده “%@” أيضًا عندما لا يكون فيه شيء آخر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এর ফোল্ডার “%@” অন্য কিছু না থাকলে সেটিও মুছে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sein Ordner „%@“ wird ebenfalls gelöscht, wenn nichts anderes darin liegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its folder “%@” goes too when nothing else is in it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Su carpeta “%@” también se elimina cuando no hay nada más en ella."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پوشه آن، «%@»، هم حذف می‌شود، اگر چیز دیگری در آن نباشد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Son dossier « %@ » disparaît aussi s’il ne contient rien d’autre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "התיקייה שלו “%@” נמחקת גם היא כשאין בה שום דבר אחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसका फ़ोल्डर “%@” भी हट जाएगा, यदि उसमें और कुछ नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Folder “%@” ikut dihapus jika tidak ada isi lain di dalamnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Anche la sua cartella “%@” viene eliminata se non contiene altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ほかに何も入っていなければ、フォルダ「%@」も削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "다른 항목이 없으면 폴더 “%@”도 함께 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De map “%@” van de feed gaat ook weg als er niets anders in staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jego folder „%@” też zostanie usunięty, jeśli nie ma w nim niczego innego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A pasta dele, “%@”, também é excluída quando não houver mais nada nela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Её папка «%@» тоже удаляется, если в ней больше ничего нет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dess mapp ”%@” raderas också när inget annat finns i den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "โฟลเดอร์ “%@” ของฟีดจะถูกลบด้วยเมื่อไม่มีสิ่งอื่นอยู่ในโฟลเดอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” klasörü de, içinde başka bir şey yoksa silinir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Папку стрічки «%@» також буде видалено, якщо в ній більше нічого немає."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس کا فولڈر “%@” بھی چلا جاتا ہے، اگر اس میں کچھ اور نہ ہو۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thư mục “%@” của nó cũng sẽ bị xóa khi không còn gì khác trong đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "若其文件夹“%@”中没有其他内容，该文件夹也会一并删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "當檔案夾中沒有其他內容時，其檔案夾「%@」也會一併刪除。"
          }
        }
      }
    },
    "feed.folderHelp" : {
      "comment" : "The line under the folder picker of the Add Feed sheet. %@ is the library folder chosen, or the name of the library's top level.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ينشئ TextMouth مجلدًا باسم الموجز في %@، وتُنزَّل حلقاته ومقالاته فيه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth %@-এ ফিডের নামে একটি ফোল্ডার বানায়, এবং এর পর্ব ও নিবন্ধ সেটিতে ডাউনলোড হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth erstellt in %@ einen Ordner mit dem Namen des Feeds, in den seine Folgen und Artikel heruntergeladen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth makes a folder named after the feed in %@, and its episodes and articles download into it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth crea en %@ una carpeta con el nombre del canal, y sus episodios y artículos se descargan en ella."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth در %@ پوشه‌ای به نام فید می‌سازد و قسمت‌ها و مقاله‌های آن در آن بارگیری می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth crée dans %@ un dossier portant le nom du flux, et ses épisodes et articles s’y téléchargent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth יוצר תיקייה על שם הערוץ ב-%@, והאפיזודות והכתבות שלו מורדות אליה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth %@ में फ़ीड के नाम का फ़ोल्डर बनाता है, और उसके एपिसोड और लेख उसमें डाउनलोड होते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth membuat folder bernama sesuai feed di %@, dan episode serta artikelnya diunduh ke dalamnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth crea in %@ una cartella con il nome del feed, e i suoi episodi e articoli vengono scaricati al suo interno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は、%@内にフィード名のフォルダを作成し、そのエピソードと記事をそこにダウンロードします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 %@ 안에 피드 이름으로 폴더를 만들고, 에피소드와 기사를 그 안에 다운로드합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth maakt in %@ een map met de naam van de feed, en de afleveringen en artikelen worden daarin gedownload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tworzy folder nazwany jak kanał w: %@, a jego odcinki i artykuły są pobierane do niego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth cria em %@ uma pasta com o nome do feed, e os episódios e artigos dele são baixados nela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth создаёт в %@ папку с названием ленты, и её выпуски и статьи загружаются в неё."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth skapar en mapp med flödets namn i %@, och dess avsnitt och artiklar hämtas till den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth สร้างโฟลเดอร์ตามชื่อฟีดใน %@ และตอนกับบทความจะดาวน์โหลดลงในโฟลเดอร์นั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth şu konumda beslemenin adını taşıyan bir klasör oluşturur: %@. Podcast bölümleri ve makaleler bu klasöre indirilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth створює в папці «%@» папку з назвою стрічки, і туди завантажуються її епізоди та статті."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth %@ میں فیڈ کے نام کا ایک فولڈر بناتا ہے، اور اس کے ایپی سوڈ اور مضامین اسی میں ڈاؤن لوڈ ہوتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tạo một thư mục đặt theo tên nguồn cấp trong %@, và các tập cùng bài viết của nó được tải về vào đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 会在 %@ 中新建一个以订阅源命名的文件夹，其单集和文章会下载到其中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 會在 %@ 中建立以此訂閱源命名的檔案夾，其單集與文章會下載到其中。"
          }
        }
      }
    },
