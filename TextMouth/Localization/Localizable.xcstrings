    },
    "fileImportService.symbolicLinkCannot" : {
      "comment" : "Why a book's files were not deleted: its package is a symbolic link, and deleting it could delete another book. Follows \"Import failed: \".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يمكن حذف رابط رمزي بوصفه حزمة كتاب مُدارة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "একটি সিম্বলিক লিঙ্ক পরিচালিত বইয়ের প্যাকেজ হিসেবে মোছা যায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein symbolischer Link kann nicht als verwaltetes Buchpaket gelöscht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A symbolic link cannot be deleted as a managed book package."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un enlace simbólico no se puede eliminar como paquete de libro administrado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پیوند نمادین را نمی‌توان به‌عنوان بسته‌ی کتاب مدیریت‌شده حذف کرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un lien symbolique ne peut pas être supprimé comme paquet de livre géré."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אי אפשר למחוק קישור סמלי כחבילת ספר מנוהלת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सिंबॉलिक लिंक को प्रबंधित पुस्तक पैकेज के रूप में नहीं मिटाया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tautan simbolis tidak dapat dihapus sebagai paket buku terkelola."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un collegamento simbolico non può essere eliminato come pacchetto di libro gestito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "シンボリックリンクは、管理されたブックパッケージとして削除できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "심볼릭 링크는 관리형 책 패키지로 삭제할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Een symbolische link kan niet worden verwijderd als beheerd boekpakket."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dowiązania symbolicznego nie można usunąć jako zarządzanego pakietu książki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um link simbólico não pode ser excluído como um pacote de livro gerenciado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Символическую ссылку нельзя удалить как управляемый пакет книги."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En symbolisk länk kan inte raderas som ett hanterat bokpaket."
          }
        },
        "th" : {
