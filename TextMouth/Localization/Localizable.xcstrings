            "value" : "%@ se mantiene en esta Mac por la lista de lectura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ est conservé sur ce Mac pour la liste de lecture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ è mantenuto su questo Mac per l’elenco di lettura."
          }
