    "bookSearch.noTranscript" : {
      "comment" : "Said instead of opening Search in Book for an audiobook that has no transcript yet. %@ is the book's title. Transcribe Audio is the name of a command in the Book menu.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا توجد نسخة نصية للبحث في %@. فرّغ الصوت أولًا باستخدام “تفريغ الصوت”."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@-এ অনুসন্ধান করার মতো কোনো ট্রান্সক্রিপ্ট নেই। আগে “অডিও ট্রান্সক্রাইব করুন” দিয়ে এটি ট্রান্সক্রাইব করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ hat kein Transkript zum Durchsuchen. Transkribiere es zuerst mit „Audio transkribieren“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ has no transcript to search. Transcribe it first, with Transcribe Audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no tiene transcripción en la que buscar. Transcríbelo primero con Transcribir audio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ رونوشتی برای جست‌وجو ندارد. ابتدا آن را با «رونویسی صدا» رونویسی کنید."
