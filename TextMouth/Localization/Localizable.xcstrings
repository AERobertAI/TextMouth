    "repeatedSymbolsSettingsView.symbolsHint" : {
      "comment" : "Tooltip and VoiceOver hint of the field listing the symbols that can form a run, in Settings, Text, Repeated Symbols.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يمكن لكل حرف مدرج أن يكوّن سلسلة. تُتجاهل المسافات، ولا تكوّن الأحرف والأرقام سلاسل أبدًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "তালিকাভুক্ত প্রতিটি চিহ্ন একটি ধারা গড়তে পারে। ফাঁক উপেক্ষা করা হয়, আর বর্ণ ও অঙ্ক কখনও ধারা গড়ে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jedes aufgeführte Zeichen kann eine Reihe bilden. Leerzeichen werden ignoriert, Buchstaben und Ziffern bilden nie Reihen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each character listed can form a run. Spaces are ignored, and letters and digits never form runs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cada carácter de la lista puede formar una serie. Los espacios se ignoran, y las letras y los dígitos nunca forman series."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هر نویسه‌ای که فهرست شده می‌تواند دنباله بسازد. فاصله‌ها نادیده گرفته می‌شوند و حروف و ارقام هرگز دنباله نمی‌سازند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chaque caractère listé peut former une séquence. Les espaces sont ignorés, et les lettres et les chiffres ne forment jamais de séquence."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כל תו ברשימה יכול ליצור רצף. רווחים אינם נחשבים, ואותיות וספרות אינן יוצרות רצפים לעולם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सूची में दिया हर वर्ण क्रम बना सकता है। स्पेस को अनदेखा किया जाता है, और अक्षर और अंक कभी क्रम नहीं बनाते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Setiap karakter yang tercantum dapat membentuk rangkaian. Spasi diabaikan, dan huruf serta angka tidak pernah membentuk rangkaian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ogni carattere elencato può formare una sequenza. Gli spazi vengono ignorati e lettere e cifre non formano mai sequenze."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "挙げた記号はそれぞれ連続を作れます。空白は無視され、文字と数字は連続になりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "나열된 각 기호는 반복 구간을 이룰 수 있습니다. 공백은 무시되며, 글자와 숫자는 반복 구간을 이루지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elk teken in de lijst kan een reeks vormen. Spaties worden genegeerd, en letters en cijfers vormen nooit reeksen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Każdy wymieniony znak może tworzyć serię. Spacje są pomijane, a litery i cyfry nigdy nie tworzą serii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cada caractere listado pode formar uma sequência. Espaços são ignorados, e letras e dígitos nunca formam sequências."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Каждый перечисленный символ может образовывать серию. Пробелы игнорируются, а буквы и цифры серий не образуют."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Varje angivet tecken kan bilda en följd. Blanksteg ignoreras, och bokstäver och siffror bildar aldrig följder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "อักขระแต่ละตัวที่ระบุไว้ทำให้เกิดสัญลักษณ์ซ้ำได้ ช่องว่างจะถูกละเว้น ส่วนตัวอักษรและตัวเลขไม่ทำให้เกิดสัญลักษณ์ซ้ำ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Listelenen her karakter bir dizi oluşturabilir. Boşluklar yoksayılır; harfler ve rakamlar hiçbir zaman dizi oluşturmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Кожен вказаний символ може утворювати послідовність. Пробіли ігноруються, а літери й цифри ніколи не утворюють послідовностей."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "درج ہر علامت تسلسل بنا سکتی ہے۔ خالی جگہیں نظر انداز کی جاتی ہیں، اور حروف تہجی اور اعداد کبھی تسلسل نہیں بناتے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mỗi ký tự trong danh sách có thể tạo thành một chuỗi. Dấu cách bị bỏ qua, còn chữ cái và chữ số không bao giờ tạo thành chuỗi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "列出的每个字符都可以构成连续符号。空格会被忽略，字母和数字不会构成连续符号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "所列的每個字元都可以構成連續符號。空格會被忽略，字母和數字不會構成連續符號。"
          }
        }
      }
    },
