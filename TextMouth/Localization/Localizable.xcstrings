          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Download do próximo artigo cancelado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
