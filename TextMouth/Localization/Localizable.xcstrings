    "shortcutsSettings.defaultsHeldElsewhere" : {
      "comment" : "Said in the row of a keyboard shortcut action that has lost its default key to another action. %1$@ is the name of the action that now has the key, and %2$@ is the key in words, such as \"Shift + Command + T\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يستخدم %1$@ الاختصار الافتراضي لهذا الإجراء، %2$@"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এটির ডিফল্ট, %2$@, এখন “%1$@”-এর"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ hat %2$@ als Standard"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ has its default, %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ tiene la tecla predeterminada, %2$@"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ کلید پیش‌فرض این کنش را دارد، %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ a pris la touche par défaut, %@"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ברירת המחדל, %2$@, תפוסה על ידי %1$@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसका डिफ़ॉल्ट, %2$@, %1$@ के पास है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ memakai pintasan default tindakan ini, %2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ha preso la scorciatoia predefinita, %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "デフォルトの%2$@は「%1$@」に割り当てられています"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@이(가) 이 동작의 기본 단축키 %2$@을(를) 사용 중입니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ heeft nu de standaardtoets, %@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Domyślny skrót, %2$@, należy teraz do działania %1$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ tem como padrão %2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сочетание по умолчанию %2$@ занято действием «%1$@»"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "”%@” har standardgenvägen, %@"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ใช้ %2$@ ซึ่งเป็นค่าเริ่มต้นของการดำเนินการนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
