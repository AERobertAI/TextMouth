    "readerViewModel.checkDiskHolding" : {
      "comment" : "Second sentence of the message when a chapter's playback stalled: what to do. Retry is the name of a button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تأكد من اتصال القرص الذي يحتوي على مكتبتك، ثم اختر “إعادة المحاولة”."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আপনার লাইব্রেরি যে ডিস্কে আছে তা সংযুক্ত আছে কি না দেখুন, তারপর “আবার চেষ্টা করুন” বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Prüfe, ob der Datenträger mit deiner Bibliothek angeschlossen ist, und wähle dann „Erneut versuchen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check that the disk holding your library is connected, then choose Retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Comprueba que el disco de tu biblioteca esté conectado y elige Reintentar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بررسی کنید که دیسک حاوی کتابخانه‌ی شما متصل باشد، سپس «تلاش دوباره» را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vérifiez que le disque contenant votre bibliothèque est connecté, puis choisissez Réessayer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ודא שהדיסק שמכיל את הספרייה מחובר, ואז בחר “נסה שוב”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "देखें कि आपकी लाइब्रेरी वाली डिस्क जुड़ी हुई है, फिर “फिर से प्रयास करें” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pastikan disk yang berisi pustaka Anda terhubung, lalu pilih Coba Lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Controlla che il disco con la tua libreria sia collegato, poi scegli Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ライブラリのあるディスクが接続されていることを確認してから、「再試行」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관함이 있는 디스크가 연결되어 있는지 확인한 다음 재시도를 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Controleer of de schijf met je bibliotheek is aangesloten en kies dan Probeer opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sprawdź, czy dysk z biblioteką jest podłączony, a następnie wybierz Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Verifique se o disco que contém sua biblioteca está conectado e escolha Tentar novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Убедитесь, что диск с вашей библиотекой подключён, затем выберите «Повторить»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kontrollera att disken som innehåller ditt bibliotek är ansluten och välj sedan Försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตรวจสอบว่าดิสก์ที่เก็บไลบรารีเชื่อมต่ออยู่ แล้วเลือก ลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitaplığınızı içeren diskin bağlı olduğunu kontrol edin, sonra Tekrar Dene'yi seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Переконайтеся, що диск із вашою бібліотекою підключено, а потім виберіть «Повторити»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جانچ لیں کہ آپ کی لائبریری والی ڈسک جڑی ہوئی ہے، پھر “دوبارہ کوشش کریں” منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hãy kiểm tra xem ổ đĩa chứa thư viện của bạn đã được kết nối chưa, rồi chọn Thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "请检查存放资料库的磁盘是否已连接，然后选取“重试”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "請檢查存放書庫的磁碟是否已連接，然後選擇「重試」。"
          }
        }
      }
    },
    "readerViewModel.chooseRetryTry" : {
      "comment" : "Second sentence of the message when a chapter failed while playing: what to do. Retry is the name of a button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اختر “إعادة المحاولة” للمحاولة مرة أخرى، أو أعد استيراد الكتاب إذا استمر الفشل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আবার চেষ্টা করতে “আবার চেষ্টা করুন” বেছে নিন, বা বারবার ব্যর্থ হলে বইটি আবার আমদানি করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wähle „Erneut versuchen“, um es noch einmal zu versuchen, oder importiere das Buch erneut, falls es weiter fehlschlägt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Retry to try again, or re-import the book if it keeps failing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige Reintentar para volver a intentarlo, o vuelve a importar el libro si sigue fallando."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«تلاش دوباره» را انتخاب کنید، یا اگر باز هم ناموفق بود، کتاب را دوباره وارد کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisissez Réessayer pour réessayer, ou réimportez le livre si l’échec persiste."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בחר “נסה שוב” כדי לנסות שוב, או ייבא את הספר מחדש אם הפעולה ממשיכה להיכשל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फिर से प्रयास करने के लिए “फिर से प्रयास करें” चुनें, या यदि यह बार-बार विफल हो तो पुस्तक को दोबारा आयात करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pilih Coba Lagi untuk mencoba kembali, atau impor ulang buku jika terus gagal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scegli Riprova per riprovare, oppure importa di nuovo il libro se continua a non funzionare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「再試行」を選択してやり直してください。失敗し続ける場合は、ブックを読み込み直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "재시도를 선택하여 다시 시도하거나, 계속 실패하면 책을 다시 가져오십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kies Probeer opnieuw om het nogmaals te proberen, of importeer het boek opnieuw als het blijft mislukken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wybierz Spróbuj ponownie albo zaimportuj książkę ponownie, jeśli błąd się powtarza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escolha Tentar novamente ou importe o livro de novo se continuar falhando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Выберите «Повторить», чтобы попробовать снова, или заново импортируйте книгу, если ошибка не исчезает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Välj Försök igen för att försöka på nytt, eller importera boken igen om det fortsätter att misslyckas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เลือก ลองอีกครั้ง หรือนำเข้าหนังสือใหม่หากยังไม่สำเร็จ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tekrar Dene'yi seçin; sürekli başarısız olursa kitabı yeniden içe aktarın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Виберіть «Повторити», щоб спробувати ще раз, або повторно імпортуйте книгу, якщо помилка не зникає."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "دوبارہ کوشش کے لیے “دوبارہ کوشش کریں” منتخب کریں، یا اگر ناکامی جاری رہے تو کتاب دوبارہ درآمد کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chọn Thử lại để thử lần nữa, hoặc nhập lại sách nếu vẫn lỗi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "选取“重试”再试一次；若持续失败，请重新导入图书。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選擇「重試」再試一次；如果持續失敗，請重新輸入書籍。"
          }
        }
      }
    },
