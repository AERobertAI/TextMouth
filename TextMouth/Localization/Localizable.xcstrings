          }
        }
      }
    },
    "TextMouth quit on %@: its memory grew to %@ GB while %@ played, because of a fault in macOS's audio. Your place was saved." : {
      "comment" : "Alert text at the next launch after TextMouth quit to protect the Mac, when a book played. %1$@ is the date and time of the quit; %2$@ is how large its memory grew, in gigabytes, such as 6.1; %3$@ is the book's title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth wurde am %1$@ beendet: Sein Speicher wuchs auf %2$@ GB, während %3$@ wiedergegeben wurde, wegen eines Fehlers im Audio von macOS. Deine Position wurde gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TextMouth quit on %1$@: its memory grew to %2$@ GB while %3$@ played, because of a fault in macOS's audio. Your place was saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth se cerró el %1$@: su memoria creció hasta %2$@ GB mientras se reproducía %3$@, por un fallo del audio de macOS. Se guardó tu posición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth a quitté le %1$@ : sa mémoire a atteint %2$@ Go pendant la lecture de %3$@, à cause d’un défaut de l’audio de macOS. Votre position a été enregistrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth si è chiuso il %1$@: la sua memoria è arrivata a %2$@ GB mentre era in riproduzione %3$@, a causa di un difetto nell’audio di macOS. La tua posizione è stata salvata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth fechou em %1$@: sua memória cresceu para %2$@ GB enquanto %3$@ era reproduzido, por causa de uma falha no áudio do macOS. Sua posição foi salva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth завершил работу %1$@: память выросла до %2$@ ГБ во время воспроизведения «%3$@» из-за сбоя в аудио macOS. Ваша позиция сохранена."
          }
        }
      }
    },
    "TextMouth quit on %@: its memory grew to %@ GB while a book played, because of a fault in macOS's audio. Your place was saved." : {
      "comment" : "Alert text at the next launch after TextMouth quit to protect the Mac, when a book played whose title was not kept. %1$@ is the date and time of the quit; %2$@ is how large its memory grew, in gigabytes, such as 6.1.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth wurde am %1$@ beendet: Sein Speicher wuchs auf %2$@ GB, während ein Buch wiedergegeben wurde, wegen eines Fehlers im Audio von macOS. Deine Position wurde gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TextMouth quit on %1$@: its memory grew to %2$@ GB while a book played, because of a fault in macOS's audio. Your place was saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth se cerró el %1$@: su memoria creció hasta %2$@ GB mientras se reproducía un libro, por un fallo del audio de macOS. Se guardó tu posición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth a quitté le %1$@ : sa mémoire a atteint %2$@ Go pendant la lecture d’un livre, à cause d’un défaut de l’audio de macOS. Votre position a été enregistrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth si è chiuso il %1$@: la sua memoria è arrivata a %2$@ GB mentre era in riproduzione un libro, a causa di un difetto nell’audio di macOS. La tua posizione è stata salvata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth fechou em %1$@: sua memória cresceu para %2$@ GB enquanto um livro era reproduzido, por causa de uma falha no áudio do macOS. Sua posição foi salva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth завершил работу %1$@: память выросла до %2$@ ГБ во время воспроизведения книги из-за сбоя в аудио macOS. Ваша позиция сохранена."
          }
        }
      }
    },
    "TextMouth quit on %@: its memory grew to %@ GB while nothing was playing. Your place was saved." : {
      "comment" : "Alert text at the next launch after TextMouth quit to protect the Mac, when nothing was playing. %1$@ is the date and time of the quit; %2$@ is how large its memory grew, in gigabytes, such as 6.1.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
