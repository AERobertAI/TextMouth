          }
        },
        "bn" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "%2$@-এ %1$lldটি নিবন্ধ সরানো হয়েছে। এটি এখন লাইব্রেরির বই, আর এর ফিডে এটি %3$@ হিসেবে দেখানো হয়।"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "%2$@-এ %1$lldটি নিবন্ধ সরানো হয়েছে। এগুলো এখন লাইব্রেরির বই, আর নিজ নিজ ফিডে এগুলো %3$@ হিসেবে দেখানো হয়।"
                }
              }
            }
