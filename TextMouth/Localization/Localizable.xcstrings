    "phoneSync.libraryNotLocal" : {
      "comment" : "Shown on an iPhone when syncing is refused because the library is kept in a cloud folder.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تتطلب المزامنة مكتبة محفوظة على هذا الـ iPhone، وهذه المكتبة ليست كذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সিঙ্কের জন্য এই iPhone-এ রাখা লাইব্রেরি দরকার, আর এটি তা নয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Synchronisierung braucht eine Bibliothek, die auf diesem iPhone liegt, und diese liegt woanders."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync needs a library kept on this iPhone, and this one isn't."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La sincronización necesita una biblioteca guardada en este iPhone, y esta no lo está."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "همگام‌سازی به کتابخانه‌ای نیاز دارد که روی این iPhone نگهداری شود و این کتابخانه چنین نیست."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La synchronisation exige une bibliothèque conservée sur cet iPhone, et celle-ci ne l’est pas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "סנכרון דורש ספרייה ששמורה ב-iPhone הזה, והספרייה הזו אינה כזו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सिंक के लिए इस iPhone पर रखी लाइब्रेरी चाहिए, और यह लाइब्रेरी ऐसी नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sinkronisasi membutuhkan pustaka yang disimpan di iPhone ini, dan pustaka ini tidak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La sincronizzazione richiede una libreria conservata su questo iPhone, e questa non lo è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "同期には、この iPhone に保存されたライブラリが必要ですが、このライブラリは違います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "동기화에는 이 iPhone에 보관된 보관함이 필요한데, 이 보관함은 그렇지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Synchronisatie heeft een bibliotheek nodig die op deze iPhone staat, en deze staat ergens anders."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Synchronizacja wymaga biblioteki przechowywanej na tym urządzeniu iPhone, a ta nie jest tu przechowywana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A sincronização precisa de uma biblioteca guardada neste iPhone, e esta não está."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Для синхронизации нужна библиотека, хранящаяся на этом iPhone, а эта хранится не здесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Synkronisering kräver ett bibliotek som finns på den här iPhone, och det här finns någon annanstans."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "การซิงค์ต้องใช้ไลบรารีที่เก็บอยู่ใน iPhone เครื่องนี้ แต่ไลบรารีนี้ไม่ได้เก็บไว้ที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eşzamanlama için bu iPhone'da tutulan bir kitaplık gerekir ve bu kitaplık burada tutulmuyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Для синхронізації потрібна бібліотека, що зберігається на цьому iPhone, а ця зберігається деінде."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سنک کے لیے اس iPhone پر رکھی لائبریری درکار ہے، اور یہ لائبریری ایسی نہیں ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đồng bộ cần một thư viện được lưu trên iPhone này, mà thư viện này thì không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "同步需要保存在这部 iPhone 上的资料库，而这个资料库不是。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "同步需要儲存在這部 iPhone 上的資料庫，而這個資料庫不是。"
          }
        }
      }
    },
    "phoneSync.status.notDownloaded" : {
      "comment" : "The Sync status on an iPhone when changes made on the Mac have not yet downloaded from iCloud Drive.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يتم تنزيل بعض التغييرات من الـ Mac بعد. سيحاول TextMouth مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mac থেকে আসা কিছু পরিবর্তন এখনো ডাউনলোড হয়নি। TextMouth আবার চেষ্টা করবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Einige Änderungen vom Mac wurden noch nicht heruntergeladen. TextMouth versucht es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some changes from your Mac haven't downloaded yet. TextMouth will try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Algunos cambios de la Mac aún no se han descargado. TextMouth volverá a intentarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "برخی تغییرها از Mac هنوز بارگیری نشده‌اند. TextMouth دوباره تلاش می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Certaines modifications venant du Mac n’ont pas encore été téléchargées. TextMouth va réessayer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "חלק מהשינויים מה-Mac עדיין לא הורדו. TextMouth ינסה שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mac से आए कुछ बदलाव अभी डाउनलोड नहीं हुए हैं। TextMouth फिर से कोशिश करेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beberapa perubahan dari Mac belum diunduh. TextMouth akan mencoba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alcune modifiche provenienti dal Mac non sono ancora state scaricate. TextMouth riproverà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mac からの変更の一部がまだダウンロードされていません。TextMouth がもう一度試します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mac에서 온 일부 변경 사항이 아직 다운로드되지 않았습니다. TextMouth가 다시 시도합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sommige wijzigingen van de Mac zijn nog niet gedownload. TextMouth probeert het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Niektóre zmiany z komputera Mac nie zostały jeszcze pobrane. TextMouth spróbuje ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Algumas alterações do Mac ainda não foram baixadas. O TextMouth tentará novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Некоторые изменения с Mac ещё не загружены. TextMouth повторит попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vissa ändringar från Mac har inte hämtats än. TextMouth försöker igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "การเปลี่ยนแปลงบางอย่างจาก Mac ยังดาวน์โหลดไม่เสร็จ TextMouth จะลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mac'ten gelen bazı değişiklikler henüz indirilmedi. TextMouth yeniden deneyecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Деякі зміни з Mac ще не завантажено. TextMouth спробує ще раз."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mac سے آنے والی کچھ تبدیلیاں ابھی ڈاؤن لوڈ نہیں ہوئیں۔ TextMouth دوبارہ کوشش کرے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Một số thay đổi từ máy Mac chưa được tải về. TextMouth sẽ thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "来自 Mac 的部分更改尚未下载。TextMouth 会再试一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "來自 Mac 的部分更動尚未下載。TextMouth 會再試一次。"
          }
        }
      }
    },
