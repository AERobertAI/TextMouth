            "value" : "정렬 메뉴에서 %@을(를) 선택한 다음 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kies %@ in het menu Sorteer en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wybierz opcję %@ w menu Sortowanie i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
