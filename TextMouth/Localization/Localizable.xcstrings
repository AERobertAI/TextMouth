    "Switching loses the changes TextMouth couldn't save while the library isn't available." : {
      "comment" : "Sentence in the question asked before switching libraries: changes that could not be saved are lost. The failure notices follow.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beim Wechseln gehen die Änderungen verloren, die TextMouth nicht sichern konnte, während die Bibliothek nicht verfügbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Al cambiar, se pierden los cambios que TextMouth no pudo guardar mientras la biblioteca no está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Changer de bibliothèque fait perdre les modifications que TextMouth n’a pas pu enregistrer tant que la bibliothèque n’est pas disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il cambio fa perdere le modifiche che TextMouth non ha potuto salvare mentre la libreria non è disponibile."
