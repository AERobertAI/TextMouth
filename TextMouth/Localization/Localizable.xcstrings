          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Призупиняє запис; «%@» продовжує той самий запис."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ریکارڈنگ میں توقف کرتا ہے؛ %@ اسی ریکارڈنگ کو جاری رکھتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tạm dừng bản ghi âm; %@ tiếp tục chính bản ghi âm đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "暂停录音；“%@”可继续同一段录音。"
