    "libraryIndexRecovery.tryAgain.restoring" : {
      "comment" : "Last sentence of what Try Again does on the library index recovery sheet: when to use it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "استخدم هذا بعد استعادة الملف من نسخة احتياطية، أو إصلاح أذوناته، أو تحديث TextMouth إلى الإصدار الذي حفظه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ব্যাকআপ থেকে ফাইল পুনরুদ্ধার করার পর, এর অনুমতি ঠিক করার পর, বা যে সংস্করণ এটি সংরক্ষণ করেছে সেই সংস্করণে TextMouth হালনাগাদ করার পর এটি ব্যবহার করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Verwende dies, nachdem du die Datei aus einem Backup wiederhergestellt, ihre Berechtigungen korrigiert oder TextMouth auf die Version aktualisiert hast, die sie gesichert hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use this after restoring the file from a backup, fixing its permissions, or updating TextMouth to the version that saved it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Úsalo después de restaurar el archivo desde una copia de seguridad, corregir sus permisos o actualizar TextMouth a la versión que lo guardó."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پس از بازیابی فایل از پشتیبان، اصلاح مجوزهای آن، یا به‌روزرسانی TextMouth به نسخه‌ای که آن را ذخیره کرده، از این استفاده کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "À utiliser après avoir restauré le fichier depuis une sauvegarde, corrigé ses autorisations ou mis à jour TextMouth vers la version qui l’a enregistré."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "השתמש בזה אחרי שחזור הקובץ מגיבוי, תיקון ההרשאות שלו או עדכון TextMouth לגרסה ששמרה אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ाइल को बैकअप से पुनर्स्थापित करने, उसकी अनुमतियाँ ठीक करने, या TextMouth को उस वर्ज़न पर अपडेट करने के बाद इसका उपयोग करें जिसने उसे सहेजा था।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gunakan ini setelah memulihkan file dari cadangan, memperbaiki izinnya, atau memperbarui TextMouth ke versi yang menyimpannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usalo dopo aver ripristinato il file da un backup, corretto i suoi permessi o aggiornato TextMouth alla versione che lo ha salvato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "バックアップからファイルを復元したり、権限を修正したり、そのファイルを保存したバージョンに TextMouth を更新したりしたあとにお使いください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "파일을 백업에서 복원하거나, 권한을 수정하거나, 파일을 저장한 버전으로 TextMouth를 업데이트한 후에 사용하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gebruik dit nadat je het bestand uit een reservekopie hebt teruggezet, de rechten ervan hebt hersteld of TextMouth hebt bijgewerkt naar de versie die het heeft bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Użyj tego po przywróceniu pliku z kopii zapasowej, naprawie jego uprawnień lub zaktualizowaniu TextMouth do wersji, która go zapisała."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Use isto depois de restaurar o arquivo de um backup, corrigir as permissões dele ou atualizar o TextMouth para a versão que o salvou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Используйте после восстановления файла из резервной копии, исправления его прав доступа или обновления TextMouth до версии, которая его сохранила."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Använd den här efter att du har återställt filen från en säkerhetskopia, rättat dess behörigheter eller uppdaterat TextMouth till den version som sparade den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ใช้หลังกู้คืนไฟล์จากข้อมูลสำรอง แก้สิทธิ์ของไฟล์ หรืออัปเดต TextMouth เป็นเวอร์ชันที่บันทึกไฟล์นั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bunu, dosyayı bir yedekten geri yükledikten, izinlerini düzelttikten veya TextMouth'u dosyayı kaydeden sürüme güncelledikten sonra kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Використовуйте це після відновлення файлу з резервної копії, виправлення його дозволів або оновлення TextMouth до версії, яка його зберегла."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اسے فائل کو بیک اپ سے بحال کرنے، اس کی اجازتیں درست کرنے، یا TextMouth کو اس ورژن پر اپ ڈیٹ کرنے کے بعد استعمال کریں جس نے اسے محفوظ کیا تھا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hãy dùng tùy chọn này sau khi khôi phục tệp từ bản sao lưu, sửa quyền của nó, hoặc cập nhật TextMouth lên phiên bản đã lưu nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在从备份恢复该文件、修复其权限，或将 TextMouth 更新到存储它的版本之后使用此项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在從備份還原檔案、修正其權限，或將 TextMouth 更新到儲存它的版本之後，請使用此項。"
          }
        }
      }
    },
