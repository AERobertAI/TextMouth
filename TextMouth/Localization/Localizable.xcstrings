                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Se pausaron %lld de libros que se estaban reproduciendo."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Se pausó el libro que se estaba reproduciendo."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Se pausaron %lld libros que se estaban reproduciendo."
                }
              }
            }
          }
        }
      }
    },
    "Paused at %@." : {
      "comment" : "Said as the audio editor's playing pauses. %@ is where, as a time in words such as \"12 minutes, 4 seconds\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En pausa en %@."
          }
        }
      }
    },
    "Paused." : {
      "comment" : "Status line and announcement of the Record window once the recording is paused.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En pausa."
          }
        }
      }
    },
    "Pauses" : {
      "comment" : "Heading of the pauses in the audio editor's list.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pausas"
          }
        }
      }
    },
    "Pauses the recording; %@ continues the same recording." : {
      "comment" : "VoiceOver hint of the Pause button in the Record window. %@ is the title of the button that continues a paused recording.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pausa la grabación; %@ continúa la misma grabación."
          }
        }
      }
    },
    "Percent Sign" : {
      "comment" : "Name of the punctuation key \"%\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Percent Sign\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Signo de porcentaje"
          }
        }
      }
    },
    "Percent must be between 0 and 100." : {
      "comment" : "Message when the number typed in Go to Percent is below 0 or above 100.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El porcentaje debe estar entre 0 y 100."
          }
        }
      }
    },
    "Percent through the book" : {
      "comment" : "Label of the Go to Percent field, where the user types how far through the book to jump.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Porcentaje del libro"
          }
        }
      }
    },
    "Percentage" : {
      "comment" : "A segment of the display picker in Search in Book: each result's position is shown as a percentage of the book.\nChoice of the headings sheet's display picker: each heading shows how far through the book it begins, as a percent.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Porcentaje"
          }
        }
      }
    },
    "Period" : {
      "comment" : "Name of the punctuation key \".\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Period\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Punto"
          }
        }
      }
    },
    "Permanently deletes the book and its files from this iPhone." : {
      "comment" : "First sentence of the message of the iPhone's question before a book is removed: nothing is kept on this iPhone.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elimina de forma permanente el libro y sus archivos de este iPhone."
          }
        }
      }
    },
    "Picture" : {
      "comment" : "Name of the book format of a picture of a page (a PNG, JPEG, HEIC, or TIFF photograph or scan) that text recognition reads, shown in a book's information, the format column, and the duplicate finder.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Imagen"
          }
        }
      }
    },
    "Pitch" : {
      "comment" : "Heading of the voice sheet's pitch group, and the label of its pitch slider.\nThe label of the slider in the Export dialog's spoken audio options that sets how high the voice sounds.\nTitle of the default pitch slider in the Voice settings.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tono"
          }
        }
      }
    },
    "Pitch %@" : {
      "comment" : "Announcement of the voice's new pitch after it changed. %@ is the pitch multiplier with one decimal, such as 1.2.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tono %@"
          }
        }
      }
    },
    "Pitch: %@" : {
      "comment" : "Caption above the voice sheet's pitch slider. %@ is the pitch, such as 1.0x.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tono: %@"
          }
        }
      }
    },
    "Plain Text" : {
      "comment" : "Name of the book format of a plain text file (.txt), shown in a book's information, the format column, and the duplicate finder.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texto sin formato"
          }
        }
      }
    },
    "Plain http: others can read or change what this feed sends." : {
      "comment" : "The note in Feed Info about a feed whose address uses plain http, which is not encrypted. Plain http is a term; keep it.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "http simple: otras personas pueden leer o cambiar lo que envía este canal."
          }
        }
      }
    },
    "Play" : {
      "comment" : "Label of the button that starts playing the book.\nLabel of the reader's play and pause button while the book is not playing; it plays.\nName of the Play media event, a choice for one step of the media-key pattern that starts a sleep timer in Settings.\nName of the playback event whose sound is chosen in Settings, Sound Effects: playing starts.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproducir"
          }
        }
      }
    },
    "Play / Pause" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Playback group and read by VoiceOver. Starts or pauses reading aloud or playing the book. Also the title of the menu command of the same name.\nName of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Starts or pauses playback in the audio editor.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproducir / Pausar"
          }
        }
      }
    },
    "Play Selection" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Plays only the selection.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproducir selección"
          }
        }
      }
    },
    "Play half a second after each move" : {
      "comment" : "Label of the switch in Storage settings (Audio Editing) that makes the audio editor play half a second at the cursor after each move.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproducir medio segundo tras cada movimiento"
          }
        }
      }
    },
    "Play the article above" : {
      "comment" : "A choice of the pop-up button that sets what happens when a news article ends: play the article above it in the list.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproducir el artículo anterior de la lista"
          }
        }
      }
    },
    "Play the article below" : {
      "comment" : "A choice of the pop-up button that sets what happens when a news article ends: play the article below it in the list.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproducir el artículo siguiente de la lista"
          }
        }
      }
    },
    "Play the book above" : {
      "comment" : "A choice of the Reading List's When a book ends pop-up button: when a book opened from the list ends, play the book above it in the list.\nA choice of the pop-up button that sets what happens when a book ends: play the book above it in the folder.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproducir el libro de arriba"
          }
        }
      }
    },
    "Play the book below" : {
      "comment" : "A choice of the Reading List's When a book ends pop-up button: when a book opened from the list ends, play the book below it in the list.\nA choice of the pop-up button that sets what happens when a book ends: play the book below it in the folder.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproducir el libro de abajo"
          }
        }
      }
    },
    "Play the episode above" : {
      "comment" : "A choice of the pop-up button that sets what happens when a podcast episode ends: play the episode above it in the list.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproducir el episodio anterior de la lista"
          }
        }
      }
    },
    "Play the episode below" : {
      "comment" : "A choice of the pop-up button that sets what happens when a podcast episode ends: play the episode below it in the list.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproducir el episodio siguiente de la lista"
          }
        }
      }
    },
    "Play the item above" : {
      "comment" : "A choice of the pop-up button that sets what happens when a feed's item ends: play the item above it in the list.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproducir el elemento anterior de la lista"
          }
        }
      }
    },
    "Play the item below" : {
      "comment" : "A choice of the pop-up button that sets what happens when a feed's item ends: play the item below it in the list.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproducir el elemento siguiente de la lista"
          }
        }
      }
    },
    "Play/Pause toggle" : {
      "comment" : "Name of the media event of the combined Play and Pause key, a choice for one step of the media-key pattern in Settings.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alternar reproducir/pausar"
          }
        }
      }
    },
    "Playback" : {
      "comment" : "Heading of the group of playback keyboard shortcuts in Settings, and the title of the Playback menu.\nName of the Settings tab for skipping, rewinding, the end of a book, the sleep timer, and the playback controls.\nTitle of the Playback menu in the menu bar, which holds the commands that play, pause, skip, and change the speed. Only a reader window shows it.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproducción"
          }
        }
      }
    },
    "Playback Controls" : {
      "comment" : "Heading of the playback controls group in the Playback settings.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Controles de reproducción"
          }
        }
      }
    },
    "Playback Problem" : {
      "comment" : "Title of the reader's alert shown when the audio could not be played.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Problema de reproducción"
          }
        }
      }
    },
    "Playback controls" : {
      "comment" : "What VoiceOver calls the group of playback buttons at the bottom of the reader.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Controles de reproducción"
          }
        }
      }
    },
    "Playback stopped because TextMouth's memory grew to %@ GB while the audio played, a fault in macOS's audio." : {
      "comment" : "Message on the Mac when playback was stopped because the app's memory kept growing. %@ is the memory reached, a number such as 3.2, before \"GB\" (gigabytes); macOS is the name of the Mac's system.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La reproducción se detuvo porque la memoria de TextMouth creció hasta %@ GB mientras sonaba el audio, un fallo del audio de macOS."
          }
        }
      }
    },
    "Playback stopped because TextMouth's memory grew to %@ GB while the audio played, a fault in the system's audio." : {
      "comment" : "Message on the iPhone when playback was stopped because the app's memory kept growing. %@ is the memory reached, a number such as 3.2, before \"GB\" (gigabytes).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La reproducción se detuvo porque la memoria de TextMouth creció hasta %@ GB mientras sonaba el audio, un fallo del audio del sistema."
          }
        }
      }
    },
    "Playback stopped: the audio stopped responding. Press Play to try again; if it stops again, quit and reopen TextMouth." : {
      "comment" : "Message when playback was stopped because the system's audio stopped responding. Play is the name of a button; TextMouth is the app's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La reproducción se detuvo: el audio dejó de responder. Pulsa Reproducir para volver a intentarlo; si se detiene otra vez, cierra TextMouth y ábrelo de nuevo."
          }
        }
      }
    },
    "Played" : {
      "comment" : "The note on a feed's episode that played to its end or was marked played. Title case.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproducido"
          }
        }
      }
    },
    "Played downloads are kept until you delete them" : {
      "comment" : "VoiceOver hint of the checkbox that turns off deleting downloads after playing.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Las descargas reproducidas se conservan hasta que las elimines"
          }
        }
      }
    },
    "Playing" : {
      "comment" : "A part of the audio editor's status line while the audio plays.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproduciendo"
          }
        }
      }
    },
    "Playing from the start." : {
      "comment" : "Said as Play starts again from the start of the audio, the cursor having been at the end.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproduciendo desde el inicio."
          }
        }
      }
    },
    "Plays a preview; choose Apply again to apply." : {
      "comment" : "Hint of the audio editor's Apply button while a press would play a preview first.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproduce una vista previa; elige Aplicar de nuevo para aplicar."
          }
        }
      }
    },
    "Plays from here." : {
      "comment" : "Hint of the iPhone reader's book text while the book is paused: activating it plays from the place VoiceOver is at.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproduce desde aquí."
          }
        }
      }
    },
    "Plays from the cursor, or pauses." : {
      "comment" : "Hint of the audio editor's Play or Pause button.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproduce desde el cursor o pausa."
          }
        }
      }
    },
    "Plays half a second at the cursor after each move." : {
      "comment" : "Hint of the Play half a second after each move switch in Storage settings.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproduce medio segundo en el cursor después de cada movimiento."
          }
        }
      }
    },
    "Plays short sounds for playback actions" : {
      "comment" : "VoiceOver hint of the Enable Sound Effects switch.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproduce sonidos breves en las acciones de reproducción"
          }
        }
      }
    },
    "Plays the book and pauses before it starts again." : {
      "comment" : "VoiceOver hint and help tag of the sleep timer sheet's End of book button, for a book set to start again from its beginning when it ends.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproduce el libro y hace una pausa antes de que vuelva a empezar."
          }
        }
      }
    },
    "Plays the book and pauses before the next book." : {
      "comment" : "VoiceOver hint and help tag of the sleep timer sheet's End of book button, for a book set to go on to the next book when it ends.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproduce el libro y hace una pausa antes del siguiente."
          }
        }
      }
    },
    "Plays the book until the next heading." : {
      "comment" : "VoiceOver hint and help tag of the sleep timer sheet's End of heading button: the book plays, and pauses where the next heading begins.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproduce el libro hasta el siguiente encabezado."
          }
        }
      }
    },
    "Plays the book." : {
      "comment" : "VoiceOver hint of the sleep timer sheet's minute presets and Set button: setting the timer also plays the book.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproduce el libro."
          }
        }
      }
    },
    "Plays the book; it stops at its end anyway." : {
      "comment" : "VoiceOver hint and help tag of the sleep timer sheet's End of book button, for a book that stops at its end on its own, so the timer adds nothing there.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproduce el libro; de todos modos se detiene al final."
          }
        }
      }
    },
    "Plays the selection, and stops at its end." : {
      "comment" : "Hint of the audio editor's Play Selection button.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproduce la selección y se detiene al final."
          }
        }
      }
    },
    "Plays when Where Am I finishes speaking" : {
      "comment" : "VoiceOver hint of the pop-up button that chooses the sound for the end of the Where Am I announcement. Where Am I is the name of a command.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Suena cuando ¿Dónde estoy? termina de hablar"
          }
        }
      }
    },
    "Plays when Where Am I starts speaking" : {
      "comment" : "VoiceOver hint of the pop-up button that chooses the sound for the start of the Where Am I announcement. Where Am I is the name of a command.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Suena cuando ¿Dónde estoy? empieza a hablar"
          }
        }
      }
    },
    "Plays when you pause reading" : {
      "comment" : "VoiceOver hint of the pop-up button that chooses the sound for the Pause event: when the sound plays.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Suena cuando pausas la lectura"
          }
        }
      }
    },
    "Plays when you skip backward" : {
      "comment" : "VoiceOver hint of the pop-up button that chooses the sound for the Skip Backward event: when the sound plays.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Suena cuando retrocedes"
          }
        }
      }
    },
    "Plays when you skip forward" : {
      "comment" : "VoiceOver hint of the pop-up button that chooses the sound for the Skip Forward event: when the sound plays.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Suena cuando avanzas"
          }
        }
      }
    },
    "Plays when you start reading" : {
      "comment" : "VoiceOver hint of the pop-up button that chooses the sound for the Play event: when the sound plays.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Suena cuando empiezas la lectura"
          }
        }
      }
    },
    "Plus" : {
      "comment" : "Name of the punctuation key \"+\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Plus\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Más"
          }
        }
      }
    },
    "Plus %lld more books, all named in the debug log at %@." : {
      "comment" : "Last line of the alert about books that could not move into the current library format: how many more books there are than the alert names, and where the log names them. %1$lld is how many more; %2$@ is the path of the debug log file.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Plus %lld more book, all named in the debug log at %@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Plus %lld more books, all named in the debug log at %@."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Y %1$lld de libros más, todos nombrados en el registro de depuración en %2$@."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Y %1$lld libro más, todos nombrados en el registro de depuración en %2$@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Y %1$lld libros más, todos nombrados en el registro de depuración en %2$@."
                }
              }
            }
          }
        }
      }
    },
    "Portable Embosser Format: pages of Unicode braille in XML, for embossers." : {
      "comment" : "The hint of the Convert to picker in the Export dialog while PEF is chosen. Portable Embosser Format is the name of the file format.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Portable Embosser Format: páginas de braille Unicode en XML, para impresoras braille."
