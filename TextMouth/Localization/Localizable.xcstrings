    "bookTextEdit.transcriptStaleReason" : {
      "comment" : "Reason after a colon: an audiobook's audio changed after it was transcribed, so its transcript no longer fits; begins in lower case.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تغيّر صوت الكتاب الصوتي منذ تفريغه، لذا لم تعد نسخته النصية مناسبة له."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "অডিওবুকের অডিও ট্রান্সক্রাইব করার পর বদলেছে, তাই এর ট্রান্সক্রিপ্ট আর মেলে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "das Audio des Hörbuchs hat sich seit der Transkription geändert, daher passt sein Transkript nicht mehr dazu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the audiobook's audio changed since it was transcribed, so its transcript no longer fits it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "el audio del audiolibro cambió desde que se transcribió, así que su transcripción ya no le corresponde."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صدای کتاب صوتی پس از رونویسی تغییر کرده است، بنابراین رونوشت آن دیگر با آن سازگار نیست."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
