    "rtfExportWriter.hint" : {
      "comment" : "The hint of the Convert to picker in the Export dialog while RTF is chosen. Word, Pages, and TextEdit are apps' names.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نص منسق، مع كل عنوان رئيسي بمستوى مخططه التفصيلي، لـ Word وPages وTextEdit."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "প্রতিটি হেডিং তার আউটলাইন স্তরে রেখে রিচ টেক্সট, Word, Pages ও TextEdit-এর জন্য।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Formatierter Text mit jeder Überschrift auf ihrer Gliederungsebene, für Word, Pages und TextEdit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rich text, with each heading at its outline level, for Word, Pages, and TextEdit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texto enriquecido, con cada encabezado en su nivel de esquema, para Word, Pages y TextEdit."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "متن غنی، با هر سرفصل در سطح طرح کلی‌اش، برای Word، Pages و TextEdit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texte enrichi, avec chaque en-tête à son niveau de plan, pour Word, Pages et TextEdit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "טקסט עשיר, עם כל כותרת ברמת המתאר שלה, עבור Word, Pages ו-TextEdit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "रिच टेक्स्ट, हर हेडिंग अपने आउटलाइन स्तर पर, Word, Pages और TextEdit के लिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Teks kaya, dengan setiap tajuk pada tingkat kerangkanya, untuk Word, Pages, dan TextEdit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Testo formattato, con ogni intestazione al suo livello di struttura, per Word, Pages e TextEdit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "リッチテキストに書き出します。各見出しはアウトラインレベルに対応し、Word、Pages、テキストエディットで開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "각 표제가 개요 수준으로 표시되는 서식 있는 텍스트로, Word, Pages, 텍스트 편집기에서 열 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Opgemaakte tekst, met elke kop op zijn overzichtsniveau, voor Word, Pages en TextEdit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tekst sformatowany, z każdym nagłówkiem na jego poziomie konspektu, dla programów Word, Pages i TextEdit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texto formatado, com cada cabeçalho em seu nível de estrutura de tópicos, para Word, Pages e TextEdit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
