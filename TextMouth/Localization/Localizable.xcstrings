    "transcriptCleanup.undoFailed" : {
      "comment" : "Alert, and what VoiceOver hears, when undoing a cleanup failed. %1$@ is the audiobook's title; %2$@ is the reason, a sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّر التراجع عن تنظيف النسخة النصية لـ%1$@: %2$@"
