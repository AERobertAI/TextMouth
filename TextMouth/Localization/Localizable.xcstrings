    "bookExport.transcriptChoiceHint.subRip" : {
      "comment" : "The hint of the Transcript's Convert to picker in the Export dialog while SubRip is chosen. %1$@ is the format's name, SubRip, and %2$@ its file extension, srt.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ترجمات توضيحية بصيغة %1$@ (.%2$@) يقرؤها تقريبًا كل مشغّل: ملف واحد، يبدأ توقيته من بداية الصوت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ (.%2$@) ফরম্যাটে ক্যাপশন, যা প্রায় সব প্লেয়ার পড়ে: একটি ফাইল, অডিওর শুরু থেকে সময় ধরে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Untertitel im Format %1$@ (.%2$@), das fast jeder Player liest: eine Datei, zeitgesteuert ab dem Beginn des Audios."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Captions in %@ (.%@), which nearly every player reads: one file, timed from the start of the audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Subtítulos en %1$@ (.%2$@), que casi todos los reproductores leen: un archivo, con tiempos desde el inicio del audio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "زیرنویس در قالب %1$@ (.%2$@) که تقریباً همه پخش‌کننده‌ها می‌خوانند: یک فایل، با زمان‌بندی از ابتدای صدا."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sous-titres en %1$@ (.%2$@), que presque tous les lecteurs savent lire : un seul fichier, synchronisé depuis le début de l’audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כתוביות בפורמט %1$@ (.%2$@), שכמעט כל נגן קורא: קובץ אחד, מתוזמן מתחילת השמע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ (.%2$@) में कैप्शन, जिसे लगभग हर प्लेयर पढ़ता है: एक फ़ाइल, ऑडियो की शुरुआत से समयबद्ध।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Takarir dalam %1$@ (.%2$@), yang dibaca hampir semua pemutar: satu file, bertanda waktu dari awal audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sottotitoli in %1$@ (.%2$@), letto da quasi tutti i lettori: un solo file, sincronizzato a partire dall’inizio dell’audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@（.%2$@）形式の字幕で、ほぼすべてのプレーヤで読み込めます。オーディオの先頭を基準に時間を付けた、1つのファイルです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "거의 모든 플레이어에서 읽는 %1$@(.%2$@) 형식의 자막: 오디오 시작부터 시간을 맞춘 파일 하나입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ondertiteling in %1$@ (.%2$@), die vrijwel elke speler leest: één bestand, met tijdcodes vanaf het begin van de audio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Napisy w formacie %1$@ (.%2$@), który odczytuje niemal każdy odtwarzacz: jeden plik, z czasem liczonym od początku dźwięku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Legendas em %1$@ (.%2$@), que quase todo reprodutor lê: um arquivo, sincronizado a partir do início do áudio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Субтитры в формате %1$@ (.%2$@), которые читает почти любой проигрыватель: один файл со временем от начала аудио."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Undertexter i %1$@ (.%2$@), som nästan alla spelare läser: en fil, tidsatt från ljudets början."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "คำบรรยายในรูปแบบ %1$@ (.%2$@) ซึ่งเครื่องเล่นเกือบทุกตัวอ่านได้ ไฟล์เดียว กำหนดเวลาจากจุดเริ่มต้นของเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ (.%2$@) biçiminde, hemen hemen her oynatıcının okuduğu altyazılar: tek dosya, sesin başından itibaren zamanlanmış."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Субтитри у форматі %1$@ (.%2$@), який читає майже кожен програвач: один файл, відлік часу від початку аудіо."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ (%2$@) میں کیپشنز، جنہیں تقریباً ہر پلیئر پڑھتا ہے: ایک فائل، آڈیو کے آغاز سے وقت بندی کے ساتھ۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Phụ đề ở định dạng %1$@ (.%2$@), mà hầu như trình phát nào cũng đọc được: một tệp, tính thời gian từ đầu âm thanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@（.%2$@）格式的字幕，几乎所有播放器都能读取：单个文件，从音频开头计时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@（.%2$@）格式的字幕，幾乎所有播放器都能讀取：單一檔案，從音訊開頭起計時。"
          }
        }
      }
    },
