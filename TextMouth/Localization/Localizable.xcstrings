          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@: מיקום %2$lld מתוך %3$lld"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ को %3$lld में से स्थान %2$lld पर ले जाया गया"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ dipindahkan ke posisi %2$lld dari %3$lld"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
