            "state" : "machine_translated",
            "value" : "La tabella scelta è una delle tabelle braille di VoiceOver di questo Mac."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A tabela escolhida é uma das tabelas braille do VoiceOver deste Mac."
          }
        }
      }
    },
    "The clipboard has no text to paste, so the text is unchanged." : {
      "comment" : "First sentence of the announcement when Paste from Clipboard finds no text on the clipboard.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Zwischenablage enthält keinen Text zum Einsetzen, daher bleibt der Text unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El portapapeles no tiene texto que pegar, así que el texto no cambió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le presse-papiers ne contient aucun texte à coller, donc le texte est inchangé."
          }
        },
        "it" : {
          "stringUnit" : {
