    "substitutions.emptyHint" : {
      "comment" : "Shown under \"No substitution rules.\" in the Substitutions settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أضف قواعد لتغيير طريقة نطق النص. تُطبَّق من الأعلى إلى الأسفل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "টেক্সট কীভাবে পড়া হবে তা বদলাতে নিয়ম যোগ করুন। নিয়মগুলো উপর থেকে নিচে প্রয়োগ হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Füge Regeln hinzu, um zu ändern, wie Text gesprochen wird. Sie gelten von oben nach unten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add rules to change how text is spoken. They apply top to bottom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Agrega reglas para cambiar cómo se pronuncia el texto. Se aplican de arriba abajo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "قاعده‌هایی اضافه کنید تا نحوه گفته شدن متن تغییر کند. آن‌ها از بالا به پایین اعمال می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ajoutez des règles pour modifier la façon dont le texte est lu. Elles s’appliquent de haut en bas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הוסף כללים כדי לשנות את אופן ההקראה של הטקסט. הם חלים מלמעלה למטה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "बोले जाने का तरीका बदलने के लिए नियम जोड़ें। वे ऊपर से नीचे लागू होते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tambahkan aturan untuk mengubah cara teks diucapkan. Aturan berlaku dari atas ke bawah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aggiungi regole per cambiare il modo in cui il testo viene letto. Vengono applicate dall’alto verso il basso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ルールを追加して、テキストの読み上げ方を変更します。ルールは上から順に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "텍스트를 읽는 방식을 바꾸려면 규칙을 추가하십시오. 규칙은 위에서 아래로 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voeg regels toe om te wijzigen hoe tekst wordt uitgesproken. Ze worden van boven naar beneden toegepast."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dodaj reguły, aby zmienić sposób odczytywania tekstu. Są stosowane od góry do dołu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Adicione regras para mudar como o texto é falado. Elas se aplicam de cima para baixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Добавьте правила, чтобы изменить произношение текста. Они применяются сверху вниз."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lägg till regler för att ändra hur text läses upp. De tillämpas uppifrån och ned."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เพิ่มกฎเพื่อเปลี่ยนวิธีอ่านข้อความออกเสียง กฎจะทำงานจากบนลงล่าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Metnin nasıl seslendirileceğini değiştirmek için kural ekleyin. Kurallar yukarıdan aşağıya uygulanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Додайте правила, щоб змінити те, як вимовляється текст. Вони застосовуються зверху вниз."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "متن کے بولے جانے کا انداز بدلنے کے لیے اصول شامل کریں۔ وہ اوپر سے نیچے لاگو ہوتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thêm quy tắc để thay đổi cách đọc văn bản. Các quy tắc áp dụng từ trên xuống dưới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "添加规则以改变文本的朗读方式。规则从上到下依次应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "加入規則以改變文字的朗讀方式。規則由上而下套用。"
          }
        }
      }
    },
