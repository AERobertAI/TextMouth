    "sync.status.removalsWaiting" : {
      "comment" : "A line of the sync status: books stay on this device because their copies in iCloud Drive are not confirmed yet. %1$@ is \"this Mac\" or \"this iPhone\"; %2$@ is a count of books, such as \"3 books\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تبقى الآن على %1$@ إلى أن تُؤكَّد نسخها في iCloud Drive: %2$@."
