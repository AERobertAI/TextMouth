    "folderNavigation.nextArticleCancelledStop" : {
      "comment" : "VoiceOver announcement when the listener cancelled the download of the next feed article that Next in Folder started, while a book was playing, so playback was paused.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أُلغي تنزيل المقالة التالية، لذا توقف التشغيل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পরবর্তী নিবন্ধের ডাউনলোড বাতিল করা হয়েছে, তাই প্লেব্যাক থেমে গেছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Download des nächsten Artikels abgebrochen, daher wurde die Wiedergabe gestoppt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download of the next article cancelled, so playback stopped."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se canceló la descarga del siguiente artículo, así que la reproducción se detuvo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بارگیری مقاله‌ی بعدی لغو شد، بنابراین پخش متوقف شد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Téléchargement de l’article suivant annulé, la lecture a donc été arrêtée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הורדת הכתבה הבאה בוטלה, ולכן הניגון נעצר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "अगले लेख का डाउनलोड रद्द किया गया, इसलिए प्लेबैक रुक गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Unduhan artikel berikutnya dibatalkan, sehingga pemutaran berhenti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Download dell’articolo successivo annullato, quindi la riproduzione si è interrotta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "次の記事のダウンロードをキャンセルしたため、再生を停止しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "다음 기사 다운로드가 취소되어 재생이 중지되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Download van het volgende artikel geannuleerd, dus het afspelen is gestopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Anulowano pobieranie następnego artykułu, więc odtwarzanie zatrzymano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Download do próximo artigo cancelado, então a reprodução parou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Загрузка следующей статьи отменена, воспроизведение остановлено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nedladdningen av nästa artikel avbröts, så uppspelningen stoppades."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ยกเลิกการดาวน์โหลดบทความถัดไปแล้ว การเล่นจึงหยุด"
