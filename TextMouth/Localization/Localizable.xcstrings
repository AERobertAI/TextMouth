    "libraryComparison.nothingCompared.because" : {
      "comment" : "First sentence of the results of Compare Libraries when the other copy's library index could not be read. %@ is the other copy's folder path.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّرت مقارنة أي شيء بالنسخة الموجودة في %@، لأن ملفًا تحتاجه المقارنة تعذّرت قراءته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@-এর কপির সঙ্গে কিছুই তুলনা করা যায়নি, কারণ তুলনার জন্য প্রয়োজনীয় একটি ফাইল পড়া যায়নি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mit der Kopie in %@ ließ sich nichts vergleichen, weil eine Datei, die der Vergleich braucht, nicht gelesen werden konnte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing could be compared with the copy in %@, because a file the comparison needs couldn't be read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo comparar nada con la copia en %@, porque no se pudo leer un archivo que la comparación necesita."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "چیزی با نسخه‌ی موجود در %@ مقایسه نشد، زیرا فایلی که مقایسه به آن نیاز دارد خوانده نشد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rien n’a pu être comparé avec la copie dans %@, car un fichier nécessaire à la comparaison n’a pas pu être lu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא ניתן היה להשוות דבר עם העותק ב-%@, כי אי אפשר היה לקרוא קובץ שההשוואה זקוקה לו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ में मौजूद कॉपी से कोई तुलना नहीं की जा सकी, क्योंकि तुलना के लिए ज़रूरी एक फ़ाइल पढ़ी नहीं जा सकी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tidak ada yang dapat dibandingkan dengan salinan di %@, karena file yang diperlukan perbandingan tidak dapat dibaca."
