    "recording.closeWhileRecordingExplanation" : {
      "comment" : "Explanation under the question asked when the Record window is closed while recording. %1$@, %2$@, and %3$@ are the titles of the question's three buttons: the one that stops and saves, the one that deletes the recording, and the one that keeps recording.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يؤدي الإغلاق إلى إنهاء التسجيل. %1$@ يحفظه ككتاب صوتي، و%2$@ يحذفه، و%3$@ يواصل التسجيل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বন্ধ করলে রেকর্ডিং শেষ হয়। %1$@ বেছে নিলে এটি অডিওবুক হিসেবে সংরক্ষিত হয়, %2$@ বেছে নিলে মুছে যায়, আর %3$@ বেছে নিলে রেকর্ডিং চলতে থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beim Schließen wird die Aufnahme beendet. „%1$@“ sichert sie als Hörbuch, „%2$@“ löscht sie, und „%3$@“ nimmt weiter auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closing ends the recording. %@ saves it as an audiobook, %@ deletes it, and %@ keeps recording."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cerrar termina la grabación. %1$@ la guarda como audiolibro, %2$@ la elimina y %3$@ sigue grabando."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بستن، ضبط را پایان می‌دهد. %1$@ آن را به‌صورت کتاب صوتی ذخیره می‌کند، %2$@ آن را حذف می‌کند و %3$@ ضبط را ادامه می‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fermer termine l’enregistrement. %1$@ l’enregistre comme livre audio, %2$@ le supprime et %3$@ poursuit l’enregistrement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "סגירה מסיימת את ההקלטה. “%1$@” שומר אותה כספר שמע, “%2$@” מוחק אותה, ו“%3$@” ממשיך להקליט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "बंद करने पर रिकॉर्डिंग समाप्त हो जाती है। “%1$@” इसे ऑडियोबुक के रूप में सहेजता है, “%2$@” इसे मिटा देता है, और “%3$@” रिकॉर्डिंग जारी रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menutup akan mengakhiri rekaman. %1$@ menyimpannya sebagai buku audio, %2$@ menghapusnya, dan %3$@ melanjutkan perekaman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se chiudi, la registrazione termina. Scegli %1$@ per salvarla come audiolibro, %2$@ per eliminarla o %3$@ per continuare a registrare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "閉じると録音が終了します。「%1$@」でオーディオブックとして保存し、「%2$@」で削除し、「%3$@」で録音を続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "닫으면 녹음이 끝납니다. %1$@: 오디오북으로 저장, %2$@: 삭제, %3$@: 계속 녹음."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Als je sluit, stopt de opname. %1$@ bewaart die als luisterboek, %2$@ verwijdert die en %3$@ blijft opnemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zamknięcie kończy nagrywanie. %1$@ zapisuje je jako audiobook, %2$@ je usuwa, a %3$@ kontynuuje nagrywanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fechar encerra a gravação. %1$@ a salva como audiolivro, %2$@ a exclui e %3$@ continua gravando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Закрытие завершает запись. Кнопка «%1$@» сохраняет её как аудиокнигу, «%2$@» удаляет, а «%3$@» продолжает запись."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Om du stänger fönstret avslutas inspelningen. %1$@ sparar den som en ljudbok, %2$@ raderar den och %3$@ fortsätter spela in."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "การปิดจะสิ้นสุดการบันทึกเสียง เลือก %1$@ เพื่อบันทึกเป็นหนังสือเสียง %2$@ เพื่อลบการบันทึก หรือ %3$@ เพื่อบันทึกต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kapatmak kaydı sonlandırır. %1$@ kaydı sesli kitap olarak kaydeder, %2$@ siler, %3$@ ise kayda devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Закриття завершує запис. «%1$@» зберігає його як аудіокнигу, «%2$@» видаляє, а «%3$@» продовжує запис."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بند کرنے سے ریکارڈنگ ختم ہو جاتی ہے۔ %1$@ اسے آڈیو بک کے طور پر محفوظ کرتا ہے، %2$@ اسے حذف کرتا ہے، اور %3$@ ریکارڈنگ جاری رکھتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đóng cửa sổ này sẽ kết thúc việc ghi âm. %1$@ lưu bản ghi thành sách nói, %2$@ xóa bản ghi, và %3$@ tiếp tục ghi âm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "关闭会结束录音。“%1$@”会将其存储为有声书，“%2$@”会将其删除，“%3$@”会继续录音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "關閉會結束錄音。「%1$@」會將它儲存為有聲書，「%2$@」會將它刪除，「%3$@」則會繼續錄音。"
          }
        }
      }
    },
    "recording.closeWhileRecordingQuestion" : {
