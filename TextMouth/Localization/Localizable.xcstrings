    "speechExport.speedHint" : {
      "comment" : "The hint of the Speed slider in the Export dialog's spoken audio options.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مدى سرعة نطق الصوت في الملف. تبدأ بسرعة الكتاب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফাইলে ভয়েস কত দ্রুত বলে। এটি বইয়ের গতি থেকে শুরু হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wie schnell die Stimme in der Datei spricht. Voreingestellt ist die Geschwindigkeit des Buchs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How fast the voice speaks in the file. It starts at the book's speed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con qué rapidez habla la voz en el archivo. Empieza con la velocidad del libro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سرعت گفتار صدا در فایل. از سرعت کتاب شروع می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vitesse de la voix dans le fichier. Elle part de la vitesse du livre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "באיזו מהירות הקול מדבר בקובץ. מתחיל במהירות הספר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ाइल में आवाज़ कितनी तेज़ बोलती है। यह पुस्तक की गति से शुरू होती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Seberapa cepat suara berbicara dalam file. Dimulai dari kecepatan buku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quanto veloce parla la voce nel file. Parte dalla velocità del libro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ファイル内で声が話す速さです。初期値はブックの速度です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "파일에서 음성이 말하는 속도입니다. 책의 속도에서 시작합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hoe snel de stem spreekt in het bestand. Begint op de snelheid van het boek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jak szybko głos mówi w pliku. Zaczyna od prędkości książki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A rapidez com que a voz fala no arquivo. Começa na velocidade do livro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Как быстро голос говорит в файле. Начальное значение — скорость книги."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hur snabbt rösten talar i filen. Från början gäller bokens hastighet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ความเร็วที่เสียงพูดในไฟล์ เริ่มจากความเร็วของหนังสือ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dosyada sesin ne kadar hızlı konuştuğu. Kitabın hızında başlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Як швидко голос говорить у файлі. Починається зі швидкості книги."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فائل میں آواز کتنی تیز بولتی ہے۔ یہ کتاب کی رفتار سے شروع ہوتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tốc độ giọng nói trong tệp. Bắt đầu bằng tốc độ của sách."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "语音在文件中朗读的快慢。初始值为图书的速度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "檔案中語音朗讀的速度。起始值為書籍的速度。"
          }
        }
      }
    },
    "speechExport.stopHint" : {
      "comment" : "The hint of the Stop button in the Export dialog while a spoken audio export runs.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يوقف التصدير ويحتفظ بالفصول المنطوقة بالفعل حتى يُنهى TextMouth، أو يبدأ تصدير صوتي منطوق مختلف، أو يتغير صوت الكتاب أو نصه أو بدائله أو وقفاته. وتصدير النطاق نفسه بالسرعة وطبقة الصوت نفسيهما يتابع منها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "রপ্তানি বন্ধ করে এবং ইতিমধ্যে পড়ে শোনানো অধ্যায়গুলো রাখে, যতক্ষণ না TextMouth বন্ধ হয়, অন্য একটি পড়ে শোনানো অডিও রপ্তানি শুরু হয়, বা বইয়ের ভয়েস, টেক্সট, প্রতিস্থাপন বা বিরতি বদলায়। একই গতি ও পিচে একই পরিসর রপ্তানি করলে সেখান থেকে চলে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppt den Export und behält die bereits gesprochenen Kapitel, bis TextMouth beendet wird, ein anderer gesprochener Audioexport beginnt oder Stimme, Text, Ersetzungen oder Pausen des Buchs sich ändern. Ein Export desselben Bereichs mit derselben Geschwindigkeit und Tonhöhe macht dort weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops the export and keeps the chapters already spoken until TextMouth quits, a different spoken audio export starts, or the book's voice, text, substitutions, or pauses change. Exporting the same range at the same speed and pitch goes on from them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detiene la exportación y conserva los capítulos ya leídos hasta que TextMouth se cierre, comience otra exportación de audio hablado, o cambien la voz, el texto, las sustituciones o las pausas del libro. Si exportas el mismo intervalo con la misma velocidad y el mismo tono, continúa desde ellos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صادر کردن را متوقف می‌کند و فصل‌های گفته‌شده را نگه می‌دارد تا زمانی که TextMouth خارج شود، صادر کردن صدای گفتاری دیگری شروع شود، یا صدا، متن، جایگزینی‌ها یا وقفه‌های کتاب تغییر کنند. صادر کردن همان بازه با همان سرعت و زیر و بمی از آن‌ها ادامه می‌یابد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrête l’exportation et conserve les chapitres déjà lus jusqu’à ce que TextMouth se ferme, qu’une autre exportation audio parlée démarre, ou que la voix, le texte, les substitutions ou les pauses du livre changent. Exporter la même plage à la même vitesse et à la même hauteur reprend à partir d’eux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "עוצר את הייצוא ושומר את הפרקים שכבר הוקראו עד ליציאה מ-TextMouth, להתחלת ייצוא שמע מוקרא אחר או לשינוי של הקול, הטקסט, ההחלפות או ההפסקות של הספר. ייצוא של אותו טווח באותה מהירות ובאותו גובה צליל ממשיך מהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "निर्यात रोकता है और अब तक बोले गए अध्याय TextMouth के बंद होने, किसी दूसरे बोले गए ऑडियो निर्यात के शुरू होने, या पुस्तक की आवाज़, टेक्स्ट, प्रतिस्थापन या विराम के बदलने तक रखता है। उसी गति और पिच पर वही रेंज निर्यात करने पर वहीं से आगे बढ़ा जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menghentikan ekspor dan menyimpan bab yang sudah diucapkan hingga TextMouth keluar, ekspor audio ucapan yang berbeda dimulai, atau suara, teks, substitusi, atau jeda buku berubah. Mengekspor rentang yang sama dengan kecepatan dan nada yang sama akan dilanjutkan dari bab tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe l’esportazione e conserva i capitoli già letti fino a quando TextMouth non viene chiuso, non inizia un’altra esportazione dell’audio parlato o non cambiano la voce, il testo, le sostituzioni o le pause del libro. Esportando lo stesso intervallo con la stessa velocità e lo stesso tono si prosegue da quelli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "書き出しを停止し、読み上げ済みの章を保持します。保持は、TextMouth を終了するか、別の読み上げオーディオの書き出しを始めるか、ブックの声、テキスト、置換、間が変わるまでです。同じ範囲を同じ速度とピッチで書き出すと、その続きから進みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "내보내기를 중지하고, TextMouth가 종료되거나, 다른 음성 오디오 내보내기가 시작되거나, 책의 음성, 텍스트, 대체 규칙 또는 정지 구간이 바뀔 때까지 이미 음성으로 만든 챕터를 보관합니다. 같은 속도와 음높이로 같은 범위를 내보내면 이어서 진행됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stopt de export en bewaart de hoofdstukken die al zijn uitgesproken totdat TextMouth wordt afgesloten, een andere gesproken audio-export begint of de stem, de tekst, de vervangingen of de pauzes van het boek veranderen. Als je hetzelfde bereik met dezelfde snelheid en toonhoogte exporteert, ga je daarmee verder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zatrzymuje eksport i zachowuje już odczytane rozdziały do czasu zakończenia TextMouth, rozpoczęcia innego eksportu dźwięku mówionego albo zmiany głosu, tekstu, podstawień lub przerw książki. Eksport tego samego zakresu z taką samą prędkością i wysokością głosu kontynuuje od nich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe a exportação e mantém os capítulos já falados até o TextMouth encerrar, outra exportação de áudio falado começar ou a voz, o texto, as substituições ou as pausas do livro mudarem. Exportar o mesmo intervalo com a mesma velocidade e o mesmo tom continua a partir deles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Останавливает экспорт и сохраняет уже озвученные главы до выхода из TextMouth, начала другого экспорта озвученного аудио или изменения голоса, текста, замен или пауз книги. Экспорт того же диапазона с теми же скоростью и высотой тона продолжится с них."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppar exporten och behåller de redan upplästa kapitlen tills TextMouth avslutas, en annan export av uppläst ljud startar eller bokens röst, text, ersättningar eller pauser ändras. En export av samma intervall med samma hastighet och tonhöjd fortsätter från dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หยุดการส่งออกและเก็บบทที่อ่านออกเสียงแล้วไว้จนกว่า TextMouth จะออก การส่งออกเสียงอ่านครั้งอื่นจะเริ่ม หรือเสียง ข้อความ การแทนที่ หรือช่วงหยุดของหนังสือเปลี่ยนไป การส่งออกช่วงเดียวกันด้วยความเร็วและความสูงต่ำของเสียงเท่าเดิมจะทำต่อจากบทเหล่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dışa aktarmayı durdurur ve seslendirilmiş bölümleri, TextMouth kapanana, farklı bir seslendirilmiş ses dışa aktarması başlayana veya kitabın sesi, metni, değiştirmeleri ya da duraklamaları değişene kadar saklar. Aynı aralığı aynı hız ve perdeyle dışa aktarmak onlardan devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Зупиняє експорт і зберігає вже озвучені розділи до виходу з TextMouth, початку іншого експорту озвученого аудіо або зміни голосу, тексту, замін чи пауз книги. Експорт того самого діапазону з тією самою швидкістю й висотою тону продовжується з них."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "برآمد روکتا ہے اور اب تک بولے گئے ابواب کو اس وقت تک رکھتا ہے جب تک TextMouth بند نہ ہو، کوئی دوسری بولی گئی آڈیو برآمد شروع نہ ہو، یا کتاب کی آواز، متن، تبدیلی کے اصول یا وقفے نہ بدلیں۔ اسی رفتار اور پچ پر وہی حد برآمد کرنے سے کام انہی سے آگے بڑھتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dừng quá trình xuất và giữ các chương đã đọc cho đến khi TextMouth thoát, một lần xuất âm thanh đọc khác bắt đầu, hoặc giọng nói, văn bản, quy tắc thay thế hay quãng nghỉ của sách thay đổi. Nếu xuất cùng phạm vi với cùng tốc độ và cao độ, quá trình xuất sẽ tiếp tục từ các chương đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止导出，并保留已朗读的章节，直到 TextMouth 退出、开始另一次朗读音频导出，或图书的语音、文本、替换或停顿发生变化。以同样的速度和音调导出相同范围，会从这些章节继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止輸出，並保留已朗讀的章節，直到 TextMouth 結束、開始另一次語音音訊輸出，或書籍的語音、文字、取代規則或停頓更改為止。以相同的速度和音調輸出相同範圍，會從這些章節繼續。"
          }
        }
      }
    },
    "speechExport.stopHint.iphone" : {
      "comment" : "The hint of the Stop button in the Export sheet while a spoken audio export runs, on the iPhone.",
      "extractionState" : "manual",
