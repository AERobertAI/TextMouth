        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Это позже конца аудио, длительность которого %@."
          }
        }
      }
    },
    "The %@ ends %@ into “%@”, which is only %@ long." : {
      "comment" : "First sentence of why an audiobook could not be imported: a section ends after the end of its audio file. %1$@ is the section, such as \"heading “Tide Tables”\" or \"untitled heading 3\" (a masculine noun phrase in English, without its article); %2$@ is how far into the file it ends and %4$@ how long the file is, both spoken times; %3$@ is the file's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die %1$@ endet bei %2$@ in der Datei „%3$@“, die nur %4$@ lang ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The %1$@ ends %2$@ into “%3$@”, which is only %4$@ long."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El %1$@ termina %2$@ después del inicio de “%3$@”, que solo dura %4$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pour la section (%1$@), la fin se situe à %2$@ dans « %3$@ », qui ne dure que %4$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’%@ termina a %@ dall’inizio di “%@”, che dura solo %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O %1$@ termina aos %2$@ de “%3$@”, que tem apenas %4$@ de duração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В аудиокниге %1$@ заканчивается на отметке %2$@ файла «%3$@», хотя его длина всего %4$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
