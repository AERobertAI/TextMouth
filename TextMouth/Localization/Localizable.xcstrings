    },
    "TextMouth is rebuilding its data directory." : {
      "comment" : "First sentence of why an operation was refused: the library is being rebuilt.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth baut seinen Datenordner gerade neu auf."
