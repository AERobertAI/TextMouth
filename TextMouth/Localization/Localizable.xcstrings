          }
        }
      }
    },
    "TextMouth will open the library in %@ instead of the one in %@, which isn't available." : {
      "comment" : "First sentence of the question asked before using another library while the one in use is not available. %1$@ is the chosen folder's path; %2$@ is the path of the library in use.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سيفتح TextMouth المكتبة في %@ بدلًا من المكتبة في %@، وهي غير متاحة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@-এর লাইব্রেরি উপলব্ধ নেই, তাই TextMouth তার বদলে %1$@-এর লাইব্রেরি খুলবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth öffnet die Bibliothek in %1$@ statt der in %2$@, die nicht verfügbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TextMouth will open the library in %1$@ instead of the one in %2$@, which isn't available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth abrirá la biblioteca de %1$@ en lugar de la de %2$@, que no está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ouvrira la bibliothèque dans %1$@ au lieu de celle dans %2$@, qui n’est pas disponible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth %2$@ की उस लाइब्रेरी के बजाय, जो उपलब्ध नहीं है, %1$@ की लाइब्रेरी खोलेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth akan membuka pustaka di %1$@ sebagai ganti yang di %2$@, yang tidak tersedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth aprirà la libreria in %@ al posto di quella in %@, che non è disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は、利用できない%2$@のライブラリの代わりに、%1$@のライブラリを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
