    "audioEditor.policyChanged.delete" : {
      "comment" : "Said as a book's original audio policy is set to keep no original.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يحتفظ هذا الكتاب بصوت أصلي: تغيّر التعديلات المحفوظة صوته في مكانه، ولا يمكن التراجع عنها بعد ذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই বই কোনো মূল অডিও রাখে না: সংরক্ষিত সম্পাদনা এর অডিওকেই বদলে দেয়, এবং পরে পূর্বাবস্থায় ফেরানো যায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieses Buch bewahrt kein Originalaudio auf: Gesicherte Bearbeitungen ändern sein Audio direkt und können danach nicht widerrufen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This book keeps no original audio: saved edits change its audio in place, and can't be undone after."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este libro no conserva audio original: las ediciones guardadas cambian su audio directamente y no se pueden deshacer después."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "این کتاب صدای اصلی نگه نمی‌دارد: ویرایش‌های ذخیره شده صدای آن را مستقیماً تغییر می‌دهند و بعد از آن نمی‌توان آن‌ها را واگرد کرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce livre ne conserve aucun audio original : les modifications enregistrées changent son audio sur place, et ne peuvent pas être annulées ensuite."
