    "audioEditor.saved.format" : {
      "comment" : "Said as a save ends and the book's file got a new name because TextMouth can't write the old format. %@ is the file's new name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أصبح ملفه الآن “%@”، لأن TextMouth لا يستطيع الكتابة بتنسيقه القديم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এর ফাইল এখন “%@”, কারণ TextMouth ফাইলটির পুরোনো ফরম্যাটে লিখতে পারে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Datei heißt jetzt „%@“, da TextMouth ihr altes Format nicht schreiben kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its file is now “%@”, since TextMouth can't write its old format."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Su archivo ahora se llama “%@”, porque TextMouth no puede escribir su formato anterior."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فایل آن اکنون «%@» است، چون TextMouth نمی‌تواند قالب قبلی آن را بنویسد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Son fichier s’appelle maintenant « %@ », car TextMouth ne peut pas écrire son ancien format."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הקובץ שלו הוא כעת “%@”, כי TextMouth אינו יכול לכתוב את הפורמט הישן שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसकी फ़ाइल अब “%@” है, क्योंकि TextMouth इसका पुराना फ़ॉर्मैट नहीं लिख सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "File-nya kini “%@”, karena TextMouth tidak dapat menulis format lamanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il suo file ora è “%@”, perché TextMouth non può scrivere il formato precedente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は元のフォーマットで書き込めないため、ファイルは「%@」になりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth는 이전 포맷으로 쓸 수 없으므로, 파일이 이제 “%@”입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Het bestand heet nu “%@”, omdat TextMouth het oude formaat niet kan schrijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jego plik nazywa się teraz „%@”, ponieważ TextMouth nie może zapisać jego starego formatu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo agora se chama “%@”, pois o TextMouth não consegue gravar o formato antigo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Теперь файл книги называется «%@», так как TextMouth не может записывать в прежнем формате."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Filen heter nu ”%@”, eftersom TextMouth inte kan skriva det gamla formatet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไฟล์ของหนังสือเปลี่ยนเป็น “%@” แล้ว เพราะ TextMouth เขียนรูปแบบเดิมไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
