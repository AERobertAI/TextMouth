          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O conversor do TextMouth parou antes do fim de “%@”, então ele não pôde ser importado."
          }
        },
        "ru" : {
          "stringUnit" : {
