    "feedFetchError.message.serverError" : {
      "comment" : "Why a feed could not be fetched: the server answered with an error. The first %@ is the server's host name; the second is the error's number, an identifier written without digit grouping, such as 503.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يتمكن %1$@ من إرسال الموجز (الخطأ %2$@). حاول مرة أخرى لاحقًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ফিডটি পাঠাতে পারেনি (ত্রুটি %2$@)। পরে আবার চেষ্টা করুন।"
