          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les flux %@ restent, avec leurs téléchargements, sans dossier jusqu’à ce que Informations sur le flux en donne un autre à chacun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I feed %@ restano, con i loro download, senza cartella finché Info feed non assegna a ciascuno un’altra cartella."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
