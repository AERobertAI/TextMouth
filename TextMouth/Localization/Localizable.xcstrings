    "speechExport.unreadableText" : {
      "comment" : "Shown under the Text as spoken audio checkbox in the Export dialog when the book's text can't be read.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يمكن قراءة نص هذا الكتاب، لذا لا يمكن نطقه في ملف صوتي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই বইয়ের টেক্সট পড়া যায় না, তাই এটি অডিও ফাইলে পড়ে শোনানো যায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Text dieses Buchs kann nicht gelesen werden, daher kann er nicht in eine Audiodatei gesprochen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This book's text can't be read, so it can't be spoken into an audio file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto de este libro no se puede leer, así que no se puede convertir en un archivo de audio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "متن این کتاب خوانده نمی‌شود، بنابراین نمی‌توان آن را در فایل صوتی گفت."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le texte de ce livre est illisible, il ne peut donc pas être converti en fichier audio parlé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא ניתן לקרוא את טקסט הספר הזה, ולכן אי אפשר להקריא אותו לקובץ שמע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस पुस्तक का टेक्स्ट पढ़ा नहीं जा सकता, इसलिए उसे ऑडियो फ़ाइल में नहीं बोला जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Teks buku ini tidak dapat dibaca, jadi tidak dapat diucapkan ke dalam file audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo di questo libro non può essere letto, quindi non può diventare un file audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このブックのテキストを読み取れないため、オーディオファイルに読み上げられません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 책의 텍스트를 읽을 수 없으므로 오디오 파일로 음성 변환할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De tekst van dit boek kan niet worden gelezen, dus kan die niet in een audiobestand worden uitgesproken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tekstu tej książki nie można odczytać, więc nie można go przekształcić w plik audio z mową."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O texto deste livro não pode ser lido, então não pode ser falado em um arquivo de áudio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Текст этой книги нельзя прочитать, поэтому его нельзя озвучить в аудиофайл."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bokens text kan inte läsas in, så den kan inte läsas upp till en ljudfil."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "อ่านข้อความของหนังสือเล่มนี้ไม่ได้ จึงอ่านออกเสียงเป็นไฟล์เสียงไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu kitabın metni okunamıyor, bu yüzden bir ses dosyasına seslendirilemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Текст цієї книги не можна прочитати, тому його не можна озвучити в аудіофайл."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس کتاب کا متن پڑھا نہیں جا سکتا، اس لیے اسے آڈیو فائل میں بولا نہیں جا سکتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không thể đọc văn bản của sách này, nên không thể đọc thành tệp âm thanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "无法读取此图书的文本，因此无法将其朗读为音频文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "無法讀取這本書的文字，因此無法朗讀成音訊檔案。"
          }
        }
      }
    },
    "speechExport.voiceLine" : {
      "comment" : "The line in the Export dialog's spoken audio options naming the voice the book is spoken with. %@ is the voice's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "الصوت: %@"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ভয়েস: %@"
          }
        },
