    "audioEditor.punchInStarting.insert" : {
      "comment" : "Said before the audio editor's Punch In records at the cursor. %1$@ is the cursor's time in words and %2$@ the microphone's name. \"Punch In\", \"Stop\" and \"Clear Selection\" are the names of controls.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تسجيل للإدراج عند %1$@، من %2$@، بعد النغمة. ينهيه “تسجيل فوق التحديد” أو “إيقاف”؛ ويتجاهله “إلغاء التحديد”."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বিপ শব্দের পর %2$@ থেকে, %1$@-এ সন্নিবেশের জন্য রেকর্ড হচ্ছে। “রেকর্ড করে বসান” বা “থামান” বেছে নিলে এটি শেষ হয়; “নির্বাচন সাফ করুন” বেছে নিলে এটি বর্জন করা হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aufnahme zum Einfügen bei %1$@, mit %2$@, nach dem Signalton. „Darüber aufnehmen“ oder „Stoppen“ beendet sie; „Auswahl aufheben“ verwirft sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recording to insert at %@, from %@, after the beep. Punch In or Stop ends it; Clear Selection discards it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Grabando para insertar en %1$@, con %2$@, después del pitido. Grabar encima o Detener la termina; Quitar selección la descarta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ضبط برای درج در %1$@، از %2$@، پس از بوق. «ضبط روی انتخاب» یا «توقف» آن را پایان می‌دهد؛ «لغو انتخاب» آن را دور می‌اندازد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Enregistrement à insérer à %1$@, avec %2$@, après le bip. Enregistrer par-dessus ou Arrêter le termine ; Désélectionner l’abandonne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מקליט להוספה ב-%1$@, מ-%2$@, אחרי הצפצוף. “הקלט מעל” או “עצור” מסיימים את ההקלטה; “נקה בחירה” משליך אותה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ पर डालने के लिए, %2$@ से, बीप के बाद रिकॉर्ड किया जा रहा है। “चयन पर रिकॉर्ड करें” या “रोकें” इसे समाप्त करता है; “चयन हटाएँ” इसे त्याग देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Merekam untuk disisipkan pada %1$@, dari %2$@, setelah bunyi bip. Rekam Menimpa atau Berhenti untuk mengakhirinya; Kosongkan Pilihan untuk membuangnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Registrazione da inserire a %1$@, da %2$@, dopo il segnale acustico. Per terminarla scegli Registra sopra o Interrompi; per scartarla, Deseleziona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ビープ音のあと、%2$@から録音し、%1$@の位置に挿入します。「上書き録音」または「停止」で終了し、「選択解除」で破棄します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "신호음 뒤에 %2$@(으)로 %1$@ 지점에 삽입할 녹음을 합니다. 덮어 녹음이나 중지로 끝내고, 선택 해제로 폐기합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Opname om in te voegen bij %1$@, met %2$@, na de pieptoon. Neem erover op of Stop beëindigt de opname; Deselecteer gooit die weg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nagrywanie do wstawienia, czas: %1$@, z mikrofonu %2$@, po sygnale dźwiękowym. Nagraj w miejscu zaznaczenia albo Zatrzymaj kończy nagrywanie; Odznacz je odrzuca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gravação a inserir em %1$@, com %2$@, após o sinal sonoro. Gravar por cima ou Parar encerra; Desmarcar seleção descarta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Запись для вставки на отметке %1$@, с микрофона «%2$@», после сигнала. «Записать поверх» или «Остановить» завершает её; «Снять выделение» отбрасывает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Spelar in för infogning vid %1$@, från %2$@, efter pipet. Spela in över eller Stoppa avslutar inspelningen. Rensa markering kasserar den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "กำลังบันทึกเสียงเพื่อแทรกที่ %1$@ จาก %2$@ หลังเสียงบี๊บ เลือก บันทึกทับ หรือ หยุด เพื่อสิ้นสุด หรือ ล้างส่วนที่เลือก เพื่อทิ้งการบันทึก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bip sesinden sonra %2$@ ile %1$@ konumuna eklenecek kayıt yapılacak. Üzerine Kayıt veya Durdur bitirir; Seçimi Kaldır atar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Запис для вставлення на позначці %1$@, з %2$@, після сигналу. «Записати поверх» або «Зупинити» завершує його; «Зняти виділення» відхиляє."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ پر داخل کرنے کے لیے ریکارڈنگ، %2$@ سے، بیپ کے بعد۔ “انتخاب پر ریکارڈ کریں” یا “روکیں” اسے ختم کرتا ہے؛ “انتخاب صاف کریں” اسے ترک کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đang ghi âm để chèn tại %1$@, từ %2$@, sau tiếng bíp. Ghi đè hoặc Dừng sẽ kết thúc việc này; Bỏ chọn sẽ bỏ bản ghi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "正在用 %2$@ 录制，将插入到 %1$@处，提示音之后开始。“覆盖录制”或“停止”会结束录制；“取消选择”会放弃录制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "嗶聲之後，將用 %2$@ 錄音並插入到 %1$@處。「覆蓋錄音」或「停止」可結束錄音；「取消選取」會捨棄錄音。"
          }
        }
      }
    },
