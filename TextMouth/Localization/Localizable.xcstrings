    "folderNavigation.previousArticleCancelled" : {
      "comment" : "VoiceOver announcement when the listener cancelled the download of the previous feed article that Previous in Folder started.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
