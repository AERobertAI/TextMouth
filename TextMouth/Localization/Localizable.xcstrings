    "%@ also holds %lld books a newer TextMouth added, which are kept." : {
      "comment" : "Last sentence of the dialog that asks how to delete a folder, when the folder holds books that a newer TextMouth added. %1$@ is the folder's name in quotation marks and %2$lld is how many books, a count.",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "يحتوي %@ أيضًا على %lld كتب من إضافة إصدار أحدث من TextMouth، وسيتم الاحتفاظ بها."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "يحتوي %@ أيضًا على %lld كتابًا من إضافة إصدار أحدث من TextMouth، وسيتم الاحتفاظ بها."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "يحتوي %@ أيضًا على %lld كتاب من إضافة إصدار أحدث من TextMouth، وسيتم الاحتفاظ به."
                }
              },
              "other" : {
