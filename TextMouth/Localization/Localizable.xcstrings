    "audioFilterPresets.chainHint" : {
      "comment" : "Hint of the chain field of a filter preset. ffmpeg is the name of a program.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مرشحات بصيغة ffmpeg، مفصولة بفواصل؛ وتأتي الخيارات بعد علامة المساواة، مفصولة بنقطتين رأسيتين."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ffmpeg-এর সিনট্যাক্সে ফিল্টার, কমা দিয়ে আলাদা করা; অপশন সমান চিহ্নের পরে আসে, কোলন দিয়ে আলাদা করা।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Filter in der Syntax von ffmpeg, durch Kommas getrennt; Optionen folgen auf ein Gleichheitszeichen und sind durch Doppelpunkte getrennt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filters in ffmpeg's syntax, separated by commas; options follow an equals sign, separated by colons."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Filtros con la sintaxis de ffmpeg, separados por comas; las opciones van después de un signo igual, separadas por dos puntos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فیلترها با نحو ffmpeg، جدا شده با کاما؛ گزینه‌ها بعد از علامت مساوی می‌آیند و با دونقطه جدا می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Filtres en syntaxe ffmpeg, séparés par des virgules ; les options suivent un signe égal, séparées par des deux-points."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מסננים בתחביר של ffmpeg, מופרדים בפסיקים; אפשרויות באות אחרי סימן שוויון, ומופרדות בנקודתיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ffmpeg के सिंटैक्स में फ़िल्टर, अल्पविराम से अलग किए हुए; विकल्प बराबर के चिह्न के बाद आते हैं, कोलन से अलग किए हुए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Filter dalam sintaks ffmpeg, dipisahkan koma; opsi mengikuti tanda sama dengan, dipisahkan titik dua."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Filtri nella sintassi di ffmpeg, separati da virgole; le opzioni seguono un segno di uguale, separate da due punti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ffmpeg の構文で書いたフィルタを、カンマで区切って並べます。オプションはイコールの後に、コロンで区切って指定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ffmpeg 구문의 필터를 쉼표로 구분하며, 옵션은 등호 뒤에 콜론으로 구분해 씁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Filters in de syntaxis van ffmpeg, gescheiden door komma's; opties volgen na een isgelijkteken, gescheiden door dubbele punten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Filtry w składni ffmpeg, oddzielone przecinkami; opcje następują po znaku równości i są oddzielone dwukropkami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Filtros na sintaxe do ffmpeg, separados por vírgulas; as opções vêm depois de um sinal de igual, separadas por dois-pontos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Фильтры в синтаксисе ffmpeg, разделённые запятыми; параметры идут после знака равенства и разделяются двоеточиями."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Filter i ffmpegs syntax, åtskilda med kommatecken. Alternativ följer efter ett likhetstecken och åtskiljs med kolon."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตัวกรองในไวยากรณ์ของ ffmpeg คั่นด้วยจุลภาค ตัวเลือกตามหลังเครื่องหมายเท่ากับ คั่นด้วยทวิภาค"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ffmpeg söz diziminde, virgülle ayrılmış filtreler; seçenekler eşittir işaretinden sonra gelir ve iki nokta üst üste ile ayrılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Фільтри в синтаксисі ffmpeg, розділені комами; параметри йдуть після знака рівності й розділені двокрапками."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ffmpeg کی نحو میں فلٹرز، کاما سے الگ کیے گئے؛ آپشنز برابر کے نشان کے بعد آتے ہیں اور کولن سے الگ ہوتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Các bộ lọc theo cú pháp của ffmpeg, phân tách bằng dấu phẩy; tùy chọn theo sau dấu bằng, phân tách bằng dấu hai chấm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ffmpeg 语法的滤波器，以逗号分隔；选项跟在等号之后，以冒号分隔。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "以 ffmpeg 語法寫成的濾波器，以逗號分隔；選項接在等號之後，以冒號分隔。"
          }
        }
      }
    },
