    "memoryQuitMarker.announcement.because" : {
      "comment" : "Alert text at the next launch after TextMouth quit to protect the Mac, when a book played. %1$@ is the date and time of the quit; %2$@ is how large its memory grew, in gigabytes, such as 6.1; %3$@ is the book's title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم إنهاء TextMouth في %1$@: تضخمت ذاكرته إلى %2$@ غيغابايت أثناء تشغيل %3$@، بسبب عطل في صوت macOS. حُفظ موضعك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth %1$@ তারিখে বন্ধ হয়েছে: %3$@ চলার সময় macOS-এর অডিওর একটি ত্রুটির কারণে এর মেমরি %2$@ GB-এ পৌঁছেছিল। আপনার অবস্থান সংরক্ষিত হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth wurde am %1$@ beendet: Wegen eines Fehlers im Audiosystem von macOS wuchs sein Speicher auf %2$@ GB, während %3$@ wiedergegeben wurde. Deine Position wurde gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth quit on %@: its memory grew to %@ GB while %@ played, because of a fault in macOS's audio. Your place was saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth se cerró el %1$@: su memoria creció hasta %2$@ GB mientras se reproducía %3$@, por un fallo del audio de macOS. Se guardó tu posición."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth در %1$@ بسته شد: حافظه‌اش به %2$@ GB رسید در حالی که %3$@ پخش می‌شد، به‌دلیل نقصی در صدای macOS. جای شما ذخیره شد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth a quitté le %1$@ : sa mémoire a atteint %2$@ Go pendant la lecture de %3$@, à cause d’un défaut de l’audio de macOS. Votre position a été enregistrée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth נסגר ב-%1$@: הזיכרון שלו גדל ל-%2$@ GB בזמן ש-%3$@ התנגן, בגלל תקלה בשמע של macOS. המקום שלך נשמר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth %1$@ को बंद हो गया: %3$@ चलते समय macOS के ऑडियो में खराबी के कारण उसकी मेमोरी %2$@ GB तक बढ़ गई। आपकी जगह सहेज ली गई थी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth keluar pada %1$@: memorinya membengkak hingga %2$@ GB saat %3$@ diputar, karena kesalahan pada audio macOS. Posisi Anda telah disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth si è chiuso il %1$@: la sua memoria è arrivata a %2$@ GB mentre era in riproduzione %3$@, a causa di un difetto nell’audio di macOS. La tua posizione è stata salvata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は%1$@に終了しました。「%3$@」の再生中に、macOS のオーディオの不具合でメモリが%2$@ GB まで増えたためです。位置は保存されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 %1$@에 종료되었습니다. %3$@을(를) 재생하는 동안 macOS 오디오의 결함으로 메모리가 %2$@GB까지 늘어났습니다. 읽던 위치는 저장되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth is afgesloten op %1$@: het geheugen groeide tot %2$@ GB terwijl %3$@ werd afgespeeld, door een fout in de audio van macOS. Je plaats is bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth zakończył działanie %1$@: użycie pamięci wzrosło do %2$@ GB podczas odtwarzania książki %3$@ z powodu usterki w dźwięku macOS. Pozycję zachowano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth fechou em %1$@: sua memória cresceu para %2$@ GB enquanto %3$@ era reproduzido, por causa de uma falha no áudio do macOS. Sua posição foi salva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth завершил работу %1$@: память выросла до %2$@ ГБ во время воспроизведения «%3$@» из-за сбоя в аудио macOS. Ваша позиция чтения сохранена."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth avslutades %1$@: minnet växte till %2$@ GB medan %3$@ spelades upp, på grund av ett fel i ljudet i macOS. Din plats sparades."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ออกเมื่อ %1$@: หน่วยความจำเพิ่มขึ้นเป็น %2$@ GB ขณะที่ %3$@ เล่นอยู่ เนื่องจากข้อบกพร่องในระบบเสียงของ macOS ตำแหน่งของคุณถูกบันทึกไว้แล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth, %1$@ tarihinde kapandı: %3$@ oynatılırken macOS'in sesindeki bir hata yüzünden belleği %2$@ GB'a çıktı. Konumunuz kaydedildi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth закрився %1$@: пам’ять зросла до %2$@ ГБ під час відтворення книги «%3$@» через збій в аудіо macOS. Вашу позицію збережено."
          }
        },
        "ur" : {
          "stringUnit" : {
