      }
    },
    "The transcript is only in iCloud, so TextMouth leaves it. Download the book, then try again." : {
      "comment" : "Line of the Transcribe Audio sheet when the book's transcript file has not been downloaded from iCloud to this Mac.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "النسخة النصية موجودة في iCloud فقط، لذا يتركها TextMouth. نزّل الكتاب ثم حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript ist nur in iCloud, daher lässt TextMouth es unverändert. Lade das Buch herunter und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcripción solo está en iCloud, así que TextMouth no la toca. Descarga el libro y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcription est seulement dans iCloud, donc TextMouth n’y touche pas. Téléchargez le livre, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ट्रांसक्रिप्ट केवल iCloud में है, इसलिए TextMouth उसे छोड़ देता है। पुस्तक डाउनलोड करें, फिर से प्रयास करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transkrip hanya ada di iCloud, jadi TextMouth membiarkannya. Unduh buku, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La trascrizione è solo in iCloud, quindi TextMouth non la tocca. Scarica il libro, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文字起こしは iCloud にしかないため、TextMouth はそのままにします。ブックをダウンロードしてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "대본이 iCloud에만 있어서 TextMouth가 그대로 둡니다. 책을 다운로드한 다음 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A transcrição está apenas no iCloud, então o TextMouth a deixa como está. Baixe o livro e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Расшифровка только в iCloud, поэтому TextMouth её не трогает. Загрузите книгу и повторите попытку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Транскрипція лише в iCloud, тому TextMouth її не чіпає. Завантажте книгу й повторіть спробу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文字稿仅在 iCloud 中，因此 TextMouth 不会处理它。请下载此图书，然后重试。"
          }
        }
      }
    },
    "The transcript is only in the cloud. Its details appear once the book is downloaded." : {
      "comment" : "Book Information's Transcript detail when the transcript file has not been downloaded from the cloud drive.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "النسخة النصية موجودة في السحابة فقط. تظهر تفاصيلها بعد تنزيل الكتاب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript ist nur in der Cloud. Seine Details erscheinen, sobald das Buch heruntergeladen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcripción solo está en la nube. Sus detalles aparecen cuando se descarga el libro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcription est seulement dans le cloud. Ses détails apparaissent une fois le livre téléchargé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ट्रांसक्रिप्ट केवल क्लाउड में है। पुस्तक डाउनलोड होने पर इसका ब्योरा दिखेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transkrip hanya ada di cloud. Detailnya muncul setelah buku diunduh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La trascrizione è solo nel cloud. I suoi dettagli compaiono quando il libro viene scaricato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文字起こしはクラウドにのみあります。詳細は、ブックをダウンロードすると表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "대본이 클라우드에만 있습니다. 책을 다운로드하면 세부 정보가 나타납니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A transcrição está apenas na nuvem. Os detalhes aparecem depois que o livro é baixado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Расшифровка только в облаке. Сведения о ней появятся после загрузки книги."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Транскрипція лише в хмарі. Її відомості з’являться, коли книгу буде завантажено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文字稿仅在云端。下载图书后会显示其详细信息。"
          }
        }
      }
    },
    "The transcript of %@ can't be read. If the book is only in the cloud, download it and try again." : {
      "comment" : "Alert shown when Clean Up Transcript is chosen for an audiobook whose transcript cannot be read. %@ is the audiobook's title.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّرت قراءة النسخة النصية لـ%@. إذا كان الكتاب في السحابة فقط، فنزّله وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript von %@ kann nicht gelesen werden. Wenn das Buch nur in der Cloud ist, lade es herunter und versuche es erneut."
