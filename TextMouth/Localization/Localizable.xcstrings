    "brailleCode.guessedRecovery" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. What Book Information says under the pop-up of a book whose code the import guessed: where the code came from, how to correct it, and how to keep it. Plain and short, so VoiceOver and a braille display read it as it is.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم تخمينه من برايل الكتاب. إذا قُرئ بشكل خاطئ، فاختر Unified English Braille في رمز برايل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইয়ের ব্রেইল থেকে অনুমান করা। ভুল পড়লে ব্রেইল কোডে Unified English Braille বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aus dem Braille des Buchs erraten. Wenn es falsch gelesen wird, wähle unter „Braille-Code“ die Unified English Braille."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guessed from the book's braille. If it reads wrongly, choose Unified English Braille in Braille Code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deducido del braille del libro. Si se lee mal, elige Unified English Braille en Código braille."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "از بریل کتاب حدس زده شده است. اگر درست خوانده نمی‌شود، در «کد بریل» Unified English Braille را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deviné d’après le braille du livre. S’il est mal lu, choisissez Unified English Braille dans Code braille."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "נוחש מתוך הברייל של הספר. אם הוא נקרא לא נכון, בחר “Unified English Braille” ב“קוד ברייל”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पुस्तक के ब्रेल से अनुमान लगाया गया। यदि यह गलत पढ़ता है, तो ब्रेल कोड में Unified English Braille चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ditebak dari braille buku. Jika dibaca keliru, pilih Unified English Braille di Kode Braille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dedotto dal braille del libro. Se viene letto in modo errato, scegli Unified English Braille in Codice braille."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブックの点字から推測しました。正しく読み込めない場合は、「点字コード」で「Unified English Braille」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책의 점자에서 추정했습니다. 잘못 읽히면 점자 코드에서 통합 영어 점자를 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Geraden uit het braille van het boek. Leest het verkeerd, kies dan Unified English Braille bij Braillecode."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rozpoznano na podstawie pisma Braille’a w książce. Jeśli odczyt jest błędny, wybierz Unified English Braille w polu Tabela Braille’a."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deduzido do braille do livro. Se a leitura sair errada, escolha Unified English Braille em Código braille."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Код определён предположительно, по Брайлю книги. Если книга читается неверно, выберите Unified English Braille в меню «Код Брайля»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gissad utifrån bokens punktskrift. Om den läses fel, välj Unified English Braille under Punktskriftskod."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "คาดเดาจากอักษรเบรลล์ของหนังสือ หากอ่านผิด ให้เลือก Unified English Braille ในรหัสอักษรเบรลล์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitabın braille'inden tahmin edildi. Yanlış okunuyorsa Braille Kodu menüsünde Unified English Braille'i seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Код припущено на основі брайля книги. Якщо книга читається неправильно, виберіть Unified English Braille у меню «Код Брайля»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب کے بریل سے اندازہ لگایا گیا۔ اگر یہ غلط پڑھتا ہے تو بریل کوڈ میں Unified English Braille منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Được đoán từ chữ braille của sách. Nếu đọc sai, hãy chọn Unified English Braille trong Mã braille."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "根据图书的盲文推测而得。如果读取有误，请在“盲文码”中选取 Unified English Braille。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "由書籍的點字推測而得。如果讀取有誤，請在「點字碼」中選擇 Unified English Braille。"
          }
        }
      }
    },
    "brailleCode.keepGuessHint" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يتوقف عن القول إن الرمز كان تخمينًا. لا تتم إعادة قراءة الكتاب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "কোডটি অনুমান করা হয়েছে বলা বন্ধ করে। বইটি আবার পড়া হয় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Code wird nicht mehr als erraten bezeichnet. Das Buch wird nicht erneut gelesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops saying the code was guessed. The book is not read again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deja de decir que el código fue deducido. El libro no se vuelve a leer."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "دیگر نمی‌گوید که کد حدس زده شده بود. کتاب دوباره خوانده نمی‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cesse d’indiquer que le code a été deviné. Le livre n’est pas relu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מפסיק לומר שהקוד נוחש. הספר אינו נקרא שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "यह कहना बंद करता है कि कोड का अनुमान लगाया गया था। पुस्तक फिर से नहीं पढ़ी जाती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Berhenti menyatakan bahwa kode ditebak. Buku tidak dibaca ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Smette di dire che il codice è stato dedotto. Il libro non viene riletto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "コードを推測したという表示をやめます。ブックは読み込み直されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "코드를 추정했다는 안내를 더 이상 표시하지 않습니다. 책을 다시 읽지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Meldt niet langer dat de code is geraden. Het boek wordt niet opnieuw gelezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Przestaje informować, że tabelę odgadnięto. Książka nie jest odczytywana ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para de dizer que o código foi deduzido. O livro não é lido novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Больше не сообщает, что код определён предположительно. Книга не читается заново."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Slutar säga att koden gissades. Boken läses inte igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เลิกบอกว่ารหัสนี้เป็นการคาดเดา ไม่มีการอ่านหนังสืออีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kodun tahmin edildiğini söylemeyi bırakır. Kitap yeniden okunmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Більше не повідомляє, що код припущено. Книгу не буде прочитано знову."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یہ کہنا بند کرتا ہے کہ کوڈ کا اندازہ لگایا گیا تھا۔ کتاب دوبارہ نہیں پڑھی جاتی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ngừng báo rằng mã đã được đoán. Sách không được đọc lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "不再说明此盲文码为推测所得。不会重新读取图书。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "不再說明此點字碼是推測的。書籍不會重新讀取。"
          }
        }
      }
    },
    "brailleCode.keepGuessLabel" : {
