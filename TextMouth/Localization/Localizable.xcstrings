            "state" : "machine_translated",
            "value" : "Файл «%1$@» у цьому документі пошкоджено або він неповний: %2$@. Отримайте свіжу копію документа, а потім імпортуйте її знову."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس دستاویز میں فائل “%1$@” خراب یا نامکمل ہے: %2$@۔ دستاویز کی نئی کاپی حاصل کریں، پھر اسے دوبارہ درآمد کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tệp “%1$@” trong tài liệu này bị hỏng hoặc không đầy đủ: %2$@. Hãy lấy một bản sao mới của tài liệu, rồi nhập lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此文档中的文件“%1$@”已损坏或不完整：%2$@。请获取文档的新副本，然后再次导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此文件中的檔案「%1$@」已損毀或不完整：%2$@。請取得文件的新副本，然後再次輸入。"
          }
        }
      }
    },
    "pageImage.cannotDecode" : {
      "comment" : "Why a picture was refused at import: the system could not decode it. Two sentences.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّر فك ترميز هذه الصورة. قد تكون تالفة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই ছবি ডিকোড করা যায়নি। এটি ক্ষতিগ্রস্ত হতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieses Bild konnte nicht decodiert werden. Es ist möglicherweise beschädigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This picture could not be decoded. It may be damaged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo decodificar esta imagen. Puede estar dañada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "این تصویر را نمی‌توان رمزگشایی کرد. ممکن است آسیب دیده باشد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cette image n’a pas pu être décodée. Elle est peut-être endommagée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא ניתן היה לפענח את התמונה הזו. ייתכן שהיא פגומה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "यह चित्र डीकोड नहीं किया जा सका। यह क्षतिग्रस्त हो सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gambar ini tidak dapat didekode. Gambar ini mungkin rusak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile decodificare questa immagine. Potrebbe essere danneggiata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "この画像をデコードできませんでした。破損している可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 이미지를 디코딩할 수 없습니다. 손상되었을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deze afbeelding kon niet worden gedecodeerd. Ze is mogelijk beschadigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie udało się zdekodować tego obrazu. Może być uszkodzony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não foi possível decodificar esta imagem. Ela pode estar danificada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не удалось декодировать это изображение. Возможно, оно повреждено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Den här bilden kunde inte avkodas. Den kan vara skadad."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ถอดรหัสรูปภาพนี้ไม่ได้ รูปภาพอาจเสียหาย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu resmin kodu çözülemedi. Hasarlı olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Це зображення не вдалося декодувати. Воно може бути пошкоджене."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس تصویر کو ڈی کوڈ نہیں کیا جا سکا۔ ہو سکتا ہے یہ خراب ہو۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không giải mã được ảnh này. Ảnh có thể bị hỏng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "无法解码此图片。它可能已损坏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "無法解碼此圖片。它可能已損毀。"
          }
        }
      }
    },
