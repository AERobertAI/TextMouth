            "value" : "A fala parou no caractere %1$@ de %2$@ no capítulo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Речь остановилась на символе %1$@ из %2$@ в главе."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
