    "storage.thereIsntEnough" : {
      "comment" : "Why the chosen location can't be used: the disk is too full. %1$@ is the size the library needs, such as \"5.5 GB\"; %2$@ is the free space.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا توجد مساحة خالية كافية للمكتبة هناك: تحتاج إلى %@، والمتوفر %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সেখানে লাইব্রেরির জন্য যথেষ্ট খালি জায়গা নেই: এর %1$@ দরকার, আর %2$@ খালি আছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dort ist nicht genug freier Speicherplatz für die Bibliothek: Sie braucht %1$@, und %2$@ sind frei."
          }
