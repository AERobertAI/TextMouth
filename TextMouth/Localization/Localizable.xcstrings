    "librarySearch.closeHint" : {
      "comment" : "VoiceOver hint of the Close button of the Search Library window. Search Library is the window's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يغلق نافذة “بحث في المكتبة”؛ وتبقى النتائج للمرة القادمة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "লাইব্রেরিতে অনুসন্ধান বন্ধ করে; ফলাফল পরের বারের জন্য থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Schließt „Bibliothek durchsuchen“; die Ergebnisse bleiben für das nächste Mal erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closes Search Library; results stay for next time"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cierra Buscar en la biblioteca; los resultados se conservan para la próxima vez"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«جست‌وجو در کتابخانه» را می‌بندد؛ نتایج برای دفعه‌ی بعد می‌مانند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ferme Rechercher dans la bibliothèque ; les résultats sont conservés pour la prochaine fois."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "סוגר את “חפש בספרייה”; התוצאות נשארות לפעם הבאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लाइब्रेरी में खोजें बंद करता है; परिणाम अगली बार के लिए रहते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menutup Cari di Pustaka; hasil tetap ada untuk lain kali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chiude Cerca nella libreria; i risultati restano per la prossima volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「ライブラリを検索」を閉じます。結果は次回のために残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관함 검색을 닫습니다. 결과는 다음에 다시 열 때까지 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sluit Zoek in bibliotheek; de resultaten blijven bewaard voor de volgende keer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zamyka okno Szukaj w bibliotece; wyniki zostają do następnego razu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fecha Buscar na biblioteca; os resultados ficam para a próxima vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Закрывает «Поиск по библиотеке»; результаты сохранятся до следующего раза."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stänger Sök i biblioteket. Resultaten finns kvar till nästa gång."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ปิดหน้าต่าง ค้นหาในไลบรารี ผลลัพธ์จะยังอยู่สำหรับครั้งถัดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitaplıkta Ara penceresini kapatır; sonuçlar bir sonraki sefer için kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Закриває «Пошук у бібліотеці»; результати залишаються до наступного разу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لائبریری میں تلاش بند کرتا ہے؛ نتائج اگلی بار کے لیے رہتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đóng Tìm kiếm trong thư viện; kết quả được giữ cho lần sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "关闭“搜索资料库”；结果会保留到下次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "關閉「搜尋書庫」；結果會保留到下次。"
          }
        }
      }
    },
    "librarySearch.fieldHint" : {
      "comment" : "VoiceOver hint of the search field in the Search Library window.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
