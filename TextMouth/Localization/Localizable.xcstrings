    "phoneApp.closedWhileOpening" : {
      "comment" : "Announced at launch after the app closed while it was opening a book. %@ is the book's title, which is not opened again.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أُغلق TextMouth أثناء فتح %@، لذلك لم يُعد فتحه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ খোলার সময় TextMouth বন্ধ হয়ে গিয়েছিল, তাই এটি আবার খোলা হয়নি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth wurde beim Öffnen von %@ beendet und öffnete es daher nicht erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth closed while opening %@, so it wasn't reopened."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth se cerró al abrir %@, así que no se volvió a abrir."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth هنگام باز کردن %@ بسته شد، بنابراین دوباره باز نشد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth s’est fermé pendant l’ouverture de %@ ; ce livre n’a donc pas été rouvert."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth נסגר בזמן פתיחת %@, ולכן הספר לא נפתח מחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ खोलते समय TextMouth बंद हो गया, इसलिए उसे दोबारा नहीं खोला गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tertutup saat membuka %@, jadi buku tidak dibuka lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth si è chiuso durante l’apertura di %@, quindi non è stato riaperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は%@を開いている間に終了したため、再び開きませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 %@을(를) 여는 중에 종료되어 다시 열지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth werd gesloten tijdens het openen van %@, dus het is niet opnieuw geopend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth zamknął się podczas otwierania książki %@, więc nie otwarto jej ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth fechou ao abrir %@, então o livro não foi reaberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth закрылся при открытии книги «%@», поэтому не открывает её снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth stängdes medan %@ öppnades, så den öppnades inte igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth เปิด %@ อยู่เมื่อปิดลง จึงไม่ได้เปิดใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth, %@ açılırken kapandı, bu yüzden yeniden açılmadı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth закрився під час відкриття %@, тому книгу не відкрито знову."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ کھولتے وقت TextMouth بند ہو گیا، اس لیے اسے دوبارہ نہیں کھولا گیا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth đã đóng khi đang mở %@, nên sách không được mở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 在打开 %@ 时关闭，因此未重新打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 在打開 %@ 時關閉了，因此沒有重新打開。"
          }
        }
      }
    },
    "phoneApp.emptyLibrary" : {
      "comment" : "The only row of an empty library. \"Add to Library\" is the name of the button that adds a book, so keep it the same as that button's label.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مكتبتك فارغة. يضيف الزر “إضافة إلى المكتبة” كتابًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আপনার লাইব্রেরি খালি। “লাইব্রেরিতে যোগ করুন” একটি বই যোগ করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deine Bibliothek ist leer. Mit „Zur Bibliothek hinzufügen“ fügst du ein Buch hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your library is empty. Add to Library adds a book."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tu biblioteca está vacía. Agregar a la biblioteca agrega un libro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتابخانه‌ی شما خالی است. «افزودن به کتابخانه» کتابی اضافه می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Votre bibliothèque est vide. Ajouter à la bibliothèque ajoute un livre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הספרייה שלך ריקה. “הוסף לספרייה” מוסיף ספר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आपकी लाइब्रेरी ख़ाली है। पुस्तक जोड़ने के लिए “लाइब्रेरी में जोड़ें” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pustaka Anda kosong. Tambahkan ke Pustaka untuk menambahkan buku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La libreria è vuota. Aggiungi alla libreria aggiunge un libro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ライブラリは空です。「ライブラリに追加」でブックを追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관함이 비어 있습니다. 책을 추가하려면 보관함에 추가를 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Je bibliotheek is leeg. Met Voeg toe aan bibliotheek voeg je een boek toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Biblioteka jest pusta. Dodaj do biblioteki dodaje książkę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sua biblioteca está vazia. Adicionar à biblioteca adiciona um livro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ваша библиотека пуста. Книгу добавляет кнопка «Добавить в библиотеку»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ditt bibliotek är tomt. Med ”Lägg till i biblioteket” lägger du till en bok."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไลบรารีของคุณว่างเปล่า ใช้ เพิ่มไปยังไลบรารี เพื่อเพิ่มหนังสือ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitaplığınız boş. Kitaplığa Ekle bir kitap ekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ваша бібліотека порожня. «Додати до бібліотеки» додає книгу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آپ کی لائبریری خالی ہے۔ “لائبریری میں شامل کریں” ایک کتاب شامل کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thư viện của bạn trống. Nút Thêm vào thư viện sẽ thêm một sách."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "你的资料库为空。“添加到资料库”可添加图书。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "你的書庫是空的。「加入書庫」可加入書籍。"
          }
        }
      }
    },
