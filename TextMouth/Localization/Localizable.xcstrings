    "failure.unsafe.definitions" : {
      "comment" : "Last sentence of why an SSML file was refused because it defines entities of its own: what to do.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "افتحه في محرر نصوص، واحذف تعريفات الكيانات، واحفظه، ثم استورده مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "একটি টেক্সট এডিটরে খুলে এনটিটি সংজ্ঞাগুলো সরিয়ে দিন, সংরক্ষণ করুন, তারপর আবার আমদানি করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffne sie in einem Texteditor, entferne die Entitätsdefinitionen, sichere sie und importiere sie dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open it in a text editor, take the entity definitions out, save it, then import it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ábrelo en un editor de texto, quita las definiciones de entidades, guárdalo y vuelve a importarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آن را در ویرایشگر متن باز کنید، تعریف‌های موجودیت را بردارید، ذخیره کنید و دوباره وارد کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ouvrez-le dans un éditeur de texte, supprimez les définitions d’entités, enregistrez-le, puis importez-le à nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "פתח אותו בעורך טקסט, הסר את הגדרות הישויות, שמור, ואז ייבא אותו שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसे टेक्स्ट एडिटर में खोलें, एंटिटी परिभाषाएँ हटाएँ, सहेजें, फिर इसे दोबारा आयात करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Buka di editor teks, hapus definisi entitas, simpan, lalu impor lagi."
          }
        },
        "it" : {
          "stringUnit" : {
