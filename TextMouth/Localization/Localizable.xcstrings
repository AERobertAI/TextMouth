      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "الملف “%1$@” يعلن ترميز النص “%2$@”، ولا يستطيع TextMouth قراءته."
          }
        },
        "bn" : {
