    "speechRefusal.stoppedInSpokenText" : {
      "comment" : "A line of the speech refusal report. %1$@ is the character offset in the spoken text where speech stopped; %2$@ and %3$@ are where the refused text begins and ends, each written without digit grouping like the speech log's offsets.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "في النص المنطوق، الذي يعطي سجل النطق مواضع أحرفه: توقف النطق عند الحرف %1$@؛ ويمتد النص المرفوض من الحرف %2$@ إلى %3$@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পড়ে শোনানো টেক্সটে, যার অফসেট স্পিচ লগ দেয়: স্পিচ %1$@ নম্বর অক্ষরে থেমেছে; প্রত্যাখ্যাত টেক্সট %2$@ থেকে %3$@ নম্বর অক্ষর পর্যন্ত।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Im gesprochenen Text, dessen Positionen das Sprachprotokoll angibt: Die Sprachausgabe stoppte bei Zeichen %1$@; der abgelehnte Text reicht von Zeichen %2$@ bis %3$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the spoken text, whose offsets the speech log gives: speech stopped at character %@; the refused text runs from character %@ to %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En el texto hablado, cuyas posiciones da el registro de voz: la voz se detuvo en el carácter %1$@; el texto rechazado va del carácter %2$@ al %3$@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "در متن گفته‌شده، که گزارش گفتار جابه‌جایی‌هایش را می‌دهد: گفتار در نویسه %1$@ متوقف شد؛ متن رد‌شده از نویسه %2$@ تا %3$@ ادامه دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dans le texte lu, dont le journal de la voix donne les positions : la lecture s’est arrêtée au caractère %1$@ ; le texte refusé va du caractère %2$@ au caractère %3$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בטקסט המוקרא, שהמיקומים שלו מופיעים ביומן הדיבור: הדיבור נעצר בתו %1$@; הטקסט שנדחה נמשך מתו %2$@ עד תו %3$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "बोले गए टेक्स्ट में, जिसके ऑफ़सेट स्पीच लॉग देता है: स्पीच वर्ण %1$@ पर रुकी; अस्वीकृत टेक्स्ट वर्ण %2$@ से %3$@ तक है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dalam teks yang diucapkan, yang posisinya diberikan log ucapan: ucapan berhenti di karakter %1$@; teks yang ditolak mencakup karakter %2$@ hingga %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nel testo letto, di cui il registro della voce indica le posizioni: la lettura si è interrotta al carattere %1$@; il testo rifiutato va dal carattere %2$@ al %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "読み上げたテキスト内（オフセットは読み上げログに記載）：読み上げは%1$@文字目で停止しました。拒否されたテキストは%2$@文字目から%3$@文字目までです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "음성으로 읽는 텍스트에서(오프셋은 음성 로그에 있음): 음성이 문자 %1$@에서 중지되었으며, 거부된 텍스트는 문자 %2$@에서 %3$@까지입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "In de gesproken tekst, waarvan het spraaklogboek de posities geeft: de spraak stopte bij teken %1$@; de geweigerde tekst loopt van teken %2$@ tot %3$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "W czytanym tekście, którego przesunięcia podaje dziennik mowy: mowa zatrzymała się na znaku %1$@; odrzucony tekst obejmuje znaki od %2$@ do %3$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No texto falado, cujos deslocamentos o registro de fala indica: a fala parou no caractere %1$@; o texto recusado vai do caractere %2$@ ao %3$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В озвучиваемом тексте, смещения которого даёт журнал речи: речь остановилась на символе %1$@; отклонённый текст занимает символы с %2$@ по %3$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I den upplästa texten, vars positioner uppläsningsloggen anger: uppläsningen stoppade vid tecken %1$@; den avvisade texten sträcker sig från tecken %2$@ till %3$@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ในข้อความที่อ่านออกเสียง ซึ่งบันทึกการอ่านออกเสียงระบุตำแหน่งไว้: การอ่านหยุดที่อักขระ %1$@ ข้อความที่ถูกปฏิเสธอยู่ตั้งแต่อักขระ %2$@ ถึง %3$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Seslendirilen metinde (konumları konuşma günlüğü verir): konuşma %1$@. karakterde durdu; reddedilen metin %2$@. karakterden %3$@. karaktere uzanıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В озвученому тексті, зсуви якого наведені в журналі озвучення: озвучення зупинилося на символі %1$@; відхилений текст іде від символу %2$@ до %3$@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بولے گئے متن میں، جس کے آفسیٹ اسپیچ لاگ دیتا ہے: اسپیچ حرف %1$@ پر رکی؛ مسترد کیا گیا متن حرف %2$@ سے %3$@ تک ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trong văn bản được đọc, với các vị trí do nhật ký giọng đọc cho biết: giọng đọc dừng ở ký tự %1$@; văn bản bị từ chối kéo dài từ ký tự %2$@ đến %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在朗读文本中（朗读日志给出偏移量）：朗读在第 %1$@ 个字符处停止；被拒绝的文本从第 %2$@ 个字符到第 %3$@ 个字符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在朗讀文字中（偏移量見語音記錄）：朗讀停在第 %1$@ 個字元；被拒絕的文字從第 %2$@ 個字元到第 %3$@ 個字元。"
          }
        }
      }
    },
    "speechRefusal.summary" : {
      "comment" : "Summary under the heading of the report of a refusal, on the Mac and the iPhone: what happened, and that Play tries again.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "رفض محرك النطق نطق النص هنا مرتين، لذا توقف النطق. يحاول “تشغيل” مرة أخرى من المكان نفسه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "স্পিচ ইঞ্জিন এখানকার টেক্সট দুবার পড়তে অস্বীকার করেছে, তাই স্পিচ থেমে গেছে। “চালান” একই জায়গা থেকে আবার চেষ্টা করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Sprachausgabe hat sich zweimal geweigert, den Text hier zu sprechen, daher stoppte das Vorlesen. „Wiedergeben“ versucht es von derselben Stelle erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The speech engine refused to speak the text here, twice, so speech stopped. Play tries again from the same place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El motor de voz se negó a leer el texto de aquí, dos veces, así que la lectura se detuvo. Reproducir vuelve a intentarlo desde el mismo lugar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "موتور گفتار دو بار از گفتن متن در اینجا امتناع کرد، بنابراین گفتار متوقف شد. «پخش» از همان‌جا دوباره تلاش می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le moteur vocal a refusé de lire le texte ici, deux fois, donc la lecture s’est arrêtée. Lire réessaie à partir du même endroit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מנוע הדיבור סירב להקריא את הטקסט כאן, פעמיים, ולכן הדיבור נעצר. “נגן” מנסה שוב מאותו מקום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "स्पीच इंजन ने यहाँ का टेक्स्ट दो बार बोलने से इनकार किया, इसलिए स्पीच रुक गई। “चलाएँ” उसी जगह से फिर से प्रयास करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mesin ucapan menolak mengucapkan teks di sini, dua kali, jadi ucapan berhenti. Putar mencoba lagi dari tempat yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il motore vocale ha rifiutato due volte di leggere il testo qui, quindi la lettura si è interrotta. Riproduci riprova dallo stesso punto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "読み上げエンジンはここのテキストを2回拒否したため、読み上げが停止しました。「再生」すると、同じ位置からもう一度試します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "음성 엔진이 여기의 텍스트를 두 번 거부하여 음성이 중지되었습니다. 재생하면 같은 위치에서 다시 시도합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De spraakengine weigerde de tekst hier twee keer uit te spreken, dus de spraak stopte. Speel af probeert het opnieuw vanaf dezelfde plaats."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mechanizm mowy dwukrotnie odmówił odczytania tekstu w tym miejscu, więc mowa się zatrzymała. Odtwórz próbuje ponownie od tego samego miejsca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O mecanismo de fala se recusou a falar o texto aqui, duas vezes, então a fala parou. Reproduzir tenta novamente a partir do mesmo ponto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Речевой движок дважды отказался произнести здесь текст, поэтому речь остановилась. «Воспроизвести» повторит попытку с того же места."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Talmotorn vägrade läsa upp texten här, två gånger, så uppläsningen stoppades. ”Spela upp” försöker igen från samma ställe."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เครื่องมืออ่านออกเสียงปฏิเสธที่จะอ่านข้อความตรงนี้สองครั้ง การอ่านออกเสียงจึงหยุด เล่นจะลองอีกครั้งจากตำแหน่งเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Konuşma motoru metni burada iki kez seslendirmeyi reddetti, bu yüzden konuşma durdu. Oynat aynı yerden tekrar dener."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Система озвучення двічі відмовилася озвучити текст тут, тому озвучення зупинилося. «Відтворити» спробує знову з того самого місця."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اسپیچ انجن نے یہاں متن کو دو بار بولنے سے انکار کیا، اس لیے اسپیچ رک گئی۔ “چلائیں” اسی جگہ سے دوبارہ کوشش کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bộ máy đọc đã hai lần từ chối đọc văn bản tại đây, nên giọng đọc đã dừng. Nút Phát sẽ thử lại từ cùng vị trí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "朗读引擎两次拒绝在此处朗读文本，因此朗读已停止。“播放”会从同一位置重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "語音引擎兩次都拒絕在此朗讀文字，因此朗讀已停止。「播放」會從同一處再試一次。"
          }
        }
      }
    },
