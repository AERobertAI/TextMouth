    "documentTooLargeError.errorDescription" : {
      "comment" : "Why a document could not be imported: it is larger than the most TextMouth reads from one document. %@ is that limit with its unit, such as \"64 MB\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحتوي هذا المستند على أكثر من %@، وهو أكبر ما يقرؤه TextMouth من مستند واحد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই নথিতে %@-এর বেশি আছে, যা TextMouth একটি নথি থেকে সর্বোচ্চ পড়ে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieses Dokument enthält mehr als %@, das Maximum, das TextMouth aus einem Dokument liest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This document holds more than %@, the most TextMouth reads from one document."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este documento contiene más de %@, el máximo que TextMouth lee de un documento."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "این سند بیش از %@ دارد، که بیشترین مقداری است که TextMouth از یک سند می‌خواند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce document dépasse %@, le maximum que TextMouth lit dans un document."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "במסמך זה יש יותר מ-%@, הכמות המרבית ש-TextMouth קורא ממסמך אחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस दस्तावेज़ में %@ से अधिक है, जो TextMouth एक दस्तावेज़ से अधिकतम पढ़ता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dokumen ini berisi lebih dari %@, batas terbesar yang dibaca TextMouth dari satu dokumen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo documento contiene più di %@, il massimo che TextMouth legge da un documento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このドキュメントは%@を超えています。TextMouth は1つのドキュメントからそれ以上は読み取りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 문서는 %@보다 큽니다. TextMouth는 문서 하나에서 이보다 많이 읽지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dit document bevat meer dan %@, het maximum dat TextMouth uit één document leest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ten dokument zawiera więcej niż %@, czyli maksimum, które TextMouth odczytuje z jednego dokumentu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este documento tem mais de %@, o máximo que o TextMouth lê de um documento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Этот документ больше %@ — это наибольший объём, который TextMouth читает из одного документа."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Det här dokumentet innehåller mer än %@, vilket är det mesta TextMouth läser från ett dokument."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เอกสารนี้มีขนาดเกิน %@ ซึ่งเป็นขนาดสูงสุดที่ TextMouth อ่านจากเอกสารหนึ่งฉบับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu belge %@ değerinden fazlasını içeriyor; bu, TextMouth'un tek bir belgeden okuduğu en fazla miktardır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Цей документ містить понад %@ — це максимум, який TextMouth читає з одного документа."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
