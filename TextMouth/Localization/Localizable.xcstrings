        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "manifest.json में सेगमेंट हैं, जिन्हें TextMouth केवल अपनी बदली हुई DAISY पुस्तक के लिए लिखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
