    "Line ends" : {
      "comment" : "The label of the pop-up in the Export dialog's braille options that chooses how each line of a BRF file ends."
    },
    "Lines per page" : {
      "comment" : "The label of the stepper in the Export dialog's braille options that sets how many lines each braille page holds."
    },
    "List and download" : {
      "comment" : "Label of the pop-up menu that chooses how many of a feed's items are listed and downloaded, in Settings and Feed Info. Sentences name it."
    },
    "Listen and Move" : {
      "comment" : "Heading of the audio editor's buttons for listening and moving the cursor."
