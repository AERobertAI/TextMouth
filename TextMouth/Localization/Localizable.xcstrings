            "value" : "O TextMouth abre o manifest.json do livro no seu editor de texto."
          }
        }
      }
    },
    "TextMouth opens the book's text in your text editor, as a Markdown file." : {
      "comment" : "First sentence of the Edit Text explanation. Markdown is the name of a text format.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth abre el texto del libro en tu editor de texto, como archivo Markdown."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ouvre le texte du livre dans votre éditeur de texte, sous forme de fichier Markdown."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth apre il testo del libro nel tuo editor di testo, come file Markdown."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth abre o texto do livro no seu editor de texto, como um arquivo Markdown."
          }
        }
      }
    },
    "TextMouth quit on %@: its memory grew to %@ GB while %@ played, because of a fault in macOS's audio. Your place was saved." : {
      "comment" : "Alert text at the next launch after TextMouth quit to protect the Mac, when a book played. %1$@ is the date and time of the quit; %2$@ is how large its memory grew, in gigabytes, such as 6.1; %3$@ is the book's title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth wurde am %1$@ beendet: Sein Speicher wuchs auf %2$@ GB, während %3$@ wiedergegeben wurde, wegen eines Fehlers im Audio von macOS. Deine Position wurde gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TextMouth quit on %1$@: its memory grew to %2$@ GB while %3$@ played, because of a fault in macOS's audio. Your place was saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth se cerró el %1$@: su memoria creció hasta %2$@ GB mientras se reproducía %3$@, por un fallo del audio de macOS. Se guardó tu posición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth a quitté le %1$@ : sa mémoire a atteint %2$@ Go pendant la lecture de %3$@, à cause d’un défaut de l’audio de macOS. Votre position a été enregistrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth si è chiuso il %1$@: la sua memoria è arrivata a %2$@ GB mentre era in riproduzione %3$@, a causa di un difetto nell’audio di macOS. La tua posizione è stata salvata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth fechou em %1$@: sua memória cresceu para %2$@ GB enquanto %3$@ era reproduzido, por causa de uma falha no áudio do macOS. Sua posição foi salva."
          }
        }
      }
    },
    "TextMouth quit on %@: its memory grew to %@ GB while a book played, because of a fault in macOS's audio. Your place was saved." : {
      "comment" : "Alert text at the next launch after TextMouth quit to protect the Mac, when a book played whose title was not kept. %1$@ is the date and time of the quit; %2$@ is how large its memory grew, in gigabytes, such as 6.1.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth wurde am %1$@ beendet: Sein Speicher wuchs auf %2$@ GB, während ein Buch wiedergegeben wurde, wegen eines Fehlers im Audio von macOS. Deine Position wurde gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TextMouth quit on %1$@: its memory grew to %2$@ GB while a book played, because of a fault in macOS's audio. Your place was saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth se cerró el %1$@: su memoria creció hasta %2$@ GB mientras se reproducía un libro, por un fallo del audio de macOS. Se guardó tu posición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth a quitté le %1$@ : sa mémoire a atteint %2$@ Go pendant la lecture d’un livre, à cause d’un défaut de l’audio de macOS. Votre position a été enregistrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth si è chiuso il %1$@: la sua memoria è arrivata a %2$@ GB mentre era in riproduzione un libro, a causa di un difetto nell’audio di macOS. La tua posizione è stata salvata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth fechou em %1$@: sua memória cresceu para %2$@ GB enquanto um livro era reproduzido, por causa de uma falha no áudio do macOS. Sua posição foi salva."
          }
        }
      }
    },
    "TextMouth quit on %@: its memory grew to %@ GB while nothing was playing. Your place was saved." : {
      "comment" : "Alert text at the next launch after TextMouth quit to protect the Mac, when nothing was playing. %1$@ is the date and time of the quit; %2$@ is how large its memory grew, in gigabytes, such as 6.1.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth wurde am %1$@ beendet: Sein Speicher wuchs auf %2$@ GB, während nichts wiedergegeben wurde. Deine Position wurde gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TextMouth quit on %1$@: its memory grew to %2$@ GB while nothing was playing. Your place was saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth se cerró el %1$@: su memoria creció hasta %2$@ GB mientras no se reproducía nada. Se guardó tu posición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth a quitté le %1$@ : sa mémoire a atteint %2$@ Go alors que rien n’était en lecture. Votre position a été enregistrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth si è chiuso il %1$@: la sua memoria è arrivata a %2$@ GB mentre non era in riproduzione nulla. La tua posizione è stata salvata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth fechou em %1$@: sua memória cresceu para %2$@ GB enquanto nada estava sendo reproduzido. Sua posição foi salva."
          }
        }
      }
    },
    "TextMouth reads BRF and BRL files you add from now on with these characters, and recognizes Unicode braille patterns by itself. The Export dialog starts a BRF with them. A book keeps its import characters, which Book Information can change." : {
      "comment" : "The caption under the braille file characters pop-up in the Braille tab of Settings. BRF and BRL are braille file formats, and Book Information is a window.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth liest BRF- und BRL-Dateien, die du ab jetzt hinzufügst, mit diesen Zeichen und erkennt Unicode-Braillemuster selbst. Der Exportdialog beginnt eine BRF-Datei mit ihnen. Ein Buch behält seine Importzeichen, die „Buchinformationen“ ändern können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A partir de ahora, TextMouth lee los archivos BRF y BRL que agregues con estos caracteres, y reconoce por sí mismo los patrones braille Unicode. El diálogo Exportar empieza un BRF con ellos. Un libro conserva sus caracteres de importación, que Información del libro puede cambiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth lit les fichiers BRF et BRL que vous ajoutez à partir de maintenant avec ces caractères, et reconnaît tout seul les motifs braille Unicode. La fenêtre Exporter en démarre un BRF avec eux. Un livre garde ses caractères d’import, que la fenêtre Informations sur le livre peut modifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth legge con questi caratteri i file BRF e BRL che aggiungi da ora in poi e riconosce da solo i modelli braille Unicode. La finestra Esporta li usa per iniziare un BRF. Un libro conserva i caratteri della sua importazione, che Informazioni sul libro può cambiare."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth lê com estes caracteres os arquivos BRF e BRL que você adicionar a partir de agora e reconhece sozinho os padrões braille Unicode. A janela Exportar começa um BRF com eles. Um livro mantém os caracteres de sua importação, que as Informações do livro podem mudar."
          }
        }
      }
    },
    "TextMouth reads braille files (BRF, BRL, and PEF) with this code and exports with it unless the Export dialog chooses another. A book keeps the code it was imported with." : {
      "comment" : "The caption under the code pop-ups in the Braille tab of Settings. BRF, BRL, and PEF are braille file formats.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth liest Braille-Dateien (BRF, BRL und PEF) mit diesem Code und exportiert damit, sofern der Exportdialog keinen anderen wählt. Ein Buch behält den Code, mit dem es importiert wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth lee los archivos braille (BRF, BRL y PEF) con este código y exporta con él, salvo que el diálogo Exportar elija otro. Un libro conserva el código con el que se importó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth lit les fichiers braille (BRF, BRL et PEF) avec ce code et exporte avec lui, sauf si la fenêtre Exporter en choisit un autre. Un livre garde le code avec lequel il a été importé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth legge i file braille (BRF, BRL e PEF) con questo codice e li esporta con lo stesso, a meno che la finestra Esporta ne scelga un altro. Un libro conserva il codice con cui è stato importato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth lê arquivos braille (BRF, BRL e PEF) com este código e exporta com ele, a menos que a janela Exportar escolha outro. Um livro mantém o código com que foi importado."
          }
        }
      }
    },
    "TextMouth reads its file as it reads a file you add: in the encoding the file names, or else the one TextMouth finds." : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. What Automatic does, as the alert says it before it is chosen.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth liest die Datei so, wie es eine hinzugefügte Datei liest: in der Codierung, die die Datei nennt, oder sonst in der, die TextMouth findet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth lee su archivo como lee un archivo que agregas: con la codificación que indica el archivo o, si no, con la que TextMouth encuentra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth lit son fichier comme un fichier que vous ajoutez : dans l’encodage que le fichier indique, sinon celui que TextMouth trouve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth legge il suo file come legge un file che aggiungi: nella codifica indicata dal file, oppure in quella che TextMouth individua."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth lê o arquivo dele como lê um arquivo que você adiciona: na codificação que o arquivo indica ou, se não houver, na que o TextMouth encontra."
          }
        }
      }
    },
    "TextMouth saves them once it has finished moving books between folders." : {
      "comment" : "Why a failed save waits: it runs when books have been moved between folders. \"Them\" is the changes that could not be saved.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth sichert sie, sobald es das Verschieben von Büchern zwischen Ordnern beendet hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth los guarda cuando termine de mover libros entre carpetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth les enregistre dès qu’il a fini de déplacer des livres entre des dossiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth le salva quando ha finito di spostare i libri tra le cartelle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth as salva quando terminar de mover livros entre pastas."
          }
        }
      }
    },
    "TextMouth saves them once it has finished rebuilding its data directory." : {
      "comment" : "Why a failed save waits: it runs when the data directory has been rebuilt. \"Them\" is the changes that could not be saved.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth sichert sie, sobald es den Datenordner neu aufgebaut hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth los guarda cuando termine de reconstruir su directorio de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth les enregistre dès qu’il a fini de reconstruire son dossier de données."
          }
        },
        "it" : {
          "stringUnit" : {
