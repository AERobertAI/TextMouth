                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "O arquivo compactado contém também %lld outros livros que não foram importados; descompacte-o para importá-los."
                }
              }
            }
          }
        },
        "ru" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "В архиве есть ещё %lld книги, которые не импортированы; распакуйте архив, чтобы импортировать их."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "В архиве есть ещё %lld книг, которые не импортированы; распакуйте архив, чтобы импортировать их."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "В архиве есть ещё %lld книга, которая не импортирована; распакуйте архив, чтобы импортировать её."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "В архиве есть ещё %lld книги, которые не импортированы; распакуйте архив, чтобы импортировать их."
                }
              }
            }
          }
        },
        "uk" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "В архіві також є %lld інші книги, які не імпортовано; розпакуйте архів, щоб їх імпортувати."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "В архіві також є %lld інших книг, які не імпортовано; розпакуйте архів, щоб їх імпортувати."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "В архіві також є %lld інша книга, яку не імпортовано; розпакуйте архів, щоб її імпортувати."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "В архіві також є %lld іншої книги, яку не імпортовано; розпакуйте архів, щоб її імпортувати."
