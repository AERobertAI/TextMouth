        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא ניתן לכתוב בתיקיית היומנים של תיקיית הנתונים (%1$@), ולכן היומנים נכתבים אל %2$@ עד שיהיה אפשר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "डेटा फ़ोल्डर के Logs फ़ोल्डर में लिखा नहीं जा सकता (%1$@), इसलिए जब तक लिखा न जा सके, लॉग %2$@ में जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Folder Log di folder data tidak dapat ditulisi (%1$@), jadi log masuk ke %2$@ sampai dapat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non è possibile scrivere nella cartella Registri della cartella dei dati (%@), quindi i registri vanno in %@ finché non sarà possibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "データディレクトリの Logs フォルダに書き込めない（%1$@）ため、書き込めるようになるまでログは%2$@に書き込まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "데이터 디렉터리의 Logs 폴더에 쓸 수 없으므로(%1$@) 쓸 수 있게 될 때까지 로그는 %2$@에 기록됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "In de map Logboeken van de gegevensmap kan niet worden geschreven (%1$@), dus logboeken gaan naar %2$@ totdat dat kan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Do folderu Dzienniki w folderze danych nie można zapisywać (%1$@), więc dzienniki trafiają do %2$@, dopóki się to nie zmieni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não é possível gravar na pasta Logs da pasta de dados (%1$@), então os registros vão para %2$@ até que seja possível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В папку Logs каталога данных нельзя записывать (%1$@), поэтому журналы пишутся в %2$@, пока это не станет возможным."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Datamappens Loggar-mapp går inte att skriva till (%1$@), så loggar går till %2$@ tills det går."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เขียนลงในโฟลเดอร์บันทึกการทำงานของโฟลเดอร์ข้อมูลไม่ได้ (%@) บันทึกการทำงานจึงไปที่ %@ จนกว่าจะเขียนได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Veri klasörünün Günlükler klasörüne yazılamıyor (%1$@); bu yüzden günlükler, yazılabilene kadar şuraya gider: %2$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "У папку Logs каталогу даних не можна записувати (%1$@), тому журнали записуються в %2$@, доки це не стане можливим."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ڈیٹا ڈائریکٹری کے لاگز فولڈر میں لکھا نہیں جا سکتا (%1$@)، اس لیے جب تک لکھا نہ جا سکے لاگز %2$@ میں جاتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không ghi được vào thư mục Logs của thư mục dữ liệu (%1$@), nên nhật ký được ghi vào %2$@ cho đến khi ghi được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "无法写入数据目录的“日志”文件夹（%1$@），因此日志会写入 %2$@，直到可以写入为止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "無法寫入資料目錄的 Logs 檔案夾（%1$@），因此在可寫入之前，記錄會存放到 %2$@。"
          }
        }
      }
    },
