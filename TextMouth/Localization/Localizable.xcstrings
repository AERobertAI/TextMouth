    "feed.everyFeedUnsubscribed" : {
      "comment" : "What VoiceOver says when Refresh All Feeds finds only unsubscribed feeds. The first %@ is the name of the Resubscribe command; the second is the name of the Feed Info sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "كل الموجزات غير مشترك فيها، لذا لم يُفحص أي منها. اختر %1$@ في صف الموجز، أو في %2$@، لفحصه مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "প্রতিটি ফিডের সাবস্ক্রিপশন বাতিল করা, তাই কোনোটিই চেক করা হয়নি। আবার চেক করতে ফিডের সারিতে বা এর %2$@-এ %1$@ বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alle Feeds sind abbestellt, daher wurde keiner geprüft. Wähle %1$@ in der Zeile eines Feeds oder unter %2$@, um ihn erneut zu prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every feed is unsubscribed, so none was checked. Choose %@ on a feed's row, or in its %@, to check it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Todos los canales tienen la suscripción cancelada, así que no se revisó ninguno. Elige %1$@ en la fila de un canal, o en su %2$@, para volver a revisarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اشتراک همه فیدها لغو شده است، پس هیچ‌کدام بررسی نشد. برای بررسی دوباره، %1$@ را در ردیف فید یا در %2$@ انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vous êtes désabonné de tous les flux, donc aucun n’a été vérifié. Choisissez %1$@ sur la ligne d’un flux, ou dans %2$@, pour le vérifier de nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כל הערוצים ללא הרשמה, ולכן אף אחד מהם לא נבדק. כדי לבדוק ערוץ שוב, בחר “%1$@” בשורה שלו או ב“%2$@” שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "हर फ़ीड की सदस्यता रद्द है, इसलिए किसी को नहीं जाँचा गया। उसे फिर से जाँचने के लिए फ़ीड की पंक्ति पर, या उसके %2$@ में, “%1$@” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Semua feed tidak lagi dilanggan, jadi tidak ada yang diperiksa. Pilih %1$@ pada baris feed, atau di %2$@-nya, untuk memeriksanya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hai annullato l’iscrizione a tutti i feed, quindi nessuno è stato controllato. Scegli %1$@ nella riga di un feed, o nel foglio %2$@, per riprendere a controllarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "すべてのフィードが購読解除されているため、どれも確認されませんでした。もう一度確認するには、フィードの行で、またはその%2$@で、%1$@を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "모든 피드가 구독 해제되어 확인한 피드가 없습니다. 다시 확인하려면 피드의 행 또는 %2$@에서 %1$@을(를) 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Geen enkele feed heeft een abonnement, dus er is niets gecontroleerd. Kies %1$@ in de rij van een feed, of in de bijbehorende %2$@, om een feed opnieuw te controleren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wszystkie kanały są bez subskrypcji, więc żaden nie został sprawdzony. Aby sprawdzić je ponownie, wybierz %1$@ w wierszu kanału lub w oknie %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Todos os feeds estão sem assinatura, então nenhum foi verificado. Escolha %1$@ na linha de um feed, ou em %2$@, para verificá-lo novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вы отписались от всех лент, поэтому ни одна не проверена. Выберите %1$@ в строке ленты или в листе %2$@, чтобы снова проверять её."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alla flöden har avslutad prenumeration, så inget kontrollerades. Välj %1$@ på ett flödes rad, eller i dess %2$@, för att kontrollera det igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ทุกฟีดเลิกติดตามแล้ว จึงไม่มีฟีดใดถูกตรวจสอบ เลือก %1$@ ที่แถวของฟีด หรือใน %2$@ เพื่อตรวจสอบอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tüm beslemelerin aboneliği kaldırılmış, bu yüzden hiçbiri denetlenmedi. Yeniden denetlemek için beslemenin satırında veya bilgi sayfasında (%2$@) şunu seçin: %1$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Усі стрічки без підписки, тому жодну не перевірено. Виберіть «%1$@» у рядку стрічки або в аркуші «%2$@», щоб відновити перевірку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ہر فیڈ کی سبسکرپشن منسوخ ہے، اس لیے کسی کو چیک نہیں کیا گیا۔ انہیں دوبارہ چیک کرنے کے لیے فیڈ کی صف پر، یا اس کی %2$@ میں، %1$@ منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bạn đã hủy đăng ký mọi nguồn cấp nên không nguồn nào được kiểm tra. Chọn %1$@ trên hàng của một nguồn cấp, hoặc trong %2$@ của nguồn cấp đó, để kiểm tra lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "所有订阅源都已取消订阅，因此没有检查任何订阅源。在订阅源所在行或其“%2$@”中选取“%1$@”，即可再次检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "每個訂閱源都已取消訂閱，因此沒有檢查任何一個。在訂閱源的列上，或在其「%2$@」中，選擇「%1$@」即可再次檢查。"
          }
        }
      }
    },
    "feed.everyListedDownloadsByHand.article" : {
      "comment" : "VoiceOver hint of the List and download choice for a feed of articles when the listener downloads by hand.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعرض كل المقالات؛ لا ينزّل شيئًا من تلقاء نفسه، ويبقى التنزيل إلى أن تحذفه أو تنقضي أيامه بعد التشغيل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সব নিবন্ধ তালিকাভুক্ত করে; কিছুই নিজে থেকে ডাউনলোড হয় না, এবং আপনি না মোছা পর্যন্ত বা চালানোর পরের দিনগুলো না পেরোনো পর্যন্ত ডাউনলোড থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Listet jeden Artikel auf; nichts wird von selbst heruntergeladen, und ein Download bleibt, bis du ihn löschst oder die Tage nach der Wiedergabe vergangen sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lists every article; nothing downloads by itself, and a download stays until you delete it or its days after playing pass."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Enumera todos los artículos; nada se descarga solo, y una descarga permanece hasta que la elimines o pasen sus días tras reproducirla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "همه مقاله‌ها را فهرست می‌کند؛ هیچ چیز خودکار بارگیری نمی‌شود و بارگیری می‌ماند تا آن را حذف کنید یا روزهای پس از پخش آن بگذرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Répertorie tous les articles ; rien n’est téléchargé automatiquement, et un téléchargement reste jusqu’à ce que vous le supprimiez ou que son délai après lecture soit écoulé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מציג ברשימה כל כתבה; דבר אינו מורד מעצמו, וההורדה נשארת עד שתמחק אותה או עד שיחלפו הימים שלאחר ההשמעה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "हर लेख सूचीबद्ध करता है; कुछ भी अपने आप डाउनलोड नहीं होता, और डाउनलोड तब तक रहता है जब तक आप उसे मिटा न दें या चलाने के बाद के उसके दिन पूरे न हो जाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mencantumkan setiap artikel; tidak ada yang diunduh otomatis, dan unduhan tetap ada sampai Anda menghapusnya atau batas harinya setelah diputar terlewati."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elenca ogni articolo; nulla viene scaricato automaticamente, e un download resta finché non lo elimini o non passano i giorni previsti dopo la riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "すべての記事を一覧表示します。自動ではダウンロードされず、ダウンロードしたものは、削除するか、再生後の日数が過ぎるまで残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "모든 기사를 나열합니다. 자동으로 다운로드되는 항목은 없으며, 직접 삭제하거나 재생 후 일수가 지날 때까지 다운로드는 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toont elk artikel; er wordt niets vanzelf gedownload en een download blijft bestaan tot je hem verwijdert of de dagen na afspelen zijn verstreken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wyświetla każdy artykuł; nic nie pobiera się samo, a pobrany plik zostaje, dopóki go nie usuniesz lub nie upłynie liczba dni po odtworzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lista todos os artigos; nada é baixado automaticamente, e um download permanece até você excluí-lo ou os dias após a reprodução passarem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Показывает все статьи; ничего не загружается само, и загрузка остаётся, пока вы её не удалите или не пройдут дни после воспроизведения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Listar varje artikel; inget hämtas automatiskt, och en nedladdning finns kvar tills du raderar den eller dess dagar efter uppspelning har gått."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "แสดงบทความทั้งหมด ไม่ดาวน์โหลดอัตโนมัติ และรายการดาวน์โหลดจะอยู่จนกว่าคุณจะลบหรือครบจำนวนวันหลังเล่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Her makaleyi listeler; hiçbir şey kendiliğinden indirilmez ve bir indirme, siz silene veya oynatıldıktan sonraki gün sayısı dolana kadar kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Показує всі статті; нічого не завантажується автоматично, а завантаження зберігається, доки ви його не видалите або не мине кількість днів після відтворення."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ہر مضمون کو فہرست میں دکھاتا ہے؛ کچھ خود بخود ڈاؤن لوڈ نہیں ہوتا، اور ڈاؤن لوڈ تب تک رہتا ہے جب تک آپ اسے حذف نہ کریں یا چلانے کے بعد کے اس کے دن نہ گزر جائیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Liệt kê mọi bài viết; không có gì tự tải về, và một bản tải về được giữ lại cho đến khi bạn xóa nó hoặc hết số ngày sau khi phát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "列出每篇文章；不会自动下载任何内容，下载内容会一直保留，直到你将其删除或播放后天数已过。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "列出每篇文章；不會自動下載任何項目，下載項目會保留，直到你刪除它或播放後的天數已過。"
          }
        }
      }
    },
