        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Darin ist keine Audiodatei im eigenen Ordner genannt, die TextMouth importieren kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It names no audio file in its own folder that TextMouth can import."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No nombra ningún archivo de audio en su propia carpeta que TextMouth pueda importar."
