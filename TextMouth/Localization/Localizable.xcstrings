    "bookTextEdit.keptOnReRead.extraction" : {
      "comment" : "Second sentence of that message. Redo Text Extraction is the name of a menu command.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اختر “إعادة استخراج النص” لقراءة ملف الكتاب مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইয়ের ফাইল আবার পড়তে “টেক্সট নিষ্কাশন আবার করুন” বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wähle „Textextraktion wiederholen“, um die Datei des Buchs erneut zu lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Redo Text Extraction to read the book's file again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige Repetir extracción de texto para volver a leer el archivo del libro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "برای خواندن دوباره فایل کتاب، «استخراج مجدد متن» را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisissez Refaire l’extraction du texte pour relire le fichier du livre."
