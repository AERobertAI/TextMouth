    "Lists the newest %lld you haven't played, and every download. Downloads only what you ask for; the others keep their records and return when you list more." : {
      "comment" : "VoiceOver hint of the List and download choice for a feed of episodes, in Settings, or for a feed of both kinds when only the newest are listed. %lld is how many of the newest.",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Listet die neueste (%lld), die du noch nicht wiedergegeben hast, und alle Downloads. Lädt nur herunter, was du anforderst; die übrigen behalten ihre Einträge und kommen zurück, wenn du mehr auflistest."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Listet die neuesten %lld, die du noch nicht wiedergegeben hast, und alle Downloads. Lädt nur herunter, was du anforderst; die übrigen behalten ihre Einträge und kommen zurück, wenn du mehr auflistest."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Lists the newest %lld you haven't played, and every download. Downloads only what you ask for; the others keep their records and return when you list more."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Lists the newest %lld you haven't played, and every download. Downloads only what you ask for; the others keep their records and return when you list more."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Enumera los %lld más recientes que no has reproducido, y todas las descargas. Descarga solo lo que pides; los demás conservan sus registros y vuelven cuando enumeras más."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Enumera el más reciente que no has reproducido, y todas las descargas. Descarga solo lo que pides; los demás conservan sus registros y vuelven cuando enumeras más."
                }
              },
              "other" : {
                "stringUnit" : {
