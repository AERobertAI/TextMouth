    "ownAudio.sentence.companionDamaged" : {
      "comment" : "Why a hybrid WavPack file could not be converted at import: the correction file beside it (the same name ending in .wvc) is damaged or belongs to another recording. %1$@ is the correction file's name and %2$@ the WavPack file's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ملف التصحيح %1$@ تالف أو يخص تسجيلًا آخر، لذا تعذّر تحويل %2$@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সংশোধন ফাইল %1$@ ক্ষতিগ্রস্ত বা অন্য রেকর্ডিংয়ের, তাই %2$@ রূপান্তর করা যায়নি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Korrekturdatei %1$@ ist beschädigt oder gehört zu einer anderen Aufnahme, daher konnte %2$@ nicht konvertiert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The correction file %@ is damaged or belongs to another recording, so %@ could not be converted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo de corrección %1$@ está dañado o pertenece a otra grabación, así que no se pudo convertir %2$@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فایل تصحیح %1$@ آسیب دیده یا متعلق به ضبط دیگری است، بنابراین %2$@ تبدیل نشد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le fichier de correction %@ est endommagé ou appartient à un autre enregistrement, donc %@ n’a pas pu être converti."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "קובץ התיקון %1$@ פגום או שייך להקלטה אחרת, ולכן לא ניתן היה להמיר את %2$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सुधार फ़ाइल %1$@ क्षतिग्रस्त है या किसी दूसरी रिकॉर्डिंग की है, इसलिए %2$@ को बदला नहीं जा सका।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "File koreksi %1$@ rusak atau milik rekaman lain, sehingga %2$@ tidak dapat dikonversi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il file di correzione %@ è danneggiato o appartiene a un’altra registrazione, quindi non è stato possibile convertire %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "補正ファイル%1$@が壊れているか、別の録音のものであるため、%2$@を変換できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보정 파일 %1$@이(가) 손상되었거나 다른 녹음의 것이어서 %2$@을(를) 변환할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Het correctiebestand %@ is beschadigd of hoort bij een andere opname, dus %@ kon niet worden geconverteerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Plik korekcji %1$@ jest uszkodzony lub należy do innego nagrania, więc nie udało się przekonwertować pliku %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo de correção %1$@ está danificado ou pertence a outra gravação, então não foi possível converter %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл коррекции %1$@ повреждён или относится к другой записи, поэтому %2$@ не удалось преобразовать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Korrigeringsfilen %@ är skadad eller tillhör en annan inspelning, så %@ kunde inte konverteras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไฟล์แก้ไข %1$@ เสียหายหรือเป็นของการบันทึกอื่น จึงแปลง %2$@ ไม่ได้"
          }
