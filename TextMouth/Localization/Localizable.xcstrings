    "removalChoice.message" : {
      "comment" : "First sentence of the confirmation that asks how to remove books. %@ is what is removed, such as \"“Notes”\" or \"3 books\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اختر طريقة إزالة %@ من المكتبة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ লাইব্রেরি থেকে কীভাবে সরাবেন তা বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
