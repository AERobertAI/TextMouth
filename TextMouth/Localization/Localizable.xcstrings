          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive está lleno, así que no se suben %@ ni %@. Tu biblioteca en %@ sigue como estaba."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive پر است، بنابراین %@ و %@ بارگذاری نشدند. کتابخانهٔ شما در %@ همان‌طور که بود مانده است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive est plein, donc %@ et %@ ne sont pas envoyés. Votre bibliothèque sur %@ est restée telle quelle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
