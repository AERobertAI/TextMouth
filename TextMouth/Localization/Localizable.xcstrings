            "state" : "machine_translated",
            "value" : "El texto que content.md tenía antes se conservó como %@, en el paquete del libro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le texte que contenait content.md a été conservé sous le nom %@, dans le paquet du livre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo che content.md conteneva prima è stato conservato come %@, nel pacchetto del libro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O texto que content.md tinha antes foi guardado como %@, no pacote do livro."
          }
        }
      }
    },
    "The text handed to the speech engine, after the substitutions and the markup guard, characters %@ to %@ of the spoken text:" : {
      "comment" : "A line of the speech refusal report that introduces the text the speech engine was handed, after the user's substitution rules and the markup guard. %1$@ and %2$@ are the first and last character offsets in the spoken text, written without digit grouping.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der der Sprachausgabe übergebene Text, nach den Ersetzungen und dem Markup-Schutz, Zeichen %1$@ bis %2$@ des gesprochenen Textes:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The text handed to the speech engine, after the substitutions and the markup guard, characters %1$@ to %2$@ of the spoken text:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto entregado al motor de voz, después de las sustituciones y de la protección de marcado, caracteres %1$@ a %2$@ del texto hablado:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le texte remis au moteur vocal, après les substitutions et le garde-fou du balisage, caractères %1$@ à %2$@ du texte lu :"
          }
