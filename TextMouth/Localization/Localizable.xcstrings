    "dataDirectoryMigrationError.chooseEmptyLocation" : {
      "comment" : "Last sentence of why a move of the data directory was refused: what to do.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اختر موقعًا فارغًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "একটি খালি অবস্থান বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wähle einen leeren Ort."
          }
        },
