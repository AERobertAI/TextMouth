    "This Kindle book has no flowing text, as in a comic or print replica, so TextMouth can't read it." : {
      "comment" : "Why a Kindle (KFX) book could not be imported: its pages are fixed layouts or pictures, as in a comic or a print replica, with no text that flows.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieses Kindle-Buch hat keinen fließenden Text, wie bei einem Comic oder einer Druckreplik, daher kann TextMouth es nicht lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este libro de Kindle no tiene texto fluido, como un cómic o una réplica impresa, así que TextMouth no puede leerlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce livre Kindle n’a pas de texte fluide, comme dans une bande dessinée ou une réplique d’imprimé, donc TextMouth ne peut pas le lire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo libro Kindle non ha testo scorrevole, come in un fumetto o in una replica della stampa, quindi TextMouth non può leggerlo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este livro Kindle não tem texto fluido, como acontece em quadrinhos ou réplicas de impressos, então o TextMouth não consegue lê-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В этой книге Kindle нет текучего текста, как в комиксах или копиях печатных изданий, поэтому TextMouth не может её прочитать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此 Kindle 图书没有可重排的文本（如漫画或印刷版复制品），TextMouth 无法读取。"
          }
        }
      }
    },
    "This Kindle book is compressed in a way TextMouth can't read yet." : {
      "comment" : "Why a Kindle (MOBI) book could not be imported: its text is compressed in a way TextMouth does not read.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieses Kindle-Buch ist auf eine Weise komprimiert, die TextMouth noch nicht lesen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este libro de Kindle está comprimido de un modo que TextMouth aún no puede leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce livre Kindle est compressé d’une manière que TextMouth ne sait pas encore lire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo libro Kindle è compresso in un modo che TextMouth non sa ancora leggere."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este livro Kindle usa uma compactação que o TextMouth ainda não consegue ler."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Эта книга Kindle сжата способом, который TextMouth пока не умеет читать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此 Kindle 图书的压缩方式 TextMouth 尚无法读取。"
          }
        }
      }
    },
    "This Kindle book is copy-protected, and TextMouth can't read copy-protected books." : {
      "comment" : "Why a Kindle (MOBI) book could not be imported: it is encrypted or carries copy protection (DRM), which TextMouth never removes.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieses Kindle-Buch ist kopiergeschützt, und TextMouth kann kopiergeschützte Bücher nicht lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este libro de Kindle tiene protección contra copia, y TextMouth no puede leer libros con protección contra copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce livre Kindle est protégé contre la copie, et TextMouth ne peut pas lire les livres protégés contre la copie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo libro Kindle è protetto da copia e TextMouth non può leggere i libri protetti da copia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este livro Kindle tem proteção contra cópia, e o TextMouth não consegue ler livros com proteção contra cópia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Эта книга Kindle защищена от копирования, а TextMouth не читает книги с такой защитой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
