      }
    },
    "manualBookOrder.noArrangedOrder.folders" : {
      "comment" : "VoiceOver announcement when Move Book Up or Move Book Down is used in a view that mixes books from many folders. Folders and Reading List are names of views in the View menu.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يمكن نقل الكتب في هذا العرض. انتقل إلى مجلد في عرض المجلدات، أو إلى قائمة القراءة، ثم حاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই ভিউয়ে বই সরানো যায় না। ফোল্ডার ভিউয়ের কোনো ফোল্ডারে, অথবা পড়ার তালিকায় যান, তারপর আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bücher lassen sich in dieser Ansicht nicht verschieben. Gehe in „Ordner“ zu einem Ordner oder zur Leseliste und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Books can't be moved in this view. Go to a folder in Folders, or to the Reading List, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los libros no se pueden mover en esta vista. Ve a una carpeta en Carpetas, o a la Lista de lectura, e inténtalo de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب‌ها را در این نما نمی‌توان جابه‌جا کرد. به پوشه‌ای در «پوشه‌ها» یا به «فهرست مطالعه» بروید و دوباره تلاش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les livres ne peuvent pas être déplacés dans cette vue. Allez dans un dossier de la vue Dossiers, ou dans la liste de lecture, puis réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אי אפשר להעביר ספרים בתצוגה הזו. עבור לתיקייה ב“תיקיות” או ל“רשימת קריאה” ונסה שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस दृश्य में पुस्तकें ले जाई नहीं जा सकतीं। फ़ोल्डर दृश्य में कोई फ़ोल्डर खोलें, या रीडिंग लिस्ट खोलें, और फिर से प्रयास करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Buku tidak dapat dipindahkan dalam tampilan ini. Buka folder di tampilan Folder, atau buka Daftar Bacaan, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I libri non possono essere spostati in questa vista. Vai a una cartella in Cartelle, o all’elenco di lettura, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このビューではブックを移動できません。「フォルダ」のフォルダまたはリーディングリストに移動してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 보기에서는 책을 이동할 수 없습니다. 폴더 보기의 폴더나 읽기 목록으로 이동한 다음 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Boeken kunnen in deze weergave niet worden verplaatst. Ga naar een map in Mappen of naar de Leeslijst en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "W tym widoku nie można przenosić książek. Przejdź do folderu w widoku Foldery albo do widoku Lista czytelnicza i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Os livros não podem ser movidos nesta visualização. Vá para uma pasta em Pastas ou para a Lista de leitura e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Книги нельзя перемещать в этом представлении. Перейдите в папку в разделе «Папки» или в «Список для чтения» и повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Böcker kan inte flyttas i den här vyn. Gå till en mapp under Mappar eller till Läslistan och försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ย้ายหนังสือในมุมมองนี้ไม่ได้ ไปที่โฟลเดอร์ในมุมมองโฟลเดอร์ หรือไปที่รายการอ่าน แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitaplar bu görünümde taşınamaz. Klasörler görünümünde bir klasöre veya Okuma Listesine gidin, sonra tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Книги не можна переміщувати в цьому вигляді. Перейдіть до папки в розділі «Папки» або до списку читання й повторіть спробу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس منظر میں کتابیں منتقل نہیں کی جا سکتیں۔ فولڈرز میں کسی فولڈر پر یا مطالعے کی فہرست پر جائیں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không thể di chuyển sách trong chế độ xem này. Hãy vào một thư mục trong chế độ xem Thư mục, hoặc vào Danh sách đọc, rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "无法在此视图中移动图书。请前往“文件夹”中的某个文件夹，或前往“阅读列表”，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此顯示方式中無法移動書籍。請前往「檔案夾」中的某個檔案夾或「閱讀列表」，然後再試一次。"
          }
        }
      }
    },
    "manualBookOrder.noArrangedOrder.sorted" : {
      "comment" : "First sentence of the announcement when Move Book Up or Move Book Down is used in a folder that is not in manual order. %@ is the name of the Manual Order sort.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يمكن نقل الكتب فقط في مجلد مرتب حسب %@، وهذا المجلد ليس كذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বই কেবল %@ অনুযায়ী সাজানো ফোল্ডারেই সরানো যায়, আর এই ফোল্ডারটি তেমন নয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bücher lassen sich nur in einem Ordner verschieben, der nach %@ sortiert ist, und dieser Ordner ist es nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Books can be moved only in a folder sorted by %@, and this folder is not."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los libros solo se pueden mover en una carpeta ordenada por %@, y esta no lo está."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب‌ها را فقط در پوشه‌ای می‌توان جابه‌جا کرد که بر اساس %@ مرتب شده باشد، و این پوشه چنین نیست."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les livres ne peuvent être déplacés que dans un dossier trié par %@, et ce dossier ne l’est pas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אפשר להעביר ספרים רק בתיקייה הממוינת לפי %@, והתיקייה הזו אינה כזו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पुस्तकें केवल “%@” के अनुसार क्रमबद्ध फ़ोल्डर में ही ले जाई जा सकती हैं, और यह फ़ोल्डर वैसा नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Buku hanya dapat dipindahkan di folder yang diurutkan menurut %@, dan folder ini tidak demikian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I libri possono essere spostati solo in una cartella ordinata per %@, e questa cartella non lo è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブックを移動できるのは%@で並べ替えたフォルダのみで、このフォルダは該当しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책은 %@ 기준으로 정렬된 폴더에서만 이동할 수 있으며, 이 폴더는 그렇지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Boeken kunnen alleen worden verplaatst in een map die is gesorteerd op %@, en deze map is dat niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Książki można przenosić tylko w folderze posortowanym według: %@, a ten folder nie jest tak posortowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Os livros só podem ser movidos em uma pasta ordenada por %@, e esta não é."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Книги можно перемещать только в папке с сортировкой «%@», а эта папка отсортирована иначе."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Böcker kan bara flyttas i en mapp som är sorterad efter %@, och den här mappen är inte det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ย้ายหนังสือได้เฉพาะในโฟลเดอร์ที่เรียงตาม %@ และโฟลเดอร์นี้ไม่ได้เรียงแบบนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitaplar yalnızca %@ ölçütüne göre sıralanmış bir klasörde taşınabilir ve bu klasör öyle değil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Книги можна переміщувати лише в папці, відсортованій за критерієм «%@», а ця папка так не відсортована."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتابیں صرف %@ کے مطابق ترتیب دیے گئے فولڈر میں منتقل کی جا سکتی ہیں، اور یہ فولڈر ایسا نہیں ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chỉ di chuyển được sách trong thư mục được sắp xếp theo %@, mà thư mục này thì không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "仅当文件夹按 %@ 排序时才能移动图书，而此文件夹并非如此。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
