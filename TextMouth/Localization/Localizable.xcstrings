    "feed.notChecked" : {
      "comment" : "What VoiceOver says when Check Feed is chosen for an unsubscribed feed. The first %@ is the feed's title; the second is the name of the Resubscribe command.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم إلغاء الاشتراك في %1$@، لذا لا يفحصه TextMouth. اختر %2$@ لفحصه مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@-এর সাবস্ক্রিপশন বাতিল করা আছে, তাই TextMouth এটি চেক করে না। আবার চেক করতে %2$@ বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ist abbestellt, daher prüft TextMouth den Feed nicht. Wähle %2$@, um ihn erneut zu prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is unsubscribed, so TextMouth doesn't check it. Choose %@ to check it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ no tiene suscripción, así que TextMouth no lo revisa. Elige %2$@ para volver a revisarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اشتراک %1$@ لغو شده است، پس TextMouth آن را بررسی نمی‌کند. برای بررسی دوباره، %2$@ را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vous êtes désabonné de %1$@, donc TextMouth ne le vérifie pas. Choisissez %2$@ pour le vérifier de nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ההרשמה ל-%1$@ בוטלה, ולכן TextMouth לא בודק אותו. בחר “%2$@” כדי לבדוק אותו שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ की सदस्यता रद्द है, इसलिए TextMouth उसे नहीं जाँचता। उसे फिर से जाँचने के लिए “%2$@” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ tidak lagi dilanggan, jadi TextMouth tidak memeriksanya. Pilih %2$@ untuk memeriksanya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’iscrizione a %1$@ è annullata, quindi TextMouth non lo controlla. Scegli %2$@ per riprendere a controllarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@は購読解除されているため、TextMouth は確認しません。もう一度確認するには%2$@を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@은(는) 구독 해제되어 TextMouth가 확인하지 않습니다. 다시 확인하려면 %2$@을(를) 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ heeft geen abonnement, dus TextMouth controleert de feed niet. Kies %2$@ om de feed opnieuw te controleren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ nie ma subskrypcji, więc TextMouth go nie sprawdza. Aby sprawdzić go ponownie, wybierz %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ está sem assinatura, então o TextMouth não o verifica. Escolha %2$@ para verificá-lo novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@: вы отписались, поэтому TextMouth не проверяет эту ленту. Выберите %2$@, чтобы снова проверять её."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Prenumerationen på %1$@ är avslutad, så TextMouth kontrollerar inte flödet. Välj %2$@ för att kontrollera det igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ เลิกติดตามแล้ว TextMouth จึงไม่ตรวจสอบ เลือก %2$@ เพื่อตรวจสอบอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abonelikten çıkılan besleme (%1$@) TextMouth tarafından denetlenmiyor. Yeniden denetlemek için şunu seçin: %2$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Підписку на %1$@ скасовано, тому TextMouth не перевіряє цю стрічку. Виберіть «%2$@», щоб відновити перевірку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ کی سبسکرپشن منسوخ ہے، اس لیے TextMouth اسے چیک نہیں کرتا۔ اسے دوبارہ چیک کرنے کے لیے %2$@ منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bạn đã hủy đăng ký %1$@ nên TextMouth không kiểm tra nguồn cấp này. Chọn %2$@ để kiểm tra lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 已取消订阅，因此 TextMouth 不会检查它。选取“%2$@”即可再次检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 已取消訂閱，因此 TextMouth 不會檢查它。選擇「%2$@」即可再次檢查。"
          }
        }
      }
    },
