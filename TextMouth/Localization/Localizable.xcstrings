        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gravando. Pare a gravação primeiro."
          }
        }
      }
    },
    "Records a new shortcut." : {
      "comment" : "VoiceOver hint of a keyboard shortcut's key button, and of the add shortcut button, in Settings: the next key pressed becomes the shortcut.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Registra un atajo nuevo."
          }
