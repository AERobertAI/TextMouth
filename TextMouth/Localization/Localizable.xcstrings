        }
      }
    },
    "The transcript from “%@” replaces the book's transcript and the text made from it." : {
      "comment" : "First sentence of the question asked before a transcript from a file replaces an audiobook's transcript. %@ is the file's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تحلّ النسخة النصية من “%@” محل النسخة النصية للكتاب والنص المصنوع منها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript aus „%@“ ersetzt das Transkript des Buchs und den daraus erstellten Text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcripción de “%@” reemplaza la del libro y el texto creado a partir de ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcription de « %@ » remplace la transcription du livre et le texte qui en est tiré."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” की ट्रांसक्रिप्ट पुस्तक की ट्रांसक्रिप्ट और उससे बने टेक्स्ट को बदल देती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
