        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@을(를) 만들 수 없습니다. 이 항목을 담을 폴더 %2$@을(를) 찾을 수 없습니다."
          }
        },
        "pt-BR" : {
