          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sein Text wird durch den neu eingelesenen ersetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its text is replaced by the new reading."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Su texto se reemplaza por la nueva lectura."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "متن آن با متن جدید جایگزین می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Son texte est remplacé par le nouveau texte lu dans le fichier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הטקסט שלו מוחלף בקריאה החדשה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसका टेक्स्ट नई रीडिंग से बदल दिया जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
