            "value" : "The file “%1$@” declares the text encoding “%2$@”, which TextMouth cannot read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo “%1$@” declara la codificación de texto “%2$@”, que TextMouth no puede leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le fichier « %@ » déclare l’encodage de texte « %@ », que TextMouth ne peut pas lire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il file “%@” dichiara la codifica del testo “%@”, che TextMouth non può leggere."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo “%1$@” declara a codificação de texto “%2$@”, que o TextMouth não consegue ler."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл «%1$@» объявляет кодировку текста «%2$@», которую TextMouth не может прочитать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文件“%1$@”声明的文本编码为“%2$@”，TextMouth 无法读取。"
          }
        }
      }
    },
    "The file “%@” in this DAISY book refers to “%@”, outside the book's folder." : {
      "comment" : "First sentence of why a DAISY book kept as loose files could not be imported: one of its files refers to a file outside the book's folder. %1$@ is the referring file's path inside the folder and %2$@ the reference, as the file writes it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Datei „%1$@“ in diesem DAISY-Buch verweist auf „%2$@“ außerhalb des Ordners des Buchs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The file “%1$@” in this DAISY book refers to “%2$@”, outside the book's folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo “%1$@” de este libro DAISY hace referencia a “%2$@”, fuera de la carpeta del libro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le fichier « %@ » de ce livre DAISY fait référence à « %@ », en dehors du dossier du livre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il file “%@” in questo libro DAISY fa riferimento a “%@”, fuori dalla cartella del libro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo “%1$@” deste livro DAISY se refere a “%2$@”, fora da pasta do livro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл «%1$@» в этой книге DAISY ссылается на «%2$@» за пределами папки книги."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此 DAISY 图书中的文件“%1$@”引用了图书文件夹之外的“%2$@”。"
          }
        }
      }
    },
    "The file “%@” in this archive is damaged or incomplete: %@. Get a fresh copy of the archive, then import it again." : {
      "comment" : "Why a ZIP archive or comic book archive (a ZIP of pictures named .cbz) could not be imported: a file inside it is damaged. %1$@ is the file's path inside the archive and %2$@ the reason, a phrase in English that begins with a lowercase letter and has no full stop.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Datei „%1$@“ in diesem Archiv ist beschädigt oder unvollständig: %2$@. Besorge dir eine neue Kopie des Archivs und importiere es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The file “%1$@” in this archive is damaged or incomplete: %2$@. Get a fresh copy of the archive, then import it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo “%1$@” de este archivo comprimido está dañado o incompleto: %2$@. Consigue una copia nueva del archivo comprimido y vuelve a importarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le fichier « %@ » de cette archive est endommagé ou incomplet : %@. Procurez-vous une nouvelle copie de l’archive, puis importez-la à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il file “%@” in questo archivio è danneggiato o incompleto: %@. Procurati una copia nuova dell’archivio, poi importalo di nuovo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo “%1$@” deste arquivo compactado está danificado ou incompleto: %2$@. Obtenha uma cópia nova do arquivo compactado e importe-o novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл «%1$@» в этом архиве повреждён или неполон: %2$@. Получите свежую копию архива и снова импортируйте её."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此归档中的文件“%1$@”已损坏或不完整：%2$@。请获取归档的新副本，然后再次导入。"
          }
        }
      }
    },
    "The file “%@” in this book is damaged or incomplete: %@. Get a fresh copy of the book, then import it again." : {
      "comment" : "Why a book could not be imported (a DAISY book, an EPUB book, or an audiobook): a file inside it is damaged. %1$@ is the file's path inside the book and %2$@ the reason, a phrase in English that begins with a lowercase letter and has no full stop.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Datei „%1$@“ in diesem Buch ist beschädigt oder unvollständig: %2$@. Besorge dir eine neue Kopie des Buchs und importiere es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The file “%1$@” in this book is damaged or incomplete: %2$@. Get a fresh copy of the book, then import it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo “%1$@” de este libro está dañado o incompleto: %2$@. Consigue una copia nueva del libro y vuelve a importarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le fichier « %@ » de ce livre est endommagé ou incomplet : %@. Procurez-vous une nouvelle copie du livre, puis importez-le à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il file “%@” in questo libro è danneggiato o incompleto: %@. Procurati una copia nuova del libro, poi importalo di nuovo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo “%1$@” deste livro está danificado ou incompleto: %2$@. Obtenha uma cópia nova do livro e importe-o novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл «%1$@» в этой книге повреждён или неполон: %2$@. Получите свежую копию книги и снова импортируйте её."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此图书中的文件“%1$@”已损坏或不完整：%2$@。请获取图书的新副本，然后再次导入。"
          }
        }
      }
    },
    "The file “%@” in this document is damaged or incomplete: %@. Get a fresh copy of the document, then import it again." : {
      "comment" : "Why a Word or OpenDocument document could not be imported: a file inside it is damaged. %1$@ is the file's path inside the document and %2$@ the reason, a phrase in English that begins with a lowercase letter and has no full stop.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Datei „%1$@“ in diesem Dokument ist beschädigt oder unvollständig: %2$@. Besorge dir eine neue Kopie des Dokuments und importiere es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The file “%1$@” in this document is damaged or incomplete: %2$@. Get a fresh copy of the document, then import it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo “%1$@” de este documento está dañado o incompleto: %2$@. Consigue una copia nueva del documento y vuelve a importarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le fichier « %@ » de ce document est endommagé ou incomplet : %@. Procurez-vous une nouvelle copie du document, puis importez-le à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il file “%@” in questo documento è danneggiato o incompleto: %@. Procurati una copia nuova del documento, poi importalo di nuovo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo “%1$@” deste documento está danificado ou incompleto: %2$@. Obtenha uma cópia nova do documento e importe-o novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл «%1$@» в этом документе повреждён или неполон: %2$@. Получите свежую копию документа и снова импортируйте его."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此文档中的文件“%1$@”已损坏或不完整：%2$@。请获取文档的新副本，然后再次导入。"
          }
        }
      }
    },
    "The file “%@” is damaged or incomplete: it begins with a %@ byte-order mark, but the rest is not valid %@ text." : {
      "comment" : "First sentence of why a file could not be imported: it begins with the byte-order mark of a Unicode encoding, but the bytes after it are not valid in that encoding. %1$@ is the file's name; %2$@ and %3$@ are both the encoding's standard name, such as UTF-16LE, which stays as it is.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Datei „%1$@“ ist beschädigt oder unvollständig: Sie beginnt mit einer %2$@-Byte-Order-Mark, der Rest ist aber kein gültiger %3$@-Text."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The file “%1$@” is damaged or incomplete: it begins with a %2$@ byte-order mark, but the rest is not valid %3$@ text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo “%1$@” está dañado o incompleto: empieza con una marca de orden de bytes %2$@, pero el resto no es texto %3$@ válido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le fichier « %1$@ » est endommagé ou incomplet : il commence par une marque d’ordre des octets %2$@, mais le reste n’est pas du texte %3$@ valide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il file “%@” è danneggiato o incompleto: inizia con un indicatore dell’ordine dei byte %@, ma il resto non è testo %@ valido."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo “%1$@” está danificado ou incompleto: começa com uma marca de ordem de bytes %2$@, mas o restante não é um texto %3$@ válido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл «%1$@» повреждён или неполон: он начинается с метки порядка байтов %2$@, но остальное не является допустимым текстом %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文件“%1$@”已损坏或不完整：它以 %2$@ 字节顺序标记开头，但其余部分不是有效的 %3$@ 文本。"
          }
        }
      }
    },
    "The file's address isn't a web address TextMouth can open." : {
      "comment" : "Why a feed item's download failed: its address is not an http or https address.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Adresse der Datei ist keine Webadresse, die TextMouth öffnen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La dirección del archivo no es una dirección web que TextMouth pueda abrir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’adresse du fichier n’est pas une adresse web que TextMouth peut ouvrir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’indirizzo del file non è un indirizzo web che TextMouth possa aprire."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O endereço do arquivo não é um endereço da web que o TextMouth possa abrir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Адрес файла — не веб-адрес, который может открыть TextMouth."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Адреса файлу не є вебадресою, яку TextMouth може відкрити."
          }
        }
      }
    },
    "The files of the new copy of “%@” are no longer in the library, so it can't be kept. Choose Cancel, then import the file again." : {
      "comment" : "What the duplicate question says when the new copy's files are gone while the question waited. %@ is the new copy's title. \"Cancel\" is the sheet's Cancel button.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Dateien der neuen Kopie von „%@“ sind nicht mehr in der Bibliothek, daher kann sie nicht behalten werden. Wähle „Abbrechen“ und importiere die Datei dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los archivos de la copia nueva de “%@” ya no están en la biblioteca, así que no se puede conservar. Elige Cancelar y luego importa el archivo otra vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les fichiers de la nouvelle copie de « %@ » ne sont plus dans la bibliothèque, donc elle ne peut pas être conservée. Choisissez Annuler, puis importez de nouveau le fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I file della nuova copia di “%@” non sono più nella libreria, quindi non può essere conservata. Scegli Annulla, poi importa di nuovo il file."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Os arquivos da nova cópia de “%@” não estão mais na biblioteca, então ela não pode ser mantida. Escolha Cancelar e depois importe o arquivo novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файлов новой копии «%@» больше нет в библиотеке, поэтому её нельзя сохранить. Выберите «Отменить», затем снова импортируйте файл."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файлів нової копії «%@» більше немає в бібліотеці, тож її не можна зберегти. Виберіть «Скасувати», а потім імпортуйте файл знову."
          }
        }
      }
    },
    "The files that couldn't be read are listed." : {
      "comment" : "Sentence of the results of Compare Libraries saying the unread files are listed below.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Dateien, die nicht gelesen werden konnten, sind aufgelistet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se enumeran los archivos que no se pudieron leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les fichiers qui n’ont pas pu être lus sont listés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I file che non è stato possibile leggere sono elencati."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Os arquivos que não puderam ser lidos estão listados."
          }
        },
        "ru" : {
          "stringUnit" : {
