            "value" : "TextMouth 无法使用这台 Mac 的表“%1$@”：%2$@。"
          }
        }
      }
    },
    "TextMouth cannot open copy-protected files." : {
      "comment" : "Advice after the refusal of audio that is locked to a store's own player, such as Audible's .aa and .aax files.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kann kopiergeschützte Dateien nicht öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede abrir archivos con protección contra copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ne peut pas ouvrir les fichiers protégés contre la copie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth कॉपी-सुरक्षित फ़ाइलें नहीं खोल सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tidak dapat membuka file yang dilindungi hak cipta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non può aprire file protetti da copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は、コピー保護されたファイルを開けません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth는 복사 방지된 파일을 열 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não consegue abrir arquivos protegidos contra cópia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не открывает файлы с защитой от копирования."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не може відкривати файли із захистом від копіювання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 无法打开受拷贝保护的文件。"
          }
        }
      }
    },
    "TextMouth closed while opening %@, so it wasn't reopened." : {
      "comment" : "Announced at launch after the app closed while it was opening a book. %@ is the book's title, which is not opened again.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth wurde beim Öffnen von %@ beendet und öffnete es daher nicht erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth se cerró al abrir %@, así que no se volvió a abrir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth s’est fermé pendant l’ouverture de %@ ; ce livre n’a donc pas été rouvert."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ खोलते समय TextMouth बंद हो गया, इसलिए उसे दोबारा नहीं खोला गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tertutup saat membuka %@, jadi buku tidak dibuka lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth si è chiuso durante l’apertura di %@, quindi non è stato riaperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は%@を開いている間に終了したため、再び開きませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 %@을(를) 여는 중에 종료되어 다시 열지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth fechou ao abrir %@, então ele não foi reaberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth закрылся при открытии книги «%@», поэтому не открывает её снова."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth закрився під час відкриття %@, тому книгу не відкрито знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 在打开 %@ 时关闭，因此未重新打开。"
          }
        }
      }
    },
    "TextMouth could not check this Mac's braille table “%@”: %@. Try again." : {
