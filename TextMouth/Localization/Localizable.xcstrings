    "feedFetchError.downloadMessage.serverError" : {
      "comment" : "Why a feed item's download failed: the server answered with an error. The first %@ is the server's host name; the second is the error's number, an identifier written without digit grouping, such as 503.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يتمكن %1$@ من إرسال الملف (الخطأ %2$@). حاول مرة أخرى لاحقًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ফাইলটি পাঠাতে পারেনি (ত্রুটি %2$@)। পরে আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ konnte die Datei nicht senden (Fehler %2$@). Versuche es später erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ couldn't send the file (error %@). Try again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ no pudo enviar el archivo (error %2$@). Inténtalo de nuevo más tarde."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ فایل را ارسال نکرد (خطای %2$@). بعداً دوباره تلاش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ n’a pas pu envoyer le fichier (erreur %2$@). Réessayez plus tard."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ לא הצליח לשלוח את הקובץ (שגיאה %2$@). נסה שוב מאוחר יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ फ़ाइल नहीं भेज सका (त्रुटि %2$@)। बाद में फिर से प्रयास करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ tidak dapat mengirim file (kesalahan %2$@). Coba lagi nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ non ha inviato il file (errore %2$@). Riprova più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@がファイルを送信できませんでした（エラー%2$@）。後でもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@에서 파일을 보내지 못했습니다(오류 %2$@). 나중에 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
