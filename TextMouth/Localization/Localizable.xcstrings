            "value" : "TextMouth दूसरी लाइब्रेरी पर फिर से खुल रहा है, इसलिए वे इसमें जहाँ हैं वहीं रहती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth akan terbuka lagi pada pustaka lain, jadi semuanya tetap di tempatnya di pustaka ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth si sta riaprendo su un’altra libreria, quindi restano dove sono in questa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は別のライブラリで開き直すため、それらはこのライブラリでは元の場所にあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
