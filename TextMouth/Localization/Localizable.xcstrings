    "miscellaneousSettings.disconnectDelayExplanation" : {
      "comment" : "Explanation under the Bluetooth disconnect delay slider in the Miscellaneous settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "المدة التي تُحجب فيها أوامر الوسائط بعد قطع اتصال جهاز Bluetooth. ارفعها إذا استؤنف التشغيل بعد إزالة سماعات الرأس."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth ডিভাইস বিচ্ছিন্ন হওয়ার পর কতক্ষণ মিডিয়া কমান্ড আটকে থাকে। হেডফোন খুলে নেওয়ার পর প্লেব্যাক আবার শুরু হলে এটি বাড়ান।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wie lange Medienbefehle blockiert werden, nachdem ein Bluetooth-Gerät getrennt wurde. Erhöhe den Wert, wenn die Wiedergabe nach dem Abnehmen der Kopfhörer fortgesetzt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How long media commands are blocked after a Bluetooth device disconnects. Raise it if playback resumes after removing headphones."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cuánto tiempo se bloquean las órdenes multimedia después de que se desconecta un dispositivo Bluetooth. Auméntalo si la reproducción se reanuda al quitarte los auriculares."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مدت مسدود بودن فرمان‌های رسانه پس از قطع اتصال یک دستگاه Bluetooth. اگر پس از برداشتن هدفون پخش دوباره شروع می‌شود، آن را افزایش دهید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Durée pendant laquelle les commandes multimédias sont bloquées après la déconnexion d’un appareil Bluetooth. Augmentez-la si la lecture reprend après le retrait des écouteurs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "משך הזמן שבו פקודות מדיה חסומות אחרי שהתקן Bluetooth מתנתק. הגדל אותו אם הניגון מתחדש אחרי הסרת אוזניות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth डिवाइस डिस्कनेक्ट होने के बाद मीडिया कमांड कितनी देर तक रोके जाते हैं। यदि हेडफ़ोन हटाने के बाद प्लेबैक फिर शुरू हो जाए तो इसे बढ़ाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Berapa lama perintah media diblokir setelah perangkat Bluetooth terputus. Naikkan jika pemutaran berlanjut setelah headphone dilepas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Per quanto tempo i comandi multimediali restano bloccati dopo la disconnessione di un dispositivo Bluetooth. Aumentalo se la riproduzione riprende dopo aver tolto le cuffie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth デバイスの接続が切れたあと、メディアコマンドをブロックする時間です。ヘッドフォンを外したあとに再生が再開する場合は、大きくしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth 기기의 연결이 해제된 후 미디어 명령을 차단하는 시간입니다. 헤드폰을 뺀 후 재생이 다시 시작되면 값을 높이십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hoelang mediacommando's worden geblokkeerd nadat een Bluetooth-apparaat is losgekoppeld. Verhoog dit als het afspelen hervat nadat je de koptelefoon hebt afgedaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jak długo polecenia multimediów są blokowane po odłączeniu urządzenia Bluetooth. Zwiększ tę wartość, jeśli odtwarzanie wznawia się po wyjęciu słuchawek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Por quanto tempo os comandos de mídia ficam bloqueados depois que um dispositivo Bluetooth se desconecta. Aumente se a reprodução continuar ao remover os fones."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Как долго медиакоманды блокируются после отключения устройства Bluetooth. Увеличьте значение, если воспроизведение возобновляется после снятия наушников."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hur länge mediakommandon blockeras efter att en Bluetooth-enhet kopplats från. Höj värdet om uppspelningen återupptas när du tar bort hörlurarna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ระยะเวลาที่บล็อกคำสั่งสื่อหลังอุปกรณ์ Bluetooth ตัดการเชื่อมต่อ เพิ่มค่านี้หากการเล่นกลับมาหลังถอดหูฟัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bir Bluetooth aygıtının bağlantısı kesildikten sonra medya komutlarının ne kadar süre engelleneceği. Kulaklıkları çıkardıktan sonra oynatma devam ediyorsa artırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Як довго медіакоманди блокуються після відключення пристрою Bluetooth. Збільшіть значення, якщо відтворення продовжується після зняття навушників."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth ڈیوائس منقطع ہونے کے بعد میڈیا کمانڈز کتنی دیر بلاک رہتی ہیں۔ اگر ہیڈ فون ہٹانے کے بعد پلے بیک دوبارہ شروع ہو جائے تو اسے بڑھائیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thời gian các lệnh phương tiện bị chặn sau khi thiết bị Bluetooth ngắt kết nối. Hãy tăng giá trị này nếu phát lại tiếp tục sau khi tháo tai nghe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "断开 Bluetooth 设备后阻止媒体命令的时长。如果移除耳机后仍会恢复播放，请调大此值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth 裝置中斷連線後，媒體指令被封鎖的時間。如果取下耳機後播放又繼續，請調高此值。"
          }
        }
      }
    },
