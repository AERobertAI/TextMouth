          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no pudo volver a leer “%@”, así que dejó el libro como estaba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth n’a pas pu relire « %@ », donc il a laissé le livre tel quel."
          }
        },
        "hi" : {
          "stringUnit" : {
