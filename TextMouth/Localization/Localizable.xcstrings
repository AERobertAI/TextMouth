        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "एक ऑडियोबुक चुनें, फिर “ऑडियो ट्रांसक्राइब करें” दोबारा चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
