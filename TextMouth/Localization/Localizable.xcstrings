    "fileImportError.unsupportedFormat.transcript" : {
      "comment" : "Advice after the refusal of a transcript file chosen as a book. %@ is the file's extension without its dot. \"Attach Transcript…\" is a command of the Book menu: keep its name the same as that command's and the menu's.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ملف .%@ هو نسخة نصية وليس كتابًا. لاستخدامه، استورد صوته، وافتح الكتاب، ثم اختر “إرفاق نسخة نصية…” من قائمة الكتاب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : ".%@ ফাইল একটি ট্রান্সক্রিপ্ট, বই নয়। এটি ব্যবহার করতে এর অডিও আমদানি করুন, বইটি খুলুন এবং বই মেনু থেকে “ট্রান্সক্রিপ্ট সংযুক্ত করুন…” বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eine .%@-Datei ist ein Transkript, kein Buch. Importiere dazu das Audio, öffne das Buch und wähle im Menü „Buch“ den Befehl „Transkript anhängen…“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A .%@ file is a transcript, not a book. To use it, import its audio, open the book, and choose Attach Transcript… from the Book menu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un archivo .%@ es una transcripción, no un libro. Para usarlo, importa su audio, abre el libro y elige Adjuntar transcripción… en el menú Libro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فایل .%@ رونوشت است، نه کتاب. برای استفاده از آن، صدایش را وارد کنید، کتاب را باز کنید و از منوی کتاب «پیوست رونوشت…» را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un fichier .%@ est une transcription, pas un livre. Pour l’utiliser, importez son audio, ouvrez le livre, puis choisissez Joindre la transcription… dans le menu Livre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "קובץ .%@ הוא תמליל, לא ספר. כדי להשתמש בו, ייבא את השמע שלו, פתח את הספר ובחר “צרף תמליל…” בתפריט “ספר”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : ".%@ फ़ाइल एक ट्रांसक्रिप्ट है, पुस्तक नहीं। इसका उपयोग करने के लिए इसका ऑडियो आयात करें, पुस्तक खोलें, और पुस्तक मेनू से “ट्रांसक्रिप्ट संलग्न करें…” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "File .%@ adalah transkrip, bukan buku. Untuk memakainya, impor audionya, buka bukunya, lalu pilih Lampirkan Transkrip… dari menu Buku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un file .%@ è una trascrizione, non un libro. Per usarlo, importa il suo audio, apri il libro e scegli Allega trascrizione… dal menu Libro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : ".%@ファイルはブックではなく文字起こしです。使用するには、そのオーディオを読み込み、ブックを開いて、「ブック」メニューの「文字起こしを添付…」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "확장자가 .%@인 파일은 대본이며 책이 아닙니다. 사용하려면 오디오를 가져오고 책을 연 다음 책 메뉴에서 “대본 첨부…” 항목을 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Een .%@-bestand is een transcriptie, geen boek. Om het te gebruiken, importeer je de audio, open je het boek en kies je Voeg transcriptie bij… in het menu Boek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Plik .%@ to transkrypcja, a nie książka. Aby go użyć, zaimportuj jej dźwięk, otwórz książkę i wybierz Dołącz transkrypcję… z menu Książka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um arquivo .%@ é uma transcrição, não um livro. Para usá-lo, importe o áudio, abra o livro e escolha Anexar transcrição… no menu Livro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл .%@ — это расшифровка, а не книга. Чтобы использовать его, импортируйте его аудио, откройте книгу и выберите «Прикрепить расшифровку…» в меню «Книга»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En .%@-fil är en transkription, inte en bok. Om du vill använda den importerar du dess ljud, öppnar boken och väljer Bifoga transkription… i menyn Bok."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไฟล์ .%@ เป็นข้อความถอดเสียง ไม่ใช่หนังสือ หากต้องการใช้ ให้นำเข้าไฟล์เสียงของไฟล์นั้น เปิดหนังสือ แล้วเลือก แนบข้อความถอดเสียง… จากเมนูหนังสือ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bir .%@ dosyası kitap değil, transkripttir. Kullanmak için sesini içe aktarın, kitabı açın ve Kitap menüsünden Transkript Ekle… komutunu seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл .%@ — це транскрипція, а не книга. Щоб ним скористатися, імпортуйте його аудіо, відкрийте книгу й виберіть «Прикріпити транскрипцію…» у меню «Книга»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ایکسٹینشن والی فائل ٹرانسکرپٹ ہے، کتاب نہیں۔ اسے استعمال کرنے کے لیے اس کا آڈیو درآمد کریں، کتاب کھولیں، اور کتاب مینو سے “ٹرانسکرپٹ منسلک کریں…” منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tệp .%@ là bản chép lời, không phải sách. Để dùng nó, hãy nhập âm thanh của sách, mở sách, rồi chọn Đính kèm bản chép lời… từ menu Sách."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : ".%@ 文件是文字稿，不是图书。要使用它，请导入其音频，打开该图书，然后从“图书”菜单中选取“附加文字稿…”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「.%@」檔案是逐字稿，不是書籍。若要使用，請輸入其音訊、打開該書籍，然後從「書籍」選單選擇「附加逐字稿…」。"
          }
        }
      }
    },
    "fileImportError.unsupportedXML" : {
      "comment" : "Why an XML file was refused at import: its root element is not one of the three kinds TextMouth reads. DTBook, Word 2003 XML, and PEF are format names.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ملف XML هذا ليس كتاب DTBook ولا مستند Word 2003 XML ولا ملف برايل PEF، وهي الأنواع الوحيدة من XML التي يقرؤها TextMouth."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই XML ফাইলটি DTBook বই, Word 2003 XML নথি বা PEF ব্রেইল ফাইল নয়; TextMouth শুধু এই ধরনের XML পড়ে।"
