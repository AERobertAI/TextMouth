    },
    "The book is open, so its download can't be removed. Close it first." : {
      "comment" : "Why Remove Download was refused: the book is open in a reader.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El libro está abierto, así que no se puede quitar su descarga. Ciérralo primero."
          }
        }
      }
    },
    "The book left the library during transcription, so its transcript wasn't saved." : {
      "comment" : "Error shown when the book was removed from the library during a transcription.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El libro salió de la biblioteca durante la transcripción, así que su transcripción no se guardó."
          }
