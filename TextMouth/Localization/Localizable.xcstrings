        "ru" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Но в %@ есть ещё %lld книги, добавленные более новой версией TextMouth: они остаются на месте, как и каждая папка, в которой лежит хотя бы одна из них."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Но в %@ есть ещё %lld книг, добавленных более новой версией TextMouth: они остаются на месте, как и каждая папка, в которой лежит хотя бы одна из них."
                }
