    "Continues the paused recording." : {
      "comment" : "VoiceOver hint of the Resume button in the Record window."
    },
    "Control" : {
      "comment" : "Name of the Control modifier key, spoken or brailled in a keyboard shortcut such as \"Control + Shift + R\"."
    },
    "Copy" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Copies the selected audio.\nName of the Edit menu's Copy command, in a sentence saying why a keyboard shortcut cannot take its key."
    },
    "Copy Reading Position" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Playback group and read by VoiceOver. Copies a link to the current reading position. Also the title of the menu command of the same name."
    },
    "Could not add the bookmark: “%@” is no longer in the library." : {
      "comment" : "VoiceOver announcement when a bookmark could not be added because the book left the library while its reader was open. %@ is the book's title, in quotation marks.",
      "localizations" : {
