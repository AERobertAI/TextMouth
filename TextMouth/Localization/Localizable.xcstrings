    "feed.itemRowHint.again" : {
      "comment" : "VoiceOver hint of a feed item's row whose place was kept after its file was deleted: its default action downloads it again and opens it at the place kept.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ينزّله مجددًا، ثم يفتحه من حيث توقفت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আবার ডাউনলোড করে, তারপর যেখানে থেমেছিলেন সেখান থেকে খোলে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lädt es erneut herunter und öffnet es an der gemerkten Stelle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads it again, then opens it where you left off"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lo descarga de nuevo y lo abre donde lo dejaste"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آن را دوباره بارگیری می‌کند، سپس از جایی که مانده بودید باز می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Télécharge de nouveau l’élément, puis l’ouvre là où vous vous étiez arrêté."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מוריד אותו שוב, ואז פותח אותו במקום שבו הפסקת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "उसे फिर से डाउनलोड करता है, फिर वहीं खोलता है जहाँ आपने छोड़ा था।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mengunduhnya lagi, lalu membukanya di tempat Anda berhenti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lo scarica di nuovo, poi lo apre dal punto in cui eri rimasto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "もう一度ダウンロードしてから、前回の続きの位置で開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "다시 다운로드한 다음 중단한 위치에서 엽니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Downloadt het opnieuw en opent het dan waar je was gebleven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pobiera go ponownie, a potem otwiera w zapamiętanym miejscu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Baixa novamente e abre de onde você parou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Загружает снова, затем открывает там, где вы остановились."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hämtar det igen och öppnar det sedan där du slutade."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ดาวน์โหลดอีกครั้ง แล้วเปิดต่อจากที่คุณค้างไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yeniden indirir, sonra kaldığınız yerden açar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Завантажує знову, а потім відкриває там, де ви зупинилися."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اسے دوبارہ ڈاؤن لوڈ کرتا ہے، پھر وہیں سے کھولتا ہے جہاں آپ نے چھوڑا تھا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tải về lại, rồi mở nó ở chỗ bạn đã dừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "再次下载，然后从你上次停下的位置打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "再次下載，然後在你上次離開的位置打開。"
          }
        }
      }
    },
