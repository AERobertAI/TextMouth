    "textEncoding.editNotKeptRefusal" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. Why the book titled bookTitle was not read again: the text changed with Edit Text could not be kept beside the new reading, so nothing was replaced, as Replace Existing leaves both copies then (DuplicateReplacement.TextNotKept). Placeholders in order: bookTitle.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يتمكن TextMouth من الاحتفاظ بالنص الذي غيّرته في “%@” بجوار القراءة الجديدة، فترك الكتاب كما كان."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth “%@”-এ আপনার বদলানো টেক্সট নতুন করে পড়া টেক্সটের পাশে রাখতে পারেনি, তাই বইটি যেমন ছিল তেমনই রেখেছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth konnte den von dir geänderten Text in „%@“ nicht neben dem neu eingelesenen Text erhalten und hat das Buch unverändert gelassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth couldn't keep the text you changed in “%@” beside the new reading, so it left the book as it was."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no pudo conservar el texto que cambiaste en “%@” junto a la nueva lectura, así que dejó el libro como estaba."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth نتوانست متنی را که در «%@» تغییر داده بودید کنار متن جدید نگه دارد، بنابراین کتاب را همان‌طور که بود گذاشت."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth n’a pas pu conserver le texte que vous avez modifié dans « %@ » à côté du nouveau texte, donc il a laissé le livre tel quel."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth לא הצליח לשמור את הטקסט ששונה ב-“%@” לצד הקריאה החדשה, ולכן השאיר את הספר כפי שהיה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth “%@” में आपके बदले हुए टेक्स्ट को नई रीडिंग के बगल में नहीं रख सका, इसलिए उसने पुस्तक जैसी थी वैसी ही छोड़ दी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tidak dapat menyimpan teks yang Anda ubah di “%@” di samping pembacaan baru, jadi buku dibiarkan seperti semula."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non è riuscito a conservare il testo che hai modificato in “%@” accanto alla nuova lettura, quindi ha lasciato il libro com’era."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は、「%@」で変更したテキストを新しい読み込み結果とは別に残せなかったため、ブックをそのままにしました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 “%@”에서 수정한 텍스트를 새로 읽은 결과 옆에 유지하지 못해 책을 그대로 두었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kon de tekst die je in “%@” hebt gewijzigd niet naast de nieuwe versie bewaren, dus blijft het boek zoals het was."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth nie mógł zachować zmienionego przez Ciebie tekstu w „%@” obok nowego odczytu, więc pozostawił książkę bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não conseguiu manter o texto que você alterou em “%@” ao lado da nova leitura, então deixou o livro como estava."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не удалось сохранить изменённый вами текст в «%@» рядом с результатом повторного чтения, поэтому книга оставлена как была."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kunde inte behålla texten du ändrade i ”%@” bredvid den nya läsningen, så boken lämnades som den var."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth เก็บข้อความที่คุณเปลี่ยนไว้ใน “%@” คู่กับข้อความที่อ่านได้ใหม่ไม่ได้ จึงปล่อยหนังสือไว้ตามเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth, “%@” içinde değiştirdiğiniz metni yeniden okunan metnin yanında saklayamadı, bu yüzden kitabı olduğu gibi bıraktı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не вдалося зберегти текст, який ви змінили в «%@», поряд із заново прочитаним текстом, тому книгу залишено без змін."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth “%@” میں آپ کا تبدیل کیا ہوا متن نئی ریڈنگ کے ساتھ نہیں رکھ سکا، اس لیے اس نے کتاب جیسی تھی ویسی ہی رہنے دی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth không thể giữ văn bản bạn đã thay đổi trong “%@” bên cạnh kết quả đọc lại, nên đã để nguyên cuốn sách."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 无法将你在“%@”中更改的文本保留在新的阅读内容旁，因此图书保持原样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 無法將你在「%@」中更改的文字與新的讀取結果一併保留，因此書籍維持原樣。"
          }
        }
      }
    },
    "textEncoding.exportingRefusal" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. Why the book titled bookTitle can't be read again while it is being exported, with what to do, as a refusal for a book in use says it (FeedBookUse.exporting): \"“Ledger” is being exported. Wait until the export ends, then try again.\". Placeholders in order: bookTitle, FeedBookUse.exporting.remedy, FeedBookUse.tryAgain.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” قيد التصدير. %2$@، ثم %3$@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” রপ্তানি করা হচ্ছে। %2$@, তারপর %3$@।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%1$@“ wird gerade exportiert. %2$@, dann %3$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is being exported. %@, then %@."
          }
        },
        "es" : {
