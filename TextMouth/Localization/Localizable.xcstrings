    "importDecision.keepsAudioOverTranscript" : {
      "comment" : "Part of the question asked about a duplicate audiobook whose new copy came with a transcript file beside its audio: Replace Existing keeps the library copy's own transcript over that file. \"The existing copy\" is the library's copy. A sentence about what is not kept follows.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحتفظ الاستبدال بموضع قراءة النسخة الموجودة وإشاراتها المرجعية وإعداداتها ومجلدها ومكانها في قائمة القراءة، وبنسختها النصية عندما يكون الصوت نفسه، بدلًا من ملف النسخة النصية الموجود بجوار صوت النسخة الجديدة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "প্রতিস্থাপন করলে বিদ্যমান কপির পড়ার অবস্থান, বুকমার্ক, সেটিংস, ফোল্ডার ও পড়ার তালিকায় জায়গা রাখা হয়, এবং অডিও একই হলে এর ট্রান্সক্রিপ্টও, নতুন কপির অডিওর পাশে পাওয়া ট্রান্সক্রিপ্ট ফাইলের বদলে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beim Ersetzen bleiben Leseposition, Lesezeichen, Einstellungen, Ordner und Platz auf der Leseliste der vorhandenen Kopie erhalten, dazu ihr Transkript, wenn das Audio dasselbe ist, statt der Transkriptdatei neben dem Audio der neuen Kopie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replacing keeps the existing copy's reading position, bookmarks, settings, folder, and place on the reading list, and its transcript when the audio is the same, rather than the transcript file found beside the new copy's audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Al reemplazar, se conservan la posición de lectura, los marcadores, los ajustes, la carpeta y el lugar en la lista de lectura de la copia existente, y su transcripción cuando el audio es el mismo, en lugar de la transcripción que se encontró junto al audio de la copia nueva."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جایگزینی موقعیت مطالعه، نشانک‌ها، تنظیمات، پوشه و جایگاه نسخه‌ی موجود در فهرست مطالعه را نگه می‌دارد و اگر صدا یکسان باشد، رونوشت آن را هم به جای فایل رونوشتی که کنار صدای نسخه‌ی جدید پیدا شده است نگه می‌دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le remplacement conserve la position de lecture, les signets, les réglages, le dossier et la place dans la liste de lecture de la copie existante, ainsi que sa transcription lorsque l’audio est le même, plutôt que le fichier de transcription trouvé à côté de l’audio de la nouvelle copie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ההחלפה שומרת את מיקום הקריאה, הסימניות, ההגדרות, התיקייה והמקום ברשימת הקריאה של העותק הקיים, ואת התמליל שלו כשהשמע זהה, ולא את קובץ התמליל שנמצא לצד השמע של העותק החדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "बदलने पर मौजूदा प्रति की पठन स्थिति, बुकमार्क, सेटिंग, फ़ोल्डर और रीडिंग लिस्ट में उसकी जगह रखी जाती है, और ऑडियो वही होने पर उसकी ट्रांसक्रिप्ट भी, न कि नई प्रति के ऑडियो के बगल में मिली ट्रांसक्रिप्ट फ़ाइल।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Penggantian mempertahankan posisi baca, markah, pengaturan, folder, dan posisi salinan yang ada di Daftar Bacaan, serta transkripnya bila audionya sama, bukan file transkrip yang ada di samping audio salinan baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La sostituzione conserva la posizione di lettura, i segnalibri, le impostazioni, la cartella e la posizione nell’elenco di lettura della copia esistente, e la sua trascrizione quando l’audio è lo stesso, anziché il file di trascrizione trovato accanto all’audio della nuova copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "置き換えても、既存のコピーの読み上げ位置、ブックマーク、設定、フォルダ、リーディングリストでの位置は保持されます。オーディオが同じ場合は、新しいコピーのオーディオの横にある文字起こしファイルではなく、既存の文字起こしが保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "대체하면 기존 사본의 읽기 위치, 북마크, 설정, 폴더, 읽기 목록 위치가 유지되며, 오디오가 같으면 새 사본의 오디오 옆에 있는 대본 파일 대신 기존 사본의 대본이 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bij vervangen blijven de leespositie, bladwijzers, instellingen, map en plaats op de leeslijst van de bestaande kopie behouden, evenals de transcriptie wanneer de audio dezelfde is, in plaats van het transcriptiebestand naast de audio van de nieuwe kopie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zastąpienie zachowuje pozycję czytania, zakładki, ustawienia, folder i miejsce na liście czytelniczej istniejącej kopii oraz jej transkrypcję, gdy dźwięk jest taki sam, a nie plik transkrypcji znaleziony obok dźwięku nowej kopii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Substituir mantém a posição de leitura, os marcadores, os ajustes, a pasta e o lugar da cópia existente na lista de leitura, e a transcrição dela quando o áudio é o mesmo, em vez do arquivo de transcrição encontrado ao lado do áudio da nova cópia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "При замене сохраняются позиция чтения, закладки, настройки, папка и место существующей копии в списке для чтения, а также её расшифровка, если аудио то же, а не файл расшифровки, найденный рядом с аудио новой копии."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vid ersättning behålls den befintliga kopians läsposition, bokmärken, inställningar, mapp och plats i läslistan, samt dess transkription när ljudet är detsamma, i stället för transkriptionsfilen som hittades bredvid den nya kopians ljud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "การแทนที่จะเก็บตำแหน่งการอ่าน ที่คั่นหน้า การตั้งค่า โฟลเดอร์ และตำแหน่งในรายการอ่านของสำเนาที่มีอยู่ รวมถึงข้อความถอดเสียงเมื่อเสียงเป็นไฟล์เดียวกัน แทนที่จะใช้ไฟล์ข้อความถอดเสียงที่พบข้างเสียงของสำเนาใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Değiştirmek, mevcut kopyanın okuma konumunu, yer imlerini, ayarlarını, klasörünü ve Okuma Listesindeki yerini, ses aynıysa transkriptini de korur; yeni kopyanın sesinin yanında bulunan transkript dosyasını değil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Заміна зберігає позицію читання, закладки, налаштування, папку та місце у списку читання наявної копії, а також її транскрипцію, якщо аудіо те саме, а не файл транскрипції поруч з аудіо нової копії."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تبدیل کرنے سے موجودہ کاپی کی مطالعے کی پوزیشن، بک مارکس، ترتیبات، فولڈر اور مطالعے کی فہرست میں جگہ برقرار رہتی ہے، اور جب آڈیو وہی ہو تو اس کا ٹرانسکرپٹ بھی، نہ کہ وہ ٹرانسکرپٹ فائل جو نئی کاپی کے آڈیو کے پاس ملی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Việc thay thế giữ lại vị trí đọc, dấu trang, cài đặt, thư mục và vị trí trong danh sách đọc của bản hiện có, cùng bản chép lời của nó khi âm thanh giống nhau, thay vì tệp bản chép lời nằm cạnh âm thanh của bản sao mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "替换会保留现有副本的阅读位置、书签、设置、文件夹以及在阅读列表中的位置；当音频相同时，还会保留其文字稿，而不使用新副本音频旁找到的文字稿文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "取代時會保留現有副本的閱讀位置、書籤、設定、檔案夾和在閱讀列表中的位置，且在音訊相同時也會保留其逐字稿，而不是新副本音訊旁找到的逐字稿檔案。"
          }
        }
      }
    },
    "importDecision.replacedCopySentence.permanently" : {
      "comment" : "Part of the question asked about a duplicate book: where the library's copy goes when replaced and files are deleted permanently.",
      "extractionState" : "manual",
      "localizations" : {
