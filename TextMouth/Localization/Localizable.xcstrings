    "feed.deletesSentence.them" : {
      "comment" : "A sentence of the confirmation before Delete Feed, when files go to the Trash: what the feed deletes, several things. %@ is a list of what is deleted.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحذف %@: تنتقل إلى سلة المهملات، حيث يمكنك استرجاعها إلى أن تُفرَّغ السلة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এটি %@ মুছে ফেলে: সেগুলো ট্র্যাশে যায়, ট্র্যাশ খালি না করা পর্যন্ত সেখান থেকে ফিরিয়ে আনা যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gelöscht werden %@: Sie landen im Papierkorb, wo du sie wiederherstellen kannst, bis er geleert wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It deletes %@: they go to the Trash, where you can recover them until the Trash is emptied."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elimina %@: se mueven a la Papelera, donde se pueden recuperar hasta que la vacíes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ را حذف می‌کند: به سطل زباله می‌روند و تا خالی شدن سطل می‌توانید آن‌ها را بازیابی کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cela supprime %@ : ils sont placés dans la corbeille, où vous pouvez les récupérer jusqu’à ce que la corbeille soit vidée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הפעולה מוחקת: %@. הקבצים עוברים לאשפה, ואפשר לשחזר אותם משם עד לריקון האשפה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "यह %@ मिटाता है: वे ट्रैश में जाते हैं, जहाँ से आप उन्हें ट्रैश खाली होने तक वापस पा सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ini menghapus %@: semuanya dipindahkan ke Tempat Sampah, tempat Anda dapat memulihkannya sampai Tempat Sampah dikosongkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elimina %@: vanno nel Cestino, da cui puoi recuperarli finché non lo svuoti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@を削除します。ゴミ箱に移動され、ゴミ箱を空にするまで復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@을(를) 삭제합니다. 휴지통으로 이동하며, 휴지통을 비우기 전에는 복구할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Het verwijdert %@: ze gaan naar de prullenmand, waar je ze kunt terughalen tot de prullenmand wordt geleegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usuwa %@: trafiają do kosza, skąd można je odzyskać, dopóki kosz nie zostanie opróżniony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ele exclui %@: vão para a Lixeira, onde você pode recuperá-los até esvaziá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Удаляются %@: они перемещаются в Корзину, откуда их можно восстановить, пока Корзина не очищена."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Det raderar %@: de flyttas till papperskorgen, där du kan återställa dem tills papperskorgen töms."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "จะลบ %@: ย้ายไปที่ถังขยะ ซึ่งคุณกู้คืนได้จนกว่าจะล้างถังขยะ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Şunları siler: %@. Çöp Sepetine gider; Çöp Sepeti boşaltılana kadar geri alabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Буде видалено: %@; вони потраплять до Кошика, де їх можна відновити, доки Кошик не очищено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یہ %@ کو حذف کرتا ہے: وہ ٹریش میں جاتے ہیں، جہاں ٹریش خالی ہونے تک آپ انہیں بحال کر سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thao tác này xóa %@: chúng được chuyển vào Thùng rác, nơi bạn có thể khôi phục cho đến khi dọn sạch Thùng rác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "这会删除%@：它们会移到废纸篓，在清倒废纸篓之前你可以将其恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "這會刪除%@：這些項目會移到垃圾桶，在清空垃圾桶前你都可以復原。"
          }
        }
      }
    },
