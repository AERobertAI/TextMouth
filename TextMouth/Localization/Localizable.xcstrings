    },
    "Nothing checks that this is the right choice. If numbers and punctuation sound wrong, choose another." : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. What the alert says first of a choice between two seven-bit codes: nothing can tell whether it is right, since every printable ASCII byte is a cell in every seven-bit code, so a wrong one reads with no error (research of October 25, section 8.3)."
    },
    "Nothing could be compared with the copy in %@, because a file the comparison needs couldn't be read." : {
      "comment" : "First sentence of the results of Compare Libraries when the other copy's library index could not be read. %@ is the other copy's folder path."
    },
    "Nothing is changed." : {
      "comment" : "Last sentence of what the Compare Libraries sheet says while it works: the comparison changes nothing in either copy."
    },
    "Nothing is selected." : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. What a press of Speak Info, or of Return (Open Selected Book), says when no row is selected."
    },
    "Nothing matches this view now." : {
      "comment" : "Text of the Library window's View pop-up and Go to View. The row a view shows while it lists nothing at all: the Feeds view, a view the listener made, and any view without a Books section (LibraryView.showsEmptySentence)."
    },
    "Nothing was changed." : {
      "comment" : "Last sentence of a message that says saving failed: nothing the user edited was saved anywhere.\nLast sentence of a refusal to read a book again: the book and its text are as they were."
    },
    "Nothing was recorded, so there is nothing to save." : {
      "comment" : "Error in the Record window when the recording was stopped before any audio was captured."
    },
    "Number Sign" : {
      "comment" : "Name of the punctuation key \"#\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Number Sign\"."
    },
    "OK" : {
      "comment" : "Button that dismisses an alert about a problem.\nButton that dismisses the reader's error alert.\nTitle of the button that dismisses the alert telling the result of importing or exporting pronunciation rules."
    },
    "Of each feed's episodes and articles, lists only the one you opened last." : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. Its hint."
    },
    "Off" : {
      "comment" : "The word for a setting that is turned off, as a slider's or stepper's value says it, such as the sleep timer's fade out.\nVoiceOver value of the iPhone reader's Sleep Timer button while no sleep timer runs.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Desactivado"
          }
        }
      }
    },
    "One Unit for Both Directions" : {
      "comment" : "A choice of the playback bar's navigation unit menus setting: one shared menu sets the unit of both skip buttons."
    },
    "Only rewind if the pause was longer than the threshold" : {
      "comment" : "VoiceOver hint of the Smart mode checkbox in the Playback settings."
    },
    "Only the Latest from Each Feed" : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. The checkbox that keeps one item per feed."
    },
    "Open Book…" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the File group and read by VoiceOver. Opens a book file to import it. Also the title of the menu command of the same name."
    },
    "Open Privacy Settings" : {
      "comment" : "Title of the button in the Record window that opens the macOS Microphone privacy settings after macOS refused TextMouth the microphone."
    },
    "Open Selected Book" : {
