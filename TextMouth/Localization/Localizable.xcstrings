    "ffmpegImport.unreadableStream" : {
      "comment" : "Why a file was not imported: what TextMouth's converter gave back was not audio TextMouth reads, which only a damaged copy of the app could make. %@ is the file's name. Advice to install the app again follows.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أعاد محوّل TextMouth صوتًا من “%@” لا يستطيع TextMouth قراءته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth-এর কনভার্টার “%@”-এর যে অডিও ফেরত দিয়েছে তা TextMouth পড়তে পারেনি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Umwandlungsprogramm von TextMouth hat Audio von „%@“ geliefert, das TextMouth nicht lesen konnte."
          }
        },
        "en" : {
