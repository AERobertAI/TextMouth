          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth перестраивает свою папку данных. Дождитесь окончания и снова выберите «%@»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth перебудовує свій каталог даних. Дочекайтеся завершення й знову виберіть «%@»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 正在重建其数据目录。请等待其完成，然后再次选择“%@”。"
          }
        }
      }
    },
    "TextMouth is replacing “%@” with the new copy. Try again when that finishes." : {
      "comment" : "Why an action on a book is refused while Replace Existing makes the new copy ready, such as Edit Text or opening the book. %@ is the book's title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ersetzt „%@“ durch die neue Kopie. Versuche es erneut, wenn das abgeschlossen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth está reemplazando “%@” por la copia nueva. Inténtalo de nuevo cuando termine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth remplace « %@ » par la nouvelle copie. Réessayez quand ce sera terminé."
          }
        },
        "it" : {
          "stringUnit" : {
