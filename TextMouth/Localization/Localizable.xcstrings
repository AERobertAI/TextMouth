    "audioEditor.explanation.editorWhereAmI" : {
      "comment" : "Hint of the audio editor's Where Am I button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يذكر مكان المؤشر، وفي أي فصل هو، وما الذي حُدّد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "কার্সর কোথায়, কোন অধ্যায়ে, এবং কী নির্বাচিত তা বলে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sagt an, wo der Cursor ist, in welchem Kapitel und was ausgewählt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Says where the cursor is, in which chapter, and what is selected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dice dónde está el cursor, en qué capítulo y qué está seleccionado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "می‌گوید مکان‌نما کجاست، در کدام فصل، و چه چیزی انتخاب شده است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Indique où se trouve le curseur, dans quel chapitre, et ce qui est sélectionné."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אומר היכן הסמן, באיזה פרק, ומה נבחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "बताता है कि कर्सर कहाँ है, किस अध्याय में है, और क्या चयनित है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menyebutkan posisi kursor, di bab mana, dan apa yang dipilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dice dove si trova il cursore, in quale capitolo e che cosa è selezionato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "カーソルの位置、チャプタ、選択範囲を読み上げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "커서의 위치, 속한 챕터, 선택된 항목을 알려 줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zegt waar de cursor staat, in welk hoofdstuk, en wat is geselecteerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mówi, gdzie jest kursor, w którym rozdziale i co jest zaznaczone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Diz onde o cursor está, em qual capítulo e o que está selecionado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сообщает, где курсор, в какой он главе и что выделено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Säger var markören är, i vilket kapitel, och vad som är markerat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "บอกว่าเคอร์เซอร์อยู่ที่ไหน อยู่ในบทใด และเลือกอะไรอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "İmlecin nerede, hangi bölümde olduğunu ve neyin seçili olduğunu söyler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Повідомляє, де курсор, у якому він розділі та що виділено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بتاتا ہے کہ کرسر کہاں ہے، کس باب میں ہے، اور کیا منتخب ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cho biết con trỏ đang ở đâu, thuộc chương nào, và những gì đang được chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "朗读光标所在位置、所在章节和所选内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "朗讀游標所在位置、所在章節，以及選取的內容。"
          }
        }
      }
    },
    "audioEditor.exportButtonHint" : {
      "comment" : "Hint of the audio editor's Export… button.",
