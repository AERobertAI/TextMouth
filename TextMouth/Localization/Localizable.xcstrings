    "readerViewModel.sleepTimerExpiredAnnouncement" : {
      "comment" : "VoiceOver announcement as a sleep timer of so many minutes runs out and pauses the book.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "انتهى مؤقت النوم. توقف التشغيل مؤقتًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "স্লিপ টাইমারের সময় শেষ হয়েছে। প্লেব্যাক বিরতিতে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Einschlaf-Timer abgelaufen. Wiedergabe pausiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep timer expired. Playback paused."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El temporizador de apagado terminó. Reproducción en pausa."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "زمان‌سنج خواب تمام شد. پخش موقتاً متوقف شد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Minuteur de mise en veille écoulé. Lecture en pause."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "טיימר השינה הסתיים. הניגון הושהה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "स्लीप टाइमर की अवधि समाप्त हुई। प्लेबैक पॉज़ किया गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Timer tidur berakhir. Pemutaran dijeda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Timer di spegnimento scaduto. Riproduzione in pausa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "スリープタイマーが終了しました。再生を一時停止しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "취침 타이머가 만료되었습니다. 재생이 일시 정지되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Slaaptimer afgelopen. Afspelen gepauzeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Upłynął czas wyłącznika czasowego. Odtwarzanie wstrzymano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Timer de repouso expirado. Reprodução pausada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Таймер сна сработал. Воспроизведение приостановлено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Insomningstimern har gått ut. Uppspelningen pausad."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตัวตั้งเวลาปิดหมดเวลา หยุดการเล่นชั่วคราวแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uyku zamanlayıcısı doldu. Oynatma duraklatıldı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Таймер сну завершився. Відтворення призупинено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سلیپ ٹائمر ختم ہو گیا۔ پلے بیک موقوف ہو گیا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hẹn giờ ngủ đã hết. Đã tạm dừng phát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "睡眠定时器已结束。播放已暂停。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "睡眠計時器時間到。播放已暫停。"
          }
        }
      }
    },
