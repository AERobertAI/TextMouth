    "audioEditor.savingDetail.format" : {
      "comment" : "Said as the audio editor begins to save, and shown in its sheet. %1$@ is the audio's length in words and %2$@ the name of the file format the book keeps, such as \"M4A (AAC)\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جارٍ حفظ %1$@ من الصوت بصيغة %2$@، وهي الصيغة التي يحتفظ بها هذا الكتاب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ অডিও %2$@ হিসেবে সংরক্ষণ করা হচ্ছে, যে ফরম্যাটে এই বই রাখা হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ Audio wird als %2$@ gesichert, dem Format, das dieses Buch behält."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saving %@ of audio as %@, the format this book keeps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Guardando %1$@ de audio como %2$@, el formato que conserva este libro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "در حال ذخیره %1$@ صدا به‌صورت %2$@، قالبی که این کتاب نگه می‌دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Écriture de %1$@ d’audio en %2$@, le format que ce livre conserve."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "שומר %1$@ של שמע בפורמט %2$@, הפורמט שבו הספר הזה נשמר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ऑडियो को %2$@ के रूप में सहेजा जा रहा है, जो इस पुस्तक का फ़ॉर्मैट है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
