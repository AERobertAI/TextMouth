    "Starting…" : {
      "comment" : "Line of the Transcribe Audio sheet before the first audio file has begun, while the speech model loads."
    },
    "Starts recording from %@." : {
      "comment" : "VoiceOver hint of the Record button in the Record window. %@ is the name of the microphone it records from."
    },
    "Starts recording once a microphone is connected." : {
      "comment" : "VoiceOver hint of the Record button in the Record window while no microphone is connected."
    },
    "Stats" : {
      "comment" : "Name of the Settings tab for reading statistics."
    },
    "Status" : {
      "comment" : "Label of the audio editor's status line: the cursor's time, chapter, and selection.\nLabel of the data directory's status row in Storage settings."
    },
    "Step %@" : {
      "comment" : "VoiceOver label of one step's pop-up of the restart gesture in the Miscellaneous settings. %@ is the step's number, an identifier written without digit grouping."
    },
    "Step %@:" : {
      "comment" : "The number of a step of the restart gesture in the Miscellaneous settings, shown beside its pop-up, ending with a colon. %@ is the step's number, an identifier written without digit grouping."
    },
    "Still comparing: %lld seconds so far. Press Escape to stop." : {
      "comment" : "VoiceOver announcement now and then during a long Compare Libraries comparison. %lld is how many seconds it has taken so far, a count. Escape is the key that stops it.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Still comparing: %lld second so far. Press Escape to stop."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Still comparing: %lld seconds so far. Press Escape to stop."
                }
              }
            }
          }
        }
      }
    },
    "Still downloading, %@ elapsed." : {
      "comment" : "Spoken every so often while a download shows no percentage. %@ is the time waited, spoken, such as \"1 minute, 5 seconds\"."
    },
    "Still finding the pauses. Try again in a moment." : {
      "comment" : "Said when a pause command is used in the audio editor while the pauses are still being found."
    },
    "Still starting: %@" : {
      "comment" : "VoiceOver announcement when Play is pressed while the next book is still opening. %@ is the next book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aún iniciando: %@"
          }
        }
      }
    },
    "Still working on the last change." : {
      "comment" : "Said when an audio editor command would change the audio while another change, a save, or an export is under way."
    },
    "Still working. Close once the change is done." : {
      "comment" : "Said when the audio editor's window can't close because a change, save, or export is under way."
    },
    "Stop" : {
      "comment" : "A choice of the Reading List's When a book ends pop-up button: when a book opened from the list ends, stop there.\nA choice of the When a Book Ends picker: the book stops at its end, finished. Play then says it is finished.\nButton of the Compare Libraries sheet that stops the comparison.\nName of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Stop\".\nName of a keyboard shortcut action, listed in Settings in the Record window group and read by VoiceOver. Stops the recording.\nName of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Stops playback in the audio editor.\nThe button in the Export dialog that stops an export under way.\nTitle of the button in the Record window that stops recording and saves it.\nTitle of the button that stops a running search in the Search Library window.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detener"
          }
        }
      }
    },
    "Stop At" : {
      "comment" : "Heading of the sleep timer sheet's section of timers that stop at a place in the book: End of heading and End of book.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detener en"
          }
        }
      }
    },
    "Stop Comparing" : {
      "comment" : "Button in Storage settings that stops the comparison made before Use This Library."
    },
    "Stop Keeping %lld Books on This Mac" : {
      "comment" : "Library menu command that stops keeping the selected books' files downloaded on this Mac. %lld is the number of books selected.",
      "localizations" : {
        "en" : {
