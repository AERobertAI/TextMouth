    "recording.recoveredAnnouncement.discard" : {
      "comment" : "Announcement of the Record window when it finds one recording left behind. %@ is the heading of the list of recovered recordings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم العثور على تسجيل من قبل آخر إنهاء لـ TextMouth، ضمن %@. احفظه أو تجاهله."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth শেষবার বন্ধ হওয়ার আগের একটি রেকর্ডিং পাওয়া গেছে, %@-এর অধীনে। এটি সংরক্ষণ করুন বা বর্জন করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eine Aufnahme von vor dem letzten Beenden von TextMouth gefunden, unter %@. Sichere oder verwirf sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Found a recording from before TextMouth last quit, under %@. Save or discard it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se encontró una grabación de antes del último cierre de TextMouth, en %@. Guárdala o descártala."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یک ضبط از پیش از آخرین خروج TextMouth باقی مانده است که زیر %@ فهرست شده است. آن را ذخیره کنید یا دور بیندازید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un enregistrement datant d’avant la dernière fermeture de TextMouth a été trouvé, sous %@. Enregistrez-le ou abandonnez-le."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "נמצאה הקלטה מלפני היציאה האחרונה מ-TextMouth, תחת %@. שמור או השלך אותה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth के पिछली बार बंद होने से पहले की एक रिकॉर्डिंग मिली, %@ में। इसे सहेजें या त्यागें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ditemukan satu rekaman dari sebelum TextMouth terakhir keluar, di bawah %@. Simpan atau buang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trovata una registrazione precedente all’ultima chiusura di TextMouth, in %@. Salvala o scartala."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth を最後に終了する前の録音が見つかりました（「%@」の下）。保存または破棄してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 마지막으로 종료되기 전의 녹음 1개를 찾아 %@ 아래에 표시했습니다. 저장하거나 폐기하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Opname gevonden van voordat TextMouth voor het laatst werd afgesloten, onder %@. Bewaar of gooi die weg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Znaleziono nagranie sprzed ostatniego zakończenia TextMouth, pod nagłówkiem %@. Zachowaj je lub odrzuć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Foi encontrada uma gravação feita antes do último encerramento do TextMouth, em %@. Salve-a ou descarte-a."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Найдена запись, оставшаяся после последнего выхода из TextMouth, в разделе «%@». Сохраните или удалите её."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hittade en inspelning från innan TextMouth senast avslutades, under %@. Spara eller kassera den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
