    "Using one library on two Macs at the same time can lose reading positions and changes." : {
      "comment" : "Last sentence of the warning that another Mac has this library open: the risk.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
