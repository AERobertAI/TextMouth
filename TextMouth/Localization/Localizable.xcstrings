          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Папка на месте, но TextMouth не может прочитать файл идентификатора её библиотеки: %@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
