        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "हो सकता है कि उसे ले जाया गया हो या उसका नाम बदला गया हो, या %@ ने उसे अभी तक इस Mac पर सिंक न किया हो।"
