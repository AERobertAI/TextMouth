    "libraryViewPicker.deletedView" : {
      "comment" : "Text of the Library window's View pop-up and Go to View. What a window announces when the view it showed was deleted, from Settings or by a change of config.json, and it shows name, the first view its pop-up offers, instead. Placeholders in order: name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم حذف العرض الذي كانت هذه النافذة تعرضه. وهي تعرض الآن %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই উইন্ডো যে ভিউ দেখাচ্ছিল সেটি মুছে ফেলা হয়েছে। এখন এটি %@ দেখাচ্ছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Ansicht, die dieses Fenster zeigte, wurde gelöscht. Es zeigt jetzt %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The view this window showed was deleted. It now shows %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La vista que mostraba esta ventana se eliminó. Ahora muestra %@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نمایی که این پنجره نشان می‌داد حذف شد. اکنون %@ را نشان می‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La vue que cette fenêtre affichait a été supprimée. Elle affiche maintenant %@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "התצוגה שהחלון הזה הציג נמחקה. כעת הוא מציג %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस विंडो में दिखाया गया दृश्य मिटा दिया गया। अब यह %@ दिखाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tampilan yang ditampilkan jendela ini telah dihapus. Sekarang menampilkan %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La vista mostrata da questa finestra è stata eliminata. Ora mostra %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このウインドウに表示していたビューは削除されました。現在は%@を表示しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 윈도우에 표시되던 보기가 삭제되었습니다. 이제 %@을(를) 표시합니다."
          }
        },
        "nl" : {
