          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si sta allegando una trascrizione al libro %@. Trascrivilo al termine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@に文字起こしを添付しています。完了してから文字起こししてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
