    "libraryViewPicker.wentToEmptyView" : {
      "comment" : "VoiceOver announcement on going, by Go to View, to a filter view that lists nothing now. %@ is the view's name. It says the words of the empty row such a view shows (\"Nothing matches this view now.\"), in lower case after the name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@، لا يوجد ما يطابق هذا العرض الآن."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, এখন এই ভিউয়ে কিছুই মেলে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@: Zurzeit passt nichts zu dieser Ansicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, nothing matches this view now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, nada coincide con esta vista ahora."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@، اکنون چیزی با این نما مطابقت ندارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, rien ne correspond à cette vue pour le moment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, אין כרגע התאמות לתצוגה הזו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, अब इस दृश्य से कुछ मेल नहीं खाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, tidak ada yang cocok dengan tampilan ini sekarang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, al momento nessun elemento corrisponde a questa vista."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@、現在このビューに一致するものはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, 지금은 일치하는 항목이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, nu komt niets overeen met deze weergave."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, do tego widoku nic teraz nie pasuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, nada corresponde a esta visualização agora."
          }
        },
        "ru" : {
