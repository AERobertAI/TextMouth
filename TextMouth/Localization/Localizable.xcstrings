    "iCloud Drive may be turned off or signed out, or this Mac may be offline. Check that, then choose Try Again." : {
      "comment" : "What to check when the library's files could not come from iCloud Drive. Try Again is the name of a button on the same screen.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Puede que iCloud Drive esté desactivado o con la sesión cerrada, o que esta Mac no tenga conexión. Compruébalo y luego elige Reintentar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive potrebbe essere disattivato o senza accesso effettuato, oppure questo Mac potrebbe essere offline. Controlla, poi scegli Riprova."
          }
        }
      }
    },
    "iCloud Drive may be turned off or signed out." : {
      "comment" : "The likely cause of a missing iCloud Drive folder: iCloud Drive's own folder is missing too.",
      "localizations" : {
