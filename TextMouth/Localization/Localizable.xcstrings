          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Оригинал в %@ — папка или ссылка, поэтому его копию нельзя проверить."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Оригінал у %@ — папка або посилання, тому його копію не можна перевірити."
