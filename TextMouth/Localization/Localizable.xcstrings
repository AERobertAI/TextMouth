    "Repack the pages of RAR comics as CBZ comics, then import those." : {
      "comment" : "Advice after the refusal of a comic whose pages are in a RAR archive.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Packe die Seiten von RAR-Comics als CBZ-Comics neu und importiere diese dann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reempaqueta las páginas de los cómics RAR como cómics CBZ y luego impórtalos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Réarchivez les pages des bandes dessinées RAR au format CBZ, puis importez-les."
