    "bookTextEdit.cannotBegin.missing.again" : {
      "comment" : "Second sentence of that message: opening the book makes its text ready.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "افتح الكتاب مرة واحدة، ثم حاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইটি একবার খুলুন, তারপর আবার চেষ্টা করুন।"
