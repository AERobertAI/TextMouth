    "bookSearch.transcribeAgainAdvice" : {
      "comment" : "Advice after the reason a book's transcript cannot be searched because its audio changed: make the transcript again.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فرّغه مرة أخرى، ثم ابحث في النسخة النصية الجديدة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আবার ট্রান্সক্রাইব করুন, তারপর নতুন ট্রান্সক্রিপ্টে অনুসন্ধান করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transkribiere es erneut und durchsuche dann das neue Transkript."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcribe it again, then search the new transcript."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transcríbelo de nuevo y luego busca en la transcripción nueva."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "دوباره آن را رونویسی کنید، سپس در رونوشت جدید جست‌وجو کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transcrivez-le de nouveau, puis recherchez dans la nouvelle transcription."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "תמלל אותו שוב, ואז חפש בתמליל החדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसे फिर से ट्रांसक्राइब करें, फिर नई ट्रांसक्रिप्ट खोजें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transkripsikan lagi, lalu cari di transkrip baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trascrivilo di nuovo, poi cerca nella nuova trascrizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "もう一度文字起こしをしてから、新しい文字起こしを検索してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "다시 대본을 만든 다음 새 대본을 검색하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transcribeer het opnieuw en doorzoek dan de nieuwe transcriptie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
