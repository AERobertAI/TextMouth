            "value" : "ライブラリにコピーできませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관함으로 복사할 수 없었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
