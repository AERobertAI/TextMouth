        }
      }
    },
    "shortcutsSettings.trialResult.tooFarApart.above" : {
      "comment" : "Announced by VoiceOver at the end of a trial of the double press time when the two presses were too far apart for the time set. Both %1$@ and %2$@ are the time between the presses, such as \"0.7 seconds\"; the listener should set the double press time above it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ضغطتان بينهما %1$@. اضبط المهلة على أكثر من %2$@ لتُحسبا ضغطة واحدة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "দুটি চাপ, %1$@ ব্যবধানে। এগুলোকে একটি হিসেবে গণ্য করতে সময় %2$@-এর বেশি করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zwei Tastendrücke im Abstand von %1$@. Stelle die Zeit höher als %2$@ ein, damit sie als einer zählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two presses, %@ apart. Set the time above %@ to count them as one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dos pulsaciones, separadas por %1$@. Sube el tiempo por encima de %2$@ para contarlas como una."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "دو فشردن، با فاصله %1$@. زمان را بالاتر از %2$@ تنظیم کنید تا یک دوبار فشردن حساب شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deux appuis, espacés de %@. Réglez le délai au-dessus de %@ pour les compter comme un seul."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "שתי לחיצות, במרחק %1$@ זו מזו. הגדר את הזמן מעל %2$@ כדי שייחשבו כאחת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "दो बार दबाया गया, बीच में %1$@ का अंतर। उन्हें एक गिनने के लिए समय को %2$@ से अधिक पर सेट करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dua penekanan, berjarak %1$@. Setel waktu di atas %2$@ agar dihitung sebagai satu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Due pressioni a distanza di %@. Imposta un tempo superiore a %@ per contarle come una sola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "2回の押下の間隔は%1$@でした。ダブルプレスとして数えるには、時間を%2$@より長くしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "두 번 누른 간격은 %1$@입니다. 두 번 누르기로 인식하려면 시간을 %2$@보다 크게 설정하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
