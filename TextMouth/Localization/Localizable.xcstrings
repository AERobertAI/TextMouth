    },
    "The previous article could not be downloaded, so playback stopped." : {
      "comment" : "First sentence of the VoiceOver announcement when Previous in Folder could not download the previous feed article while a book was playing, so playback was paused. A sentence with the reason follows it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der vorherige Artikel konnte nicht heruntergeladen werden, daher wurde die Wiedergabe gestoppt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo descargar el artículo anterior, así que la reproducción se detuvo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’article précédent n’a pas pu être téléchargé, donc la lecture s’est arrêtée."
