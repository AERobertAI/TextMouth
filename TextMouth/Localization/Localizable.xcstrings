    "Date Added" : {
      "comment" : "Name of a way to sort the books: by the date the book was added. Shown in the Sort menu, the library view editor, the window title, and in sort announcements.\nText of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. A kind of test as a condition's test pop-up names it. This is the case .addedWithin."
    },
    "Date Opened" : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. A kind of test as a condition's test pop-up names it. This is the case .openedWithin."
    },
    "Days after an episode finishes before its download is deleted, from 0 (at once) to 365; one open in a reader waits until it closes" : {
      "comment" : "VoiceOver hint of the delete-after-playing number field and stepper. The range is the limits of the number, in days."
    },
    "Days to keep an original" : {
      "comment" : "Label of the stepper that sets how many days an original audio is kept, in Storage settings (Audio Editing) and the audio editor's Audio Info."
    },
    "Decrease Speed" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Playback group and read by VoiceOver. Makes the reading speed slower. Also the title of the menu command of the same name."
    },
    "Default Pitch" : {
      "comment" : "Heading of the default pitch group in the Voice settings."
    },
    "Default Pitch: %@" : {
      "comment" : "The default pitch shown above its slider in the Voice settings. %@ is the pitch, such as Normal (1.0x)."
