        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mở thư viện ở vị trí mặc định, ~/.TextMouth, hoặc bắt đầu một thư viện mới ở đó, thay cho thư viện không khả dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "打开位于默认位置 ~/.TextMouth 的资料库，或在那里新建一个，以取代不可用的资料库。"
          }
        },
        "zh-Hant" : {
