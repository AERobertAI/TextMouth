            "value" : "Iniciando: %@"
          }
        }
      }
    },
    "Status" : {
      "comment" : "Label of the audio editor's status line: the cursor's time, chapter, and selection."
    },
    "Still finding the pauses. Try again in a moment." : {
      "comment" : "Said when a pause command is used in the audio editor while the pauses are still being found."
    },
    "Still starting: %@" : {
      "comment" : "VoiceOver announcement when Play is pressed while the next book is still opening. %@ is the next book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aún iniciando: %@"
          }
        }
      }
    },
    "Still working on the last change." : {
      "comment" : "Said when an audio editor command would change the audio while another change, a save, or an export is under way."
    },
    "Still working. Close once the change is done." : {
      "comment" : "Said when the audio editor's window can't close because a change, save, or export is under way."
    },
    "Stop" : {
      "comment" : "A choice of the Reading List's When a book ends pop-up button: when a book opened from the list ends, stop there.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detener"
          }
        }
      }
    },
    "Stop At" : {
      "comment" : "Heading of the sleep timer sheet's section of timers that stop at a place in the book: End of heading and End of book.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detener en"
          }
        }
      }
    },
    "Stop Preview" : {
      "comment" : "Button of the audio editor's Apply Filter sheet that stops the preview."
    },
    "Stop Recording" : {
      "comment" : "Title of the audio editor's Punch In button while it records."
    },
    "Stop at the end of the book" : {
      "comment" : "VoiceOver label of the sleep timer sheet's End of book button, which sets a timer that stops where the book ends.",
      "localizations" : {
