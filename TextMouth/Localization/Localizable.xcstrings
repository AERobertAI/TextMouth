    "bookExport.chapterListChoiceHint.exports" : {
      "comment" : "The hint of the Headings checkbox in the Export dialog while CUE sheet is chosen. \"Audio\" is the name of the Audio checkbox.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نص كل عنوان رئيسي وبدايته، كملف CUE يسمّي الصوت كما يصدّره التنسيق “صوتي”."
