    "libraryTransition.feedItemsLeft.episodes" : {
      "comment" : "VoiceOver announcement when Move to Folder left one feed item where it is. %1$@ is the item's title, in quotes. %2$@ is the name of the Move to Library command, which makes an item a book of the library.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تُرك %1$@ في مكانه: تبقى الحلقات والمقالات في موجزاتها؛ و%2$@ يجعله كتابًا في مكتبتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ যেখানে আছে সেখানেই রাখা হয়েছে: পর্ব ও নিবন্ধ নিজ নিজ ফিডেই থাকে; “%2$@” একটিকে আপনার লাইব্রেরির বই বানায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ bleibt, wo es ist: Folgen und Artikel bleiben in ihren Feeds; %2$@ macht eines zu einem Buch deiner Bibliothek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Left %@ where it is: episodes and articles stay in their feeds; %@ makes one a book of your library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se dejó %1$@ donde está: los episodios y artículos permanecen en sus canales; %2$@ convierte uno en un libro de tu biblioteca."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ همان‌جا که هست ماند: قسمت‌ها و مقاله‌ها در فیدهای خود می‌مانند؛ %2$@ یکی را به کتابی از کتابخانه‌ی شما تبدیل می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ n’a pas été déplacé : les épisodes et les articles restent dans leurs flux ; la commande %@ en fait un livre de votre bibliothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ נשאר במקומו: אפיזודות וכתבות נשארות בערוצים שלהן; הפקודה “%2$@” הופכת אחת מהן לספר בספרייה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ को जहाँ है वहीं छोड़ा गया: एपिसोड और लेख अपनी फ़ीड में रहते हैं; “%2$@” किसी को आपकी लाइब्रेरी की पुस्तक बनाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ dibiarkan di tempatnya: episode dan artikel tetap berada di feed-nya; %@ menjadikannya buku di pustaka Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ non è stato spostato: gli episodi e gli articoli restano nei loro feed; %@ ne trasforma uno in un libro della tua libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@をそのままにしました。エピソードと記事はフィードに残ります。「%2$@」を実行すると、ライブラリのブックにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@을(를) 그대로 두었습니다. 에피소드와 기사는 해당 피드에 남으며, %2$@ 명령을 사용하면 보관함의 책이 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ is op zijn plaats gelaten: afleveringen en artikelen blijven in hun feeds; met %@ maak je er een boek in je bibliotheek van."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pozostawiono %1$@ na miejscu: odcinki i artykuły zostają w swoich kanałach; polecenie %2$@ zamienia taki element w książkę biblioteki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ foi deixado onde está: episódios e artigos permanecem em seus feeds; %2$@ transforma um deles em livro da sua biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Оставлено на месте: %1$@. Выпуски и статьи остаются в своих лентах; «%2$@» делает выпуск или статью книгой вашей библиотеки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ lämnades kvar där den är: avsnitt och artiklar stannar i sina flöden; ”%@” gör ett av dem till en bok i ditt bibliotek."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ยังอยู่ที่เดิม: ตอนและบทความจะอยู่ในฟีดของตน ส่วนคำสั่ง %2$@ จะทำให้รายการเป็นหนังสือในไลบรารีของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ olduğu yerde bırakıldı: podcast bölümleri ve makaleler beslemelerinde kalır; “%2$@” komutu birini kitaplığınızın bir kitabı yapar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Залишено на місці: %1$@. Епізоди та статті залишаються у своїх стрічках; «%2$@» робить елемент книгою вашої бібліотеки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ کو جہاں ہے وہیں چھوڑ دیا گیا: ایپی سوڈز اور مضامین اپنی فیڈز میں رہتے ہیں؛ “%2$@” کسی ایک کو آپ کی لائبریری کی کتاب بنا دیتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đã để nguyên %1$@: tập và bài viết ở lại trong nguồn cấp của chúng; lệnh %2$@ biến một mục thành sách trong thư viện của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 保持在原处：单集和文章会留在其订阅源中；使用 %2$@ 可将其变为你资料库中的图书。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 保持在原處：單集和文章會留在它們的訂閱源中；%2$@ 可將單集或文章變成書庫中的書籍。"
          }
        }
      }
    },
