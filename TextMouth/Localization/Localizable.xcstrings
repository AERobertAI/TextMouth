    "There isn't room on this Mac for this episode (%@)." : {
      "comment" : "Why a feed's episode could not be downloaded: the disk is too full. %@ is the file's size with its unit, such as 61 MB.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Auf diesem Mac ist kein Platz für diese Folge (%@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay espacio en esta Mac para este episodio (%@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il n’y a pas de place sur ce Mac pour cet épisode (%@)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non c’è spazio su questo Mac per questo episodio (%@)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não há espaço neste Mac para este episódio (%@)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "На этом Mac нет места для этого выпуска (%@)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "На цьому Mac немає місця для цього епізоду (%@)."
          }
        }
      }
    },
    "There isn’t enough free space on the disk." : {
      "comment" : "Why an import failed when the disk is full. Said instead of the system's own sentence, which names a hidden internal file.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Auf dem Datenträger ist nicht genug Speicherplatz frei."
          }
