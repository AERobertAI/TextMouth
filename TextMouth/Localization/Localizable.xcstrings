    "protection.removePasswordHint" : {
      "comment" : "Hint of the Remove Password checkbox: what it changes and what it leaves alone.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعيد كتابة ملف الكتاب في مكتبتك دون كلمة مروره. لا يتغير ملفك الأصلي أبدًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আপনার লাইব্রেরিতে বইয়ের ফাইলটি পাসওয়ার্ড ছাড়া আবার লেখে। আপনার মূল ফাইল কখনও বদলায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Schreibt die Datei des Buchs in Ihrer Bibliothek ohne Passwort neu. Ihr Original bleibt unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rewrites the book's file in your library without its password. Your original is never changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reescribe el archivo del libro en tu biblioteca sin su contraseña. Tu original nunca se modifica."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فایل کتاب را در کتابخانه‌تان بدون گذرواژه بازنویسی می‌کند. فایل اصلی شما هرگز تغییر نمی‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Réécrit le fichier du livre dans votre bibliothèque sans son mot de passe. Votre original n’est jamais modifié."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כותב מחדש את קובץ הספר בספרייה שלכם ללא הסיסמה. הקובץ המקורי שלכם לא משתנה לעולם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आपकी लाइब्रेरी में पुस्तक की फ़ाइल को उसके पासवर्ड के बिना दोबारा लिखता है। आपकी मूल फ़ाइल कभी नहीं बदलती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menulis ulang file buku di pustaka Anda tanpa kata sandinya. File asli Anda tidak pernah diubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Riscrive il file del libro nella tua libreria senza password. Il tuo originale non viene mai modificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ライブラリ内のブックのファイルをパスワードなしで書き直します。元のファイルは変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관함에 있는 책의 파일을 암호 없이 다시 씁니다. 원본 파일은 절대 바뀌지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Schrijft het bestand van het boek in je bibliotheek opnieuw zonder wachtwoord. Je origineel wordt nooit gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zapisuje plik książki w Twojej bibliotece ponownie, bez hasła. Twój oryginał nigdy nie jest zmieniany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Regrava o arquivo do livro na sua biblioteca sem a senha. O seu original nunca é alterado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Перезаписывает файл книги в вашей библиотеке без пароля. Ваш оригинал не меняется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Skriver om bokens fil i ditt bibliotek utan lösenord. Ditt original ändras aldrig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เขียนไฟล์หนังสือในไลบรารีของคุณใหม่โดยไม่มีรหัสผ่าน ไฟล์ต้นฉบับของคุณจะไม่ถูกเปลี่ยนแปลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitabın kitaplığınızdaki dosyasını parolasız olarak yeniden yazar. Orijinal dosyanız asla değişmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Перезаписує файл книги у вашій бібліотеці без пароля. Ваш оригінал ніколи не змінюється."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آپ کی لائبریری میں کتاب کی فائل کو پاس ورڈ کے بغیر دوبارہ لکھتا ہے۔ آپ کی اصل فائل کبھی نہیں بدلتی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ghi lại tệp của sách trong thư viện của bạn mà không có mật khẩu. Tệp gốc của bạn không bao giờ bị thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "将资料库中此图书的文件改写为不带密码的文件。你的原始文件不会被更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "將資料庫中這本書的檔案改寫為不含密碼的檔案。你的原始檔案不會被更改。"
          }
        }
      }
    },
