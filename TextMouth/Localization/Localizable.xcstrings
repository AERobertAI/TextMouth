    "settings.smartModeHint" : {
      "comment" : "VoiceOver hint of the Smart mode checkbox in the Playback settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يرجّع التشغيل فقط إذا كان الإيقاف المؤقت أطول من الحد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বিরতি সীমার চেয়ে বেশি হলেই কেবল পিছিয়ে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nur zurückspulen, wenn die Pause länger als der Schwellenwert war."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
