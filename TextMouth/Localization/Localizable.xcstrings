    "Lists up to 500 of this book's matches here" : {
      "comment" : "VoiceOver hint of the row that lists a book's matches in the Search Library results. 500 is the most it lists."
    },
    "Loading" : {
      "comment" : "Value of the Play button while the book is loading, spoken by VoiceOver."
    },
    "Loading %@" : {
      "comment" : "What VoiceOver says for the spinner in the reader while a book loads. %@ is the book's title."
