    "This book keeps its original audio until the book is removed." : {
      "comment" : "Said as a book's original audio policy is set to keep the original until the book is removed.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحتفظ هذا الكتاب بصوته الأصلي حتى تتم إزالة الكتاب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieses Buch bewahrt sein Originalaudio auf, bis das Buch entfernt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este libro conserva su audio original hasta que se quita el libro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce livre conserve son audio original jusqu’à ce qu’il soit retiré."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "यह पुस्तक हटाए जाने तक अपना मूल ऑडियो रखती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Buku ini mempertahankan audio aslinya sampai bukunya dibuang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo libro conserva il suo audio originale finché il libro non viene rimosso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このブックは、ブックが取り除かれるまで元のオーディオを保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
