          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%1$@» — це Власний голос, який macOS не може записати у файл. Виберіть інший голос кнопкою «%2$@» у вікні читання, а потім експортуйте знову."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” ایک Personal Voice ہے، جسے macOS فائل میں ریکارڈ نہیں کر سکتا۔ ریڈر میں “%2$@” بٹن سے کوئی دوسری آواز منتخب کریں، پھر دوبارہ برآمد کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
