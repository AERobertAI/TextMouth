            "value" : "TextMouth les a laissés là et utilise toujours %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ने उन्हें वहीं छोड़ दिया और अब भी %@ का उपयोग कर रहा है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth membiarkannya di sana dan masih memakai %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth li ha lasciati lì e sta ancora usando %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth はそれらをそこに残し、引き続き%@を使用しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
