    "settings.navigationMenuExplanation" : {
      "comment" : "Explanation under the playback controls group's choices in the Playback settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تُحفظ تغييرات القوائم كإعدادات افتراضية للكتاب الحالي. يستخدم إخفاء القوائم خيارات التخطي العامة؛ وتبقى الإعدادات الافتراضية للكتب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "মেনুর পরিবর্তন বর্তমান বইয়ের ডিফল্ট হিসেবে সংরক্ষিত হয়। মেনু লুকালে গ্লোবাল এগিয়ে-পিছিয়ে যাওয়ার পছন্দ ব্যবহৃত হয়; বইয়ের ডিফল্ট রাখা থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Änderungen am Menü werden als Standard für das aktuelle Buch gesichert. Wenn die Menüs ausgeblendet sind, gelten die globalen Sprungwerte; die Standards der Bücher bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menu changes are saved as defaults for the current book. Hiding the menus uses the global skip choices; book defaults are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los cambios del menú se guardan como valores predeterminados del libro actual. Al ocultar los menús se usan las opciones de salto globales; los valores predeterminados de cada libro se conservan."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تغییرات منو به‌عنوان پیش‌فرض کتاب فعلی ذخیره می‌شوند. پنهان کردن منوها از انتخاب‌های رد شدن سراسری استفاده می‌کند؛ پیش‌فرض‌های کتاب حفظ می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les changements de menu sont enregistrés comme valeurs par défaut du livre actuel. Masquer les menus utilise les choix de saut globaux ; les valeurs par défaut des livres sont conservées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "שינויים בתפריטים נשמרים כברירות מחדל של הספר הנוכחי. הסתרת התפריטים משתמשת בבחירות הדילוג הגלובליות; ברירות המחדל של הספרים נשמרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "मेनू में किए गए बदलाव वर्तमान पुस्तक के डिफ़ॉल्ट के रूप में सहेजे जाते हैं। मेनू छिपाने पर वैश्विक आगे-पीछे जाने के विकल्प उपयोग होते हैं; पुस्तक के डिफ़ॉल्ट बने रहते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Perubahan menu disimpan sebagai default untuk buku saat ini. Menyembunyikan menu memakai pilihan lompat global; default buku tetap disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le modifiche al menu vengono salvate come predefinite per il libro corrente. Se nascondi i menu, vengono usate le scelte di salto globali; le impostazioni predefinite dei libri vengono mantenute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "メニューの変更は、現在のブックのデフォルトとして保存されます。メニューを非表示にすると全体のスキップ設定を使い、ブックのデフォルトは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "메뉴 변경 사항은 현재 책의 기본값으로 저장됩니다. 메뉴를 숨기면 전체 건너뛰기 설정을 사용하며, 책별 기본값은 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wijzigingen in de menu's worden bewaard als standaard voor het huidige boek. Als je de menu's verbergt, gelden de globale sprongkeuzes; de standaardwaarden van boeken blijven bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zmiany w menu są zapisywane jako ustawienia domyślne bieżącej książki. Po ukryciu menu używane są globalne ustawienia przewijania; ustawienia domyślne książek zostają zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "As mudanças nos menus são salvas como padrões do livro atual. Ocultar os menus usa as opções globais de avanço; os padrões do livro são mantidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Изменения в меню сохраняются как значения по умолчанию для текущей книги. Если скрыть меню, действуют общие варианты перемотки; значения для книг сохраняются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menyändringar sparas som standard för den aktuella boken. När menyerna döljs används de globala hoppvalen; bokstandarder behålls."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "การเปลี่ยนแปลงเมนูจะบันทึกเป็นค่าเริ่มต้นของหนังสือเล่มปัจจุบัน การซ่อนเมนูจะใช้ตัวเลือกการข้ามส่วนกลาง และค่าเริ่มต้นของหนังสือจะยังคงอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menü değişiklikleri geçerli kitap için varsayılan olarak kaydedilir. Menüleri gizlemek genel atlama seçimlerini kullanır; kitap varsayılanları korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Зміни меню зберігаються як типові для поточної книги. Приховування меню використовує загальні параметри перемотування; типові параметри книги зберігаються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مینو کی تبدیلیاں موجودہ کتاب کے ڈیفالٹ کے طور پر محفوظ ہوتی ہیں۔ مینو چھپانے پر عالمی چھلانگ کے انتخاب استعمال ہوتے ہیں؛ کتاب کے ڈیفالٹ برقرار رہتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thay đổi trong menu được lưu làm mặc định cho sách hiện tại. Việc ẩn menu dùng các lựa chọn tua chung; mặc định của sách được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "菜单中的更改会存储为当前图书的默认设置。隐藏菜单会使用全局跳过选项；图书默认设置会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選單的更改會儲存為目前書籍的預設值。隱藏選單時會使用全域的跳轉選擇；書籍的預設值會保留。"
          }
        }
      }
    },
    "settings.navigationUnitControlsHint" : {
      "comment" : "VoiceOver hint of the Navigation unit controls pop-up in the Playback settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يختار عدم وجود عنصر تحكم لكل كتاب، أو منتقيًا مشتركًا واحدًا، أو قائمة بمنتقيين منفصلين للأمام والخلف."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইভিত্তিক কোনো নিয়ন্ত্রণ নয়, একটি ভাগ করা পিকার, অথবা আলাদা এগিয়ে ও পিছিয়ে যাওয়ার পিকারসহ একটি মেনু বেছে নেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wähle zwischen keiner Steuerung pro Buch, einer gemeinsamen Auswahl und einem Menü mit getrennten Auswahlen für vorwärts und rückwärts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose no per-book control, one shared picker, or a menu with separate forward and backward pickers"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige entre no tener control por libro, un selector compartido o un menú con selectores separados para avanzar y retroceder"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بدون کنترل برای هر کتاب، یک انتخابگر مشترک، یا منویی با انتخابگرهای جداگانه برای جلو و عقب را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisit entre aucun contrôle par livre, un sélecteur partagé, ou un menu avec des sélecteurs distincts pour l’avance et le retour."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בוחר את הפקד לכל ספר: ללא פקד, בורר משותף אחד, או תפריט עם בוררים נפרדים לקדימה ולאחורה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चुनें कि कोई प्रति-पुस्तक कंट्रोल न हो, एक साझा पिकर हो, या आगे और पीछे के अलग पिकर वाला मेनू हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Memilih antara tidak ada kontrol per buku, satu pemilih bersama, atau menu dengan pemilih maju dan mundur yang terpisah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sceglie tra nessun controllo per libro, un selettore condiviso o un menu con selettori separati per avanti e indietro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブックごとのコントロールなし、共有の1つのピッカー、または前方と後方で別々のピッカーを持つメニューから選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책별 제어 없음, 공유 선택기 하나, 앞으로와 뒤로 선택기가 따로 있는 메뉴 중에서 선택합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bepaalt of er geen bediening per boek is, één gedeelde keuzelijst of een menu met aparte keuzelijsten voor vooruit en achteruit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pozwala wybrać brak osobnych kontrolek dla książki, jeden wspólny przycisk wyboru albo menu z osobnymi wyborami do przodu i do tyłu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escolhe entre nenhum controle por livro, um seletor compartilhado ou um menu com seletores separados para avançar e retroceder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Выбирает вариант: без выбора для каждой книги, один общий список или меню с отдельными списками для движения вперёд и назад."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Välj ingen kontroll per bok, en gemensam väljare eller en meny med separata väljare för framåt och bakåt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เลือกระหว่างไม่มีตัวควบคุมสำหรับแต่ละเล่ม ตัวเลือกร่วมหนึ่งตัว หรือเมนูที่มีตัวเลือกไปข้างหน้าและย้อนกลับแยกกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitap başına denetim olmamasını, tek bir ortak seçiciyi veya ileri ve geri için ayrı seçicileri olan bir menüyü seçer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Виберіть, чи не показувати елемент керування для кожної книги, чи один спільний засіб вибору, чи меню з окремими засобами вибору для навігації вперед і назад."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فی کتاب کوئی کنٹرول نہ رکھنا، ایک مشترکہ انتخاب کنندہ، یا آگے اور پیچھے کے الگ انتخاب کنندگان والا مینو منتخب کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chọn không có điều khiển theo từng sách, một bộ chọn dùng chung, hoặc một menu với bộ chọn tiến và lùi riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "选取不显示每本图书的控件、一个共用选择器，或带有独立向前和向后选择器的菜单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選擇不使用每本書的控制項、一個共用的選擇器，或含有向前與向後各自選擇器的選單。"
          }
        }
      }
    },
    "settings.navigationUnitControlsLabel" : {
      "comment" : "VoiceOver label of the Navigation unit controls pop-up in the Playback settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
