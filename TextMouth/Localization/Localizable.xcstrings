    "importProgress.cancelButtonHint" : {
      "comment" : "VoiceOver hint of the import overlay's Cancel button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يوقف الاستيراد الجاري والمنتظر. تبقى الكتب التي تم استيرادها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "চলমান আমদানি এবং অপেক্ষায় থাকাগুলো থামায়। আগে আমদানি হওয়া বই থেকে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppt den laufenden und die wartenden Importe. Bereits importierte Bücher bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops the import under way and those waiting. Books already imported stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detiene la importación en curso y las que esperan. Los libros ya importados se quedan."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "وارد کردن در جریان و موردهای منتظر در صف را متوقف می‌کند. کتاب‌هایی که پیش از این وارد شده‌اند می‌مانند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrête l’importation en cours et celles en attente. Les livres déjà importés restent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "עוצר את הייבוא שבתהליך ואת אלה שממתינים. ספרים שכבר יובאו נשארים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "जारी आयात और प्रतीक्षा में रखे आयात रोक देता है। जो पुस्तकें आयात हो चुकी हैं, वे बनी रहती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menghentikan impor yang sedang berjalan dan yang menunggu. Buku yang sudah diimpor tetap ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe l’importazione in corso e quelle in attesa. I libri già importati restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "処理中の読み込みと待機中の読み込みを停止します。すでに読み込んだブックは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "진행 중인 가져오기와 대기 중인 가져오기를 중지합니다. 이미 가져온 책은 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stopt de lopende import en de wachtende. Al geïmporteerde boeken blijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zatrzymuje trwający import i oczekujące. Już zaimportowane książki zostają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe a importação em andamento e as que aguardam. Os livros já importados permanecem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Останавливает выполняемый импорт и ожидающие. Уже импортированные книги остаются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppar importen som pågår och de som väntar. Böcker som redan importerats finns kvar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หยุดการนำเข้าที่กำลังทำอยู่และที่รออยู่ หนังสือที่นำเข้าแล้วยังอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Süren ve bekleyen içe aktarmaları durdurur. İçe aktarılmış kitaplar kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Зупиняє поточний імпорт і ті, що очікують. Уже імпортовані книги залишаються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جاری درآمد اور انتظار میں موجود درآمدات کو روک دیتا ہے۔ جو کتابیں پہلے ہی درآمد ہو چکی ہیں وہ رہتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dừng lượt nhập đang diễn ra và những lượt đang chờ. Các sách đã nhập vẫn còn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止正在进行和正在等待的导入。已导入的图书会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止進行中與等待中的輸入。已輸入的書籍會保留。"
          }
        }
      }
    },
