    "nextBookWindow.enabledHint.article" : {
      "comment" : "VoiceOver hint of the Open the next article in pop-up button in a news feed's Feed Info.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يختار المكان الذي تُفتح فيه المقالة التالية من هذا الموجز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই ফিডের পরের নিবন্ধ কোথায় খুলবে তা বেছে নেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Legt fest, wo der nächste Artikel dieses Feeds geöffnet wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chooses where this feed's next article opens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige dónde se abre el siguiente artículo de este canal."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "انتخاب می‌کند مقاله‌ی بعدی این فید کجا باز شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisit où s’ouvre le prochain article de ce flux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בוחר היכן תיפתח הכתבה הבאה של הערוץ הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चुनता है कि इस फ़ीड का अगला लेख कहाँ खुले।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Memilih tempat artikel berikutnya dari feed ini dibuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sceglie dove si apre l’articolo successivo di questo feed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このフィードの次の記事を開く場所を選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 피드의 다음 기사를 열 위치를 선택합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kiest waar het volgende artikel van deze feed opent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wybiera, gdzie otwiera się następny artykuł tego kanału."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escolhe onde o próximo artigo deste feed abre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Выбирает, где откроется следующая статья этой ленты."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Väljer var det här flödets nästa artikel öppnas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เลือกตำแหน่งที่จะเปิดบทความถัดไปของฟีดนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu beslemenin sonraki makalesinin nerede açılacağını seçer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вибирає, де відкривається наступна стаття цієї стрічки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "منتخب کرتا ہے کہ اس فیڈ کا اگلا مضمون کہاں کھلے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chọn nơi mở bài viết tiếp theo của nguồn cấp này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "选取此订阅源的下一篇文章的打开位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選擇此訂閱源的下一篇文章要打開的位置。"
          }
        }
      }
    },
