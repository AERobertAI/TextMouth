    "The book is on the reading list, which this Mac keeps downloaded, so its download can't be removed." : {
      "comment" : "First sentence of why Remove Download was refused: the reading list keeps the book downloaded.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El libro está en la lista de lectura, que esta Mac mantiene descargada, así que no se puede quitar su descarga."
          }
        }
