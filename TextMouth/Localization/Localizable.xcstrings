    "bookCloudError.packageMissing" : {
      "comment" : "Why a book can't be used yet: its files have not arrived. %@ is the cloud service's name, or \"The cloud service\" when it is unknown.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ملفات الكتاب ليست على هذا الـ Mac بعد. ربما لا يزال %@ يزامنها."
