{
  "sourceLanguage" : "en",
  "strings" : {
    "\"%@\" is not a number." : {
      "comment" : "Message when the text typed in Go to Percent is no number. %@ is what the user typed, shown in quotation marks."
    },
    "\"%@\" plays the next book in the same folder by sort order." : {
      "comment" : "Explanation under the When book ends pop-up in the Playback settings. %@ is the title of the pop-up's choice that plays the next book, as the pop-up shows it."
    },
    "%@ %@" : {
      "comment" : "Announcement of the microphone level every few seconds while recording. %1$@ is the level's label and %2$@ is the level in words, such as \"minus 12 decibels, good\".\nJoins two whole sentences into one text. %1$@ is the first sentence and %2$@ the second. English puts a space between them; Japanese and Chinese join sentences with no space at all, so change only the separator.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ (%@)" : {
      "comment" : "The second choice of the Log location pop-up in the Storage settings. %1$@ is the choice's name, and %2$@ is the folder's name on this Mac, a path that stays as written, such as ~/Library/Logs/TextMouth.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@)"
          }
        }
      }
    },
    "%@ (current heading) - level %lld" : {
      "comment" : "What VoiceOver says for the heading being read, in the headings list. %1$@ is the heading's text; %2$lld is its level, 1 for the biggest heading.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (current heading) - level %2$lld"
          }
        }
      }
    },
    "%@ - level %lld" : {
      "comment" : "What VoiceOver says for a heading in the headings list. %1$@ is the heading's text; %2$lld is its level, 1 for the biggest heading.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ - level %2$lld"
          }
        }
      }
    },
    "%@ adds a bookmark at the current position." : {
      "comment" : "Help under \"No bookmarks yet.\" in the Bookmarks list. %@ is the keyboard shortcut that adds a bookmark, spelled out in words, such as Command + B.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ agrega un marcador en la posición actual."
          }
        }
      }
    },
    "%@ adds one at the current position." : {
      "comment" : "Help under \"No bookmarks yet.\" in the Bookmarks list, when the add command has no keyboard shortcut. %@ is the name of the Add Bookmark button above the list.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ agrega uno en la posición actual."
          }
        }
      }
    },
    "%@ at %@" : {
      "comment" : "An amount of time followed by the speed it counts at. %1$@ is the amount with its words, such as \"3:44:01 left\" or \"Total time: 4 hours\"; %2$@ is the speed, such as \"2.0x\", \"2.0 times speed\" or \"500 words a minute\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ at %2$@"
          }
        }
      }
    },
    "%@ by %@" : {
      "comment" : "The shared title and author of a group of duplicate books that match by both, in the group's heading. %1$@ is the title and %2$@ is the author.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ by %2$@"
          }
        }
      }
    },
    "%@ can't open while its edited text can't be used: %@" : {
      "comment" : "First part of the message a reader shows in place of a book whose edited text can't be used. %1$@ is the book's title; %2$@ is the reason, a clause that begins in lower case and ends with its full stop.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ can't open while its edited text can't be used: %2$@"
          }
        }
      }
    },
    "%@ deleted" : {
      "comment" : "Announcement after a substitution rule is deleted. %@ is the rule's name."
    },
    "%@ for This Book" : {
      "comment" : "Heading at the top of the reader's sheet for a book's own settings. %@ is the sheet's name, \"Audio Settings\" or \"Voice & Speed\"."
    },
    "%@ has its default, %@" : {
      "comment" : "Said in the row of a keyboard shortcut action that has lost its default key to another action. %1$@ is the name of the action that now has the key, and %2$@ is the key in words, such as \"Shift + Command + T\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has its default, %2$@"
          }
        }
      }
    },
    "%@ has no transcript text to search now, because %@" : {
      "comment" : "Said instead of opening Search in Book when the book's audio changed after its transcript was made. %1$@ is the book's title and %2$@ is the reason, a whole sentence that ends with its own full stop.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has no transcript text to search now, because %2$@"
          }
        }
      }
    },
    "%@ has no transcript text to search now, because its edited text can't be used: %@" : {
      "comment" : "Said instead of opening Search in Book when the book's edited transcript text was held back. %1$@ is the book's title and %2$@ is the reason, a whole sentence that ends with its own full stop.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has no transcript text to search now, because its edited text can't be used: %2$@"
          }
        }
      }
    },
    "%@ has no transcript text to search now." : {
      "comment" : "Said instead of opening Search in Book when a book's transcript text cannot be searched and no reason is known. %@ is the book's title."
    },
    "%@ has no transcript to search." : {
      "comment" : "Said instead of opening Search in Book for an audiobook that has no transcript, where TextMouth cannot make one. %@ is the book's title."
    },
    "%@ has no transcript to search. Transcribe it first, with Transcribe Audio." : {
      "comment" : "Said instead of opening Search in Book for an audiobook that has no transcript yet. %@ is the book's title. Transcribe Audio is the name of a command in the Book menu."
    },
    "%@ has no words, so the cursor is %@." : {
      "comment" : "Announcement after Go to Page when the page typed has no words of its own. %1$@ names the page, such as \"Page 7\" or \"The first page labelled 3\"; %2$@ says where the cursor is, such as \"on page 8\" or \"before page 1\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has no words, so the cursor is %2$@."
          }
        }
      }
    },
    "%@ is already in the reading list." : {
      "comment" : "VoiceOver announcement when Add to Reading List added nothing: the one book selected is on the list already. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ya está en la lista de lectura."
          }
        }
      }
    },
    "%@ is an audiobook without a transcript, so it has no text to edit." : {
      "comment" : "First sentence of the message when Edit Text is chosen for an audiobook with no transcript. %@ is the book's title."
    },
    "%@ is in a skipped section, so the cursor is %@." : {
      "comment" : "Announcement after Go to Page when every word of the page typed is in a skipped section. %1$@ names the page, such as \"Page 40\" or \"The first page labelled 3\"; %2$@ says where the cursor is, such as \"on page 52\" or \"before page 1\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is in a skipped section, so the cursor is %2$@."
          }
        }
      }
    },
    "%@ is no longer in the library." : {
      "comment" : "Announcement when the book of a search match has left the library since the search. %@ is the book's title."
    },
    "%@ isn't an audiobook of tracks, so it has no manifest to edit." : {
      "comment" : "Message when the user asks to edit the manifest of a book that is not an audiobook of tracks. %@ is the book's title."
    },
    "%@ isn't available, so TextMouth can't record from it. Choose another microphone." : {
      "comment" : "Error in the Record window when the chosen microphone is not available. %@ is the microphone's name."
    },
    "%@ isn't in the reading list." : {
      "comment" : "VoiceOver announcement when Remove from Reading List took nothing off: the one book selected is not on the list. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no está en la lista de lectura."
          }
        }
      }
    },
    "%@ left" : {
      "comment" : "Time left in the book as the reader's status row shows it. %@ is a clock time such as 3:44:01."
    },
    "%@ moved to position %@ of %@" : {
      "comment" : "Announcement after a substitution rule moves in the list. %1$@ is the rule's name, %2$@ is its new place counting from one, and %3$@ is how many rules the list holds.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ moved to position %2$@ of %3$@"
          }
        }
      }
    },
    "%@ not recorded for %@: %@" : {
      "comment" : "Announced by VoiceOver when a key cannot become a keyboard shortcut. %1$@ is the key in words, %2$@ is the action's name, and %3$@ is the reason, which starts in lower case.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ not recorded for %2$@: %3$@"
          }
        }
      }
    },
    "%@ not recording" : {
      "comment" : "Announcement of the microphone level while nothing is recording. %@ is the level's label."
    },
    "%@ now waits before %@, in case it is pressed twice." : {
      "comment" : "Announced by VoiceOver after a key's double press was given to an action: the key's single press now waits a moment before it acts, in case a second press follows. %1$@ is the key in words, such as \"J\", and %2$@ is the name of the action of its single press.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ now waits before %2$@, in case it is pressed twice."
          }
        }
      }
    },
    "%@ or %@" : {
      "comment" : "Joins two keyboard shortcuts of one action with \"or\", as in \"Space or K\". %1$@ is the shortcuts so far and %2$@ the next one.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ or %2$@"
          }
        }
      }
    },
    "%@ remaining" : {
      "comment" : "The sleep timer's state as VoiceOver reads it after \"Sleep timer:\" while it counts down. %@ is the time left in minutes and seconds, such as 4:59.\nTime left in the book as Where Am I? speaks it. %@ is the time in words, such as \"3 hours\".\nTime left in the book as the copied reading position shows it. %@ is a clock time such as 3:44:01.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "quedan %@"
          }
        }
      }
    },
    "%@ remaining at current speed" : {
      "comment" : "Time left in the book as the reader's status row speaks it when no speed is named: it counts at the speed now set. %@ is the time in words, such as \"3 hours, 44 minutes, 1 second\"."
    },
    "%@ remaining in this heading" : {
      "comment" : "Part of the full Where Am I? summary: the time left in the heading being read. %@ is the time in words, such as \"12 minutes\"."
    },
    "%@ reset to default: %@" : {
      "comment" : "Announced by VoiceOver after a keyboard shortcut action was given its default keys again. %1$@ is the action's name and %2$@ is its keys in words, such as \"Option + Shift + Command + B\", or \"No shortcut\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ reset to default: %2$@"
          }
        }
      }
    },
    "%@ seconds" : {
      "comment" : "A length of time in seconds with one decimal digit, such as \"0.5 seconds\". %@ is the already formatted number."
    },
    "%@ silent" : {
      "comment" : "Announcement of the microphone level when no sound reaches TextMouth. %@ is the level's label."
    },
    "%@ through the book" : {
      "comment" : "What VoiceOver says for the reader's percent button. %@ is the percent, such as 22.9%."
    },
    "%@ tries again, %@ quits without saving, %@ keeps TextMouth open." : {
      "comment" : "Last line of the alert's message, saying what each button does. %1$@ is the name of the first button, which tries saving again, %2$@ the name of the second, which quits without saving, and %3$@ the name of the third, which keeps TextMouth open. Keep each name exactly as the buttons show it.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ tries again, %2$@ quits without saving, %3$@ keeps TextMouth open."
          }
        }
      }
    },
    "%@ twice" : {
      "comment" : "A keyboard shortcut that is its key pressed twice quickly, as spoken or shown. %@ is the shortcut, such as \"W\" or \"Command + I\"."
    },
    "%@ uses it in the menus" : {
      "comment" : "The reason, said after \"not recorded\", why a key cannot be a shortcut: a command of the Mac's own menus uses it. %@ is that command's name, such as Quit TextMouth or Copy. Lower case in English, since it follows a colon."
    },
    "%@ was connected, so recordings use it." : {
      "comment" : "Said by the Record window when a microphone connects and recordings now use it. %@ is the microphone's name."
    },
    "%@ was connected; choose it in the %@ pop-up to record from it." : {
      "comment" : "Said by the Record window when one microphone connects and is added to the Microphone pop-up. %1$@ is the microphone's name and %2$@ is the pop-up's label.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ was connected; choose it in the %2$@ pop-up to record from it."
          }
        }
      }
    },
    "%@ was disconnected, so recording stopped. What was recorded is kept." : {
      "comment" : "Error in the Record window when the microphone was unplugged while recording. %@ is the microphone's name."
    },
    "%@ was disconnected, so recordings use %@." : {
      "comment" : "Said by the Record window when the chosen microphone is unplugged and another takes its place. %1$@ is the microphone that went away and %2$@ is the one recordings use now.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ was disconnected, so recordings use %2$@."
          }
        }
      }
    },
    "%@ was disconnected. Connect a microphone to record." : {
      "comment" : "Said by the Record window when the chosen microphone is unplugged and no other is connected. %@ is the microphone's name."
    },
    "%@ was not added back: no copy of the text its package held could be kept first, so TextMouth left the text as it was." : {
      "comment" : "Message when adding a book back to the library stopped because no backup of the text it held could be made. %@ is the book's title."
    },
    "%@ were connected; choose one in the %@ pop-up to record from it." : {
      "comment" : "Said by the Record window when several microphones connect and are added to the Microphone pop-up. %1$@ is their names as a list and %2$@ is the pop-up's label.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ were connected; choose one in the %2$@ pop-up to record from it."
          }
        }
      }
    },
    "%@ works in %@." : {
      "comment" : "Announced by VoiceOver after the listener chose where a keyboard shortcut works. %1$@ is the action's name and %2$@ names the windows, such as \"every window\" or \"Library windows\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ works in %2$@."
          }
        }
      }
    },
    "%@, %@" : {
      "comment" : "A heading's description followed by a detail such as its duration. %1$@ is the description, such as \"Chapter One - level 1\"; %2$@ is the detail, such as \"4 minutes\".\nJoins two parts of a label with a comma. %1$@ is the text so far and %2$@ the next part. English puts a comma and a space between them.\nThe microphone level spoken in the Record window. %1$@ is the level in decibels in words, such as \"minus 12 decibels\", and %2$@ is a word for how loud that is, such as \"good\".\nThe right side of a row in the Library views settings: whether the view is built in or custom, then when it shows. %1$@ is built in or custom and %2$@ is its visibility, such as \"always\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%@, %@ quality" : {
      "comment" : "VoiceOver label of a voice in the voice pop-up. %1$@ is the voice's name and %2$@ is its quality, such as Enhanced.\nWhat VoiceOver says for a voice in the voice sheet's menu. %1$@ is the voice's name; %2$@ is its quality, such as Enhanced.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@ quality"
          }
        }
      }
    },
    "%@, %@, in %@" : {
      "comment" : "VoiceOver label of a search match: the match in its text, where it is in the book, then the book. %1$@ is the match in its surrounding text, %2$@ is its place, such as a chapter's title, and %3$@ is the book's title.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@, in %3$@"
          }
        }
      }
    },
    "%@, and %lld in all" : {
      "comment" : "Note on a finished search's status: the list also stops after this many matches in all. %1$@ is the note \"showing up to 20 in each book\", and %2$lld is the number of matches shown in all.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@, and %lld in all"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@, and %lld in all"
                }
              }
            }
          }
        }
      }
    },
    "%@, at %@" : {
      "comment" : "VoiceOver label and rotor entry of a search result in a transcribed audiobook. %1$@ is the match with its context and place, and %2$@ is the time it is heard, spoken.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, at %2$@"
          }
        }
      }
    },
    "%@, at %@ into book" : {
      "comment" : "VoiceOver label of a search result placed by an estimated time. %1$@ is the match with its context and place, and %2$@ is the time into the book, spoken.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, at %2$@ into book"
          }
        }
      }
    },
    "%@, at %@ percent of book" : {
      "comment" : "VoiceOver label of a search result placed by percentage. %1$@ is the match with its context and place, and %2$@ is the percentage through the book with one decimal digit, such as 12.5.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, at %2$@ percent of book"
          }
        }
      }
    },
    "%@, by %@" : {
      "comment" : "A book's title and author in a search result's heading. %1$@ is the book's title and %2$@ its author.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, by %2$@"
          }
        }
      }
    },
    "%@, by %@, %@, in %@, added %@" : {
      "comment" : "A duplicate book's row, spoken and shown as one label in Find Duplicate Books. %1$@ is the title, %2$@ the author, %3$@ the format, %4$@ the library folder it is in, and %5$@ the date it was added.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, by %2$@, %3$@, in %4$@, added %5$@"
          }
        }
      }
    },
    "%@, edited by hand" : {
      "comment" : "What VoiceOver says for a field of the book information sheet that the user edited by hand. %@ is the field's name, such as \"Book title\"."
    },
    "%@, in %@" : {
      "comment" : "VoiceOver label of a search match whose place in the book is unknown. %1$@ is the match in its surrounding text, and %2$@ is the book's title.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, in %2$@"
          }
        }
      }
    },
    "%@, recorded for %@" : {
      "comment" : "Announced by VoiceOver after a key became a keyboard shortcut. %1$@ is the key in words, such as \"Shift + R\" or \"W twice\", and %2$@ is the action's name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, recorded for %2$@"
          }
        }
      }
    },
    "%@, then %@" : {
      "comment" : "Joins two steps of the restart gesture's summary in the Miscellaneous settings. %1$@ is the steps so far and %2$@ is the next step, such as \"Previous track, then Play\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, then %2$@"
          }
        }
      }
    },
    "%@." : {
      "comment" : "Ends a sentence with its full stop. %@ is the sentence without it. Chinese and Japanese use their own full stop here."
    },
    "%@:" : {
      "comment" : "Caption beside the headings sheet's level filter. %@ is the filter's label; the colon follows it as the language writes a label before a control."
    },
    "%@: %@" : {
      "comment" : "A label and its value on one line, such as \"Elapsed: 1:04\". %1$@ is the label and %2$@ its value. English puts a colon and a space between them.\nA name, a colon, and its value, such as a keyboard shortcut action's name and its keys, or a control's label and its value. %1$@ is the name and %2$@ is the value.\nThe name of a keyboard shortcut action with the name of its group before it, such as an audio editor action. %1$@ is the group's name and %2$@ the action's own name.\nTitle of a reader window for a book whose author is unknown. %1$@ is the word that begins it (\"Book\" or \"Reading List\"); %2$@ is the book's title.\nTitle of the reader's sheet for a book's own settings. %1$@ is the sheet's name, \"Audio Settings\" or \"Voice & Speed\"; %2$@ is the book's title.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@"
          }
        }
      }
    },
    "%@: %@ by %@" : {
      "comment" : "Title of a reader window. %1$@ is the word that begins it (\"Book\" or \"Reading List\"); %2$@ is the book's title; %3$@ is the book's author.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@ by %3$@"
          }
        }
      }
    },
    "%@: %@ dB peak, %@ dB average, %@" : {
