    "libraryIndexRecoveryError.couldNotPreserve" : {
      "comment" : "First sentence of why Rebuild Library Index replaced nothing. %@ is the file's path.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّر على TextMouth حفظ نسخة من %@، لذا ترك ذلك الملف دون تغيير."
