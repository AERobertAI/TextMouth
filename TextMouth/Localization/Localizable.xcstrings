    "folderOperationConflict.invalidName" : {
      "comment" : "Error shown when a folder's new name is refused: the name is empty, is a single or double dot, ends in .tmb, or is one TextMouth keeps for itself. The quoted pieces are literal text.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يمكن أن يكون اسم المجلد فارغًا أو “.” أو “..”، أو ينتهي بـ “.tmb”، أو يكون محجوزًا لـ TextMouth."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফোল্ডারের নাম খালি হতে পারে না, “.” বা “..” হতে পারে না, “.tmb” দিয়ে শেষ হতে পারে না, এবং TextMouth-এর সংরক্ষিত নাম হতে পারে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Ordnername darf nicht leer, „.“ oder „..“ sein, nicht auf „.tmb“ enden und nicht von TextMouth reserviert sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A folder name can't be empty, \".\" or \"..\", end in \".tmb\", or be reserved by TextMouth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El nombre de una carpeta no puede estar vacío, ser \".\" ni \"..\", terminar en \".tmb\" ni estar reservado por TextMouth."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نام پوشه نمی‌تواند خالی، «.» یا «..» باشد، به «.tmb» ختم شود یا از نام‌های رزروشده‌ی TextMouth باشد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le nom d’un dossier ne peut pas être vide, « . » ou « .. », se terminer par « .tmb », ni être réservé par TextMouth."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "שם תיקייה לא יכול להיות ריק, “.” או “..”, להסתיים ב-“.tmb” או להיות שמור ל-TextMouth."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ोल्डर का नाम खाली, “.” या “..” नहीं हो सकता, “.tmb” पर समाप्त नहीं हो सकता, और TextMouth के लिए आरक्षित नहीं हो सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nama folder tidak boleh kosong, berupa “.” atau “..”, berakhiran “.tmb”, atau dicadangkan oleh TextMouth."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il nome di una cartella non può essere vuoto, “.” o “..”, terminare con “.tmb” né essere riservato da TextMouth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フォルダ名には、空の名前、「.」、「..」、「.tmb」で終わる名前、TextMouth が予約している名前は使えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "폴더 이름은 비어 있거나 “.” 또는 “..”이거나 “.tmb”로 끝나거나 TextMouth가 예약한 이름일 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De naam van een map mag niet leeg zijn, “.” of “..” zijn, op “.tmb” eindigen of door TextMouth gereserveerd zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nazwa folderu nie może być pusta, nie może mieć postaci „.” ani „..”, nie może kończyć się na „.tmb” ani być zarezerwowana przez TextMouth."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O nome de uma pasta não pode ser vazio, “.” ou “..”, terminar em “.tmb” nem ser reservado pelo TextMouth."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Имя папки не может быть пустым, равным «.» или «..», оканчиваться на «.tmb» или быть зарезервированным в TextMouth."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En mapps namn kan inte vara tomt, ”.” eller ”..”, sluta på ”.tmb” eller vara reserverat av TextMouth."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ชื่อโฟลเดอร์ต้องไม่ว่างเปล่า ไม่ใช่ “.” หรือ “..” ไม่ลงท้ายด้วย “.tmb” และไม่ใช่ชื่อที่ TextMouth สงวนไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Klasör adı boş, “.” veya “..” olamaz, “.tmb” ile bitemez ve TextMouth tarafından ayrılmış olamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Назва папки не може бути порожньою, «.» чи «..», закінчуватися на «.tmb» або бути зарезервованою TextMouth."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فولڈر کا نام خالی، “.” یا “..” نہیں ہو سکتا، “.tmb” پر ختم نہیں ہو سکتا، اور TextMouth کے لیے مخصوص نام بھی نہیں ہو سکتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tên thư mục không được để trống, là \".\" hoặc \"..\", kết thúc bằng \".tmb\", hay là tên TextMouth đã dành riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文件夹名称不能为空，不能是“.”或“..”，不能以“.tmb”结尾，也不能是 TextMouth 保留的名称。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "檔案夾名稱不能為空、不能是「.」或「..」、不能以「.tmb」結尾，也不能是 TextMouth 保留的名稱。"
          }
        }
      }
    },
    "folderOperationConflict.invalidPath.changed" : {
      "comment" : "Error shown when a folder edit is refused because the folder has no name on record.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ليس لهذا المجلد اسم مخزّن، لذا لا يمكن تغييره بأمان."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই ফোল্ডারের কোনো সংরক্ষিত নাম নেই, তাই এটি নিরাপদে পরিবর্তন করা যায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieser Ordner hat keinen gespeicherten Namen und kann daher nicht sicher geändert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This folder has no stored name, so it cannot be changed safely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta carpeta no tiene un nombre guardado, así que no se puede cambiar de forma segura."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "این پوشه نام ذخیره‌شده‌ای ندارد، بنابراین نمی‌توان آن را به‌طور ایمن تغییر داد."
          }
        },
        "fr" : {
