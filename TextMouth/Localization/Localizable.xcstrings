    },
    "TextMouth stopped %@ because %@, and won't try again until TextMouth is closed and opened again." : {
      "comment" : "Said when a library call inside the iPhone app ran too long and was abandoned. %1$@ is the work's name, such as \"the braille translation\" (English until its area converts); %2$@ is why it was stopped, such as \"it ran longer than 11 seconds\" (English until the watchdog's area converts). Read after an import's own words.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth hat %1$@ gestoppt, weil %2$@, und versucht es erst wieder, wenn TextMouth beendet und neu geöffnet wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TextMouth stopped %1$@ because %2$@, and won't try again until TextMouth is closed and opened again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth detuvo %1$@ porque %2$@, y no volverá a intentarlo hasta que cierres y vuelvas a abrir TextMouth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth a arrêté %1$@ parce que %2$@, et ne réessaiera pas avant que TextMouth soit fermé puis rouvert."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ने %1$@ रोक दिया क्योंकि %2$@, और TextMouth बंद करके दोबारा खोलने तक फिर प्रयास नहीं करेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth menghentikan %1$@ karena %2$@, dan tidak akan mencoba lagi sampai TextMouth ditutup dan dibuka kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ha interrotto %1$@ perché %2$@, e non riproverà finché TextMouth non verrà chiuso e riaperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は%1$@を中止しました。理由：%2$@。TextMouth を閉じてもう一度開くまで、再試行しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 %2$@ 때문에 %1$@을(를) 중지했으며, TextMouth를 닫았다가 다시 열 때까지 다시 시도하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth interrompeu %1$@ porque %2$@, e não tentará novamente até ser fechado e aberto outra vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth остановил %1$@, потому что %2$@, и не будет пробовать снова, пока TextMouth не будет закрыт и открыт заново."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth зупинив %1$@, тому що %2$@, і не спробує знову, доки TextMouth не буде закрито й відкрито знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 已停止 %1$@，因为 %2$@，在 TextMouth 关闭并重新打开之前不会重试。"
          }
        }
      }
    },
    "TextMouth stopped %@ earlier because it took too long, and won't try again until TextMouth is closed and opened again." : {
      "comment" : "Said when a library call inside the iPhone app is refused because an earlier one was abandoned for taking too long. %@ is the work's name, such as \"the braille translation\" (English until its area converts). Read after an import's own words.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth hat %@ zuvor gestoppt, weil es zu lange dauerte, und versucht es erst wieder, wenn TextMouth beendet und neu geöffnet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth detuvo antes %@ porque tardaba demasiado, y no volverá a intentarlo hasta que cierres y vuelvas a abrir TextMouth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth a arrêté %@ plus tôt parce que cela prenait trop de temps, et ne réessaiera pas avant que TextMouth soit fermé puis rouvert."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ने %@ पहले इसलिए रोक दिया था क्योंकि उसमें बहुत समय लग रहा था, और TextMouth बंद करके दोबारा खोलने तक फिर प्रयास नहीं करेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth menghentikan %@ sebelumnya karena terlalu lama, dan tidak akan mencoba lagi sampai TextMouth ditutup dan dibuka kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ha interrotto %@ prima perché richiedeva troppo tempo, e non riproverà finché TextMouth non verrà chiuso e riaperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は、先に%@に時間がかかりすぎて中止したため、TextMouth を閉じてもう一度開くまで再試行しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 %@을(를) 너무 오래 걸려 이전에 중지했으며, TextMouth를 닫았다가 다시 열 때까지 다시 시도하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth interrompeu %@ antes porque demorou demais, e não tentará novamente até ser fechado e aberto outra vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ранее остановил %@, потому что операция заняла слишком много времени, и не будет пробовать снова, пока TextMouth не будет закрыт и открыт заново."
          }
        },
