    "it has %@, where the audiobook has %@. Keep every line beginning with <!-- chapter: and save again, and the text shows." : {
      "comment" : "Reason after a colon: the edited transcript's number of chapters no longer matches the audiobook's; begins in lower case. %1$@ and %2$@ are counts of chapters such as \"3 chapters\". \"<!-- chapter:\" is literal text in the file and stays exactly as written.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فيه %1$@، بينما في الكتاب الصوتي %2$@. أبقِ كل سطر يبدأ بـ <!-- chapter: واحفظ مرة أخرى، فيظهر النص."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "es enthält %1$@, das Hörbuch aber %2$@. Behalte jede Zeile, die mit <!-- chapter: beginnt, und sichere erneut, dann wird der Text angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "it has %1$@, where the audiobook has %2$@. Keep every line beginning with <!-- chapter: and save again, and the text shows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "tiene %1$@, mientras que el audiolibro tiene %2$@. Conserva cada línea que empieza con <!-- chapter: y guarda de nuevo, y el texto se mostrará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "il contient %@, alors que le livre audio en contient %@. Conservez chaque ligne commençant par <!-- chapter: et enregistrez à nouveau, et le texte s’affiche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "उसमें %1$@ हैं, जबकि ऑडियोबुक में %2$@ हैं। <!-- chapter: से शुरू होने वाली हर पंक्ति को बनाए रखें और फिर से सहेजें, तब टेक्स्ट दिखेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "teks itu memiliki %1$@, sedangkan buku audio memiliki %2$@. Pertahankan setiap baris yang diawali <!-- chapter: lalu simpan lagi, maka teks akan tampil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "la trascrizione ha %@, ma l’audiolibro ne ha %@. Conserva ogni riga di capitolo che inizia con <!-- chapter: e salva di nuovo, e il testo viene mostrato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文字起こしは%1$@ですが、オーディオブックは%2$@です。 <!-- chapter: で始まる行をすべて残してもう一度保存すると、テキストが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "챕터가 %1$@인데 오디오북은 %2$@입니다. <!-- chapter: 로 시작하는 줄을 모두 그대로 두고 다시 저장하면 텍스트가 표시됩니다."
          }
