        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo leer texto del PDF: no tiene texto incrustado y el OCR no pudo ejecutarse (%@)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "متنی از PDF خوانده نشد: متن جاسازی‌شده ندارد و OCR اجرا نشد (%@)."
