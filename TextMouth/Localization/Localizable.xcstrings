    "sync.keepHint" : {
      "comment" : "VoiceOver hint of the Kept on all devices checkbox in Book Information.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "كل جهاز يزامن يحتفظ بملفات هذا الكتاب ويُنزّلها عندما يستطيع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সিঙ্ক করা প্রতিটি ডিভাইস এই বইয়ের ফাইল রাখে এবং পারলে ডাউনলোড করে নেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jedes Gerät, das synchronisiert, behält die Dateien dieses Buchs und lädt sie herunter, wenn es kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every device that syncs keeps this book's files, and downloads them when it can."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Todos los dispositivos que sincronizan mantienen los archivos de este libro y los descargan cuando pueden."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هر دستگاهی که همگام می‌کند فایل‌های این کتاب را نگه می‌دارد و در صورت امکان بارگیری می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chaque appareil qui se synchronise conserve les fichiers de ce livre et les télécharge dès qu’il le peut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כל מכשיר שמסנכרן שומר את הקבצים של ספר זה ומוריד אותם כשאפשר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सिंक करने वाला हर डिवाइस इस पुस्तक की फ़ाइलें रखता है और संभव होने पर उन्हें डाउनलोड करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Setiap perangkat yang menyinkronkan menyimpan file buku ini dan mengunduhnya jika bisa."
