          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مکان‌نما را یک ثانیه عقب می‌برد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Recule le curseur d’une seconde."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מזיז את הסמן אחורה שנייה אחת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कर्सर को एक सेकंड पीछे ले जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
