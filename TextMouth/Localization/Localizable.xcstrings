    "textEncoding.failedRefusal.withReason" : {
      "comment" : "Why a book was not read again with another encoding or braille code: the reading failed. %1$@ is the book's title and %2$@ is the reason in English, as the reader worded it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يتمكن TextMouth من قراءة “%1$@” مرة أخرى، فترك الكتاب كما كان: %2$@"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth “%1$@” আবার পড়তে পারেনি, তাই বইটি যেমন ছিল তেমনই রেখেছে: %2$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth konnte „%1$@“ nicht erneut lesen und hat das Buch unverändert gelassen: %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth couldn't read “%@” again, so it left the book as it was: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no pudo volver a leer “%1$@”, así que dejó el libro como estaba: %2$@"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth نتوانست «%@» را دوباره بخواند، بنابراین کتاب را همان‌طور که بود گذاشت: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth n’a pas pu relire « %@ », donc il a laissé le livre tel quel : %@"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth לא הצליח לקרוא שוב את “%1$@”, ולכן השאיר את הספר כפי שהיה: %2$@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth “%1$@” को फिर से नहीं पढ़ सका, इसलिए उसने पुस्तक जैसी थी वैसी ही छोड़ दी: %2$@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tidak dapat membaca “%@” ulang, jadi buku dibiarkan seperti semula: %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non è riuscito a rileggere “%@”, quindi ha lasciato il libro com’era: %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は「%1$@」を読み込み直せなかったため、ブックをそのままにしました：%2$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 “%1$@”을(를) 다시 읽지 못해 책을 그대로 두었습니다: %2$@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kon “%@” niet opnieuw lezen, dus blijft het boek zoals het was: %@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth nie mógł ponownie odczytać „%1$@”, więc pozostawił książkę bez zmian: %2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não conseguiu ler “%1$@” novamente, então deixou o livro como estava: %2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не удалось прочитать «%1$@» заново, поэтому книга оставлена как была: %2$@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kunde inte läsa ”%@” igen, så boken lämnades som den var: %@"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth อ่าน “%1$@” ใหม่ไม่ได้ จึงปล่อยหนังสือไว้ตามเดิม: %2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth “%1$@” kitabını yeniden okuyamadı, bu yüzden kitabı olduğu gibi bıraktı: %2$@"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не вдалося знову прочитати «%1$@», тому книгу залишено без змін: %2$@"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth “%1$@” کو دوبارہ نہیں پڑھ سکا، اس لیے اس نے کتاب جیسی تھی ویسی ہی رہنے دی: %2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth không thể đọc lại “%1$@”, nên đã để nguyên cuốn sách: %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 无法重新读取“%1$@”，因此图书保持原样：%2$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 無法重新讀取「%1$@」，因此書籍維持原樣：%2$@"
          }
        }
      }
    },
