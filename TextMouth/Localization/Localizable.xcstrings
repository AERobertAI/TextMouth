    "%@ hasn't said that every file of this book is uploaded, so its download can't be removed: the only copy might be on this Mac." : {
      "comment" : "First sentence of why Remove Download was refused: the cloud service gave no upload state. %@ is the cloud service's name, or \"The cloud service\" when it is unknown.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ hat nicht gemeldet, dass jede Datei dieses Buchs hochgeladen ist, daher kann der Download nicht entfernt werden: Die einzige Kopie könnte auf diesem Mac liegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no ha indicado que todos los archivos de este libro estén subidos, así que no se puede quitar su descarga: la única copia podría estar en esta Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ n’a pas indiqué que tous les fichiers de ce livre sont envoyés ; son téléchargement ne peut donc pas être retiré : la seule copie se trouve peut-être sur ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ non ha confermato che ogni file di questo libro è stato caricato, quindi il suo download non può essere rimosso: l’unica copia potrebbe trovarsi su questo Mac."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ não informou que todos os arquivos deste livro foram enviados; por isso, o download não pode ser removido: a única cópia pode estar neste Mac."
          }
        }
      }
    },
    "%@ hasn't said that the copy of this book on this Mac is the latest, so its download can't be removed." : {
      "comment" : "First sentence of why Remove Download was refused: the cloud service has not said the copy here is current. %@ is the cloud service's name, or \"The cloud service\" when it is unknown.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ hat nicht gemeldet, dass die Kopie dieses Buchs auf diesem Mac die neueste ist, daher kann der Download nicht entfernt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no ha indicado que la copia de este libro en esta Mac sea la más reciente, así que no se puede quitar su descarga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ n’a pas indiqué que la copie de ce livre sur ce Mac est la plus récente ; son téléchargement ne peut donc pas être retiré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ non ha confermato che la copia di questo libro su questo Mac è la più recente, quindi il suo download non può essere rimosso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ não informou que a cópia deste livro neste Mac é a mais recente; por isso, o download não pode ser removido."
          }
        }
      }
    },
    "%@ holds a conflicting version of %@, saved at another time." : {
      "comment" : "First sentence of the report of an unresolved version of a file whose computer and time of saving are not known. %1$@ is the sync service's name; %2$@ is a phrase naming the file.",
