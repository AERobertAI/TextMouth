          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth लाइब्रेरी के लिए इस Mac को ज्ञात पहचान के साथ %@ लिखता है, और उसे खोलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth menulis %@ dengan identitas yang diketahui Mac ini untuk pustaka, dan membukanya."
