    },
    "There's no library in %@ to use, and none to move there while the library isn't available." : {
      "comment" : "First sentence of why the chosen folder can't be used: it holds no library and there is none to move. %@ is the folder's path.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay ninguna biblioteca en %@ que usar, ni ninguna que trasladar allí mientras la biblioteca no está disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
