    "bookExport.stopHint" : {
      "comment" : "The hint of the Stop button in the Export dialog.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يوقف التصدير. لا يُحتفظ بالملف الجاري إنشاؤه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "রপ্তানি বন্ধ করে। তৈরি হতে থাকা ফাইলটি রাখা হয় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppt den Export. Die Datei, die gerade erstellt wird, wird nicht behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops the export. The file being made is not kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
