    "miscellaneousSettings.patternExplanation" : {
      "comment" : "Explanation under the restart gesture's pattern heading in the Miscellaneous settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أحداث التحكم في الوسائط التي تُطلق إعادة التشغيل. يُستهلك الأخير ولا يُمرَّر إلى التشغيل، لذا لا يمكنه بدء الصوت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "রিস্টার্ট চালু করে এমন মিডিয়া-নিয়ন্ত্রণ ঘটনা। শেষটি গ্রহণ করে নেওয়া হয়, প্লেব্যাকে পাঠানো হয় না, তাই এটি অডিও চালু করতে পারে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Medientasten-Ereignisse, die den Neustart auslösen. Das letzte wird verbraucht und nicht an die Wiedergabe weitergegeben, kann also kein Audio starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Media-control events that trigger the restart. The last one is consumed, not passed to playback, so it can't start audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eventos de control multimedia que activan el reinicio. El último se consume y no se pasa a la reproducción, así que no puede iniciar el audio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "رویدادهای کنترل رسانه که شروع دوباره را فعال می‌کنند. آخرین رویداد مصرف می‌شود و به پخش داده نمی‌شود، بنابراین نمی‌تواند صدا را شروع کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Événements de commande multimédia qui déclenchent le redémarrage. Le dernier est consommé et non transmis à la lecture, il ne peut donc pas démarrer l’audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אירועי פקדי מדיה שמפעילים את ההפעלה מחדש. האחרון נצרך ולא מועבר לניגון, ולכן הוא לא יכול להפעיל שמע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "वे मीडिया-कंट्रोल इवेंट जो रीस्टार्ट शुरू करते हैं। आख़िरी इवेंट प्लेबैक को नहीं भेजा जाता, इसलिए वह ऑडियो शुरू नहीं कर सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Peristiwa kontrol media yang memicu mulai ulang. Yang terakhir ditahan dan tidak diteruskan ke pemutaran, jadi tidak dapat memulai audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eventi di controllo multimediale che avviano il riavvio. L’ultimo viene consumato e non passato alla riproduzione, quindi non può avviare l’audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "再開のきっかけになるメディアコントロールのイベントです。最後の1つは再生に渡されず消費されるため、音声は開始されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "타이머를 다시 시작하는 미디어 제어 이벤트입니다. 마지막 이벤트는 재생에 전달되지 않고 소비되므로 오디오를 시작할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mediabedieningsgebeurtenissen die de herstart activeren. De laatste wordt opgevangen en niet doorgegeven aan het afspelen, zodat hij geen audio kan starten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zdarzenia sterowania multimediami, które uruchamiają restart. Ostatnie jest pochłaniane i nie trafia do odtwarzania, więc nie może uruchomić dźwięku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eventos de controle de mídia que acionam o reinício. O último é consumido e não é passado à reprodução, então não pode iniciar o áudio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "События управления медиа, запускающие перезапуск. Последнее поглощается и не передаётся воспроизведению, поэтому не может запустить звук."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mediekontrollhändelser som utlöser omstarten. Den sista förbrukas och skickas inte vidare till uppspelningen, så den kan inte starta ljud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เหตุการณ์การควบคุมสื่อที่ทำให้เริ่มใหม่ เหตุการณ์สุดท้ายจะถูกใช้ไปและไม่ส่งต่อไปยังการเล่น จึงเริ่มเสียงไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yeniden başlatmayı tetikleyen medya denetimi olayları. Sonuncusu oynatmaya iletilmez, tüketilir; bu yüzden sesi başlatamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Події медіакерування, що запускають перезапуск. Остання з них поглинається й не передається відтворенню, тому не може запустити звук."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "وہ میڈیا کنٹرول ایونٹس جن سے ری اسٹارٹ ہوتا ہے۔ آخری ایونٹ استعمال ہو جاتا ہے، پلے بیک کو نہیں بھیجا جاتا، اس لیے وہ آڈیو شروع نہیں کر سکتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Các sự kiện điều khiển phương tiện kích hoạt việc khởi động lại. Sự kiện cuối cùng được giữ lại, không chuyển đến phát lại, nên không thể bắt đầu phát âm thanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "触发重启的媒体控制事件。最后一个事件会被拦截，不会传给播放功能，因此无法启动音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "觸發重新啟動的媒體控制事件。最後一個事件會被攔截，不會傳給播放功能，因此無法啟動音訊。"
          }
        }
      }
    },
