            }
          }
        },
        "it" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Questo libro ha %1$lld di pagine, da %2$@ a %3$@."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Questo libro ha %1$lld pagina, da %2$@ a %3$@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Questo libro ha %1$lld pagine, da %2$@ a %3$@."
                }
              }
            }
