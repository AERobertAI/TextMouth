    "substitutions.resetConfirmationMessage.changed" : {
      "comment" : "Last sentence of the message of the question asked before the Substitutions settings replace every rule with the defaults.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ستفقد القواعد التي أضفتها أو غيّرتها."
          }
        },
        "bn" : {
          "stringUnit" : {
