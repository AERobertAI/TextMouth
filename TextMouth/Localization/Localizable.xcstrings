            "value" : "ستُرفع مكتبتك إلى %@ في الخلفية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আপনার লাইব্রেরি ব্যাকগ্রাউন্ডে %@-এ আপলোড হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
