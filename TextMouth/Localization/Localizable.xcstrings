    "None of the %lld chapters could be read" : {
      "comment" : "Starts the warning after an import where none of a book's chapters could be read. %lld is how many chapters the book has, always two or more. Has no full stop.",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
