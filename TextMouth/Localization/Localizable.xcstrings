    "TextMouth attaches WebVTT (.vtt) and SubRip (.srt) files." : {
      "comment" : "Alert explaining why a chosen file was not attached as a transcript. WebVTT and SubRip are subtitle file formats, and .vtt and .srt their file extensions.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يرفق TextMouth ملفات بصيغة WebVTT (.vtt) أو SubRip (.srt) فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth hängt WebVTT-Dateien (.vtt) und SubRip-Dateien (.srt) an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth adjunta archivos WebVTT (.vtt) y SubRip (.srt)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth joint des fichiers WebVTT (.vtt) et SubRip (.srt)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth WebVTT (.vtt) और SubRip (.srt) फ़ाइलें संलग्न करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth melampirkan file WebVTT (.vtt) dan SubRip (.srt)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth allega file WebVTT (.vtt) e SubRip (.srt)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth が添付できるのは、WebVTT（.vtt）と SubRip（.srt）のファイルです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth는 WebVTT(.vtt) 및 SubRip(.srt) 파일을 첨부할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth anexa arquivos WebVTT (.vtt) e SubRip (.srt)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth прикрепляет файлы WebVTT (.vtt) и SubRip (.srt)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth прикріплює файли WebVTT (.vtt) і SubRip (.srt)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 可附加 WebVTT（.vtt）和 SubRip（.srt）文件。"
          }
        }
      }
    },
    "TextMouth can't convert %@ files because its converter is missing from the app." : {
      "comment" : "Why a file was not imported: the converter TextMouth carries is missing from the app, which only a damaged copy is. %@ is the name of the file's format, such as WMA or Matroska. Advice to install the app again follows.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kann %@-Dateien nicht umwandeln, weil das Umwandlungsprogramm in der App fehlt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede convertir archivos %@ porque falta su conversor en la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ne peut pas convertir les fichiers %@, car son convertisseur est absent de l’app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth %@ फ़ाइलें नहीं बदल सकता क्योंकि उसका कनवर्टर ऐप से गायब है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tidak dapat mengonversi file %@ karena konverternya tidak ada di app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non può convertire i file %@ perché il suo convertitore manca nell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "コンバータがアプリにないため、TextMouth は%@ファイルを変換できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "변환기가 앱에 없으므로 TextMouth가 %@ 파일을 변환할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não consegue converter arquivos %@ porque o conversor dele está ausente do app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не может преобразовать файлы %@, потому что его конвертер отсутствует в приложении."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не може перетворювати файли %@, бо в застосунку немає його перетворювача."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 无法转换 %@ 文件，因为其转换器已从 App 中丢失。"
          }
        }
      }
    },
    "TextMouth can't convert the sound of “%@”: it is in a kind of audio it does not read." : {
      "comment" : "Why a file was not imported: its sound is in a codec TextMouth does not decode. %@ is the file's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kann den Ton von „%@“ nicht umwandeln: Er liegt in einer Audioart vor, die TextMouth nicht liest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede convertir el sonido de “%@”: está en un tipo de audio que no lee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ne peut pas convertir le son de « %@ » : il est dans un type d’audio qu’il ne lit pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth “%@” की ध्वनि नहीं बदल सकता: वह ऐसे ऑडियो प्रकार में है जिसे वह नहीं पढ़ता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tidak dapat mengonversi suara “%@”: suaranya berjenis audio yang tidak dapat dibaca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non può convertire l’audio di “%@”: è in un tipo di audio che non legge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は「%@」の音声を変換できません。対応していない種類のオーディオです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 “%@”의 사운드를 변환할 수 없습니다. 지원하지 않는 종류의 오디오입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não consegue converter o som de “%@”: ele está em um tipo de áudio que o app não lê."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не может преобразовать звук «%@»: он в формате, который TextMouth не читает."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не може перетворити звук файлу «%@»: це вид аудіо, який він не читає."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 无法转换“%@”的声音：它属于 TextMouth 无法读取的一种音频。"
          }
        }
      }
    },
    "TextMouth can't convert “%@”: its sound changes rate or channels partway through, by more than it can follow." : {
      "comment" : "Why a file was not imported: its sound changes its sample rate or its number of channels partway through, by more than the converter can follow. %@ is the file's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kann „%@“ nicht umwandeln: Die Samplerate oder die Anzahl der Kanäle ändert sich mittendrin stärker, als es folgen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede convertir “%@”: su sonido cambia de frecuencia o de canales a mitad del archivo, más de lo que puede seguir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ne peut pas convertir « %@ » : la fréquence ou le nombre de canaux de son audio change en cours de route, plus qu’il ne peut suivre."
