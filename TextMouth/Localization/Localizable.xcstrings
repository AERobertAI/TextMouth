    "feedFetchError.message.constrainedNetwork" : {
      "comment" : "Why a feed's automatic refresh did not run now: the network has data limits. %@ is the feed's title or server.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ينتظر %@ شبكة بلا حدود للبيانات ليتحدّث من تلقاء نفسه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ নিজে থেকে রিফ্রেশ হতে ডেটা সীমাহীন নেটওয়ার্কের অপেক্ষায় আছে।"
          }
