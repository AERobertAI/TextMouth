    "libraryBookInfo.writeRefusal.downloaded" : {
      "comment" : "First sentence of the message when Save in Book Information is refused because the book's EPUB file is only in the cloud, and writing to the file is on. EPUB is a format name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ملف EPUB للكتاب موجود في السحابة فقط، لذا لا يمكن الكتابة فيه إلى أن يتم تنزيل الكتاب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইয়ের EPUB ফাইলটি শুধু ক্লাউডে আছে, তাই বইটি ডাউনলোড না হওয়া পর্যন্ত এটি লেখা যাবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die EPUB-Datei des Buchs ist nur in der Cloud und kann daher erst geschrieben werden, wenn das Buch heruntergeladen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The book's EPUB file is only in the cloud, so it can't be written until the book is downloaded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo EPUB del libro está solo en la nube, así que no se puede escribir hasta que se descargue el libro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فایل EPUB کتاب فقط در فضای ابری است، بنابراین تا بارگیری کتاب نمی‌توان آن را نوشت."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le fichier EPUB du livre n’est que dans le cloud, donc il ne peut pas être écrit avant que le livre soit téléchargé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "קובץ ה-EPUB של הספר נמצא רק בענן, ולכן אי אפשר לכתוב אליו עד להורדת הספר."
