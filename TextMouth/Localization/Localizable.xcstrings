    "libraryViewModel.removalRecordLeftHeading.stays" : {
      "comment" : "Heading of the error alert's list when Remove from Library Only removed one book but could not delete the bookInfo.json file in its package. bookInfo.json is a file name. The book's title and the reason follow on the next line.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أُزيل هذا الكتاب من المكتبة، لكن تعذّر حذف ملف bookInfo.json الخاص به. يبقى خارج المكتبة:"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই বইটি লাইব্রেরি থেকে সরানো হয়েছে, কিন্তু এর bookInfo.json ফাইল মুছে ফেলা যায়নি। এটি লাইব্রেরির বাইরেই থাকে:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieses Buch wurde aus der Bibliothek entfernt, aber seine Datei bookInfo.json konnte nicht gelöscht werden. Es bleibt außerhalb der Bibliothek:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This book was removed from the library, but its bookInfo.json file could not be deleted. It stays out of the library:"
