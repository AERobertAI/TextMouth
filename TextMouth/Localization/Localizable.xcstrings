    "libraryViewsSettings.orderCaption" : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). What the list is, and where a new window opens.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تقدم قائمة العرض المنبثقة في نافذة المكتبة هذه العروض بهذا الترتيب. تُفتح نافذة جديدة على أول عرض مقدَّم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "লাইব্রেরি উইন্ডোর ভিউ পপ-আপ এই ভিউগুলো এই ক্রমে দেখায়। নতুন উইন্ডো প্রথম দেখানো ভিউয়ে খোলে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Einblendmenü „Ansicht“ eines Bibliotheksfensters bietet diese Ansichten in dieser Reihenfolge an. Ein neues Fenster öffnet sich mit der ersten angebotenen Ansicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The View pop-up of a Library window offers these views in this order. A new window opens at the first one offered."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El menú Vista de una ventana de la biblioteca ofrece estas vistas en este orden. Una ventana nueva se abre en la primera que se ofrece."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "منوی بازشوی نمای پنجره‌ی کتابخانه این نماها را به این ترتیب ارائه می‌کند. پنجره‌ی جدید در اولین نمای ارائه‌شده باز می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le menu Vue d’une fenêtre de bibliothèque propose ces vues dans cet ordre. Une nouvelle fenêtre s’ouvre sur la première proposée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "התפריט הקופץ “תצוגה” של חלון ספרייה מציע את התצוגות האלה בסדר הזה. חלון חדש נפתח בראשונה שמוצעת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लाइब्रेरी विंडो का दृश्य पॉप-अप इन दृश्यों को इसी क्रम में पेश करता है। नई विंडो पहले पेश किए गए दृश्य पर खुलती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menu pop-up Tampilan pada jendela Pustaka menawarkan tampilan ini dalam urutan ini. Jendela baru dibuka pada tampilan pertama yang ditawarkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il menu Vista di una finestra della libreria propone queste viste in quest’ordine. Una nuova finestra si apre sulla prima proposta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ライブラリウインドウの「ビュー」ポップアップメニューには、これらのビューがこの順に表示されます。新しいウインドウは、最初に表示されたビューで開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관함 윈도우의 보기 팝업 메뉴는 이 보기들을 이 순서로 제공합니다. 새 윈도우는 맨 처음 보기에서 열립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De pop-up Weergave van een bibliotheekvenster biedt deze weergaven in deze volgorde aan. Een nieuw venster opent bij de eerste die wordt aangeboden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rozwijane menu Widok w oknie biblioteki oferuje te widoki w tej kolejności. Nowe okno otwiera się na pierwszym z oferowanych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O menu local Visualização de uma janela da biblioteca oferece estas visualizações nesta ordem. Uma nova janela abre na primeira oferecida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Меню представлений окна библиотеки предлагает эти представления в таком порядке. Новое окно открывается на первом из предложенных."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Popupknappen Vy i ett biblioteksfönster erbjuder de här vyerna i den här ordningen. Ett nytt fönster öppnas med den första som erbjuds."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เมนูป๊อปอัปมุมมองของหน้าต่างไลบรารีแสดงมุมมองเหล่านี้ตามลำดับนี้ หน้าต่างใหม่จะเปิดที่มุมมองแรกที่แสดง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bir Kitaplık penceresinin Görünüm açılır menüsü bu görünümleri bu sırayla sunar. Yeni bir pencere, sunulan ilk görünümde açılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Спливне меню «Вигляд» у вікні бібліотеки пропонує ці вигляди в такому порядку. Нове вікно відкривається на першому з запропонованих."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لائبریری ونڈو کا منظر پاپ اپ یہ مناظر اسی ترتیب میں پیش کرتا ہے۔ نئی ونڈو پہلے پیش کیے گئے منظر پر کھلتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nút bật lên Chế độ xem của cửa sổ Thư viện đưa ra các chế độ xem này theo thứ tự này. Cửa sổ mới mở ở chế độ xem đầu tiên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "资料库窗口的“视图”弹出式菜单按此顺序提供这些视图。新窗口会在提供的第一个视图处打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "書庫視窗的「顯示方式」彈出式選單會依此順序提供這些顯示方式。新視窗會以第一個提供的顯示方式打開。"
          }
        }
      }
    },
    "libraryViewsSettings.readingListHint" : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). The Reading List's row hint: what it shows.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعرض الكتب بالترتيب الذي تنظمه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আপনার সাজানো ক্রমে বইগুলো দেখায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zeigt die Bücher in der von dir festgelegten Reihenfolge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the books in the order you arrange"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Muestra los libros en el orden que les das"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب‌ها را به ترتیبی که خودتان مرتب می‌کنید نشان می‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Affiche les livres dans l’ordre que vous définissez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מציג את הספרים בסדר שקבעת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पुस्तकें उसी क्रम में दिखाता है जो आप तय करते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menampilkan buku dalam urutan yang Anda atur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mostra i libri nell’ordine che stabilisci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "手動で並べた順にブックを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "직접 정렬한 순서로 책을 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toont de boeken in de volgorde die je instelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pokazuje książki w kolejności ustawionej przez Ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mostra os livros na ordem que você organiza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Показывает книги в порядке, который вы задали."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Visar böckerna i den ordning du bestämmer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "แสดงหนังสือตามลำดับที่จัดเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
