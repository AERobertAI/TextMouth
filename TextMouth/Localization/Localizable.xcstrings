      }
    },
    "libraryIndexRecoveryError.indexReadableAgain" : {
      "comment" : "Why Rebuild Library Index replaced nothing: the library index can be read again. It follows the sentence \"The library index was not rebuilt.\", so \"It\" is the index. Try Again is a button name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يمكن قراءته الآن مرة أخرى. اختر “إعادة المحاولة” لاستخدامه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এটি এখন আবার পড়া যায়। ব্যবহার করতে “আবার চেষ্টা করুন” বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Er kann jetzt wieder gelesen werden. Wähle „Erneut versuchen“, um ihn zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It can be read again now. Choose Try Again to use it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ya se puede leer de nuevo. Elige Reintentar para usarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اکنون دوباره قابل خواندن است. «تلاش دوباره» را انتخاب کنید تا از آن استفاده شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il peut de nouveau être lu. Choisissez Réessayer pour l’utiliser."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אפשר לקרוא אותו שוב עכשיו. בחר “נסה שוב” כדי להשתמש בו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसे अब फिर से पढ़ा जा सकता है। इसका उपयोग करने के लिए “फिर से प्रयास करें” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sekarang dapat dibaca lagi. Pilih Coba Lagi untuk menggunakannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ora può essere letto di nuovo. Scegli Riprova per usarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "もう一度読み取れるようになりました。使用するには「再試行」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이제 읽을 수 있습니다. 다시 시도를 선택하여 사용하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hij kan nu weer worden gelezen. Kies Probeer opnieuw om hem te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Można go już odczytać. Wybierz Spróbuj ponownie, aby go użyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ele pode ser lido de novo agora. Escolha Tentar novamente para usá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Теперь его можно прочитать. Выберите «Повторить попытку», чтобы использовать его."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Det kan läsas igen nu. Välj Försök igen för att använda det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตอนนี้อ่านได้อีกแล้ว เลือก ลองอีกครั้ง เพื่อใช้งาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Artık okunabiliyor. Kullanmak için Tekrar Dene düğmesini seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Її знову можна прочитати. Виберіть «Повторити», щоб використати її."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اب اسے دوبارہ پڑھا جا سکتا ہے۔ اسے استعمال کرنے کے لیے “دوبارہ کوشش کریں” منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Giờ đã đọc lại được. Chọn Thử lại để dùng nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "现在可以再次读取它了。选取“重试”来使用它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "現在可以再次讀取。請選擇「重試」來使用它。"
          }
        }
      }
    },
    "libraryIndexRecoveryError.indexUnreadable" : {
      "comment" : "Why a command that acts on the library index was refused: the index can't be read yet. Try Again and Rebuild Library Index are button names in the Library window.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يمكن قراءة فهرس المكتبة. اختر “إعادة المحاولة” أو “إعادة بناء فهرس المكتبة” في نافذة المكتبة أولًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "লাইব্রেরি সূচক পড়া যাচ্ছে না। আগে লাইব্রেরি উইন্ডোতে “আবার চেষ্টা করুন” বা “লাইব্রেরি সূচক পুনর্নির্মাণ করুন” বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
