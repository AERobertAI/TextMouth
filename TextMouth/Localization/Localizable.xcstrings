    },
    "The recording as it was made, before any edits." : {
      "comment" : "The hint of the Original recording checkbox in the Export dialog.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La grabación tal como se hizo, antes de cualquier edición."
