    },
    "How many of the newest" : {
      "comment" : "Label of the number field and stepper that say how many of a feed's newest items are listed or downloaded.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wie viele der neuesten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cuántos de los más recientes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nombre des plus récents"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quanti dei più recenti"
