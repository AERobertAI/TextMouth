        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Одна книга этой библиотеки требует более новой версии TextMouth. Она хранится как есть, но не показывается."
          }
        },
        "uk" : {
          "stringUnit" : {
