        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menampilkan durasi, file, dan edit; mengatur apa yang terjadi pada audio asli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mostra durata, file e modifiche; imposta che cosa succede all’audio originale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "長さ、ファイル、編集を表示し、元のオーディオの扱いを設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "길이, 파일, 편집 내용을 보여 주고 원본 오디오의 처리 방식을 설정합니다."
