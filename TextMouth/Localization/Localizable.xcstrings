    "libraryCloud.downloadFirst.select" : {
      "comment" : "What to do about a book only in the cloud before an operation that never downloads. %@ is the name of the Library menu command Download Now.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نزّله أولًا: حدده في المكتبة، ثم اختر %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আগে এটি ডাউনলোড করুন: লাইব্রেরিতে এটি নির্বাচন করে “%@” বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lade es zuerst herunter: Wähle es in der Bibliothek aus und wähle dann %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download it first: select it in the library, then choose %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Descárgalo primero: selecciónalo en la biblioteca y luego elige %@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ابتدا آن را بارگیری کنید: آن را در کتابخانه انتخاب کنید، سپس %@ را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Téléchargez-le d’abord : sélectionnez-le dans la bibliothèque, puis choisissez %@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הורד אותו תחילה: בחר בו בספרייה, ואז בחר “%@”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पहले इसे डाउनलोड करें: लाइब्रेरी में इसे चुनें, फिर “%@” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Unduh dulu: pilih di pustaka, lalu pilih %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scaricalo prima: selezionalo nella libreria, poi scegli %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "先にダウンロードしてください。ライブラリでそのブックを選択し、「%@」を選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "먼저 다운로드하십시오. 보관함에서 선택한 다음 %@을(를) 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Download het eerst: selecteer het in de bibliotheek en kies dan %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Najpierw ją pobierz: zaznacz ją w bibliotece, a następnie wybierz %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Baixe-o primeiro: selecione-o na biblioteca e escolha %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сначала загрузите её: выберите книгу в библиотеке, затем выберите «%@»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hämta den först: markera den i biblioteket och välj sedan %@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ดาวน์โหลดหนังสือเล่มนั้นก่อน: เลือกในไลบรารี แล้วเลือก %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Önce indirin: kitaplıkta seçin, sonra “%@” komutunu seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Спочатку завантажте її: виберіть її в бібліотеці, а потім виберіть «%@»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پہلے اسے ڈاؤن لوڈ کریں: لائبریری میں اسے منتخب کریں، پھر “%@” منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hãy tải sách về trước: chọn sách trong thư viện, rồi chọn %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "请先下载：在资料库中选择它，然后选择 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "請先下載：在書庫中選擇它，然後選擇 %@。"
          }
        }
      }
    },
