    "textEncoding.notValid" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. Why a file chosen to be read in the encoding named encoding was not read: some of its bytes are not valid in it. subject names the file or the book, as the sentence begins: \"“Ledger” can't be read as Shift JIS (Japanese): it holds bytes that are not valid in that encoding.\" The decoder's error (TextEncodingError.invalidForChosenEncoding) and Book Information's refusal both say it from here. Placeholders in order: subject, encoding.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّرت قراءة %1$@ بترميز %2$@: يحتوي على بايتات غير صالحة في هذا الترميز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@ হিসেবে পড়া যায় না: এতে এমন বাইট আছে, যা ওই এনকোডিংয়ে বৈধ নয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ kann nicht als %2$@ gelesen werden: Die Datei enthält Bytes, die in dieser Codierung nicht gültig sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ can't be read as %@: it holds bytes that are not valid in that encoding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ no se puede leer como %2$@: contiene bytes que no son válidos en esa codificación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ را نمی‌توان به‌صورت %2$@ خواند: بایت‌هایی دارد که در آن کدگذاری معتبر نیستند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ne peut pas être lu en %@ : il contient des octets non valides dans cet encodage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא ניתן לקרוא את %1$@ כ-%2$@: הוא מכיל בייטים שאינם תקפים בקידוד הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ को %2$@ के रूप में नहीं पढ़ा जा सका: इसमें ऐसे बाइट हैं जो उस एन्कोडिंग में मान्य नहीं हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ tidak dapat dibaca sebagai %@: berisi byte yang tidak valid dalam pengodean tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ non può essere letto come %@: contiene byte non validi in quella codifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@を%2$@として読み込めません。このエンコーディングでは無効なバイトが含まれています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@은(는) %2$@ 인코딩으로 읽을 수 없습니다. 해당 인코딩에서 유효하지 않은 바이트가 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ kan niet worden gelezen als %@: het bevat bytes die in die codering niet geldig zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie można odczytać %1$@ jako %2$@: plik zawiera bajty nieprawidłowe w tym kodowaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não foi possível ler %1$@ como %2$@: o arquivo contém bytes que não são válidos nessa codificação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не удаётся прочитать %1$@ как %2$@: в файле есть байты, недопустимые в этой кодировке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ kan inte läsas som %@: filen innehåller byte som inte är giltiga i den teckenkodningen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "อ่าน %1$@ เป็น %2$@ ไม่ได้ เพราะมีไบต์ที่ใช้ไม่ได้ในการเข้ารหัสนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@ olarak okunamıyor: bu kodlamada geçerli olmayan baytlar içeriyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ не вдається прочитати як %2$@: дані містять байти, недійсні в цьому кодуванні."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ کو %2$@ کے طور پر نہیں پڑھا جا سکتا: اس میں ایسے بائٹس ہیں جو اس انکوڈنگ میں درست نہیں ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không thể đọc %1$@ dưới dạng %2$@: tệp có các byte không hợp lệ trong bảng mã đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 无法按 %2$@ 读取：其中含有该编码中无效的字节。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "無法以 %2$@ 讀取 %1$@：其中含有該編碼不允許的位元組。"
          }
        }
      }
    },
    "textEncoding.placesNote" : {
