        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस पुस्तक में कोई हेडिंग नहीं है, इसलिए पूरी निर्यात होती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Buku ini tidak memiliki tajuk, jadi seluruhnya diekspor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo libro non ha intestazioni, quindi viene esportato per intero."
          }
        },
        "ja" : {
