            "value" : "آپ اسے بند کر سکتے ہیں۔ برآمد جاری رہتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bạn có thể đóng mục này. Quá trình xuất vẫn tiếp tục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "你可以关闭此内容。导出会继续进行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "你可以關閉此內容。輸出會繼續進行。"
          }
        }
      }
    },
    "phoneExport.closeWhileExporting" : {
      "comment" : "The hint of the Close button of the Export sheet on the iPhone while a spoken audio export runs: the sheet closes, the export goes on, and the Library shows its progress.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يغلق التصدير. يستمر التصدير وتعرض المكتبة مدى تقدّمه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "রপ্তানি বন্ধ করে। রপ্তানি চলতে থাকে, আর লাইব্রেরি দেখায় তা কতদূর এগিয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Schließt den Export. Der Export läuft weiter, und die Bibliothek zeigt, wie weit er ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closes Export. The export goes on, and the Library shows how far it has come."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cierra Exportar. La exportación continúa y la Biblioteca muestra cuánto ha avanzado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صادر کردن را می‌بندد. صادر کردن ادامه می‌یابد و کتابخانه نشان می‌دهد چقدر پیش رفته است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ferme Exporter. L’exportation continue, et la Bibliothèque montre où elle en est."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "סוגר את הייצוא. הייצוא נמשך, והספרייה מראה כמה הוא התקדם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "निर्यात बंद करता है। निर्यात जारी रहता है, और लाइब्रेरी दिखाती है कि वह कितना आगे बढ़ा है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menutup Ekspor. Ekspor terus berjalan, dan Pustaka menunjukkan sejauh mana kemajuannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chiude Esporta. L’esportazione continua e la Libreria mostra a che punto è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "書き出しを閉じます。書き出しは続き、ライブラリに進み具合が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "내보내기를 닫습니다. 내보내기는 계속되고, 보관함에서 진행 상황을 볼 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sluit Exporteer. De export gaat door en de Bibliotheek laat zien hoe ver hij is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zamyka eksport. Eksport trwa dalej, a Biblioteka pokazuje, jak daleko zaszedł."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fecha Exportar. A exportação continua, e a Biblioteca mostra até onde ela foi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Закрывает экспорт. Экспорт продолжается, а Библиотека показывает, как далеко он продвинулся."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stänger Exportera. Exporten fortsätter, och Biblioteket visar hur långt den har kommit."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ปิดการส่งออก การส่งออกจะดำเนินต่อไป และไลบรารีจะแสดงว่าคืบหน้าไปแค่ไหน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dışa Aktar’ı kapatır. Dışa aktarma sürer ve Kitaplık ne kadar ilerlediğini gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Закриває експорт. Експорт триває, а Бібліотека показує, як далеко він просунувся."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "برآمد بند کرتا ہے۔ برآمد جاری رہتی ہے، اور لائبریری دکھاتی ہے کہ وہ کتنی آگے بڑھی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đóng Xuất. Quá trình xuất vẫn tiếp tục, và Thư viện cho biết nó đã đi được bao xa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "关闭导出。导出会继续进行，资料库会显示进度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "關閉輸出。輸出會繼續進行，書庫會顯示進度。"
          }
        }
      }
    },
    "phoneExport.questionWithNoSheet" : {
      "comment" : "Ends what an export says when it stopped because it needed to ask what to do with a chapter nested too deeply, and the Export sheet was closed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "احتاج فصل متداخل بعمق زائد إلى سؤال، وكانت الشاشة مغلقة، فتوقف التصدير."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "অতিরিক্ত গভীরভাবে নেস্ট করা একটি অধ্যায় সম্পর্কে প্রশ্ন করার দরকার ছিল, কিন্তু শিটটি বন্ধ ছিল, তাই রপ্তানি বন্ধ হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zu einem zu tief verschachtelten Kapitel war eine Frage nötig, und das Blatt war geschlossen, deshalb wurde der Export gestoppt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chapter nested too deeply needed a question, and the sheet was closed, so the export stopped."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un capítulo anidado con demasiada profundidad requería una pregunta, pero la hoja estaba cerrada, así que la exportación se detuvo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فصلی با تودرتویی بیش‌ازحد به پرسشی نیاز داشت و برگه بسته بود، پس صادر کردن متوقف شد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un chapitre trop imbriqué demandait une question, et la feuille était fermée : l’exportation s’est donc arrêtée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "פרק מקונן עמוק מדי היה צריך שאלה, והגיליון היה סגור, ולכן הייצוא נעצר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "बहुत गहराई में बसे एक अध्याय के बारे में सवाल पूछना था, पर शीट बंद थी, इसलिए निर्यात रुक गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sebuah bab yang bersarang terlalu dalam memerlukan pertanyaan, tetapi lembar sudah ditutup, jadi ekspor dihentikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un capitolo annidato troppo in profondità richiedeva una domanda, ma il foglio era chiuso, quindi l’esportazione si è interrotta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "深く入れ子になった章について確認が必要でしたが、シートが閉じていたため、書き出しを停止しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "너무 깊게 중첩된 챕터에 대해 질문이 필요했지만 시트가 닫혀 있어 내보내기를 중지했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voor een te diep genest hoofdstuk was een vraag nodig, maar het blad was gesloten, dus de export is gestopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rozdział zagnieżdżony zbyt głęboko wymagał pytania, ale arkusz był zamknięty, więc eksport zatrzymano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um capítulo aninhado fundo demais precisava de uma pergunta, mas a folha estava fechada, então a exportação parou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Для слишком глубоко вложенной главы был нужен вопрос, но лист был закрыт, поэтому экспорт остановлен."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ett för djupt nästlat kapitel behövde en fråga, men bladet var stängt, så exporten stoppades."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "บทที่ซ้อนลึกเกินไปต้องมีคำถาม แต่แผ่นงานถูกปิดอยู่ การส่งออกจึงหยุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fazla derin iç içe geçmiş bir bölüm için soru sorulması gerekiyordu, ancak sayfa kapalıydı; bu yüzden dışa aktarma durdu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Для надто глибоко вкладеного розділу потрібне було запитання, але аркуш було закрито, тож експорт зупинено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بہت گہرائی میں گھرے ایک باب کے بارے میں سوال پوچھنا تھا، مگر شیٹ بند تھی، اس لیے برآمد رک گئی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Một chương lồng quá sâu cần được hỏi, nhưng trang đã đóng, nên quá trình xuất đã dừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "有一章嵌套过深，需要询问，但面板已关闭，所以导出已停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "有一章巢狀過深，需要詢問，但面板已關閉，所以輸出已停止。"
          }
        }
      }
    },
    "phoneExport.share" : {
