        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Aufnahme konnte nicht ordnungsgemäß abgeschlossen werden. Das Aufgenommene bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo terminar bien la grabación. Lo grabado se conserva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile completare correttamente la registrazione. Quanto registrato è stato conservato."
          }
        }
      }
    },
    "The recording couldn't be saved: %@ It is kept; choose %@ or %@." : {
      "comment" : "Status line and announcement of the Record window when saving a recording failed. %1$@ is the reason, a whole sentence that ends with its own full stop, %2$@ is the title of the button that tries again, and %3$@ is the title of the button that deletes the recording.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Aufnahme konnte nicht gesichert werden: %1$@ Sie bleibt erhalten; wähle „%2$@“ oder „%3$@“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The recording couldn't be saved: %1$@ It is kept; choose %2$@ or %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo guardar la grabación: %1$@ Se conserva; elige %2$@ o %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile salvare la registrazione: %1$@ È stata conservata; scegli %2$@ oppure %3$@."
          }
        }
      }
    },
    "The recording lasts %@." : {
      "comment" : "Second sentence of that refusal. %@ is the recording's length spoken in words, such as \"9 hours, 41 minutes, 7 seconds\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La grabación dura %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La registrazione dura %@."
          }
        }
      }
    },
    "The recording was discarded." : {
      "comment" : "Status line of the Record window after a recording was discarded.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Aufnahme wurde verworfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La grabación se descartó."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La registrazione è stata scartata."
          }
        }
      }
    },
    "The recording window" : {
      "comment" : "Choice of the Works in pop-up of a keyboard shortcut: the shortcut works only in the Record window.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La ventana de grabación"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Finestra di registrazione"
          }
        }
      }
    },
    "The recording's audio couldn't be read." : {
      "comment" : "Error in the Record window when saving: the recorded take holds no audio that can be read.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Audio der Aufnahme konnte nicht gelesen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo leer el audio de la grabación."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile leggere l’audio della registrazione."
          }
        }
      }
    },
    "The refresh of %@ was stopped." : {
      "comment" : "Why a feed's refresh ended: it was stopped. %@ is the feed's title or server.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se detuvo la actualización de %@."
          }
        }
      }
    },
    "The refused text began before this passage, at character %@." : {
      "comment" : "A line of the speech refusal report: the refused text began before the passage shown. %@ is the character offset where it began, written without digit grouping.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto rechazado empezó antes de este pasaje, en el carácter %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo rifiutato iniziava prima di questo brano, al carattere %@."
          }
        }
      }
    },
    "The refused text begins here, at character %@." : {
      "comment" : "A line of the speech refusal report, just before the refused text. %@ is the character offset where it begins, written without digit grouping.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto rechazado empieza aquí, en el carácter %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo rifiutato inizia qui, al carattere %@."
          }
        }
      }
    },
    "The refused text ends here, at character %@." : {
      "comment" : "A line of the speech refusal report, just after the refused text. %@ is the character offset where it ends, written without digit grouping.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto rechazado termina aquí, en el carácter %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo rifiutato finisce qui, al carattere %@."
          }
        }
      }
    },
    "The refused text goes on past this passage, to character %@." : {
      "comment" : "A line of the speech refusal report: the refused text goes on past the passage shown. %@ is the character offset where it ends, written without digit grouping.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto rechazado continúa después de este pasaje, hasta el carácter %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo rifiutato prosegue oltre questo brano, fino al carattere %@."
          }
        }
      }
    },
    "The saved copy at %@ keeps the old data." : {
      "comment" : "Last sentence of what Rebuild Library Index does: where the old data stays. %@ is the saved copy's path.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La copia guardada en %@ conserva los datos anteriores."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La copia salvata in %@ conserva i vecchi dati."
          }
        }
      }
    },
    "The search couldn't be sent, because the directory's address isn't a web address." : {
      "comment" : "Why a podcast search failed: the directory's address is not an http or https address.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo enviar la búsqueda, porque la dirección del directorio no es una dirección web."
          }
        }
      }
    },
    "The search was stopped." : {
      "comment" : "Why a podcast search ended: it was stopped.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se detuvo la búsqueda."
          }
        }
      }
    },
    "The selected data directory is not empty." : {
      "comment" : "First sentence of why a move of the data directory was refused: the new location already holds something.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El directorio de datos seleccionado no está vacío."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La cartella dei dati selezionata non è vuota."
          }
        }
      }
    },
    "The selection is all the audio; nothing to trim." : {
      "comment" : "Said by the audio editor's Trim to Selection when the selection is all of the audio.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Auswahl ist das gesamte Audio; es gibt nichts zu kürzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La selección es todo el audio; no hay nada que recortar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La selezione è tutto l’audio; niente da ritagliare."
          }
        }
      }
    },
    "The server %@ couldn't be found." : {
      "comment" : "Why a feed item's download failed: no server answers at its address. %@ is the server's host name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se encontró el servidor %@."
          }
        }
      }
    },
    "The server %@ couldn't be found. Check the address." : {
      "comment" : "Why a feed could not be fetched: no server answers at its address. %@ is the server's host name, such as example.com.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se encontró el servidor %@. Revisa la dirección."
          }
        }
      }
    },
    "The server says the file is gone." : {
      "comment" : "Why a feed item's download failed: the server says nothing is at the address (error 404).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El servidor dice que el archivo ya no existe."
          }
        }
      }
    },
    "The speech engine refused to speak the text here, twice, so speech stopped. Play tries again from the same place." : {
      "comment" : "Summary under the heading of the report of a refusal, on the Mac and the iPhone: what happened, and that Play tries again.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El motor de voz se negó a leer el texto de aquí, dos veces, así que la lectura se detuvo. Reproducir vuelve a intentarlo desde el mismo lugar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il motore vocale ha rifiutato due volte di leggere il testo qui, quindi la lettura si è interrotta. Riproduci riprova dallo stesso punto."
          }
        }
      }
    },
    "The speech model for %@ isn't on this Mac yet. Download it first." : {
      "comment" : "Error shown when transcription is tried before the language's speech model is downloaded. %@ is the language's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Sprachmodell für %@ ist noch nicht auf diesem Mac. Lade es zuerst herunter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El modelo de voz de %@ aún no está en esta Mac. Descárgalo primero."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il modello vocale per %@ non è ancora su questo Mac. Scaricalo prima."
          }
        }
      }
    },
    "The stretch of the take to use isn't inside the take." : {
      "comment" : "Said when a punch-in's recording is asked to use a stretch that is not inside the recording.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der zu verwendende Abschnitt der Aufnahme liegt nicht innerhalb der Aufnahme."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El tramo de la toma que se usará no está dentro de la toma."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La parte della registrazione da usare non è all’interno della registrazione."
          }
        }
      }
    },
    "The subscriptions couldn't be saved: %@" : {
      "comment" : "Why the subscriptions could not be exported. %@ is the reason, from the system.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudieron guardar las suscripciones: %@"
          }
        }
      }
    },
    "The text changed since the search; moved to the nearest match." : {
      "comment" : "Announcement when the book's text changed since the search and the reader moved to the nearest match.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto cambió desde la búsqueda; se pasó a la coincidencia más cercana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo è cambiato dopo la ricerca; spostato alla corrispondenza più vicina."
          }
        }
      }
    },
    "The text content.md held before was kept as %@, in the book's package." : {
      "comment" : "Second sentence of that message. content.md is the file name of the book's text and stays as written; %@ is the backup's file name such as content.md.edited-20261004T123012Z, which stays as written.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto que content.md tenía antes se conservó como %@, en el paquete del libro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo che content.md conteneva prima è stato conservato come %@, nel pacchetto del libro."
          }
        }
      }
    },
    "The text handed to the speech engine, after the substitutions and the markup guard, characters %@ to %@ of the spoken text:" : {
      "comment" : "A line of the speech refusal report that introduces the text the speech engine was handed, after the user's substitution rules and the markup guard. %1$@ and %2$@ are the first and last character offsets in the spoken text, written without digit grouping.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The text handed to the speech engine, after the substitutions and the markup guard, characters %1$@ to %2$@ of the spoken text:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto entregado al motor de voz, después de las sustituciones y de la protección de marcado, caracteres %1$@ a %2$@ del texto hablado:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo passato al motore vocale, dopo le sostituzioni e la protezione del markup, caratteri da %1$@ a %2$@ del testo letto:"
          }
        }
      }
    },
    "The text of %@" : {
      "comment" : "Names what the export's deep-nesting question is about: a book's whole text, which has no chapter markers. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto de %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo di %@"
          }
        }
      }
    },
    "The text of %@ can't be read, so it can't be edited." : {
      "comment" : "Message when Edit Text finds the book's text file unreadable. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se puede leer el texto de %@, así que no se puede editar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo di %@ non può essere letto, quindi non può essere modificato."
          }
        }
      }
    },
    "The text of %@ isn't ready to edit yet." : {
      "comment" : "First sentence of the message when Edit Text finds the book's text file missing. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto de %@ aún no está listo para editar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo di %@ non è ancora pronto per essere modificato."
          }
        }
      }
    },
    "The text of %@ was read again from its own file." : {
      "comment" : "First sentence of the message after a book's text was read again from its own file. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto de %@ se volvió a leer desde su propio archivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo di %@ è stato letto di nuovo dal suo file."
          }
        }
      }
    },
    "The text of this book %@, which TextMouth can't export safely. Choose Edit Text, flatten the nesting, and save; then export again." : {
      "comment" : "Why a book's text was not exported: it nests quotes, lists, or emphasis too deeply, and has no chapter markers. %@ is the clause that says how deep, such as \"nests quotes, lists, or emphasis more than 128 levels deep\". \"Edit Text\" is a command.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto de este libro %@, y TextMouth no puede exportarlo con seguridad. Elige Editar texto, aplana el anidado y guarda; después vuelve a exportar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo di questo libro %@, e TextMouth non può esportarlo in sicurezza. Scegli Modifica testo, appiattisci l’annidamento e salva; poi esporta di nuovo."
          }
        }
      }
    },
    "The text was reloaded, but the editor's file does not say what encoding it is in, so some characters may be wrong." : {
      "comment" : "First sentence of the note after Reload from Editor read a file whose text encoding nothing in it tells.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se recargó el texto, pero el archivo del editor no indica en qué codificación está, así que algunos caracteres pueden ser incorrectos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo è stato ricaricato, ma il file dell’editor non indica in quale codifica sia, quindi alcuni caratteri potrebbero essere errati."
          }
        }
      }
    },
    "The tracks of the cue sheet “%@” run past the end of its audio, so its headings were not used." : {
      "comment" : "Notice that a cue sheet of an imported folder or archive was not used, because its tracks lie past the end of its audio. %@ is the cue sheet's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Las pistas del archivo CUE “%@” pasan del final de su audio, así que no se usaron sus encabezados."
          }
        }
      }
    },
    "The transcript and the text made from it are deleted." : {
      "comment" : "First sentence of the question asked before an audiobook's transcript is deleted.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript und der daraus erstellte Text werden gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcripción y el texto creado a partir de ella se eliminan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La trascrizione e il testo ricavato da essa vengono eliminati."
          }
        }
      }
    },
    "The transcript as %@ captions, one file timed from the start of the audio." : {
      "comment" : "The hint of the Transcript checkbox in the Export dialog while its transcript is written as captions. %@ is the format's name, such as WebVTT or SubRip.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcripción como subtítulos %@, un archivo con tiempos desde el inicio del audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La trascrizione come sottotitoli %@, un solo file sincronizzato a partire dall’inizio dell’audio."
          }
        }
      }
    },
    "The transcript as TextMouth keeps it, in JSON, with its text as Markdown." : {
      "comment" : "The hint of the Transcript's Convert to picker in the Export dialog while JSON and Markdown is chosen.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcripción tal como la conserva TextMouth, en JSON, con su texto como Markdown."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La trascrizione com’è conservata da TextMouth, in JSON, con il testo in Markdown."
          }
        }
      }
    },
    "The transcript can't be read. If the book is only in the cloud, download it and try again." : {
      "comment" : "Error shown when Clean Up Transcript cannot read the transcript.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript kann nicht gelesen werden. Wenn das Buch nur in der Cloud ist, lade es herunter und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se puede leer la transcripción. Si el libro solo está en la nube, descárgalo y vuelve a intentarlo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile leggere la trascrizione. Se il libro è solo nel cloud, scaricalo e riprova."
          }
        }
      }
    },
    "The transcript changed since this was shown. Reopen Clean Up Transcript to see the changes." : {
      "comment" : "Error shown when the transcript changed after the Clean Up Transcript sheet showed its changes. Clean Up Transcript is the command's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript hat sich geändert, seit dies angezeigt wurde. Öffne „Transkript bereinigen“ erneut, um die Änderungen zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcripción cambió desde que se mostró esto. Vuelve a abrir Limpiar transcripción para ver los cambios."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La trascrizione è cambiata dopo la visualizzazione. Riapri Pulisci trascrizione per vedere le modifiche."
          }
        }
      }
    },
    "The transcript file found beside the new copy's audio replaces the existing copy's transcript." : {
      "comment" : "Part of the question asked about a duplicate audiobook: the transcript file found beside the new copy's audio takes the place of the library copy's transcript.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo de transcripción que se encontró junto al audio de la copia nueva reemplaza la transcripción de la copia existente."
          }
        }
      }
    },
    "The transcript files beside the audio weren't attached: %@" : {
      "comment" : "Notice after an import: the transcript files beside each track's audio were not attached. %@ is the reason, a sentence.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Transkriptdateien neben dem Audio wurden nicht angehängt: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los archivos de transcripción junto al audio no se adjuntaron: %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I file di trascrizione accanto all’audio non sono stati allegati: %@"
          }
        }
      }
    },
    "The transcript from before the cleanup can't be used: %@." : {
      "comment" : "Error shown when Undo Cleanup is pressed and the transcript from before the cleanup is damaged. %@ is the reason, a technical phrase in English.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript von vor der Bereinigung kann nicht verwendet werden: %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se puede usar la transcripción anterior a la limpieza: %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile usare la trascrizione precedente alla pulizia: %@."
          }
        }
      }
    },
    "The transcript from “%@” replaces the book's transcript and the text made from it." : {
      "comment" : "First sentence of the question asked before a transcript from a file replaces an audiobook's transcript. %@ is the file's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript aus „%@“ ersetzt das Transkript des Buchs und den daraus erstellten Text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcripción de “%@” reemplaza la del libro y el texto creado a partir de ella."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La trascrizione di “%@” sostituisce la trascrizione del libro e il testo ricavato da essa."
          }
        }
      }
    },
    "The transcript holds no text to attach." : {
      "comment" : "Error shown when an attached transcript file holds no text.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript enthält keinen Text zum Anhängen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcripción no contiene texto que adjuntar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La trascrizione non contiene testo da allegare."
          }
        }
      }
    },
    "The transcript is only in iCloud, so TextMouth leaves it. Download the book, then try again." : {
      "comment" : "Line of the Transcribe Audio sheet when the book's transcript file has not been downloaded from iCloud to this Mac.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript ist nur in iCloud, daher lässt TextMouth es unverändert. Lade das Buch herunter und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcripción solo está en iCloud, así que TextMouth no la toca. Descarga el libro y vuelve a intentarlo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La trascrizione è solo in iCloud, quindi TextMouth non la tocca. Scarica il libro, poi riprova."
          }
        }
      }
    },
    "The transcript is only in the cloud. Its details appear once the book is downloaded." : {
      "comment" : "Book Information's Transcript detail when the transcript file has not been downloaded from the cloud drive.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript ist nur in der Cloud. Seine Details erscheinen, sobald das Buch heruntergeladen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcripción solo está en la nube. Sus detalles aparecen cuando se descarga el libro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La trascrizione è solo nel cloud. I suoi dettagli compaiono quando il libro viene scaricato."
          }
        }
      }
    },
    "The transcript of %@ can't be read. If the book is only in the cloud, download it and try again." : {
      "comment" : "Alert shown when Clean Up Transcript is chosen for an audiobook whose transcript cannot be read. %@ is the audiobook's title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript von %@ kann nicht gelesen werden. Wenn das Buch nur in der Cloud ist, lade es herunter und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se puede leer la transcripción de %@. Si el libro solo está en la nube, descárgalo y vuelve a intentarlo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile leggere la trascrizione di %@. Se il libro è solo nel cloud, scaricalo e riprova."
          }
        }
      }
    },
    "The transcript runs to %@, past the audio's end at %@, so it is for other audio." : {
      "comment" : "Error shown when an attached transcript file's times run past the end of the book's audio. %1$@ is where the transcript ends and %2$@ where the audio ends, each a length of time in words such as \"1 hour, 2 minutes, 5 seconds\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript reicht bis %1$@, über das Ende des Audios bei %2$@ hinaus, gehört also zu anderem Audio."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The transcript runs to %1$@, past the audio's end at %2$@, so it is for other audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcripción llega hasta %1$@, más allá del final del audio en %2$@, así que es de otro audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La trascrizione arriva a %1$@, oltre la fine dell’audio a %2$@, quindi è per un altro audio."
          }
        }
      }
    },
    "The transcript's files could not be examined once they were written." : {
      "comment" : "Error shown when TextMouth could not check the audio files after writing a transcript for them.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Dateien des Transkripts konnten nach dem Schreiben nicht geprüft werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudieron examinar los archivos de la transcripción una vez escritos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile esaminare i file della trascrizione dopo averli scritti."
          }
        }
      }
    },
    "The transcript's text as %@, made from its Markdown." : {
      "comment" : "The hint of the Transcript checkbox in the Export dialog while its text is written by a text writer. %@ is the writer's name, such as HTML or RTF.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto de la transcripción como %@, creado a partir de su Markdown."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo della trascrizione come %@, ricavato dal suo Markdown."
          }
        }
      }
    },
    "The transcript's text didn't read back as one chapter per chapter of the book." : {
      "comment" : "Error shown when the text written from a transcript did not have one chapter for each chapter of the audiobook.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Text des Transkripts ergab beim Zurücklesen nicht ein Kapitel pro Kapitel des Buchs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto de la transcripción no se leyó de vuelta como un capítulo por cada capítulo del libro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo della trascrizione non è tornato come un capitolo per ogni capitolo del libro."
          }
        }
      }
    },
    "The transcript's times don't fit together, so TextMouth can't use it." : {
      "comment" : "Error shown when an attached transcript file's times are out of order or inconsistent.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Zeiten des Transkripts passen nicht zusammen, daher kann TextMouth es nicht verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los tiempos de la transcripción no encajan entre sí, así que TextMouth no puede usarla."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I tempi della trascrizione non sono coerenti, quindi TextMouth non può usarla."
          }
        }
      }
    },
    "The transcript, with its text as Markdown for an audiobook." : {
      "comment" : "The hint of the Transcript checkbox in the Export dialog.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcripción, con su texto como Markdown para un audiolibro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La trascrizione, con il testo in Markdown, per un audiolibro."
          }
        }
      }
    },
    "The transcript, with your changes, stays with the episode in its feed, even after its download is deleted. Deleting the episode or feed deletes it; Move to Library keeps it as a book." : {
      "comment" : "Note under a podcast episode's transcript editor and cleanup sheet. Move to Library is the name of a command in the feed's episode menu.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript mit deinen Änderungen bleibt bei der Folge in ihrem Feed, auch nachdem ihr Download gelöscht wurde. Beim Löschen der Folge oder des Feeds wird es gelöscht; „In die Bibliothek verschieben“ behält es als Buch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcripción, con tus cambios, se queda con el episodio en su canal, incluso después de eliminar su descarga. Eliminar el episodio o el canal la elimina; Mover a la biblioteca la conserva como libro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La trascrizione, con le tue modifiche, resta con l’episodio nel suo feed, anche dopo che il suo download è stato eliminato. Eliminando l’episodio o il feed viene eliminata; Sposta nella libreria la conserva come libro."
          }
        }
      }
    },
    "The unreadable library index is no longer there, so TextMouth saved the library rebuilt from your books as the new index, with %@." : {
      "comment" : "Outcome of the library index recovery when the unreadable index had gone and the rebuilt library was saved as the new index. %@ is a count of books, such as \"743 books\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El índice ilegible de la biblioteca ya no está, así que TextMouth guardó como índice nuevo la biblioteca reconstruida a partir de tus libros, con %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’indice illeggibile della libreria non c’è più, quindi TextMouth ha salvato come nuovo indice la libreria ricostruita dai tuoi libri, con %@."
          }
        }
      }
    },
    "The view is first in the list." : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). Move Up's hint while the view is first, when it is dimmed.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La vista es la primera de la lista."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La vista è la prima dell’elenco."
          }
        }
      }
    },
    "The view is last in the list." : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). Move Down's hint while the view is last, when it is dimmed.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La vista es la última de la lista."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La vista è l’ultima dell’elenco."
          }
        }
      }
    },
    "The view this window showed was deleted. It now shows %@." : {
      "comment" : "Text of the Library window's View pop-up and Go to View. What a window announces when the view it showed was deleted, from Settings or by a change of config.json, and it shows name, the first view its pop-up offers, instead. Placeholders in order: name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La vista que mostraba esta ventana se eliminó. Ahora muestra %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La vista mostrata da questa finestra è stata eliminata. Ora mostra %@."
          }
        }
      }
    },
    "The voice changed its kind of audio partway through “%@”." : {
      "comment" : "Why a chapter of a spoken audio export could not be spoken: the voice changed its audio format. %@ is the chapter's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La voz cambió su tipo de audio a mitad de «%@»."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La voce ha cambiato tipo di audio a metà di “%@”."
          }
        }
      }
    },
    "The voice made no sound for “%@”. Check that it speaks the book's language." : {
      "comment" : "Why a chapter of a spoken audio export could not be spoken: the voice made no sound. %@ is the chapter's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La voz no emitió ningún sonido para «%@». Comprueba que hable el idioma del libro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La voce non ha prodotto alcun suono per “%@”. Controlla che parli la lingua del libro."
          }
        }
      }
    },
    "The voice stopped partway through “%@”, and TextMouth stopped waiting." : {
      "comment" : "Why a chapter of a spoken audio export could not be spoken: the voice stalled. %@ is the chapter's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La voz se detuvo a mitad de «%@», y TextMouth dejó de esperar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La voce si è interrotta a metà di “%@” e TextMouth ha smesso di aspettare."
          }
        }
      }
    },
    "The words TextMouth reads aloud, as plain text, each chapter under its title." : {
      "comment" : "The hint of the Text as plain text checkbox in the Export dialog.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Las palabras que TextMouth lee en voz alta, como texto sin formato, con cada capítulo bajo su título."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le parole che TextMouth legge ad alta voce, come testo semplice, ogni capitolo sotto il suo titolo."
          }
        }
      }
    },
    "Their %@ are kept." : {
      "comment" : "Sentence that says what is kept of every one of several deleted downloads. %@ is a list of parts, such as \"places and bookmarks\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sus %@ se conservan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vengono conservati: %@."
          }
        }
      }
    },
    "Their original files were not changed." : {
      "comment" : "Second sentence of the alert about several books that could not move into the current library format.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sus archivos originales no se modificaron."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I loro file originali non sono stati modificati."
          }
        }
      }
    },
    "Their places, bookmarks, and transcripts, if they have any, are kept, and they can be downloaded again." : {
      "comment" : "Sentence about several deleted downloads: what the listener left in them is kept, and they can be downloaded again.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sus lugares, marcadores y transcripciones, si los tienen, se conservan, y se pueden descargar de nuevo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La loro posizione, i segnalibri e le trascrizioni, se ne hanno, vengono conservati e possono essere scaricati di nuovo."
          }
        }
      }
    },
    "Then take it off the reading list, or clear %@ in the Reading List's options." : {
      "comment" : "Last sentence of why Remove Download was refused for a book the listener keeps and the reading list keeps too: what to do after choosing Stop Keeping on This Mac. %@ is the name of the Reading List's option that keeps its books downloaded, as the option shows it.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Luego quítalo de la lista de lectura, o desactiva %@ en las opciones de la lista de lectura."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Poi toglilo dall’elenco di lettura, oppure disattiva %@ nelle opzioni dell’elenco di lettura."
          }
        }
      }
    },
    "There are no feeds to refresh." : {
      "comment" : "What VoiceOver says when Refresh All Feeds finds no feed in the library.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay canales que actualizar."
          }
        }
      }
    },
    "There are no subscriptions to export." : {
      "comment" : "What Export OPML says when the library has no feed.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay suscripciones que exportar."
          }
        }
      }
    },
    "There are no subscriptions to export: every feed in your library is unsubscribed." : {
      "comment" : "What Export OPML says when every feed in the library is unsubscribed, which an export leaves out.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay suscripciones que exportar: todos los canales de tu biblioteca tienen la suscripción cancelada."
          }
        }
      }
    },
    "There is a file at %@, not a folder." : {
      "comment" : "First sentence of why the chosen location can't be used: a file is there. %@ is the path.\nWhy the library can't be used: a file sits where the library's folder should be. %@ is the path.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hay un archivo en %@, no una carpeta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "In %@ c’è un file, non una cartella."
          }
        }
      }
    },
    "There is no page %@ in this book." : {
      "comment" : "First sentence of the message when Go to Page is given a page the book does not have. %@ is what the user typed.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay ninguna página %@ en este libro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il libro non ha la pagina %@."
          }
        }
      }
    },
    "There is no view %@. Go to View reaches %lld views." : {
      "comment" : "VoiceOver announcement when a Go to View key has no view. %1$@ is the view's number as the listener pressed it, an identifier written without digit grouping. %2$lld is how many views Go to View reaches, a count.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "There is no view %@. Go to View reaches %lld view."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "There is no view %@. Go to View reaches %lld views."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "No hay vista %1$@. Ir a vista llega a %2$lld de vistas."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "No hay vista %1$@. Ir a vista llega a %2$lld vista."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "No hay vista %1$@. Ir a vista llega a %2$lld vistas."
                }
              }
            }
          }
        },
        "it" : {
          "variations" : {
            "plural" : {
              "many" : {
