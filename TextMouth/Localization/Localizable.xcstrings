    "audioEditor.findingPauses" : {
      "comment" : "Said when a pause command is used in the audio editor while the pauses are still being found.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يزال البحث عن الوقفات جاريًا. حاول مرة أخرى بعد قليل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এখনও নীরবতা খোঁজা হচ্ছে। কিছুক্ষণ পরে আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Pausen werden noch gesucht. Versuche es gleich erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still finding the pauses. Try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aún se están buscando las pausas. Inténtalo de nuevo en un momento."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هنوز در حال پیدا کردن وقفه‌هاست. کمی بعد دوباره تلاش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Recherche des pauses en cours. Réessayez dans un instant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "עדיין מחפש את ההפסקות. נסה שוב בעוד רגע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "विराम अभी खोजे जा रहे हैं। थोड़ी देर में फिर से प्रयास करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Masih mencari jeda. Coba lagi sebentar lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ricerca delle pause ancora in corso. Riprova tra un momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "無音を検出しているところです。少ししてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "아직 정지 구간을 찾는 중입니다. 잠시 후 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De pauzes worden nog gezocht. Probeer het zo opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wciąż trwa wyszukiwanie przerw. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ainda localizando as pausas. Tente novamente em instantes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Поиск пауз ещё идёт. Повторите попытку чуть позже."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Letar fortfarande efter pauserna. Försök igen om en stund."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ยังค้นหาช่วงหยุดอยู่ ลองอีกครั้งในอีกสักครู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Duraklamalar hâlâ bulunuyor. Biraz sonra tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Паузи ще шукаються. Спробуйте за мить."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "وقفے ابھی تلاش کیے جا رہے ہیں۔ تھوڑی دیر بعد دوبارہ کوشش کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vẫn đang tìm các quãng nghỉ. Hãy thử lại sau giây lát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "仍在查找停顿。请稍后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "仍在尋找停頓。請稍後再試。"
          }
        }
      }
    },
