        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo compactado contém um link para um arquivo fora dele, que nunca é extraído."
          }
        }
      }
    },
    "The archive holds more than the %@ it declares, so extraction stopped." : {
      "comment" : "First sentence of why an import's archive stopped extracting: it holds more than it declares. %@ is the size it declares, such as \"2 GB\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Archiv enthält mehr als die angegebenen %@, daher wurde die Extraktion gestoppt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo comprimido contiene más de los %@ que declara, así que la extracción se detuvo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’archive contient plus que les %@ qu’elle déclare ; l’extraction s’est donc arrêtée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
