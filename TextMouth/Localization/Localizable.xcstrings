    },
    "Which track of %@ do you want to edit?" : {
      "comment" : "Question asked before editing a book of several audio tracks. %@ is the book's title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Welche Spur von %@ möchtest du bearbeiten?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "¿Qué pista de %@ quieres editar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quelle piste de %@ voulez-vous modifier ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quale traccia di %@ vuoi modificare?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Qual faixa de %@ você quer editar?"
          }
        }
      }
    },
    "While TextMouth was copying its data, %@ was changed to lead to %@ instead of %@." : {
      "comment" : "First sentence of why a move of the data directory did not finish: the new location's link was changed while the data was copied. %1$@ is the link's path; %2$@ is where it leads now; %3$@ is where it led before.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Während TextMouth seine Daten kopierte, wurde %1$@ so geändert, dass es zu %2$@ statt zu %3$@ führt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "While TextMouth was copying its data, %1$@ was changed to lead to %2$@ instead of %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mientras TextMouth copiaba sus datos, %1$@ se cambió para llevar a %2$@ en lugar de %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pendant que TextMouth copiait ses données, %1$@ a été modifié pour mener à %2$@ au lieu de %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mentre TextMouth copiava i suoi dati, %@ è stato modificato in modo da portare a %@ invece che a %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Enquanto o TextMouth copiava os dados, %1$@ foi alterado para levar a %2$@ em vez de %3$@."
          }
        }
      }
    },
    "While TextMouth was copying its data, %lld items appeared in %@: %@." : {
      "comment" : "First sentence of why a move of the data directory did not finish: items appeared in the new location while the data was copied. %1$lld is how many; %2$@ is the new location's path; %3$@ is their names as a list.",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Während TextMouth seine Daten kopierte, erschien %1$lld Objekt in %2$@: %3$@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Während TextMouth seine Daten kopierte, erschienen %1$lld Objekte in %2$@: %3$@."
                }
