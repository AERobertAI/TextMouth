    "transcriptCleanup.editedSinceCleanup" : {
      "comment" : "Line of the Clean Up Transcript sheet warning that undoing the cleanup also undoes the user's later edits. %@ is a date, such as \"October 5, 2026\". Undo Cleanup is the name of a button of the sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "حرّرت النسخة النصية في %@، بعد التنظيف. يتراجع “تراجع عن التنظيف” عن هذه التعديلات أيضًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পরিষ্কার করার পর আপনি ট্রান্সক্রিপ্ট %@ তারিখে সম্পাদনা করেছেন। “পরিষ্কার করা পূর্বাবস্থায় ফেরান” বেছে নিলে সেই সম্পাদনাগুলোও পূর্বাবস্থায় ফেরে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du hast das Transkript am %@ nach der Bereinigung bearbeitet. „Bereinigung widerrufen“ widerruft diese Bearbeitungen ebenfalls."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You edited the transcript on %@, after the cleanup. Undo Cleanup undoes those edits too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Editaste la transcripción el %@, después de la limpieza. Deshacer limpieza también deshace esas ediciones."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "شما رونوشت را در %@، پس از پاک‌سازی، ویرایش کردید. «واگرد پاک‌سازی» آن ویرایش‌ها را هم واگرد می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vous avez modifié la transcription le %@, après le nettoyage. Annuler le nettoyage annule aussi ces modifications."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ערכת את התמליל בתאריך %@, לאחר הניקוי. “בטל ניקוי” מבטל גם את העריכות האלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आपने सफ़ाई के बाद, %@ को ट्रांसक्रिप्ट संपादित की। “सफ़ाई पूर्ववत करें” उन संपादनों को भी पूर्ववत करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Anda mengedit transkrip pada %@, setelah perapian. Urungkan Perapian juga mengurungkan edit tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hai modificato la trascrizione il %@, dopo la pulizia. Il comando Annulla pulizia annulla anche quelle modifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "整理のあと、%@に文字起こしを編集しています。「整理を取り消す」では、その編集も取り消されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@에 정리 후 대본을 편집했습니다. 정리 실행 취소를 선택하면 그 편집도 취소됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Je hebt de transcriptie gewijzigd op %@, na de opschoning. Maak opschoning ongedaan maakt die wijzigingen ook ongedaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transkrypcja została edytowana dnia %@, po oczyszczeniu. Cofnij oczyszczanie cofa też te edycje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Você editou a transcrição em %@, depois da limpeza. Desfazer limpeza desfaz essas edições também."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вы изменили расшифровку %@, уже после исправления. «Отменить исправление» отменяет и эти правки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du redigerade transkriptionen den %@, efter uppstädningen. Ångra uppstädning ångrar också de redigeringarna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "คุณแก้ไขข้อความถอดเสียงเมื่อ %@ หลังการตรวจแก้ คำสั่ง เลิกทำการตรวจแก้ จะเลิกทำการแก้ไขเหล่านั้นด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transkripti temizlemeden sonra %@ tarihinde düzenlediniz. Temizlemeyi Geri Al bu düzenlemeleri de geri alır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ви відредагували транскрипцію %@, після очищення. «Відмінити очищення» скасовує й ці правки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آپ نے صفائی کے بعد %@ کو ٹرانسکرپٹ میں ترمیم کی تھی۔ “صفائی کالعدم کریں” ان ترامیم کو بھی کالعدم کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bạn đã sửa bản chép lời vào ngày %@, sau lần dọn dẹp. Hoàn tác dọn dẹp cũng hoàn tác các chỉnh sửa đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "你已于 %@ 在整理之后编辑过文字稿。“撤销整理”也会撤销这些编辑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "你在清理之後，於 %@ 編輯過逐字稿。「還原清理」也會還原那些編輯。"
          }
        }
      }
    },
