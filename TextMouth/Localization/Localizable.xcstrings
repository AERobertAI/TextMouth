    "%@ is an audiobook without a transcript, so it has no text to edit." : {
      "comment" : "First sentence of the message when Edit Text is chosen for an audiobook with no transcript. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ es un audiolibro sin transcripción, así que no tiene texto para editar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ est un livre audio sans transcription, il n’a donc aucun texte à modifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ è un audiolibro senza trascrizione, quindi non ha testo da modificare."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ é um audiolivro sem transcrição, portanto não tem texto para editar."
          }
        }
      }
    },
    "%@ is an item of a feed, and a feed's items can't be moved." : {
      "comment" : "VoiceOver announcement when Move Book Up or Move Book Down is used on an episode or article of a feed in a folder. %@ is its title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ist ein Element eines Feeds, und die Elemente eines Feeds lassen sich nicht bewegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ es un elemento de un canal, y los elementos de un canal no se pueden mover."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ est un élément d’un flux, et les éléments d’un flux ne peuvent pas être déplacés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ è un elemento di un feed e gli elementi di un feed non possono essere spostati."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ é um item de um feed, e os itens de um feed não podem ser movidos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 是订阅源的项目，订阅源的项目无法移动。"
          }
        }
      }
    },
    "%@ is being transcribed. Cancel it, or attach the transcript once it finishes." : {
      "comment" : "Alert shown when Attach Transcript is chosen for an audiobook that is being transcribed. %@ is the audiobook's title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ wird gerade transkribiert. Brich den Vorgang ab oder hänge das Transkript an, sobald er fertig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ se está transcribiendo. Cancélalo o adjunta la transcripción cuando termine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ est en cours de transcription. Annulez-la, ou joignez la transcription une fois qu’elle est terminée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il libro %@ è in fase di trascrizione. Annullala, oppure allega la trascrizione al termine."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ está sendo transcrito. Cancele a transcrição ou anexe a transcrição quando ela terminar."
          }
        }
      }
    },
    "%@ is being transcribed. Cancel it, or delete the transcript once it finishes." : {
      "comment" : "Alert shown when Delete Transcript is chosen for an audiobook that is being transcribed. %@ is the audiobook's title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ wird gerade transkribiert. Brich den Vorgang ab oder lösche das Transkript, sobald er fertig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ se está transcribiendo. Cancélalo o elimina la transcripción cuando termine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ est en cours de transcription. Annulez-la, ou supprimez la transcription une fois qu’elle est terminée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il libro %@ è in fase di trascrizione. Annullala, oppure elimina la trascrizione al termine."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ está sendo transcrito. Cancele a transcrição ou exclua a transcrição quando ela terminar."
          }
        }
      }
    },
    "%@ is being transcribed. Clean up its transcript once that finishes." : {
      "comment" : "Alert shown when Clean Up Transcript is chosen for an audiobook that is being transcribed. %@ is the audiobook's title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ wird gerade transkribiert. Bereinige das Transkript, sobald der Vorgang fertig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ se está transcribiendo. Limpia su transcripción cuando termine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ est en cours de transcription. Nettoyez sa transcription une fois qu’elle est terminée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il libro %@ è in fase di trascrizione. Pulisci la trascrizione al termine."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ está sendo transcrito. Limpe a transcrição quando ela terminar."
          }
        }
      }
    },
    "%@ is filed %@ in %@ and %@ in %@." : {
      "comment" : "A difference found by Compare Libraries. %1$@ is a book's title, %2$@ says where this copy files it (at the top of the library, or in a folder), %3$@ is this copy, %4$@ says where the other copy files it, %5$@ is the other copy.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ist abgelegt: %3$@ %2$@, %5$@ %4$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is filed %2$@ in %3$@ and %4$@ in %5$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En %3$@, %1$@ está %2$@; en %5$@, está %4$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ est classé %@ dans %@ et %@ dans %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ si trova %@ in %@ e %@ in %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Em %3$@, %1$@ está %2$@; em %5$@, está %4$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 在 %3$@ 中归档于%2$@，在 %5$@ 中归档于%4$@。"
          }
        }
      }
    },
    "%@ is in %@, which TextMouth on iPhone can't play yet." : {
      "comment" : "First sentence of the refusal of an audio file the iPhone can't convert. %1$@ is the file's quoted name, or \"This file\". %2$@ is the audio format's name, as in \"Ogg\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ liegt als %2$@ vor, was TextMouth auf dem iPhone noch nicht wiedergeben kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is in %2$@, which TextMouth on iPhone can't play yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ está en %2$@, que TextMouth en el iPhone aún no puede reproducir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ est au format %2$@, que TextMouth sur iPhone ne peut pas encore lire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ è in %2$@, che TextMouth su iPhone non può ancora riprodurre."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ está em %2$@, que o TextMouth no iPhone ainda não consegue reproduzir."
          }
        }
      }
    },
    "%@ is in a skipped section, so the cursor is %@." : {
      "comment" : "Announcement after Go to Page when every word of the page typed is in a skipped section. %1$@ names the page, such as \"Page 40\" or \"The first page labelled 3\"; %2$@ says where the cursor is, such as \"on page 52\" or \"before page 1\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is in a skipped section, so the cursor is %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ está en una sección omitida, así que el cursor está %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ se trouve dans une section ignorée, le curseur est donc %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ si trova in una sezione saltata, quindi il cursore è %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ está em uma seção ignorada, então o cursor está %2$@."
          }
        }
      }
    },
    "%@ is in your library, unsubscribed. Choose %@ on its row, or in its %@, to check it again." : {
      "comment" : "Why Subscribe refused: the feed is in the library but unsubscribed. The first %@ is the feed's title; the second is the name of the Resubscribe command; the third is the name of the Feed Info sheet.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ist in deiner Bibliothek, aber abbestellt. Wähle %2$@ in der Zeile oder unter %3$@, um den Feed erneut zu prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is in your library, unsubscribed. Choose %2$@ on its row, or in its %3$@, to check it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ está en tu biblioteca, sin suscripción. Elige %2$@ en su fila, o en su %3$@, para volver a revisarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ figure dans votre bibliothèque, mais sans abonnement. Choisissez %2$@ sur sa ligne, ou dans %3$@, pour le vérifier de nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ è nella tua libreria, ma l’iscrizione è annullata. Scegli %2$@ nella sua riga, o nel foglio %3$@, per controllarlo di nuovo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ está na sua biblioteca, sem assinatura. Escolha %2$@ na linha dele, ou em %3$@, para verificá-lo novamente."
          }
        }
      }
    },
    "%@ is kept on this Mac for the reading list." : {
      "comment" : "First sentence of why Stop Keeping on This Mac changed nothing for one book: the reading list keeps it. %@ is the book's title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ wird für die Leseliste auf diesem Mac behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ se mantiene en esta Mac por la lista de lectura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ est conservé sur ce Mac pour la liste de lecture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ è mantenuto su questo Mac per l’elenco di lettura."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ é mantido neste Mac para a lista de leitura."
          }
        }
      }
    },
    "%@ is no longer in the library." : {
      "comment" : "Announcement when the book of a search match has left the library since the search. %@ is the book's title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ist nicht mehr in der Bibliothek."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ya no está en la biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ n’est plus dans la bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ non è più nella libreria."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ não está mais na biblioteca."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 已不在资料库中。"
          }
        }
      }
    },
    "%@ is not a valid library folder location." : {
      "comment" : "Error shown when a folder edit is refused because its location is not a safe library path. %@ is the location, in straight double quotes.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ist kein gültiger Ort für einen Bibliotheksordner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no es una ubicación válida para una carpeta de la biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ n’est pas un emplacement valide de dossier de bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ non è una posizione valida per una cartella della libreria."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ não é uma localização válida para uma pasta da biblioteca."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 不是有效的资料库文件夹位置。"
          }
        }
      }
    },
    "%@ is now in effect: %@." : {
      "comment" : "What VoiceOver says once a change of the global List and download choice takes effect. The first %@ is the name of the choice; the second is the choice now in force, such as \"Every item listed, newest 3 downloaded\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ gilt jetzt: %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is now in effect: %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ya se aplica: %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ est désormais appliqué : %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ è ora impostato su: %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ está em vigor: %2$@."
          }
        }
      }
    },
    "%@ is only in the cloud and isn't on this Mac yet, so nothing was written over it." : {
      "comment" : "First sentence of why a file was not saved: it is only in the cloud. %@ is the file's name, which stays as written.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ liegt nur in der Cloud und noch nicht auf diesem Mac, daher wurde nichts überschrieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ solo está en la nube y aún no está en esta Mac, así que no se escribió nada encima."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ se trouve uniquement dans le cloud et n’est pas encore sur ce Mac ; rien n’a donc été écrit par-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ è solo nel cloud e non è ancora su questo Mac, quindi non è stato sovrascritto nulla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ está apenas na nuvem e ainda não está neste Mac; por isso, nada foi sobrescrito."
          }
        }
      }
    },
    "%@ is open in a reader. Close it, then choose Edit Audio again." : {
      "comment" : "Said when a book's reader did not close, so the audio editor can't open. %@ is the book's title. \"Edit Audio\" is the name of the command.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ist in einer Leseansicht geöffnet. Schließe sie und wähle dann erneut „Audio bearbeiten“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ está abierto en un lector. Ciérralo y elige Editar audio de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un lecteur est ouvert sur %@. Fermez-le, puis choisissez à nouveau Modifier l’audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il libro %@ è aperto in un lettore. Chiudilo, poi scegli di nuovo Modifica audio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ está aberto em um leitor. Feche-o e escolha Editar áudio de novo."
          }
        }
      }
    },
    "%@ is set to be read as “%@”, a text encoding this version of TextMouth can't read." : {
      "comment" : "First sentence of why a book set to an unknown text encoding cannot be read. %1$@ names the book, as in “Ledger”, and %2$@ is the encoding's stored identifier.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ soll als „%2$@“ gelesen werden, eine Textcodierung, die diese Version von TextMouth nicht lesen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is set to be read as “%2$@”, a text encoding this version of TextMouth can't read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ está configurado para leerse como “%2$@”, una codificación de texto que esta versión de TextMouth no puede leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ est réglé pour être lu en « %@ », un encodage de texte que cette version de TextMouth ne peut pas lire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ è impostato per essere letto come «%@», una codifica del testo che questa versione di TextMouth non sa leggere."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A leitura de %1$@ está definida como “%2$@”, uma codificação de texto que esta versão do TextMouth não consegue ler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 被设为按“%2$@”读取，这是此版本的 TextMouth 无法读取的文本编码。"
          }
        }
      }
    },
    "%@ is that folder or one of its subfolders." : {
      "comment" : "Second sentence of the error shown when a folder is moved into itself. %@ is the chosen destination's location, in straight double quotes.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ist dieser Ordner oder einer seiner Unterordner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ es esa carpeta o una de sus subcarpetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ est ce dossier ou l’un de ses sous-dossiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ è quella cartella o una delle sue sottocartelle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ é essa pasta ou uma de suas subpastas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 就是该文件夹或其某个子文件夹。"
          }
        }
      }
    },
    "%@ is the newer. It has %@." : {
      "comment" : "Sentence of Use This Library's account of which copy is newer. %1$@ is a copy of the library, capitalized, and %2$@ lists what only it has, such as \"newer places in 3 books and 2 books the other lacks\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ist die neuere. Sie hat %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
