            "value" : "Votre bibliothèque (%1$@) sera envoyée vers %2$@ en arrière-plan."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आपकी लाइब्रेरी (%1$@) पृष्ठभूमि में %2$@ पर अपलोड होगी।"
          }
        },
        "id" : {
          "stringUnit" : {
