        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ là một mục của nguồn cấp, và không thể di chuyển các mục của nguồn cấp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 是订阅源的项目，订阅源的项目无法移动。"
