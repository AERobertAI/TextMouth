    "sleepTimerView.customMinutesHint" : {
      "comment" : "VoiceOver hint of the sleep timer sheet's custom minutes field on the Mac: the fewest and most minutes it takes, and what the Return key does there. %1$lld is the fewest (1); %2$lld the most (480). Return is the name of the key.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يقبل من %1$lld إلى %2$lld دقيقة. يضبط Return المؤقت ويشغّل الكتاب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$lld থেকে %2$lld মিনিট দেওয়া যায়। রিটার্ন চাপলে টাইমার সেট হয় এবং বইটি চলে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Akzeptiert %1$lld bis %2$lld Minuten. Mit Return wird der Timer gestellt und das Buch wiedergegeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takes %lld to %lld minutes. Return sets the timer and plays the book."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Admite de %1$lld a %2$lld minutos. Retorno programa el temporizador y reproduce el libro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$lld تا %2$lld دقیقه می‌پذیرد. Return زمان‌سنج را تنظیم می‌کند و کتاب را پخش می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Accepte de %1$lld à %2$lld minutes. La touche Retour règle le minuteur et lit le livre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מקבל %1$lld עד %2$lld דקות. Return מגדיר את הטיימר ומנגן את הספר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$lld से %2$lld मिनट तक स्वीकार करता है। रिटर्न टाइमर सेट करता है और पुस्तक चलाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menerima %1$lld hingga %2$lld menit. Return mengatur timer dan memutar buku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Accetta da %1$lld a %2$lld minuti. Invio imposta il timer e riproduce il libro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$lld分から%2$lld分まで指定できます。Return キーでタイマーをセットしてブックを再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$lld분에서 %2$lld분까지 입력할 수 있습니다. Return 키를 누르면 타이머가 설정되고 책이 재생됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Accepteert %1$lld tot %2$lld minuten. Met Return stel je de timer in en speel je het boek af."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Przyjmuje od %1$lld do %2$lld minut. Return ustawia minutnik i odtwarza książkę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aceita de %1$lld a %2$lld minutos. Return define o timer e reproduz o livro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Допустимо от %1$lld до %2$lld минут. Return запускает таймер и воспроизводит книгу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tar emot %1$lld till %2$lld minuter. Retur ställer in timern och spelar upp boken."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "รับค่า %1$lld ถึง %2$lld นาที กด Return เพื่อตั้งตัวจับเวลาและเล่นหนังสือ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$lld ile %2$lld dakika arasını kabul eder. Return zamanlayıcıyı ayarlar ve kitabı oynatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Приймає від %1$lld до %2$lld хвилин. Return задає таймер і відтворює книгу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$lld سے %2$lld منٹ تک قبول کرتا ہے۔ ریٹرن ٹائمر سیٹ کرتا ہے اور کتاب چلاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nhận giá trị từ %1$lld đến %2$lld phút. Phím Return đặt bộ hẹn giờ và phát sách."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "范围为 %1$lld 到 %2$lld 分钟。按 Return 键设定定时器并播放图书。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "可接受 %1$lld 到 %2$lld 分鐘。按下 Return 會設定計時器並播放這本書。"
          }
        }
      }
