    "audioEditor.explanation.editorAddMarker" : {
      "comment" : "Hint of the audio editor's Add Marker button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يضع علامة عند المؤشر، حتى أثناء تشغيل الصوت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "অডিও চলার সময়ও কার্সরের জায়গায় একটি মার্কার রাখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Setzt einen Marker am Cursor, auch während das Audio wiedergegeben wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drops a marker at the cursor, even while the audio plays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Coloca una marca en el cursor, incluso mientras se reproduce el audio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یک علامت در محل مکان‌نما می‌گذارد، حتی وقتی صدا پخش می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dépose un marqueur au curseur, même pendant la lecture de l’audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מניח נקודת ציון בסמן, גם בזמן שהשמע מתנגן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कर्सर पर मार्कर लगाता है, ऑडियो चलते समय भी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menaruh penanda di posisi kursor, bahkan saat audio diputar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Inserisce un marcatore nella posizione del cursore, anche durante la riproduzione dell’audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オーディオの再生中でも、カーソルの位置にマーカーを置きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "오디오가 재생되는 중에도 커서 위치에 마커를 놓습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Plaatst een markering bij de cursor, ook terwijl de audio wordt afgespeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wstawia znacznik przy kursorze, nawet podczas odtwarzania dźwięku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Coloca uma marca no cursor, mesmo enquanto o áudio é reproduzido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ставит метку в позиции курсора, даже когда аудио воспроизводится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sätter ett ljudmärke vid markören, även medan ljudet spelas upp."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "วางเครื่องหมายที่เคอร์เซอร์ แม้ขณะที่เสียงกำลังเล่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "İmleç konumuna, ses çalarken bile bir işaret bırakır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ставить мітку в місці курсора, навіть коли аудіо відтворюється."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کرسر کی جگہ مارکر لگاتا ہے، آڈیو چلتے ہوئے بھی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đặt một điểm đánh dấu tại con trỏ, kể cả khi âm thanh đang phát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在光标处放置标记，即使音频正在播放也可以。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在游標處放置標記，即使音訊正在播放也可以。"
          }
        }
      }
    },
    "audioEditor.explanation.editorApplyFilter" : {
      "comment" : "Hint of the audio editor's Apply Filter button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يطبّق إعدادًا مسبقًا للمرشح على التحديد أو على الملف كله."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "নির্বাচিত অংশে বা পুরো ফাইলে একটি ফিল্টার প্রিসেট চালায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wendet eine Filtervoreinstellung auf die Auswahl oder die ganze Datei an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs a filter preset over the selection or the whole file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aplica un preajuste de filtro a la selección o a todo el archivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پیش‌تنظیم فیلتر را روی انتخاب یا کل فایل اجرا می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Applique un préréglage de filtre à la sélection ou à tout le fichier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מריץ הגדרה מוכנה של מסנן על הבחירה או על הקובץ כולו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चयन या पूरी फ़ाइल पर फ़िल्टर प्रीसेट चलाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menjalankan preset filter pada pilihan atau seluruh file."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Applica un preset di filtro alla selezione o a tutto il file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選択範囲またはファイル全体に、フィルタプリセットを適用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "선택 영역 또는 전체 파일에 필터 프리셋을 실행합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Past een filtervoorinstelling toe op de selectie of het hele bestand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uruchamia ustawienie wstępne filtra dla zaznaczenia albo całego pliku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aplica uma predefinição de filtro à seleção ou ao arquivo inteiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
