    },
    "This re-extracts the cached text of every book, which may take a while for a large library." : {
      "comment" : "First sentence of the Redo Text Extraction question.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dadurch wird der zwischengespeicherte Text jedes Buchs neu extrahiert, was bei einer großen Bibliothek eine Weile dauern kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esto vuelve a extraer el texto en caché de cada libro, lo que puede tardar un poco en una biblioteca grande."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cela réextrait le texte en cache de chaque livre, ce qui peut prendre du temps pour une grande bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo estrae di nuovo il testo memorizzato nella cache di ogni libro, e potrebbe richiedere un po’ di tempo per una libreria grande."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Isso extrai de novo o texto em cache de todos os livros, o que pode demorar em uma biblioteca grande."
          }
        }
      }
    },
    "This recording isn't saved. %@ tries again, %@ deletes it, and %@ keeps the window open." : {
      "comment" : "Explanation under the question asked when the Record window is closed with a recording that could not be saved. %1$@, %2$@, and %3$@ are the titles of the question's three buttons: the one that saves, the one that deletes the recording, and the one that keeps the window open.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Diese Aufnahme ist nicht gesichert. „%1$@“ versucht es erneut, „%2$@“ löscht sie, und „%3$@“ lässt das Fenster geöffnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This recording isn't saved. %1$@ tries again, %2$@ deletes it, and %3$@ keeps the window open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta grabación no está guardada. %1$@ lo intenta de nuevo, %2$@ la elimina y %3$@ mantiene abierta la ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cet enregistrement n’est pas enregistré. %1$@ réessaie, %2$@ le supprime, et %3$@ garde la fenêtre ouverte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questa registrazione non è salvata. %1$@ riprova, %2$@ la elimina e %3$@ lascia aperta la finestra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta gravação não foi salva. %1$@ tenta de novo, %2$@ a exclui e %3$@ mantém a janela aberta."
          }
        }
      }
    },
    "This recreates the directory structure and migrates books using old storage." : {
      "comment" : "First sentence of the Rebuild Directory confirmation.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dadurch wird die Verzeichnisstruktur neu erstellt, und Bücher mit alter Speicherung werden migriert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esto vuelve a crear la estructura de directorios y migra los libros que usan el almacenamiento antiguo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cela recrée la structure de dossiers et migre les livres qui utilisent l’ancien stockage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo ricrea la struttura della cartella e migra i libri che usano la vecchia archiviazione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Isso recria a estrutura do diretório e migra os livros que usam o armazenamento antigo."
          }
        }
      }
    },
    "This view is as TextMouth made it." : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). Restore Default…'s hint for a built-in view as TextMouth made it, or Folders or the Reading List, when it is dimmed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
