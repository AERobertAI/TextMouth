            "value" : "Una virgoletta non è chiusa in “%@”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」で引用符が閉じられていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@”에 닫히지 않은 따옴표가 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uma aspa simples não foi fechada em “%@”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В «%@» не закрыта кавычка."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не закрито лапку в «%@»."
          }
        },
