    "transcription.attachWhileTranscribing" : {
      "comment" : "Alert shown when Attach Transcript is chosen for an audiobook that is being transcribed. %@ is the audiobook's title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يجري تفريغ %@. ألغِ التفريغ، أو أرفق النسخة النصية بعد اكتماله."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ট্রান্সক্রাইব করা হচ্ছে। এটি বাতিল করুন, অথবা শেষ হলে ট্রান্সক্রিপ্ট সংযুক্ত করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ wird gerade transkribiert. Brich den Vorgang ab oder hänge das Transkript an, sobald er fertig ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is being transcribed. Cancel it, or attach the transcript once it finishes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ se está transcribiendo. Cancélalo o adjunta la transcripción cuando termine."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ در حال رونویسی است. آن را لغو کنید، یا پس از پایان کار، رونوشت را پیوست کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ est en cours de transcription. Annulez-la, ou joignez la transcription une fois qu’elle est terminée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ בתהליך תמלול. בטל את התמלול, או צרף תמליל לאחר שיסתיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ को ट्रांसक्राइब किया जा रहा है। इसे रद्द करें, या इसके पूरा होने पर ट्रांसक्रिप्ट संलग्न करें।"
