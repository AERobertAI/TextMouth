          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ข้อความของหนังสือมีการเปลี่ยนแปลงที่ TextMouth คัดลอกไม่ได้ จึงปล่อยข้อความไว้ตามเดิม"
