    },
    "TextMouth left them there and is still using %@." : {
      "comment" : "Second sentence of why a move of the data directory did not finish, when several items appeared: TextMouth left the items and kept using the current data directory. %@ is the current data directory's path.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تركها TextMouth هناك ولا يزال يستخدم %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth সেগুলো সেখানেই রেখেছে এবং এখনো %@ ব্যবহার করছে।"
          }
        },
        "de" : {
