          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "बदलने पर मौजूदा प्रति की पठन स्थिति, बुकमार्क, सेटिंग, फ़ोल्डर और रीडिंग लिस्ट में उसकी जगह रखी जाती है, और ऑडियो वही होने पर उसका ट्रांसक्रिप्ट भी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Penggantian mempertahankan posisi baca, markah, pengaturan, folder, dan posisi salinan yang ada di Daftar Bacaan, serta transkripnya bila audionya sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La sostituzione conserva la posizione di lettura, i segnalibri, le impostazioni, la cartella e la posizione nell’elenco di lettura della copia esistente, e la sua trascrizione quando l’audio è lo stesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "置き換えても、既存のコピーの読み上げ位置、ブックマーク、設定、フォルダ、リーディングリストでの位置は保持されます。オーディオが同じ場合は、既存の文字起こしも保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "대체하면 기존 사본의 읽기 위치, 북마크, 설정, 폴더, 읽기 목록 위치가 유지되며, 오디오가 같으면 대본도 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Substituir mantém a posição de leitura, os marcadores, os ajustes, a pasta e o lugar da cópia existente na lista de leitura, e a transcrição dela quando o áudio é o mesmo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "При замене сохраняются позиция чтения, закладки, настройки, папка и место существующей копии в списке для чтения, а также её расшифровка, если аудио то же."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Заміна зберігає позицію читання, закладки, налаштування, папку та місце у списку читання наявної копії, а також її транскрипцію, якщо аудіо те саме."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "替换会保留现有副本的阅读位置、书签、设置、文件夹以及在阅读列表中的位置；当音频相同时，还会保留其文字稿。"
          }
        }
      }
    },
