    "Any other book passes over The, A, and An." : {
      "comment" : "Second sentence of the note under the Leading Articles pop-up: the articles skipped for a book in any other language. The, A, and An are the English articles and stay as written.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أي كتاب آخر يتجاوز The وA وAn."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "অন্য যেকোনো বইয়ের ক্ষেত্রে The, A এবং An বাদ দেওয়া হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jedes andere Buch übergeht „The“, „A“ und „An“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cualquier otro libro omite The, A y An."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tout autre livre ignore The, A et An."
