    "audioEditor.revertExplanation.another" : {
      "comment" : "Explains the audio editor's Revert to Original confirmation: how many edits it undoes. %lld is the number of edits.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "تم التراجع عن %lld تعديلات. يعيدها الأمر “إعادة” ما لم تُجرِ تعديلًا آخر."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "تم التراجع عن %lld تعديلًا. يعيدها الأمر “إعادة” ما لم تُجرِ تعديلًا آخر."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "تم التراجع عن %lld تعديل. يعيده الأمر “إعادة” ما لم تُجرِ تعديلًا آخر."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "تم التراجع عن %lld تعديل. يعيدها الأمر “إعادة” ما لم تُجرِ تعديلًا آخر."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "تم التراجع عن %lld تعديلين. يعيدهما الأمر “إعادة” ما لم تُجرِ تعديلًا آخر."
                }
              },
              "zero" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "تم التراجع عن %lld تعديلات. يعيدها الأمر “إعادة” ما لم تُجرِ تعديلًا آخر."
                }
              }
            }
          }
        },
        "bn" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "%lldটি সম্পাদনা পূর্বাবস্থায় ফেরানো হয়েছে। আরেকটি সম্পাদনা না করা পর্যন্ত “পুনরায় করুন” বেছে নিলে সেগুলো ফিরে আসে।"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "%lldটি সম্পাদনা পূর্বাবস্থায় ফেরানো হয়েছে। আরেকটি সম্পাদনা না করা পর্যন্ত “পুনরায় করুন” বেছে নিলে সেগুলো ফিরে আসে।"
                }
              }
            }
          }
        },
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "%lld Bearbeitung wird widerrufen. „Wiederholen“ holt sie zurück, solange du nichts Neues bearbeitest."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "%lld Bearbeitungen werden widerrufen. „Wiederholen“ holt sie zurück, solange du nichts Neues bearbeitest."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld edit is undone. Redo brings them back until you make another edit."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld edits are undone. Redo brings them back until you make another edit."
                }
