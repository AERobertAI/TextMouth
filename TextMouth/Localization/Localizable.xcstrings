    "audioFilterPresets.resetAllHint" : {
      "comment" : "Hint of the Reset All to Defaults button in the filter presets sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعيد إعدادات TextMouth المسبقة الجاهزة، ويزيل التي أضفتها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আপনার যোগ করাগুলো সরিয়ে TextMouth-এর তৈরি করা প্রিসেট ফিরিয়ে আনে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stellt die vorgefertigten Voreinstellungen von TextMouth wieder her und entfernt die, die du hinzugefügt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puts back TextMouth's premade presets, removing the ones you added."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Restablece los preajustes originales de TextMouth y quita los que agregaste."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پیش‌تنظیم‌های آماده TextMouth را برمی‌گرداند و آن‌هایی را که افزوده‌اید برمی‌دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Remet les préréglages d’origine de TextMouth et retire ceux que vous avez ajoutés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מחזיר את ההגדרות המוכנות של TextMouth ומסיר את אלה שהוספת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth के पहले से बने प्रीसेट वापस लाता है, और आपके जोड़े हुए प्रीसेट हटा देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mengembalikan preset bawaan TextMouth, dan membuang preset yang Anda tambahkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ripristina i preset predefiniti di TextMouth, rimuovendo quelli che hai aggiunto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 標準のプリセットに戻し、追加したものを取り除きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth의 기본 제공 프리셋을 복원하고, 추가한 프리셋은 제거합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Herstelt de ingebouwde voorinstellingen van TextMouth en verwijdert de voorinstellingen die je hebt toegevoegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Przywraca fabryczne ustawienia wstępne TextMouth i usuwa te, które dodano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Restaura as predefinições prontas do TextMouth e remove as que você adicionou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Возвращает готовые пресеты TextMouth и удаляет добавленные вами."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Återställer de färdiga förinställningarna i TextMouth och tar bort dem som du har lagt till."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "นำค่าที่ตั้งไว้ล่วงหน้าที่ TextMouth สร้างไว้กลับคืน และลบรายการที่คุณเพิ่ม"
