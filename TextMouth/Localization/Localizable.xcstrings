    "sync.remove.offline" : {
      "comment" : "Why Remove Download left a book's files on this device: it is offline. %@ is \"this Mac\" or \"this iPhone\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يستطيع TextMouth التحقق من النسخة في iCloud Drive بينما %@ غير متصل بالإنترنت، لذا يبقى التنزيل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ অফলাইন থাকলে TextMouth iCloud Drive-এর কপি যাচাই করতে পারে না, তাই ডাউনলোড থেকে যাচ্ছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kann die Kopie in iCloud Drive nicht prüfen, solange %@ offline ist; daher bleibt der Download."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
