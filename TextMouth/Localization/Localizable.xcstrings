    "A quote isn't closed in “%@”." : {
      "comment" : "Problem found in a typed filter chain: a single quote is opened and never closed. %@ is the text of the part holding it.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "علامة اقتباس غير مغلقة في “%@”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "In „%@“ ist ein Anführungszeichen nicht geschlossen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Falta cerrar unas comillas en “%@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un guillemet simple n’est pas fermé dans « %@ »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” में एक उद्धरण चिह्न बंद नहीं किया गया है।"
          }
        },
        "id" : {
          "stringUnit" : {
