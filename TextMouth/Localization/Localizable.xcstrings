    "sync.removeAfter.hint" : {
      "comment" : "VoiceOver hint of the setting that removes the downloads of books left unopened for some days.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يزيل تنزيل الكتاب من هذا الجهاز إذا لم تفتحه خلال هذه المدة. يبقى الكتاب في iCloud Drive."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "কোনো বই এত সময় না খুললে এই ডিভাইস থেকে তার ডাউনলোড সরিয়ে দেয়। বইটি iCloud Drive-এ থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Entfernt den Download eines Buchs von diesem Gerät, wenn du es so lange nicht geöffnet hast. Das Buch bleibt in iCloud Drive."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes a book's download from this device once you haven't opened it for this long. The book stays in iCloud Drive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quita la descarga de un libro de este dispositivo cuando no lo abres durante este tiempo. El libro sigue en iCloud Drive."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اگر کتابی را این مدت باز نکرده باشید، بارگیری آن را از این دستگاه برمی‌دارد. کتاب در iCloud Drive می‌ماند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Retire le téléchargement d’un livre de cet appareil quand vous ne l’avez pas ouvert pendant ce délai. Le livre reste dans iCloud Drive."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מסיר את ההורדה של ספר מהמכשיר הזה אם לא פתחת אותו במשך פרק הזמן הזה. הספר נשאר ב-iCloud Drive."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "अगर आपने कोई पुस्तक इतने समय तक नहीं खोली, तो इस डिवाइस से उसका डाउनलोड हटाता है। पुस्तक iCloud Drive में बनी रहती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuang unduhan buku dari perangkat ini jika Anda tidak membukanya selama itu. Buku tetap ada di iCloud Drive."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rimuove il download di un libro da questo dispositivo quando non lo apri per questo periodo. Il libro resta in iCloud Drive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "この期間ブックを開かなかった場合、このデバイスからそのブックのダウンロードを取り除きます。ブックは iCloud Drive に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 기간 동안 열지 않은 책의 다운로드를 이 기기에서 제거합니다. 책은 iCloud Drive에 남아 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Verwijdert de download van een boek van dit apparaat als je het zo lang niet hebt geopend. Het boek blijft in iCloud Drive."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usuwa pobrany plik książki z tego urządzenia, jeśli nie otwierasz jej przez tak długi czas. Książka pozostaje w iCloud Drive."
