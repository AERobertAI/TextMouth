          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth liest „%@“ gerade in einer anderen Codierung erneut. Versuche es erneut, wenn das beendet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth is reading “%@” again in another encoding. Try again when that finishes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth está volviendo a leer “%@” con otra codificación. Inténtalo de nuevo cuando termine."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth در حال خواندن دوباره‌ی «%@» با کدگذاری دیگری است. پس از پایان آن دوباره تلاش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
