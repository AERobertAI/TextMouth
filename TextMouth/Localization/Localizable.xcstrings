            "value" : "%@ non è una posizione valida per una cartella della libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@はライブラリフォルダの場所として無効です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@은(는) 올바른 보관함 폴더 위치가 아닙니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ não é uma localização válida para uma pasta da biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ — недопустимое расположение папки библиотеки."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ — недійсне розташування папки бібліотеки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 不是有效的资料库文件夹位置。"
          }
        }
      }
    },
    "%@ is now in effect: %@." : {
      "comment" : "What VoiceOver says once a change of the global List and download choice takes effect. The first %@ is the name of the choice; the second is the choice now in force, such as \"Every item listed, newest 3 downloaded\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ gilt jetzt: %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is now in effect: %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ya se aplica: %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ est désormais appliqué : %2$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ अब लागू है: %2$@।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ kini berlaku: %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ è ora impostato su: %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@が有効になりました：%2$@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 설정이 적용되었습니다: %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ está em vigor: %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ теперь действует: %2$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ тепер діє: %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@现已生效：%2$@。"
          }
        }
      }
    },
    "%@ is only in the cloud and isn't on this Mac yet, so nothing was written over it." : {
      "comment" : "First sentence of why a file was not saved: it is only in the cloud. %@ is the file's name, which stays as written.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ موجود في السحابة فقط وليس على هذا الـ Mac بعد، لذا لم يُكتب فوقه أي شيء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ শুধু ক্লাউডে আছে, এখনো এই Mac-এ নেই, তাই এর ওপর কিছু লেখা হয়নি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ liegt nur in der Cloud und noch nicht auf diesem Mac, daher wurde nichts überschrieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ solo está en la nube y aún no está en esta Mac, así que no se escribió nada encima."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ se trouve uniquement dans le cloud et n’est pas encore sur ce Mac ; rien n’a donc été écrit par-dessus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ केवल क्लाउड में है और अभी इस Mac पर नहीं है, इसलिए उसके ऊपर कुछ नहीं लिखा गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ hanya ada di cloud dan belum ada di Mac ini, jadi tidak ada yang ditimpa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ è solo nel cloud e non è ancora su questo Mac, quindi non è stato sovrascritto nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@はクラウドにのみあり、まだこの Mac にないため、上書きされませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@은(는) 클라우드에만 있고 아직 이 Mac에 없어서 덮어쓰지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ está apenas na nuvem e ainda não está neste Mac; por isso, nada foi sobrescrito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл %@ есть только в облаке и ещё не на этом Mac, поэтому поверх него ничего не записано."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ є лише в хмарі й ще не на цьому Mac, тому нічого не перезаписано."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 仅存在于云端，尚未下载到这台 Mac，因此没有覆盖它。"
          }
        }
      }
    },
    "%@ is open in a reader. Close it, then choose Edit Audio again." : {
      "comment" : "Said when a book's reader did not close, so the audio editor can't open. %@ is the book's title. \"Edit Audio\" is the name of the command.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ مفتوح في القارئ. أغلقه، ثم اختر “تحرير الصوت” مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ist in einer Leseansicht geöffnet. Schließe sie und wähle dann erneut „Audio bearbeiten“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ está abierto en un lector. Ciérralo y elige Editar audio de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un lecteur est ouvert sur %@. Fermez-le, puis choisissez à nouveau Modifier l’audio."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ को किसी रीडर में खोला गया है। इसे बंद करें, फिर ऑडियो संपादित करें दोबारा चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ terbuka di pembaca. Tutup pembacanya, lalu pilih Edit Audio lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il libro %@ è aperto in un lettore. Chiudilo, poi scegli di nuovo Modifica audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@はリーダで開かれています。リーダを閉じてから、もう一度「オーディオを編集」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@이(가) 리더에서 열려 있습니다. 리더를 닫은 다음 오디오 편집을 다시 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ está aberto em um leitor. Feche-o e escolha Editar áudio de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Книга «%@» открыта в окне чтения. Закройте его и снова выберите «Изменить аудио»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ відкрито у вікні читання. Закрийте його й знову виберіть «Редагувати аудіо»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@”已在阅读器中打开。请将其关闭，然后再次选取“编辑音频”。"
          }
        }
      }
    },
    "%@ is set to be read as “%@”, a text encoding this version of TextMouth can't read." : {
      "comment" : "First sentence of why a book set to an unknown text encoding cannot be read. %1$@ names the book, as in “Ledger”, and %2$@ is the encoding's stored identifier.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم ضبط قراءة %1$@ بترميز النص “%2$@”، وهذا الإصدار من TextMouth لا يستطيع قراءته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ soll als „%2$@“ gelesen werden, eine Textcodierung, die diese Version von TextMouth nicht lesen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is set to be read as “%2$@”, a text encoding this version of TextMouth can't read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ está configurado para leerse como “%2$@”, una codificación de texto que esta versión de TextMouth no puede leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ est réglé pour être lu en « %@ », un encodage de texte que cette version de TextMouth ne peut pas lire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ को “%2$@” के रूप में पढ़ने के लिए सेट किया गया है, जो TextMouth का यह वर्ज़न नहीं पढ़ सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ diatur untuk dibaca sebagai “%@”, pengodean teks yang tidak dapat dibaca oleh versi TextMouth ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ è impostato per essere letto come “%@”, una codifica del testo che questa versione di TextMouth non sa leggere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@は「%2$@」として読み込む設定ですが、このバージョンの TextMouth ではこの文字エンコーディングを読み込めません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@은(는) “%2$@” 텍스트 인코딩으로 읽도록 설정되어 있지만, 이 TextMouth 버전에서는 읽을 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A leitura de %1$@ está definida como “%2$@”, uma codificação de texto que esta versão do TextMouth não consegue ler."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Для книги %1$@ выбрано чтение в кодировке «%2$@», которую эта версия TextMouth не поддерживает."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@: вибрано читання як «%2$@» — кодування тексту, якого ця версія TextMouth не підтримує."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 被设为按“%2$@”读取，这是此版本的 TextMouth 无法读取的文本编码。"
          }
        }
      }
    },
    "%@ is that folder or one of its subfolders." : {
      "comment" : "Second sentence of the error shown when a folder is moved into itself. %@ is the chosen destination's location, in straight double quotes.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ هو ذلك المجلد أو أحد مجلداته الفرعية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ist dieser Ordner oder einer seiner Unterordner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ es esa carpeta o una de sus subcarpetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ est ce dossier ou l’un de ses sous-dossiers."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ वही फ़ोल्डर या उसका कोई सबफ़ोल्डर है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ adalah folder itu atau salah satu subfoldernya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ è quella cartella o una delle sue sottocartelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@はそのフォルダ、またはそのサブフォルダです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@은(는) 해당 폴더이거나 그 하위 폴더입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ é essa pasta ou uma de suas subpastas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ — это та же папка или одна из её вложенных папок."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ — це ця папка або одна з її підпапок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 就是该文件夹或其某个子文件夹。"
          }
        }
      }
    },
    "%@ is the newer. It has %@." : {
      "comment" : "Sentence of Use This Library's account of which copy is newer. %1$@ is a copy of the library, capitalized, and %2$@ lists what only it has, such as \"newer places in 3 books and 2 books the other lacks\".",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ هي الأحدث. وتحتوي على %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ist die neuere. Sie hat %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is the newer. It has %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ es la más reciente. Tiene %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ est la plus récente. Elle a %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ नया है। उसमें %2$@ है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ lebih baru. Salinan itu memiliki %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ è la più recente. Ha %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "新しいのは%1$@です。%2$@があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@이(가) 더 최신입니다. 이 사본에만 %2$@이(가) 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ é a mais recente. Tem %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Новее: %1$@. Только в ней есть %2$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ новіша. Лише вона має %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 较新。它有 %2$@。"
          }
        }
      }
    },
    "%@ is unsubscribed, so TextMouth doesn't check it. Choose %@ to check it again." : {
      "comment" : "What VoiceOver says when Check Feed is chosen for an unsubscribed feed. The first %@ is the feed's title; the second is the name of the Resubscribe command.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ist abbestellt, daher prüft TextMouth den Feed nicht. Wähle %2$@, um ihn erneut zu prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is unsubscribed, so TextMouth doesn't check it. Choose %2$@ to check it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ no tiene suscripción, así que TextMouth no lo revisa. Elige %2$@ para volver a revisarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vous êtes désabonné de %1$@, donc TextMouth ne le vérifie pas. Choisissez %2$@ pour le vérifier de nouveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ की सदस्यता रद्द है, इसलिए TextMouth उसे नहीं जाँचता। उसे फिर से जाँचने के लिए “%2$@” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ tidak berlangganan, jadi TextMouth tidak memeriksanya. Pilih %2$@ untuk memeriksanya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’iscrizione a %1$@ è annullata, quindi TextMouth non lo controlla. Scegli %2$@ per controllarlo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@は購読解除されているため、TextMouth は確認しません。もう一度確認するには%2$@を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@은(는) 구독 해제되어 TextMouth가 확인하지 않습니다. 다시 확인하려면 %2$@을(를) 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ está sem assinatura, então o TextMouth não o verifica. Escolha %2$@ para verificá-lo novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@: вы отписались, поэтому TextMouth не проверяет эту ленту. Выберите %2$@, чтобы снова проверять её."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Підписку на %1$@ скасовано, тому TextMouth її не перевіряє. Виберіть %2$@, щоб перевіряти знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 已取消订阅，因此 TextMouth 不会检查它。选取 %2$@ 可再次检查。"
