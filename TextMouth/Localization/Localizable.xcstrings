    "feed.deleteItemMessage.bookmarks" : {
      "comment" : "A sentence of the confirmation before a feed's episode or article is deleted: what TextMouth kept of the listener's for it goes too.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يُحذف أيضًا الموضع والإشارات المرجعية والنسخة النصية المحفوظة له."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এর জন্য রাখা অবস্থান, বুকমার্ক ও ট্রান্সক্রিপ্টও মুছে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die dafür behaltene Stelle, die Lesezeichen und das Transkript werden ebenfalls gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The place, bookmarks, and transcript kept for it are deleted too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El lugar, los marcadores y la transcripción que se conservaron para él también se eliminan."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جایگاه، نشانک‌ها و رونوشتی که برای آن نگه داشته شده هم حذف می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La position, les signets et la transcription conservés pour lui sont aussi supprimés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "המקום, הסימניות והתמליל שנשמרו עבורה נמחקים גם הם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "उसके लिए रखा गया स्थान, बुकमार्क और ट्रांसक्रिप्ट भी मिटा दिए जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Posisi, markah, dan transkrip yang disimpan untuknya juga ikut dihapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vengono eliminati anche la posizione, i segnalibri e la trascrizione conservati per esso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "保持されていた位置、ブックマーク、文字起こしも削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 항목에 보관한 위치, 북마크, 대본도 함께 삭제됩니다."
