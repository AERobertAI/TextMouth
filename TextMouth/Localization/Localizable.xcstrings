        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Âm thanh của sách đã thay đổi kể từ khi chép lời (%@), nên bản chép lời không còn khớp. Hãy chép lời lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "自转录以来图书的音频已更改（%@），因此文字稿已不再适用。请重新转录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
