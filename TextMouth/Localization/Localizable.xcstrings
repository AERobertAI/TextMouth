          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此漫画归档包含的图片数量超过了 TextMouth 可读取的 %@ 张。"
          }
        }
      }
    },
    "This comic book archive holds no pictures TextMouth can read." : {
