    "Takes %lld to %lld minutes." : {
      "comment" : "VoiceOver hint of the sleep timer sheet's custom minutes field on the iPhone: the fewest and most minutes it takes. %1$lld is the fewest (1); %2$lld the most (480).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Akzeptiert %1$lld bis %2$lld Minuten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Takes %1$lld to %2$lld minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Admite de %1$lld a %2$lld minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Accepte de %1$lld à %2$lld minutes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$lld से %2$lld मिनट तक स्वीकार करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menerima %1$lld hingga %2$lld menit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Accetta da %1$lld a %2$lld minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$lld分から%2$lld分まで指定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$lld분에서 %2$lld분까지 입력할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aceita de %1$lld a %2$lld minutos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Допустимо от %1$lld до %2$lld минут."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Приймає від %1$lld до %2$lld хвилин."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "范围为 %1$lld 到 %2$lld 分钟。"
          }
        }
      }
    },
    "Takes %lld to %lld minutes. Return sets the timer and plays the book." : {
      "comment" : "VoiceOver hint of the sleep timer sheet's custom minutes field on the Mac: the fewest and most minutes it takes, and what the Return key does there. %1$lld is the fewest (1); %2$lld the most (480). Return is the name of the key.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Akzeptiert %1$lld bis %2$lld Minuten. Mit Return wird der Timer gesetzt und das Buch wiedergegeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Takes %1$lld to %2$lld minutes. Return sets the timer and plays the book."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Admite de %1$lld a %2$lld minutos. Retorno programa el temporizador y reproduce el libro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Accepte de %1$lld à %2$lld minutes. La touche Retour règle le minuteur et lit le livre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$lld से %2$lld मिनट तक स्वीकार करता है। रिटर्न टाइमर सेट करता है और पुस्तक चलाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menerima %1$lld hingga %2$lld menit. Return mengatur timer dan memutar buku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Accetta da %1$lld a %2$lld minuti. Invio imposta il timer e riproduce il libro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$lld分から%2$lld分まで指定できます。Return キーでタイマーをセットしてブックを再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$lld분에서 %2$lld분까지 입력할 수 있습니다. Return 키를 누르면 타이머가 설정되고 책이 재생됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aceita de %1$lld a %2$lld minutos. Return define o timer e reproduz o livro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Допустимо от %1$lld до %2$lld минут. Return запускает таймер и воспроизводит книгу."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Приймає від %1$lld до %2$lld хвилин. Return задає таймер і відтворює книгу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "范围为 %1$lld 到 %2$lld 分钟。按 Return 键设定定时器并播放图书。"
          }
        }
      }
    },
    "Takes each finished book off the list when its window moves on or closes. Books finished before you turn it on stay." : {
      "comment" : "VoiceOver hint of the Reading List's Remove books when finished checkbox.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Entfernt jedes beendete Buch aus der Liste, wenn sein Fenster weiterwechselt oder geschlossen wird. Bücher, die vor dem Aktivieren beendet wurden, bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quita de la lista cada libro terminado cuando su ventana pasa a otro libro o se cierra. Los libros terminados antes de activarlo se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Retire chaque livre terminé de la liste quand sa fenêtre passe à autre chose ou se ferme. Les livres terminés avant l’activation restent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "हर पूरी हुई पुस्तक को, उसकी विंडो के आगे बढ़ने या बंद होने पर, सूची से हटाता है। इसे चालू करने से पहले पूरी हुई पुस्तकें बनी रहती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuang setiap buku yang selesai dari daftar saat jendelanya berpindah atau ditutup. Buku yang selesai sebelum Anda mengaktifkannya tetap ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toglie dall’elenco ogni libro terminato quando la sua finestra passa oltre o si chiude. I libri terminati prima che tu lo attivi restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ウインドウが次へ進むか閉じたとき、読了した各ブックをリストから取り除きます。オンにする前に読了したブックは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "윈도우가 다음으로 넘어가거나 닫힐 때 완료한 책을 목록에서 제거합니다. 켜기 전에 완료한 책은 그대로 남습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tira cada livro concluído da lista quando sua janela passa adiante ou fecha. Livros concluídos antes de você ativar isso permanecem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Убирает каждую завершённую книгу из списка, когда её окно переходит дальше или закрывается. Книги, завершённые до включения, остаются."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вилучає кожну завершену книгу зі списку, коли її вікно переходить далі або закривається. Книги, завершені до вмикання, залишаються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在窗口前进或关闭时，从列表中移除每本已读完的图书。开启之前读完的图书会保留。"
          }
        }
      }
    },
    "Takes the selected books off the reading list. They stay in the library." : {
