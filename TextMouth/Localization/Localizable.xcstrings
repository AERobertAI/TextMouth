    "storageLocation.panelMessage.empty" : {
      "comment" : "First sentence of the message of the folder chooser that Change Location opens.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اختر مجلدًا فارغًا لنقل المكتبة إليه، أو مجلدًا يحتوي على مكتبة TextMouth لاستخدامها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "লাইব্রেরি সরানোর জন্য একটি খালি ফোল্ডার বেছে নিন, অথবা ব্যবহার করতে TextMouth লাইব্রেরি আছে এমন একটি ফোল্ডার বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wähle einen leeren Ordner, in den die Bibliothek verschoben wird, oder einen Ordner mit einer TextMouth-Bibliothek, um sie zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose an empty folder to move the library into, or a folder that holds a TextMouth library to use it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige una carpeta vacía a la que trasladar la biblioteca, o una carpeta que contenga una biblioteca de TextMouth para usarla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پوشه‌ای خالی را برای انتقال کتابخانه به آن انتخاب کنید، یا پوشه‌ای را که کتابخانه‌ی TextMouth در آن است انتخاب کنید تا از آن استفاده شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisissez un dossier vide dans lequel déplacer la bibliothèque, ou un dossier contenant une bibliothèque TextMouth pour l’utiliser."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בחר תיקייה ריקה שאליה תועבר הספרייה, או תיקייה שמכילה ספריית TextMouth כדי להשתמש בה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लाइब्रेरी को ले जाने के लिए कोई खाली फ़ोल्डर चुनें, या TextMouth लाइब्रेरी वाला फ़ोल्डर चुनें ताकि उसका उपयोग हो सके।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pilih folder kosong untuk memindahkan pustaka ke dalamnya, atau folder yang berisi pustaka TextMouth untuk menggunakannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scegli una cartella vuota in cui spostare la libreria, oppure una cartella che contiene una libreria di TextMouth per usarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ライブラリの移動先となる空のフォルダか、使用する TextMouth ライブラリを含むフォルダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관함을 옮길 빈 폴더를 선택하거나, TextMouth 보관함이 들어 있는 폴더를 선택하여 그 보관함을 사용하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kies een lege map om de bibliotheek naartoe te verplaatsen, of een map met een TextMouth-bibliotheek om die te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wybierz pusty folder, do którego zostanie przeniesiona biblioteka, lub folder zawierający bibliotekę TextMouth, aby jej używać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escolha uma pasta vazia para mover a biblioteca para ela ou uma pasta que contenha uma biblioteca do TextMouth para usá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Выберите пустую папку, чтобы переместить в неё библиотеку, или папку с библиотекой TextMouth, чтобы использовать её."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Välj en tom mapp att flytta biblioteket till, eller en mapp som innehåller ett TextMouth-bibliotek för att använda det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เลือกโฟลเดอร์ว่างเพื่อย้ายไลบรารีเข้าไป หรือโฟลเดอร์ที่มีไลบรารี TextMouth เพื่อใช้ไลบรารีนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitaplığı taşımak için boş bir klasör, kullanmak için ise TextMouth kitaplığı içeren bir klasör seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Виберіть порожню папку, до якої перемістити бібліотеку, або папку з бібліотекою TextMouth, щоб використовувати її."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لائبریری منتقل کرنے کے لیے خالی فولڈر منتخب کریں، یا ایسا فولڈر جس میں TextMouth لائبریری ہو تاکہ اسے استعمال کیا جا سکے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chọn thư mục trống để di chuyển thư viện vào, hoặc thư mục chứa thư viện TextMouth để dùng thư viện đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "选取一个空文件夹来移入资料库，或选取包含 TextMouth 资料库的文件夹以使用该资料库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選擇要將書庫移入的空檔案夾，或選擇存放 TextMouth 書庫的檔案夾以使用該書庫。"
          }
        }
      }
    },
