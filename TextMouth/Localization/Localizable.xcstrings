    "libraryFileWait.identityNotKnown.disagree" : {
      "comment" : "Last sentence of the question asked before giving the library a new identity file. %1$@ is the identity file's name, which stays as written; %2$@ and %3$@ are the cloud service's name, or \"the cloud\" when it is unknown.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "إذا وصل %@ الخاص بالمكتبة من %@ لاحقًا، فقد يحتفظ %@ بنسختين منه، ولن يتفق هذا الـ Mac والآخر على تحديد هذه المكتبة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "লাইব্রেরির নিজস্ব %1$@ পরে %2$@ থেকে এলে %3$@ এটির দুটি কপি রাখতে পারে, আর এই Mac ও অন্যটি কোনটি এই লাইব্রেরি তা নিয়ে একমত হবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wenn die eigene Datei %1$@ der Bibliothek später von %2$@ eintrifft, liegen in %3$@ möglicherweise zwei Kopien davon, und dieser Mac und der andere wären sich uneins, welche Bibliothek dies ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the library's own %@ arrives from %@ later, %@ may keep two copies of it, and this Mac and the other would disagree about which library this is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si el %1$@ de la propia biblioteca llega más tarde desde %2$@, puede que %3$@ conserve dos copias, y esta Mac y la otra no coincidirían en cuál es esta biblioteca."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اگر %1$@ خود کتابخانه بعداً از %2$@ برسد، %3$@ ممکن است دو نسخه از آن نگه دارد و این Mac و دیگری درباره اینکه این کدام کتابخانه است اختلاف پیدا می‌کنند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si le fichier %1$@ propre à la bibliothèque arrive plus tard depuis %2$@, %3$@ peut en conserver deux copies, et ce Mac et l’autre ne seraient pas d’accord sur la bibliothèque dont il s’agit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אם %1$@ של הספרייה עצמה יגיע בהמשך דרך %2$@, %3$@ עשוי לשמור שני עותקים שלו, וה-Mac הזה והאחר לא יסכימו איזו ספרייה זו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "यदि लाइब्रेरी की अपनी %1$@ बाद में %2$@ से आती है, तो %3$@ उसकी दो प्रतियाँ रख सकता है, और यह Mac तथा दूसरा Mac इस पर असहमत हो सकते हैं कि यह कौन-सी लाइब्रेरी है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jika %1$@ milik pustaka tiba dari %2$@ nanti, %3$@ mungkin menyimpan dua salinannya, dan Mac ini serta yang lain tidak sepakat tentang pustaka mana ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se il file %@ della libreria arriva più tardi tramite %@, %@ potrebbe conservarne due copie, e questo Mac e l’altro non concorderebbero su quale libreria sia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ライブラリ自身の%1$@が後で%2$@から届くと、%3$@がそのコピーを2つ保持する可能性があり、この Mac とほかの Mac でどのライブラリなのかが食い違います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "나중에 %2$@에서 보관함 자체의 %1$@이(가) 도착하면 %3$@이(가) 사본을 두 개 보관할 수 있으며, 이 Mac과 다른 Mac이 어느 쪽이 이 보관함인지 서로 다르게 판단할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Als de eigen %1$@ van de bibliotheek later van %2$@ aankomt, bewaart %3$@ er mogelijk twee kopieën van, en zijn deze Mac en de andere het oneens over welke bibliotheek dit is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jeśli własny plik %1$@ biblioteki dotrze później (źródło: %2$@), %3$@ może zachować dwie jego kopie, a ten komputer Mac i drugi będą się różnić co do tego, która to biblioteka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se o %1$@ da própria biblioteca chegar via %2$@ mais tarde, %3$@ poderá manter duas cópias dele, e este Mac e o outro discordarão sobre qual é esta biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Если собственный файл %1$@ библиотеки позже поступит через %2$@, %3$@ может сохранить две копии, и этот Mac и другой будут по-разному определять, какая это библиотека."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Om bibliotekets egen %1$@ kommer från %2$@ senare kan %3$@ behålla två kopior av den, och den här Mac-datorn och den andra skulle vara oeniga om vilket bibliotek det här är."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หาก %@ ของไลบรารีเองมาจาก %@ ภายหลัง %@ อาจเก็บไว้สองสำเนา และ Mac เครื่องนี้กับเครื่องอื่นจะไม่ตรงกันว่านี่คือไลบรารีใด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitaplığın kendi %1$@ dosyası sonradan buluttan (%2$@) gelirse, %3$@ bunun iki kopyasını tutabilir ve bu Mac ile diğeri bunun hangi kitaplık olduğu konusunda anlaşamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо власний файл %1$@ бібліотеки пізніше надійде (джерело: %2$@), %3$@ може зберегти дві його копії, і цей Mac та інший розходитимуться щодо того, яка це бібліотека."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اگر لائبریری کی اپنی %1$@ بعد میں %2$@ سے پہنچے، تو %3$@ اس کی دو کاپیاں رکھ سکتا ہے، اور یہ Mac اور دوسرا اس پر متفق نہیں ہوں گے کہ یہ کون سی لائبریری ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nếu %1$@ riêng của thư viện đến từ %2$@ sau đó, %3$@ có thể giữ hai bản sao của nó, và máy Mac này cùng máy kia sẽ không thống nhất đây là thư viện nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "如果资料库自己的 %1$@ 稍后从 %2$@ 传来，%3$@ 可能会保留它的两个副本，这台 Mac 和另一台就会对这是哪个资料库产生分歧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "如果書庫本身的 %1$@ 之後從 %2$@ 同步過來，%3$@ 可能會保留它的兩個副本，而這部 Mac 與另一部 Mac 對於這是哪個書庫會有不同看法。"
          }
        }
      }
    },
    "libraryFileWait.identityNotKnown.writes" : {
      "comment" : "First sentence of the question asked before giving the library a new identity file. %@ is the identity file's name, which stays as written.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يكتب TextMouth الملف %@ بهوية جديدة للمكتبة، ويفتحها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth লাইব্রেরির জন্য একটি নতুন পরিচয় সহ %@ লেখে এবং সেটি খোলে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth schreibt %@ mit einer neuen Identität für die Bibliothek und öffnet sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth writes %@ with a new identity for the library, and opens it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth escribe %@ con una identidad nueva para la biblioteca y la abre."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth %@ را با هویتی جدید برای کتابخانه می‌نویسد و آن را باز می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth écrit %@ avec une nouvelle identité pour la bibliothèque, puis l’ouvre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth כותב את %@ עם זהות חדשה לספרייה, ופותח אותה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth लाइब्रेरी के लिए नई पहचान के साथ %@ लिखता है, और उसे खोलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth menulis %@ dengan identitas baru untuk pustaka, dan membukanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth scrive %@ con una nuova identità per la libreria e la apre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth はライブラリに新しい ID を付けて%@を書き込み、ライブラリを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 보관함의 새 식별 정보로 %@을(를) 쓰고 보관함을 엽니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth schrijft %@ met een nieuwe identiteit voor de bibliotheek en opent die."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth zapisuje %@ z nową tożsamością biblioteki i otwiera ją."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth grava %@ com uma nova identidade para a biblioteca e a abre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth запишет %@ с новым идентификатором библиотеки и откроет её."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth skriver %@ med en ny identitet för biblioteket och öppnar det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth เขียน %@ ด้วยตัวตนใหม่ของไลบรารี และเปิดไลบรารี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth, kitaplık için yeni bir kimlikle %@ dosyasını yazar ve kitaplığı açar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth запише %@ з новим ідентифікатором бібліотеки й відкриє її."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth %@ کو لائبریری کی نئی شناخت کے ساتھ لکھتا ہے، اور اسے کھولتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ghi %@ với danh tính mới cho thư viện, và mở thư viện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 会为资料库写入带有新标识的 %@，并打开它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 會寫入 %@，內含書庫的新身分，然後打開書庫。"
          }
        }
      }
    },
    "libraryFileWait.openHint.identity" : {
      "comment" : "VoiceOver hint of the button that restores the library's identity file.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يسأل أولًا، ثم يكتب الهوية التي يعرفها هذا الـ Mac للمكتبة ويفتحها."
          }
        },
        "bn" : {
          "stringUnit" : {
