    "libraryFileWait.confirmation.index.listening" : {
      "comment" : "Second sentence of the question asked before opening the library without its index file: what the new index will not hold. \"It\" is the new index.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لن يحتوي على قائمة القراءة، ولا على إعدادات الفرز وخيارات الاستماع للمجلدات، ولا على أي كتاب ملفاته ليست في هذا المجلد بعد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পড়ার তালিকা, ফোল্ডারগুলোর সাজানোর ক্রম ও শোনার বিকল্প, এবং যেসব বইয়ের ফাইল এখনো এই ফোল্ডারে নেই, সেগুলো এতে থাকবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Leseliste, die Sortierungen und Höroptionen der Ordner und jedes Buch, dessen Dateien noch nicht in diesem Ordner liegen, sind darin nicht enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The reading list, the folders' sorts and listening options, and any book whose files aren't in this folder yet won't be in it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No incluirá la lista de lectura, los ajustes de orden y de escucha de las carpetas, ni los libros cuyos archivos aún no estén en esta carpeta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فهرست مطالعه، ترتیب‌ها و گزینه‌های شنیداری پوشه‌ها، و هر کتابی که فایل‌هایش هنوز در این پوشه نیست، در آن نخواهند بود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La liste de lecture, les tris et les options d’écoute des dossiers, ainsi que tout livre dont les fichiers ne sont pas encore dans ce dossier, n’y figureront pas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "רשימת הקריאה, המיונים ואפשרויות ההאזנה של התיקיות, וכל ספר שקבציו עדיין לא בתיקייה הזו לא יהיו בו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "रीडिंग लिस्ट, फ़ोल्डरों के क्रम और सुनने के विकल्प, और ऐसी कोई भी पुस्तक जिसकी फ़ाइलें अभी इस फ़ोल्डर में नहीं हैं, उसमें नहीं होंगे।"
