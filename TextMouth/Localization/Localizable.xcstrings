    },
    "Choose where to move the books and subfolders before deleting \"%@\"." : {
      "comment" : "Explanation in the sheet that chooses where a folder's contents go before the folder is deleted. %@ is the folder's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اختر مكان نقل الكتب والمجلدات الفرعية قبل حذف \"%@\"."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wähle, wohin die Bücher und Unterordner verschoben werden sollen, bevor „%@“ gelöscht wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige adónde mover los libros y subcarpetas antes de eliminar \"%@\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisissez où déplacer les livres et les sous-dossiers avant de supprimer « %@ »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "\"%@\" को मिटाने से पहले चुनें कि पुस्तकें और सबफ़ोल्डर कहाँ ले जाने हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pilih tujuan untuk memindahkan buku dan subfolder sebelum menghapus \"%@\"."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scegli dove spostare i libri e le sottocartelle prima di eliminare “%@”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」を削除する前に、ブックとサブフォルダの移動先を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@”을(를) 삭제하기 전에 책과 하위 폴더를 이동할 위치를 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escolha para onde mover os livros e as subpastas antes de excluir “%@”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Выберите, куда переместить книги и вложенные папки перед удалением «%@»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Виберіть, куди перемістити книги та підпапки, перш ніж видалити «%@»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "删除“%@”前，请选取图书和子文件夹要移到哪里。"
          }
        }
      }
    },
    "Chooses a folder with another copy of this library and lists what differs. Neither copy changes." : {
      "comment" : "VoiceOver hint of the Compare Libraries button in Storage settings.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يختار مجلدًا يحتوي على نسخة أخرى من هذه المكتبة ويسرد الفروق. لا تتغير أي من النسختين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wählt einen Ordner mit einer weiteren Kopie dieser Bibliothek und listet die Unterschiede auf. Keine der Kopien wird geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige una carpeta con otra copia de esta biblioteca y muestra qué difiere. Ninguna copia cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisit un dossier contenant une autre copie de cette bibliothèque et liste les différences. Aucune des copies ne change."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "दूसरी कॉपी वाला फ़ोल्डर चुनता है और अंतर सूचीबद्ध करता है। कोई भी कॉपी नहीं बदलती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Memilih folder berisi salinan lain pustaka ini dan mencantumkan perbedaannya. Kedua salinan tidak berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sceglie una cartella con un’altra copia di questa libreria ed elenca le differenze. Nessuna delle due copie cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このライブラリの別のコピーが入っているフォルダを選択し、相違点を一覧表示します。どちらのコピーも変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "다른 보관함 사본이 있는 폴더를 선택하고 차이점을 나열합니다. 어느 사본도 변경되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escolhe uma pasta com outra cópia desta biblioteca e lista o que difere. Nenhuma das cópias muda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Позволяет выбрать папку с другой копией этой библиотеки и показывает различия. Ни одна копия не изменяется."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вибирає папку з іншою копією цієї бібліотеки та показує відмінності. Жодна з копій не змінюється."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "选取存放此资料库另一个副本的文件夹，并列出差异。两个副本都不会更改。"
          }
        }
      }
    },
    "Chooses the file format. M4B is an audiobook; M4A and MP3 play in more apps. M4B and M4A have a chapter for each heading; an MP3, for the first %@." : {
      "comment" : "The hint of the Format pop-up in the Export dialog's spoken audio options. M4B, M4A, and MP3 are audio file formats. %@ is the number of chapters an MP3 can have, 255.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wählt das Dateiformat. M4B ist ein Hörbuch; M4A und MP3 funktionieren in mehr Apps. M4B und M4A haben für jede Überschrift ein Kapitel; MP3 für die ersten %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige el formato del archivo. M4B es un audiolibro; M4A y MP3 se reproducen en más apps. M4B y M4A tienen un capítulo por cada encabezado; un MP3, para los primeros %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisit le format de fichier. M4B est un livre audio ; M4A et MP3 se lisent dans plus d’apps. M4B et M4A ont un chapitre par en-tête ; un MP3, pour les %@ premiers."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ाइल फ़ॉर्मैट चुनता है। M4B ऑडियोबुक है; M4A और MP3 अधिक ऐप में चलते हैं। M4B और M4A में हर हेडिंग के लिए एक अध्याय होता है; MP3 में पहले %@ के लिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Memilih format file. M4B adalah buku audio; M4A dan MP3 diputar di lebih banyak app. M4B dan M4A memiliki satu bab untuk setiap tajuk; MP3, untuk %@ yang pertama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sceglie il formato del file. M4B è un audiolibro; M4A e MP3 si riproducono in più app. M4B e M4A hanno un capitolo per ogni intestazione; un MP3, per le prime %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ファイル形式を選びます。M4B はオーディオブック用で、M4A と MP3 はより多くの App で再生できます。M4B と M4A は見出しごとにチャプタを持ち、MP3 は最初の%@個までです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "파일 포맷을 선택합니다. M4B는 오디오북이며, M4A와 MP3는 더 많은 앱에서 재생됩니다. M4B와 M4A에는 표제마다 챕터가 있으며, MP3에는 처음 %@개의 표제에만 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escolhe o formato do arquivo. M4B é um audiolivro; M4A e MP3 tocam em mais apps. M4B e M4A têm um capítulo para cada cabeçalho; um MP3, para os primeiros %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Выбирает формат файла. M4B — аудиокнига; M4A и MP3 воспроизводятся в большем числе приложений. В M4B и M4A на каждый заголовок приходится глава; в MP3 — на первые %@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вибирає формат файлу. M4B — аудіокнига; M4A і MP3 відтворюються в більшій кількості програм. У M4B і M4A кожному заголовку відповідає розділ, а в MP3 — перші %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "选取文件格式。M4B 是有声书；M4A 和 MP3 可在更多 App 中播放。M4B 和 M4A 为每个章节标题设一个章节；MP3 则只设前 %@ 个。"
          }
        }
      }
    },
