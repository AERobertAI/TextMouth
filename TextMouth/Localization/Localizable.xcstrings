      }
    },
    "%@ holds a conflicting version of %@, saved at another time." : {
      "comment" : "First sentence of the report of an unresolved version of a file whose computer and time of saving are not known. %1$@ is the sync service's name; %2$@ is a phrase naming the file.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحتفظ %@ بإصدار متعارض من %@ حُفظ في وقت آخر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@-এর একটি সংঘাতপূর্ণ সংস্করণ রেখেছে, যা অন্য সময়ে সংরক্ষিত।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ enthält eine widersprüchliche Version von %2$@, zu einer anderen Zeit gesichert."
          }
        },
        "en" : {
