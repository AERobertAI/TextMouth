    "feedDownloadProgress.cancelButtonHint" : {
      "comment" : "What VoiceOver says the feed downloads section's Cancel button does: it stops every feed download and deletes what they had downloaded.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يوقف كل تنزيلات الموجزات، بما فيها المنتظرة، ويحذف ما نزّلته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "অপেক্ষায় থাকাগুলোসহ প্রতিটি ফিড ডাউনলোড থামায় এবং যা ডাউনলোড হয়েছিল তা মুছে ফেলে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppt alle Feed-Downloads, auch die wartenden, und löscht, was bereits heruntergeladen wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops every feed download, including those waiting, and deletes what they had downloaded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detiene todas las descargas de canales, incluidas las que esperan, y elimina lo que habían descargado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "همه بارگیری‌های فید، از جمله آن‌هایی را که منتظرند، متوقف می‌کند و آنچه را بارگیری کرده‌اند حذف می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrête tous les téléchargements de flux, y compris ceux en attente, et supprime ce qu’ils avaient téléchargé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "עוצר כל הורדת ערוץ, כולל אלה שממתינות, ומוחק את מה שכבר הורד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "प्रतीक्षा में रखे डाउनलोड समेत हर फ़ीड डाउनलोड रोक देता है, और जो डाउनलोड हो चुका था उसे मिटा देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menghentikan setiap unduhan feed, termasuk yang menunggu, dan menghapus apa yang sudah diunduh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe ogni download di feed, compresi quelli in attesa, ed elimina ciò che avevano scaricato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "待機中のものを含むすべてのフィードのダウンロードを停止し、ダウンロード済みの内容を削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "대기 중인 다운로드를 포함해 모든 피드 다운로드를 중지하고, 다운로드된 내용을 삭제합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stopt elke feeddownload, ook de wachtende, en verwijdert wat is gedownload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zatrzymuje wszystkie pobrania z kanałów, także oczekujące, i usuwa to, co pobrały."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompe todos os downloads de feeds, inclusive os que aguardam, e exclui o que eles já haviam baixado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Останавливает все загрузки лент, в том числе ожидающие, и удаляет то, что они успели загрузить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stoppar varje flödesnedladdning, även de som väntar, och raderar det de hade hämtat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หยุดการดาวน์โหลดฟีดทั้งหมด รวมถึงที่รออยู่ และลบสิ่งที่ดาวน์โหลดไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bekleyenler dahil her besleme indirmesini durdurur ve indirdiklerini siler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Зупиняє всі завантаження зі стрічок, зокрема ті, що очікують, і видаляє вже завантажене."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "انتظار میں رہنے والے ڈاؤن لوڈز سمیت ہر فیڈ ڈاؤن لوڈ روک دیتا ہے، اور جو کچھ وہ ڈاؤن لوڈ کر چکے تھے اسے حذف کر دیتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dừng mọi bản tải về của nguồn cấp, kể cả những bản đang chờ, và xóa những gì chúng đã tải về."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止所有订阅源下载（包括正在等待的），并删除它们已下载的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止每個訂閱源下載（包括等待中的），並刪除它們已下載的內容。"
          }
        }
      }
    },
