          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le dossier de %@ n’est plus dans la bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La cartella di %@ non è più nella libreria."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
