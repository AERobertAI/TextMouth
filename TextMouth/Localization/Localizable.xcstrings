        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Plik audio %@ nie jest takim rodzajem pliku, jaki wskazuje jego nazwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo de áudio %@ não é do tipo que seu nome indica."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Аудиофайл %@ не относится к тому типу, который указан в его имени."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ljudfilen %@ är inte den sortens fil som namnet säger."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไฟล์เสียง %@ ไม่ใช่ไฟล์ประเภทที่ชื่อบอก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ses dosyası, adının belirttiği türde bir dosya değil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Аудіофайл %@ не є файлом того типу, який вказує його назва."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آڈیو فائل %@ اس قسم کی فائل نہیں جو اس کا نام بتاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tệp âm thanh %@ không phải loại tệp mà tên của nó cho biết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "音频文件 %@ 的类型与其名称所示不符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "音訊檔案 %@ 並非其名稱所示的檔案類型。"
          }
        }
      }
    },
    "ownAudio.sentence.truncated" : {
      "comment" : "Why an audio file could not be converted at import: the file stops before the audio its header promises. %@ is the file's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ينتهي الملف الصوتي %@ قبل انتهاء صوته، لذا تعذّر تحويله."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "অডিও ফাইল %@ তার অডিওর আগেই শেষ হয়ে গেছে, তাই এটি রূপান্তর করা যায়নি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Audiodatei %@ bricht vor dem Ende ihres Audios ab, daher konnte sie nicht konvertiert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The audio file %@ ends before its audio does, so it could not be converted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo de audio %@ termina antes que su audio, así que no se pudo convertir."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فایل صوتی %@ زودتر از صدای خود تمام می‌شود، بنابراین تبدیل نشد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le fichier audio %@ s’arrête avant la fin de son audio, il n’a donc pas pu être converti."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "קובץ השמע %@ מסתיים לפני שהשמע שלו מסתיים, ולכן לא ניתן היה להמיר אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ऑडियो फ़ाइल %@ अपने ऑडियो से पहले ही समाप्त हो जाती है, इसलिए उसे बदला नहीं जा सका।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "File audio %@ berakhir sebelum audionya selesai, sehingga tidak dapat dikonversi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il file audio %@ termina prima del suo audio, quindi non è stato possibile convertirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オーディオファイル%@は途中で切れているため、変換できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "오디오 파일 %@의 오디오가 끝나기 전에 파일이 끝나 변환할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Het audiobestand %@ eindigt voordat de audio is afgelopen, dus het kon niet worden geconverteerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Plik audio %@ kończy się wcześniej niż jego dźwięk, więc nie udało się go przekonwertować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo de áudio %@ termina antes do áudio que deveria conter, então não foi possível convertê-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Аудиофайл %@ обрывается до конца записи, поэтому его не удалось преобразовать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ljudfilen %@ slutar före sitt ljud, så den kunde inte konverteras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไฟล์เสียง %@ จบก่อนเสียงจริง จึงแปลงไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ses dosyası, sesi bitmeden önce bittiği için dönüştürülemedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Аудіофайл %@ закінчується раніше, ніж його аудіо, тому його не вдалося перетворити."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آڈیو فائل %@ اپنے آڈیو سے پہلے ختم ہو جاتی ہے، اس لیے اسے تبدیل نہیں کیا جا سکا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tệp âm thanh %@ kết thúc trước khi hết âm thanh của nó, nên không thể chuyển đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "音频文件 %@ 在其音频结束之前就已截断，因此无法转换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "音訊檔案 %@ 在音訊結束之前就結束了，因此無法轉換。"
          }
        }
      }
    },
    "ownAudio.sentence.unsupported" : {
      "comment" : "Why an audio file could not be converted at import: it is of a format TextMouth reads, in a form it refuses. %1$@ is the file's name and %2$@ the reason, a clause in English that follows \"because\" and has no full stop.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يستطيع TextMouth قراءة الملف الصوتي %1$@ لأن %2$@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth অডিও ফাইল %1$@ পড়তে পারে না, কারণ %2$@।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kann die Audiodatei %1$@ nicht lesen, denn %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth can't read the audio file %@ because %@."
          }
