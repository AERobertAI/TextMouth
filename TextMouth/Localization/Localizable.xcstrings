    "transcriptCleanupError.transcriptChanged" : {
      "comment" : "Error shown when the transcript changed after the Clean Up Transcript sheet showed its changes. Clean Up Transcript is the command's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تغيّرت النسخة النصية منذ عرض هذا. أعد فتح “تنظيف النسخة النصية” لرؤية التغييرات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এটি দেখানোর পর ট্রান্সক্রিপ্ট বদলেছে। পরিবর্তনগুলো দেখতে “ট্রান্সক্রিপ্ট পরিষ্কার করুন” আবার খুলুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Transkript hat sich geändert, seit dies angezeigt wurde. Öffne „Transkript bereinigen“ erneut, um die Änderungen zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The transcript changed since this was shown. Reopen Clean Up Transcript to see the changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcripción cambió desde que se mostró esto. Vuelve a abrir Limpiar transcripción para ver los cambios."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "رونوشت از زمانی که این نمایش داده شد تغییر کرده است. «تمیز کردن رونوشت» را دوباره باز کنید تا تغییرات را ببینید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La transcription a changé depuis cet affichage. Rouvrez Nettoyer la transcription pour voir les modifications."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "התמליל השתנה מאז שהוצג. פתח שוב את “נקה תמליל” כדי לראות את השינויים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "जब से यह दिखाया गया, ट्रांसक्रिप्ट बदल गई है। बदलाव देखने के लिए “ट्रांसक्रिप्ट साफ़ करें” दोबारा खोलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transkrip berubah sejak ini ditampilkan. Buka kembali Rapikan Transkrip untuk melihat perubahannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La trascrizione è cambiata dopo la visualizzazione. Riapri Pulisci trascrizione per vedere le modifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "表示後に文字起こしが変更されました。「文字起こしを整理（実験的）…」を開き直して、変更内容を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
