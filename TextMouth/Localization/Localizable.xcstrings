        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此文件中有一个文档的标记过多，TextMouth 无法在内存中读取。"
          }
        }
      }
    },
    "One tag in this file has more than %@ attributes, which TextMouth can't read safely." : {
      "comment" : "First sentence of why a file was refused: one of its markup tags has more attributes than TextMouth reads. %@ is the most attributes, a number.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحتوي أحد الوسوم في هذا الملف على أكثر من %@ سمة، ولا يستطيع TextMouth قراءته بأمان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Tag in dieser Datei hat mehr als %@ Attribute, die TextMouth nicht sicher lesen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una etiqueta de este archivo tiene más de %@ atributos, y TextMouth no puede leerla de forma segura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une balise de ce fichier a plus de %@ attributs, ce que TextMouth ne peut pas lire en toute sécurité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस फ़ाइल के एक टैग में %@ से अधिक एट्रिब्यूट हैं, जिन्हें TextMouth सुरक्षित रूप से नहीं पढ़ सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Satu tag di file ini memiliki lebih dari %@ atribut, yang tidak dapat dibaca TextMouth dengan aman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un tag in questo file ha più di %@ attributi, che TextMouth non può leggere in sicurezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このファイル内の1つのタグに%@個を超える属性があり、TextMouth は安全に読み取れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 파일의 태그 하나에 속성이 %@개를 넘어 TextMouth가 안전하게 읽을 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uma tag deste arquivo tem mais de %@ atributos, o que o TextMouth não consegue ler com segurança."
