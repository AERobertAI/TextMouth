    },
    "Each heading's title and start, as a CUE sheet naming the audio as Audio exports it." : {
      "comment" : "The hint of the Headings checkbox in the Export dialog while CUE sheet is chosen. \"Audio\" is the name of the Audio checkbox.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Titel und Anfang jeder Überschrift als CUE-Sheet, das das Audio so benennt, wie „Audio“ es exportiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El título y el inicio de cada encabezado, como una hoja CUE que nombra el audio igual que Audio al exportarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le titre et le début de chaque en-tête, en feuille CUE nommant l’audio comme l’exporte Audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Titolo e inizio di ogni intestazione, come foglio CUE che dà all’audio il nome usato da Audio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O título e o início de cada cabeçalho, como um arquivo CUE que dá ao áudio o nome com que Áudio o exporta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Название и начало каждого заголовка в виде CUE-листа, где аудио названо так же, как при экспорте флажка «Аудио»."
          }
        }
      }
    },
    "Each line beginning with <!-- chapter: starts a chapter; keep those lines." : {
      "comment" : "Second sentence of the Edit Text explanation. \"<!-- chapter:\" is the literal text that begins a chapter line in the file; it stays exactly as written.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jede Zeile, die mit <!-- chapter: beginnt, beginnt ein Kapitel; behalte diese Zeilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cada línea que empieza con <!-- chapter: inicia un capítulo; conserva esas líneas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chaque ligne commençant par <!-- chapter: démarre un chapitre ; conservez ces lignes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ogni riga che inizia con <!-- chapter: inizia un capitolo; conserva quelle righe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cada linha que começa com <!-- chapter: inicia um capítulo; mantenha essas linhas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Каждая строка, которая начинается с <!-- chapter:, начинает главу; сохраняйте эти строки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "每行以 <!-- chapter: 开头的内容开始一个章节；请保留这些行。"
          }
        }
      }
    },
