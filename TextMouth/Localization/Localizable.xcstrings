          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth Sync という名前のフォルダがすでにあります。使うには「同期フォルダに参加」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
