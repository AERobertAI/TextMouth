            "state" : "machine_translated",
            "value" : "%1$@ برای %2$@ اکنون از تنظیم سراسری پیروی می‌کند: %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ pour %2$@ suit de nouveau le réglage général : %3$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” עבור %2$@ נקבעת כעת לפי ההגדרה הכללית: %3$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@ के लिए %1$@ अब वैश्विक सेटिंग के अनुसार है: %3$@।"
