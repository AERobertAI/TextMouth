    "bookCloud.doesntSayWhether" : {
      "comment" : "First sentence of why Remove Download was refused: the cloud service never says whether the copy here is current. %@ is the cloud service's name, or \"The cloud service\" when it is unknown.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يذكر %@ ما إذا كانت نسخة هذا الكتاب على هذا الـ Mac هي الأحدث، لذا لا يمكن إزالة تنزيله، ولن يغيّر الانتظار ذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ জানায়নি যে এই Mac-এ বইটির কপি সর্বশেষ কি না, তাই এর ডাউনলোড সরানো যাবে না, আর অপেক্ষা করলেও তা বদলাবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ gibt nicht an, ob die Kopie dieses Buchs auf diesem Mac die neueste ist, daher kann der Download nicht entfernt werden, und Warten ändert daran nichts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ doesn't say whether the copy of this book on this Mac is the latest, so its download can't be removed, and waiting won't change that."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no indica si la copia de este libro en esta Mac es la más reciente, así que no se puede quitar su descarga, y esperar no lo cambiará."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ نمی‌گوید که نسخه این کتاب روی این Mac آخرین نسخه است یا نه، بنابراین بارگیری آن برداشته نمی‌شود و صبر کردن هم این را تغییر نمی‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ n’indique pas si la copie de ce livre sur ce Mac est la plus récente ; son téléchargement ne peut donc pas être retiré, et attendre n’y changera rien."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ לא מציין אם העותק של הספר הזה ב-Mac הזה הוא העדכני ביותר, ולכן לא ניתן להסיר את ההורדה שלו, והמתנה לא תשנה זאת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ से यह पता नहीं चलता कि इस Mac पर इस पुस्तक की प्रति नवीनतम है या नहीं, इसलिए उसका डाउनलोड नहीं हटाया जा सकता, और प्रतीक्षा करने से यह नहीं बदलेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ tidak menyatakan apakah salinan buku ini di Mac ini adalah yang terbaru, sehingga unduhannya tidak dapat dibuang, dan menunggu tidak akan mengubahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ non indica se la copia di questo libro su questo Mac è la più recente, quindi il suo download non può essere rimosso, e attendere non cambierà la situazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "この Mac にあるブックのコピーが最新かどうかを%@が示さないため、ダウンロードを取り除けません。待っても変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@이(가) 이 Mac에 있는 이 책의 사본이 최신인지 알려 주지 않아 다운로드를 제거할 수 없습니다. 기다려도 달라지지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ geeft niet aan of de kopie van dit boek op deze Mac de nieuwste is. De download kan dus niet worden verwijderd, en wachten verandert dat niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ nie informuje, czy kopia tej książki na tym komputerze Mac jest najnowsza, więc nie można usunąć pobranego pliku, a czekanie tego nie zmieni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ não informa se a cópia deste livro neste Mac é a mais recente; por isso, o download não pode ser removido, e esperar não vai mudar isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ не сообщает, актуальна ли копия этой книги на этом Mac, поэтому загрузку нельзя убрать, и ожидание ничего не изменит."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ anger inte om kopian av den här boken på den här Mac-datorn är den senaste, så nedladdningen kan inte tas bort, och att vänta ändrar inte det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ไม่ได้บอกว่าสำเนาของหนังสือเล่มนี้ใน Mac เครื่องนี้เป็นฉบับล่าสุดหรือไม่ จึงนำการดาวน์โหลดออกไม่ได้ และการรอก็ไม่ช่วยอะไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, bu Mac'teki kitap kopyasının en son kopya olup olmadığını bildirmiyor; bu yüzden indirilen kopya kaldırılamaz ve beklemek bunu değiştirmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ не повідомляє, чи копія цієї книги на цьому Mac найновіша, тому її завантаження не можна вилучити, і очікування цього не змінить."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ یہ نہیں بتاتا کہ اس Mac پر اس کتاب کی کاپی تازہ ترین ہے یا نہیں، اس لیے اس کا ڈاؤن لوڈ نہیں ہٹایا جا سکتا، اور انتظار کرنے سے یہ بات نہیں بدلے گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ không cho biết bản sao của sách này trên máy Mac này có phải bản mới nhất hay không, nên không thể gỡ bản tải về, và chờ đợi cũng không thay đổi được điều đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 没有说明这台 Mac 上这本图书的副本是否为最新版本，因此无法移除其下载内容，等待也不会改变这一点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 沒有說明這部 Mac 上的這本書副本是否為最新，因此無法移除其下載項目，而且再等也不會改變這一點。"
          }
        }
      }
    },
    "bookCloud.downloadCantRemoved" : {
      "comment" : "Last sentence of why Remove Download was refused after a failed upload.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يمكن إزالة تنزيله إلى أن يتم رفعه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আপলোড না হওয়া পর্যন্ত এর ডাউনলোড সরানো যায় না।"
