      }
    },
    "Back 10 Seconds" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Moves back ten seconds."
    },
    "Back One Second" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Moves back one second."
    },
    "Back a Tenth of a Second" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Moves back a tenth of a second."
    },
    "Back to Book" : {
      "comment" : "Button of the headings sheet that closes it and returns to the book.\nTitle of the button that closes the Search in Book sheet and returns to the book."
    },
    "Backslash" : {
      "comment" : "Name of the punctuation key \"\\\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Backslash\"."
    },
    "Backward navigation unit" : {
      "comment" : "Label of the menu that sets the unit by which this book moves backward."
    },
    "Backward navigation unit: %@" : {
      "comment" : "VoiceOver label of the playback bar's menu that picks the unit the backward button moves by. %@ is the unit now chosen, such as \"Sentence\"."
    },
    "Before page %@" : {
      "comment" : "Where the reader is before the first page of a book that has pages. %@ is the first page's label, an identifier."
    },
    "Begin" : {
      "comment" : "Name of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Begin\"."
    },
    "Blocks the spurious play command macOS sends when Bluetooth headphones are removed." : {
      "comment" : "Explanation under the Enable Bluetooth monitoring switch in the Miscellaneous settings. macOS is the name of the operating system."
    },
    "Bluetooth" : {
      "comment" : "Heading of the Bluetooth group in the Miscellaneous settings. Bluetooth is a trademark and stays as written in most languages."
    },
    "Bluetooth disconnect delay" : {
      "comment" : "VoiceOver label of the Bluetooth disconnect delay slider in the Miscellaneous settings."
    },
    "Book" : {
      "comment" : "The object of a removal confirmation's title for one book, in title case, as in \"Move Book to Trash?\".\nThe word that begins the title of a reader window for a book, before its title and author: \"Book: <title> by <author>\".\nTitle of the Book menu in the menu bar, which holds the commands about the open book, such as exporting or editing it. Only a reader window shows it."
    },
    "Book Info" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Library group and read by VoiceOver. Opens the selected book's information, such as title and author. Also the title of the menu command of the same name.\nTitle of the reader toolbar's button that opens the book's information sheet."
    },
    "Book Information" : {
      "comment" : "Heading of the sheet in which the user edits a book's information (title, author and so on)."
    },
    "Book Reader" : {
      "comment" : "Title of a window in which a book is read, before the window shows its own book's title. Also the name of the window group."
    },
    "Book content" : {
      "comment" : "What VoiceOver calls the scrolling area that holds the book's text in the reader."
    },
    "Book only in %@: %@." : {
      "comment" : "A difference found by Compare Libraries. %1$@ is a copy of the library (this copy or the other copy), %2$@ is a book's title and, when known, its author.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Book only in %1$@: %2$@."
          }
        }
      }
    },
    "Book title" : {
      "comment" : "What VoiceOver says for the book information sheet's field for the book's title."
    },
    "Bookmark" : {
      "comment" : "A unit a skip or navigation picker moves by: one bookmark."
    },
    "Bookmark %@" : {
      "comment" : "A bookmark's name, by its number: the first line of its row in the Bookmarks list, and what VoiceOver says after a move to it. %@ is the bookmark's number, an identifier written without digit grouping.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Marcador %@"
          }
        }
      }
    },
    "Bookmark %@ added" : {
      "comment" : "VoiceOver announcement after a bookmark was added at the reading position. %@ is the new bookmark's number, an identifier written without digit grouping.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Marcador %@ agregado"
          }
        }
      }
    },
    "Bookmark %@ in %@: differs." : {
      "comment" : "First sentence of a bookmark difference found by Compare Libraries. %1$@ is the bookmark's number, an identifier written without digit grouping, and %2$@ is a book's title.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bookmark %1$@ in %2$@: differs."
          }
        }
      }
    },
    "Bookmark %@ in %@: only in %@, %@." : {
      "comment" : "A difference found by Compare Libraries. %1$@ is the bookmark's number, an identifier written without digit grouping; %2$@ is a book's title; %3$@ is the copy of the library that has it; %4$@ is the bookmark's place and note, such as \"chapter 3, with no note\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bookmark %1$@ in %2$@: only in %3$@, %4$@."
          }
        }
      }
    },
    "Bookmark %@ removed" : {
      "comment" : "VoiceOver announcement after the bookmark command removed the bookmark at the reading position. %@ is that bookmark's number, an identifier written without digit grouping.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Marcador %@ eliminado"
          }
        }
      }
    },
    "Bookmark %@, %@, Note: %@, added %@" : {
      "comment" : "VoiceOver label of a bookmark's row in the Bookmarks list and its rotor. %1$@ is the bookmark's number, an identifier written without digit grouping; %2$@ the heading it is under; %3$@ its note, written by the listener; %4$@ the day it was added, such as October 9, 2026.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bookmark %1$@, %2$@, Note: %3$@, added %4$@"
          }
        },
        "es" : {
          "stringUnit" : {
