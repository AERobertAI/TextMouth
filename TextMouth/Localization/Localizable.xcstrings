    "feedDownloadRemoval.keptSentence.transcript" : {
      "comment" : "Sentence about one deleted download: what the listener left in it is kept, and it can be downloaded again.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يُحتفظ بموضعه وإشاراته المرجعية ونسخته النصية، إن وُجدت، ويمكن تنزيله مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এর অবস্থান, বুকমার্ক এবং ট্রান্সক্রিপ্ট (থাকলে) রাখা হয়, আর এটি আবার ডাউনলোড করা যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Seine Position, Lesezeichen und sein Transkript, falls vorhanden, bleiben erhalten, und es kann erneut heruntergeladen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its place, bookmarks, and transcript, if it has any, are kept, and it can be downloaded again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Su lugar, sus marcadores y su transcripción, si la tiene, se conservan, y se puede descargar de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مکان، نشانک‌ها و رونوشت آن، اگر داشته باشد، نگه داشته می‌شوند و می‌توان دوباره آن را بارگیری کرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sa position, ses signets et sa transcription, s’il en a, sont conservés, et il peut être téléchargé de nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "המקום, הסימניות והתמליל שלה, אם יש, נשמרים, ואפשר להוריד אותה שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसका स्थान, बुकमार्क और ट्रांसक्रिप्ट, यदि कोई हों, रखे जाते हैं, और इसे फिर से डाउनलोड किया जा सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Posisi, markah, dan transkripnya, jika ada, tetap disimpan, dan dapat diunduh lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La sua posizione, i segnalibri e la trascrizione, se ne ha una, vengono conservati e può essere scaricato di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "場所、ブックマーク、文字起こし（ある場合）は残り、もう一度ダウンロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "위치, 북마크, 대본이 있으면 그대로 유지되며, 다시 다운로드할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De leespositie, bladwijzers en transcriptie, als die er zijn, blijven bewaard en het kan opnieuw worden gedownload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pozycja czytania, zakładki i transkrypcja, jeśli istnieje, zostają zachowane, a plik można pobrać ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sua posição, seus marcadores e sua transcrição, se tiver, são mantidos, e ele pode ser baixado novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Позиция чтения, закладки и расшифровка, если она есть, сохраняются, а загрузку можно повторить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dess plats, bokmärken och transkription, om det finns någon, behålls, och den kan hämtas igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตำแหน่ง ที่คั่นหน้า และข้อความถอดเสียง (ถ้ามี) จะยังอยู่ และดาวน์โหลดใหม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yeri, yer imleri ve varsa transkripti saklanır ve yeniden indirilebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Його місце, закладки та транскрипція, якщо вони є, зберігаються, і його можна завантажити знову."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس کا مقام، بک مارکس اور ٹرانسکرپٹ، اگر ہو، برقرار رکھے جاتے ہیں، اور اسے دوبارہ ڈاؤن لوڈ کیا جا سکتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vị trí, dấu trang và bản chép lời của nó, nếu có, được giữ lại, và có thể tải về lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "它的位置、书签以及文字稿（如果有）都会保留，并且可以再次下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "它的位置、書籤和逐字稿（如有）都會保留，且可以再次下載。"
          }
        }
      }
    },
    "feedDownloadRemoval.keptSentence.transcripts" : {
      "comment" : "Sentence about several deleted downloads: what the listener left in them is kept, and they can be downloaded again.",
      "extractionState" : "manual",
      "localizations" : {
