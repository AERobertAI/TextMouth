    "recording.saveFailed" : {
      "comment" : "Status line and announcement of the Record window when saving a recording failed. %1$@ is the reason, a whole sentence that ends with its own full stop, %2$@ is the title of the button that tries again, and %3$@ is the title of the button that deletes the recording.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّر حفظ التسجيل: %1$@ تم الاحتفاظ به؛ اختر %2$@ أو %3$@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "রেকর্ডিং সংরক্ষণ করা যায়নি: %1$@ এটি রাখা আছে; %2$@ অথবা %3$@ বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Aufnahme konnte nicht gesichert werden: %1$@ Sie bleibt erhalten; wähle „%2$@“ oder „%3$@“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recording couldn't be saved: %@ It is kept; choose %@ or %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo guardar la grabación: %1$@ Se conserva; elige %2$@ o %3$@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ضبط ذخیره نشد: %1$@ این ضبط نگه داشته شده است؛ %2$@ یا %3$@ را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’enregistrement n’a pas pu être sauvegardé : %1$@ Il est conservé ; choisissez %2$@ ou %3$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא ניתן היה לשמור את ההקלטה: %1$@ ההקלטה לא אבדה; בחר “%2$@” או “%3$@”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "रिकॉर्डिंग सहेजी नहीं जा सकी: %1$@ यह रखी हुई है; “%2$@” या “%3$@” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rekaman tidak dapat disimpan: %1$@ Rekaman masih ada; pilih %2$@ atau %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile salvare la registrazione: %1$@ È stata conservata; scegli %2$@ oppure %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "録音を保存できませんでした：%1$@録音は保持されています。「%2$@」または「%3$@」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "녹음을 저장할 수 없습니다: %1$@ 녹음은 보관됩니다. %2$@ 또는 %3$@ 중에서 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De opname kon niet worden bewaard: %1$@ De opname blijft bewaard; kies %2$@ of %3$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie udało się zachować nagrania: %1$@ Nagranie nie zostało utracone; wybierz %2$@ albo %3$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não foi possível salvar a gravação: %1$@ Ela foi mantida; escolha %2$@ ou %3$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не удалось сохранить запись: %1$@ Запись не потеряна; выберите «%2$@» или «%3$@»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Inspelningen kunde inte sparas: %1$@ Den har behållits. Välj %2$@ eller %3$@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "บันทึกการบันทึกเสียงไม่ได้: %1$@ ยังเก็บการบันทึกไว้ ให้เลือก %2$@ หรือ %3$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kayıt kaydedilemedi: %1$@ Kayıt saklandı; %2$@ veya %3$@ seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не вдалося зберегти запис: %1$@ Його збережено; виберіть «%2$@» або «%3$@»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ریکارڈنگ محفوظ نہیں ہو سکی: %1$@ وہ رکھی ہوئی ہے؛ %2$@ یا %3$@ منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không thể lưu bản ghi âm: %1$@ Bản ghi vẫn được giữ; hãy chọn %2$@ hoặc %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "无法存储录音：%1$@录音已保留；请选取“%2$@”或“%3$@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "無法儲存錄音：%1$@錄音已保留；請選擇「%2$@」或「%3$@」。"
          }
        }
      }
    },
    "recording.saveRecoveredHint" : {
      "comment" : "VoiceOver hint of the button that saves a recording left behind. %@ is the label of the pop-up that chooses the folder.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحفظ هذا التسجيل ككتاب صوتي في المجلد المحدد في %@، بعنوان يعتمد على وقت تسجيله."
          }
        },
        "bn" : {
          "stringUnit" : {
