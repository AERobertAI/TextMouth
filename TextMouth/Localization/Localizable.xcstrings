    "Keep Both" : {
      "comment" : "Title and VoiceOver label of the button of the duplicate-book question that keeps both copies. Title case."
    },
    "Keep Original" : {
      "comment" : "A choice of the After Importing a Book pop-up in the Storage settings: the original file stays where it was."
    },
    "Keep This Code" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. The label of the button under that note that keeps the guessed code (a pop-up cannot be asked for the choice already selected), and what it does."
    },
    "Keep for a number of days" : {
      "comment" : "Choice of the Original audio picker: keep the original audio for a number of days, set by a stepper beside it."
    },
    "Keep on This Mac" : {
      "comment" : "Library menu command that keeps a book's files downloaded on this Mac. Also the name other sentences use for the command."
    },
    "Keep originals of converted audio" : {
      "comment" : "Label of the Storage settings switch that keeps the original file of each audio file an import converts."
    },
    "Keep these books on this Mac" : {
      "comment" : "Checkbox of the Reading List's options bar, shown while the library is in iCloud: keep the list's books downloaded on this Mac.",
      "localizations" : {
