          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Datei „%1$@“ deklariert die Textcodierung „%2$@“, die TextMouth nicht lesen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
