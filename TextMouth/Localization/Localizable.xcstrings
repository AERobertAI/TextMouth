    "duplicateCopy.markerStays" : {
      "comment" : "What the duplicate question says when Keep Both could not take the waiting mark off the new copy. %@ is the new copy's title. \"Cancel\" is the sheet's Cancel button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّر على TextMouth الاحتفاظ بالنسخة الجديدة من “%@”. اختر “إلغاء” لتجاهل النسخة، ثم استورد الملف مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth “%@”-এর নতুন কপি রাখতে পারেনি। কপিটি বাদ দিতে “বাতিল করুন” বেছে নিন, তারপর ফাইলটি আবার আমদানি করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth konnte die neue Kopie von „%@“ nicht behalten. Wähle „Abbrechen“, um die Kopie zu verwerfen, und importiere die Datei dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth could not keep the new copy of “%@”. Choose Cancel to discard the copy, then import the file again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no pudo conservar la copia nueva de “%@”. Elige Cancelar para descartar la copia y luego importa el archivo otra vez."
          }
        },
        "fa" : {
          "stringUnit" : {
