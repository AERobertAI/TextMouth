        }
      }
    },
    "The original file was kept: TextMouth imported only the DAISY book “%@” from the archive “%@”." : {
      "comment" : "Notice after one DAISY book was imported from an archive of other books, so the original file was kept. %1$@ is the book's title and %2$@ the archive's file name. A sentence about the other books follows.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Originaldatei wurde behalten: TextMouth hat nur das DAISY-Buch „%1$@“ aus dem Archiv „%2$@“ importiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The original file was kept: TextMouth imported only the DAISY book “%1$@” from the archive “%2$@”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se conservó el archivo original: TextMouth importó solo el libro DAISY “%1$@” del archivo comprimido “%2$@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le fichier d’origine a été conservé : TextMouth n’a importé que le livre DAISY « %1$@ » de l’archive « %2$@ »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "मूल फ़ाइल रखी गई: TextMouth ने संग्रह “%2$@” से केवल DAISY पुस्तक “%1$@” आयात की।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "File asli dipertahankan: TextMouth hanya mengimpor buku DAISY “%1$@” dari arsip “%2$@”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il file originale è stato conservato: TextMouth ha importato solo il libro DAISY “%1$@” dall’archivio “%2$@”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "元のファイルは保持されました。TextMouth は、アーカイブ「%2$@」から DAISY ブック「%1$@」だけを読み込みました。"
          }
        },
