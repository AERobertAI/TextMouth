    },
    "Save" : {
      "comment" : "Button of the book information sheet that saves the edits.\nButton that keeps what was typed or changed in a sheet and closes it, such as a bookmark's note, a book's information, or a library view's name.\nButton that saves the changes made in a sheet.\nButton that saves what a sheet or window edited, such as a filter preset or the audio editor's edits.\nName of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Saves the edited audio.\nText of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. The button that saves the view.\nTitle of the button that saves an edited substitution rule, in the rule editor.\nTitle of the question's default button when the Record window is closed with a recording that could not be saved: it tries to save it again.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Guardar"
          }
        }
      }
    },
    "Save Again" : {
      "comment" : "Title of the button in the Record window that tries again to save a recording whose save failed."
    },
    "Save Name" : {
      "comment" : "Button that keeps the new name typed for a marker."
    },
    "Save WordPerfect documents as Word or HTML files in a program that reads them, such as LibreOffice, then import those." : {
      "comment" : "Advice after the refusal of a WordPerfect document, which no part of macOS reads. LibreOffice is a program's name."
    },
    "Save and Export" : {
      "comment" : "Heading of the audio editor's buttons for saving and exporting."
    },
    "Save as Audiobook" : {
      "comment" : "Title of the button in the Record window that saves a recording left behind as an audiobook."
    },
    "Save as Audiobook: %@" : {
      "comment" : "VoiceOver label of the button that saves one recording left behind. %@ describes the recording, such as \"Recording of October 4, 2026 at 6:30 AM, 1 minute, 4 seconds\"."
    },
    "Save in" : {
      "comment" : "Label of the pop-up in the Record window that chooses the library folder the recording is saved in."
    },
    "Save metadata changes" : {
      "comment" : "What VoiceOver says for the Save button of an audiobook's book information sheet."
    },
    "Save metadata to the library and to the library's copy of the EPUB file" : {
