        }
      }
    },
    "Default location" : {
      "comment" : "Under the data directory's path in Storage settings: the library is in the default location."
    },
    "Default pitch" : {
      "comment" : "VoiceOver label of the default pitch slider in the Voice settings."
    },
    "Default pitch for new books. 1.0 is normal. Each book can override this." : {
      "comment" : "Explanation under the default pitch slider in the Voice settings."
    },
    "Default speed" : {
      "comment" : "VoiceOver label of the default speed slider in the Voice settings."
    },
    "Default speed for new books. Each book can override this with its own speed." : {
      "comment" : "Explanation under the default speed slider in the Voice settings."
    },
    "Delete" : {
      "comment" : "A command on a bookmark of the Bookmarks list, as a button beside its row, a VoiceOver action, and a context menu item: deletes the bookmark.\nButton of a marker's row in the audio editor's list that deletes the marker.\nName of a filter preset's Delete button, also its VoiceOver action and context menu item.\nName of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Delete\".\nName of the command that deletes a substitution rule: a row button's label and tooltip, a VoiceOver action, and a context menu item.\nText of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). The question's button that deletes.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eliminar"
          }
        }
      }
    },
    "Delete %@" : {
      "comment" : "VoiceOver label of the command that deletes feed items' downloads. %@ is what is deleted, such as \"the download of “Ep. 368”\" or \"3 downloads\"."
    },
    "Delete %@ Permanently" : {
      "comment" : "Title of a button that deletes the named books' files permanently, in title case. %@ is the object, such as \"3 Books\", \"3 Selected\", or \"Everything\"."
    },
    "Delete %@ permanently" : {
      "comment" : "VoiceOver label of a removal button that deletes files permanently. %@ is what is deleted, such as \"“Notes”\", \"3 selected books\", or \"the original file\"."
    },
