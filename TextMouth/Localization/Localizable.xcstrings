            "state" : "machine_translated",
            "value" : "La bibliothèque dans %@ n’est pas disponible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הספרייה שבנתיב %@ אינה זמינה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ पर मौजूद लाइब्रेरी उपलब्ध नहीं है।"
