    "sleepTimerView.endOfBookHint.continueNext" : {
      "comment" : "VoiceOver hint and help tag of the sleep timer sheet's End of book button, for a book set to go on to the next book when it ends.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يشغّل الكتاب ويتوقف مؤقتًا قبل الكتاب التالي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইটি চালায় এবং পরের বইয়ের আগে বিরতি দেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gibt das Buch wieder und pausiert vor dem nächsten Buch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plays the book and pauses before the next book."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproduce el libro y hace una pausa antes del siguiente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب را پخش می‌کند و پیش از کتاب بعدی مکث می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lit le livre et fait une pause avant le livre suivant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מנגן את הספר ומשהה לפני הספר הבא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पुस्तक चलाता है और अगली पुस्तक से पहले पॉज़ करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Memutar buku dan menjeda sebelum buku berikutnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Riproduce il libro e si mette in pausa prima del libro successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブックを再生し、次のブックの前に一時停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책을 재생하고 다음 책 전에 일시 정지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Speelt het boek af en pauzeert vóór het volgende boek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Odtwarza książkę i wstrzymuje odtwarzanie przed następną książką."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproduz o livro e pausa antes do próximo livro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Воспроизводит книгу и ставит на паузу перед следующей книгой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Spelar upp boken och pausar före nästa bok."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เล่นหนังสือและหยุดชั่วคราวก่อนหนังสือเล่มถัดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitabı oynatır ve sonraki kitaptan önce duraklatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відтворює книгу та призупиняє перед наступною книгою."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب چلاتا ہے اور اگلی کتاب سے پہلے توقف کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Phát sách và tạm dừng trước sách tiếp theo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "播放图书，并在下一本图书前暂停。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "播放這本書，並在下一本書之前暫停。"
          }
        }
      }
    },
    "sleepTimerView.endOfBookHint.loop" : {
      "comment" : "VoiceOver hint and help tag of the sleep timer sheet's End of book button, for a book set to start again from its beginning when it ends.",
