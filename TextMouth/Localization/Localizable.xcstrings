        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth-এর একটি নতুন সংস্করণ এই অডিও সম্পাদনা করেছে, তাই এই সংস্করণ সেই সম্পাদনাগুলোতে হাত দেয় না।"
          }
        },
        "de" : {
          "stringUnit" : {
