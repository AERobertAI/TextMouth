    "folderRemoval.choiceMessage.contents" : {
      "comment" : "Sentence of the dialog that asks how to delete a folder. \"Move Contents Out\" is the name of one of its buttons.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عند اختيار “نقل المحتويات إلى الخارج”، تبقى في المكتبة ويُحذف المجلد فقط."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“বিষয়বস্তু বাইরে স্থানান্তর করুন” দিয়ে এগুলো লাইব্রেরিতে থাকে আর শুধু ফোল্ডারটি মুছে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mit „Inhalt herausverschieben“ bleiben sie in der Bibliothek, und nur der Ordner wird gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Move Contents Out, they stay in the library and only the folder is deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con Mover el contenido fuera, permanecen en la biblioteca y solo se elimina la carpeta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "با «انتقال محتوا به بیرون»، آن‌ها در کتابخانه می‌مانند و فقط پوشه حذف می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si vous choisissez Déplacer le contenu hors du dossier, ils restent dans la bibliothèque et seul le dossier est supprimé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בבחירה ב“הוצא את התוכן”, הם נשארים בספרייה ורק התיקייה נמחקת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“सामग्री बाहर ले जाएँ” चुनने पर, वे लाइब्रेरी में रहते हैं और केवल फ़ोल्डर मिटाया जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dengan Pindahkan Isi ke Luar, semuanya tetap berada di pustaka dan hanya folder yang dihapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con “Sposta fuori il contenuto”, restano nella libreria e viene eliminata solo la cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「中身を移動」では、それらはライブラリに残り、フォルダだけが削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "내용 이동을 선택하면 항목은 보관함에 남고 폴더만 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Met Verplaats inhoud eruit blijven ze in de bibliotheek en wordt alleen de map verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Po wybraniu Przenieś zawartość na zewnątrz pozostają w bibliotece, a usuwany jest tylko folder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Com Mover conteúdo para fora, eles permanecem na biblioteca e só a pasta é excluída."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«Переместить содержимое»: они остаются в библиотеке, а удаляется только папка."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Med ”Flytta ut innehållet” finns de kvar i biblioteket och bara mappen raderas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เมื่อเลือก ย้ายเนื้อหาออก รายการเหล่านั้นจะยังอยู่ในไลบรารีและลบเฉพาะโฟลเดอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“İçeriği Dışarı Taşı” ile bunlar kitaplıkta kalır ve yalnızca klasör silinir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо вибрати «Перемістити вміст», вони залишаються в бібліотеці, а видаляється лише папка."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“مندرجات باہر منتقل کریں” منتخب کرنے پر، وہ لائبریری میں رہتے ہیں اور صرف فولڈر حذف ہوتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nếu chọn Di chuyển nội dung ra ngoài, chúng vẫn ở trong thư viện và chỉ thư mục bị xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "使用“移出内容”时，它们会保留在资料库中，只会删除该文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "使用「移出內容」時，它們會留在書庫中，只有檔案夾被刪除。"
          }
        }
      }
    },
    "folderRemoval.choiceMessage.everything" : {
      "comment" : "Sentence of the dialog that asks how to delete a folder. %1$@ is the title of its button that deletes everything, such as \"Move Everything to Trash\", and %2$@ says what happens to the files, such as \"their files go to the Trash, where you can recover them until the Trash is emptied\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عند اختيار %1$@، يغادر المجلد وكل ما فيه المكتبة، و%2$@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” দিয়ে ফোল্ডার ও এর সবকিছু লাইব্রেরি ছেড়ে যায়, এবং %2$@।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mit %1$@ verlassen der Ordner und alles darin die Bibliothek, und %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With %@, the folder and everything in it leave the library, and %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con %1$@, la carpeta y todo lo que contiene salen de la biblioteca, y %2$@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "با %@، پوشه و همه‌ی محتوای آن از کتابخانه خارج می‌شوند، و %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si vous choisissez %@, le dossier et tout ce qu’il contient quittent la bibliothèque, et %@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בבחירה ב“%1$@”, התיקייה וכל מה שבתוכה עוזבים את הספרייה, ו%2$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” चुनने पर, फ़ोल्डर और उसमें मौजूद सब कुछ लाइब्रेरी से हट जाता है, और %2$@।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dengan %@, folder dan semua isinya keluar dari pustaka, dan %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con “%@”, la cartella e tutto ciò che contiene escono dalla libreria, e %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%1$@」では、フォルダとその中身すべてがライブラリから消え、%2$@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@을(를) 선택하면 폴더와 그 안의 모든 항목이 보관함에서 제거됩니다. 또한 %2$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Met %@ verlaten de map en alles erin de bibliotheek, en %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Po wybraniu %1$@ folder i wszystko, co w nim jest, opuszcza bibliotekę, a %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Com %1$@, a pasta e tudo que há nela saem da biblioteca, e %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%1$@»: папка и всё, что в ней, покидают библиотеку; %2$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Med ”%@” lämnar mappen och allt i den biblioteket, och %@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เมื่อเลือก %1$@ โฟลเดอร์และทุกอย่างในนั้นจะออกจากไลบรารี และ %2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” ile klasör ve içindeki her şey kitaplıktan çıkar; %2$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо вибрати «%1$@», папка та все, що в ній, залишають бібліотеку, і %2$@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” منتخب کرنے پر فولڈر اور اس کی ہر چیز لائبریری سے نکل جاتی ہے، اور %2$@۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nếu chọn %1$@, thư mục và mọi thứ trong đó rời khỏi thư viện, và %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "使用“%1$@”时，该文件夹及其中的所有内容都会离开资料库，并且%2$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "使用「%1$@」時，檔案夾及其中所有內容都會離開書庫，且%2$@。"
          }
        }
      }
    },
