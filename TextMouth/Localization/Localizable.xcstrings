    "common.theseBooksCouldNotBeRemoved" : {
      "comment" : "Heading of the error alert's list when Remove from Library Only could not mark the packages of several books, so they stay in the library. Each book's title and the reason follow on their own lines.\nHeading over the books that could not be removed from the library, several of them. One line for each book follows.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّرت إزالة هذه الكتب من المكتبة وهي باقية فيها:"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই বইগুলো লাইব্রেরি থেকে সরানো যায়নি এবং এতেই রয়ে গেছে:"
