    "%@ and any subfolders will be removed from the library." : {
      "comment" : "First sentence of the second confirmation that deletes an empty folder. %@ is the folder's name in quotation marks.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ und alle Unterordner werden aus der Bibliothek entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ y cualquier subcarpeta se quitarán de la biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ et ses sous-dossiers seront retirés de la bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ e le eventuali sottocartelle verranno rimosse dalla libreria."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A pasta %@ e as subpastas serão removidas da biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ и все вложенные папки будут убраны из библиотеки."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ і всі підпапки буде вилучено з бібліотеки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 及其所有子文件夹都将从资料库中移除。"
          }
        }
      }
    },
    "%@ are in your library, unsubscribed. Choose %@ on a feed's row, or in its %@, to check it again." : {
      "comment" : "What the Import OPML sheet says of several feeds the file lists that are in the library already, unsubscribed. The first %@ is a list of their titles; the second is the name of the Resubscribe command; the third is the name of the Feed Info sheet.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ sind in deiner Bibliothek, aber abbestellt. Wähle %2$@ in der Zeile des jeweiligen Feeds oder unter %3$@, um sie erneut zu prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ are in your library, unsubscribed. Choose %2$@ on a feed's row, or in its %3$@, to check it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ya están en tu biblioteca, sin suscripción. Elige %2$@ en la fila de un canal, o en su %3$@, para volver a revisarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ figurent dans votre bibliothèque, mais sans abonnement. Choisissez %2$@ sur la ligne d’un flux, ou dans %3$@, pour les vérifier de nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ sono nella tua libreria, ma l’iscrizione è annullata. Scegli %2$@ nella riga di un feed, o nel foglio %3$@, per controllarli di nuovo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ estão na sua biblioteca, sem assinatura. Escolha %2$@ na linha de um feed, ou em %3$@, para verificá-los novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ уже в вашей библиотеке, но вы от них отписались. Выберите %2$@ в строке ленты или в листе %3$@, чтобы снова проверять их."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ є у вашій бібліотеці без підписки. Виберіть %2$@ у рядку стрічки або в аркуші «%3$@», щоб перевірити їх знову."
          }
        }
      }
    },
    "%@ aren't downloaded." : {
      "comment" : "Why an operation left several books as it is: their files are only in the cloud. %@ is a count of books, such as \"5 books\".\nWhy an operation left two or three books as it is: their files are only in the cloud. %@ is the books' titles as a list.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ sind nicht heruntergeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no están descargados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ne sont pas téléchargés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ non sono scaricati."
          }
        },
        "pt-BR" : {
