    "Every episode of %@ is already played." : {
      "comment" : "What VoiceOver says when Mark All Played finds no unplayed episode. %@ is the feed's title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alle Folgen von %@ sind bereits wiedergegeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Todos los episodios de %@ ya están reproducidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tous les épisodes de %@ sont déjà écoutés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
