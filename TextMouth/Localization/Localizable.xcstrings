    "brailleSettings.source.writesOnly" : {
      "comment" : "Under the pop-ups in the Braille tab of Settings: the table chosen earlier only writes braille from print, so it is not among the choices for reading. Choosing another is the way to change it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جدول برايل المختار يكتب برايل فقط، لذلك لا يُعرض لقراءة ملفات برايل؛ اختر جدولًا آخر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বেছে নেওয়া ব্রেইল টেবিলটি শুধু ব্রেইল লেখে, তাই ব্রেইল ফাইল পড়ার জন্য এটি দেওয়া হয় না; অন্যটি বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die gewählte Tabelle schreibt nur Braille und wird deshalb nicht zum Lesen von Braille-Dateien angeboten; wählen Sie eine andere."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chosen table only writes braille, so it is not offered for reading braille files; choose another."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La tabla elegida solo escribe braille, así que no se ofrece para leer archivos braille; elige otra."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جدول انتخاب‌شده فقط بریل می‌نویسد، پس برای خواندن پرونده‌های بریل پیشنهاد نمی‌شود؛ جدول دیگری انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La table choisie écrit seulement du braille, elle n’est donc pas proposée pour lire des fichiers braille ; choisissez-en une autre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הטבלה שנבחרה רק כותבת ברייל, ולכן היא לא מוצעת לקריאת קובצי ברייל; בחרו טבלה אחרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "चुनी गई तालिका केवल ब्रेल लिखती है, इसलिए ब्रेल फ़ाइलें पढ़ने के लिए यह नहीं दी जाती; कोई और चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tabel yang dipilih hanya menulis Braille, jadi tidak ditawarkan untuk membaca berkas Braille; pilih yang lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La tabella scelta scrive solo braille, quindi non viene offerta per leggere i file braille; scegline un’altra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選択した点字テーブルは点字を書き出すだけなので、点字ファイルの読み取りには使えません。別のテーブルを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "선택한 점자 테이블은 점자를 쓰기만 하므로 점자 파일을 읽는 데는 제공되지 않습니다. 다른 테이블을 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De gekozen tabel schrijft alleen braille en wordt daarom niet aangeboden om braillebestanden te lezen; kies een andere."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wybrana tabela tylko zapisuje Braille’a, więc nie jest oferowana do odczytu plików Braille’a; wybierz inną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A tabela escolhida só escreve braille, então não é oferecida para ler arquivos braille; escolha outra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Выбранная таблица только пишет шрифт Брайля, поэтому её нельзя использовать для чтения файлов Брайля; выберите другую."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Den valda tabellen skriver bara punktskrift och erbjuds därför inte för att läsa punktskriftsfiler; välj en annan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตารางอักษรเบรลล์ที่เลือกใช้เขียนเบรลล์ได้อย่างเดียว จึงไม่เสนอให้ใช้อ่านไฟล์เบรลล์ โปรดเลือกตารางอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Seçilen tablo yalnızca Braille yazar, bu yüzden Braille dosyalarını okumak için sunulmaz; başka bir tane seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вибрана таблиця лише пише шрифт Брайля, тому її не пропонують для читання файлів Брайля; виберіть іншу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "منتخب جدول صرف بریل لکھتا ہے، اس لیے بریل فائلیں پڑھنے کے لیے پیش نہیں کیا جاتا؛ کوئی اور چنیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bảng đã chọn chỉ viết Braille nên không được đưa ra để đọc tệp Braille; hãy chọn bảng khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "所选盲文表只能写出盲文，因此不会用于读取盲文文件；请另选一个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "所選點字表只能寫出點字，因此不會用於讀取點字檔案；請另選一個。"
          }
        }
      }
    },
