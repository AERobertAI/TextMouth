          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "звук аудиокниги изменился после расшифровки, поэтому расшифровка ему больше не соответствует."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ljudbokens ljud ändrades efter att den transkriberades, så dess transkription passar inte längre."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เสียงของหนังสือเสียงเปลี่ยนไปหลังถอดเสียง ข้อความถอดเสียงจึงไม่ตรงกับเสียงอีกต่อไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "sesli kitabın sesi yazıya dökülmesinden sonra değişti, bu yüzden transkripti artık ona uymuyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "звук аудіокниги змінився після транскрибування, тому її транскрипція йому більше не відповідає."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آڈیو بک کا آڈیو ٹرانسکرپشن کے بعد بدل گیا، اس لیے اس کا ٹرانسکرپٹ اب اس سے میل نہیں کھاتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "âm thanh của sách nói đã thay đổi kể từ khi được chép lời, nên bản chép lời của nó không còn khớp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "有声书的音频在转录后已更改，因此其文字稿不再与之相符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "有聲書的音訊在轉錄後已更改，因此其逐字稿已不再相符。"
          }
        }
      }
    },
    "bookTextEdit.transcriptUnavailable" : {
      "comment" : "Reason after a colon: an audiobook's transcript can't be read, so an edit can't be taken into it; begins in lower case.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّرت قراءة النسخة النصية للكتاب الصوتي الآن، لذا لا يمكن إدخال التحرير فيها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "অডিওবুকের ট্রান্সক্রিপ্ট এখন পড়া যাচ্ছে না, তাই সম্পাদনাটি তাতে নেওয়া যাচ্ছে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "das Transkript des Hörbuchs kann gerade nicht gelesen werden, daher kann die Änderung nicht darin übernommen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the audiobook's transcript can't be read now, so the edit can't be taken into it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "la transcripción del audiolibro no se puede leer ahora, así que la edición no se puede incorporar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "رونوشت کتاب صوتی اکنون قابل خواندن نیست، بنابراین ویرایش در آن اعمال نمی‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "la transcription du livre audio est illisible pour l’instant, la modification ne peut donc pas y être prise en compte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא ניתן לקרוא כעת את התמליל של ספר השמע, ולכן לא ניתן לשלב בו את העריכה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ऑडियोबुक की ट्रांसक्रिप्ट अभी पढ़ी नहीं जा सकती, इसलिए संपादन को उसमें शामिल नहीं किया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "transkrip buku audio tidak dapat dibaca sekarang, sehingga hasil edit tidak dapat dimasukkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "la trascrizione dell’audiolibro non può essere letta ora, quindi la modifica non può essere applicata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オーディオブックの文字起こしを今は読み取れないため、編集を反映できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "오디오북의 대본을 지금 읽을 수 없어 편집 내용을 반영할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "de transcriptie van het luisterboek kan nu niet worden gelezen, dus de wijziging kan er niet in worden opgenomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "nie można teraz odczytać transkrypcji audiobooka, więc nie można do niej wprowadzić edycji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "a transcrição do audiolivro não pode ser lida agora, então a edição não pode ser incorporada a ela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "расшифровку аудиокниги сейчас нельзя прочитать, поэтому правку нельзя в неё внести."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ljudbokens transkription kan inte läsas nu, så ändringen kan inte tas in i den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตอนนี้อ่านข้อความถอดเสียงของหนังสือเสียงไม่ได้ จึงนำการแก้ไขไปใช้ไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "sesli kitabın transkripti şu an okunamıyor, bu yüzden düzenleme ona işlenemiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "транскрипцію аудіокниги зараз не вдається прочитати, тому правку не можна в неї внести."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آڈیو بک کا ٹرانسکرپٹ ابھی پڑھا نہیں جا سکتا، اس لیے ترمیم اس میں شامل نہیں کی جا سکتی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "không đọc được bản chép lời của sách nói lúc này, nên không thể đưa bản sửa vào đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "现在无法读取有声书的文字稿，因此无法将编辑纳入其中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "目前無法讀取有聲書的逐字稿，因此無法將編輯納入其中。"
          }
        }
      }
    },
