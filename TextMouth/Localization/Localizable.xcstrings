            "state" : "machine_translated",
            "value" : "Download de “%@” interrompido."
          }
        }
      }
    },
    "Stopped keeping %@ on this Mac" : {
      "comment" : "Announcement when Stop Keeping on This Mac ran. %@ is the book's title, or a count of books such as \"3 books\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
