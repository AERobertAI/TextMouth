          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "目标文件夹 %@ 已不在资料库中。"
          }
        }
      }
    },
    "The details could not be copied" : {
      "comment" : "Announcement when Copy Details could not copy the report of a speech refusal to the pasteboard.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
