    "quitHold.message" : {
      "comment" : "Panel text and announcement while TextMouth finishes work before quitting. %@ is the list of what is under way, such as \"saving the library and keeping downloads\", already joined in the language's own list style.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يُنجز TextMouth بعض الأعمال قبل الإنهاء: %@. وسيُنهي عمله عند اكتمالها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth প্রস্থানের আগে কাজ শেষ করছে: %@। কাজ শেষ হলে এটি প্রস্থান করবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth erledigt noch Aufgaben, bevor es sich beendet: %@. Danach beendet es sich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth is finishing up before it quits: %@. It quits when that is done."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth está terminando antes de salir: %@. Saldrá cuando termine."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth پیش از خروج در حال تمام کردن کار است: %@. پس از پایان آن خارج می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth termine son travail avant de se fermer : %@. Il se ferme ensuite."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth מסיים את מה שבתהליך לפני היציאה: %@. הוא ייצא עם סיום הפעולות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth छोड़ने से पहले काम पूरा कर रहा है: %@। वह पूरा होते ही TextMouth छोड़ दिया जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth sedang menyelesaikan pekerjaan sebelum keluar: %@. TextMouth keluar setelah itu selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth sta ultimando le operazioni prima di uscire: %@. Uscirà al termine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は終了前に作業を完了しています：%@。完了すると終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 종료 전에 작업을 마무리하는 중입니다: %@. 완료되면 종료됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth rondt af voordat het wordt afgesloten: %@. Het sluit af zodra dat klaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kończy pracę przed zamknięciem: %@. Zamknie się, gdy to się skończy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth está concluindo antes de encerrar: %@. Ele encerra quando isso terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth заканчивает дела перед выходом: %@. Выход произойдёт, когда всё будет сделано."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth gör klart innan det avslutas: %@. Det avslutas när det är klart."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth กำลังทำงานให้เสร็จก่อนออก: %@ จะออกเมื่อเสร็จแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth çıkmadan önce işleri bitiriyor: %@. Bunlar bitince çıkar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth завершує роботу перед виходом: %@. Він вийде, коли це буде зроблено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth بند ہونے سے پہلے کام مکمل کر رہا ہے: %@۔ یہ مکمل ہوتے ہی بند ہو جائے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth đang hoàn tất công việc trước khi thoát: %@. Ứng dụng sẽ thoát khi xong."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 正在完成退出前的收尾工作：%@。完成后即会退出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 結束前正在完成收尾工作：%@。完成後便會結束。"
          }
        }
      }
    },
