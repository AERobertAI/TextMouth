          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bagian dengan %1$@ dimulai %2$@ setelah awal “%3$@”, sebelum %4$@ yang lebih awal, yang dimulai %5$@ setelah awal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’%@ inizia a %@ dall’inizio di “%@”, prima dell’%@ precedente, che inizia a %@."
