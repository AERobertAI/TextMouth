    "speechRefusal.bookPassageHeading" : {
      "comment" : "A line of the speech refusal report that introduces the passage as the book has it. %1$@ and %2$@ are the first and last character offsets of the passage, and %3$@ is the chapter's number, each written without digit grouping.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "النص كما هو في الكتاب، من الحرف %1$@ إلى %2$@ من الفصل %3$@:"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইয়ে যেমন আছে তেমন অংশটি, অধ্যায় %3$@-এর %1$@ থেকে %2$@ নম্বর অক্ষর:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Passage, wie sie im Buch steht, Zeichen %1$@ bis %2$@ von Kapitel %3$@:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The passage as the book has it, characters %@ to %@ of chapter %@:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El pasaje tal como lo tiene el libro, caracteres %1$@ a %2$@ del capítulo %3$@:"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بخش همان‌طور که کتاب دارد، نویسه‌های %1$@ تا %2$@ از فصل %3$@:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le passage tel que le livre le contient, caractères %1$@ à %2$@ du chapitre %3$@ :"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הקטע כפי שהוא בספר, תווים %1$@ עד %2$@ בפרק %3$@:"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पुस्तक में यह अंश जैसा है, अध्याय %3$@ के वर्ण %1$@ से %2$@ तक:"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bagian seperti yang ada di buku, karakter %1$@ hingga %2$@ dari bab %3$@:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il brano com’è nel libro, caratteri da %1$@ a %2$@ del capitolo %3$@:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブックにあるままの箇所（第%3$@章の%1$@文字目から%2$@文字目）："
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책에 있는 그대로의 구간, 챕터 %3$@의 문자 %1$@에서 %2$@까지:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De passage zoals het boek die heeft, tekens %1$@ tot %2$@ van hoofdstuk %3$@:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fragment taki, jaki ma książka, znaki od %1$@ do %2$@ rozdziału %3$@:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O trecho como está no livro, caracteres %1$@ a %2$@ do capítulo %3$@:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Отрывок в том виде, как он в книге, символы с %1$@ по %2$@ главы %3$@:"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stycket så som det står i boken, tecken %1$@ till %2$@ i kapitel %3$@:"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ข้อความตามที่หนังสือมี อักขระ %1$@ ถึง %2$@ ของบทที่ %3$@:"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pasaj, kitaptaki haliyle, %3$@. bölümün %1$@. ile %2$@. karakterleri:"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Уривок, як він є в книзі, символи від %1$@ до %2$@ розділу %3$@:"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب میں موجود حصہ، باب %3$@ کے حرف %1$@ سے %2$@ تک:"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đoạn văn như trong sách, ký tự %1$@ đến %2$@ của chương %3$@:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "图书中的原文段落，第 %3$@ 章的第 %1$@ 到 %2$@ 个字符："
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "書籍中的這段文字，第 %1$@ 到 %2$@ 個字元，位於第 %3$@ 章："
          }
        }
      }
