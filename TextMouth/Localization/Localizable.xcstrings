    "protection.passwordHint" : {
      "comment" : "Hint of the password field: what to type, and how to finish.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اكتب كلمة مرور الكتاب، ثم اضغط Return."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইয়ের পাসওয়ার্ড টাইপ করে Return চাপুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Geben Sie das Passwort des Buchs ein und drücken Sie dann die Eingabetaste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type the book's password, then press Return."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escribe la contraseña del libro y pulsa Intro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "گذرواژه کتاب را بنویسید و سپس Return را بزنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saisissez le mot de passe du livre, puis appuyez sur Retour."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הקלידו את סיסמת הספר ולחצו על Return."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पुस्तक का पासवर्ड लिखें, फिर Return दबाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ketik kata sandi buku, lalu tekan Return."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Digita la password del libro, poi premi Invio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブックのパスワードを入力して、Returnキーを押してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책의 암호를 입력한 다음 Return 키를 누르세요."
          }
        },
        "nl" : {
