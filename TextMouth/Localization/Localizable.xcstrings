        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "При замене сохраняются позиция чтения, закладки, настройки, папка и место существующей копии в списке для чтения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vid ersättning behålls den befintliga kopians läsposition, bokmärken, inställningar, mapp och plats i läslistan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "การแทนที่จะเก็บตำแหน่งการอ่าน ที่คั่นหน้า การตั้งค่า โฟลเดอร์ และตำแหน่งในรายการอ่านของสำเนาที่มีอยู่"
