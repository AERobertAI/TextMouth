    "mobiError.copyProtected" : {
      "comment" : "Why a Kindle (MOBI) book could not be imported: it is encrypted or carries copy protection (DRM), which TextMouth never removes.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "كتاب Kindle هذا محمي من النسخ، ولا يستطيع TextMouth قراءة الكتب المحمية من النسخ."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই Kindle বইটি কপি-সুরক্ষিত, এবং TextMouth কপি-সুরক্ষিত বই পড়তে পারে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieses Kindle-Buch ist kopiergeschützt, und TextMouth kann kopiergeschützte Bücher nicht lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Kindle book is copy-protected, and TextMouth can't read copy-protected books."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este libro de Kindle tiene protección contra copia, y TextMouth no puede leer libros con protección contra copia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "این کتاب Kindle حفاظت از کپی دارد و TextMouth نمی‌تواند کتاب‌های دارای حفاظت از کپی را بخواند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce livre Kindle est protégé contre la copie, et TextMouth ne peut pas lire les livres protégés contre la copie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ספר Kindle זה מוגן מפני העתקה, ו-TextMouth אינו יכול לקרוא ספרים מוגנים מפני העתקה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "यह Kindle पुस्तक कॉपी-सुरक्षित है, और TextMouth कॉपी-सुरक्षित पुस्तकें नहीं पढ़ सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Buku Kindle ini dilindungi dari penyalinan, dan TextMouth tidak dapat membaca buku yang dilindungi dari penyalinan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo libro Kindle è protetto da copia e TextMouth non può leggere i libri protetti da copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "この Kindle ブックはコピー防止されており、TextMouth はコピー防止されたブックを読み取れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 Kindle 책은 복사 방지가 되어 있으며, TextMouth는 복사 방지된 책을 읽을 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dit Kindle-boek is kopieerbeveiligd, en TextMouth kan geen kopieerbeveiligde boeken lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ta książka Kindle jest zabezpieczona przed kopiowaniem, a TextMouth nie potrafi odczytywać takich książek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este livro Kindle tem proteção contra cópia, e o TextMouth não consegue ler livros com proteção contra cópia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Эта книга Kindle защищена от копирования, а TextMouth не читает книги с такой защитой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Den här Kindle-boken är kopieringsskyddad, och TextMouth kan inte läsa kopieringsskyddade böcker."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หนังสือ Kindle เล่มนี้มีการป้องกันการคัดลอก และ TextMouth อ่านหนังสือที่มีการป้องกันการคัดลอกไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu Kindle kitabı kopya korumalı ve TextMouth kopya korumalı kitapları okuyamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ця книга Kindle захищена від копіювання, а TextMouth не може читати книги із захистом від копіювання."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یہ Kindle کتاب کاپی سے محفوظ ہے، اور TextMouth کاپی سے محفوظ کتابیں نہیں پڑھ سکتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sách Kindle này được bảo vệ chống sao chép, và TextMouth không thể đọc sách được bảo vệ chống sao chép."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此 Kindle 图书受复制保护，TextMouth 无法读取受复制保护的图书。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此 Kindle 書籍受拷貝保護，TextMouth 無法讀取受拷貝保護的書籍。"
          }
        }
      }
    },
    "mobiError.damaged.kindleBookIncompleteGet" : {
      "comment" : "Why a Kindle (MOBI) book could not be imported: it is damaged, and what to do.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "كتاب Kindle هذا تالف أو غير مكتمل. احصل على نسخة جديدة، ثم استورده مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই Kindle বইটি ক্ষতিগ্রস্ত বা অসম্পূর্ণ। একটি নতুন কপি সংগ্রহ করুন, তারপর আবার আমদানি করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieses Kindle-Buch ist beschädigt oder unvollständig. Besorge dir eine neue Kopie und importiere sie dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Kindle book is damaged or incomplete. Get a fresh copy, then import it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este libro de Kindle está dañado o incompleto. Consigue una copia nueva e impórtalo de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "این کتاب Kindle آسیب دیده یا ناقص است. نسخه تازه‌ای بگیرید، سپس دوباره وارد کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce livre Kindle est endommagé ou incomplet. Procurez-vous une nouvelle copie, puis importez-le à nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ספר Kindle זה פגום או חלקי. השג עותק חדש, ואז ייבא אותו שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "यह Kindle पुस्तक क्षतिग्रस्त या अधूरी है। नई प्रति प्राप्त करें, फिर उसे दोबारा आयात करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Buku Kindle ini rusak atau tidak lengkap. Dapatkan salinan baru, lalu impor lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo libro Kindle è danneggiato o incompleto. Procurati una copia nuova, poi importalo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "この Kindle ブックは壊れているか不完全です。新しいコピーを入手してから、もう一度読み込んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 Kindle 책이 손상되었거나 불완전합니다. 새 사본을 구한 다음 다시 가져오십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dit Kindle-boek is beschadigd of onvolledig. Zorg voor een nieuwe kopie en importeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ta książka Kindle jest uszkodzona lub niekompletna. Pobierz nową kopię, a następnie zaimportuj ją ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este livro Kindle está danificado ou incompleto. Obtenha uma cópia nova e importe-o novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Эта книга Kindle повреждена или неполна. Получите свежую копию и снова импортируйте её."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Den här Kindle-boken är skadad eller ofullständig. Skaffa en ny kopia och importera den sedan igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หนังสือ Kindle เล่มนี้เสียหายหรือไม่สมบูรณ์ ขอสำเนาใหม่ แล้วนำเข้าอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu Kindle kitabı hasarlı ya da eksik. Yeni bir kopya edinin, sonra yeniden içe aktarın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Цю книгу Kindle пошкоджено або вона неповна. Отримайте свіжу копію, а потім імпортуйте її знову."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یہ Kindle کتاب خراب یا نامکمل ہے۔ نئی کاپی حاصل کریں، پھر اسے دوبارہ درآمد کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sách Kindle này bị hỏng hoặc không đầy đủ. Hãy lấy một bản sao mới, rồi nhập lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此 Kindle 图书已损坏或不完整。请获取新副本，然后再次导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此 Kindle 書籍已損毀或不完整。請取得新的副本，然後再次輸入。"
          }
        }
      }
    },
