              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "%lld minutos"
                }
              }
            }
          }
        }
      }
    },
    "%lld percent" : {
      "comment" : "Said at each quarter of a long save or export in the audio editor. %lld is how much is done, from 0 to 100.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld percent"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld percent"
                }
              }
            }
          }
        }
      }
    },
    "%lld seconds" : {
      "comment" : "A count of whole seconds inside a duration or a setting's length. %lld is the number of seconds.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld second"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld seconds"
                }
              }
            }
          }
        }
      }
    },
    "A Little Faster" : {
      "comment" : "Title of a premade audio filter preset: plays the audio a quarter faster without raising its pitch."
    },
    "A New Window" : {
      "comment" : "A choice of the Open the next book in pop-up button (Settings, Playback; Feed Info; Folder Settings): the next book opens in a window of its own, and this one stays.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una ventana nueva"
          }
        }
      }
    },
    "A chapter marker needs a title." : {
      "comment" : "Problem shown when the title of a chapter marker to insert in the audio editor is blank."
    },
    "A copy was kept in the book's package. Start over with no edits, or cancel." : {
      "comment" : "Explains the question about an unreadable audio edit history: what Start Over and Cancel do."
    },
    "A filter preset needs a name." : {
      "comment" : "Said when a filter preset is saved with a blank name."
    },
    "A new timer replaces the one running." : {
      "comment" : "Note under the sleep timer sheet's New Timer heading while a timer runs: setting one of the timers below stops it.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un temporizador nuevo reemplaza al que está en curso."
          }
        }
      }
    },
    "A newer TextMouth edited this audio, so this version leaves its edits alone." : {
      "comment" : "Said when the book's saved edit history was written by a later version of TextMouth than this one."
    },
    "A quote isn't closed in “%@”." : {
      "comment" : "Problem found in a typed filter chain: a single quote is opened and never closed. %@ is the text of the part holding it."
    },
    "A stretch of the edits runs past the end of “%@”." : {
      "comment" : "Said when an edit names a stretch of a source audio file that lies past the file's end. %@ is the file's name."
    },
    "Add" : {
      "comment" : "Button of the panel for adding a bookmark: adds it, with the note written.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Agregar"
          }
        }
      }
    },
