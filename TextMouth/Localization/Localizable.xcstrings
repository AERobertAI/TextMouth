    "librarySearch.regexHint" : {
      "comment" : "VoiceOver hint of the Regular Expression checkbox in the Search Library window. ICU is the name of the regular expression syntax, and stays as written.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عند التحديد، يكون نص البحث تعبيرًا نمطيًا بصيغة ICU."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "চেক করা থাকলে অনুসন্ধানের টেক্সট একটি ICU রেগুলার এক্সপ্রেশন হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
