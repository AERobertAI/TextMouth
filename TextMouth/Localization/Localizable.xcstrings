    "bookCloud.freeSpaceAnyway" : {
      "comment" : "Second sentence of why Remove Download was refused: how to free the space by hand. Show in Finder is a command's name. %@ is a clause that tells what to do in the cloud service's own app, such as \"choose Remove Download\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لتحرير المساحة على أي حال، اختر “إظهار في Finder”، ثم %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "তবুও জায়গা খালি করতে “Finder-এ দেখান” বেছে নিন, তারপর %@।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um den Speicherplatz trotzdem freizugeben, wähle „Im Finder anzeigen“ und dann %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To free the space anyway, choose Show in Finder, then %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para liberar el espacio de todos modos, elige Mostrar en Finder y luego %@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "برای آزاد کردن فضا به هر حال، «نمایش در Finder» را انتخاب کنید، سپس %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pour libérer quand même l’espace, choisissez Afficher dans le Finder, puis %@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כדי לפנות את המקום בכל זאת, בחר “הצג ב-Finder”, ואז %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फिर भी जगह खाली करने के लिए “Finder में दिखाएँ” चुनें, फिर %@।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Untuk tetap mengosongkan ruang, pilih Tampilkan di Finder, lalu %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Per liberare comunque lo spazio, scegli Mostra nel Finder, poi %@."
          }
