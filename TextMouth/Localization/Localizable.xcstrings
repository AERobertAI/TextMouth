        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uma cópia foi mantida no pacote do livro. Recomece sem edições ou cancele."
          }
        }
      }
    },
    "A destination folder path is invalid." : {
      "comment" : "Error shown when books or folders cannot be moved because the destination folder's path is not a valid place in the library.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
