    "feedItemMoveError.packageNotManaged" : {
      "comment" : "Why a downloaded feed item could not be moved between its feed's folder and the library, after \"“Title” stays in its feed:\". Lower case, without a full stop.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يذكر صفه أي حزمة تديرها المكتبة"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এর সারিতে লাইব্রেরির পরিচালিত কোনো প্যাকেজের নাম নেই"
          }
