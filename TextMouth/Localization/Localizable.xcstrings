        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "برآمد کرنے کے لیے فولڈر منتخب کریں۔ “نیا فولڈر” ایک بناتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chọn thư mục để xuất. Nút Thư mục mới sẽ tạo thư mục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
