            "value" : "Stoppt den Download. Es wird nichts installiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detiene la descarga. No se instala nada."
          }
        },
        "fr" : {
          "stringUnit" : {
