    "feed.nothingSubscribedToExport" : {
      "comment" : "What Export OPML says when every feed in the library is unsubscribed, which an export leaves out.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا توجد اشتراكات لتصديرها: كل موجز في مكتبتك غير مشترك فيه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "রপ্তানি করার মতো কোনো সাবস্ক্রিপশন নেই: আপনার লাইব্রেরির প্রতিটি ফিডের সাবস্ক্রিপশন বাতিল করা।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es gibt keine Abonnements zu exportieren: Alle Feeds in deiner Bibliothek sind abbestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are no subscriptions to export: every feed in your library is unsubscribed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay suscripciones que exportar: todos los canales de tu biblioteca tienen la suscripción cancelada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اشتراکی برای صادر کردن نیست: اشتراک همه فیدهای کتابخانه‌ی شما لغو شده است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il n’y a aucun abonnement à exporter : vous êtes désabonné de tous les flux de votre bibliothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "אין הרשמות לייצוא: כל הערוצים בספרייה שלך ללא הרשמה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "निर्यात करने के लिए कोई सदस्यता नहीं है: आपकी लाइब्रेरी के हर फ़ीड की सदस्यता रद्द है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tidak ada langganan untuk diekspor: semua feed di pustaka Anda tidak lagi dilanggan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non ci sono iscrizioni da esportare: hai annullato l’iscrizione a tutti i feed della tua libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "書き出す購読がありません。ライブラリのフィードはすべて購読解除されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "내보낼 구독이 없습니다. 보관함의 모든 피드가 구독 해제되어 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Er zijn geen abonnementen om te exporteren: voor elke feed in je bibliotheek is het abonnement opgezegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie ma subskrypcji do wyeksportowania: każdy kanał w Twojej bibliotece jest bez subskrypcji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não há assinaturas para exportar: todos os feeds da sua biblioteca estão sem assinatura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Нет подписок для экспорта: вы отписались от всех лент в вашей библиотеке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Det finns inga prenumerationer att exportera: alla flöden i ditt bibliotek har avslutad prenumeration."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไม่มีรายการที่ติดตามให้ส่งออก: ทุกฟีดในไลบรารีของคุณเลิกติดตามแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dışa aktarılacak abonelik yok: kitaplığınızdaki her beslemenin aboneliği kaldırılmış."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Немає підписок для експорту: усі стрічки у вашій бібліотеці без підписки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "برآمد کرنے کے لیے کوئی سبسکرپشن نہیں ہے: آپ کی لائبریری کی ہر فیڈ کی سبسکرپشن منسوخ ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không có mục đăng ký nào để xuất: mọi nguồn cấp trong thư viện của bạn đều đã hủy đăng ký."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "没有可导出的订阅：你资料库中的每个订阅源都已取消订阅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "沒有可輸出的訂閱項目：你書庫中的每個訂閱源都已取消訂閱。"
          }
        }
      }
    },
