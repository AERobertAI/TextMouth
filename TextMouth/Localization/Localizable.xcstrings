      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّرت على TextMouth قراءة قائمة القراءة أو إعدادات الفرز في الفهرس غير المقروء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth অপঠনযোগ্য সূচকের পড়ার তালিকা বা সাজানোর সেটিংস পড়তে পারেনি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth konnte die Leseliste und die Sortiereinstellungen im nicht lesbaren Index nicht lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth could not read the reading list or the sort settings in the unreadable index."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no pudo leer la lista de lectura ni los ajustes de orden del índice ilegible."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth نتوانست فهرست مطالعه یا تنظیمات مرتب‌سازی را در نمایه‌ی ناخوانا بخواند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth n’a pas pu lire la liste de lecture ni les réglages de tri dans l’index illisible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth לא הצליח לקרוא את רשימת הקריאה או את הגדרות המיון באינדקס הלא קריא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth अपठनीय इंडेक्स में रीडिंग लिस्ट या क्रम सेटिंग नहीं पढ़ सका।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tidak dapat membaca daftar bacaan atau pengaturan urutan di indeks yang tidak terbaca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non ha potuto leggere l’elenco di lettura né le impostazioni di ordinamento nell’indice illeggibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は読み取れないインデックスのリーディングリストと並べ替えの設定を読み取れませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 읽을 수 없는 색인에서 읽기 목록과 정렬 설정을 읽을 수 없었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kon de leeslijst of de sorteerinstellingen in de onleesbare index niet lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth nie mógł odczytać listy czytelniczej ani ustawień sortowania z nieczytelnego indeksu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não conseguiu ler a lista de leitura nem os ajustes de ordenação no índice ilegível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не удалось прочитать список для чтения и настройки сортировки в нечитаемом индексе."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kunde inte läsa läslistan eller sorteringsinställningarna i det oläsbara indexet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ไม่สามารถดึงรายการอ่านหรือการตั้งค่าการเรียงลำดับจากดัชนีที่อ่านไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth, okunamayan dizindeki okuma listesini veya sıralama ayarlarını okuyamadı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не вдалося прочитати список читання або параметри сортування з нечитабельного індексу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth نہ پڑھے جا سکنے والے انڈیکس میں مطالعے کی فہرست یا ترتیب دینے کی ترتیبات نہیں پڑھ سکا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth không đọc được danh sách đọc hoặc cài đặt sắp xếp trong chỉ mục không đọc được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 无法从不可读的索引中读取阅读列表或排序设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 無法從無法讀取的索引中讀取閱讀列表或排序設定。"
          }
        }
      }
    },
