    },
    "Failed to load book" : {
      "comment" : "Heading of the view shown in place of a book that could not be loaded; the reason follows it."
    },
    "Feeds" : {
      "comment" : "Text of the Folder Settings sheet, which shows one library folder's facts and its listening options. The label of the feeds inside the folder, shown only when it has any.\nText of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. A kind of row as its checkbox names it: \"Books\", \"Episodes\", \"Articles\", or \"Feeds\". This is the case .feeds."
    },
    "Feeds are always listed by title" : {
      "comment" : "Text of the Library window's View pop-up and Go to View. The hint of that one item, which says why there is no other."
    },
    "Feeds are listed by title" : {
      "comment" : "Text of the Library window's View pop-up and Go to View. What VoiceOver says when that item is chosen."
    },
    "File" : {
      "comment" : "Heading of the group of keyboard shortcuts of the File menu's commands in Settings, and the title of the File menu."
    },
    "File format: %@" : {
      "comment" : "What VoiceOver says for the book information sheet's file format row. %@ is the format, such as MP3."
    },
    "File size %@" : {
      "comment" : "Speak Info: the part of a book's full summary that says how big its file is. %@ is a size such as \"2.4 MB\"."
    },
    "Files not read" : {
      "comment" : "Label of the list of files the Compare Libraries comparison could not read."
    },
    "Find" : {
      "comment" : "Name of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Find\".\nTitle of the Find submenu of the Edit menu, which holds the command that searches the whole library."
    },
    "Find Duplicate Books" : {
      "comment" : "Heading of the Find Duplicate Books sheet."
    },
    "Find Duplicates" : {
      "comment" : "Navigation title of the Find Duplicate Books sheet."
    },
    "Finished" : {
      "comment" : "How far a finished book has got, shown and spoken in place of its percent: in the library's row, Speak Info, Where Am I?, and Copy Reading Position.\nText of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. A reading state as the pop-up names it. This is the case .finished.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Terminado"
          }
        }
      }
    },
    "Finished: %@" : {
      "comment" : "VoiceOver announcement as a book ends with no book to follow it. %@ is the book's title. Sentences saying why may follow it.",
