              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld edits, not all saved"
                }
              }
            }
          }
        }
      }
    },
    "%lld episodes" : {
      "comment" : "A count of podcast episodes in a list, counted beside books. %lld is the number of episodes.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld episode"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld episodes"
                }
              }
            }
          }
        }
      }
    },
    "%lld feeds" : {
      "comment" : "A count of podcast and news feeds standing alone, such as a library summary. %lld is the number of feeds.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld feed"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld feeds"
                }
              }
            }
          }
        }
      }
    },
    "%lld hours" : {
      "comment" : "A count of hours inside a duration, such as \"2 hours, 3 minutes\". %lld is the number of hours.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld hour"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld hours"
                }
              }
            }
          }
        }
      }
    },
    "%lld minutes" : {
      "comment" : "A sleep timer's length, as its preset button and the custom minutes' value say it, such as \"10 minutes\". %lld is the number of minutes.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld minute"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld minutes"
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
