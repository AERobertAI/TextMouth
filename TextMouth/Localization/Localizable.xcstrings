    "convertedOriginal.hint" : {
      "comment" : "VoiceOver hint of the switch that keeps the originals of converted audio.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحتفظ بكل ملف صوتي يحوّله الاستيراد، مثل Ogg أو AC-3، داخل حزمة الكتاب."
