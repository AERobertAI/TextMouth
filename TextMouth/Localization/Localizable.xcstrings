    "recording.announceLevelHint" : {
      "comment" : "VoiceOver hint and tooltip of the switch in the Record window that announces the microphone level.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يقرأ VoiceOver المستوى أثناء التسجيل. عبر مكبرات الصوت، قد يُسجَّل كلامه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "রেকর্ড করার সময় VoiceOver লেভেল পড়ে শোনায়। স্পিকারে চালালে এর কণ্ঠ রেকর্ড হয়ে যেতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "VoiceOver spricht den Pegel während der Aufnahme. Über Lautsprecher kann die Sprachausgabe mit aufgenommen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver speaks the level while recording. Over speakers, its speech can be recorded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "VoiceOver dice el nivel mientras se graba. Con altavoces, su voz puede quedar grabada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "VoiceOver سطح را هنگام ضبط می‌گوید. از طریق بلندگو، گفتار آن ممکن است ضبط شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "VoiceOver annonce le niveau pendant l’enregistrement. Avec des haut-parleurs, sa voix peut être enregistrée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "VoiceOver מקריא את הרמה בזמן ההקלטה. דרך רמקולים, ההקראה שלו עלולה להיקלט בהקלטה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "VoiceOver रिकॉर्ड करते समय स्तर बोलता है। स्पीकर पर, उसकी आवाज़ रिकॉर्ड हो सकती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "VoiceOver mengucapkan level saat merekam. Jika memakai speaker, ucapannya dapat ikut terekam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "VoiceOver pronuncia il livello durante la registrazione. Con gli altoparlanti, la sua voce può finire nella registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "録音中は VoiceOver がレベルを読み上げます。スピーカーから出ると、その音声が録音されることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "녹음하는 동안 VoiceOver 음성으로 레벨을 알려 줍니다. 스피커로 들으면 그 음성이 녹음될 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "VoiceOver spreekt het niveau uit tijdens het opnemen. Via luidsprekers kan die spraak worden opgenomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "VoiceOver wypowiada poziom podczas nagrywania. Przez głośniki jego mowa może zostać nagrana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O VoiceOver fala o nível durante a gravação. Em alto-falantes, a fala dele pode ser gravada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "VoiceOver произносит уровень во время записи. Если звук идёт через динамики, эта речь может попасть в запись."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "VoiceOver läser upp nivån under inspelning. Om du använder högtalare kan talet spelas in."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "VoiceOver พูดระดับเสียงขณะบันทึกเสียง หากใช้ลำโพง เสียงพูดอาจถูกบันทึกไปด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "VoiceOver kayıt sırasında düzeyi söyler. Hoparlörlerde bu konuşma kaydedilebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "VoiceOver озвучує рівень під час запису. Через динаміки його мовлення може потрапити в запис."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ریکارڈنگ کے دوران VoiceOver لیول بولتا ہے۔ اسپیکرز پر اس کی آواز ریکارڈ ہو سکتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "VoiceOver đọc mức âm khi ghi âm. Nếu phát qua loa, giọng đọc của nó có thể bị ghi lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "录音时 VoiceOver 会朗读电平。如果使用扬声器，其语音可能被录入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "錄音時 VoiceOver 會朗讀音量。若使用喇叭播放，它的語音可能會被錄進去。"
          }
        }
      }
    },
