    "audioEditor.punchedIn" : {
      "comment" : "Said as a punch-in recording replaces the selection in the audio editor. %1$@ is the length replaced and %2$@ the length of the new recording, both in words.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم استبدال %1$@ بـ%2$@ من التسجيل الجديد، وهو محدّد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ প্রতিস্থাপন করে %2$@ নতুন রেকর্ডিং বসানো হয়েছে, যা নির্বাচিত।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ durch %2$@ neue Aufnahme ersetzt, die ausgewählt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replaced %@ with %@ of new recording, which is selected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se reemplazó un fragmento de %1$@ por %2$@ de grabación nueva, que queda seleccionada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ با %2$@ ضبط جدید جایگزین شد و انتخاب شده است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Remplacé : %1$@ par %2$@ du nouvel enregistrement, sélectionné."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "קטע של %1$@ הוחלף בהקלטה חדשה באורך %2$@, והיא נבחרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ को %2$@ की नई रिकॉर्डिंग से बदला गया, जो चयनित है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ diganti dengan rekaman baru berdurasi %2$@ yang kini terpilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sostituito: %1$@ con %2$@ di nuova registrazione, selezionata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@を%2$@の新しい録音で置き換え、選択しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@을(를) 새 녹음 %2$@(으)로 교체했으며, 선택되어 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ vervangen door %2$@ nieuwe opname, die is geselecteerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zastąpiono fragment (%1$@) nowym nagraniem (%2$@), które jest zaznaczone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Substituído: %1$@ por %2$@ de nova gravação, que está selecionada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Фрагмент длиной %1$@ заменён новой записью длительностью %2$@, она выделена."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ersatte %1$@ med %2$@ ny inspelning, som är markerad."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "แทนที่ %1$@ ด้วยการบันทึกเสียงใหม่ยาว %2$@ แล้ว และเลือกไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ yerine %2$@ uzunluğunda yeni kayıt kondu ve seçili."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Фрагмент тривалістю %1$@ замінено новим записом тривалістю %2$@, його виділено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ کی جگہ %2$@ کی نئی ریکارڈنگ آ گئی، جو منتخب ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đã thay thế %1$@ bằng %2$@ bản ghi âm mới, đang được chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "已将 %1$@替换为 %2$@的新录音，并已选中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "已用 %2$@的新錄音取代 %1$@，並已選取新錄音。"
          }
        }
      }
    },
    "audioEditor.quitExplanation" : {
      "comment" : "Explains the question about the audio editor's unsaved edits asked as TextMouth quits: what Discard and Cancel do.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يجري إنهاء TextMouth وصوت الكتاب لا يحتوي على هذه التعديلات بعد. يتراجع “تجاهل” عنها؛ وفي المرة التالية التي تحرّر فيها هذا الكتاب، تعيدها “إعادة” ما لم تُجرِ تعديلًا آخر. يُبقي “إلغاء” TextMouth مفتوحًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth বন্ধ হচ্ছে এবং বইয়ের অডিওতে এই সম্পাদনাগুলো এখনও নেই। “বর্জন করুন” বেছে নিলে সেগুলো পূর্বাবস্থায় ফেরে; পরের বার এই বই সম্পাদনা করলে, আরেকটি সম্পাদনা না করা পর্যন্ত “পুনরায় করুন” বেছে নিলে সেগুলো ফিরে আসে। “বাতিল করুন” বেছে নিলে TextMouth খোলা থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth wird beendet, und das Audio des Buchs enthält diese Bearbeitungen noch nicht. „Verwerfen“ widerruft sie; wenn du dieses Buch das nächste Mal bearbeitest, bringt „Wiederholen“ sie zurück, solange du nichts Neues bearbeitest. „Abbrechen“ lässt TextMouth geöffnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth is quitting and the book's audio doesn't hold these edits yet. Discard undoes them; next time you edit this book, Redo brings them back until you make another edit. Cancel keeps TextMouth open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth se está cerrando y el audio del libro aún no contiene estas ediciones. Descartar las deshace; la próxima vez que edites este libro, Rehacer las recupera hasta que hagas otra edición. Cancelar mantiene TextMouth abierto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth در حال خروج است و صدای کتاب هنوز این ویرایش‌ها را ندارد. «دور انداختن» آن‌ها را واگرد می‌کند؛ دفعه بعد که این کتاب را ویرایش کنید، «انجام مجدد» آن‌ها را برمی‌گرداند، تا وقتی که ویرایش دیگری انجام دهید. «لغو» TextMouth را باز نگه می‌دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth se ferme et l’audio du livre ne contient pas encore ces modifications. Abandonner les annule ; la prochaine fois que vous modifiez ce livre, Rétablir les restaure jusqu’à ce que vous fassiez une autre modification. Annuler garde TextMouth ouvert."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth נסגר והשמע של הספר עדיין לא כולל את העריכות האלה. “השלך” מבטל אותן; בפעם הבאה שתערוך את הספר, “בצע שוב” יחזיר אותן עד שתבצע עריכה נוספת. “ביטול” משאיר את TextMouth פתוח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth बंद हो रहा है और पुस्तक के ऑडियो में ये संपादन अभी नहीं हैं। “त्यागें” उन्हें पूर्ववत करता है; अगली बार इस पुस्तक को संपादित करने पर, कोई दूसरा संपादन करने तक “फिर से करें” उन्हें वापस ले आता है। “रद्द करें” TextMouth को खुला रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth akan keluar dan audio buku belum memuat edit ini. Pilih Buang untuk mengurungkannya; saat Anda mengedit buku ini lagi, pilih Ulangi untuk mengembalikannya sebelum Anda melakukan edit lain. Pilih Batal agar TextMouth tetap terbuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth sta per chiudersi e l’audio del libro non contiene ancora queste modifiche. Con Scarta vengono annullate; la prossima volta che modifichi questo libro, con Ripeti tornano finché non fai un’altra modifica. Con Annulla TextMouth resta aperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth を終了しようとしていますが、ブックのオーディオにはこれらの編集がまだ含まれていません。「破棄」で取り消します。次回このブックを編集するときは、別の編集をするまで「やり直す」で復元できます。「キャンセル」で TextMouth を開いたままにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth를 종료하는 중이며 책의 오디오에는 아직 이 편집이 들어 있지 않습니다. 폐기하면 편집이 취소되며, 다음에 이 책을 편집할 때 다른 편집을 하기 전까지 다시 실행으로 되돌릴 수 있습니다. 취소하면 TextMouth가 열린 채로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth wordt afgesloten en de audio van het boek bevat deze bewerkingen nog niet. Gooi weg maakt ze ongedaan; de volgende keer dat je dit boek wijzigt, brengt Herhaal ze terug tot je een nieuwe bewerking maakt. Annuleer houdt TextMouth open."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth się zamyka, a dźwięk książki nie zawiera jeszcze tych edycji. Odrzuć cofa je; przy następnej edycji tej książki Ponów przywróci je, dopóki nie wprowadzisz kolejnej edycji. Anuluj pozostawia TextMouth otwarty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth está sendo encerrado e o áudio do livro ainda não contém estas edições. Descartar desfaz essas edições; na próxima vez que você editar este livro, Refazer pode trazê-las de volta enquanto você não fizer outra edição. Cancelar mantém o TextMouth aberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth завершает работу, а в аудио книги этих правок ещё нет. «Отбросить» отменяет их; при следующем изменении этой книги «Повторить» вернёт их, пока вы не сделаете другую правку. «Отменить» оставляет TextMouth открытым."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth avslutas och bokens ljud innehåller inte de här redigeringarna än. Kassera ångrar dem; nästa gång du redigerar den här boken kan Gör om återställa dem tills du gör en ny redigering. Avbryt håller TextMouth öppet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth กำลังจะออก และเสียงของหนังสือยังไม่มีการแก้ไขเหล่านี้ คำสั่ง ทิ้ง จะเลิกทำการแก้ไข และเมื่อแก้ไขหนังสือเล่มนี้ครั้งหน้า คำสั่ง ทำซ้ำ จะนำกลับมาได้จนกว่าคุณจะแก้ไขใหม่ ส่วนคำสั่ง ยกเลิก จะให้ TextMouth เปิดอยู่ต่อไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kapanıyor ve kitabın sesinde bu düzenlemeler henüz yok. At düğmesi bunları geri alır; bu kitabı bir sonraki düzenlediğinizde, başka bir düzenleme yapana kadar Yinele bunları geri getirir. Vazgeç düğmesi TextMouth'u açık tutar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth закривається, а аудіо книги ще не містить цих правок. «Відхилити» скасовує їх; наступного разу, коли ви редагуватимете цю книгу, «Повторити» поверне їх, доки ви не зробите іншу правку. «Скасувати» залишає TextMouth відкритим."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth بند ہو رہا ہے اور کتاب کے آڈیو میں یہ ترامیم ابھی نہیں ہیں۔ “ترک کریں” انہیں کالعدم کرتا ہے؛ اس کتاب میں اگلی بار ترمیم کرتے وقت، دوسری ترمیم کرنے تک “دوبارہ کریں” انہیں واپس لے آتا ہے۔ “منسوخ کریں” TextMouth کو کھلا رکھتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth đang thoát và âm thanh của sách chưa có các chỉnh sửa này. Nút Bỏ sẽ hoàn tác chúng; lần sau khi bạn sửa sách này, Làm lại sẽ khôi phục chúng cho đến khi bạn sửa lần khác. Nút Hủy sẽ giữ TextMouth mở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 正在退出，图书的音频尚未包含这些编辑。“放弃”会将其撤销；下次编辑此图书时，“重做”可将其恢复，直到你进行另一项编辑。“取消”会让 TextMouth 保持打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 即將結束，而書籍的音訊尚未包含這些編輯。「捨棄」會還原這些編輯；下次編輯這本書時，在你進行其他編輯之前，可用「重做」恢復它們。「取消」會讓 TextMouth 保持打開。"
          }
        }
      }
    },
    "audioEditor.quitWhileRecording" : {
      "comment" : "Said in an audio editor when TextMouth can't quit because a punch-in records there. %@ is the book's title. \"Clear Selection\" is the name of a command.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” قيد التسجيل. أوقفه أو تجاهله باستخدام “إلغاء التحديد”، ثم أنهِ TextMouth."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” রেকর্ড করছে। এটি থামান, অথবা “নির্বাচন সাফ করুন” দিয়ে বর্জন করুন, তারপর প্রস্থান করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%@“ nimmt auf. Stoppe oder verwirf die Aufnahme mit „Auswahl aufheben“ und beende dann TextMouth."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is recording. Stop or discard it with Clear Selection, then quit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” está grabando. Detén la grabación o descártala con Quitar selección y luego sal de TextMouth."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%@» در حال ضبط است. آن را متوقف کنید، یا با «لغو انتخاب» دور بیندازید، سپس خارج شوید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "« %@ » est en cours d’enregistrement. Arrêtez-le ou abandonnez-le avec Désélectionner, puis quittez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” מקליט. עצור או השלך את ההקלטה באמצעות “נקה בחירה”, ואז צא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” में रिकॉर्डिंग हो रही है। “रोकें” से रोकें या “चयन हटाएँ” से त्याग दें, फिर TextMouth छोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” sedang merekam. Hentikan atau buang dengan Kosongkan Pilihan, lalu keluar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "In “%@” è in corso una registrazione. Interrompila o scartala con Deseleziona, poi esci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」は録音中です。停止するか、「選択解除」で破棄してから、終了してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@”이(가) 녹음 중입니다. 중지하거나 선택 해제로 폐기한 다음 종료하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” neemt op. Stop de opname of gooi die weg met Deselecteer en sluit TextMouth daarna af."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "W edytorze książki „%@” trwa nagrywanie. Zatrzymaj je albo odrzuć poleceniem Odznacz, a potem zakończ działanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” está gravando. Pare ou descarte com Desmarcar seleção e depois saia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В редакторе аудио «%@» идёт запись. Остановите её или отбросьте командой «Снять выделение», затем завершите работу TextMouth."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "”%@” spelar in. Stoppa eller kassera inspelningen med Rensa markering och avsluta sedan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” กำลังบันทึกเสียง ให้หยุด หรือทิ้งโดยใช้คำสั่ง ล้างส่วนที่เลือก แล้วจึงออก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” kayıt yapıyor. Durdurun veya Seçimi Kaldır ile atın, sonra çıkın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Триває запис «%@». Зупиніть його або відхиліть командою «Зняти виділення», потім завершіть TextMouth."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” ریکارڈ کر رہی ہے۔ اسے روکیں یا “انتخاب صاف کریں” سے ترک کریں، پھر TextMouth چھوڑیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” đang ghi âm. Hãy dừng hoặc bỏ bản ghi bằng Bỏ chọn, rồi thoát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@”正在录音。请先停止录音，或用“取消选择”放弃录音，然后再退出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」正在錄音。請先停止，或用「取消選取」捨棄錄音，然後再結束。"
          }
        }
      }
    },
    "audioEditor.quitWhileWorking" : {
      "comment" : "Said in an audio editor when TextMouth can't quit because its work is under way. %@ is the book's title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” لا يزال قيد العمل. أنهِ TextMouth بعد اكتمال التغيير."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” এখনও কাজ করছে। পরিবর্তন শেষ হলে প্রস্থান করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%@“ arbeitet noch. Beende TextMouth, sobald die Änderung abgeschlossen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is still working. Quit once the change is done."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” sigue trabajando. Sal de TextMouth cuando termine el cambio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%@» هنوز در حال کار است. پس از پایان تغییر خارج شوید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "« %@ » est encore en cours de traitement. Quittez une fois la modification terminée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” עדיין עובד. צא לאחר שהשינוי יסתיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” में अभी काम चल रहा है। बदलाव पूरा होने पर TextMouth छोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” masih memproses. Keluar setelah perubahan selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "In “%@” è ancora in corso una modifica. Esci quando è finita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」は処理中です。変更が終わってから終了してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@”이(가) 아직 작업 중입니다. 변경이 끝난 후 종료하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” is nog bezig. Sluit TextMouth af zodra de wijziging klaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "W edytorze książki „%@” wciąż trwa praca. Zakończ działanie po zakończeniu zmiany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” ainda está processando. Saia quando a alteração terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В редакторе аудио «%@» ещё выполняется изменение. Завершите работу TextMouth, когда оно закончится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "”%@” arbetar fortfarande. Avsluta när ändringen är klar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” ยังทำงานอยู่ ให้ออกหลังจากเปลี่ยนแปลงเสร็จแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” hâlâ çalışıyor. Değişiklik bitince çıkın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Редактор аудіо для «%@» ще працює. Завершіть TextMouth, коли зміну буде виконано."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” پر ابھی کام جاری ہے۔ تبدیلی مکمل ہونے پر TextMouth چھوڑیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” vẫn đang xử lý. Hãy thoát sau khi thay đổi xong."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@”仍在处理。请在更改完成后再退出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」仍在處理中。請在更改完成後再結束。"
          }
        }
      }
    },
    "audioEditor.readerStillOpen" : {
      "comment" : "Said when a book's reader did not close, so the audio editor can't open. %@ is the book's title. \"Edit Audio\" is the name of the command.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ مفتوح في القارئ. أغلقه، ثم اختر “تحرير الصوت” مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ একটি রিডারে খোলা আছে। সেটি বন্ধ করুন, তারপর আবার “অডিও সম্পাদনা করুন” বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ist in einer Leseansicht geöffnet. Schließe sie und wähle dann erneut „Audio bearbeiten“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is open in a reader. Close it, then choose Edit Audio again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ está abierto en un lector. Ciérralo y elige Editar audio de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ در یک کتاب‌خوان باز است. آن را ببندید، سپس دوباره «ویرایش صدا» را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un lecteur est ouvert sur %@. Fermez-le, puis choisissez à nouveau Modifier l’audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ פתוח בקורא. סגור אותו ולאחר מכן בחר שוב “ערוך שמע”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ को किसी रीडर में खोला गया है। इसे बंद करें, फिर “ऑडियो संपादित करें” दोबारा चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ terbuka di pembaca. Tutup pembacanya, lalu pilih Edit Audio lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il libro %@ è aperto in un lettore. Chiudilo, poi scegli di nuovo Modifica audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@はリーダで開かれています。リーダを閉じてから、もう一度「オーディオを編集」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@이(가) 리더에서 열려 있습니다. 리더를 닫은 다음 오디오 편집을 다시 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ is geopend in een lezer. Sluit de lezer en kies dan opnieuw Wijzig audio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Książka %@ jest otwarta w czytniku. Zamknij ją, a potem ponownie wybierz Edytuj dźwięk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ está aberto em um leitor. Feche-o e escolha Editar áudio de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Книга «%@» открыта в окне чтения. Закройте его и снова выберите «Изменить аудио»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Boken %@ är öppen i en läsare. Stäng läsaren och välj Redigera ljud igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ เปิดอยู่ในตัวอ่าน ให้ปิดก่อน แล้วเลือก แก้ไขเสียง อีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ bir okuyucuda açık. Okuyucuyu kapatın, sonra Sesi Düzenle'yi yeniden seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ відкрито у вікні читання. Закрийте його й знову виберіть «Редагувати аудіо»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ریڈر میں کھلی ہے۔ اسے بند کریں، پھر دوبارہ “آڈیو میں ترمیم کریں” منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ đang mở trong trình đọc. Hãy đóng nó, rồi chọn lại Sửa âm thanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@”已在阅读器中打开。请将其关闭，然后再次选取“编辑音频”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」已在閱讀器中打開。請先關閉，再重新選擇「編輯音訊」。"
          }
        }
      }
    },
    "audioEditor.recordingInserted" : {
      "comment" : "Said as a punch-in recording is inserted at the cursor in the audio editor. %@ is its length in words.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم إدراج %@ من التسجيل الجديد، وهو محدّد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ নতুন রেকর্ডিং সন্নিবেশ করা হয়েছে, যা নির্বাচিত।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ neue Aufnahme eingefügt und ausgewählt."
          }
        },
        "en" : {
