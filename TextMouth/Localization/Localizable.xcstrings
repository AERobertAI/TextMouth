          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Хранит каждый аудиофайл, который импорт преобразует (например, Ogg или AC-3), внутри пакета книги."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Зберігає в пакеті книги кожен аудіофайл, який імпорт перетворює, як-от Ogg або AC-3."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "将导入时转换的每个音频文件（如 Ogg 或 AC-3）保留在图书包中。"
          }
        }
      }
    },
    "Keeps only the selection." : {
      "comment" : "Hint of the audio editor's Trim to Selection button.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
