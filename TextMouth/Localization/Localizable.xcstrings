      }
    },
    "shortcutsSettings.recordingKeyEquivalentLabel" : {
      "comment" : "VoiceOver label of a menu command's key button while it waits for the new key: the shortcut of a menu command must be a key held with the Command or Control key.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جارٍ تسجيل الاختصار. اضغط مفتاحًا مع Command أو Control."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "শর্টকাট রেকর্ড হচ্ছে। কমান্ড বা কন্ট্রোল-সহ একটি কী চাপুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kurzbefehl wird aufgenommen. Drücke eine Taste mit Befehl oder Control."
          }
        },
        "en" : {
