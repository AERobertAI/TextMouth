            "value" : "O TextMouth fechou ao abrir %@, então ele não foi reaberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth закрылся при открытии книги «%@», поэтому не открывает её снова."
          }
        }
      }
    },
    "TextMouth could not check this Mac's braille table “%@”: %@. Try again." : {
      "comment" : "Why a braille translation was refused: one of this Mac's braille tables could not be checked. %1$@ is the table's name as macOS gives it and %2$@ the reason, which stays English.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth konnte die Brailletabelle „%1$@“ dieses Mac nicht prüfen: %2$@. Versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TextMouth could not check this Mac's braille table “%1$@”: %2$@. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
