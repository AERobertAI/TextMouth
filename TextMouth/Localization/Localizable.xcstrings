    "audioEditingSettings.explanation.delete" : {
      "comment" : "Explains Storage settings' Original audio choice Don't keep: no original is kept, so saved edits can't be undone.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يُحتفظ بأصل: تغيّر التعديلات الصوت في مكانه، ولا يمكن التراجع عن التعديلات المحفوظة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "মূল অডিও রাখা হয় না: সম্পাদনা অডিওটিকেই বদলে দেয়, এবং সংরক্ষিত সম্পাদনা পূর্বাবস্থায় ফেরানো যায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es wird kein Original aufbewahrt: Bearbeitungen ändern das Audio direkt, und gesicherte Bearbeitungen können nicht widerrufen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No original is kept: edits change the audio in place, and saved edits can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se conserva ningún original: las ediciones cambian el audio directamente, y las ediciones guardadas no se pueden deshacer."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صدای اصلی نگه داشته نمی‌شود: ویرایش‌ها خود صدا را تغییر می‌دهند و ویرایش‌های ذخیره شده را نمی‌توان واگرد کرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucun original n’est conservé : les modifications changent l’audio sur place, et les modifications enregistrées ne peuvent pas être annulées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא נשמר מקור: העריכות משנות את השמע במקומו, ואי אפשר לבטל עריכות שנשמרו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कोई मूल ऑडियो नहीं रखा जाता: संपादन ऑडियो को उसी जगह बदलते हैं, और सहेजे गए संपादन पूर्ववत नहीं किए जा सकते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Audio asli tidak disimpan: edit mengubah audio secara langsung, dan edit yang sudah tersimpan tidak dapat diurungkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non viene conservato alcun originale: le modifiche cambiano direttamente l’audio e quelle salvate non si possono annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "元のオーディオは保持されません。編集はオーディオをその場で変更し、保存済みの編集は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "원본을 보관하지 않습니다. 편집하면 오디오가 그 자리에서 바뀌며, 저장된 편집은 취소할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Er wordt geen origineel bewaard: bewerkingen wijzigen de audio rechtstreeks en bewaarde bewerkingen kunnen niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie zachowano oryginału: edycje zmieniają dźwięk w miejscu, a zachowanych edycji nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nenhum original é mantido: as edições alteram o áudio no próprio arquivo, e as edições salvas não podem ser desfeitas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Оригинал не хранится: правки изменяют аудио на месте, а сохранённые правки нельзя отменить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Inget original behålls: redigeringar ändrar ljudet direkt, och sparade redigeringar kan inte ångras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไม่ได้เก็บต้นฉบับ: การแก้ไขจะเปลี่ยนเสียงโดยตรง และเลิกทำการแก้ไขที่บันทึกแล้วไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Orijinal saklanmaz: düzenlemeler sesi yerinde değiştirir ve kaydedilen düzenlemeler geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Оригінал не зберігається: правки змінюють аудіо на місці, а збережені правки скасувати не можна."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کوئی اصل نہیں رکھا جاتا: ترامیم آڈیو کو اسی میں بدل دیتی ہیں، اور محفوظ شدہ ترامیم کالعدم نہیں کی جا سکتیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không giữ bản gốc nào: các chỉnh sửa thay đổi âm thanh tại chỗ, và không thể hoàn tác các chỉnh sửa đã lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "没有保留原始音频：编辑会直接更改音频，已存储的编辑无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "不保留原始檔：編輯會直接更改音訊，已儲存的編輯無法還原。"
          }
        }
      }
    },
