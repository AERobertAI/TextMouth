    "Books stay on this Mac until you remove their downloads or macOS needs space." : {
      "comment" : "Second sentence of what moving the library into a cloud folder means.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bücher bleiben auf diesem Mac, bis du ihre Downloads entfernst oder macOS Speicherplatz braucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los libros permanecen en esta Mac hasta que quites sus descargas o macOS necesite espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
