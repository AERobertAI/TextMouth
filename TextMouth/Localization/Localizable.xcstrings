        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "این آرشیو ZIP با گذرواژه محافظت شده است. خواندن %@ ممکن نبود."
          }
        },
        "fr" : {
          "stringUnit" : {
