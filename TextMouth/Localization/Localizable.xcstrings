    "speechRefusal.markupGuard.character" : {
      "comment" : "A line of the speech refusal report: the markup guard silenced every angle bracket between two characters. %1$@ and %2$@ are the first and last character offsets in the spoken text, written without digit grouping.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "حارس الترميز: صارم، كل قوس زاوية مكتوم، من الحرف %1$@ إلى %2$@ من النص المنطوق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "মার্কআপ গার্ড: কঠোর, প্রতিটি অ্যাঙ্গেল ব্র্যাকেট নীরব, পড়ে শোনানো টেক্সটের %1$@ থেকে %2$@ নম্বর অক্ষর পর্যন্ত।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Markup-Schutz: streng, jede spitze Klammer stumm, von Zeichen %1$@ bis %2$@ des gesprochenen Textes."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markup guard: strict, every angle bracket silent, from character %@ to %@ of the spoken text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Protección de marcado: estricta, todos los corchetes angulares en silencio, del carácter %1$@ al %2$@ del texto hablado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "محافظ نشانه‌گذاری: سخت‌گیرانه، هر براکت زاویه‌ای بی‌صدا، از نویسه %1$@ تا %2$@ متن گفته‌شده."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Garde-fou du balisage : strict, chaque chevron est silencieux, du caractère %1$@ au caractère %2$@ du texte lu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הגנת סימון: מחמירה, כל סוגר זוויתי מושתק, מתו %1$@ עד תו %2$@ בטקסט המוקרא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "मार्कअप गार्ड: सख़्त, हर ऐंगल ब्रैकेट मौन, बोले गए टेक्स्ट के वर्ण %1$@ से %2$@ तक।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pelindung markup: ketat, setiap tanda kurung sudut disenyapkan, dari karakter %1$@ hingga %2$@ pada teks yang diucapkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Protezione del markup: rigorosa, ogni parentesi angolare silenziata, dal carattere %1$@ al %2$@ del testo letto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "マークアップガード：厳格。読み上げテキストの%1$@文字目から%2$@文字目までの山かっこを、すべて読み上げません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "마크업 보호: 엄격, 음성으로 읽는 텍스트의 문자 %1$@에서 %2$@까지 모든 꺾쇠괄호를 읽지 않음."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Opmaakbeveiliging: streng, geen enkele punthaak wordt uitgesproken, van teken %1$@ tot %2$@ van de gesproken tekst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ochrona znaczników: ścisła, każdy nawias ostry wyciszony, od znaku %1$@ do %2$@ czytanego tekstu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Proteção de marcação: rigorosa, todo colchete angular silenciado, do caractere %1$@ ao %2$@ do texto falado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Защита разметки: строгая, ни одна угловая скобка не произносится, с символа %1$@ по %2$@ озвучиваемого текста."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Märkningsskydd: strikt, alla vinkelparenteser tystas, från tecken %1$@ till %2$@ i den upplästa texten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตัวป้องกันมาร์กอัป: แบบเข้มงวด ปิดเสียงเครื่องหมายวงเล็บแหลมทุกตัว ตั้งแต่อักขระ %1$@ ถึง %2$@ ของข้อความที่อ่านออกเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "İşaretleme koruması: katı, her açılı ayraç sessiz, konuşulan metnin %1$@. ile %2$@. karakterleri arasında."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Захист розмітки: суворий, усі кутові дужки мовчать, від символу %1$@ до %2$@ озвученого тексту."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مارک اپ گارڈ: سخت، ہر زاویہ بریکٹ خاموش، بولے گئے متن کے حرف %1$@ سے %2$@ تک۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bảo vệ đánh dấu: nghiêm ngặt, mọi dấu ngoặc nhọn đều không được đọc, từ ký tự %1$@ đến %2$@ của văn bản được đọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "标记防护：严格，朗读文本第 %1$@ 到 %2$@ 个字符之间的每个尖括号都不发声。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "標記防護：嚴格，所有角括號皆靜音，範圍為朗讀文字的第 %1$@ 到 %2$@ 個字元。"
          }
        }
      }
    },
