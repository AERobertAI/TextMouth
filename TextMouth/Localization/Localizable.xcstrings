          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este arquivo de quadrinhos contém mais do que as %@ imagens que o TextMouth lê."
          }
        }
      }
    },
    "This comic book archive holds no pictures TextMouth can read." : {
      "comment" : "Why a comic book archive was refused at import: it holds no picture TextMouth reads.",
      "localizations" : {
