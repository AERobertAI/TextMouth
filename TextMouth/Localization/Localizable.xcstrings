                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld second"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld seconds"
                }
              }
            }
          }
        }
      }
    },
    "%lld words a minute" : {
      "comment" : "A text book's reading speed. %lld is the number of words read in a minute, such as 500.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld word a minute"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld words a minute"
                }
              }
            }
          }
        }
      }
    },
    "%lld words per minute" : {
      "comment" : "What VoiceOver says for the playback bar's speed of a text book. %lld is the number of words read in a minute.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld word per minute"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld words per minute"
                }
              }
            }
          }
        }
      }
    },
    "%lld words per minute, book-specific speed" : {
      "comment" : "What VoiceOver says for the reader toolbar's speed caption when this book has a speed of its own. %lld is the number of words read in a minute.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld word per minute, book-specific speed"
                }
