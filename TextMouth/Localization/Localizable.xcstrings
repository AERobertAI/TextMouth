                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "No tiene encabezados, así que la lista de contenido tiene %lld entrada para sus capítulos y los lugares que marca."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "No tiene encabezados, así que la lista de contenido tiene %lld entradas para sus capítulos y los lugares que marca."
                }
              }
            }
          }
        }
      }
    },
    "It has no headings, so the contents list has one entry for the whole book." : {
      "comment" : "A sentence of the accessibility summary written into an exported EPUB: the book has no headings and its contents list has one entry.",
      "localizations" : {
        "es" : {
