    "audioEdit.undoLimit.originalDeleted" : {
      "comment" : "Said when Undo can't reach edits already saved, and the hint of a dimmed Undo in the audio editor: the book's original audio was deleted. %@ is the date it was deleted, in long form.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "حُذف الصوت الأصلي في %@، لذا لا يمكن التراجع عن التعديلات المحفوظة قبل ذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "মূল অডিও %@ তারিখে মুছে ফেলা হয়েছে, তাই তার আগে সংরক্ষিত সম্পাদনা পূর্বাবস্থায় ফেরানো যায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Originalaudio wurde am %@ gelöscht, daher können davor gesicherte Bearbeitungen nicht widerrufen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The original audio was deleted on %@, so edits saved before then can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El audio original se eliminó el %@, así que las ediciones guardadas antes no se pueden deshacer."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صدای اصلی در %@ حذف شد، پس ویرایش‌هایی که پیش از آن ذخیره شده‌اند را نمی‌توان واگرد کرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’audio original a été supprimé le %@, donc les modifications enregistrées avant cette date ne peuvent pas être annulées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "השמע המקורי נמחק בתאריך %@, ולכן אי אפשר לבטל עריכות שנשמרו לפני כן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "मूल ऑडियो %@ को मिटा दिया गया था, इसलिए उससे पहले सहेजे गए संपादन पूर्ववत नहीं किए जा सकते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Audio asli dihapus pada %@, sehingga edit yang disimpan sebelumnya tidak dapat diurungkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’audio originale è stato eliminato il %@, quindi le modifiche salvate prima di allora non si possono annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "元のオーディオは%@に削除されたため、それ以前に保存した編集は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "원본 오디오가 %@에 삭제되어, 그 전에 저장한 편집은 취소할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De originele audio is verwijderd op %@, dus eerder bewaarde bewerkingen kunnen niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Oryginalny dźwięk został usunięty dnia %@, więc edycji zachowanych przed tą datą nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O áudio original foi excluído em %@, então as edições salvas antes disso não podem ser desfeitas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Исходное аудио удалено %@, поэтому правки, сохранённые до этого, нельзя отменить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Originalljudet raderades den %@, så redigeringar som sparades före dess kan inte ångras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ลบเสียงต้นฉบับเมื่อ %@ จึงเลิกทำการแก้ไขที่บันทึกก่อนหน้านั้นไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Orijinal ses %@ tarihinde silindi, bu yüzden o tarihten önce kaydedilen düzenlemeler geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Оригінальне аудіо видалено %@, тому правки, збережені до цього, скасувати не можна."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اصل آڈیو %@ کو حذف کر دیا گیا تھا، اس لیے اس سے پہلے محفوظ کی گئی ترامیم کالعدم نہیں کی جا سکتیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Âm thanh gốc đã bị xóa vào ngày %@, nên không thể hoàn tác các chỉnh sửa đã lưu trước đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "原始音频已于 %@ 删除，因此在此之前存储的编辑无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "原始音訊已於 %@ 刪除，因此在那之前儲存的編輯無法還原。"
          }
        }
      }
    },
