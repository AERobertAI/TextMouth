    "libraryIndexRecovery.quit" : {
      "comment" : "What Quit TextMouth does on the library index recovery sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ينهي TextMouth دون كتابة فهرس المكتبة، لتتمكن من استعادة الملف وفتح TextMouth مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "লাইব্রেরি সূচক না লিখেই TextMouth থেকে প্রস্থান করে, যাতে আপনি ফাইলটি পুনরুদ্ধার করে আবার TextMouth খুলতে পারেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beendet TextMouth, ohne den Bibliotheksindex zu schreiben, damit du die Datei wiederherstellen und TextMouth erneut öffnen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quits TextMouth without writing the library index, so you can restore the file and open TextMouth again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sale de TextMouth sin escribir el índice de la biblioteca, para que puedas restaurar el archivo y abrir TextMouth de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بدون نوشتن نمایه‌ی کتابخانه از TextMouth خارج می‌شود تا بتوانید فایل را بازیابی کنید و دوباره TextMouth را باز کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quitte TextMouth sans écrire l’index de la bibliothèque, pour que vous puissiez restaurer le fichier et rouvrir TextMouth."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "יוצא מ-TextMouth בלי לכתוב את אינדקס הספרייה, כדי שאפשר יהיה לשחזר את הקובץ ולפתוח את TextMouth שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लाइब्रेरी इंडेक्स लिखे बिना TextMouth छोड़ता है, ताकि आप फ़ाइल पुनर्स्थापित करके TextMouth फिर से खोल सकें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Keluar dari TextMouth tanpa menulis indeks pustaka, sehingga Anda dapat memulihkan file dan membuka TextMouth lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esce da TextMouth senza scrivere l’indice della libreria, così puoi ripristinare il file e aprire di nuovo TextMouth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ライブラリインデックスを書き込まずに TextMouth を終了するので、ファイルを復元してから TextMouth をもう一度開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관함 색인을 쓰지 않고 TextMouth를 종료하므로, 파일을 복원한 다음 TextMouth를 다시 열 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sluit TextMouth af zonder de bibliotheekindex te schrijven, zodat je het bestand kunt terugzetten en TextMouth opnieuw kunt openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kończy TextMouth bez zapisywania indeksu biblioteki, aby można było przywrócić plik i ponownie otworzyć TextMouth."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Encerra o TextMouth sem gravar o índice da biblioteca, para você restaurar o arquivo e abrir o TextMouth de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Завершает TextMouth, не записывая индекс библиотеки, чтобы вы могли восстановить файл и снова открыть TextMouth."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Avslutar TextMouth utan att skriva biblioteksindexet, så att du kan återställa filen och öppna TextMouth igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ออกจาก TextMouth โดยไม่เขียนดัชนีไลบรารี เพื่อให้กู้คืนไฟล์แล้วเปิด TextMouth อีกครั้งได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitaplık dizinini yazmadan TextMouth'tan çıkar; böylece dosyayı geri yükleyip TextMouth'u yeniden açabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Завершує TextMouth, не записуючи індекс бібліотеки, щоб ви могли відновити файл і знову відкрити TextMouth."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لائبریری انڈیکس لکھے بغیر TextMouth چھوڑ دیتا ہے، تاکہ آپ فائل بحال کر کے TextMouth دوبارہ کھول سکیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thoát TextMouth mà không ghi chỉ mục thư viện, để bạn khôi phục tệp và mở lại TextMouth."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "退出 TextMouth，不写入资料库索引，以便你恢复该文件后再次打开 TextMouth。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "結束 TextMouth，不寫入書庫索引，讓你可以還原檔案後再次打開 TextMouth。"
          }
        }
      }
    },
