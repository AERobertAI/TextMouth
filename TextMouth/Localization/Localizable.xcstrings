    },
    "Asks first, then gives the library a new identity and opens it." : {
      "comment" : "VoiceOver hint of the button that gives the library a new identity file.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يسأل أولًا، ثم يمنح المكتبة هوية جديدة ويفتحها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আগে জিজ্ঞাসা করে, তারপর লাইব্রেরিকে একটি নতুন পরিচয় দেয় ও খোলে।"
          }
        },
        "de" : {
          "stringUnit" : {
