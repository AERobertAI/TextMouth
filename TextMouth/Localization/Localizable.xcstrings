    "WMV video" : {
      "comment" : "The name of the Windows Media Video format, as people say it. Inside sentences about importing a file of that format."
    },
    "Wait until the export ends" : {
      "comment" : "What to do before trying again, when a book's download is being exported and cannot be deleted or replaced. Written without a full stop."
    },
    "Wait until the transcription ends, or cancel it" : {
      "comment" : "What to do before trying again, when a book's download is being transcribed and cannot be deleted or replaced. Written without a full stop."
    },
    "Waiting for Sync" : {
      "comment" : "Note in the library list: the book's files have not arrived on this Mac from the sync service yet."
    },
    "Waiting for audio editing to finish..." : {
      "comment" : "Progress text while a move of the library waits for audio editing to finish first."
    },
