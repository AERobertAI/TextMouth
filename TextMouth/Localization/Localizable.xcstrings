          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apre un selettore di file per importare libri in qualsiasi formato letto da TextMouth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ファイルピッカーを開き、TextMouth が対応するあらゆる形式のブックを読み込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 읽을 수 있는 모든 포맷의 책을 가져오기 위해 파일 선택 창을 엽니다."
          }
