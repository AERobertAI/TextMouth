    },
    "Saves the temporary library as the new index, with the reading list and the sort settings TextMouth could read." : {
      "comment" : "First sentence of what Rebuild Library Index does on the library index recovery sheet.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحفظ المكتبة المؤقتة كفهرس جديد، مع قائمة القراءة وإعدادات الفرز التي استطاع TextMouth قراءتها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "অস্থায়ী লাইব্রেরিকে নতুন সূচক হিসেবে সংরক্ষণ করে, সঙ্গে TextMouth-এর পড়তে পারা পড়ার তালিকা ও বাছাইয়ের সেটিংস।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sichert die temporäre Bibliothek als neuen Index, mit der Leseliste und den Sortiereinstellungen, die TextMouth lesen konnte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Guarda la biblioteca temporal como el índice nuevo, con la lista de lectura y los ajustes de orden que TextMouth pudo leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Enregistre la bibliothèque temporaire comme nouvel index, avec la liste de lecture et les réglages de tri que TextMouth a pu lire."
