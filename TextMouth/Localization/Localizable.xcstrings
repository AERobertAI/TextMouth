        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Incolla e adatta stile"
          }
        }
      }
    },
    "Paste from Clipboard" : {
      "comment" : "Button of the New Book from Text sheet that replaces the text with the text on the system clipboard.",
