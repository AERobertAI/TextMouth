    "libraryIndexRecovery.rebuild.cannot" : {
      "comment" : "Last sentence of what Rebuild Library Index does when no copy has been saved yet: it saves one first.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحفظ TextMouth أولًا نسخة من الملف القديم، ولا يعيد البناء إذا تعذّر ذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth আগে পুরোনো ফাইলের একটি কপি সংরক্ষণ করে, আর তা না পারলে পুনর্নির্মাণ করে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth sichert zuerst eine Kopie der alten Datei und baut nicht neu auf, wenn das nicht gelingt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth first saves a copy of the old file, and does not rebuild if it cannot."
