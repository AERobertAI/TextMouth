    },
    "keptParts.keptForRedownloadSentence.value" : {
      "comment" : "What VoiceOver says after Delete Download deleted a download whose package kept one part of the listener's. %@ is what is kept, such as \"place\" or \"transcript\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يُحتفظ بما يلي لحين تنزيله مرة أخرى: %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আবার ডাউনলোড করলে ব্যবহারের জন্য এর %@ রাখা হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Für den Fall eines erneuten Downloads bleibt erhalten: %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its %@ is kept for when you download it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para cuando la descargues de nuevo, se conserva: %@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ آن برای زمانی که دوباره بارگیری کنید نگه داشته می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Conservée en vue d’un nouveau téléchargement : %@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ נשמר למקרה של הורדה חוזרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फिर से डाउनलोड करने के लिए इसका यह अंश रखा गया है: %@।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ disimpan untuk dipakai saat Anda mengunduhnya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ne conserva %@ per quando lo scarichi di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "もう一度ダウンロードするときのために、%@が保持されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@은(는) 다시 다운로드할 때를 위해 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De %@ blijft bewaard, voor als je het opnieuw downloadt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zachowane do ponownego pobrania: %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fica guardado para quando você baixar de novo: %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сохранено для повторной загрузки: %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dess %@ sparas tills du hämtar den igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "จะเก็บ %@ ของรายการไว้ใช้เมื่อคุณดาวน์โหลดอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yeniden indirdiğinizde kullanılmak üzere şu saklanır: %@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Збережено: %@, на випадок повторного завантаження."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس کی %@ کو اس وقت کے لیے رکھا گیا ہے جب آپ اسے دوبارہ ڈاؤن لوڈ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ của nó được giữ lại để dùng khi bạn tải về lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "其%@会保留，供你再次下载时使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "其%@會保留，待你再次下載時使用。"
          }
        }
      }
    },
