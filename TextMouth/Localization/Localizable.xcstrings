    },
    "This file could not be read as a rich text document." : {
      "comment" : "Why a file was refused at import: it could not be read as a rich text (RTF) document. A sentence saying it may be damaged follows.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo leer este archivo como documento de texto enriquecido."
          }
        }
      }
    },
    "This file could not be read as an OpenDocument text document." : {
      "comment" : "Why a file was refused at import: it could not be read as an OpenDocument text (.odt) document. A sentence saying it may be damaged follows.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo leer este archivo como documento de texto de OpenDocument."
          }
