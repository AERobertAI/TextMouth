          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Ordner ist kein DAISY-Buch: Er hat auf oberster Ebene weder eine ncc.html- noch eine .opf-Datei."
          }
        },
        "en" : {
