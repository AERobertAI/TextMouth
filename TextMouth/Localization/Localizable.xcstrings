      }
    },
    "textImportPolicy.reloadFailed.unchanged" : {
      "comment" : "First sentence of the announcement when Reload from Editor could not read the editor's file back.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
