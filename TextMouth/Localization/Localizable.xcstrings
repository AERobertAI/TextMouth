    },
    "The braille code the book is written in." : {
      "comment" : "The hint of the braille code pop-up in the Export dialog's braille options.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Braille-Code, in dem das Buch geschrieben ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El código braille en el que está escrito el libro."
          }
        },
