    "libraryViewEditor.editDisabledHint" : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. Its hint for Folders and the Reading List, when it is dimmed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تسرد المجلدات وقائمة القراءة ما تسرده دائمًا. يمكنك نقلها وإخفاء قائمة القراءة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফোল্ডার ও পড়ার তালিকা সবসময় নিজেদের যা আছে তা-ই তালিকাভুক্ত করে। এগুলো সরানো যায়, আর পড়ার তালিকা লুকানো যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„Ordner“ und die Leseliste listen immer dasselbe auf. Du kannst sie verschieben und die Leseliste ausblenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folders and the Reading List list what they always have. You can move them, and hide the Reading List."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Carpetas y la Lista de lectura siempre muestran lo mismo. Puedes moverlas y ocultar la Lista de lectura."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پوشه‌ها و فهرست مطالعه همان را فهرست می‌کنند که همیشه کرده‌اند. می‌توانید آن‌ها را جابه‌جا کنید و فهرست مطالعه را پنهان کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La vue Dossiers et la liste de lecture listent toujours la même chose. Vous pouvez les déplacer et masquer la liste de lecture."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "התצוגות “תיקיות” ו“רשימת קריאה” מציגות תמיד את התוכן הקבוע שלהן. אפשר להזיז אותן ולהסתיר את רשימת הקריאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ोल्डर और रीडिंग लिस्ट वही सूचीबद्ध करती हैं जो उनमें हमेशा रहता है। आप उन्हें ले जा सकते हैं, और रीडिंग लिस्ट को छिपा सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Folder dan Daftar Bacaan selalu mencantumkan isi yang sama. Anda dapat memindahkannya, dan menyembunyikan Daftar Bacaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le cartelle e l’elenco di lettura elencano sempre ciò che hanno. Puoi spostarli e nascondere l’elenco di lettura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「フォルダ」とリーディングリストは、常に決まった内容を表示します。どちらも移動でき、リーディングリストは非表示にすることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "폴더 보기와 읽기 목록 보기는 그 안에 있는 항목을 항상 나열합니다. 위치를 이동할 수 있고, 읽기 목록은 숨길 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mappen en de Leeslijst tonen altijd wat erin staat. Je kunt ze verplaatsen en de Leeslijst verbergen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Foldery i Lista czytelnicza wyświetlają zawsze to, co mają. Można je przenosić, a Listę czytelniczą ukryć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pastas e a Lista de leitura listam sempre o que têm. Você pode movê-las e ocultar a Lista de leitura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«Папки» и «Список для чтения» всегда показывают одно и то же. Их можно перемещать, а «Список для чтения» можно и скрыть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mappar och Läslistan listar det de alltid gör. Du kan flytta dem och dölja Läslistan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "โฟลเดอร์และรายการอ่านแสดงสิ่งที่มีอยู่เสมอ ย้ายได้ และซ่อนรายการอ่านได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Klasörler ve Okuma Listesi her zaman kendi içeriklerini listeler. Bunları taşıyabilir ve Okuma Listesini gizleyebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«Папки» та «Список читання» завжди показують свій звичайний вміст. Їх можна переміщувати, а «Список читання» — приховати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فولڈرز اور مطالعے کی فہرست وہی دکھاتے ہیں جو ان میں ہمیشہ ہوتا ہے۔ آپ انہیں منتقل کر سکتے ہیں، اور مطالعے کی فہرست کو چھپا سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chế độ xem Thư mục và Danh sách đọc luôn liệt kê những gì vốn có của chúng. Bạn có thể di chuyển chúng, và ẩn Danh sách đọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文件夹和阅读列表始终列出固定的内容。你可以移动它们，也可以隐藏阅读列表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "檔案夾和閱讀列表一律列出它們原有的內容。你可以移動它們，也可以隱藏閱讀列表。"
          }
        }
      }
    },
    "libraryViewEditor.editHint" : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. Its hint.",
