    "duplicateReplacement.oldCopyLeftMessage.deleted" : {
      "comment" : "Alert after Replace Existing when the old copy's files could not be deleted. %1$@ is the book's title. %2$@ is why they could not be deleted.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "حلّت النسخة الجديدة محل “%1$@”، لكن تعذّر حذف ملفات النسخة القديمة وبقيت في مجلدها: %2$@"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "নতুন কপি “%1$@” প্রতিস্থাপন করেছে, কিন্তু পুরোনো কপির ফাইল মুছে ফেলা যায়নি এবং সেগুলো এর ফোল্ডারে থেকে গেছে: %2$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die neue Kopie hat „%1$@“ ersetzt, aber die Dateien der alten Kopie konnten nicht gelöscht werden und bleiben in ihrem Ordner: %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The new copy replaced “%@”, but the old copy's files could not be deleted and stay in its folder: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La copia nueva reemplazó “%1$@”, pero los archivos de la copia anterior no se pudieron eliminar y permanecen en su carpeta: %2$@"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نسخه‌ی جدید جایگزین «%@» شد، اما فایل‌های نسخه‌ی قدیمی حذف نشدند و در پوشه‌ی آن می‌مانند: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La nouvelle copie a remplacé « %@ », mais les fichiers de l’ancienne copie n’ont pas pu être supprimés et restent dans son dossier : %@"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "העותק החדש החליף את “%1$@”, אבל לא ניתן היה למחוק את קבצי העותק הישן והם נשארים בתיקייה שלו: %2$@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "नई कॉपी ने “%1$@” को बदल दिया, लेकिन पुरानी कॉपी की फ़ाइलें मिटाई नहीं जा सकीं और उसके फ़ोल्डर में बनी हैं: %2$@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Salinan baru menggantikan “%@”, tetapi file salinan lama tidak dapat dihapus dan tetap berada di folder-nya: %@"
