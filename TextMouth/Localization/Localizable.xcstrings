    "brailleFileCode.readingAgainRefusal" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. Why what would rewrite the text of the braille book titled bookTitle waits while TextMouth reads it again with other braille file characters, as the encoding's sentence says it for any other book (TextEncodingWording.readingAgainRefusal(bookTitle:)): a second re-read of it, Edit Text, Redo Text Extraction, and Replace Existing (LibraryViewModel.readingAgainRefusal(of:)). Placeholders in order: bookTitle.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يعيد TextMouth قراءة “%@” بحروف ملف برايل أخرى. حاول مرة أخرى عند انتهاء ذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth “%@” অন্য ব্রেইল ফাইল অক্ষর দিয়ে আবার পড়ছে। সেটি শেষ হলে আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth liest „%@“ gerade mit anderen Zeichen der Braille-Datei erneut. Versuche es erneut, wenn das beendet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth is reading “%@” again with other braille file characters. Try again when that finishes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth está volviendo a leer “%@” con otros caracteres de archivo braille. Inténtalo de nuevo cuando termine."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth در حال خواندن دوباره‌ی «%@» با نویسه‌های فایل بریل دیگری است. پس از پایان آن دوباره تلاش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth relit « %@ » avec d’autres caractères de fichier braille. Réessayez quand ce sera terminé."
