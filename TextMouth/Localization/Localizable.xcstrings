        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisissez %@ dans le menu Tri, puis réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בחר “%@” בתפריט המיון ונסה שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "क्रमबद्ध करें मेनू में “%@” चुनें, और फिर से प्रयास करें।"
          }
        },
        "id" : {
          "stringUnit" : {
