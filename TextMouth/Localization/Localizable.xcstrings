    "textEncoding.keptTextNote" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. What a re-read does to text TextMouth did not write, said only for a book whose content.md holds such text: an edit made with Edit Text, or a save no edit took, either kept as Replace Existing keeps it (ImportDecisionWording.replacingKeepsTextSentence).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يُحفظ تحرير نصه بجوار القراءة الجديدة، كنسخة في حزمة الكتاب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এর টেক্সটে করা সম্পাদনা নতুন করে পড়া টেক্সটের পাশে, বইয়ের প্যাকেজে একটি কপি হিসেবে রাখা হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eine Bearbeitung seines Texts bleibt neben dem neu eingelesenen Text erhalten, als Kopie im Paket des Buchs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An edit of its text is kept beside the new reading, as a copy in the book's package."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una edición de su texto se conserva junto a la nueva lectura, como una copia en el paquete del libro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ویرایش متن آن، به‌صورت یک نسخه در بسته‌ی کتاب، کنار متن جدید نگه داشته می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une modification de son texte est conservée à côté du nouveau texte, sous forme de copie dans le paquet du livre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "עריכה של הטקסט שלו נשמרת לצד הקריאה החדשה, כעותק בחבילת הספר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "उसके टेक्स्ट का संपादन नई रीडिंग के बगल में, पुस्तक के पैकेज में एक कॉपी के रूप में रखा जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hasil edit teksnya disimpan di samping pembacaan baru, sebagai salinan di paket buku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una modifica del suo testo viene conservata accanto alla nuova lettura, come copia nel pacchetto del libro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "テキストの編集内容は、新しい読み込み結果とは別に、ブックのパッケージ内にコピーとして残されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "텍스트를 편집한 내용은 새로 읽은 결과 옆에 책 패키지 안의 사본으로 보관됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Een bewerking van de tekst blijft bewaard naast de nieuwe versie, als kopie in het pakket van het boek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Edytowany tekst zostaje zachowany obok nowego odczytu jako kopia w pakiecie książki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uma edição do texto é mantida ao lado da nova leitura, como uma cópia no pacote do livro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Правка текста сохраняется как копия в пакете книги, рядом с результатом повторного чтения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En redigering av dess text behålls vid sidan av den nya läsningen, som en kopia i bokens paket."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ข้อความที่แก้ไขไว้จะถูกเก็บเป็นสำเนาในแพ็กเกจของหนังสือ คู่กับข้อความที่อ่านได้ใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Metinde yapılan bir düzenleme, kitabın paketinde bir kopya olarak yeniden okunan metnin yanında saklanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ваші зміни в тексті зберігаються як копія в пакеті книги, поряд із заново прочитаним текстом."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس کے متن کی ترمیم نئی ریڈنگ کے ساتھ، کتاب کے پیکیج میں ایک کاپی کے طور پر رکھی جاتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bản sửa văn bản của sách được giữ bên cạnh kết quả đọc lại, dưới dạng một bản sao trong gói của sách."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "对其文本所做的编辑，会作为副本保留在图书包中新的阅读内容旁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "對其文字所做的編輯，會以副本形式保留在書籍的套件中，與新的讀取結果並存。"
          }
        }
      }
    },
