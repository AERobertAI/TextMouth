    "readerWhereAmIToolbarButton.spokenLabel" : {
      "comment" : "What VoiceOver calls the reader toolbar's Where Am I? button while nothing is announced.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أين أنا؟ يعلن الموضع الحالي في الكتاب"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আমি কোথায়? বইয়ের বর্তমান অবস্থান ঘোষণা করে"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wo bin ich? Sagt die aktuelle Position im Buch an"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where Am I? Announces current position in the book"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "¿Dónde estoy? Anuncia la posición actual en el libro"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کجا هستم؟ موقعیت فعلی در کتاب را اعلام می‌کند"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Où suis-je ? Annonce la position actuelle dans le livre"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "איפה אני? מכריז על המיקום הנוכחי בספר"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "मैं कहाँ हूँ? पुस्तक में वर्तमान स्थिति बताता है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Di mana saya? Mengumumkan posisi saat ini di buku"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dove sono? Annuncia la posizione corrente nel libro"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ここはどこ？ ブック内の現在位置を読み上げます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "내 위치는? 책의 현재 위치를 안내합니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Waar ben ik? Kondigt de huidige positie in het boek aan"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gdzie jestem? Podaje bieżącą pozycję w książce"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Onde estou? Anuncia a posição atual no livro"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Где я? Объявляет текущую позицию в книге"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Var är jag? Meddelar aktuell position i boken"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ฉันอยู่ที่ไหน ประกาศตำแหน่งปัจจุบันในหนังสือ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Neredeyim? Kitaptaki geçerli konumu duyurur"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Де я? Оголошує поточну позицію в книзі"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "میں کہاں ہوں؟ کتاب میں موجودہ مقام بتاتا ہے"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tôi đang ở đâu? Thông báo vị trí hiện tại trong sách"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "我在哪里？播报图书中的当前位置"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "我在哪裡？播報書籍中的目前位置"
          }
        }
      }
    },
