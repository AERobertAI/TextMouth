    "libraryFolderSettings.feedHint" : {
      "comment" : "Hint of the Library toolbar button, in the folder of a feed, that opens the feed's settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يفتح إعدادات الموجز: أين تذهب تنزيلاته وما يسرده وينزّله وما يحدث عند انتهاء حلقة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফিডের সেটিংস খোলে: এর ডাউনলোড কোথায় যায়, কী তালিকাভুক্ত ও ডাউনলোড হয়, আর একটি পর্ব শেষ হলে কী হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffnet die Einstellungen des Feeds: wohin seine Downloads gehen, was er auflistet und herunterlädt und was passiert, wenn eine Folge endet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens the feed's settings: where its downloads go, what it lists and downloads, and what happens when an episode ends"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre los ajustes del canal: adónde van sus descargas, qué muestra y descarga, y qué pasa cuando termina un episodio"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تنظیمات فید را باز می‌کند: محل بارگیری‌ها، آنچه فهرست و بارگیری می‌شود، و آنچه هنگام پایان یک قسمت رخ می‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ouvre les réglages du flux : où vont ses téléchargements, ce qu’il liste et télécharge, et ce qui se passe à la fin d’un épisode."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "פותח את הגדרות הערוץ: לאן נשמרות ההורדות שלו, מה הוא מציג ומוריד, ומה קורה כשאפיזודה מסתיימת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ीड की सेटिंग खोलता है: उसके डाउनलोड कहाँ जाते हैं, वह क्या सूचीबद्ध और डाउनलोड करती है, और एपिसोड खत्म होने पर क्या होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuka pengaturan feed: ke mana unduhannya disimpan, apa yang dicantumkan dan diunduhnya, dan apa yang terjadi saat episode selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apre le impostazioni del feed: dove vanno i suoi download, che cosa elenca e scarica, e che cosa succede quando finisce un episodio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フィードの設定を開きます：ダウンロード先、表示とダウンロードの対象、エピソード終了時の動作。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "피드 설정을 엽니다. 다운로드 위치, 나열 및 다운로드할 항목, 에피소드가 끝날 때의 동작을 설정할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Opent de instellingen van de feed: waar de downloads naartoe gaan, wat de feed toont en downloadt, en wat er gebeurt als een aflevering eindigt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Otwiera ustawienia kanału: dokąd trafiają pobrane pliki, co jest wyświetlane i pobierane oraz co dzieje się po zakończeniu odcinka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre os ajustes do feed: para onde vão os downloads, o que ele lista e baixa, e o que acontece quando um episódio termina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Открывает настройки ленты: куда попадают загрузки, что она показывает и загружает и что происходит, когда выпуск заканчивается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öppnar flödets inställningar: vart nedladdningarna går, vad det listar och hämtar, och vad som händer när ett avsnitt tar slut."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เปิดการตั้งค่าของฟีด: ปลายทางของรายการดาวน์โหลด สิ่งที่แสดงและดาวน์โหลด และสิ่งที่เกิดขึ้นเมื่อตอนจบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beslemenin ayarlarını açar: indirmelerinin nereye gittiği, neyi listeleyip indirdiği ve bir podcast bölümü bitince ne olacağı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відкриває налаштування стрічки: куди потрапляють її завантаження, що вона показує й завантажує та що відбувається, коли епізод закінчується."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فیڈ کی ترتیبات کھولتا ہے: اس کے ڈاؤن لوڈز کہاں جاتے ہیں، یہ کیا درج اور ڈاؤن لوڈ کرتا ہے، اور ایپی سوڈ ختم ہونے پر کیا ہوتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mở cài đặt của nguồn cấp: nơi các bản tải về được lưu, những gì nó liệt kê và tải về, và điều xảy ra khi một tập kết thúc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "打开订阅源的设置：下载内容存放位置、列出和下载的内容，以及单集结束时的行为。"
