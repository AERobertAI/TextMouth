    },
    "OCR could not run on %@ of %lld pages, so text found only in their images is missing: %@." : {
      "comment" : "Warning after an import of a PDF where some pages needed text recognition (OCR) where it could not run. %1$@ is how many of them, one or more, written with digit grouping; %2$lld is how many pages the PDF has, two or more; %3$@ is the pages and why, such as \"pages 3 and 7 (text recognition is not available)\", the reasons in English.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "OCR could not run on %@ of %lld page, so text found only in their images is missing: %@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "OCR could not run on %@ of %lld pages, so text found only in their images is missing: %@."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "No se pudo ejecutar el OCR en %@ de %lld de páginas, así que falta el texto que solo aparece en sus imágenes: %@."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "No se pudo ejecutar el OCR en %@ de %lld página, así que falta el texto que solo aparece en sus imágenes: %@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "No se pudo ejecutar el OCR en %@ de %lld páginas, así que falta el texto que solo aparece en sus imágenes: %@."
                }
              }
            }
          }
        }
      }
    },
    "OCR could not run on all %lld pages, so text found only in their images is missing: %@." : {
      "comment" : "Warning after an import of a PDF whose every page needed text recognition (OCR) where it could not run. %lld is how many pages the PDF has, two or more. %@ is the pages and why, such as \"pages 3 and 7 (text recognition is not available)\", the reasons in English.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "OCR could not run on all %lld page, so text found only in its images is missing: %@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "OCR could not run on all %lld pages, so text found only in their images is missing: %@."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "No se pudo ejecutar el OCR en todas las %lld de páginas, así que falta el texto que solo aparece en sus imágenes: %@."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "No se pudo ejecutar el OCR en la única página (%lld), así que falta el texto que solo aparece en sus imágenes: %@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "No se pudo ejecutar el OCR en todas las %lld páginas, así que falta el texto que solo aparece en sus imágenes: %@."
                }
              }
            }
          }
        }
      }
    },
    "OCR could not run on the PDF's only page, so text found only in its images is missing: %@." : {
      "comment" : "Warning after an import of a PDF whose only page needed text recognition (OCR) where it could not run. %@ is the page and why, such as \"page 1 (text recognition is not available)\", the reason in English.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
