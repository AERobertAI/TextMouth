{
  "sourceLanguage" : "en",
  "strings" : {
    "\"%@\" is not a number." : {
      "comment" : "Message when the text typed in Go to Percent is no number. %@ is what the user typed, shown in quotation marks."
    },
    "\"%@\" plays the next book in the same folder by sort order." : {
      "comment" : "Explanation under the When book ends pop-up in the Playback settings. %@ is the title of the pop-up's choice that plays the next book, as the pop-up shows it."
    },
    "%@ %@" : {
      "comment" : "A row button's name with the row's subject, so VoiceOver tells one row's button from the next, such as \"Delete Marker 3\". %1$@ is the button's name and %2$@ the row's subject.\nAnnouncement of the microphone level every few seconds while recording. %1$@ is the level's label and %2$@ is the level in words, such as \"minus 12 decibels, good\".\nJoins two whole sentences into one text. %1$@ is the first sentence and %2$@ the second. English puts a space between them; Japanese and Chinese join sentences with no space at all, so change only the separator.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ %@, which TextMouth can't export with its structure." : {
      "comment" : "The first sentence of the alert an export shows when a chapter nests too deeply. %1$@ names what nests, such as \"Chapter 2 of Deep Notes\", and %2$@ is the clause that says how deep, such as \"nests quotes, lists, or emphasis more than 128 levels deep\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@, which TextMouth can't export with its structure."
          }
        }
      }
    },
    "%@ %@." : {
      "comment" : "Says why a book's download cannot be deleted or replaced now. The first %@ is the book's title in quotation marks, or \"It\"; the second is a clause such as \"is open in a reader\" or \"is being transcribed, and deleting its download now would lose the transcript\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@."
          }
        }
      }
    },
    "%@ %lld of %lld" : {
      "comment" : "A question's title followed by its place among the questions waiting, when the title ends in a question mark. %1$@ is the title, %2$lld the question's place and %3$lld the number of questions, such as \"Create Folder for Imported Books? 2 of 3\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$lld of %3$lld"
          }
        }
      }
    },
    "%@ (%@)" : {
      "comment" : "A feed that could not be subscribed to, with the reason in parentheses. The first %@ is the feed's title; the second is the reason, in the engine's words.\nThe second choice of the Log location pop-up in the Storage settings. %1$@ is the choice's name, and %2$@ is the folder's name on this Mac, a path that stays as written, such as ~/Library/Logs/TextMouth.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@)"
          }
        }
      }
    },
    "%@ (current heading) - level %lld" : {
      "comment" : "What VoiceOver says for the heading being read, in the headings list. %1$@ is the heading's text; %2$lld is its level, 1 for the biggest heading.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (current heading) - level %2$lld"
          }
        }
      }
    },
    "%@ - Original Audio" : {
      "comment" : "The name of an exported folder holding a book's audio as it was before its first edit. %@ is the book's title made safe for a file name."
    },
    "%@ - Original Files" : {
      "comment" : "The name of an exported folder holding an audiobook's audio files as they were before TextMouth converted them. %@ is the book's title made safe for a file name."
    },
    "%@ - Original Recording.%@" : {
      "comment" : "The name of an exported file holding a recording as it was made. %1$@ is the book's title made safe for a file name and %2$@ the file's extension, such as m4a.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ - Original Recording.%2$@"
          }
        }
      }
    },
    "%@ - level %lld" : {
      "comment" : "What VoiceOver says for a heading in the headings list. %1$@ is the heading's text; %2$lld is its level, 1 for the biggest heading.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ - level %2$lld"
          }
        }
      }
    },
    "%@ Ascending" : {
      "comment" : "The sort in a Library window's title: a sort field and its direction, ascending. %@ is the sort field's name, such as Title or Date Added."
    },
    "%@ Copy" : {
      "comment" : "Name Duplicate gives a copy of a Library view. %@ is the name of the view that was copied, such as \"Unopened\"; the copy is \"Unopened Copy\"."
    },
    "%@ Copy %@" : {
      "comment" : "Name Duplicate gives a second or later copy of a Library view, the first copy's name being taken. %1$@ is the name of the view that was copied. %2$@ is the copy's number, 2 or more, an identifier written without digit grouping.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ Copy %2$@"
          }
        }
      }
    },
    "%@ Descending" : {
      "comment" : "The sort in a Library window's title: a sort field and its direction, descending. %@ is the sort field's name, such as Title or Date Added."
    },
    "%@ adds a bookmark at the current position." : {
      "comment" : "Help under \"No bookmarks yet.\" in the Bookmarks list. %@ is the keyboard shortcut that adds a bookmark, spelled out in words, such as Command + B.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ agrega un marcador en la posición actual."
          }
        }
      }
    },
    "%@ adds one at the current position." : {
      "comment" : "Help under \"No bookmarks yet.\" in the Bookmarks list, when the add command has no keyboard shortcut. %@ is the name of the Add Bookmark button above the list.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ agrega uno en la posición actual."
          }
        }
      }
    },
    "%@ also holds %lld books a newer TextMouth added, which are kept." : {
      "comment" : "Last sentence of the dialog that asks how to delete a folder, when the folder holds books that a newer TextMouth added. %1$@ is the folder's name in quotation marks and %2$lld is how many books, a count.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ also holds %lld book a newer TextMouth added, which is kept."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ also holds %lld books a newer TextMouth added, which are kept."
                }
              }
            }
          }
        }
      }
    },
    "%@ and any subfolders will be removed from the library." : {
      "comment" : "First sentence of the second confirmation that deletes an empty folder. %@ is the folder's name in quotation marks."
    },
    "%@ are in your library, unsubscribed. Choose %@ on a feed's row, or in its %@, to check it again." : {
      "comment" : "What the Import OPML sheet says of several feeds the file lists that are in the library already, unsubscribed. The first %@ is a list of their titles; the second is the name of the Resubscribe command; the third is the name of the Feed Info sheet.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ are in your library, unsubscribed. Choose %2$@ on a feed's row, or in its %3$@, to check it again."
          }
        }
      }
    },
    "%@ aren't downloaded." : {
      "comment" : "Why an operation left several books as it is: their files are only in the cloud. %@ is a count of books, such as \"5 books\".\nWhy an operation left two or three books as it is: their files are only in the cloud. %@ is the books' titles as a list."
    },
    "%@ as %@" : {
      "comment" : "The name of a checkbox in the Export dialog while its list or transcript is written in a format. %1$@ is the checkbox's name, such as Headings or Transcript, and %2$@ the name of the format, such as CUE sheet or WebVTT.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ as %2$@"
          }
        }
      }
    },
    "%@ at %@" : {
      "comment" : "A moment on another day. The first %@ is the date, such as \"October 1\" or \"October 1, 2025\"; the second is the time of day, such as 3:05 PM.\nAn amount of time followed by the speed it counts at. %1$@ is the amount with its words, such as \"3:44:01 left\" or \"Total time: 4 hours\"; %2$@ is the speed, such as \"2.0x\", \"2.0 times speed\" or \"500 words a minute\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ at %2$@"
          }
        }
      }
    },
    "%@ by %@" : {
      "comment" : "A book named in a row of Compare Libraries. %1$@ is its title and %2$@ its author.\nThe shared title and author of a group of duplicate books that match by both, in the group's heading. %1$@ is the title and %2$@ is the author.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ by %2$@"
          }
        }
      }
    },
    "%@ can't be made, because the folder that would hold it, %@, can't be found." : {
      "comment" : "Why the chosen location can't be used: the folder that would hold it is missing. %1$@ is the chosen path; %2$@ is the missing folder's path.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ can't be made, because the folder that would hold it, %2$@, can't be found."
          }
        }
      }
    },
    "%@ can't be read as %@: it holds bytes that are not valid in that encoding." : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. Why a file chosen to be read in the encoding named encoding was not read: some of its bytes are not valid in it. subject names the file or the book, as the sentence begins: \"“Ledger” can't be read as Shift JIS (Japanese): it holds bytes that are not valid in that encoding.\" The decoder's error (TextEncodingError.invalidForChosenEncoding) and Book Information's refusal both say it from here. Placeholders in order: subject, encoding.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ can't be read as %2$@: it holds bytes that are not valid in that encoding."
          }
        }
      }
    },
    "%@ can't move down." : {
      "comment" : "VoiceOver announcement when a book is at the bottom of a manual order and cannot move down. %@ is the book's title."
    },
    "%@ can't move up." : {
      "comment" : "VoiceOver announcement when a book is at the top of a manual order and cannot move up. %@ is the book's title."
    },
    "%@ can't open while its edited text can't be used: %@" : {
      "comment" : "First part of the message a reader shows in place of a book whose edited text can't be used. %1$@ is the book's title; %2$@ is the reason, a clause that begins in lower case and ends with its full stop.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ can't open while its edited text can't be used: %2$@"
          }
        }
      }
    },
    "%@ contains %lld books and may have subfolders." : {
      "comment" : "First sentence of the dialog that asks how to delete a folder. %1$@ is the folder's name in quotation marks and %2$lld is how many books the folder and its subfolders hold, a count.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ contains %lld book and may have subfolders."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ contains %lld books and may have subfolders."
                }
              }
            }
          }
        }
      }
    },
    "%@ couldn't be reached: %@" : {
      "comment" : "Why a feed could not be fetched: the connection failed. The first %@ is the server's host name; the second is the reason, a phrase from the system or from TextMouth, such as \"the server sent no answer\".\nWhy a feed item's download failed: the connection failed. The first %@ is the server's host name; the second is the reason, a phrase from the system or from TextMouth, such as \"the server sent no answer\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ couldn't be reached: %2$@"
          }
        }
      }
    },
    "%@ couldn't be read: %@" : {
      "comment" : "Why a file could not be read, in Use This Library's account. %1$@ names the file and %2$@ is the reason in English, as the file's reader worded it.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ couldn't be read: %2$@"
          }
        }
      }
    },
    "%@ couldn't download the book: %@" : {
      "comment" : "Why a book download failed. %1$@ is the cloud service's name, or \"The cloud service\" when it is unknown; %2$@ is the service's own message.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ couldn't download the book: %2$@"
          }
        }
      }
    },
    "%@ couldn't remove the book's download: %@" : {
      "comment" : "Why Remove Download failed. %1$@ is the cloud service's name, or \"The cloud service\" when it is unknown; %2$@ is the service's own message.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ couldn't remove the book's download: %2$@"
          }
        }
      }
    },
    "%@ couldn't send the feed (error %@). Try again later." : {
      "comment" : "Why a feed could not be fetched: the server answered with an error. The first %@ is the server's host name; the second is the error's number, an identifier written without digit grouping, such as 503.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ couldn't send the feed (error %2$@). Try again later."
          }
        }
      }
    },
    "%@ couldn't send the file (error %@). Try again later." : {
      "comment" : "Why a feed item's download failed: the server answered with an error. The first %@ is the server's host name; the second is the error's number, an identifier written without digit grouping, such as 503.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ couldn't send the file (error %2$@). Try again later."
          }
        }
      }
    },
    "%@ couldn't upload this book: %@" : {
      "comment" : "First sentence of why Remove Download was refused: the upload failed. %1$@ is the cloud service's name, or \"The cloud service\" when it is unknown; %2$@ is the service's own message, which ends with a full stop.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ couldn't upload this book: %2$@"
          }
        }
      }
    },
    "%@ deleted" : {
      "comment" : "Announcement after a substitution rule is deleted. %@ is the rule's name.\nSaid as a filter preset is deleted. %@ is the preset's name."
    },
    "%@ deleted." : {
      "comment" : "Said as a marker is deleted in the audio editor. %@ is the marker's name such as \"Marker 3\" or \"Marker 3, Intro\"."
    },
    "%@ didn't answer for %lld seconds." : {
      "comment" : "Why a feed could not be fetched: the server took too long. The first %@ is the server's host name; %lld is the number of seconds waited.\nWhy a feed item's download failed: the server took too long. The first %@ is the server's host name; %lld is the number of seconds waited.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ didn't answer for %lld second."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ didn't answer for %lld seconds."
                }
              }
            }
          }
        }
      }
    },
    "%@ does the same for every such chapter of this export, without asking again." : {
      "comment" : "The third sentence of the alert an export shows when a chapter nests too deeply and others may too. %@ is the name of the Export Every Such Chapter as Written button."
    },
    "%@ doesn't say whether the copy of this book on this Mac is the latest, so its download can't be removed, and waiting won't change that." : {
      "comment" : "First sentence of why Remove Download was refused: the cloud service never says whether the copy here is current. %@ is the cloud service's name, or \"The cloud service\" when it is unknown."
    },
    "%@ downloaded" : {
      "comment" : "Announcement that Download Now brought one book to this Mac. %@ is the book's title."
    },
    "%@ elapsed" : {
      "comment" : "The time a download has waited, in the download view's progress value. %@ is the time, such as \"1:05\" on screen or \"1 minute, 5 seconds\" spoken."
    },
    "%@ failed: %@" : {
      "comment" : "Why an import failed: the step it was at, then the reason. %1$@ is the step starting a sentence, such as \"Reading its text\" or \"Copying it into the library\", and %2$@ the reason, a sentence of the system's or the app's.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ failed: %2$@"
          }
        }
      }
    },
    "%@ files can't hold chapter markers, so its %lld chapter markers are left out of this file." : {
      "comment" : "Said when a save or an export writes a file format that has no place for chapter markers. %1$@ is the format's name, such as \"WAV\", and %2$lld the number of chapter markers left out.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ files can't hold chapter markers, so its chapter marker is left out of this file."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ files can't hold chapter markers, so its %lld chapter markers are left out of this file."
                }
              }
            }
          }
        }
      }
    },
    "%@ for %@ is now in effect: %@." : {
      "comment" : "What VoiceOver says once a change of a feed's own List and download choice takes effect. The first %@ is the name of the choice; the second is the feed's title; the third is the choice now in force.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ for %2$@ is now in effect: %3$@."
          }
        }
      }
    },
    "%@ for %@ now follows the global setting: %@." : {
      "comment" : "What VoiceOver says once a feed uses the global List and download choice again. The first %@ is the name of the choice; the second is the feed's title; the third is the global choice now in force.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ for %2$@ now follows the global setting: %3$@."
          }
        }
      }
    },
    "%@ for This Book" : {
      "comment" : "Heading at the top of the reader's sheet for a book's own settings. %@ is the sheet's name, \"Audio Settings\" or \"Voice & Speed\"."
    },
    "%@ hadn't arrived from the cloud after %lld seconds" : {
      "comment" : "Why a file could not be read, in Use This Library's account. %1$@ names the file and %2$lld is how many seconds TextMouth waited, a count.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ hadn't arrived from the cloud after %lld second"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ hadn't arrived from the cloud after %lld seconds"
                }
              }
            }
          }
        }
      }
    },
    "%@ has %@." : {
      "comment" : "Second sentence of a position difference found by Compare Libraries. %1$@ is a copy of the library, capitalized, and %2$@ is the place it has saved, such as \"chapter 3, 41%\".\nSentence of Use This Library's account when neither copy is newer. %1$@ is a copy of the library, capitalized, and %2$@ lists what only it has, such as \"newer places in 3 books and 2 books the other lacks\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has %2$@."
          }
        }
      }
    },
    "%@ has %@; %@ has %@." : {
      "comment" : "Second sentence of a difference found by Compare Libraries. %1$@ is this copy of the library, capitalized, %2$@ is what it holds, %3$@ is the other copy, and %4$@ is what it holds.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has %2$@; %3$@ has %4$@."
          }
        }
      }
    },
    "%@ has its default, %@" : {
      "comment" : "Said in the row of a keyboard shortcut action that has lost its default key to another action. %1$@ is the name of the action that now has the key, and %2$@ is the key in words, such as \"Shift + Command + T\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has its default, %2$@"
          }
        }
      }
    },
    "%@ has no place saved." : {
      "comment" : "Second sentence of a position difference found by Compare Libraries. %@ is a copy of the library, capitalized, that has no place saved for the book."
    },
    "%@ has no transcript text to search now, because %@" : {
      "comment" : "Said instead of opening Search in Book when the book's audio changed after its transcript was made. %1$@ is the book's title and %2$@ is the reason, a whole sentence that ends with its own full stop.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has no transcript text to search now, because %2$@"
          }
        }
      }
    },
    "%@ has no transcript text to search now, because its edited text can't be used: %@" : {
      "comment" : "Said instead of opening Search in Book when the book's edited transcript text was held back. %1$@ is the book's title and %2$@ is the reason, a whole sentence that ends with its own full stop.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has no transcript text to search now, because its edited text can't be used: %2$@"
          }
        }
      }
    },
    "%@ has no transcript text to search now." : {
      "comment" : "Said instead of opening Search in Book when a book's transcript text cannot be searched and no reason is known. %@ is the book's title."
    },
    "%@ has no transcript to clean up. Transcribe its audio first." : {
      "comment" : "Alert shown when Clean Up Transcript is chosen for an audiobook with no transcript. %@ is the audiobook's title."
    },
    "%@ has no transcript to search." : {
      "comment" : "Said instead of opening Search in Book for an audiobook that has no transcript, where TextMouth cannot make one. %@ is the book's title."
    },
    "%@ has no transcript to search. Transcribe it first, with Transcribe Audio." : {
      "comment" : "Said instead of opening Search in Book for an audiobook that has no transcript yet. %@ is the book's title. Transcribe Audio is the name of a command in the Book menu."
    },
    "%@ has no words, so the cursor is %@." : {
      "comment" : "Announcement after Go to Page when the page typed has no words of its own. %1$@ names the page, such as \"Page 7\" or \"The first page labelled 3\"; %2$@ says where the cursor is, such as \"on page 8\" or \"before page 1\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has no words, so the cursor is %2$@."
          }
        }
      }
    },
    "%@ hasn't arrived on this Mac yet. %@ may still be syncing it." : {
      "comment" : "Shown and spoken when the book's files have not arrived from the sync service. %1$@ is the book's title; %2$@ is the cloud service's name, or \"The cloud service\" when it is unknown.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ hasn't arrived on this Mac yet. %2$@ may still be syncing it."
          }
        }
      }
    },
    "%@ hasn't downloaded anything for %lld seconds." : {
      "comment" : "First sentence of why a book download stopped: the cloud service made no progress. %1$@ is the cloud service's name, or \"The cloud service\" when it is unknown; %2$lld is the number of seconds.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ hasn't downloaded anything for %lld second."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ hasn't downloaded anything for %lld seconds."
                }
              }
            }
          }
        }
      }
    },
    "%@ hasn't said that every file of this book is uploaded, so its download can't be removed: the only copy might be on this Mac." : {
      "comment" : "First sentence of why Remove Download was refused: the cloud service gave no upload state. %@ is the cloud service's name, or \"The cloud service\" when it is unknown."
    },
    "%@ hasn't said that the copy of this book on this Mac is the latest, so its download can't be removed." : {
      "comment" : "First sentence of why Remove Download was refused: the cloud service has not said the copy here is current. %@ is the cloud service's name, or \"The cloud service\" when it is unknown."
    },
    "%@ holds a conflicting version of %@, saved at another time." : {
      "comment" : "First sentence of the report of an unresolved version of a file whose computer and time of saving are not known. %1$@ is the sync service's name; %2$@ is a phrase naming the file.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ holds a conflicting version of %2$@, saved at another time."
          }
        }
      }
    },
    "%@ holds a conflicting version of %@, saved on %@." : {
      "comment" : "First sentence of the report of an unresolved version of a file. %1$@ is the sync service's name; %2$@ is a phrase naming the file; %3$@ is the date and time it was saved.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ holds a conflicting version of %2$@, saved on %3$@."
          }
        }
      }
    },
    "%@ holds a conflicting version of %@, saved on “%@” on %@." : {
      "comment" : "First sentence of the report of an unresolved version of a file. %1$@ is the sync service's name; %2$@ is a phrase naming the file; %3$@ is the name of the computer that saved it; %4$@ is the date and time it was saved.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ holds a conflicting version of %2$@, saved on “%3$@” on %4$@."
          }
        }
      }
    },
    "%@ holds a conflicting version of %@, saved on “%@”." : {
      "comment" : "First sentence of the report of an unresolved version of a file. %1$@ is the sync service's name; %2$@ is a phrase naming the file; %3$@ is the name of the computer that saved it.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ holds a conflicting version of %2$@, saved on “%3$@”."
          }
        }
      }
    },
    "%@ holds two versions of a file of this book, so its download can't be removed." : {
      "comment" : "First sentence of why Remove Download was refused: the cloud service holds conflicting versions. %@ is the cloud service's name, or \"The cloud service\" when it is unknown."
    },
    "%@ in %@." : {
      "comment" : "Summary line of the Clean Up Transcript sheet. %1$@ is the number of corrections, such as \"23 corrections\"; %2$@ is the number of sentences they are in, such as \"19 sentences\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ in %2$@."
          }
        }
      }
    },
    "%@ in the cloud" : {
      "comment" : "Part of a checkbox's label in the Export dialog: how many books hold this item only in the cloud. %@ is a count of books, such as 2 books."
    },
    "%@ is already in the reading list." : {
      "comment" : "VoiceOver announcement when Add to Reading List added nothing: the one book selected is on the list already. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ya está en la lista de lectura."
          }
        }
      }
    },
    "%@ is already kept on this Mac." : {
      "comment" : "Why Keep on This Mac changed nothing: the selected book is already kept. %@ is the book's title."
    },
    "%@ is an audiobook without a transcript, so it has no text to edit." : {
      "comment" : "First sentence of the message when Edit Text is chosen for an audiobook with no transcript. %@ is the book's title."
    },
    "%@ is an item of a feed, and a feed's items can't be moved." : {
      "comment" : "VoiceOver announcement when Move Book Up or Move Book Down is used on an episode or article of a feed in a folder. %@ is its title."
    },
    "%@ is being transcribed. Cancel it, or attach the transcript once it finishes." : {
      "comment" : "Alert shown when Attach Transcript is chosen for an audiobook that is being transcribed. %@ is the audiobook's title."
    },
    "%@ is being transcribed. Cancel it, or delete the transcript once it finishes." : {
      "comment" : "Alert shown when Delete Transcript is chosen for an audiobook that is being transcribed. %@ is the audiobook's title."
    },
    "%@ is being transcribed. Clean up its transcript once that finishes." : {
      "comment" : "Alert shown when Clean Up Transcript is chosen for an audiobook that is being transcribed. %@ is the audiobook's title."
    },
    "%@ is filed %@ in %@ and %@ in %@." : {
      "comment" : "A difference found by Compare Libraries. %1$@ is a book's title, %2$@ says where this copy files it (at the top of the library, or in a folder), %3$@ is this copy, %4$@ says where the other copy files it, %5$@ is the other copy.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is filed %2$@ in %3$@ and %4$@ in %5$@."
          }
        }
      }
    },
    "%@ is in a skipped section, so the cursor is %@." : {
      "comment" : "Announcement after Go to Page when every word of the page typed is in a skipped section. %1$@ names the page, such as \"Page 40\" or \"The first page labelled 3\"; %2$@ says where the cursor is, such as \"on page 52\" or \"before page 1\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is in a skipped section, so the cursor is %2$@."
          }
        }
      }
    },
    "%@ is in your library, unsubscribed. Choose %@ on its row, or in its %@, to check it again." : {
      "comment" : "Why Subscribe refused: the feed is in the library but unsubscribed. The first %@ is the feed's title; the second is the name of the Resubscribe command; the third is the name of the Feed Info sheet.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is in your library, unsubscribed. Choose %2$@ on its row, or in its %3$@, to check it again."
          }
        }
      }
    },
    "%@ is kept on this Mac for the reading list." : {
      "comment" : "First sentence of why Stop Keeping on This Mac changed nothing for one book: the reading list keeps it. %@ is the book's title."
    },
    "%@ is no longer in the library." : {
      "comment" : "Announcement when the book of a search match has left the library since the search. %@ is the book's title."
    },
    "%@ is not a valid library folder location." : {
      "comment" : "Error shown when a folder edit is refused because its location is not a safe library path. %@ is the location, in straight double quotes."
    },
    "%@ is now in effect: %@." : {
      "comment" : "What VoiceOver says once a change of the global List and download choice takes effect. The first %@ is the name of the choice; the second is the choice now in force, such as \"Every item listed, newest 3 downloaded\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is now in effect: %2$@."
          }
        }
      }
    },
    "%@ is only in the cloud and isn't on this Mac yet, so nothing was written over it." : {
      "comment" : "First sentence of why a file was not saved: it is only in the cloud. %@ is the file's name, which stays as written."
    },
    "%@ is open in a reader. Close it, then choose Edit Audio again." : {
      "comment" : "Said when a book's reader did not close, so the audio editor can't open. %@ is the book's title. \"Edit Audio\" is the name of the command."
    },
    "%@ is set to be read as “%@”, a text encoding this version of TextMouth can't read." : {
      "comment" : "First sentence of why a book set to an unknown text encoding cannot be read. %1$@ names the book, as in “Ledger”, and %2$@ is the encoding's stored identifier.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is set to be read as “%2$@”, a text encoding this version of TextMouth can't read."
          }
        }
      }
    },
    "%@ is that folder or one of its subfolders." : {
      "comment" : "Second sentence of the error shown when a folder is moved into itself. %@ is the chosen destination's location, in straight double quotes."
    },
    "%@ is the newer. It has %@." : {
      "comment" : "Sentence of Use This Library's account of which copy is newer. %1$@ is a copy of the library, capitalized, and %2$@ lists what only it has, such as \"newer places in 3 books and 2 books the other lacks\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is the newer. It has %2$@."
          }
        }
      }
    },
    "%@ is unsubscribed, so TextMouth doesn't check it. Choose %@ to check it again." : {
      "comment" : "What VoiceOver says when Check Feed is chosen for an unsubscribed feed. The first %@ is the feed's title; the second is the name of the Resubscribe command.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is unsubscribed, so TextMouth doesn't check it. Choose %2$@ to check it again."
          }
        }
      }
    },
    "%@ isn't an audiobook of tracks, so it has no manifest to edit." : {
      "comment" : "Message when the user asks to edit the manifest of a book that is not an audiobook of tracks. %@ is the book's title."
    },
    "%@ isn't an audiobook; only audiobooks can be transcribed." : {
      "comment" : "Alert shown when Transcribe Audio is chosen for a book that is text, not audio. %@ is the book's title."
    },
    "%@ isn't available, so TextMouth can't record from it. Choose another microphone." : {
      "comment" : "Error in the Record window when the chosen microphone is not available. %@ is the microphone's name."
    },
    "%@ isn't downloaded." : {
      "comment" : "Shown and spoken when the book's download is cancelled. %@ is the book's title.\nWhy an operation left one book as it is: its files are only in the cloud. %@ is the book's title."
    },
    "%@ isn't in the reading list." : {
      "comment" : "VoiceOver announcement when Remove from Reading List took nothing off: the one book selected is not on the list. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no está en la lista de lectura."
          }
        }
      }
    },
    "%@ isn't kept on this Mac." : {
      "comment" : "Why Stop Keeping on This Mac changed nothing: the selected book is not kept. %@ is the book's title."
    },
    "%@ left" : {
      "comment" : "A book's time left to read, as its row shows it. %@ is a time, such as 16:00.\nTime left in the book as the reader's status row shows it. %@ is a clock time such as 3:44:01."
    },
    "%@ lists %lld feeds. Each gets its own folder, named after it." : {
      "comment" : "The line of the Import OPML sheet that names the file and how many feeds it lists. %@ is the file's name; %lld is how many feeds.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ lists %lld feed. Each gets its own folder, named after it."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ lists %lld feeds. Each gets its own folder, named after it."
                }
              }
            }
          }
        }
      }
    },
    "%@ may be signed out or not running." : {
      "comment" : "The likely cause of a missing cloud service's folder when the service's own folder is missing too. %@ is the cloud service's name."
    },
    "%@ moved to position %@ of %@" : {
      "comment" : "Announcement after a substitution rule moves in the list. %1$@ is the rule's name, %2$@ is its new place counting from one, and %3$@ is how many rules the list holds.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ moved to position %2$@ of %3$@"
          }
        }
      }
    },
    "%@ moved to position %lld of %lld" : {
      "comment" : "Said as a filter preset moves in the list. %1$@ is the preset's name, %2$lld its new place and %3$lld how many presets the list holds.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ moved to position %2$lld of %3$lld"
          }
        }
      }
    },
    "%@ moves an episode or article downloaded in its feed. Select one in its feed's folder." : {
      "comment" : "What VoiceOver says when Move to Library is chosen and no selected book is a feed's download. %@ is the name of the Move to Library command, with its ellipsis."
    },
    "%@ nests too deeply" : {
      "comment" : "The title of the alert an export shows when a chapter nests quotes, lists, or emphasis too deeply. %@ names what nests, such as \"Chapter 2 of Deep Notes\"."
    },
    "%@ not recorded for %@: %@" : {
      "comment" : "Announced by VoiceOver when a key cannot become a keyboard shortcut. %1$@ is the key in words, %2$@ is the action's name, and %3$@ is the reason, which starts in lower case.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ not recorded for %2$@: %3$@"
          }
        }
      }
    },
    "%@ not recording" : {
      "comment" : "Announcement of the microphone level while nothing is recording. %@ is the level's label."
    },
    "%@ now waits before %@, in case it is pressed twice." : {
      "comment" : "Announced by VoiceOver after a key's double press was given to an action: the key's single press now waits a moment before it acts, in case a second press follows. %1$@ is the key in words, such as \"J\", and %2$@ is the name of the action of its single press.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ now waits before %2$@, in case it is pressed twice."
          }
        }
      }
    },
    "%@ of %@" : {
      "comment" : "How many bytes of an archive's declared total have been extracted. %1$@ is the size done and %2$@ the total size, each with its unit, such as \"1.2 GB of 3.4 GB\".\nThe audio editor's time display as VoiceOver speaks it. %1$@ is the cursor's time and %2$@ the audio's length, both in words such as \"12 minutes, 4.3 seconds\".\nThe audio editor's time display as shown and brailled. %1$@ is the cursor's time and %2$@ the audio's length, both as clock times such as \"12:04.3\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@"
          }
        }
      }
    },
    "%@ of %@ transcribed" : {
      "comment" : "Line of the Transcribe Audio sheet while transcribing. %1$@ is the length of audio transcribed so far, in words such as \"40 minutes\"; %2$@ is the audiobook's whole length in words, such as \"6 hours, 12 minutes\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@ transcribed"
          }
        }
      }
    },
    "%@ on this book" : {
      "comment" : "Line of the import overlay: how long the book under way has taken. %@ is the time in words, such as \"1 minute, 5 seconds\"."
    },
    "%@ or %@" : {
      "comment" : "Joins two keyboard shortcuts of one action with \"or\", as in \"Space or K\". %1$@ is the shortcuts so far and %2$@ the next one.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ or %2$@"
          }
        }
      }
    },
    "%@ percent" : {
      "comment" : "A book's reading progress as VoiceOver says it. %@ is a whole number, such as 42."
    },
    "%@ plays sections that are stretches of its tracks, so its tracks can't be edited yet." : {
      "comment" : "Said when Edit Audio… is chosen for a book whose sections are stretches of its audio tracks. %@ is the book's title."
    },
    "%@ read" : {
      "comment" : "A book's reading progress as VoiceOver says it when the row also says a download's percentage. %@ is the progress, such as 42 percent."
    },
    "%@ remaining" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. remaining as a row speaks a time left: \"2 hours, 5 minutes remaining\". Placeholders in order: TimeFormatting.spoken(remaining).\nText of the time bar under the Library list: the time left to read the listed books. %@ is a time, such as 3:20:00.\nThe sleep timer's state as VoiceOver reads it after \"Sleep timer:\" while it counts down. %@ is the time left in minutes and seconds, such as 4:59.\nTime left in the book as Where Am I? speaks it. %@ is the time in words, such as \"3 hours\".\nTime left in the book as the copied reading position shows it. %@ is a clock time such as 3:44:01.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "quedan %@"
          }
        }
      }
    },
    "%@ remaining at current speed" : {
      "comment" : "Time left in the book as the reader's status row speaks it when no speed is named: it counts at the speed now set. %@ is the time in words, such as \"3 hours, 44 minutes, 1 second\"."
    },
    "%@ remaining in this heading" : {
      "comment" : "Part of the full Where Am I? summary: the time left in the heading being read. %@ is the time in words, such as \"12 minutes\"."
    },
    "%@ remaining in total" : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. The time left in all of a folder's books, or nil when none is known. Example: \"14 hours, 3 minutes remaining in total\". Placeholders in order: TimeFormatting.spoken(remaining)."
    },
    "%@ reset to default: %@" : {
      "comment" : "Announced by VoiceOver after a keyboard shortcut action was given its default keys again. %1$@ is the action's name and %2$@ is its keys in words, such as \"Option + Shift + Command + B\", or \"No shortcut\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ reset to default: %2$@"
          }
        }
      }
    },
    "%@ reset to its default" : {
      "comment" : "Said as a premade filter preset is put back as it came. %@ is the preset's name."
    },
    "%@ seconds" : {
      "comment" : "A length of time in seconds with one decimal digit, such as \"0.5 seconds\". %@ is the already formatted number.\nA number of seconds with decimals inside a spoken duration, such as \"4.2 seconds\" in \"12 minutes, 4.2 seconds\". %@ is the already formatted number."
    },
    "%@ set aside a conflicting copy of %@: “%@”, in %@." : {
      "comment" : "First sentence of the report of a conflicting copy. %1$@ is the sync service's name; %2$@ is a phrase naming the original file; %3$@ is the copy's name; %4$@ is the folder's path.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ set aside a conflicting copy of %2$@: “%3$@”, in %4$@."
          }
        }
      }
    },
    "%@ silent" : {
      "comment" : "Announcement of the microphone level when no sound reaches TextMouth. %@ is the level's label."
    },
    "%@ so far" : {
      "comment" : "How far a feed download's file has come, when its size is not known. %@ is the bytes received so far with their unit, such as 12 MB."
    },
    "%@ stay in their feeds: %@" : {
      "comment" : "What the Move to Library sheet says about several items that stayed in their feeds for one reason. The first %@ is their titles in quotation marks; the second is the reason, a sentence or clause.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ stay in their feeds: %2$@"
          }
        }
      }
    },
    "%@ stays in its feed: %@" : {
      "comment" : "What the Move to Library sheet says about one item that stayed in its feed. The first %@ is its title in quotation marks; the second is the reason, a sentence or clause.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ stays in its feed: %2$@"
          }
        }
      }
    },
    "%@ stops the whole export. Files already written stay." : {
      "comment" : "The last sentence of the alert an export shows when a chapter nests too deeply. %@ is the name of the Cancel Export button."
    },
    "%@ through the book" : {
      "comment" : "What VoiceOver says for the reader's percent button. %@ is the percent, such as 22.9%."
    },
    "%@ to %@" : {
      "comment" : "Part of a spoken audio export's file name: a range of the book. %1$@ is where it begins and %2$@ where it ends, each a heading's words or the beginning or end of the book, as in \"Chapter 1 to Chapter 3\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ to %2$@"
          }
        }
      }
    },
    "%@ to convert its Ogg audio to AAC. Free some space, and TextMouth converts it at the next launch." : {
      "comment" : "Message of the alert about one book's Ogg audio that waits for disk space. %@ is what the book needs, such as \"“Harbor Dramas” needs 4.2 GB free\"."
    },
    "%@ to convert their Ogg audio to AAC. Free some space, and TextMouth converts them at the next launch." : {
      "comment" : "Message of the alert about several books' Ogg audio that waits for disk space. %@ is what each book needs, listed as a sentence lists them, such as \"“A” needs 1 GB free and “B” needs 2 GB free\"."
    },
    "%@ total remaining at current speed" : {
      "comment" : "Part of the time bar's spoken label: the time left for the listed books at the reading speed now set. %@ is a spoken time, such as 3 hours 20 minutes."
    },
    "%@ tries again, %@ quits without saving, %@ keeps TextMouth open." : {
      "comment" : "Last line of the alert's message, saying what each button does. %1$@ is the name of the first button, which tries saving again, %2$@ the name of the second, which quits without saving, and %3$@ the name of the third, which keeps TextMouth open. Keep each name exactly as the buttons show it.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ tries again, %2$@ quits without saving, %3$@ keeps TextMouth open."
          }
        }
      }
    },
    "%@ twice" : {
      "comment" : "A keyboard shortcut that is its key pressed twice quickly, as spoken or shown. %@ is the shortcut, such as \"W\" or \"Command + I\"."
    },
    "%@ use plain http, so others can read or change what they send; TextMouth still loads it." : {
      "comment" : "What the Import OPML sheet says of several new feeds whose addresses use plain http, which is not encrypted. %@ is a list of their titles."
    },
    "%@ uses it in the menus" : {
      "comment" : "The reason, said after \"not recorded\", why a key cannot be a shortcut: a command of the Mac's own menus uses it. %@ is that command's name, such as Quit TextMouth or Copy. Lower case in English, since it follows a colon."
    },
    "%@ uses plain http, so others can read or change what it sends; TextMouth still loads it." : {
      "comment" : "What the Import OPML sheet says of one new feed whose address uses plain http, which is not encrypted. %@ is the feed's title."
    },
    "%@ waits for a network without data limits to refresh by itself." : {
      "comment" : "Why a feed's automatic refresh did not run now: the network has data limits. %@ is the feed's title or server."
    },
    "%@ was connected, so recordings use it." : {
      "comment" : "Said by the Record window when a microphone connects and recordings now use it. %@ is the microphone's name."
    },
    "%@ was connected; choose it in the %@ pop-up to record from it." : {
      "comment" : "Said by the Record window when one microphone connects and is added to the Microphone pop-up. %1$@ is the microphone's name and %2$@ is the pop-up's label.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ was connected; choose it in the %2$@ pop-up to record from it."
          }
        }
      }
    },
    "%@ was disconnected, so recording stopped. What was recorded is kept." : {
      "comment" : "Error in the Record window when the microphone was unplugged while recording. %@ is the microphone's name."
    },
    "%@ was disconnected, so recordings use %@." : {
      "comment" : "Said by the Record window when the chosen microphone is unplugged and another takes its place. %1$@ is the microphone that went away and %2$@ is the one recordings use now.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ was disconnected, so recordings use %2$@."
          }
        }
      }
    },
    "%@ was disconnected. Connect a microphone to record." : {
      "comment" : "Said by the Record window when the chosen microphone is unplugged and no other is connected. %@ is the microphone's name."
    },
    "%@ was not added back: no copy of the text its package held could be kept first, so TextMouth left the text as it was." : {
      "comment" : "Message when adding a book back to the library stopped because no backup of the text it held could be made. %@ is the book's title."
    },
    "%@ wasn't asked for again, because the drive hasn't answered an earlier read" : {
      "comment" : "Why a file could not be read, in Use This Library's account. %@ names the file."
    },
    "%@ wasn't downloaded" : {
      "comment" : "Announcement that Download Now could not bring one book to this Mac. %@ is the book's title."
    },
    "%@ wasn't read within %lld seconds" : {
      "comment" : "Why a file could not be read, in Use This Library's account. %1$@ names the file and %2$lld is how many seconds TextMouth waited, a count.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ wasn't read within %lld second"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ wasn't read within %lld seconds"
                }
              }
            }
          }
        }
      }
    },
    "%@ were connected; choose one in the %@ pop-up to record from it." : {
      "comment" : "Said by the Record window when several microphones connect and are added to the Microphone pop-up. %1$@ is their names as a list and %2$@ is the pop-up's label.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ were connected; choose one in the %2$@ pop-up to record from it."
          }
        }
      }
    },
    "%@ will be removed from the library." : {
      "comment" : "First sentence of a removal confirmation. %@ is what is removed, such as \"“Notes”\" or \"3 books\". A sentence about the files follows."
    },
    "%@ works in %@." : {
      "comment" : "Announced by VoiceOver after the listener chose where a keyboard shortcut works. %1$@ is the action's name and %2$@ names the windows, such as \"every window\" or \"Library windows\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ works in %2$@."
          }
        }
      }
    },
    "%@ writes that chapter as plain paragraphs of its lines, with its quote and list marks kept as characters, and exports everything else as usual." : {
      "comment" : "The second sentence of the alert an export shows when a chapter nests too deeply. %@ is the name of the Export as Written button."
    },
    "%@ writes the text as plain paragraphs of its lines, with its quote and list marks kept as characters, and exports everything else as usual." : {
      "comment" : "The second sentence of the alert an export shows when a book's text, which has no chapter markers, nests too deeply. %@ is the name of the Export as Written button."
    },
    "%@%@ dB" : {
      "comment" : "A level change in decibels with its sign, such as \"+3 dB\" or \"-6 dB\". %1$@ is the sign, \"+\" or \"-\" or nothing, and %2$@ the number, already formatted.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@%2$@ dB"
          }
        }
      }
    },
    "%@, %@" : {
      "comment" : "A braille table in words: its code's name, then how it contracts, in lower case. %1$@ is the code's name, such as Unified English Braille, and %2$@ the contraction, such as uncontracted (Grade 1).\nA heading's description followed by a detail such as its duration. %1$@ is the description, such as \"Chapter One - level 1\"; %2$@ is the detail, such as \"4 minutes\".\nA language's menu item in the transcription language pop-up, with its speech model's status. %1$@ is the language's name, such as \"English (United States)\"; %2$@ is the status: installed, needs download, or not supported.\nJoins a name and a note about it with a comma, such as an encoding or braille code and \"guessed\". %1$@ is the name and %2$@ the note.\nJoins two parts of a label with a comma. %1$@ is the text so far and %2$@ the next part. English puts a comma and a space between them.\nText of the Library window's View pop-up and Go to View. What a window says on going to the view name by Go to View's key or menu item: the name, then counts, what the view lists there (CountWording.listItems(of:feeds:)), as \"All Items, 743 books, 2 feeds\". Placeholders in order: name, counts.\nThe microphone level spoken in the Record window. %1$@ is the level in decibels in words, such as \"minus 12 decibels\", and %2$@ is a word for how loud that is, such as \"good\".\nThe right side of a row in the Library views settings: whether the view is built in or custom, then when it shows. %1$@ is built in or custom and %2$@ is its visibility, such as \"always\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%@, %@ quality" : {
      "comment" : "VoiceOver label of a voice in the voice pop-up. %1$@ is the voice's name and %2$@ is its quality, such as Enhanced.\nWhat VoiceOver says for a voice in the voice sheet's menu. %1$@ is the voice's name; %2$@ is its quality, such as Enhanced.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@ quality"
          }
        }
      }
    },
    "%@, %@, %@, %lld of %lld" : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). A view's row as VoiceOver reads it and a braille display shows it, in one element: \"Reading List, built in, always, 5 of 6\". %1$@ is the view's name, %2$@ is the word built in or custom, %3$@ is its visibility in lower case (always, when applicable, hidden), %4$lld is its place in the list and %5$lld the number of views.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@, %3$@, %4$lld of %5$lld"
          }
        }
      }
    },
    "%@, %@, at %@" : {
      "comment" : "A pause's row in the audio editor's list. %1$@ is the pause such as \"Pause 2\", %2$@ its length in words, and %3$@ its start in words.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@, at %3$@"
          }
        }
      }
    },
    "%@, %@, in %@" : {
      "comment" : "VoiceOver label of a search match: the match in its text, where it is in the book, then the book. %1$@ is the match in its surrounding text, %2$@ is its place, such as a chapter's title, and %3$@ is the book's title.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@, in %3$@"
          }
        }
      }
    },
    "%@, %lld of %lld" : {
      "comment" : "A question's title, a comma, then its place among the questions waiting. %1$@ is the title, %2$lld the question's place and %3$lld the number of questions, such as \"Duplicate Book Found, 2 of 3\".\nText of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). What VoiceOver says after a move: the view and its new place, \"Reading List, 4 of 6\", short enough to hear after each of many moves. Placeholders in order: name, number, count.\nVoiceOver announcement after a book moved one place in an order the user arranges. %1$@ is the book's title. %2$lld is its new place, counted from 1. %3$lld is how many books the order holds.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$lld of %3$lld"
          }
        }
      }
    },
    "%@, %lld unopened" : {
      "comment" : "Speak Info and Folder Settings: how many books a folder holds and how many of them were never opened. %1$@ is the count of books, such as \"12 books\", and %2$lld is how many are unopened, a count.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@, %lld unopened"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@, %lld unopened"
                }
              }
            }
          }
        }
      }
    },
    "%@, and %lld in all" : {
      "comment" : "Note on a finished search's status: the list also stops after this many matches in all. %1$@ is the note \"showing up to 20 in each book\", and %2$lld is the number of matches shown in all.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@, and %lld in all"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@, and %lld in all"
                }
              }
            }
          }
        }
      }
    },
    "%@, and %lld more" : {
      "comment" : "The first three titles of the feed items that were left where they are, then how many others there were. %1$@ is the three titles, in quotes, separated by commas. %2$lld is how many more.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@, and %lld more"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@, and %lld more"
                }
              }
            }
          }
        }
      }
    },
    "%@, any subfolders, and the %lld books inside will be removed from the library." : {
      "comment" : "First sentence of the second confirmation that deletes a folder holding several books. %1$@ is the folder's name in quotation marks and %2$lld is how many books, a count.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@, any subfolders, and the %lld book inside will be removed from the library."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@, any subfolders, and the %lld books inside will be removed from the library."
                }
              }
            }
          }
        }
      }
    },
    "%@, any subfolders, and the book inside will be removed from the library." : {
      "comment" : "First sentence of the second confirmation that deletes a folder holding one book. %@ is the folder's name in quotation marks."
    },
    "%@, ascending" : {
      "comment" : "A sort, spoken: a sort field and its direction. %@ is the sort field's name, such as Title or Date Added. Used inside announcements and labels about the sort."
    },
    "%@, at %@" : {
      "comment" : "VoiceOver label and rotor entry of a search result in a transcribed audiobook. %1$@ is the match with its context and place, and %2$@ is the time it is heard, spoken.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, at %2$@"
          }
        }
      }
    },
    "%@, at %@ into book" : {
      "comment" : "VoiceOver label of a search result placed by an estimated time. %1$@ is the match with its context and place, and %2$@ is the time into the book, spoken.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, at %2$@ into book"
          }
        }
      }
    },
    "%@, at %@ percent of book" : {
      "comment" : "VoiceOver label of a search result placed by percentage. %1$@ is the match with its context and place, and %2$@ is the percentage through the book with one decimal digit, such as 12.5.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, at %2$@ percent of book"
          }
        }
      }
    },
    "%@, at %@." : {
      "comment" : "Said as the audio editor's cursor goes to a marker, and its row's label. %1$@ is the marker's name such as \"Marker 3\" or \"Marker 3, Intro\", and %2$@ its time in words.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, at %2$@."
          }
        }
      }
    },
    "%@, by %@" : {
      "comment" : "A book's title and author in a search result's heading. %1$@ is the book's title and %2$@ its author.\nHeading of a track whose performer is not the book's author, made at import: the title, a comma, then \"by\" and the performer. %1$@ is the track's title and %2$@ the performer. The comma makes VoiceOver pause.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, by %2$@"
          }
        }
      }
    },
    "%@, by %@, %@, in %@, added %@" : {
      "comment" : "A duplicate book's row, spoken and shown as one label in Find Duplicate Books. %1$@ is the title, %2$@ the author, %3$@ the format, %4$@ the library folder it is in, and %5$@ the date it was added.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, by %2$@, %3$@, in %4$@, added %5$@"
          }
        }
      }
    },
    "%@, descending" : {
      "comment" : "A sort, spoken: a sort field and its direction. %@ is the sort field's name, such as Title or Date Added. Used inside announcements and labels about the sort."
    },
    "%@, edited by hand" : {
      "comment" : "What VoiceOver says for a field of the book information sheet that the user edited by hand. %@ is the field's name, such as \"Book title\"."
    },
    "%@, hidden" : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). What VoiceOver says after a row's action or the context menu gives the view name a visibility (finding 12): \"Feeds, hidden\", \"Feeds, shown always\", \"Feeds, shown when applicable\". The pop-up says its own new value. This is the case .hidden. Placeholders in order: name."
    },
    "%@, in %@" : {
      "comment" : "A braille table in words, then the language it is in. %1$@ is the table in words, such as Unified English Braille, uncontracted, and %2$@ the language's name, such as English.\nVoiceOver label of a search match whose place in the book is unknown. %1$@ is the match in its surrounding text, and %2$@ is the book's title.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, in %2$@"
          }
        }
      }
    },
    "%@, nothing matches this view now." : {
      "comment" : "VoiceOver announcement on going, by Go to View, to a filter view that lists nothing now. %@ is the view's name. It says the words of the empty row such a view shows (\"Nothing matches this view now.\"), in lower case after the name."
    },
    "%@, recorded for %@" : {
      "comment" : "Announced by VoiceOver after a key became a keyboard shortcut. %1$@ is the key in words, such as \"Shift + R\" or \"W twice\", and %2$@ is the action's name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, recorded for %2$@"
          }
        }
      }
    },
    "%@, shown always" : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). What VoiceOver says after a row's action or the context menu gives the view name a visibility (finding 12): \"Feeds, hidden\", \"Feeds, shown always\", \"Feeds, shown when applicable\". The pop-up says its own new value. This is the case .always. Placeholders in order: name."
    },
    "%@, shown when applicable" : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). What VoiceOver says after a row's action or the context menu gives the view name a visibility (finding 12): \"Feeds, hidden\", \"Feeds, shown always\", \"Feeds, shown when applicable\". The pop-up says its own new value. This is the case .whenApplicable. Placeholders in order: name."
    },
    "%@, then %@" : {
      "comment" : "Joins two steps of the restart gesture's summary in the Miscellaneous settings. %1$@ is the steps so far and %2$@ is the next step, such as \"Previous track, then Play\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, then %2$@"
          }
        }
      }
    },
    "%@, then %@." : {
      "comment" : "What to do about a refusal, then what to do next. The first %@ is a request such as \"Close it\" or \"Wait until the export ends\"; the second is the next step, such as \"try again\" or \"choose Delete Feed… again\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, then %2$@."
          }
        }
      }
    },
    "%@, where %@ leads" : {
      "comment" : "A folder's real path followed by the link that leads to it. %1$@ is the real path; %2$@ is the link's path.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, where %2$@ leads"
          }
        }
      }
    },
    "%@, which leads to %@" : {
      "comment" : "A link's path followed by the real folder it leads to. %1$@ is the link's path; %2$@ is the real path.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, which leads to %2$@"
          }
        }
      }
    },
    "%@-bit floating-point" : {
      "comment" : "An audio file's sample form, an adjective of \"samples\" in a refusal such as \"uses 16-bit floating-point samples\". %@ is the number of bits, an identifier written without digit grouping."
    },
    "%@-bit integer" : {
      "comment" : "An audio file's sample form, an adjective of \"samples\" in a refusal such as \"uses 64-bit integer samples\". %@ is the number of bits, an identifier written without digit grouping."
    },
    "%@." : {
      "comment" : "A spoken clause of an announcement ended with a full stop. %@ is the clause. English adds a full stop; change only the mark.\nEnds a line about waiting downloads as a sentence of its own. %@ is the line, such as \"2 waiting for room on this Mac\".\nEnds a line of a progress display with its full stop, so VoiceOver reads the lines as sentences. %@ is the line.\nEnds a sentence with its full stop. %@ is the sentence without it. Chinese and Japanese use their own full stop here.\nEnds a title with a full stop so it reads as a sentence before the question that follows. %@ is the title.\nEnds the notifications setting's hint with a full stop, before the sentence that says notifications are refused. %@ is the hint, without its full stop.\nLibrary view editor: ends a filter's description with a full stop. %@ is the whole description.\nLibrary view editor: the note shown in place of the sort choice while the view lists feeds alone. %@ is a sentence without its full stop, saying feeds are always listed by title; this adds the full stop.\nMakes a clause into a whole sentence by adding its full stop. %@ is the clause, already starting with a capital letter.\nVoiceOver announcement of Next in Folder or Previous in Folder when no item lies that way. %@ is a sentence without its full stop, such as \"No more books in folder\"; this adds the full stop."
    },
    "%@. %@" : {
      "comment" : "Joins two spoken clauses of an announcement. %1$@ is the clauses so far and %2$@ the next one. English ends the first with a full stop and a space; a language that writes no full stop, or another mark, changes only that.\nWhat VoiceOver says when the Library Not Available screen appears. %1$@ is the screen's heading; %2$@ is why the library can't be used.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. %2$@"
          }
        }
      }
    },
    "%@:" : {
      "comment" : "Caption beside the headings sheet's level filter. %@ is the filter's label; the colon follows it as the language writes a label before a control."
    },
    "%@: %@" : {
      "comment" : "A label and its value on one line, such as \"Elapsed: 1:04\". %1$@ is the label and %2$@ its value. English puts a colon and a space between them.\nA label, a colon, and its value, as one line of the audio editor's sheets and the filter presets. %1$@ is the label and %2$@ the value.\nA name, a colon, and its value, such as a keyboard shortcut action's name and its keys, or a control's label and its value. %1$@ is the name and %2$@ is the value.\nThe name of a keyboard shortcut action with the name of its group before it, such as an audio editor action. %1$@ is the group's name and %2$@ the action's own name.\nTitle of a reader window for a book whose author is unknown. %1$@ is the word that begins it (\"Book\" or \"Reading List\"); %2$@ is the book's title.\nTitle of the reader's sheet for a book's own settings. %1$@ is the sheet's name, \"Audio Settings\" or \"Voice & Speed\"; %2$@ is the book's title.\nWhat VoiceOver says for a detail of Book Information. %1$@ is the detail's label; %2$@ is its value.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@"
          }
        }
      }
    },
    "%@: %@ by %@" : {
      "comment" : "Title of a reader window. %1$@ is the word that begins it (\"Book\" or \"Reading List\"); %2$@ is the book's title; %3$@ is the book's author.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@ by %3$@"
          }
        }
      }
    },
    "%@: %@ dB peak, %@ dB average, %@" : {
      "comment" : "The microphone level line of the Record window while recording. %1$@ is the level's label, %2$@ is the loudest sample's level in decibels with a minus sign, %3$@ is the average level in decibels, and %4$@ is a word for how loud that is, such as \"good\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@ dB peak, %3$@ dB average, %4$@"
          }
        }
      }
    },
    "%@: %@, changed from its default" : {
      "comment" : "A filter preset's row as VoiceOver reads it, for a premade preset the user changed. %1$@ is the preset's name and %2$@ its chain of filters, in filter syntax.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
