        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se puede leer la transcripción. Si el libro solo está en la nube, descárgalo y vuelve a intentarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "رونوشت خوانده نمی‌شود. اگر کتاب فقط در فضای ابری است، آن را بارگیری کنید و دوباره تلاش کنید."
