            "value" : "रिकॉर्डिंग सहेजी नहीं जा सकी: %1$@ यह रखी हुई है; %2$@ या %3$@ चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rekaman tidak dapat disimpan: %1$@ Rekaman tetap disimpan; pilih %2$@ atau %3$@."
