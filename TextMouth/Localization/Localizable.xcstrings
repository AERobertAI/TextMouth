        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo compactado contém %1$@ arquivos e pastas, mais do que os %2$@ que o TextMouth extrai em uma importação."
          }
        }
      }
    },
    "The archive holds a file whose path leads outside it, which is never extracted." : {
      "comment" : "Why an archive was refused at import: it holds a file whose path climbs out of the folder it is extracted into.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Archiv enthält eine Datei, deren Pfad aus dem Archiv herausführt; sie wird nie entpackt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo comprimido contiene un archivo cuya ruta sale de él, que nunca se extrae."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’archive contient un fichier dont le chemin mène à l’extérieur, qui n’est jamais extrait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’archivio contiene un file il cui percorso porta fuori dall’archivio; non viene mai estratto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo compactado contém um arquivo cujo caminho leva para fora dele, o que nunca é extraído."
          }
        }
      }
    },
    "The archive holds a link to a file outside it, which is never extracted." : {
      "comment" : "Why an archive was refused at import: it holds a symbolic link to a file outside it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Archiv enthält einen Link auf eine Datei außerhalb des Archivs; er wird nie entpackt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo comprimido contiene un enlace a un archivo fuera de él, que nunca se extrae."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’archive contient un lien vers un fichier extérieur à elle, qui n’est jamais extrait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’archivio contiene un collegamento a un file esterno; non viene mai estratto."
