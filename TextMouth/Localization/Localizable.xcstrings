    },
    "Heavy" : {
      "comment" : "The name of punctuation pause level 3: periods, commas, and paragraph breaks pause."
    },
    "Help" : {
      "comment" : "Name of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Help\"."
    },
    "Hidden" : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). A visibility as the Visibility pop-up names it: \"Always\", \"When Applicable\", or \"Hidden\". This is the case .hidden."
    },
    "Hide" : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). The command that gives a view visibility: \"Show Always\", \"Show When Applicable\", or \"Hide\". This is the case .hidden."
    },
    "Hide Others" : {
      "comment" : "Name of the application menu's Hide Others command, in a sentence saying why a keyboard shortcut cannot take its key."
    },
    "Hide TextMouth" : {
      "comment" : "Name of the application menu's Hide command, in a sentence saying why a keyboard shortcut cannot take its key."
    },
    "Hides jump to page controls" : {
      "comment" : "Hint of the status row's page button while the jump to page panel is open."
    },
    "Hides jump to percent controls" : {
      "comment" : "Hint of the reader's percent button while the jump to percent panel is open."
    },
    "Hides jump to time controls" : {
      "comment" : "Hint of the reader's time button while the jump to time panel is open."
    },
    "Hides this notice without saving anything." : {
      "comment" : "First sentence of the VoiceOver hint of the failure banner's Dismiss button."
    },
    "Hold Shift while skipping to use a secondary skip amount." : {
      "comment" : "Explanation under the Shift+Skip pop-ups in the Playback settings. Shift is the key's name."
    },
    "Home" : {
      "comment" : "Name of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Home\"."
    },
    "Hours between refreshes while TextMouth runs, from 1 to 168" : {
      "comment" : "VoiceOver hint of the refresh interval's number field and stepper. The range is the limits of the number, in hours."
    },
    "How a BRF or BRL file writes each braille cell. Most files use North American Braille ASCII." : {
      "comment" : "The hint of the braille file characters pop-up in the Braille tab of Settings. BRF and BRL are braille file formats, and North American Braille ASCII is the name of a braille character code."
    },
    "How fast the voice speaks in the file. It starts at the book's speed." : {
      "comment" : "The hint of the Speed slider in the Export dialog's spoken audio options."
    },
    "How high the voice sounds in the file. It starts at the book's pitch." : {
      "comment" : "The hint of the Pitch slider in the Export dialog's spoken audio options."
    },
    "How long media commands are blocked after a Bluetooth device disconnects. Raise it if playback resumes after removing headphones." : {
      "comment" : "Explanation under the Bluetooth disconnect delay slider in the Miscellaneous settings."
    },
    "How many braille cells each line holds, from 18 to 80." : {
      "comment" : "The hint of the Cells per line stepper in the Export dialog's braille options."
    },
    "How many lines each braille page holds, from 4 to 50." : {
      "comment" : "The hint of the Lines per page stepper in the Export dialog's braille options."
    },
    "How many of the newest" : {
      "comment" : "Label of the number field and stepper that say how many of a feed's newest items are listed or downloaded."
    },
    "How soon a second press must follow the first. A key with different single and double press actions waits this long before its single press acts." : {
      "comment" : "Hint of the double press time stepper in Settings: what the time is, and that a key that has one action for a single press and another for a double press waits for that time before acting on a single press."
    },
    "How the BRF writes each braille cell. Most braille displays and embossers read North American Braille ASCII; those set up for German read Eurobraille. To share with a reader elsewhere, export a PEF." : {
      "comment" : "The hint of the braille file characters pop-up in the Export dialog's braille options. BRF and PEF are braille file formats, and North American Braille ASCII and Eurobraille are names of braille character codes."
    },
    "ISBN" : {
      "comment" : "Name of the book information sheet's row that shows a book's ISBN, its international book number."
    },
    "ISBN: %@" : {
      "comment" : "The shared value of a group of duplicate books that match by ISBN, in the group's heading. %@ is the ISBN. ISBN stays as written.\nWhat VoiceOver says for the book information sheet's ISBN row. %@ is the book's ISBN."
    },
    "Identical File (MD5)" : {
      "comment" : "A match criterion of Find Duplicate Books: the files' contents are exactly the same. MD5 is the name of the checksum used to compare them."
    },
    "Identifier" : {
      "comment" : "Name of the book information sheet's row that shows a book's identifier, a code that names it."
    },
    "Identifier: %@" : {
      "comment" : "What VoiceOver says for the book information sheet's identifier row. %@ is the book's identifier code."
    },
    "If %@ arrives from %@ later, %@ may keep two copies of it." : {
      "comment" : "Last sentence of the question asked before opening the library without its index file. %1$@ is the index file's name, which stays as written; %2$@ and %3$@ are the cloud service's name, or \"the cloud\" when it is unknown.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If %1$@ arrives from %2$@ later, %3$@ may keep two copies of it."
          }
        }
      }
    },
    "If it is gone, choose %@." : {
      "comment" : "Last sentence of why the library can't open, pointing to the button that opens it anyway. %@ is that button's name, without its ellipsis. \"It\" is the missing file."
    },
    "If the file arrives from %@ later, it names the same library." : {
      "comment" : "Last sentence of the question asked before restoring the library's identity file. %@ is the cloud service's name, or \"the cloud\" when it is unknown."
    },
    "If the file is not written in %@, TextMouth refuses it, and nothing changes." : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. What the alert says first of a choice to or from Unicode braille patterns, which the re-read checks byte by byte before it changes anything (BrailleBookReader.requireReadable(_:as:)), so a wrong one is refused at its first line (review of October 30, finding 5): a file not written in the code named codeName, the one chosen, is refused, and nothing changes. \"If the file is not written in Unicode braille patterns, TextMouth refuses it, and nothing changes.\". Placeholders in order: codeName."
    },
    "If the library's own %@ arrives from %@ later, %@ may keep two copies of it, and this Mac and the other would disagree about which library this is." : {
      "comment" : "Last sentence of the question asked before giving the library a new identity file. %1$@ is the identity file's name, which stays as written; %2$@ and %3$@ are the cloud service's name, or \"the cloud\" when it is unknown.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If the library's own %1$@ arrives from %2$@ later, %3$@ may keep two copies of it, and this Mac and the other would disagree about which library this is."
          }
        }
      }
    },
    "Ignored When Typing" : {
      "comment" : "A choice of the Leading Articles pop-up: a title's leading article does not count when typing a title's first letters, but the list keeps its order."
    },
    "Ignored When Typing and Sorting" : {
      "comment" : "A choice of the Leading Articles pop-up: a title's leading article does not count when typing or when sorting."
    },
    "Import" : {
      "comment" : "Title of the button of the Import Folder panel that imports the chosen folders.\nTitle of the button that starts an import, such as an OPML file of subscriptions."
    },
    "Import Behavior" : {
      "comment" : "Heading of the section of Storage settings about what an import does."
    },
    "Import Folder" : {
      "comment" : "Title of the panel that chooses folders to import. Title case."
    },
    "Import Folder…" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Library group and read by VoiceOver. Imports a DAISY book, or a folder of audio tracks, as a book. Also the title of the menu command of the same name."
    },
    "Import OPML…" : {
      "comment" : "Title of the Library menu's command that imports an OPML file of subscriptions. The ellipsis says a panel follows. OPML is a file format; keep it."
    },
    "Import Subscriptions" : {
      "comment" : "Heading of the sheet that imports an OPML file of subscriptions. Title case."
    },
    "Import cancelled after %@." : {
      "comment" : "Sentence of the alert about a ZIP batch the reader cancelled partway. %@ is how many of how many books were done, such as \"3 of 10 books\"."
    },
    "Import cancelled while extracting the archive, before any book was imported." : {
      "comment" : "Sentence of the alert about a ZIP batch the reader cancelled while its archive was still being extracted."
    },
    "Import failed: %@" : {
      "comment" : "Why an import failed. %@ is the reason, a sentence."
    },
    "Import it again, which asks about the duplicate, and choose Replace Existing so that the copy stored in the data directory takes its place, or remove it from the library, then move the data directory again." : {
      "comment" : "Last sentence of why a move of the data directory was refused: what to do. Replace Existing is the name of a button in the duplicate question. \"It\" is the book."
    },
    "Import questions can't be answered while the library is moving." : {
      "comment" : "First sentence of what an import question says when it is answered while the library is being moved."
    },
    "Imported %lld books, but %@" : {
      "comment" : "Sentence of the alert about a ZIP batch that left something out. %1$lld is the number of books imported and %2$@ the sections that say what failed or is missing, each a heading and a line for each entry.",
