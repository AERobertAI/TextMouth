    },
    "The search couldn't be sent, because the directory's address isn't a web address." : {
      "comment" : "Why a podcast search failed: the directory's address is not an http or https address.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo enviar la búsqueda, porque la dirección del directorio no es una dirección web."
