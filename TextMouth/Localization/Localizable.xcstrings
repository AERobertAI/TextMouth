            "value" : "원본 파일이 유지되었습니다. TextMouth는 압축 파일 “%2$@”에서 DAISY 책 “%1$@”만 가져왔습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O arquivo original foi mantido: o TextMouth importou apenas o livro DAISY “%1$@” do arquivo compactado “%2$@”."
          }
        },
        "ru" : {
          "stringUnit" : {
