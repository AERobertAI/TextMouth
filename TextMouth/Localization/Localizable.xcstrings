    "pronunciationLexicon.importHint" : {
      "comment" : "VoiceOver hint of the Import Rules button in Settings, Text, Substitutions: what is added and what is left out.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يضيف إدخالات القاموس بعد قواعدك؛ وتُستبعد الإدخالات التي تقتصر على تهجئة صوتية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আপনার নিয়মগুলোর পরে লেক্সিকনের এন্ট্রিগুলো যোগ করে; শুধু ধ্বনিগত বানানের এন্ট্রি আলাদা করে রাখা হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fügt die Einträge des Lexikons nach deinen Regeln hinzu; Einträge nur mit phonetischer Schreibweise werden übergangen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds the lexicon's entries after your rules; entries with only a phonetic spelling are set aside"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Agrega las entradas del léxico después de tus reglas; las entradas con solo una notación fonética se dejan aparte"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ورودی‌های واژه‌نامه را بعد از قاعده‌های شما اضافه می‌کند؛ ورودی‌هایی که فقط املای آوایی دارند کنار گذاشته می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ajoute les entrées du lexique après vos règles ; les entrées qui ne donnent qu’une orthographe phonétique sont écartées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מוסיף את רשומות המילון אחרי הכללים שלך; רשומות עם איות פונטי בלבד מדולגות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लेक्सिकन की प्रविष्टियों को आपके नियमों के बाद जोड़ता है; केवल ध्वन्यात्मक वर्तनी वाली प्रविष्टियाँ अलग रखी जाती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menambahkan entri leksikon setelah aturan Anda; entri yang hanya berisi ejaan fonetik dikesampingkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aggiunge le voci del lessico dopo le tue regole; le voci con la sola ortografia fonetica vengono messe da parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "既存のルールの後に辞書のエントリを追加します。発音の表記だけのエントリは除外されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "내 규칙 뒤에 어휘집의 항목을 추가하며, 음성 표기만 있는 항목은 제외됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voegt de vermeldingen van het lexicon toe na je regels; vermeldingen met alleen een fonetische spelling worden overgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dodaje wpisy leksykonu po dotychczasowych regułach; wpisy tylko z zapisem fonetycznym są pomijane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Adiciona as entradas do léxico depois das suas regras; entradas só com grafia fonética são ignoradas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Добавляет элементы лексикона после ваших правил; элементы только с фонетическим написанием пропускаются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lägger till lexikonets poster efter dina regler; poster med enbart fonetisk stavning lämnas utanför."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เพิ่มรายการของพจนานุกรมต่อจากกฎของคุณ รายการที่มีเฉพาะการสะกดตามหน่วยเสียงจะถูกข้ามไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sözlüğün girdilerini kurallarınızdan sonra ekler; yalnızca fonetik yazımı olan girdiler ayrı tutulur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Додає записи словника після ваших правил; записи лише з фонетичним написанням пропускаються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لغت کے اندراجات آپ کے اصولوں کے بعد شامل کرتا ہے؛ صرف صوتی ہجے والے اندراجات الگ رکھے جاتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thêm các mục của từ điển phát âm sau các quy tắc của bạn; các mục chỉ có phiên âm sẽ được bỏ qua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在你的规则之后添加词典中的词条；只有音标拼写的词条会被略过。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在你的規則之後加入詞典的詞條；只有音標的詞條會被略過。"
          }
        }
      }
    },
