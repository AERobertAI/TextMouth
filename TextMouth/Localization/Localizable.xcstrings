    "folderRemoval.feedsChoiceSentences.moves" : {
      "comment" : "Sentence of the dialog that asks how to delete a folder that holds one feed's folder. \"Move Contents Out\" is the name of one of its buttons.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عند اختيار “نقل المحتويات إلى الخارج”، ينتقل مجلد الموجز مع البقية."
          }
        },
        "bn" : {
