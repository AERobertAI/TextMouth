    "To let it go, take it off the reading list, or clear %@ in the Reading List's options." : {
      "comment" : "Last sentence of why Stop Keeping on This Mac cannot let a book go: the reading list keeps it. %@ is the name of the Reading List's option that keeps its books downloaded, as the option shows it.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لإتاحة التخلي عنه، أزله من قائمة القراءة، أو امسح %@ في خيارات قائمة القراءة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এটিকে ছেড়ে দিতে পড়ার তালিকা থেকে সরান, অথবা পড়ার তালিকার বিকল্পে %@ অচিহ্নিত করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um es freizugeben, nimm es von der Leseliste oder deaktiviere %@ in den Optionen der Leseliste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para soltarlo, quítalo de la lista de lectura, o desactiva %@ en las opciones de la lista de lectura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pour le laisser partir, retirez-le de la liste de lecture, ou décochez %@ dans les options de la liste de lecture."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "उसे जाने देने के लिए, उसे रीडिंग लिस्ट से हटाएँ, या रीडिंग लिस्ट के विकल्पों में %@ को अचयनित करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Untuk melepasnya, keluarkan dari daftar bacaan, atau kosongkan %@ di opsi Daftar Bacaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Per lasciarlo andare, toglilo dall’elenco di lettura, oppure disattiva %@ nelle opzioni dell’elenco di lettura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "この Mac での保持を解除するには、リーディングリストから外すか、リーディングリストのオプションで「%@」の選択を解除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관을 해제하려면 읽기 목록에서 제거하거나 읽기 목록 옵션에서 %@을(를) 해제하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para soltá-lo, tire-o da lista de leitura ou desmarque %@ nas opções da Lista de leitura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Чтобы она не хранилась на этом Mac, уберите её из списка для чтения или снимите отметку «%@» в параметрах списка для чтения."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Щоб вона перестала зберігатися, вилучіть її зі списку читання або зніміть позначку «%@» у параметрах списку читання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "要让它不再保留，请将它从阅读列表中移除，或在阅读列表的选项中取消勾选 %@。"
          }
        }
      }
    },
    "To let them go, take them off the reading list, or clear %@ in the Reading List's options." : {
      "comment" : "Last sentence of why Stop Keeping on This Mac cannot let several books go: the reading list keeps them. %@ is the name of the Reading List's option that keeps its books downloaded, as the option shows it.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لإتاحة التخلي عنها، أزلها من قائمة القراءة، أو امسح %@ في خيارات قائمة القراءة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সেগুলোকে ছেড়ে দিতে পড়ার তালিকা থেকে সরান, অথবা পড়ার তালিকার বিকল্পে %@ অচিহ্নিত করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um sie freizugeben, nimm sie von der Leseliste oder deaktiviere %@ in den Optionen der Leseliste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para soltarlos, quítalos de la lista de lectura, o desactiva %@ en las opciones de la lista de lectura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pour les laisser partir, retirez-les de la liste de lecture, ou décochez %@ dans les options de la liste de lecture."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "उन्हें जाने देने के लिए, उन्हें रीडिंग लिस्ट से हटाएँ, या रीडिंग लिस्ट के विकल्पों में %@ को अचयनित करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Untuk melepasnya, keluarkan dari daftar bacaan, atau kosongkan %@ di opsi Daftar Bacaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Per lasciarli andare, toglili dall’elenco di lettura, oppure disattiva %@ nelle opzioni dell’elenco di lettura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "それらの保持を解除するには、リーディングリストから外すか、リーディングリストのオプションで「%@」の選択を解除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관을 해제하려면 읽기 목록에서 제거하거나 읽기 목록 옵션에서 %@을(를) 해제하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para soltá-los, tire-os da lista de leitura ou desmarque %@ nas opções da Lista de leitura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Чтобы они не хранились на этом Mac, уберите их из списка для чтения или снимите отметку «%@» в параметрах списка для чтения."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Щоб вони перестали зберігатися, вилучіть їх зі списку читання або зніміть позначку «%@» у параметрах списку читання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "要让它们不再保留，请将它们从阅读列表中移除，或在阅读列表的选项中取消勾选 %@。"
          }
