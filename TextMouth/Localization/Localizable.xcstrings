          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%@» è in fase di esportazione. %@, poi %@."
          }
        }
      }
    },
    "“%@” is not a complete, valid XML file." : {
      "comment" : "Message of the alert when a file chosen as a pronunciation lexicon is not valid XML. %@ is the file's name.",
      "localizations" : {
        "es" : {
