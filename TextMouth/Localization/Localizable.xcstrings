    "metadataEditor.notInLibrary" : {
      "comment" : "First sentence of the message when the book being edited left the library. %@ is the book's title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّر حفظ البيانات الوصفية: “%@” لم يعد في المكتبة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "মেটাডেটা সংরক্ষণ করা যায়নি: “%@” আর লাইব্রেরিতে নেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Metadaten konnten nicht gesichert werden: „%@“ ist nicht mehr in der Bibliothek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not save metadata: “%@” is no longer in the library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudieron guardar los metadatos: “%@” ya no está en la biblioteca."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فراداده ذخیره نشد: «%@» دیگر در کتابخانه نیست."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossible d’enregistrer les métadonnées : « %@ » n’est plus dans la bibliothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא ניתן היה לשמור מטא-נתונים: “%@” אינו נמצא עוד בספרייה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "मेटाडेटा सहेजा नहीं जा सका: “%@” अब लाइब्रेरी में नहीं है।"
          }
        },
        "id" : {
