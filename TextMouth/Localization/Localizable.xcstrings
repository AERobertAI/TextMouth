    "recording.microphonesConnected.wasChoose" : {
      "comment" : "Said by the Record window when one microphone connects and is added to the Microphone pop-up. %1$@ is the microphone's name and %2$@ is the pop-up's label.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم توصيل %1$@؛ اختره من قائمة %2$@ المنبثقة للتسجيل منه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ সংযুক্ত হয়েছে; এটি থেকে রেকর্ড করতে %2$@ পপ-আপে এটি বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ wurde verbunden; wähle es im Einblendmenü „%2$@“ aus, um damit aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ was connected; choose it in the %@ pop-up to record from it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ se conectó; elígelo en el menú emergente %2$@ para grabar con él."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ وصل شد؛ برای ضبط از آن، آن را در منوی بازشوی %2$@ انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Microphone connecté : %1$@. Pour l’utiliser, choisissez-le dans le menu local %2$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ חובר; בחר אותו בתפריט הקופץ “%2$@” כדי להקליט ממנו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ को कनेक्ट किया गया; इससे रिकॉर्ड करने के लिए %2$@ पॉप-अप में इसे चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ tersambung; pilih di menu pop-up %2$@ untuk merekam darinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Microfono %1$@ collegato; scegli questo microfono nel menu a comparsa %2$@ per registrare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@が接続されました。録音するには、「%2$@」ポップアップメニューで選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@이(가) 연결되었습니다. 이 마이크로 녹음하려면 %2$@ 팝업 메뉴에서 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ is aangesloten; kies de microfoon in het pop-upmenu %2$@ om ermee op te nemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mikrofon %1$@ został podłączony; wybierz go w przycisku rozwijanym %2$@, aby z niego nagrywać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ foi conectado; escolha-o no menu local %2$@ para gravar com ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Микрофон «%1$@» подключён. Выберите его во всплывающем меню «%2$@», чтобы вести с него запись."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ anslöts. Välj den i popupknappen %2$@ för att spela in från den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เชื่อมต่อ %1$@ แล้ว ให้เลือกในเมนูป๊อปอัป %2$@ เพื่อบันทึกเสียงจากอุปกรณ์นี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ bağlandı; bundan kayıt yapmak için %2$@ açılır menüsünden seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Мікрофон %1$@ підключено; виберіть його в спливному меню «%2$@», щоб записувати з нього."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ جڑ گیا؛ اس سے ریکارڈ کرنے کے لیے %2$@ پاپ اپ میں اسے منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đã kết nối %1$@; chọn thiết bị trong nút bật lên %2$@ để ghi âm từ đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 已连接；若要用它录音，请在“%2$@”弹出式菜单中选取它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 已連接；請在「%2$@」彈出式選單中選擇它來錄音。"
          }
        }
      }
    },
    "recording.microphonesConnected.were" : {
      "comment" : "Said by the Record window when several microphones connect and are added to the Microphone pop-up. %1$@ is their names as a list and %2$@ is the pop-up's label.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم توصيل %1$@؛ اختر أحدها من قائمة %2$@ المنبثقة للتسجيل منه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ সংযুক্ত হয়েছে; একটি থেকে রেকর্ড করতে %2$@ পপ-আপে সেটি বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ wurden verbunden; wähle im Einblendmenü „%2$@“ eines aus, um damit aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ were connected; choose one in the %@ pop-up to record from it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ se conectaron; elige uno en el menú emergente %2$@ para grabar con él."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ وصل شدند؛ برای ضبط از یکی از آن‌ها، آن را در منوی بازشوی %2$@ انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Microphones connectés : %1$@. Pour en utiliser un, choisissez-le dans le menu local %2$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ חוברו; בחר אחד מהם בתפריט הקופץ “%2$@” כדי להקליט ממנו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ को कनेक्ट किया गया; इनसे रिकॉर्ड करने के लिए %2$@ पॉप-अप में कोई एक चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ tersambung; pilih salah satunya di menu pop-up %2$@ untuk merekam darinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Microfoni collegati: %1$@; scegline uno nel menu a comparsa %2$@ per registrare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@が接続されました。録音に使うマイクを「%2$@」ポップアップメニューで選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@이(가) 연결되었습니다. 녹음하려면 %2$@ 팝업 메뉴에서 하나를 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ zijn aangesloten; kies er een in het pop-upmenu %2$@ om ermee op te nemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Podłączono mikrofony: %1$@; wybierz jeden w przycisku rozwijanym %2$@, aby z niego nagrywać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ foram conectados; escolha um deles no menu local %2$@ para gravar com ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Подключены микрофоны: %1$@. Выберите один из них во всплывающем меню «%2$@», чтобы вести с него запись."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ anslöts. Välj en av dem i popupknappen %2$@ för att spela in från den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เชื่อมต่อ %1$@ แล้ว ให้เลือกหนึ่งรายการในเมนูป๊อปอัป %2$@ เพื่อบันทึกเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ bağlandı; bunlardan birinden kayıt yapmak için %2$@ açılır menüsünden seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Підключено мікрофони: %1$@; виберіть один зі спливного меню «%2$@», щоб записувати з нього."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ جڑ گئے؛ ان سے ریکارڈ کرنے کے لیے %2$@ پاپ اپ میں کسی ایک کو منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đã kết nối %1$@; chọn một thiết bị trong nút bật lên %2$@ để ghi âm từ đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 已连接；若要用其中一个录音，请在“%2$@”弹出式菜单中选取它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 已連接；請在「%2$@」彈出式選單中選擇其中一個來錄音。"
