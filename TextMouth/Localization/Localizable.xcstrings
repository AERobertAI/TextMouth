    },
    "Free up space, then import it again." : {
      "comment" : "Last sentence of why an import's archive was refused for want of disk space: what to do. \"It\" is the archive.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "وفّر مساحة، ثم استورده مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "জায়গা খালি করুন, তারপর আবার আমদানি করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Schaffe Speicherplatz und importiere es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Libera espacio y vuelve a importarlo."
          }
        },
        "fr" : {
