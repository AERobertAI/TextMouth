    "Heading: %@" : {
      "comment" : "Announcement on arriving at a heading while reading. %@ is the heading's text; where several headings begin at the same place, their texts joined with commas."
    },
    "Headings" : {
      "comment" : "Heading of the headings sheet, which lists a book's headings.\nThe name of the Headings checkbox in the Export dialog: a list of the book's headings and where each begins.\nTitle of the reader toolbar's button that opens the headings sheet."
    },
    "Headings, %lld headings" : {
      "comment" : "What VoiceOver calls the list of headings, with how many it shows. %lld is the number of headings the level filter shows.",
      "localizations" : {
