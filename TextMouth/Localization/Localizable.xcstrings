          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes the recording without saving it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elimina la grabación sin guardarla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ضبط را بدون ذخیره حذف می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Supprime l’enregistrement sans le conserver."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מוחק את ההקלטה בלי לשמור אותה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
