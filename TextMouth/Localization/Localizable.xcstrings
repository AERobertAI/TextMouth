    "libraryIndexReadFailure.fileReadNoPermission" : {
      "comment" : "Why the library index could not be loaded: macOS refused TextMouth permission to read it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ليس لدى TextMouth إذن بقراءة الملف."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফাইলটি পড়ার অনুমতি TextMouth-এর নেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth hat keine Berechtigung, die Datei zu lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth does not have permission to read the file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no tiene permiso para leer el archivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth اجازه خواندن فایل را ندارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth n’a pas l’autorisation de lire le fichier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ל-TextMouth אין הרשאה לקרוא את הקובץ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth के पास फ़ाइल पढ़ने की अनुमति नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tidak memiliki izin untuk membaca file itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non ha il permesso di leggere il file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth にはファイルを読み取る権限がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth에 파일을 읽을 권한이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth heeft geen toestemming om het bestand te lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth nie ma uprawnień do odczytu pliku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não tem permissão para ler o arquivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "У TextMouth нет разрешения на чтение этого файла."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth har inte behörighet att läsa filen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ไม่มีสิทธิ์อ่านไฟล์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth'un dosyayı okuma izni yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не має дозволу читати цей файл."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth کے پاس فائل پڑھنے کی اجازت نہیں ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth không có quyền đọc tệp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 没有读取该文件的权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 沒有讀取該檔案的權限。"
          }
        }
      }
    },
    "libraryIndexReadFailure.fileReadNoSuchFile" : {
      "comment" : "Why the library index could not be loaded: the file vanished during the read.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اختفى الملف أثناء قراءة TextMouth له."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth পড়ার সময় ফাইলটি অদৃশ্য হয়ে গেছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Datei verschwand, während TextMouth sie las."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file disappeared while TextMouth was reading it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo desapareció mientras TextMouth lo leía."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
