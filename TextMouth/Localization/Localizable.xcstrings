    "bookTextEdit.stoppedBookReadAgain.since" : {
      "comment" : "First sentence of the announcement when an Edit Text session ends because the book's file was read again in another encoding. %@ is the book's title. Edit Text is a menu command.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "توقف “تحرير النص” لـ %@ لأن ملفه قُرئ مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@-এর টেক্সট সম্পাদনা বন্ধ হয়েছে, কারণ এর ফাইল আবার পড়া হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„Text bearbeiten“ wurde für %@ beendet, weil die Datei erneut gelesen wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit Text has stopped for %@, since its file was read again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Editar texto se detuvo para %@, porque se volvió a leer su archivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ویرایش متن برای %@ متوقف شد، زیرا فایل آن دوباره خوانده شد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La modification du texte de %@ s’est arrêtée, car son fichier a été relu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“ערוך טקסט” הופסק עבור %@ כי הקובץ שלו נקרא מחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ के लिए “टेक्स्ट संपादित करें” रुक गया है, क्योंकि उसकी फ़ाइल फिर से पढ़ी गई है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Edit Teks dihentikan untuk %@, karena file-nya dibaca ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Modifica testo si è interrotto per %@, perché il suo file è stato letto di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ファイルが再読み込みされたため、%@のテキスト編集を終了しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@의 파일을 다시 읽었으므로 텍스트 편집이 중지되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wijzig tekst is gestopt voor %@, omdat het bestand opnieuw is gelezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
