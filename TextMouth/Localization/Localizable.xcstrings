    "Plays a preview; choose Apply again to apply." : {
      "comment" : "Hint of the audio editor's Apply button while a press would play a preview first.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يشغّل معاينة؛ اختر “تطبيق” مرة أخرى للتطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gibt eine Vorschau wieder; wähle erneut „Anwenden“, um den Filter anzuwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
