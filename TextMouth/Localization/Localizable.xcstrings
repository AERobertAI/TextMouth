    "mobiError.notAKindleBook" : {
      "comment" : "Why a file could not be imported as a Kindle (MOBI) book: it is not a Kindle book of a kind TextMouth reads.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هذا الملف ليس كتاب Kindle يستطيع TextMouth قراءته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই ফাইলটি TextMouth-এর পড়তে পারা কোনো Kindle বই নয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Diese Datei ist kein Kindle-Buch, das TextMouth lesen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This file is not a Kindle book that TextMouth can read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este archivo no es un libro de Kindle que TextMouth pueda leer."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "این فایل کتاب Kindle قابل خواندن برای TextMouth نیست."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce fichier n’est pas un livre Kindle que TextMouth sait lire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "קובץ זה אינו ספר Kindle ש-TextMouth יכול לקרוא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "यह फ़ाइल ऐसी Kindle पुस्तक नहीं है जिसे TextMouth पढ़ सके।"
          }
        },
        "id" : {
