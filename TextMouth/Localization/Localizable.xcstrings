    "phoneSettings.brailleCaption" : {
      "comment" : "The caption under the Braille code row in the iPhone's Settings. A book keeps the braille code it was added with.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يقرأ TextMouth ملفات برايل التي تضيفها من الآن فصاعدًا بهذا الرمز. يحتفظ الكتاب بالرمز الذي أُضيف به."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এখন থেকে আপনি যে ব্রেইল ফাইল যোগ করবেন, TextMouth তা এই কোড দিয়ে পড়বে। বইটি যে কোড দিয়ে যোগ করা হয়েছিল, সেটিই রেখে দেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth liest Braille-Dateien, die Sie ab jetzt hinzufügen, mit diesem Code. Ein Buch behält den Code, mit dem es hinzugefügt wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth reads braille files you add from now on with this code. A book keeps the code it was added with."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth lee con este código los archivos braille que añadas a partir de ahora. Un libro conserva el código con el que se añadió."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth پرونده‌های بریلی را که از این پس اضافه می‌کنید با این کد می‌خواند. هر کتاب کدی را نگه می‌دارد که با آن اضافه شده است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth lit avec ce code les fichiers braille que vous ajoutez à partir de maintenant. Un livre garde le code avec lequel il a été ajouté."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth קורא קובצי ברייל שתוסיפו מעכשיו בקוד הזה. ספר שומר את הקוד שבו נוסף."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "अब से आप जो ब्रेल फ़ाइलें जोड़ेंगे, TextMouth उन्हें इसी कोड से पढ़ेगा। पुस्तक उसी कोड को रखती है जिससे वह जोड़ी गई थी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth membaca berkas Braille yang Anda tambahkan mulai sekarang dengan kode ini. Buku mempertahankan kode saat ditambahkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth legge con questo codice i file braille che aggiungi da ora in poi. Un libro mantiene il codice con cui è stato aggiunto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouthは、今後追加する点字ファイルをこのコードで読み取ります。ブックは追加したときのコードを保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth는 지금부터 추가하는 점자 파일을 이 코드로 읽습니다. 책은 추가할 때의 코드를 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth leest braillebestanden die je vanaf nu toevoegt met deze code. Een boek behoudt de code waarmee het is toegevoegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth odczytuje pliki Braille’a dodawane od teraz za pomocą tego kodu. Książka zachowuje kod, z którym została dodana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth lê com este código os arquivos braille que você adicionar de agora em diante. Um livro mantém o código com que foi adicionado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth читает файлы Брайля, которые вы добавите с этого момента, по этому коду. Книга сохраняет код, с которым была добавлена."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth läser punktskriftsfiler som du lägger till från och med nu med den här koden. En bok behåller koden som den lades till med."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth จะอ่านไฟล์อักษรเบรลล์ที่คุณเพิ่มจากนี้ไปด้วยรหัสนี้ หนังสือจะคงรหัสที่ใช้ตอนเพิ่มไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth, bundan sonra eklediğiniz Braille dosyalarını bu kodla okur. Bir kitap, eklendiği kodu korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth читає файли Брайля, які ви додасте відтепер, за цим кодом. Книга зберігає код, з яким її додано."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اب سے آپ جو بریل فائلیں شامل کریں گے، TextMouth انہیں اسی کوڈ سے پڑھے گا۔ کتاب وہی کوڈ رکھتی ہے جس سے شامل کی گئی تھی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth đọc các tệp Braille bạn thêm từ bây giờ bằng mã này. Sách giữ mã lúc được thêm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "从现在起添加的盲文文件，TextMouth 会用此编码读取。图书会保留添加时所用的编码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "從現在起加入的點字檔案，TextMouth 會用此編碼讀取。書籍會保留加入時所用的編碼。"
          }
        }
      }
    },
