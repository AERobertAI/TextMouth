    "There isn't enough free space for the library there: it needs %@, and %@ is free." : {
      "comment" : "Why the chosen location can't be used: the disk is too full. %1$@ is the size the library needs, such as \"5.5 GB\"; %2$@ is the free space.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dort ist nicht genug freier Speicherplatz für die Bibliothek: Sie braucht %1$@, und %2$@ sind frei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There isn't enough free space for the library there: it needs %1$@, and %2$@ is free."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay suficiente espacio libre para la biblioteca allí: necesita %1$@, y hay %2$@ libres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il n’y a pas assez d’espace libre pour la bibliothèque à cet endroit : elle nécessite %1$@, et %2$@ sont libres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non c’è abbastanza spazio libero per la libreria lì: ne servono %@ e ne sono liberi %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não há espaço livre suficiente para a biblioteca ali: ela precisa de %1$@, e há %2$@ livres."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Для библиотеки там недостаточно свободного места: нужно %1$@, свободно %2$@."
