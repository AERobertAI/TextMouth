    "phoneImport.macBrailleTableRefusal" : {
      "comment" : "First sentence of the refusal of a braille book that needs a braille table only a Mac has. %1$@ is the file's quoted name, or \"This file\". %2$@ is the table's file name, as in \"fr-bfu-g2.ctb\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحتاج %1$@ إلى “%2$@”، وهو أحد جداول برايل الخاصة بـ Mac، وهو غير متوفر في TextMouth على iPhone."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@-এর জন্য “%2$@” দরকার, যা একটি Mac-এর নিজস্ব ব্রেইল টেবিল এবং iPhone-এ TextMouth-এ নেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ benötigt „%2$@“, eine der eigenen Brailletabellen eines Mac, die TextMouth auf dem iPhone nicht hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ needs “%@”, one of a Mac's own braille tables, which TextMouth on iPhone doesn't have."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ necesita “%2$@”, una de las tablas de braille propias de una Mac, que TextMouth en el iPhone no tiene."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ به «%2$@» نیاز دارد، یکی از جدول‌های بریل خود Mac که TextMouth در iPhone ندارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ nécessite « %2$@ », l’une des tables braille propres à un Mac, que TextMouth sur iPhone n’a pas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ דורש את “%2$@”, אחת מטבלאות הברייל של Mac, שאין ב-TextMouth ב-iPhone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ को “%2$@” चाहिए, जो Mac की अपनी ब्रेल टेबलों में से एक है और iPhone पर TextMouth में नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ memerlukan “%2$@”, salah satu tabel braille bawaan Mac, yang tidak dimiliki TextMouth di iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ richiede “%2$@”, una delle tabelle braille di un Mac, che TextMouth su iPhone non ha."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@には、Mac 専用の点字表「%2$@」が必要ですが、iPhone 版の TextMouth にはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@에는 Mac 전용 점자표인 “%2$@”이(가) 필요하지만, iPhone용 TextMouth에는 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ heeft “%2$@” nodig, een van de eigen brailletabellen van een Mac, die TextMouth op de iPhone niet heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ wymaga tabeli „%2$@” — jednej z własnych tabel Braille’a komputera Mac, której TextMouth na urządzeniu iPhone nie ma."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ precisa de “%2$@”, uma das tabelas braille do próprio Mac, que o TextMouth no iPhone não tem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ требует таблицу «%2$@», одну из встроенных таблиц Брайля на Mac, которой нет в TextMouth на iPhone."
          }
