    "Folder placement and manual order that were stored only in the unreadable index are lost from the library." : {
      "comment" : "Second sentence of what Rebuild Library Index does: what is lost.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يُفقد من المكتبة موضع المجلدات والترتيب اليدوي اللذان كانا مخزّنين في الفهرس غير المقروء فقط."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "যে ফোল্ডার বিন্যাস ও ম্যানুয়াল ক্রম শুধু অপঠনযোগ্য সূচকে সংরক্ষিত ছিল, তা লাইব্রেরি থেকে হারিয়ে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ordnerzuordnung und manuelle Reihenfolge, die nur im unlesbaren Index gespeichert waren, gehen aus der Bibliothek verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La ubicación en carpetas y el orden manual que estaban guardados solo en el índice ilegible se pierden de la biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le placement des dossiers et l’ordre manuel, stockés uniquement dans l’index illisible, sont perdus pour la bibliothèque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ोल्डर की स्थिति और मैन्युअल क्रम, जो केवल अपठनीय इंडेक्स में संग्रहीत थे, लाइब्रेरी से खो जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Penempatan folder dan urutan manual yang hanya tersimpan di indeks yang tidak terbaca hilang dari pustaka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La posizione nelle cartelle e l’ordine manuale memorizzati solo nell’indice illeggibile vanno persi dalla libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "読み取れないインデックスにだけ保存されていたフォルダの配置と手動の並び順は、ライブラリから失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "읽을 수 없는 색인에만 저장되어 있던 폴더 배치와 수동 순서는 보관함에서 사라집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A posição das pastas e a ordem manual que estavam apenas no índice ilegível são perdidas da biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Расположение в папках и ручной порядок, хранившиеся только в нечитаемом индексе, будут потеряны из библиотеки."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Розташування папок і порядок, задані вручну, які зберігалися лише в нечитабельному індексі, буде втрачено з бібліотеки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "仅存储在无法读取的索引中的文件夹位置和手动顺序，会从资料库中丢失。"
          }
        }
      }
    },
