    },
    "TextMouth isn't allowed to make changes in %@." : {
      "comment" : "First sentence of why the chosen location can't be used: macOS does not let TextMouth write there. %@ is the folder's path.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
