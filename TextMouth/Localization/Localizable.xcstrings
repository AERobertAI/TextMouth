        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "PDF থেকে কোনো টেক্সট পড়া যায়নি: এতে এমবেড করা টেক্সট নেই, এবং OCR চালানো যায়নি (%@)।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aus der PDF-Datei konnte kein Text gelesen werden: Sie enthält keinen eingebetteten Text, und die Texterkennung (OCR) konnte nicht ausgeführt werden (%@)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No text could be read from the PDF: it has no embedded text, and OCR could not run (%@)."
