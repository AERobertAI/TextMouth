    "dataDirectoryUnavailable.quitHint" : {
      "comment" : "VoiceOver hint of Quit TextMouth on the Library Not Available screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ينهي TextMouth دون تغيير أي شيء في موقع المكتبة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "লাইব্রেরির অবস্থানে কিছু না বদলিয়ে TextMouth থেকে প্রস্থান করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beendet TextMouth, ohne am Ort der Bibliothek etwas zu ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quits TextMouth without changing anything in the library's location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sale de TextMouth sin cambiar nada en la ubicación de la biblioteca."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بدون تغییر دادن چیزی در مکان کتابخانه از TextMouth خارج می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quitte TextMouth sans rien changer à l’emplacement de la bibliothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "יוצא מ-TextMouth בלי לשנות דבר במיקום הספרייה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लाइब्रेरी के स्थान में कुछ भी बदले बिना TextMouth छोड़ता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Keluar dari TextMouth tanpa mengubah apa pun di lokasi pustaka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esce da TextMouth senza modificare nulla nella posizione della libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ライブラリの場所を何も変更せずに TextMouth を終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관함의 위치를 변경하지 않고 TextMouth를 종료합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sluit TextMouth af zonder iets aan de locatie van de bibliotheek te wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kończy TextMouth bez zmieniania czegokolwiek w lokalizacji biblioteki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Encerra o TextMouth sem alterar nada na localização da biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Завершает TextMouth, не изменяя расположение библиотеки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Avslutar TextMouth utan att ändra något i bibliotekets plats."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ออกจาก TextMouth โดยไม่เปลี่ยนแปลงอะไรในตำแหน่งที่ตั้งของไลบรารี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitaplığın konumunda hiçbir şeyi değiştirmeden TextMouth'tan çıkar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Завершує TextMouth, не змінюючи розташування бібліотеки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لائبریری کے مقام میں کوئی تبدیلی کیے بغیر TextMouth چھوڑ دیتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thoát TextMouth mà không thay đổi gì ở vị trí của thư viện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "退出 TextMouth，不更改资料库的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "結束 TextMouth，不更改書庫的位置。"
          }
        }
      }
    },
    "dataDirectoryUnavailable.refusal.openBookFile" : {
      "comment" : "What the Library window says when a command that adds a book is chosen while the library can't be used.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يمكن إضافة كتب بينما المكتبة غير متاحة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "লাইব্রেরি উপলব্ধ না থাকলে বই যোগ করা যাবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bücher können nicht hinzugefügt werden, solange die Bibliothek nicht verfügbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Books can't be added while the library isn't available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pueden agregar libros mientras la biblioteca no está disponible."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تا وقتی کتابخانه در دسترس نیست، نمی‌توان کتابی اضافه کرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossible d’ajouter des livres tant que la bibliothèque n’est pas disponible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא ניתן להוסיף ספרים בזמן שהספרייה אינה זמינה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लाइब्रेरी उपलब्ध न होने पर पुस्तकें नहीं जोड़ी जा सकतीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Buku tidak dapat ditambahkan saat pustaka tidak tersedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non è possibile aggiungere libri mentre la libreria non è disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ライブラリが利用できないときは、ブックを追加できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보관함을 사용할 수 없는 동안에는 책을 추가할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Er kunnen geen boeken worden toegevoegd terwijl de bibliotheek niet beschikbaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie można dodawać książek, gdy biblioteka jest niedostępna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não é possível adicionar livros enquanto a biblioteca não está disponível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Книги нельзя добавлять, пока библиотека недоступна."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Böcker kan inte läggas till medan biblioteket inte är tillgängligt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เพิ่มหนังสือไม่ได้ขณะที่ไลบรารีไม่พร้อมใช้งาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kitaplık kullanılamıyorken kitap eklenemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Книги не можна додавати, поки бібліотека недоступна."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لائبریری دستیاب نہ ہونے پر کتابیں شامل نہیں کی جا سکتیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không thể thêm sách khi thư viện không khả dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "资料库不可用时无法添加图书。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "書庫無法使用時無法加入書籍。"
          }
        }
      }
    },
