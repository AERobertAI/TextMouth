              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Temporizador programado para %lld minutos."
                }
              }
            }
          }
        }
      }
    },
    "Times" : {
      "comment" : "Heading of the group in Playback settings that holds the setting about naming the speed beside times."
    },
    "Title" : {
      "comment" : "Label of the field in the Record window that names the recording, which becomes the audiobook's title.\nName of the book information sheet's field for the book's title."
    },
    "Titles" : {
      "comment" : "Heading of the Library settings section that holds the Leading Articles pop-up, which decides how book titles are sorted and typed."
    },
    "Titles sort, and are found by typing, as they are written: The Hobbit is among the T's." : {
      "comment" : "Describes the Leading Articles choice Part of the Title, under the pop-up. The Hobbit is the example title; the T's are the books sorted under the letter T."
    },
    "Toggle Bookmark" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Bookmarks group and read by VoiceOver. Adds a bookmark at the reading position, or removes the one there. Also the title of the menu command of the same name."
    },
    "Total book time: %@" : {
      "comment" : "Part of the full Where Am I? summary: the book's whole length. %@ is the time in words, such as \"4 hours, 50 minutes\"."
    },
    "Total time: %@" : {
      "comment" : "The book's total time as the reader's status row speaks it. %@ is the time in words, such as \"4 hours, 50 minutes, 33 seconds\"."
    },
    "Total: %@" : {
      "comment" : "The book's total time as the reader's status row shows it. %@ is a clock time such as 4:50:33."
    },
    "Transcribe it again, then edit the new transcript." : {
      "comment" : "Sentence after the reason that an audiobook's transcript no longer fits its audio: what to do."
    },
    "Transcribe it again, then search the new transcript." : {
      "comment" : "Advice after the reason a book's transcript cannot be searched because its audio changed: make the transcript again."
    },
    "Transcribe it first, with Transcribe Audio." : {
      "comment" : "Second sentence of that message. Transcribe Audio is the name of a menu command."
    },
    "Tries again to save the recording as an audiobook." : {
      "comment" : "VoiceOver hint of the Save Again button of the Record window."
    },
    "Tries to get the book again" : {
      "comment" : "Hint of the Try Again button of the reader's view for a book that could not be got from the cloud."
    },
    "Trim to Selection" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Deletes all audio outside the selection."
    },
    "Try Again" : {
      "comment" : "Button of the reader's alert about a chapter that could not be downloaded; it tries the download again.\nButton of the reader's view for a book that could not be got from the cloud; it tries again."
    },
    "Try a Double Press" : {
      "comment" : "Button in the Shortcuts tab of Settings that lets the listener press a key twice to find out whether the double press time counts the two presses as a double press."
    },
    "Turn off “%@” to save the metadata to the library only." : {
      "comment" : "Second sentence of that message. %@ is the shown name of the editor's switch that also writes the file, quoted."
    },
    "Two different keys, not a double press." : {
      "comment" : "Announced by VoiceOver at the end of a trial of the double press time when the two presses were of different keys."
    },
    "Two presses, %@ apart. Set the time above %@ to count them as one." : {
      "comment" : "Announced by VoiceOver at the end of a trial of the double press time when the two presses were too far apart for the time set. Both %1$@ and %2$@ are the time between the presses, such as \"0.7 seconds\"; the listener should set the double press time above it.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Two presses, %1$@ apart. Set the time above %2$@ to count them as one."
          }
        }
      }
    },
    "Two presses, %@ apart. The double press time goes up to %@." : {
      "comment" : "Announced by VoiceOver at the end of a trial of the double press time when the two presses were farther apart than the longest time allowed. %1$@ is the time between the presses, such as \"2.5 seconds\", and %2$@ is the longest time allowed, such as \"2 seconds\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Two presses, %1$@ apart. The double press time goes up to %2$@."
          }
        }
      }
    },
    "Type a page as the book numbers it, such as 12 or xii." : {
      "comment" : "Last sentence of the Go to Page field's hint: what the user may type. 12 and xii are examples of page labels, a number and a roman numeral."
    },
    "Type a page number." : {
      "comment" : "Message when Go to Page is chosen with nothing typed in its field."
    },
    "Type a percent from 0 to 100, such as 47.5." : {
      "comment" : "Hint of the Go to Percent field: what the user may type. 47.5 is an example number; write it as the language writes numbers."
    },
    "Type a title, then save again." : {
      "comment" : "Second sentence of that message: what to do."
    },
    "Type straight quotation marks: in TextEdit, turn off Smart Quotes under Edit, Substitutions." : {
      "comment" : "Third sentence of the Edit Manifest explanation. TextEdit is the Mac's text editor; Smart Quotes, Edit and Substitutions are its menu names, so use the words macOS shows for them."
    },
    "Type text to find in every book of the library." : {
      "comment" : "Status line of the Search Library window before anything is typed."
    },
    "Type to search the book's transcript" : {
      "comment" : "VoiceOver hint of the search field in Search in Book when the book searched is a transcribed audiobook."
    },
    "Type to search the text of every book in the library" : {
      "comment" : "VoiceOver hint of the search field in the Search Library window."
    },
    "Type to search within the book" : {
      "comment" : "VoiceOver hint of the search field in Search in Book when the book searched is a text book."
    },
    "Underscore" : {
      "comment" : "Name of the punctuation key \"_\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Underscore\"."
    },
    "Undo" : {
      "comment" : "Name of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Undo\".\nName of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Undoes the last edit.\nName of the Edit menu's Undo command, in a sentence saying why a keyboard shortcut cannot take its key."
    },
    "Untitled rule" : {
      "comment" : "The name a substitution rule is given in lists and announcements when it has neither a name nor a pattern."
    },
    "Up Arrow" : {
      "comment" : "Name of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Up Arrow\"."
    },
    "Up One Level" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Navigation group and read by VoiceOver. Goes up one level, to the folder that holds the current one."
    },
    "Updates the default voice, speed, and pitch for every book without settings of its own." : {
      "comment" : "Hint and tooltip of the buttons that save a text book's voice, speed and pitch as the settings for every book."
    },
    "Use %@ and %@, or drag, to reorder. Rules apply top to bottom." : {
      "comment" : "Help in the footer of the Substitutions settings on reordering rules. %1$@ and %2$@ are the titles of the Move Up and Move Down commands, which stay as those commands show them.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use %1$@ and %2$@, or drag, to reorder. Rules apply top to bottom."
          }
        }
      }
    },
    "Use Global Default" : {
      "comment" : "Button of the book's own settings sheet that removes its own end of book choice, so the setting for every book applies."
    },
    "Use Regex" : {
      "comment" : "Title of the switch in Search in Book that makes the search text a regular expression. Regex is short for regular expression."
    },
    "Use regular expression" : {
      "comment" : "VoiceOver label of the Use Regex switch in Search in Book."
    },
    "Use regular expression matching" : {
      "comment" : "VoiceOver label of the Regular expression switch in the substitution rule editor."
    },
    "Use the global setting (%@)" : {
      "comment" : "A choice of the Open the next book in pop-up button in Feed Info and Folder Settings: do as Settings says. %@ is the name of the choice Settings has now, such as This Window.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usar el ajuste general (%@)"
          }
        }
      }
    },
    "User" : {
      "comment" : "Name of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + User\"."
    },
    "Using global voice, speed, and pitch settings" : {
      "comment" : "Announcement after a text book's own voice, speed and pitch were removed, so it uses the settings for every book."
    },
    "Vertical Bar" : {
      "comment" : "Name of the punctuation key \"|\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Vertical Bar\"."
    },
    "Voice" : {
      "comment" : "Name of the Settings tab for the voice, its language, and the default speed and pitch. Shown in the Settings window's toolbar.\nTitle of the pop-up in the Voice settings that chooses the voice.\nTitle of the reader toolbar's button that opens a text book's own voice settings.\nTitle of the voice sheet's menu of voices, and the heading of its group."
    },
    "Voice & Speed" : {
      "comment" : "Name of the reader's sheet for a text book's own voice, speed and pitch."
    },
    "Voice language" : {
      "comment" : "VoiceOver label of the Language pop-up in the Voice settings."
    },
    "Voice language filter" : {
      "comment" : "What VoiceOver calls the voice sheet's menu that limits the voices listed to one language."
    },
    "VoiceOver speaks the level while recording. Over speakers, its speech can be recorded." : {
      "comment" : "VoiceOver hint and tooltip of the switch in the Record window that announces the microphone level."
    },
    "Warning: This will rewrite the library's copy of the EPUB file and recalculate its MD5 hash." : {
      "comment" : "First sentence of the warning shown under the metadata editor's switch while it is on. MD5 is the name of a checksum and stays as written."
    },
    "What happens when a book finishes playing" : {
      "comment" : "VoiceOver hint of the When book ends pop-up in the Playback settings."
    },
    "What happens when you hold Shift and skip backward" : {
      "comment" : "VoiceOver hint of the Shift+Skip Backward pop-up in the Playback settings. Shift is the key's name."
    },
    "What happens when you hold Shift and skip forward" : {
      "comment" : "VoiceOver hint of the Shift+Skip Forward pop-up in the Playback settings. Shift is the key's name."
    },
    "What happens when you skip backward" : {
      "comment" : "VoiceOver hint of the Skip Backward pop-up in the Playback settings."
    },
    "What happens when you skip forward" : {
      "comment" : "VoiceOver hint of the Skip Forward pop-up in the Playback settings."
    },
    "When a book ends" : {
      "comment" : "Label of the Reading List's options bar pop-up button choosing what a book opened from the list does when it ends: play the book below, play the book above, or stop.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Al terminar un libro"
          }
        }
      }
    },
    "When articles are ignored, a book whose metadata names French, German, Spanish, Italian, Portuguese, Dutch, Catalan, Swedish, Danish, or Norwegian passes over that language's articles, such as Le and Die, and The." : {
      "comment" : "First sentence of the note under the Leading Articles pop-up, shown where articles are ignored. Names the languages whose articles TextMouth skips; Le, Die, and The are example articles and stay as written."
    },
    "When book ends" : {
      "comment" : "Title of the pop-up in the Playback settings that chooses what happens when a book ends."
    },
    "When checked, matches must use the same upper and lower case" : {
      "comment" : "VoiceOver hint of the Match Case checkbox."
    },
    "When checked, the search text is an ICU regular expression" : {
      "comment" : "VoiceOver hint of the Regular Expression checkbox in the Search Library window. ICU is the name of the regular expression syntax, and stays as written."
    },
    "When enabled, playback starts automatically after jumping to a heading, bookmark, or search result" : {
      "comment" : "VoiceOver hint of the Auto-play after navigation checkbox in the Playback settings."
    },
    "When enabled, search text is treated as a regular expression" : {
      "comment" : "VoiceOver hint of the Use Regex switch in Search in Book."
    },
    "When enabled, use \\b in the pattern for word boundaries" : {
      "comment" : "VoiceOver hint of the Regular expression switch in the substitution rule editor. \\b is regular expression syntax and stays as written."
    },
    "When off, the sheet stays open showing the remaining time and a reset button" : {
      "comment" : "VoiceOver hint of the Close sheet after setting timer checkbox in the Playback settings."
    },
    "When resuming playback, rewind to the start of this unit" : {
      "comment" : "VoiceOver hint of the Rewind to pop-up in the Playback settings."
    },
    "When this book ends" : {
      "comment" : "Title of the book's own settings menu that chooses what happens when this book ends."
    },
    "When you save, TextMouth checks the manifest and rearranges the book, keeping your place in its track." : {
      "comment" : "Fourth sentence of the Edit Manifest explanation: what happens when the user saves the manifest."
    },
    "When you save, the book updates and keeps your place as near as it can." : {
      "comment" : "Fourth sentence of the Edit Text explanation: what happens when the user saves the edited text."
    },
    "Where Am I?" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Information group and read by VoiceOver. Speaks a short summary of the reading position. Also the title of the menu command of the same name.\nName of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Speaks the position and the selection.\nTitle of the reader toolbar's button that says where the reader is in the book."
    },
    "Where Am I? Announces current position in the book" : {
      "comment" : "What VoiceOver calls the reader toolbar's Where Am I? button while nothing is announced."
    },
    "Where Am I? Full Summary" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Information group and read by VoiceOver. Speaks the full summary of the reading position. Also the title of the menu command of the same name."
    },
    "Where TextMouth writes its diagnostic logs. %@ keeps them with your books, so they move and sync with the library. %@ keeps them in %@, which never syncs. A change applies from the next line; existing logs stay." : {
      "comment" : "VoiceOver hint and tooltip of the Log location pop-up in the Storage settings. %1$@ and %2$@ are the names of its two choices, as the pop-up lists them, and %3$@ is the folder's path on this Mac, which stays as written.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Where TextMouth writes its diagnostic logs. %1$@ keeps them with your books, so they move and sync with the library. %2$@ keeps them in %3$@, which never syncs. A change applies from the next line; existing logs stay."
          }
        }
      }
    },
    "Whole word only" : {
      "comment" : "A part of a substitution rule's spoken summary: the rule matches whole words only."
    },
    "With \"%@\", Play on a finished book says it is finished; with \"%@\", Play starts it again from the beginning." : {
      "comment" : "Caption under the When book ends picker in Settings, Playback. %1$@ and %2$@ are the names of two of the picker's choices, as the picker shows them (Stop, and Stop, and Play Starts Over); Play is the reader's Play button.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
