        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’episodio esce dall’elenco per sempre; il libro in cui è diventato nella tua libreria resta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O episódio sai da lista de vez; o livro em que ele se tornou na sua biblioteca permanece."
          }
        }
      }
    },
    "The existing copy's files are deleted permanently and cannot be recovered." : {
      "comment" : "Part of the question asked about a duplicate book: where the library's copy goes when replaced and files are deleted permanently.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Dateien der vorhandenen Kopie werden endgültig gelöscht und lassen sich nicht wiederherstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los archivos de la copia existente se eliminan de forma permanente y no se pueden recuperar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les fichiers de la copie existante sont supprimés définitivement et ne peuvent pas être récupérés."
