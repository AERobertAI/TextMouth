          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Транскрипція з «%@» замінює транскрипцію книги й текст, створений із неї."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "来自“%@”的文字稿将替换图书的文字稿及据此生成的文本。"
