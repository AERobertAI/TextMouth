            "value" : "Le fichier CUE « %@ » est trop volumineux pour être lu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "קובץ ה-CUE “%@” גדול מדי לקריאה."
