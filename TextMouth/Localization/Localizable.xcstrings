    "Its package name was taken by other content, and no unused name could be found." : {
      "comment" : "Why a book could not move into the current library format. \"Its\" is the book's.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اسم حزمته مأخوذ بمحتوى آخر، ولم يمكن العثور على اسم غير مستخدم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এর প্যাকেজের নামটি অন্য বিষয়বস্তু নিয়ে নিয়েছে, আর কোনো অব্যবহৃত নাম পাওয়া যায়নি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Paketname des Buchs wurde von anderem Inhalt belegt, und es konnte kein unbenutzter Name gefunden werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Otro contenido ocupó el nombre de su paquete, y no se encontró ningún nombre sin usar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le nom de son paquet a été pris par un autre contenu, et aucun nom inutilisé n’a pu être trouvé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसका पैकेज नाम अन्य सामग्री ने ले लिया था, और कोई अप्रयुक्त नाम नहीं मिल सका।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nama paketnya dipakai konten lain, dan tidak ditemukan nama yang belum terpakai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il nome del suo pacchetto era già usato da altro contenuto e non è stato trovato un nome libero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "パッケージ名がほかの内容に使われていて、未使用の名前も見つかりませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "패키지 이름을 다른 콘텐츠가 사용 중이고 사용하지 않는 이름을 찾을 수 없었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O nome do pacote dele foi usado por outro conteúdo, e nenhum nome livre foi encontrado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Имя её пакета занято другим содержимым, а свободное имя найти не удалось."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Назву її пакета зайнято іншим вмістом, і вільної назви знайти не вдалося."
