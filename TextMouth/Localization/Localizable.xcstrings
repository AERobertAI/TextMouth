            "value" : "%@ interrompe toda a exportação. Os arquivos já gravados permanecem."
          }
        }
      }
    },
    "%@ through the book" : {
      "comment" : "What VoiceOver says for the reader's percent button. %@ is the percent, such as 22.9%.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
