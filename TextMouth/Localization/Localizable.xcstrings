    },
    "%@, in %@" : {
      "comment" : "A braille table in words, then the language it is in. %1$@ is the table in words, such as Unified English Braille, uncontracted, and %2$@ the language's name, such as English.\nVoiceOver label of a search match whose place in the book is unknown. %1$@ is the match in its surrounding text, and %2$@ is the book's title.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
