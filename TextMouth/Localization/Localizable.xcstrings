        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hiermee wordt de tekst in de cache van elk boek opnieuw uitgepakt, wat bij een grote bibliotheek even kan duren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "To ponownie wyodrębni tekst każdej książki i odświeży jego kopię w pamięci podręcznej, co w dużej bibliotece może chwilę potrwać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Isso extrai de novo o texto em cache de todos os livros, o que pode demorar em uma biblioteca grande."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Заново извлечёт кэшированный текст каждой книги; для большой библиотеки это может занять время."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Det här extraherar den cachade texten för varje bok igen, vilket kan ta en stund för ett stort bibliotek."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "การดำเนินการนี้จะดึงข้อความที่แคชไว้ของทุกเล่มอีกครั้ง ซึ่งอาจใช้เวลานานสำหรับไลบรารีขนาดใหญ่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu, her kitabın önbelleğe alınmış metnini yeniden çıkarır; büyük bir kitaplıkta bu biraz sürebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Буде повторно видобуто кешований текст кожної книги, що для великої бібліотеки може тривати певний час."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یہ ہر کتاب کا محفوظ شدہ متن دوبارہ نکالتا ہے، جس میں بڑی لائبریری کے لیے کچھ وقت لگ سکتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Việc này trích xuất lại văn bản đã lưu đệm của mọi sách, có thể mất một lúc với thư viện lớn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
