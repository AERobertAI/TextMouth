        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dónde empieza el audio: el inicio del libro o un encabezado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Où l’audio commence : le début du livre ou un en-tête."
