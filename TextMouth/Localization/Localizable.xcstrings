        }
      }
    },
    "The cue sheet “%@” names none of the audio beside it, so its headings were not used." : {
      "comment" : "Notice that a cue sheet of an imported folder or archive was not used, because it names none of the audio beside it. %@ is the cue sheet's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Cue-Sheet „%@“ nennt keine der daneben liegenden Audiodateien, daher wurden seine Überschriften nicht verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo CUE “%@” no nombra ningún audio junto a él, así que no se usaron sus encabezados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le fichier CUE « %@ » ne désigne aucun des fichiers audio voisins, donc ses en-têtes n’ont pas été utilisés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "क्यू शीट “%@” अपने पास के किसी ऑडियो का नाम नहीं लेती, इसलिए उसके हेडिंग उपयोग में नहीं लाए गए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lembar CUE “%@” tidak menyebutkan audio mana pun di sampingnya, jadi tajuknya tidak dipakai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il cue sheet “%@” non nomina nessuno degli audio accanto a esso, quindi le sue intestazioni non sono state usate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "キューシート「%@」は、隣にあるオーディオのどれも指定していないため、その見出しは使用されませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "큐 시트 “%@”에 옆에 있는 오디오와 일치하는 이름이 없어 해당 표제를 사용하지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
