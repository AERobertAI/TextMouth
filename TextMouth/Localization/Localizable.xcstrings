            "value" : "%1$@ dipindahkan ke %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Spostato: %1$@ a %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
