    "ffmpegImport.leftOutHoldingNoSound.hold" : {
      "comment" : "Notice that a book left out several files that hold no sound TextMouth can read. %@ is the files' count and names, such as \"2 files, “a.spx” and “b.spx”\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تجاهل TextMouth %@، فلا صوت فيها يستطيع قراءته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth %@ বাদ দিয়েছে, যেগুলোতে পড়ার মতো কোনো সাউন্ড নেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth hat %@ ausgelassen, die keinen Ton enthalten, den es lesen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth left out %@, which hold no sound it can read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth omitió %@, que no contienen sonido que pueda leer."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth %@ را که صدای قابل خواندنی ندارند کنار گذاشت."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth a écarté %@, qui ne contiennent aucun son qu’il puisse lire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth השמיט את %@, שאין בהם שמע שהוא יכול לקרוא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ने %@ छोड़ दीं, जिनमें कोई ऐसी ध्वनि नहीं है जिसे वह पढ़ सके।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth melewatkan %@, yang tidak berisi suara yang dapat dibacanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ha escluso %@, che non contengono audio leggibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は、読み取れる音声のない%@を除外しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 읽을 수 있는 소리가 없는 %@을(를) 제외했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth heeft %@ weggelaten, die geen geluid bevatten dat TextMouth kan lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth pominął: %@. Te pliki nie zawierają dźwięku, który może odczytać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth deixou de fora %@, que não contêm som que ele possa ler."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth пропустил %@: в них нет звука, который он может прочитать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth utelämnade %@, som inte innehåller något ljud som TextMouth kan läsa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ข้าม %@ ซึ่งไม่มีเสียงที่อ่านได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth şunları dışarıda bıraktı: %@. Okuyabileceği ses içermiyorlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Пропущено %@: у них немає звуку, який може прочитати TextMouth."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth نے %@ چھوڑ دیے، جن میں کوئی ایسی آواز نہیں جسے وہ پڑھ سکے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth đã bỏ qua %@, những tệp không chứa âm thanh mà nó đọc được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 略去了%@，它们不含 TextMouth 可读取的声音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 略過了 %@，其中沒有它能讀取的聲音。"
          }
        }
      }
    },
