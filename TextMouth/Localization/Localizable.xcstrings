    "%@ couldn't send the feed (error %@). Try again later." : {
      "comment" : "Why a feed could not be fetched: the server answered with an error. The first %@ is the server's host name; the second is the error's number, an identifier written without digit grouping, such as 503.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ konnte den Feed nicht senden (Fehler %2$@). Versuche es später erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ couldn't send the feed (error %2$@). Try again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ no pudo enviar el canal (error %2$@). Inténtalo de nuevo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ n’a pas pu envoyer le flux (erreur %2$@). Réessayez plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ non ha inviato il feed (errore %2$@). Riprova più tardi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ não conseguiu enviar o feed (erro %2$@). Tente novamente mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сервер %1$@ не смог отправить ленту (ошибка %2$@). Повторите попытку позже."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сервер %1$@ не зміг надіслати стрічку (помилка %2$@). Спробуйте пізніше."
          }
        }
      }
    },
    "%@ couldn't send the file (error %@). Try again later." : {
      "comment" : "Why a feed item's download failed: the server answered with an error. The first %@ is the server's host name; the second is the error's number, an identifier written without digit grouping, such as 503.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
