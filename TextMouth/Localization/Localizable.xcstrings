            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Este libro conserva su audio original %lld de días después de guardarse o editarse por última vez."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Este libro conserva su audio original %lld día después de guardarse o editarse por última vez."
                }
              },
              "other" : {
                "stringUnit" : {
