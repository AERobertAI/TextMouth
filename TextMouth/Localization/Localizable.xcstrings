    "folderRemoval.confirmationMessage.folders" : {
      "comment" : "Sentence of the second confirmation that deletes a folder: several feeds stay. %@ is a list of the feeds' titles in quotation marks. \"Feed Info\" names a sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تبقى الموجزات %@ مع تنزيلاتها بلا مجلدات إلى أن تمنح “معلومات الموجز” كلًا منها مجلدًا آخر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফিড %@ নিজ নিজ ডাউনলোডসহ থাকে, “ফিডের তথ্য” প্রতিটিকে অন্য ফোল্ডার না দেওয়া পর্যন্ত কোনো ফোল্ডার ছাড়াই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Feeds %@ bleiben mit ihren Downloads ohne Ordner, bis „Feed-Info“ jedem einen anderen gibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The feeds %@ stay, with their downloads, without folders until Feed Info gives each another."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los canales %@ permanecen, con sus descargas, sin carpetas hasta que Información del canal dé una a cada uno."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فیدهای %@ با بارگیری‌شده‌هایشان بدون پوشه می‌مانند تا «اطلاعات فید» به هر کدام پوشه‌ی دیگری بدهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les flux %@ restent, avec leurs téléchargements, sans dossier jusqu’à ce que vous en donniez un autre à chacun dans Informations sur le flux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הערוצים %@ נשארים, עם ההורדות שלהם, ללא תיקיות עד ש“פרטי הערוץ” נותנים לכל אחד תיקייה אחרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ीड %@ अपने डाउनलोड के साथ तब तक बिना फ़ोल्डर के रहती हैं जब तक “फ़ीड जानकारी” हर एक को दूसरा फ़ोल्डर न दे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Feed %@ tetap ada, beserta unduhannya, tanpa folder sampai Info Feed memberi masing-masing folder lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I feed %@ restano, con i loro download, senza cartella finché Info feed non assegna a ciascuno un’altra cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フィード%@は、「フィード情報」でそれぞれ別のフォルダを指定するまで、ダウンロードと一緒にフォルダなしで残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "피드 %@은(는) 피드 정보에서 각각에 다른 폴더를 지정할 때까지 다운로드와 함께 폴더 없이 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De feeds %@ blijven met hun downloads bewaard, zonder map, totdat je elke feed in Feedinformatie een andere map geeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kanały %@ zostają wraz z pobranymi plikami bez folderów, dopóki w Informacjach o kanale nie przypiszesz każdemu innego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Os feeds %@ permanecem, com seus downloads, sem pasta até que Informações do feed dê uma a cada um."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ленты %@ остаются вместе с загрузками без папки, пока «Сведения о ленте» не назначат каждой другую."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Flödena %@ finns kvar, med sina nedladdningar, utan mappar tills Flödesinformation ger vart och ett en ny."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ฟีด %@ จะยังอยู่ พร้อมรายการดาวน์โหลด โดยไม่อยู่ในโฟลเดอร์ใดจนกว่า ข้อมูลฟีด จะกำหนดโฟลเดอร์อื่นให้แต่ละฟีด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ beslemeleri, Besleme Bilgileri her birine başka bir klasör verene kadar indirmeleriyle birlikte klasörsüz kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Стрічки %@ залишаються разом із завантаженнями без папок, доки «Інформація про стрічку» не призначить кожній іншу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فیڈز %@ اپنے ڈاؤن لوڈز کے ساتھ بغیر فولڈر کے رہتے ہیں، جب تک “فیڈ کی معلومات” میں ہر ایک کو دوسرا فولڈر نہ دیا جائے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Các nguồn cấp %@ vẫn còn, cùng các bản tải về của chúng, không thuộc thư mục nào cho đến khi bạn gán cho mỗi nguồn cấp một thư mục khác trong Thông tin nguồn cấp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "订阅源 %@ 会连同其下载内容保留，且不在任何文件夹中，直到“订阅源信息”为每个订阅源指定另一个文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "訂閱源 %@ 會連同其下載項目保留，且不在任何檔案夾中，直到「訂閱源資訊」為每個訂閱源指定另一個檔案夾。"
          }
        }
      }
    },
    "folderRemoval.confirmationMessage.inside" : {
      "comment" : "First sentence of the second confirmation that deletes a folder holding one book. %@ is the folder's name in quotation marks.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ستتم إزالة %@ وأي مجلدات فرعية والكتاب الموجود بداخله من المكتبة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, এর সব সাবফোল্ডার এবং ভেতরের বইটি লাইব্রেরি থেকে সরানো হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, alle Unterordner und das Buch darin werden aus der Bibliothek entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, any subfolders, and the book inside will be removed from the library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, sus subcarpetas y el libro que contiene se quitarán de la biblioteca."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@، هر زیرپوشه‌ای که دارد و کتاب داخل آن از کتابخانه برداشته می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, ses sous-dossiers et le livre qu’il contient seront retirés de la bibliothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, כל תיקיות המשנה והספר שבפנים יוסרו מהספרייה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, इसके सभी सबफ़ोल्डर और अंदर की पुस्तक लाइब्रेरी से हटा दिए जाएँगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, semua subfolder, dan buku di dalamnya akan dibuang dari pustaka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, le eventuali sottocartelle e il libro al suo interno verranno rimossi dalla libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@、サブフォルダ、および中のブックはライブラリから取り除かれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, 모든 하위 폴더, 그 안의 책이 보관함에서 제거됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, alle submappen en het boek erin worden uit de bibliotheek weggehaald."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Z biblioteki zostaną usunięte: %@, wszystkie podfoldery i książka znajdująca się w środku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A pasta %@, as subpastas e o livro dentro dela serão removidos da biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, все вложенные папки и книга внутри будут убраны из библиотеки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, eventuella undermappar och boken inuti tas bort från biblioteket."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ รวมถึงโฟลเดอร์ย่อยและหนังสือเล่มข้างในจะถูกนำออกจากไลบรารี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, tüm alt klasörleri ve içindeki kitap kitaplıktan kaldırılacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, усі підпапки та книгу всередині буде вилучено з бібліотеки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@، اس کے تمام ذیلی فولڈر اور اندر موجود کتاب لائبریری سے ہٹا دیے جائیں گے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, mọi thư mục con và cuốn sách bên trong sẽ bị gỡ khỏi thư viện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@、所有子文件夹以及其中的图书都将从资料库中移除。"
          }
