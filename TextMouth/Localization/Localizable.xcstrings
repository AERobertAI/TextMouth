        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth는 다음에 열릴 때 %1$@의 보관함을 열지만, 스스로 다시 열 수 없었습니다: %2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth vai abrir a biblioteca em %1$@ na próxima vez que abrir, mas não conseguiu abrir de novo sozinho: %2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "При следующем запуске TextMouth откроет библиотеку в %1$@, но сам заново открыться не смог: %2$@"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth відкриє бібліотеку в %1$@ під час наступного запуску, але не зміг відкритися знову сам: %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 下次打开时会打开 %1$@ 中的资料库，但无法自行重新打开：%2$@"
          }
        }
      }
    },
    "TextMouth will quit and open again to load it." : {
      "comment" : "Last sentence of the question asked before using another library: TextMouth opens again.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سيتم إنهاء TextMouth وفتحه مرة أخرى لتحميلها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এটি লোড করতে TextMouth প্রস্থান করে আবার খুলবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth wird beendet und erneut geöffnet, um sie zu laden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth saldrá y se abrirá de nuevo para cargarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth va quitter puis se rouvrir pour la charger."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसे लोड करने के लिए TextMouth बंद होकर फिर खुलेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth akan keluar dan terbuka lagi untuk memuatnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth uscirà e si riaprirà per caricarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は終了して開き直し、それを読み込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
