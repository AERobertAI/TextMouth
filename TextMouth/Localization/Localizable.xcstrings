        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Er erscheint erneut, wenn das Problem nach dem Verschwinden wiederkehrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vuelve a aparecer si el problema regresa después de resolverse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il réapparaît si le problème revient après avoir disparu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "समस्या दूर होने के बाद यदि वह लौटती है, तो यह फिर दिखाई देती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Muncul lagi jika masalah kembali setelah teratasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ricompare se il problema si ripresenta dopo essere stato risolto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "問題が解消したあとに再び発生すると、もう一度表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "문제가 해결된 후 다시 발생하면 이 알림이 다시 나타납니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O aviso reaparece se o problema voltar depois de desaparecer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Оно появится снова, если проблема вернётся после устранения."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Воно з’явиться знову, якщо проблема повернеться після усунення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "如果问题在消除后再次出现，它会重新显示。"
          }
        }
      }
    },
    "It belongs to its feed while it is downloaded. %@ removes its file and keeps its place and bookmarks." : {
      "comment" : "Why a feed episode's book cannot be removed from the library: it belongs to its feed. %@ is the name of the Delete Download command, which the sentence recommends.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es gehört zu seinem Feed, solange es heruntergeladen ist. %@ entfernt die Datei und behält die Stelle und die Lesezeichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pertenece a su canal mientras está descargado. %@ quita su archivo y conserva su lugar y sus marcadores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il appartient à son flux tant qu’il est téléchargé. %@ retire son fichier et conserve sa position et ses signets."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "जब तक वह डाउनलोड है, वह अपने फ़ीड का हिस्सा है। “%@” उसकी फ़ाइल हटाता है और उसका स्थान तथा बुकमार्क रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ini milik feed-nya selama masih diunduh. %@ membuang filenya dan mempertahankan posisi serta markahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Appartiene al suo feed finché è scaricato. %@ rimuove il suo file e conserva il punto di lettura e i segnalibri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ダウンロードされている間は、フィードに属します。%@を選択すると、ファイルは取り除かれ、位置とブックマークは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "다운로드된 동안에는 피드에 속해 있습니다. %@은(는) 파일을 제거하고 위치와 북마크는 유지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ele pertence ao feed enquanto está baixado. %@ remove o arquivo dele e mantém a posição e os marcadores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Пока книга загружена, она принадлежит своей ленте. %@ удаляет её файл и сохраняет позицию чтения и закладки."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вона належить своїй стрічці, поки її завантажено. %@ вилучає її файл і зберігає місце та закладки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "它在下载期间属于其订阅源。%@ 会移除其文件，但保留其位置和书签。"
          }
        }
      }
    },
    "It can be downloaded again." : {
      "comment" : "What VoiceOver says after Delete Download deleted a download that kept nothing of the listener's: the item can be downloaded again.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es kann erneut heruntergeladen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se puede descargar de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
