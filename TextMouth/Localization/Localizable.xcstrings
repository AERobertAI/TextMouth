    "To use another folder, open Settings, Storage, and choose %@ or %@." : {
      "comment" : "Sentence on the Library Not Available screen that points to the way to another library. Settings and Storage are the names of the settings window and its tab; %1$@ and %2$@ are the names of two buttons in Storage settings, as they show them.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um einen anderen Ordner zu verwenden, öffne Einstellungen, Speicher und wähle %1$@ oder %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To use another folder, open Settings, Storage, and choose %1$@ or %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para usar otra carpeta, abre Ajustes, Almacenamiento y elige %1$@ o %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pour utiliser un autre dossier, ouvrez Réglages, Stockage, et choisissez %1$@ ou %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Per usare un’altra cartella, apri Impostazioni, Archiviazione e scegli %@ o %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para usar outra pasta, abra Ajustes, Armazenamento e escolha %1$@ ou %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Чтобы использовать другую папку, откройте «Настройки», «Хранилище» и выберите «%1$@» или «%2$@»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Щоб використати іншу папку, відкрийте «Налаштування», вкладку «Сховище» і виберіть «%1$@» або «%2$@»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "要使用其他文件夹，请打开“设置”，进入“存储”，然后选择 %1$@ 或 %2$@。"
          }
        }
      }
    },
    "To use it, choose %@ on the Text tab in Settings." : {
      "comment" : "Advice after the refusal of a pronunciation lexicon on the Mac. %@ is the title of the import button on the Text tab of Settings, which is another string of the app.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zum Verwenden wähle %@ im Tab „Text“ in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para usarlo, elige %@ en la pestaña Texto de Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pour l’utiliser, choisissez %@ dans l’onglet Texte des Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Per usarlo, scegli %@ nella scheda Testo delle Impostazioni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para usá-lo, escolha %@ na aba Texto em Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Чтобы использовать его, выберите %@ на вкладке «Текст» в Настройках."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Щоб ним скористатися, виберіть %@ на вкладці «Текст» у налаштуваннях."
          }
        }
      }
    },
    "To use it, open the book and choose %@ from the Book menu." : {
      "comment" : "Last sentence of a notice after an import, saying how to attach the transcript file by hand. %@ is the name of the Attach Transcript command in the Book menu.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um es zu verwenden, öffne das Buch und wähle im Menü „Buch“ den Befehl „%@“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para usarla, abre el libro y elige %@ en el menú Libro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pour l’utiliser, ouvrez le livre et choisissez %@ dans le menu Livre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Per usarla, apri il libro e scegli %@ dal menu Libro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para usá-la, abra o livro e escolha %@ no menu Livro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Чтобы использовать её, откройте книгу и выберите «%@» в меню «Книга»."
          }
        }
      }
    },
    "Today" : {
      "comment" : "Title of the Stats pane's tile showing the listening time of today.",
      "localizations" : {
