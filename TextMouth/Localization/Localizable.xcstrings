    "bookTextEdit.recordUnavailable" : {
      "comment" : "Reason after a colon: an edit could not be saved to the library now; begins in lower case.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يمكن تغيير سجل الكتاب الآن. سيحاول TextMouth مرة أخرى عند الحفظ أو العودة في المرة التالية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইটির রেকর্ড এখন বদলানো যাচ্ছে না। আপনি পরের বার সংরক্ষণ করলে বা ফিরে এলে TextMouth আবার চেষ্টা করবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "der Eintrag des Buchs kann gerade nicht geändert werden. TextMouth versucht es erneut, wenn du das nächste Mal sicherst oder zurückkehrst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the book's record can't be changed now. TextMouth tries again when you next save or return."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "el registro del libro no se puede cambiar ahora. TextMouth vuelve a intentarlo la próxima vez que guardes o vuelvas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "رکورد کتاب اکنون قابل تغییر نیست. TextMouth دفعه بعد که ذخیره کنید یا برگردید دوباره تلاش می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "la fiche du livre ne peut pas être modifiée pour l’instant. TextMouth réessaiera à votre prochain enregistrement ou retour."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא ניתן לשנות כעת את רשומת הספר. TextMouth ינסה שוב בשמירה או בחזרה הבאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पुस्तक का रिकॉर्ड अभी बदला नहीं जा सकता। TextMouth अगली बार आपके सहेजने या लौटने पर फिर से प्रयास करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "catatan buku tidak dapat diubah sekarang. TextMouth mencoba lagi saat Anda menyimpan berikutnya atau kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "il record del libro non può essere modificato ora. TextMouth riprova al prossimo salvataggio o ritorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブックのレコードを今は変更できません。次に保存するか戻るときに、TextMouth がもう一度試します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책의 레코드를 지금 변경할 수 없습니다. 다음에 저장하거나 돌아올 때 TextMouth가 다시 시도합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "de gegevens van het boek kunnen nu niet worden gewijzigd. TextMouth probeert het opnieuw wanneer je de volgende keer bewaart of terugkeert."
          }
        },
        "pl" : {
          "stringUnit" : {
