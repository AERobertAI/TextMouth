            "value" : "এগুলোর অবস্থান, বুকমার্ক ও ট্রান্সক্রিপ্ট (থাকলে) রাখা হয়, আর এগুলো আবার ডাউনলোড করা যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ihre Positionen, Lesezeichen und Transkripte, falls vorhanden, bleiben erhalten, und sie können erneut heruntergeladen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
