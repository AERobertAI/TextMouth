          }
        }
      }
    },
    "It has a page list, and the start of each page is marked in the text." : {
      "comment" : "A sentence of the accessibility summary written into an exported EPUB: the book has pages.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tiene una lista de páginas, y el inicio de cada página está marcado en el texto."
          }
        }
      }
    },
    "It has no headings, so the contents list has %lld entries for its chapters and the places it marks." : {
      "comment" : "A sentence of the accessibility summary written into an exported EPUB: the book has no headings and its contents list has several entries. %lld is the number of entries.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "It has no headings, so the contents list has %lld entry for its chapters and the places it marks."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "It has no headings, so the contents list has %lld entries for its chapters and the places it marks."
                }
