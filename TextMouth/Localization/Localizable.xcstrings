    "librarySessionLease.warningMessage.positions" : {
      "comment" : "Last sentence of the warning that another Mac has this library open: the risk.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "قد يؤدي استخدام مكتبة واحدة على جهازي Mac في الوقت نفسه إلى فقدان مواضع القراءة والتغييرات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "একই সময়ে দুটি Mac-এ একটি লাইব্রেরি ব্যবহার করলে পড়ার অবস্থান ও পরিবর্তন হারিয়ে যেতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wird eine Bibliothek gleichzeitig auf zwei Macs verwendet, können Leseposition und Änderungen verloren gehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using one library on two Macs at the same time can lose reading positions and changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usar una biblioteca en dos Mac al mismo tiempo puede hacer perder posiciones de lectura y cambios."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "استفاده هم‌زمان از یک کتابخانه روی دو Mac می‌تواند موقعیت‌های مطالعه و تغییرات را از بین ببرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Utiliser une même bibliothèque sur deux Mac en même temps peut faire perdre des positions de lecture et des modifications."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "שימוש בספרייה אחת בשני מחשבי Mac בו-זמנית עלול לגרום לאובדן מיקומי קריאה ושינויים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "एक ही लाइब्रेरी को एक साथ दो Mac पर उपयोग करने से पठन स्थितियाँ और बदलाव खो सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Memakai satu pustaka di dua Mac sekaligus dapat menghilangkan posisi baca dan perubahan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usare una libreria su due Mac contemporaneamente può far perdere posizioni di lettura e modifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "1つのライブラリを2台の Mac で同時に使うと、読書位置や変更が失われることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "하나의 보관함을 Mac 두 대에서 동시에 사용하면 읽기 위치와 변경 사항을 잃을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Als je één bibliotheek tegelijk op twee Macs gebruikt, kunnen leesposities en wijzigingen verloren gaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Używanie jednej biblioteki na dwóch komputerach Mac jednocześnie może spowodować utratę pozycji czytania i zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usar uma biblioteca em dois Macs ao mesmo tempo pode causar a perda de posições de leitura e de alterações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Одновременное использование одной библиотеки на двух Mac может привести к потере позиций чтения и изменений."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Att använda ett bibliotek på två Mac-datorer samtidigt kan göra att läspositioner och ändringar går förlorade."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "การใช้ไลบรารีเดียวบน Mac สองเครื่องพร้อมกันอาจทำให้ตำแหน่งการอ่านและการเปลี่ยนแปลงสูญหาย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bir kitaplığı aynı anda iki Mac'te kullanmak okuma konumlarının ve değişikliklerin kaybolmasına neden olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Одночасне використання однієї бібліотеки на двох Mac може призвести до втрати позицій читання та змін."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ایک ہی وقت میں دو Mac پر ایک لائبریری استعمال کرنے سے مطالعے کی پوزیشنیں اور تبدیلیاں ضائع ہو سکتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dùng một thư viện trên hai máy Mac cùng lúc có thể làm mất vị trí đọc và các thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "同时在两台 Mac 上使用同一个资料库，可能会丢失阅读位置和更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在兩部 Mac 上同時使用同一個書庫，可能會遺失閱讀位置和更改。"
          }
        }
      }
    },
