        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth sparar dem när flytten av datamappen är klar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth จะบันทึกการเปลี่ยนแปลงเมื่อการย้ายโฟลเดอร์ข้อมูลสิ้นสุด"
