    "Folder “%@” in %@ is “%@” in %@." : {
      "comment" : "A difference found by Compare Libraries: the same folder has two paths. %1$@ is its path in this copy, %2$@ is this copy, %3$@ is its path in the other copy, and %4$@ is the other copy.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@ hat den Ordner „%1$@“, %4$@ hat ihn als „%3$@“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Folder “%1$@” in %2$@ is “%3$@” in %4$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La carpeta “%1$@” en %2$@ es “%3$@” en %4$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le dossier « %@ » dans %@ est « %@ » dans %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La cartella “%@” in %@ è “%@” in %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A pasta “%1$@” em %2$@ é “%3$@” em %4$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Папка «%1$@» (%2$@) — это «%3$@» (%4$@)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Папка має два шляхи: «%1$@» (%2$@) і «%3$@» (%4$@)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@ 中的文件夹“%1$@”在 %4$@ 中是“%3$@”。"
          }
        }
      }
    },
    "Folder “%@” is only in %@." : {
      "comment" : "A difference found by Compare Libraries. %1$@ is a library folder's path and %2$@ is the copy of the library that has it.",
