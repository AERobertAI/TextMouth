    "storageSettings.resetMessage" : {
      "comment" : "Message of the question asked before moving the library back to the default location. %1$@ is the current folder's path; %2$@ is the default folder's path.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ينقل هذا كل البيانات من %@ إلى الموقع الافتراضي، %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এটি %1$@ থেকে সব ডেটা ডিফল্ট অবস্থান %2$@-এ ফিরিয়ে নেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
