    "audioEditor.explanation.editorShowMarkers" : {
      "comment" : "Hint of the audio editor's Show Markers button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يسرد العلامات وعلامات الفصل والوقفات، للانتقال إليها أو تسميتها أو تحديدها أو حذفها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "মার্কার, অধ্যায় মার্কার ও নীরবতার তালিকা দেখায়, যেখানে যাওয়া, নাম দেওয়া, নির্বাচন করা বা মোছা যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Listet Marker, Kapitelmarken und Pausen auf, die du ansteuern, benennen, auswählen oder löschen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lists markers, chapter markers, and pauses, to go to, name, select, or delete."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Muestra una lista de marcas, marcas de capítulo y pausas, para ir a ellas, nombrarlas, seleccionarlas o eliminarlas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "علامت‌ها، علامت‌های فصل و وقفه‌ها را فهرست می‌کند تا به آن‌ها بروید، نامی برایشان بگذارید، انتخابشان کنید یا حذفشان کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Liste les marqueurs, les marqueurs de chapitre et les pauses, pour y aller, les nommer, les sélectionner ou les supprimer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מציג רשימה של נקודות ציון, נקודות ציון של פרקים והפסקות, למעבר, למתן שם, לבחירה או למחיקה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "मार्कर, अध्याय मार्कर और विराम सूचीबद्ध करता है; इन पर जाया, इन्हें नाम दिया, चुना या मिटाया जा सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menampilkan daftar penanda, penanda bab, dan jeda, untuk dituju, diberi nama, dipilih, atau dihapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elenca marcatori, marcatori di capitolo e pause, per andare a uno, assegnargli un nome, selezionarlo o eliminarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "マーカー、チャプタマーカー、無音を一覧にし、移動、名前の設定、選択、削除ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "마커, 챕터 마커, 정지 구간을 나열하며, 이동, 이름 지정, 선택, 삭제를 할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toont markeringen, hoofdstukmarkeringen en pauzes, om ernaartoe te gaan, een naam te geven, te selecteren of te verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wyświetla znaczniki, znaczniki rozdziałów i przerwy, do których można przejść, które można nazwać, zaznaczyć lub usunąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lista marcas, marcas de capítulo e pausas, para ir até elas, nomeá-las, selecioná-las ou excluí-las."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Показывает метки, метки глав и паузы, чтобы переходить к ним, называть, выделять или удалять их."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Listar ljudmärken, kapitelmärken och pauser, som du kan gå till, namnge, markera eller radera."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "แสดงรายการเครื่องหมาย เครื่องหมายบท และช่วงหยุด เพื่อไปที่ ตั้งชื่อ เลือก หรือลบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "İşaretleri, bölüm işaretlerini ve duraklamaları listeler; gitmek, adlandırmak, seçmek veya silmek için."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Показує мітки, мітки розділів і паузи, щоб перейти до них, назвати, виділити чи видалити."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مارکر، باب مارکر اور وقفے درج کرتا ہے، تاکہ ان پر جایا جا سکے، ان کا نام رکھا جا سکے، انہیں منتخب یا حذف کیا جا سکے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Liệt kê điểm đánh dấu, điểm đánh dấu chương và quãng nghỉ để đi tới, đặt tên, chọn hoặc xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "列出标记、章节标记和停顿，以便前往、命名、选择或删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "列出標記、章節標記和停頓，可前往、命名、選取或刪除。"
          }
        }
      }
    },
    "audioEditor.explanation.editorSkipBack" : {
      "comment" : "Hint of the audio editor's Skip Back button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ينقل المؤشر للخلف بمقدار ثانية واحدة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "কার্সর এক সেকেন্ড পিছিয়ে নেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bewegt den Cursor um eine Sekunde zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves the cursor back one second."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mueve el cursor un segundo hacia atrás."
          }
