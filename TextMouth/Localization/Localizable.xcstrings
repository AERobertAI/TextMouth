            "state" : "machine_translated",
            "value" : "Interrotta dopo %@ su %@:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Interrompido após %1$@ de %2$@:"
          }
        }
      }
    },
    "Stopped downloading “%@”." : {
      "comment" : "What VoiceOver says once Cancel Download stopped a download. %@ is the episode's or article's title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
