    "feed.nothingToMoveToLibrary" : {
      "comment" : "What VoiceOver says when Move to Library is chosen and no selected book is a feed's download. %@ is the name of the Move to Library command, with its ellipsis.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ينقل حلقة أو مقالة تم تنزيلها في موجزها. حدد واحدة في مجلد موجزها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ দিয়ে ফিডে ডাউনলোড করা পর্ব বা নিবন্ধ স্থানান্তর করা যায়। ফিডের ফোল্ডারে একটি নির্বাচন করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ verschiebt Heruntergeladenes aus einem Feed, etwa eine Folge oder einen Artikel. Wähle dazu im Ordner des Feeds einen Eintrag aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ moves an episode or article downloaded in its feed. Select one in its feed's folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ mueve un episodio o artículo descargado en su canal. Selecciona uno en la carpeta de su canal."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ قسمت یا مقاله‌ای را که در فید آن بارگیری شده منتقل می‌کند. یکی را در پوشه‌ی فید آن انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ déplace un épisode ou un article téléchargé dans son flux. Sélectionnez-en un dans le dossier de son flux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” מעביר אפיזודה או כתבה שהורדו בערוץ שלהן. בחר אחת מהן בתיקיית הערוץ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” किसी फ़ीड में डाउनलोड हुए एपिसोड या लेख को ले जाता है। उसके फ़ीड के फ़ोल्डर में एक चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ memindahkan episode atau artikel yang diunduh di feed-nya. Pilih salah satu di folder feed-nya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il comando %@ sposta un episodio o un articolo scaricato dal suo feed. Selezionane uno nella cartella del feed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」は、フィードでダウンロードしたエピソードまたは記事を移動します。そのフィードのフォルダ内で1つ選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@은(는) 피드에서 다운로드한 에피소드나 기사를 이동합니다. 해당 피드의 폴더에서 하나를 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ verplaatst een aflevering of artikel dat in de feed is gedownload. Selecteer er een in de map van de feed."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ przenosi odcinek lub artykuł pobrany z kanału. Zaznacz pozycję w folderze tego kanału."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ move um episódio ou artigo baixado de um feed. Selecione um na pasta do feed."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ перемещает выпуск или статью, загруженные из ленты. Выберите выпуск или статью в папке ленты."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ flyttar ett avsnitt eller en artikel som hämtats i sitt flöde. Markera ett i flödets mapp."
