    "epubExportWriter.writeFailureSentence.other" : {
      "comment" : "Why an EPUB export failed: the write failed and the disk may be full.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّرت كتابة ملف EPUB، لأن القرص قد يكون ممتلئًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "EPUB ফাইল লেখা যায়নি, কারণ ডিস্ক পূর্ণ থাকতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die EPUB-Datei konnte nicht geschrieben werden, weil der Datenträger voll sein könnte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The EPUB file could not be written, because the disk may be full."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo escribir el archivo EPUB, porque el disco puede estar lleno."
          }
