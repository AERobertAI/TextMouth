    "memoryQuitMarker.announcement.book" : {
      "comment" : "Alert text at the next launch after TextMouth quit to protect the Mac, when a book played whose title was not kept. %1$@ is the date and time of the quit; %2$@ is how large its memory grew, in gigabytes, such as 6.1.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم إنهاء TextMouth في %1$@: تضخمت ذاكرته إلى %2$@ غيغابايت أثناء تشغيل كتاب، بسبب عطل في صوت macOS. حُفظ موضعك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth %1$@ তারিখে বন্ধ হয়েছে: একটি বই চলার সময় macOS-এর অডিওর একটি ত্রুটির কারণে এর মেমরি %2$@ GB-এ পৌঁছেছিল। আপনার অবস্থান সংরক্ষিত হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth wurde am %1$@ beendet: Wegen eines Fehlers im Audiosystem von macOS wuchs sein Speicher auf %2$@ GB, während ein Buch wiedergegeben wurde. Deine Position wurde gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth quit on %@: its memory grew to %@ GB while a book played, because of a fault in macOS's audio. Your place was saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth se cerró el %1$@: su memoria creció hasta %2$@ GB mientras se reproducía un libro, por un fallo del audio de macOS. Se guardó tu posición."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth در %1$@ بسته شد: حافظه‌اش به %2$@ GB رسید در حالی که کتابی پخش می‌شد، به‌دلیل نقصی در صدای macOS. جای شما ذخیره شد."
          }
        },
        "fr" : {
          "stringUnit" : {
