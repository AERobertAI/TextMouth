        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não há assinaturas para exportar: todos os feeds da sua biblioteca estão sem assinatura."
          }
        }
      }
    },
    "There is a file at %@, not a folder." : {
      "comment" : "First sentence of why the chosen location can't be used: a file is there. %@ is the path.\nWhy the library can't be used: a file sits where the library's folder should be. %@ is the path.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "An %@ liegt eine Datei, kein Ordner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hay un archivo en %@, no una carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il y a un fichier dans %@, pas un dossier."
          }
