        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce fichier XML n’est ni un livre DTBook, ni un document XML Word 2003, ni un fichier braille PEF, les seuls XML que TextMouth lit."
