    "libraryFolderSettings.folderHint" : {
      "comment" : "Hint of the Library toolbar button, in a plain folder, that opens the folder's settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يفتح إعدادات المجلد: ما يحتويه وما يحدث عند انتهاء أحد كتبه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফোল্ডারের সেটিংস খোলে: এতে কী আছে, আর এর একটি বই শেষ হলে কী হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffnet die Einstellungen des Ordners: was er enthält und was passiert, wenn eines seiner Bücher endet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens the folder's settings: what it holds, and what happens when one of its books ends"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre los ajustes de la carpeta: qué contiene y qué pasa cuando termina uno de sus libros"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تنظیمات پوشه را باز می‌کند: آنچه در آن است، و آنچه هنگام پایان یکی از کتاب‌های آن رخ می‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ouvre les réglages du dossier : ce qu’il contient, et ce qui se passe à la fin d’un de ses livres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "פותח את הגדרות התיקייה: מה היא מכילה, ומה קורה כשאחד מספריה מסתיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फ़ोल्डर की सेटिंग खोलता है: उसमें क्या है, और उसकी कोई पुस्तक खत्म होने पर क्या होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuka pengaturan folder: apa isinya, dan apa yang terjadi saat salah satu bukunya selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apre le impostazioni della cartella: che cosa contiene e che cosa succede quando finisce uno dei suoi libri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フォルダの設定を開きます：中身と、ブック終了時の動作。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "폴더 설정을 엽니다. 폴더에 들어 있는 항목과 책이 끝날 때의 동작을 설정할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Opent de instellingen van de map: wat die bevat, en wat er gebeurt als een van de boeken eindigt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Otwiera ustawienia folderu: co zawiera i co dzieje się po zakończeniu jednej z jego książek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre os ajustes da pasta: o que ela contém e o que acontece quando um dos livros dela termina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Открывает настройки папки: что в ней находится и что происходит, когда заканчивается одна из её книг."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öppnar mappens inställningar: vad den innehåller och vad som händer när en av dess böcker tar slut."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เปิดการตั้งค่าของโฟลเดอร์: สิ่งที่มีอยู่ และสิ่งที่เกิดขึ้นเมื่อหนังสือเล่มหนึ่งจบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Klasörün ayarlarını açar: neyi tuttuğu ve kitaplarından biri bitince ne olacağı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відкриває налаштування папки: що вона містить і що відбувається, коли закінчується одна з її книг."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فولڈر کی ترتیبات کھولتا ہے: اس میں کیا ہے، اور اس کی کوئی کتاب ختم ہونے پر کیا ہوتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mở cài đặt của thư mục: nó chứa gì, và điều xảy ra khi một sách của nó kết thúc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "打开文件夹的设置：其包含的内容，以及其中一本图书结束时的行为。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "打開檔案夾的設定：它包含的內容，以及其中一本書結束時的處理方式。"
          }
        }
      }
    },
