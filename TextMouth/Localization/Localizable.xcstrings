    "librarySheet.moveContentsExplanation" : {
      "comment" : "Explanation in the sheet that chooses where a folder's contents go before the folder is deleted. %@ is the folder's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اختر مكان نقل الكتب والمجلدات الفرعية قبل حذف “%@”."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” মুছে ফেলার আগে বই ও সাবফোল্ডারগুলো কোথায় সরাবেন তা বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wähle, wohin die Bücher und Unterordner verschoben werden sollen, bevor „%@“ gelöscht wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose where to move the books and subfolders before deleting \"%@\"."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige adónde mover los libros y subcarpetas antes de eliminar \"%@\"."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "انتخاب کنید کتاب‌ها و زیرپوشه‌ها پیش از حذف «%@» به کجا منتقل شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisissez où déplacer les livres et les sous-dossiers avant de supprimer « %@ »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בחר לאן להעביר את הספרים ואת תיקיות המשנה לפני מחיקת “%@”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” को मिटाने से पहले चुनें कि पुस्तकें और सबफ़ोल्डर कहाँ ले जाने हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pilih tujuan untuk memindahkan buku dan subfolder sebelum menghapus “%@”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scegli dove spostare i libri e le sottocartelle prima di eliminare “%@”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」を削除する前に、ブックとサブフォルダの移動先を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@”을(를) 삭제하기 전에 책과 하위 폴더를 이동할 위치를 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kies waarheen de boeken en submappen worden verplaatst voordat “%@” wordt verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wybierz, dokąd przenieść książki i podfoldery przed usunięciem folderu „%@”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escolha para onde mover os livros e as subpastas antes de excluir “%@”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Выберите, куда переместить книги и вложенные папки перед удалением «%@»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Välj vart böckerna och undermapparna ska flyttas innan ”%@” raderas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เลือกตำแหน่งที่จะย้ายหนังสือและโฟลเดอร์ย่อยไปก่อนลบ “%@”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” silinmeden önce kitapların ve alt klasörlerin taşınacağı yeri seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Виберіть, куди перемістити книги та підпапки, перш ніж видалити «%@»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” کو حذف کرنے سے پہلے منتخب کریں کہ کتابیں اور ذیلی فولڈر کہاں منتقل کیے جائیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chọn nơi chuyển sách và thư mục con trước khi xóa “%@”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "删除“%@”前，请选取图书和子文件夹要移到哪里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "刪除「%@」之前，請選擇要將書籍和子檔案夾移到哪裡。"
          }
        }
      }
    },
