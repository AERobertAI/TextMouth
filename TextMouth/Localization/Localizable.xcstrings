            "value" : "%@ شاید سائن آؤٹ ہو یا چل نہ رہا ہو۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ có thể đã đăng xuất hoặc không chạy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 可能已退出登录或未运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 可能已登出或未在執行。"
          }
        }
      }
    },
    "dataDirectoryUnavailability.notOnThisMac" : {
      "comment" : "Why the library can't be used yet: some of its files are only in the cloud. %@ is the cloud service's name, or \"the cloud\" when it is unknown.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
