        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "the record of %1$@ in %2$@"
          }
        }
      }
    },
    "the recording window" : {
      "comment" : "Names where a keyboard shortcut works, inside a sentence such as \"Works in the recording window.\": the Record window. Lower case in English, since it is in the middle of a sentence."
    },
    "the server" : {
      "comment" : "What a message calls a feed's server when its address names no host, as in \"the server sent no answer\". Lower case."
    },
    "the server sent no answer" : {
      "comment" : "The reason a connection to a feed's server failed: it sent nothing back. Follows \"<server> couldn't be reached:\". Lower case, without a full stop."
    },
    "the top of your library" : {
      "comment" : "Where a book is when it is in no library folder, as in \"Moved “Ep. 368” into the top of your library.\" Lower case."
    },
    "their files are deleted permanently and cannot be recovered" : {
      "comment" : "A clause about several books' files when they are deleted permanently, inside a sentence of a removal confirmation."
    },
    "their files go to the Trash, where you can recover them until the Trash is emptied" : {
      "comment" : "A clause about several books' files when they are moved to the Trash, inside a sentence of a removal confirmation."
    },
    "their files stay in the TextMouth library folder" : {
      "comment" : "A clause about several books' files when they are removed from the library only, inside a sentence of a removal confirmation."
    },
    "third" : {
      "comment" : "Ordinal word 3rd, naming which of several pages that carry the same label a page is. Lower case, as it follows \"the\"."
    },
    "this Mac no longer has it" : {
      "comment" : "Why a braille table of this Mac was refused, ending a sentence such as \"TextMouth can't use this Mac's table X: this Mac no longer has it.\"."
    },
    "this copy" : {
      "comment" : "What the Compare Libraries sheet calls the library in use inside a sentence, in lower case: \"Book only in this copy\"."
    },
    "this format" : {
      "comment" : "Stands for the name of a file's format inside a sentence about importing it, when the file's name and its bytes name none, as in \"TextMouth can't read “Clip” as this format.\""
    },
    "title or author contains “%@”" : {
      "comment" : "Library view editor: a condition inside a filter's description. %@ is the text the listener typed to look for."
    },
    "title or author does not contain “%@”" : {
      "comment" : "Library view editor: a condition inside a filter's description. %@ is the text the listener typed to look for."
    },
    "today at %@" : {
      "comment" : "A moment on the day of the check. %@ is the time of day, such as 3:05 PM. Lower case."
    },
    "too loud" : {
      "comment" : "A word describing the microphone's loudness in the Record window: peaks reach the top and are cut off. Lower case, since it follows figures."
    },
    "transcript" : {
      "comment" : "The transcript that a deleted download kept, a noun inside a list such as \"the place and transcript kept for 1 removed download\". Lower case."
    },
    "transcripts" : {
      "comment" : "The transcripts that several deleted downloads kept, a noun inside a list such as \"the places and transcripts kept for 3 removed downloads\". Lower case."
    },
    "try again" : {
      "comment" : "The next step after a refusal, when the listener repeats the command: \"Close it, then try again.\" Written in lower case, without a full stop, to follow \"then\"."
    },
    "unknown length" : {
      "comment" : "A length of audio that is no length (not a finite number of seconds), said in a sentence, such as \"Cut unknown length.\""
    },
    "unsubscribed" : {
      "comment" : "Library view editor: a condition inside a filter's description: the listener is not subscribed to the feed."
    },
    "use Google Drive's Offline Access menu" : {
      "comment" : "A clause that follows \"then\" in a sentence that tells how to free a book's space: what to do in Google Drive. Offline Access is Google Drive's own menu name."
    },
    "use the drive's own command to keep the book only online" : {
      "comment" : "A clause that follows \"then\" in a sentence that tells how to free a book's space: what to do when the cloud drive is not known."
    },
    "what was kept for %lld removed downloads" : {
      "comment" : "What a feed kept for downloads the listener removed, when their packages held none of the parts named, inside a sentence about what Unsubscribe or Delete Feed does. %lld is how many removed downloads. Lower case.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "what was kept for %lld removed download"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "what was kept for %lld removed downloads"
                }
              }
            }
          }
        }
      }
    },
    "when applicable" : {
      "comment" : "A Library view's visibility in lower case, inside a row's spoken label: the View pop-up offers the view only while it lists something."
    },
    "word" : {
      "comment" : "A small tag in a substitution rule's row: the rule matches whole words only. In lower case."
    },
    "yesterday at %@" : {
      "comment" : "A moment on the day before the check. %@ is the time of day, such as 9:00 AM. Lower case."
    },
    "you stopped the comparison" : {
      "comment" : "A reason, in a clause with no capital letter and no full stop, that Use This Library could not tell which copy of the library is newer: the listener cancelled the comparison."
    },
    "“%@”" : {
      "comment" : "Puts a book's, folder's, or feed's title in quotation marks inside a sentence. %@ is the title."
    },
    "“%@” (%@)" : {
      "comment" : "One skipped entry of a playlist in a list: its location in curly quotes, then its reason in parentheses. %1$@ is the location and %2$@ the reason.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” (%2$@)"
          }
        }
      }
    },
    "“%@” becomes “%@”, inside words too: %@." : {
      "comment" : "Heading of one rule's changes in the Clean Up Transcript sheet, for a rule that also changes the text inside longer words. %1$@ is the text the rule looks for; %2$@ is the text it puts in its place; %3$@ is the number of corrections, such as \"4 corrections\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” becomes “%2$@”, inside words too: %3$@."
          }
        }
      }
    },
    "“%@” becomes “%@”: %@." : {
      "comment" : "Heading of one rule's changes in the Clean Up Transcript sheet. %1$@ is the text the rule looks for; %2$@ is the text it puts in its place; %3$@ is the number of corrections, such as \"4 corrections\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” becomes “%2$@”: %3$@."
          }
        }
      }
    },
    "“%@” beside the audio wasn't attached: %@" : {
      "comment" : "Notice after an import: a transcript file found beside the audio was not attached. %1$@ is the file's name; %2$@ is the reason, a sentence.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” beside the audio wasn't attached: %2$@"
          }
        }
      }
    },
    "“%@” can't be read as %@: %@ Nothing was changed." : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. Why the book titled bookTitle was not read again with the braille file characters named codeName: its file is not braille in them, as reason, the reader's own sentence (BrailleFileError), says, and nothing changed. It has the shape of an encoding's refusal (TextEncodingWording.notValidRefusal(bookTitle:encoding:)): \"“Ledger” can't be read as Eurobraille, six-dot (German-speaking countries): Line 3 holds the control character U+0007, which is not Eurobraille. Nothing was changed.\". Placeholders in order: bookTitle, codeName, reason.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” can't be read as %2$@: %3$@ Nothing was changed."
          }
        }
      }
    },
    "“%@” changed while it was being replaced, so TextMouth left both copies as they are. Choose Replace Existing again." : {
      "comment" : "What the duplicate question says when the library's copy changed while the new copy was being made ready. %@ is the book's title. \"Replace Existing\" is a button of the question."
    },
    "“%@” could not be moved back after a failed move, so its files are at %@ instead of %@: %@" : {
      "comment" : "Failure notice: a book's files could not be put back after a move failed. %1$@ is the book's title; %2$@ is where its files are now; %3$@ is where they belong; %4$@ is the reason, a sentence from the system.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” could not be moved back after a failed move, so its files are at %2$@ instead of %3$@: %4$@"
          }
        }
      }
    },
    "“%@” couldn't be read: %@." : {
      "comment" : "Error shown when an audio file cannot be read. %1$@ is the audio file's name; %2$@ is the reason, a short phrase in English.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” couldn't be read: %2$@."
          }
        }
      }
    },
    "“%@” downloads once this Mac is on a network without data limits." : {
      "comment" : "Why a feed item's download did not run now: the network has data limits. Says the same as the row's wait reason. %@ is the item's title."
    },
    "“%@” holds no DAISY book and no audio tracks to import as one book." : {
      "comment" : "What the library says as a folder chosen to import holds no DAISY book and no audio tracks. %@ is the folder's name. A sentence about what it holds follows."
    },
    "“%@” holds no sound to import." : {
      "comment" : "Why a file was not imported: it holds no sound, such as a video without a sound track. %@ is the file's name."
    },
    "“%@” is a Personal Voice, which macOS can't record to a file. Choose another voice with the %@ button in the reader, then export again." : {
      "comment" : "Why a spoken audio export was refused: the book's voice is a Personal Voice. %1$@ is the voice's name and %2$@ the name of the Voice button in the book's reader.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” is a Personal Voice, which macOS can't record to a file. Choose another voice with the %2$@ button in the reader, then export again."
          }
        }
      }
    },
    "“%@” is a pronunciation lexicon, not a playlist." : {
      "comment" : "Refusal of a .pls file that is a pronunciation lexicon, not a playlist. %@ is the file's name."
    },
    "“%@” is already being added to the library." : {
      "comment" : "What VoiceOver says when Cancel Download comes too late: the download's book is already being imported. %@ is the title."
    },
    "“%@” is being exported. %@, then %@." : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. Why the book titled bookTitle can't be read again while it is being exported, with what to do, as a refusal for a book in use says it (FeedBookUse.exporting): \"“Ledger” is being exported. Wait until the export ends, then try again.\". Placeholders in order: bookTitle, FeedBookUse.exporting.remedy, FeedBookUse.tryAgain.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” is being exported. %2$@, then %3$@."
          }
        }
      }
    },
    "“%@” is now read as %@." : {
      "comment" : "VoiceOver announcement once a book was read again. %1$@ is the book's title and %2$@ describes how it is read now, such as \"Windows-1251 (Cyrillic), chosen\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” is now read as %2$@."
          }
        }
      }
    },
    "“%@” is only in the cloud. Download the book, then transcribe it." : {
      "comment" : "Error shown when an audio file has not been downloaded from the cloud drive. %@ is the audio file's name."
    },
    "“%@” is recording. Stop or discard it with Clear Selection, then quit." : {
      "comment" : "Said in an audio editor when TextMouth can't quit because a punch-in records there. %@ is the book's title. \"Clear Selection\" is the name of a command."
    },
    "“%@” is still working. Quit once the change is done." : {
      "comment" : "Said in an audio editor when TextMouth can't quit because its work is under way. %@ is the book's title."
    },
    "“%@” isn't a filter's name." : {
      "comment" : "Problem found in a typed filter chain: the text before an equals sign is not a filter's name. %@ is that text."
    },
    "“%@” keeps %@." : {
      "comment" : "Text of Speak Info, Book Information's braille code and text encoding rows, and the re-read alerts. What VoiceOver hears when the listener keeps a guessed code by choosing it again: the book and the code, now the listener's own. Placeholders in order: bookTitle, codeName.",
      "localizations" : {
