    "%lld differences between this library and the copy in %@." : {
      "comment" : "First sentence of the results of Compare Libraries. %1$lld is how many differences there are, a count; %2$@ is the other copy's folder path.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld difference between this library and the copy in %@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld differences between this library and the copy in %@."
                }
              }
            }
          }
        }
      }
