      }
    },
    "This book's audio needs converting from Ogg to AAC. TextMouth is converting it now, and it plays when that ends." : {
      "comment" : "What Play says for a book found still in Ogg, whose conversion TextMouth starts.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
