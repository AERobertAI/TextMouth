        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تاریخچه ویرایش فقط در فضای ابری است، هنوز روی این Mac نیست."
          }
        },
        "fr" : {
          "stringUnit" : {
