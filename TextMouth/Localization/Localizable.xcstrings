    "manualBookOrder.feedItemCannotMoveAnnouncement" : {
      "comment" : "VoiceOver announcement when Move Book Up or Move Book Down is used on an episode or article of a feed in a folder. %@ is its title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ عنصر من موجز، ولا يمكن نقل عناصر الموجز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ একটি ফিডের আইটেম, আর ফিডের আইটেম সরানো যায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ist ein Eintrag eines Feeds, und die Einträge eines Feeds lassen sich nicht verschieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is an item of a feed, and a feed's items can't be moved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ es un elemento de un canal, y los elementos de un canal no se pueden mover."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ یک مورد از یک فید است و موردهای فید را نمی‌توان جابه‌جا کرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ est un élément d’un flux, et les éléments d’un flux ne peuvent pas être déplacés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ הוא פריט של ערוץ, ואי אפשר להעביר פריטים של ערוץ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ किसी फ़ीड का आइटम है, और फ़ीड के आइटम ले जाए नहीं जा सकते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ adalah item feed, dan item feed tidak dapat dipindahkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ è un elemento di un feed e gli elementi di un feed non possono essere spostati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@はフィードの項目なので、移動できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@은(는) 피드의 항목이며, 피드의 항목은 이동할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ is een onderdeel van een feed, en de onderdelen van een feed kunnen niet worden verplaatst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ to pozycja kanału, a pozycji kanału nie można przenosić."
