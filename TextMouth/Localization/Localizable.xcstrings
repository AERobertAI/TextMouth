    "The text of %@ was read again from its own file." : {
      "comment" : "First sentence of the message after a book's text was read again from its own file. %@ is the book's title."
    },
    "The text of this book %@, which TextMouth can't export safely. Choose Edit Text, flatten the nesting, and save; then export again." : {
      "comment" : "Why a book's text was not exported: it nests quotes, lists, or emphasis too deeply, and has no chapter markers. %@ is the clause that says how deep, such as \"nests quotes, lists, or emphasis more than 128 levels deep\". \"Edit Text\" is a command."
    },
    "The text was reloaded, but the editor's file does not say what encoding it is in, so some characters may be wrong." : {
      "comment" : "First sentence of the note after Reload from Editor read a file whose text encoding nothing in it tells."
    },
    "The tracks of the cue sheet “%@” run past the end of its audio, so its headings were not used." : {
      "comment" : "Notice that a cue sheet of an imported folder or archive was not used, because its tracks lie past the end of its audio. %@ is the cue sheet's name."
    },
    "The transcript and the text made from it are deleted." : {
      "comment" : "First sentence of the question asked before an audiobook's transcript is deleted."
    },
    "The transcript as %@ captions, one file timed from the start of the audio." : {
      "comment" : "The hint of the Transcript checkbox in the Export dialog while its transcript is written as captions. %@ is the format's name, such as WebVTT or SubRip."
    },
    "The transcript as TextMouth keeps it, in JSON, with its text as Markdown." : {
      "comment" : "The hint of the Transcript's Convert to picker in the Export dialog while JSON and Markdown is chosen."
