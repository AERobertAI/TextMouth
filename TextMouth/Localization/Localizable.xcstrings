      }
    },
    "The book is kept on this Mac, and is on the reading list, which this Mac keeps downloaded, so its download can't be removed." : {
      "comment" : "First sentence of why Remove Download was refused: the listener keeps the book and the reading list keeps it too.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El libro se mantiene en esta Mac y está en la lista de lectura, que esta Mac mantiene descargada, así que no se puede quitar su descarga."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il libro è mantenuto su questo Mac ed è nell’elenco di lettura, che questo Mac mantiene scaricato, quindi il suo download non può essere rimosso."
          }
        }
      }
    },
    "The book is kept on this Mac, so its download can't be removed." : {
      "comment" : "First sentence of why Remove Download was refused: the listener chose Keep on This Mac for the book.",
