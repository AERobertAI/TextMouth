                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "No se pudo ejecutar el OCR en %@ de %lld página, así que falta el texto que solo aparece en sus imágenes: %@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "No se pudo ejecutar el OCR en %@ de %lld páginas, así que falta el texto que solo aparece en sus imágenes: %@."
                }
              }
            }
          }
        },
        "it" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "L’OCR non ha potuto funzionare su %@ di %lld di pagine, quindi manca il testo presente solo nelle loro immagini: %@."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "L’OCR non ha potuto funzionare su %@ di %lld pagine, quindi manca il testo presente solo nelle loro immagini: %@."
