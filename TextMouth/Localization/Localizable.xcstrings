              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Articles (%lld)"
                }
              }
            }
          }
        }
      }
    },
    "Artist" : {
      "comment" : "Name of the book information sheet's field for an audiobook's artist."
    },
    "Artist or narrator" : {
      "comment" : "What VoiceOver says for the book information sheet's field for an audiobook's artist, who may be its narrator."
    },
    "Ascending" : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. A direction as the pop-up names it. This is the form for the first case of the condition."
    },
    "Ask Each Time" : {
      "comment" : "A choice of the After Importing a Book pop-up in the Storage settings: TextMouth asks what to do with the original file after each import."
    },
    "Asks before deleting." : {
      "comment" : "First sentence of the VoiceOver hint of a delete command that asks before it deletes."
    },
    "Asks first, then replaces every rule with the defaults." : {
      "comment" : "VoiceOver hint of the Reset to Defaults button in the Substitutions settings."
    },
    "Asks for an optional note, then marks the reading position." : {
      "comment" : "VoiceOver hint of the Bookmarks list's Add Bookmark button: it opens the step where an optional note is written, then the bookmark is added where the book is being read.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pide una nota opcional y luego marca la posición de lectura."
          }
        }
      }
    },
    "Asks whether to %@ or keep them in the TextMouth library folder." : {
      "comment" : "VoiceOver hint of the Remove button when it asks first. %@ is what deleting the files does, such as \"move the files to the Trash\" or \"delete the files permanently\"."
    },
    "Asterisk" : {
      "comment" : "Name of the punctuation key \"*\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Asterisk\"."
    },
    "At Sign" : {
      "comment" : "Name of the punctuation key \"@\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + At Sign\"."
    },
    "Audio Editor" : {
      "comment" : "Heading of the group of the audio editor's keyboard shortcuts in Settings."
    },
    "Audio Info…" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the audio editor group and read by VoiceOver. Shows information about the audio, such as its format and length."
    },
    "Audio Settings" : {
      "comment" : "Name of the reader's sheet and toolbar button for an audiobook's own settings (its speed), and what VoiceOver calls that button."
    },
    "Audio Speed" : {
      "comment" : "Heading of the group in an audiobook's own settings sheet that holds its speed."
    },
    "Audio speed" : {
      "comment" : "Label of an audiobook's speed slider; VoiceOver reads it before the speed."
    },
    "Author" : {
      "comment" : "Name of the book information sheet's field for a book's author; VoiceOver reads it as the field's label."
    },
    "Auto-play after navigation" : {
      "comment" : "Title and VoiceOver label of the checkbox in the Playback settings that starts playing after a jump to a heading, bookmark, or search result."
    },
    "Automatic" : {
      "comment" : "Name of the Text Encoding pop-up's first option, which reads the file again the way an import does, by guessing its encoding."
    },
    "Automatically start playing when you navigate to a heading, bookmark, or search result." : {
      "comment" : "Explanation under the Auto-play after navigation checkbox in the Playback settings."
    },
    "Available only while this feed's articles go on to another article when one ends" : {
      "comment" : "VoiceOver hint of the dimmed Open the next article in pop-up button in a news feed's Feed Info: when it can be used.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disponible solo mientras los artículos de este canal pasan a otro artículo al terminar uno"
          }
        }
      }
    },
    "Available only while this feed's episodes go on to another episode when one ends" : {
      "comment" : "VoiceOver hint of the dimmed Open the next episode in pop-up button in a podcast feed's Feed Info: when it can be used.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disponible solo mientras los episodios de este canal pasan a otro episodio al terminar uno"
          }
        }
      }
    },
    "Available only while this feed's items go on to another item when one ends" : {
