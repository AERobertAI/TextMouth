    "Sets a chapter marker at the cursor, with a title you type." : {
      "comment" : "Hint of the audio editor's Insert Chapter Marker button.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يضع علامة فصل عند المؤشر، بعنوان تكتبه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Setzt am Cursor eine Kapitelmarke mit einem Titel, den du eingibst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pone una marca de capítulo en el cursor, con un título que escribas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Place au curseur un marqueur de chapitre, avec un titre que vous saisissez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कर्सर पर, आपके लिखे शीर्षक के साथ अध्याय मार्कर सेट करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Memasang penanda bab di posisi kursor, dengan judul yang Anda ketik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Imposta un marcatore di capitolo nella posizione del cursore, con un titolo che digiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "入力したタイトルのチャプタマーカーを、カーソルの位置に設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "입력한 제목으로 커서 위치에 챕터 마커를 설정합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Define uma marca de capítulo no cursor, com um título que você digitar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Устанавливает метку главы в позиции курсора с названием, которое вы вводите."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ставить у місці курсора мітку розділу з назвою, яку ви введете."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在光标处设置章节标记，标题由你输入。"
          }
        }
      }
    },
    "Sets the transcription language. A language marked needs download downloads only from the Transcribe Audio sheet." : {
      "comment" : "VoiceOver hint of the transcription language pop-up. \"needs download\" is the status word a language's menu item shows when its speech model is not on this Mac, and Transcribe Audio is the command's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحدّد لغة التفريغ. اللغة التي يحمل نموذجها الوصف “يحتاج إلى تنزيل” لا تُنزَّل إلا من ورقة “تفريغ الصوت”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Legt die Transkriptionssprache fest. Eine als „Download nötig“ markierte Sprache lässt sich nur im Fenster „Audio transkribieren“ herunterladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Define el idioma de la transcripción. Un idioma marcado como necesita descarga solo se descarga desde la hoja Transcribir audio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Définit la langue de transcription. Une langue marquée « téléchargement requis » ne se télécharge que depuis la feuille Transcrire l’audio."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ट्रांसक्रिप्शन की भाषा सेट करता है। जिस भाषा पर “डाउनलोड आवश्यक” लिखा हो, वह केवल “ऑडियो ट्रांसक्राइब करें” शीट से डाउनलोड होती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mengatur bahasa transkripsi. Bahasa yang ditandai perlu diunduh hanya dapat diunduh dari lembar Transkripsikan Audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Imposta la lingua della trascrizione. Una lingua contrassegnata come “da scaricare” si scarica solo dal foglio Trascrivi audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文字起こしの言語を設定します。「ダウンロードが必要」と表示された言語は、「オーディオを文字起こし」のシートからのみダウンロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "대본 언어를 설정합니다. 다운로드 필요로 표시된 언어는 오디오 대본 만들기 시트에서만 다운로드됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Define o idioma da transcrição. Um idioma marcado como “precisa ser baixado” só é baixado na folha Transcrever áudio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Задаёт язык расшифровки. Язык со статусом «нужна загрузка» загружается только в листе «Расшифровать аудио»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Задає мову транскрибування. Мова з позначкою «потрібне завантаження» завантажується лише з аркуша «Транскрибувати аудіо»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "设置转录语言。标有“需要下载”的语言只能从“转录音频”下载。"
          }
        }
      }
    },
    "Sets when the View pop-up offers this view" : {
      "comment" : "Text of the Library tab of Settings, a list of the views the Library window offers (built-in views and the listener's own). The Visibility pop-up's hint.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحدد متى تتيح قائمة العرض المنبثقة هذا العرض"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
