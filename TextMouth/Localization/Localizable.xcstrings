    "phoneReader.previousHeadingHint" : {
      "comment" : "Hint of the iPhone reader's Previous Heading button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ينتقل إلى العنوان الرئيسي السابق مع إبقاء وحدة التنقل."
          }
        },
        "bn" : {
          "stringUnit" : {
