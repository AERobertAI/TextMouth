        }
      }
    },
    "Books stay on this Mac until you remove their downloads or macOS needs space." : {
      "comment" : "Second sentence of what moving the library into a cloud folder means.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تبقى الكتب على هذا الـ Mac إلى أن تزيل تنزيلاتها أو يحتاج macOS إلى مساحة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আপনি বইয়ের ডাউনলোড না সরানো পর্যন্ত, অথবা macOS-এর জায়গা দরকার না হওয়া পর্যন্ত, বইগুলো এই Mac-এ থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bücher bleiben auf diesem Mac, bis du ihre Downloads entfernst oder macOS Speicherplatz braucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los libros permanecen en esta Mac hasta que quites sus descargas o macOS necesite espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les livres restent sur ce Mac jusqu’à ce que vous retiriez leurs téléchargements ou que macOS ait besoin d’espace."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पुस्तकें इस Mac पर तब तक रहती हैं जब तक आप उनके डाउनलोड नहीं हटाते या macOS को जगह की ज़रूरत नहीं होती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Buku tetap ada di Mac ini sampai Anda membuang unduhannya atau macOS membutuhkan ruang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I libri restano su questo Mac finché non rimuovi i loro download o macOS non ha bisogno di spazio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブックは、ダウンロードを取り除くか、macOS が容量を必要とするまで、この Mac に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책은 다운로드를 제거하거나 macOS에 공간이 필요해질 때까지 이 Mac에 남아 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Os livros ficam neste Mac até você remover os downloads deles ou o macOS precisar de espaço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Книги остаются на этом Mac, пока вы не уберёте их загрузки или macOS не потребуется место."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Книги залишаються на цьому Mac, доки ви не вилучите їхні завантаження або macOS не знадобиться місце."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "图书会一直保留在这台 Mac 上，直到你移除其下载内容或 macOS 需要空间。"
          }
        }
      }
    },
