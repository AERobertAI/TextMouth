    "phoneReader.playHint.bookmark" : {
      "comment" : "Hint of the iPhone reader's Play button while the navigation unit is a bookmark.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ينتقل للخلف أو للأمام حسب الإشارة المرجعية."
