            "value" : "TextMouth l’ha lasciato lì e sta ancora usando %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth はそれをそこに残し、引き続き%@を使用しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
