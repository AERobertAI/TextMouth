    "transcription.offerNotNowHint" : {
      "comment" : "VoiceOver hint of the Not Now button of the question offered after an import. Transcribe Audio is the command's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يترك الكتاب الصوتي دون تفريغ؛ ويمكن تفريغه لاحقًا بالأمر “تفريغ الصوت”."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "অডিওবুক ট্রান্সক্রাইব না করে রেখে দেয়; পরে “অডিও ট্রান্সক্রাইব করুন” দিয়ে তা করা যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lässt das Hörbuch ohne Transkript; „Audio transkribieren“ erledigt das später."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaves the audiobook untranscribed; Transcribe Audio does it later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deja el audiolibro sin transcribir; Transcribir audio lo hace más tarde."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کتاب صوتی را رونویسی نشده می‌گذارد؛ «رونویسی صدا» بعداً آن را انجام می‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Laisse le livre audio non transcrit ; Transcrire l’audio le fera plus tard."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "משאיר את ספר השמע ללא תמלול; “תמלל שמע” עושה זאת מאוחר יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ऑडियोबुक को बिना ट्रांसक्राइब किए छोड़ देता है; “ऑडियो ट्रांसक्राइब करें” इसे बाद में करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membiarkan buku audio tanpa transkrip; Transkripsikan Audio dapat melakukannya nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lascia l’audiolibro non trascritto; potrai trascriverlo più tardi con Trascrivi audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オーディオブックを文字起こししないままにします。あとで「オーディオを文字起こし」でできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "오디오북의 대본을 만들지 않고 둡니다. 나중에 오디오 대본 만들기로 만들 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Laat het luisterboek ongetranscribeerd; Transcribeer audio doet dat later."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zostawia audiobook bez transkrypcji; później można użyć polecenia Transkrybuj dźwięk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deixa o audiolivro sem transcrição; Transcrever áudio faz isso depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Оставляет аудиокнигу нерасшифрованной; позже её можно расшифровать командой «Расшифровать аудио»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lämnar ljudboken utan transkription; Transkribera ljud kan göra det senare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ปล่อยหนังสือเสียงไว้โดยไม่ถอดเสียง ใช้คำสั่ง ถอดเสียงจากไฟล์เสียง ภายหลังได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sesli kitabı yazıya dökmeden bırakır; Sesi Yazıya Dök bunu sonra yapar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Залишає аудіокнигу без транскрипції; «Транскрибувати аудіо» зробить це пізніше."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آڈیو بک کو ٹرانسکرائب کیے بغیر چھوڑ دیتا ہے؛ “آڈیو ٹرانسکرائب کریں” اسے بعد میں کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Để sách nói chưa chép lời; bạn có thể dùng lệnh Chép lời âm thanh sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "不转录此有声书；稍后可用“转录音频”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "不轉錄這本有聲書；之後可用「轉錄音訊」進行。"
          }
        }
      }
    },
