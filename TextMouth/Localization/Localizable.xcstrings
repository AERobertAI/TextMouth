    "recording.pauseHint" : {
      "comment" : "VoiceOver hint of the Pause button in the Record window. %@ is the title of the button that continues a paused recording.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يوقف التسجيل مؤقتًا؛ ويواصل %@ التسجيل نفسه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "রেকর্ডিংয়ে বিরতি দেয়; %@ বেছে নিলে একই রেকর্ডিং চলতে থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pausiert die Aufnahme; „%@“ setzt dieselbe Aufnahme fort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauses the recording; %@ continues the same recording."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pausa la grabación; %@ continúa la misma grabación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ضبط را مکث می‌کند؛ %@ همان ضبط را ادامه می‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Met l’enregistrement en pause ; %@ le reprend."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "משהה את ההקלטה; “%@” ממשיך באותה הקלטה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "रिकॉर्डिंग को पॉज़ करता है; “%@” उसी रिकॉर्डिंग को जारी रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menjeda rekaman; %@ melanjutkan rekaman yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mette in pausa la registrazione; con %@ continua la stessa registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "録音を一時停止します。「%@」で同じ録音を続けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "녹음을 일시 정지합니다. %@을(를) 선택하면 같은 녹음을 계속합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pauzeert de opname; %@ hervat dezelfde opname."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wstrzymuje nagrywanie; %@ kontynuuje to samo nagranie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pausa a gravação; %@ continua a mesma gravação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Приостанавливает запись; «%@» продолжает ту же запись."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pausar inspelningen. %@ fortsätter samma inspelning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หยุดการบันทึกเสียงชั่วคราว เลือก %@ เพื่อบันทึกต่อในการบันทึกเสียงเดิม"
          }
        },
        "tr" : {
