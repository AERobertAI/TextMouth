    },
    "Save to Global Settings" : {
      "comment" : "Button of a text book's own settings sheet that saves its voice, speed and pitch as the settings for every book."
    },
    "Save your subscriptions as an OPML file, which other feed readers import." : {
      "comment" : "The message of the Save panel that saves the subscriptions as an OPML file."
    },
    "Saved %@" : {
      "comment" : "Said as an edited filter preset is saved. %@ is the preset's name."
    },
    "Saved %@." : {
      "comment" : "Text of the Library view editor sheet, which makes and changes a view of the Library window, and of the descriptions of a view's filter. What VoiceOver says once a changed view is saved. Placeholders in order: name."
    },
    "Saved Recording as %@" : {
      "comment" : "Announcement of the Record window once a recording is saved as an audiobook. %@ is the audiobook's title."
    },
    "Saved Recording as %@." : {
      "comment" : "Status line of the Record window once a recording is saved as an audiobook, ending with a full stop. %@ is the audiobook's title."
    },
    "Saved as" : {
      "comment" : "Label of the file format the book's audio is saved as, in the audio editor's Audio Info sheet."
    },
    "Saved copy" : {
      "comment" : "Label of the path of the saved copy of the unreadable library index file, on the library index recovery sheet."
    },
    "Saved. The book's audio is now %@ long." : {
      "comment" : "Said as the audio editor's save ends. %@ is the book's new audio length in words."
    },
    "Saves the edits into the book's audio file, in the format the book keeps." : {
