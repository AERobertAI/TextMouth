    "feed.itemPolicyApplied.follows" : {
      "comment" : "What VoiceOver says once a feed uses the global List and download choice again. The first %@ is the name of the choice; the second is the feed's title; the third is the global choice now in force.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ لـ %2$@ يتبع الآن الإعداد العام: %3$@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@-এর জন্য %1$@ এখন গ্লোবাল সেটিং অনুসরণ করে: %3$@।"
