        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile rimuovere questo libro dalla libreria, quindi resta al suo interno:"
          }
        }
      }
    },
    "This book follows the global setting now." : {
      "comment" : "Said as a book's original audio policy is set to follow the global setting. A sentence saying what that setting does follows.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieses Buch folgt jetzt der globalen Einstellung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este libro ahora sigue el ajuste global."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ora questo libro segue l’impostazione globale."
          }
        }
      }
    },
    "This book has %lld pages, from %@ to %@." : {
      "comment" : "First sentence of the Go to Page field's hint. %1$lld is the number of pages in the book; %2$@ is the first page's label and %3$@ the last page's label, identifiers such as i or 300 written without digit grouping.",
      "localizations" : {
        "en" : {
          "variations" : {
