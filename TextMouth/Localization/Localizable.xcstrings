    "recordingFailure.couldNotFinish" : {
      "comment" : "Error in the Record window when stopping could not finish the recording's file properly.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّر إنهاء التسجيل بشكل صحيح. تم الاحتفاظ بما سُجّل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "রেকর্ডিং ঠিকভাবে শেষ করা যায়নি। যা রেকর্ড হয়েছে তা রাখা হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Aufnahme konnte nicht ordnungsgemäß abgeschlossen werden. Das Aufgenommene bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recording couldn't be finished properly. What was recorded is kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo terminar bien la grabación. Lo grabado se conserva."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ضبط به درستی پایان نیافت. آنچه ضبط شده بود نگه داشته می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’enregistrement n’a pas pu être terminé correctement. Ce qui a été enregistré est conservé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא ניתן היה לסיים את ההקלטה כראוי. מה שהוקלט נשמר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "रिकॉर्डिंग ठीक से पूरी नहीं हो सकी। जो रिकॉर्ड हुआ वह सुरक्षित है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rekaman tidak dapat diselesaikan dengan benar. Hasil rekaman tetap disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile completare correttamente la registrazione. Quanto registrato è stato conservato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "録音を正しく完了できませんでした。録音済みの内容は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "녹음을 제대로 마무리할 수 없었습니다. 녹음된 내용은 보관됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De opname kon niet goed worden afgerond. Wat is opgenomen, blijft bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie udało się prawidłowo zakończyć nagrania. To, co nagrano, zostało zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
