        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ক্লাউডের একটি লাইব্রেরিতে সময় লাগতে পারে: শুধু ক্লাউডে থাকা ফাইলগুলো পড়ার জন্য আগে এই Mac-এ ডাউনলোড করা হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bei einer Bibliothek in der Cloud kann das eine Weile dauern: Dateien, die nur in der Cloud liegen, werden zum Lesen auf diesen Mac geladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A library in the cloud can take a while: its cloud-only files are downloaded to this Mac to be read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una biblioteca en la nube puede tardar: sus archivos que solo están en la nube se descargan en esta Mac para leerlos."
