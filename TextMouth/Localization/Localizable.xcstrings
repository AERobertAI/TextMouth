    "readingList.removeFinishedHint" : {
      "comment" : "VoiceOver hint of the Reading List's Remove books when finished checkbox.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يزيل كل كتاب منتهٍ من القائمة عندما تنتقل نافذته أو تُغلق. تبقى الكتب التي انتهت قبل تفعيله."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "শেষ হওয়া প্রতিটি বই তালিকা থেকে সরায়, যখন এর উইন্ডো এগিয়ে যায় বা বন্ধ হয়। চালু করার আগে যেগুলো শেষ হয়েছে সেগুলো থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Entfernt jedes beendete Buch aus der Liste, wenn sein Fenster zu einem anderen Buch wechselt oder geschlossen wird. Bücher, die vor dem Aktivieren beendet wurden, bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takes each finished book off the list when its window moves on or closes. Books finished before you turn it on stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quita de la lista cada libro terminado cuando su ventana pasa a otro libro o se cierra. Los libros terminados antes de activarlo se quedan."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هر کتاب تمام‌شده را وقتی پنجره‌اش ادامه می‌دهد یا بسته می‌شود از فهرست برمی‌دارد. کتاب‌هایی که پیش از روشن کردن این گزینه تمام شده‌اند می‌مانند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Retire chaque livre terminé de la liste quand sa fenêtre passe à un autre livre ou se ferme. Les livres terminés avant l’activation restent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מסיר כל ספר שהושלם מהרשימה כשהחלון שלו ממשיך הלאה או נסגר. ספרים שהושלמו לפני ההפעלה נשארים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "हर पूरी हुई पुस्तक को, उसकी विंडो के आगे बढ़ने या बंद होने पर, सूची से हटाता है। इसे चालू करने से पहले पूरी हुई पुस्तकें बनी रहती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuang setiap buku yang selesai dari daftar saat jendelanya berpindah atau ditutup. Buku yang selesai sebelum Anda mengaktifkannya tetap ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toglie dall’elenco ogni libro terminato quando la sua finestra passa oltre o si chiude. I libri terminati prima che tu lo attivi restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ウインドウが次へ進むか閉じたとき、読了した各ブックをリストから取り除きます。オンにする前に読了したブックは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "윈도우가 다음으로 넘어가거나 닫힐 때 완료한 책을 목록에서 제거합니다. 켜기 전에 완료한 책은 그대로 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Haalt elk voltooid boek van de lijst wanneer het venster doorgaat of sluit. Boeken die voltooid waren voordat je dit inschakelde, blijven staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usuwa każdą ukończoną książkę z listy, gdy jej okno przechodzi dalej lub się zamyka. Książki ukończone przed włączeniem tej opcji zostają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tira cada livro concluído da lista quando sua janela passa adiante ou fecha. Livros concluídos antes de você ativar isso permanecem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Убирает каждую завершённую книгу из списка, когда её окно переходит дальше или закрывается. Книги, завершённые до включения, остаются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tar bort varje avslutad bok från listan när dess fönster går vidare eller stängs. Böcker som avslutades innan du slår på alternativet finns kvar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "นำหนังสือที่อ่านจบแล้วออกจากรายการเมื่อหน้าต่างของหนังสือไปต่อหรือปิดลง หนังสือที่อ่านจบก่อนเปิดตัวเลือกนี้จะยังอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bitmiş her kitabı, penceresi başka kitaba geçtiğinde veya kapandığında listeden kaldırır. Seçeneği açmadan önce bitmiş kitaplar kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вилучає кожну завершену книгу зі списку, коли її вікно переходить далі або закривається. Книги, завершені до вмикання, залишаються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ہر مکمل کتاب کو فہرست سے ہٹا دیتا ہے جب اس کی ونڈو آگے بڑھتی یا بند ہوتی ہے۔ اسے آن کرنے سے پہلے مکمل ہوئی کتابیں رہتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gỡ mỗi sách đã đọc xong khỏi danh sách khi cửa sổ của sách chuyển sang sách khác hoặc đóng. Các sách đã đọc xong trước khi bạn bật tùy chọn này vẫn được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在窗口前进或关闭时，从列表中移除每本已读完的图书。开启之前读完的图书会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "當書籍的視窗前往下一本或關閉時，將每本已完成的書從列表中移除。開啟此選項之前已完成的書會保留。"
          }
        }
      }
    },
