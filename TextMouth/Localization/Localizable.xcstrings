    "bookTextEdit.explanation.updates" : {
      "comment" : "Fourth sentence of the Edit Text explanation: what happens when the user saves the edited text.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عند الحفظ، يُحدَّث الكتاب ويحتفظ بموضعك قدر الإمكان."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সংরক্ষণ করলে বইটি হালনাগাদ হয় এবং যতটা সম্ভব আপনার জায়গা ধরে রাখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beim Sichern wird das Buch aktualisiert und behält deine Stelle so genau wie möglich bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you save, the book updates and keeps your place as near as it can."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Al guardar, el libro se actualiza y conserva tu lugar lo mejor que puede."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هنگام ذخیره، کتاب به‌روز می‌شود و جای شما را تا حد ممکن نگه می‌دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "À l’enregistrement, le livre se met à jour et conserve votre position au plus près."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בעת השמירה, הספר מתעדכן ושומר על מקומך עד כמה שאפשר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सहेजने पर पुस्तक अपडेट हो जाती है और आपकी जगह को यथासंभव पास ही रखती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saat Anda menyimpan, buku diperbarui dan mempertahankan posisi Anda sebisa mungkin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quando salvi, il libro si aggiorna e mantiene la tua posizione il più vicino possibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "保存すると、ブックが更新され、できるだけ近い位置が維持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "저장하면 책이 업데이트되고 가능한 한 현재 위치를 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bij het bewaren wordt het boek bijgewerkt en blijft je plek zo goed mogelijk behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Po zachowaniu książka się aktualizuje i zachowuje miejsce odczytu tak dokładnie, jak to możliwe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ao salvar, o livro é atualizado e mantém sua posição o mais perto possível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "При сохранении книга обновляется и по возможности сохраняет вашу позицию чтения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "När du sparar uppdateras boken och din plats behålls så nära som möjligt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เมื่อคุณบันทึก หนังสือจะอัปเดตและคงตำแหน่งของคุณไว้ใกล้เคียงที่สุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kaydettiğinizde kitap güncellenir ve yerinizi olabildiğince korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Коли ви збережете, книга оновиться, і ваше місце збережеться якомога точніше."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "محفوظ کرنے پر کتاب اپ ڈیٹ ہو جاتی ہے اور آپ کی جگہ جہاں تک ممکن ہو برقرار رکھتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Khi bạn lưu, sách được cập nhật và giữ vị trí của bạn gần nhất có thể."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "存储时，图书会更新，并尽量保持你的阅读位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "儲存時，書籍會更新，並盡可能保留你的位置。"
          }
        }
      }
    },
    "bookTextEdit.explanationTitle" : {
