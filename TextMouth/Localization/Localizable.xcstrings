        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "हो सकता है कि वह रुका हो, साइन आउट हो, या चल नहीं रहा हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mungkin dijeda, sudah keluar dari akun, atau tidak berjalan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Potrebbe essere in pausa, non aver effettuato l’accesso o non essere in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "一時停止中、サインアウト中、または実行されていない可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "일시 정지되었거나, 로그아웃되었거나, 실행 중이 아닐 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hij is misschien gepauzeerd, afgemeld of draait niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usługa może być wstrzymana lub nie działać albo logowanie mogło wygasnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
