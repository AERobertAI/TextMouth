      }
    },
    "convertedOriginal.keepingCaption" : {
      "comment" : "Caption under the Keep Originals switch while it is on. \"Original file\" names the choice Export offers; keep it the same as that choice's translation.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحتفظ TextMouth بالملف الأصلي للصوت الذي يحوّله عند الاستيراد. يشغل الأصل مساحة قرصية تقارب مساحة ملفه المحوَّل، أو ضعفها عندما لا يكون مضغوطًا. يعرضه التصدير بوصفه الملف الأصلي. لا يُحتفظ بأصل حلقة الموجز: يمكن تنزيله مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth আমদানির সময় যে অডিও রূপান্তর করে তার মূল ফাইল রাখে। একটি মূল ফাইল রূপান্তরিত ফাইলের প্রায় সমান ডিস্ক জায়গা নেয়, বা সংকোচন না করা হলে দ্বিগুণ। রপ্তানি এটিকে মূল ফাইল হিসেবে দেয়। ফিডের পর্বের মূল ফাইল রাখা হয় না: তা আবার ডাউনলোড করা যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth behält die Originaldatei von Audio, das es beim Import umwandelt. Ein Original braucht ungefähr so viel Speicherplatz wie seine umgewandelte Datei, unkomprimiert doppelt so viel. Der Export bietet es als „Originaldatei“ an. Das Original einer Feed-Folge wird nicht behalten: Sie lässt sich erneut herunterladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth keeps the original file of audio it converts at import. An original takes about as much disk space as its converted file, or twice as much when uncompressed. Export offers it as the Original file. A feed episode's original is not kept: it can be downloaded again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth conserva el archivo original del audio que convierte al importar. Un original ocupa casi tanto espacio en disco como su archivo convertido, o el doble si no está comprimido. Exportar lo ofrece como Archivo original. El original de un episodio de un canal no se conserva: se puede descargar de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth فایل اصلی صدایی را که هنگام وارد کردن تبدیل می‌کند نگه می‌دارد. هر نسخه‌ی اصلی تقریباً به اندازه فایل تبدیل‌شده‌اش فضای دیسک می‌گیرد، یا دو برابر آن اگر فشرده نباشد. هنگام صادر کردن، به‌صورت گزینه‌ی «فایل اصلی» عرضه می‌شود. نسخه‌ی اصلی قسمت فید نگه داشته نمی‌شود: می‌توان آن را دوباره بارگیری کرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth conserve le fichier d’origine de l’audio qu’il convertit à l’importation. Un original occupe à peu près autant d’espace disque que son fichier converti, ou deux fois plus s’il n’est pas compressé. L’exportation le propose comme Fichier d’origine. L’original d’un épisode de flux n’est pas conservé : il peut être téléchargé de nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth שומר את קובץ המקור של שמע שהוא ממיר בעת הייבוא. קובץ מקור תופס בערך אותו מקום בדיסק כמו הקובץ המומר שלו, או פי שניים כשהוא לא מכווץ. הייצוא מציע אותו כקובץ מקור. קובץ המקור של אפיזודה מערוץ אינו נשמר: אפשר להוריד אותו שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth जिस ऑडियो को आयात के समय बदलता है, उसकी मूल फ़ाइल रखता है। मूल फ़ाइल लगभग उतनी ही डिस्क जगह लेती है जितनी बदली गई फ़ाइल, या असंपीड़ित होने पर दोगुनी। निर्यात उसे “मूल फ़ाइल” के रूप में देता है। फ़ीड एपिसोड का मूल नहीं रखा जाता: उसे फिर से डाउनलोड किया जा सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth menyimpan file asli audio yang dikonversinya saat impor. File asli memakai ruang disk sebesar file hasil konversinya, atau dua kali lipat bila tidak dikompresi. Ekspor menawarkannya sebagai File asli. File asli episode feed tidak disimpan: episode itu dapat diunduh lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth conserva il file originale dell’audio che converte all’importazione. Un originale occupa circa lo stesso spazio su disco del file convertito, o il doppio se non compresso. L’esportazione lo offre come File originale. L’originale di un episodio di feed non viene conservato: può essere scaricato di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は、読み込み時に変換したオーディオの元のファイルを保持します。元のファイルは、変換後のファイルとほぼ同じ容量を使い、非圧縮の場合は2倍の容量を使います。書き出しでは「元のファイル」として選べます。フィードのエピソードの元のファイルは保持されません。もう一度ダウンロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth는 가져올 때 변환하는 오디오의 원본 파일을 보관합니다. 원본은 변환된 파일과 비슷한 디스크 공간을 차지하며, 압축되지 않은 경우 두 배를 차지합니다. 내보내기에서 원본 파일로 제공됩니다. 피드 에피소드의 원본은 다시 다운로드할 수 있으므로 보관하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth bewaart het originele bestand van audio die het bij het importeren converteert. Een origineel neemt ongeveer evenveel schijfruimte in beslag als het geconverteerde bestand, of twee keer zoveel als het niet is gecomprimeerd. Bij exporteren wordt het aangeboden als Origineel bestand. Het origineel van een feedaflevering wordt niet bewaard: de aflevering kan opnieuw worden gedownload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth zachowuje oryginalny plik dźwięku konwertowanego przy imporcie. Oryginał zajmuje mniej więcej tyle miejsca na dysku co przekonwertowany plik, a gdy jest nieskompresowany, dwa razy tyle. Eksport oferuje go jako „Oryginalny plik”. Oryginał odcinka z kanału nie jest zachowywany: można go pobrać ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth mantém o arquivo original do áudio que converte na importação. Um original ocupa aproximadamente o mesmo espaço em disco que o arquivo convertido, ou o dobro quando não é compactado. A exportação o oferece como Arquivo original. O original de um episódio de feed não é mantido: ele pode ser baixado novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth хранит исходный файл звука, который преобразует при импорте. Оригинал занимает примерно столько же места на диске, сколько преобразованный файл, а без сжатия — вдвое больше. Экспорт предлагает его как «Исходный файл». Оригинал выпуска ленты не хранится: его можно загрузить снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth behåller originalfilen av ljud som konverteras vid import. Ett original tar ungefär lika mycket diskutrymme som den konverterade filen, eller dubbelt så mycket när det är okomprimerat. Export erbjuder det som Originalfilen. Ett flödesavsnitts original behålls inte: det kan hämtas igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth เก็บไฟล์ต้นฉบับของเสียงที่แปลงตอนนำเข้า ไฟล์ต้นฉบับใช้พื้นที่ดิสก์ประมาณเท่าไฟล์ที่แปลงแล้ว หรือสองเท่าหากไม่บีบอัด การส่งออกมีให้เลือกเป็นไฟล์ต้นฉบับ ไฟล์ต้นฉบับของตอนในฟีดจะไม่ถูกเก็บ: ดาวน์โหลดอีกครั้งได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth, içe aktarırken dönüştürdüğü sesin orijinal dosyasını saklar. Bir orijinal dosya, dönüştürülmüş dosyasıyla yaklaşık aynı disk alanını kaplar; sıkıştırılmamışsa iki katı kadar. Dışa aktarma bunu Orijinal dosya olarak sunar. Beslemedeki bir podcast bölümünün orijinali saklanmaz: yeniden indirilebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth зберігає оригінальний файл аудіо, яке перетворює під час імпорту. Оригінал займає приблизно стільки ж місця на диску, що й перетворений файл, або вдвічі більше, якщо він без стиснення. Експорт пропонує його як «Оригінальний файл». Оригінал епізоду зі стрічки не зберігається: його можна завантажити знову."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth درآمد کے وقت تبدیل کی جانے والی آڈیو کی اصل فائل رکھتا ہے۔ ایک اصل فائل تقریباً اتنی ہی ڈسک جگہ لیتی ہے جتنی اس کی تبدیل شدہ فائل، یا غیر کمپریسڈ ہو تو دگنی۔ برآمد اسے اصل فائل کے طور پر پیش کرتی ہے۔ فیڈ کے ایپی سوڈ کی اصل فائل نہیں رکھی جاتی: اسے دوبارہ ڈاؤن لوڈ کیا جا سکتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth giữ tệp gốc của âm thanh mà nó chuyển đổi khi nhập. Bản gốc chiếm dung lượng đĩa gần bằng tệp đã chuyển đổi, hoặc gấp đôi nếu chưa nén. Lệnh Xuất cung cấp bản gốc dưới tên Tệp gốc. Bản gốc của một tập từ nguồn cấp không được giữ: có thể tải về lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 会保留导入时转换的音频的原始文件。原始文件占用的磁盘空间与转换后的文件大致相同，未压缩时则为两倍。导出时，它会作为“原始文件”选项提供。订阅源单集的原始文件不会保留：可以再次下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 會保留輸入時轉換之音訊的原始檔案。原始檔案占用的磁碟空間與其轉換後的檔案差不多，未壓縮時則為兩倍。輸出時可選擇「原始檔案」。訂閱源單集的原始檔案不會保留：可以再次下載。"
          }
        }
      }
    },
