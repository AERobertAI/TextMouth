            "value" : "Buku Kindle ini dikompresi dengan cara yang belum dapat dibaca TextMouth."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo libro Kindle è compresso in un modo che TextMouth non sa ancora leggere."
