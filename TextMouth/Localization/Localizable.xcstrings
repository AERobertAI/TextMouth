    "Paste or type the text here instead, or try again." : {
      "comment" : "Second sentence of the announcement when Open in Editor failed: what to do instead.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "الصق النص أو اكتبه هنا بدلًا من ذلك، أو حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Füge den Text stattdessen hier ein oder tippe ihn, oder versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pega o escribe aquí el texto, o inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Collez ou saisissez plutôt le texte ici, ou réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसके बजाय यहाँ टेक्स्ट पेस्ट करें या टाइप करें, या फिर से प्रयास करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tempel atau ketik teks di sini, atau coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Incolla o digita qui il testo, oppure riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ここにテキストをペーストまたは入力するか、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "여기에 텍스트를 붙여넣거나 입력하거나 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cole ou digite o texto aqui, ou tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вставьте или введите текст здесь либо повторите попытку."
