        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le texte de %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo di %@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O texto de %@"
          }
        }
      }
    },
    "The text of %@ can't be read, so it can't be edited." : {
      "comment" : "Message when Edit Text finds the book's text file unreadable. %@ is the book's title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se puede leer el texto de %@, así que no se puede editar."
