    "Plus %lld more books, all named in the debug log at %@." : {
      "comment" : "Last line of the alert about books that could not move into the current library format: how many more books there are than the alert names, and where the log names them. %1$lld is how many more; %2$@ is the path of the debug log file.",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "إضافة إلى %lld كتب أخرى، مذكورة كلها في سجل تصحيح الأخطاء في %@."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "إضافة إلى %lld كتابًا آخر، مذكورة كلها في سجل تصحيح الأخطاء في %@."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "إضافة إلى %lld كتاب آخر، مذكورة كلها في سجل تصحيح الأخطاء في %@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "إضافة إلى %lld كتاب آخر، مذكورة كلها في سجل تصحيح الأخطاء في %@."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "إضافة إلى %lld كتابين آخرين، مذكورة كلها في سجل تصحيح الأخطاء في %@."
                }
              },
              "zero" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "إضافة إلى %lld كتاب آخر، مذكورة كلها في سجل تصحيح الأخطاء في %@."
                }
              }
            }
          }
        },
        "bn" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "আরও %lldটি বই, যার সবগুলোর নাম %@-এর ডিবাগ লগে আছে।"
