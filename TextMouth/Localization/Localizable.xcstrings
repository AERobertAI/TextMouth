    "audioEditor.policyChanged.keep" : {
      "comment" : "Said as a book's original audio policy is set to keep the original until the book is removed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحتفظ هذا الكتاب بصوته الأصلي حتى تتم إزالة الكتاب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বইটি সরানো পর্যন্ত এই বই তার মূল অডিও রাখে।"
          }
        },
        "de" : {
          "stringUnit" : {
