    "feed.unsubscribed.articles" : {
      "comment" : "What VoiceOver says once Unsubscribe is done, for a feed of articles. The first %@ is the feed's title; the second is a clause about the downloads that stay, which may be empty.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تم إلغاء الاشتراك في %1$@: لم يعد TextMouth يفحص المقالات الجديدة فيه%2$@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@-এর সাবস্ক্রিপশন বাতিল করা হয়েছে: TextMouth আর নতুন নিবন্ধের জন্য এটি চেক করে না%2$@।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ abbestellt: TextMouth prüft ihn nicht mehr auf neue Artikel%2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unsubscribed from %@: TextMouth no longer checks it for new articles%@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se canceló la suscripción a %1$@: TextMouth ya no lo revisa en busca de artículos nuevos%2$@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اشتراک %1$@ لغو شد: TextMouth دیگر آن را برای مقاله‌های جدید بررسی نمی‌کند%2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Désabonné de %1$@ : TextMouth n’y recherche plus de nouveaux articles%2$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ביטלת את ההרשמה ל-%1$@: TextMouth כבר אינו בודק אם יש בו כתבות חדשות%2$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ की सदस्यता रद्द की गई: TextMouth अब उसमें नए लेख नहीं जाँचता%2$@।"
