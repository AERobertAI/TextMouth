    "audioEditError.mp3NeedsFFmpeg" : {
      "comment" : "Said when MP3 is asked for and neither TextMouth's built-in encoder nor an installed ffmpeg program can write it. \"Storage settings\" is the name of a settings tab.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّرت كتابة MP3: تعذّر بدء مشفّر TextMouth، كما أن ffmpeg مفقود أو معطّل في إعدادات التخزين."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "MP3 লেখা যায় না: TextMouth-এর এনকোডার চালু হয়নি, এবং স্টোরেজ সেটিংসে ffmpeg নেই বা বন্ধ আছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
