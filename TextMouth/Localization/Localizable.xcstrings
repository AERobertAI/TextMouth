    },
    "Its place, bookmarks, and transcript, if it has any, are kept, and it can be downloaded again." : {
      "comment" : "Sentence about one deleted download: what the listener left in it is kept, and it can be downloaded again.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يُحتفظ بموضعه وإشاراته المرجعية ونسخته النصية، إن وُجدت، ويمكن تنزيله مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Seine Position, Lesezeichen und sein Transkript, falls vorhanden, bleiben erhalten, und es kann erneut heruntergeladen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Su lugar, sus marcadores y su transcripción, si la tiene, se conservan, y se puede descargar de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sa position, ses signets et sa transcription, s’il en a, sont conservés, et il peut être téléchargé de nouveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसका स्थान, बुकमार्क और ट्रांसक्रिप्ट, यदि है, रखे जाते हैं, और इसे फिर से डाउनलोड किया जा सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Posisi, markah, dan transkripnya, jika ada, tetap disimpan, dan dapat diunduh lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La sua posizione, i segnalibri e la trascrizione, se ne ha una, vengono conservati e può essere scaricato di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "場所、ブックマーク、文字起こしがある場合はそれらも残り、もう一度ダウンロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "위치, 북마크, 대본이 있으면 그대로 유지되며, 다시 다운로드할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sua posição, seus marcadores e sua transcrição, se tiver, são mantidos, e ele pode ser baixado novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Позиция чтения, закладки и расшифровка, если она есть, сохраняются, и книгу можно загрузить снова."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Його місце, закладки та транскрипція, якщо вони є, зберігаються, і його можна завантажити знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "它的位置、书签以及文字稿（如果有）都会保留，并且可以再次下载。"
          }
        }
      }
    },
    "Its reading index could not be saved, so TextMouth will build it again later." : {
      "comment" : "First sentence of a warning about a book that moved into the current library format: its reading index will be built again later.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّر حفظ فهرس القراءة الخاص به، لذا سيبنيه TextMouth مرة أخرى لاحقًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এর পড়ার সূচক সংরক্ষণ করা যায়নি, তাই TextMouth পরে আবার তৈরি করবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sein Leseindex konnte nicht gesichert werden, daher baut TextMouth ihn später neu auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo guardar su índice de lectura, así que TextMouth lo creará de nuevo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Son index de lecture n’a pas pu être enregistré, donc TextMouth le reconstruira plus tard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसका पठन इंडेक्स सहेजा नहीं जा सका, इसलिए TextMouth उसे बाद में फिर से बनाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Indeks bacanya tidak dapat disimpan, jadi TextMouth akan membuatnya lagi nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non è stato possibile salvare il suo indice di lettura, quindi TextMouth lo ricostruirà più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "読書用インデックスを保存できなかったため、TextMouth はあとでもう一度作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "읽기 색인을 저장할 수 없어서 TextMouth가 나중에 다시 만듭니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O índice de leitura dele não pôde ser salvo, então o TextMouth vai criá-lo de novo mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не удалось сохранить её индекс чтения, поэтому TextMouth построит его позже."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Її індекс читання не вдалося зберегти, тому TextMouth побудує його знову пізніше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "其阅读索引无法存储，因此 TextMouth 稍后会重新建立。"
          }
        }
      }
    },
    "Its text could not be prepared for reading yet; TextMouth will try again later." : {
      "comment" : "Warning about a book that moved into the current library format: its text will be prepared later.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تعذّر تجهيز نصه للقراءة حتى الآن؛ سيحاول TextMouth مرة أخرى لاحقًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এর টেক্সট এখনো পড়ার জন্য প্রস্তুত করা যায়নি; TextMouth পরে আবার চেষ্টা করবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sein Text konnte noch nicht zum Lesen vorbereitet werden; TextMouth versucht es später erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aún no se pudo preparar su texto para la lectura; TextMouth intentará de nuevo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Son texte n’a pas encore pu être préparé pour la lecture ; TextMouth réessaiera plus tard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसका टेक्स्ट अभी पढ़ने के लिए तैयार नहीं किया जा सका; TextMouth बाद में फिर प्रयास करेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Teksnya belum dapat disiapkan untuk dibaca; TextMouth akan mencoba lagi nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
