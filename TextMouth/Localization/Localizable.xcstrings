    },
    "Pattern error: %@" : {
      "comment" : "VoiceOver label of the message that says a substitution rule's pattern is not a valid regular expression. %@ is the message."
    },
    "Pattern: %@" : {
      "comment" : "A part of a substitution rule's spoken summary. %@ is the rule's pattern."
    },
    "Pause" : {
      "comment" : "Label of the button that pauses the book while it is playing.\nLabel of the reader's play and pause button while the book plays; it pauses.\nName of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Pause\".\nTitle of the button in the Record window that pauses the recording."
    },
    "Pause level" : {
      "comment" : "Title of the punctuation pause level slider in the Playback settings."
    },
    "Pause or Resume" : {
      "comment" : "Name of a keyboard shortcut action, listed in Settings in the Record window group and read by VoiceOver. Pauses the recording, or resumes a paused one."
    },
    "Pause playback after:" : {
      "comment" : "Note under the sleep timer sheet's New Timer heading while no timer runs; the minute presets follow it, such as 10 minutes.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pausar la reproducción después de:"
          }
        }
      }
    },
    "Paused %lld books that were playing." : {
      "comment" : "Said by the Record window when starting or resuming a recording paused books that were playing, so the microphone would not pick them up. %lld is the number of books paused. The one form has no number: \"Paused the book that was playing.\"",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Paused the book that was playing."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Paused %lld books that were playing."
                }
              }
            }
          }
        }
      }
    },
    "Paused." : {
      "comment" : "Status line and announcement of the Record window once the recording is paused."
    },
    "Pauses the recording; %@ continues the same recording." : {
      "comment" : "VoiceOver hint of the Pause button in the Record window. %@ is the title of the button that continues a paused recording."
    },
    "Percent Sign" : {
      "comment" : "Name of the punctuation key \"%\", spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Percent Sign\"."
    },
    "Percent must be between 0 and 100." : {
      "comment" : "Message when the number typed in Go to Percent is below 0 or above 100."
    },
    "Percent through the book" : {
      "comment" : "Label of the Go to Percent field, where the user types how far through the book to jump."
    },
    "Percentage" : {
      "comment" : "A segment of the display picker in Search in Book: each result's position is shown as a percentage of the book.\nChoice of the headings sheet's display picker: each heading shows how far through the book it begins, as a percent."
