    "libraryComparison.buttonHint" : {
      "comment" : "VoiceOver hint of the Compare Libraries button in Storage settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يختار مجلدًا يحتوي على نسخة أخرى من هذه المكتبة ويسرد الفروق. لا تتغير أي من النسختين."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই লাইব্রেরির আরেকটি কপি থাকা একটি ফোল্ডার বেছে নেয় এবং কী আলাদা তা তালিকাভুক্ত করে। কোনো কপিই পরিবর্তিত হয় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wählt einen Ordner mit einer weiteren Kopie dieser Bibliothek und listet die Unterschiede auf. Keine der Kopien wird geändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chooses a folder with another copy of this library and lists what differs. Neither copy changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige una carpeta con otra copia de esta biblioteca y muestra qué difiere. Ninguna copia cambia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پوشه‌ای با نسخه‌ی دیگری از این کتابخانه را انتخاب می‌کند و تفاوت‌ها را فهرست می‌کند. هیچ‌یک از دو نسخه تغییر نمی‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisit un dossier contenant une autre copie de cette bibliothèque et liste les différences. Aucune des copies ne change."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בוחר תיקייה עם עותק אחר של הספרייה הזו ומציג מה שונה. אף אחד מהעותקים לא משתנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "दूसरी कॉपी वाला फ़ोल्डर चुनता है और अंतर सूचीबद्ध करता है। कोई भी कॉपी नहीं बदलती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Memilih folder berisi salinan lain pustaka ini dan mencantumkan perbedaannya. Kedua salinan tidak berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sceglie una cartella con un’altra copia di questa libreria ed elenca le differenze. Nessuna delle due copie cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このライブラリの別のコピーが入っているフォルダを選択し、相違点を一覧表示します。どちらのコピーも変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 보관함의 다른 사본이 있는 폴더를 선택하고 차이점을 나열합니다. 어느 사본도 변경되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kiest een map met een andere kopie van deze bibliotheek en toont wat verschilt. Geen van beide kopieën verandert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wybiera folder z inną kopią tej biblioteki i wyświetla różnice. Żadna kopia nie zostanie zmieniona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escolhe uma pasta com outra cópia desta biblioteca e lista o que difere. Nenhuma das cópias muda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Позволяет выбрать папку с другой копией этой библиотеки и показывает различия. Ни одна копия не изменяется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Väljer en mapp med en annan kopia av det här biblioteket och listar vad som skiljer sig. Ingen av kopiorna ändras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เลือกโฟลเดอร์ที่มีสำเนาอื่นของไลบรารีนี้ และแสดงรายการที่ต่างกัน ไม่มีสำเนาใดเปลี่ยนแปลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu kitaplığın başka bir kopyasını içeren bir klasör seçer ve farklı olanları listeler. Hiçbir kopya değişmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вибирає папку з іншою копією цієї бібліотеки та показує відмінності. Жодна з копій не змінюється."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس لائبریری کی دوسری کاپی والا فولڈر منتخب کرتا ہے اور جو مختلف ہے اس کی فہرست دیتا ہے۔ کوئی کاپی تبدیل نہیں ہوتی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chọn thư mục có bản sao khác của thư viện này và liệt kê điểm khác biệt. Cả hai bản đều không thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "选取存放此资料库另一个副本的文件夹，并列出差异。两个副本都不会更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選擇存放這個書庫另一份副本的檔案夾，並列出差異。兩份副本都不會更改。"
          }
        }
      }
    },
