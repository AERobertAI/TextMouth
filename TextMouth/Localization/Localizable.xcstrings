    },
    "Previous sentence" : {
      "comment" : "Announcement after the reader moved to the previous sentence."
    },
    "Print" : {
      "comment" : "Name of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Print\"."
    },
    "Print Screen" : {
      "comment" : "Name of a key of the keyboard, spoken by VoiceOver and shown in braille in a keyboard shortcut such as \"Command + Print Screen\"."
    },
    "Publication Date" : {
      "comment" : "Name of the book information sheet's field for a book's publication date."
