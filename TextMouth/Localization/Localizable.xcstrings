    "recording.closeWithUnsavedExplanation" : {
      "comment" : "Explanation under the question asked when the Record window is closed with a recording that could not be saved. %1$@, %2$@, and %3$@ are the titles of the question's three buttons: the one that saves, the one that deletes the recording, and the one that keeps the window open.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هذا التسجيل غير محفوظ. %1$@ يحاول مرة أخرى، و%2$@ يحذفه، و%3$@ يُبقي النافذة مفتوحة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই রেকর্ডিং সংরক্ষিত হয়নি। %1$@ বেছে নিলে আবার চেষ্টা করা হয়, %2$@ বেছে নিলে এটি মুছে যায়, আর %3$@ বেছে নিলে উইন্ডো খোলা থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Diese Aufnahme ist nicht gesichert. „%1$@“ versucht es erneut, „%2$@“ löscht sie, und „%3$@“ lässt das Fenster geöffnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This recording isn't saved. %@ tries again, %@ deletes it, and %@ keeps the window open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta grabación no está guardada. %1$@ lo intenta de nuevo, %2$@ la elimina y %3$@ mantiene abierta la ventana."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "این ضبط ذخیره نشده است. %1$@ دوباره تلاش می‌کند، %2$@ آن را حذف می‌کند و %3$@ پنجره را باز نگه می‌دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cet enregistrement n’est pas sauvegardé. %1$@ réessaie, %2$@ le supprime, et %3$@ garde la fenêtre ouverte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ההקלטה הזו לא נשמרה. “%1$@” מנסה שוב, “%2$@” מוחק אותה, ו“%3$@” משאיר את החלון פתוח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "यह रिकॉर्डिंग सहेजी नहीं गई है। “%1$@” फिर से प्रयास करता है, “%2$@” इसे मिटा देता है, और “%3$@” विंडो को खुला रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rekaman ini belum tersimpan. %1$@ mencoba lagi, %2$@ menghapusnya, dan %3$@ membiarkan jendela tetap terbuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questa registrazione non è salvata. Scegli %1$@ per riprovare, %2$@ per eliminarla o %3$@ per lasciare aperta la finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "この録音は保存されていません。「%1$@」で再試行し、「%2$@」で削除し、「%3$@」でウインドウを開いたままにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 녹음은 저장되지 않았습니다. %1$@: 다시 시도, %2$@: 삭제, %3$@: 윈도우 유지."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deze opname is niet bewaard. %1$@ probeert het opnieuw, %2$@ verwijdert de opname en %3$@ houdt het venster open."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "To nagranie nie zostało zachowane. %1$@ ponawia próbę, %2$@ je usuwa, a %3$@ pozostawia okno otwarte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta gravação não foi salva. %1$@ tenta novamente, %2$@ a exclui e %3$@ mantém a janela aberta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Эта запись не сохранена. Кнопка «%1$@» повторяет попытку, «%2$@» удаляет запись, а «%3$@» оставляет окно открытым."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Den här inspelningen är inte sparad. %1$@ försöker igen, %2$@ raderar den och %3$@ håller fönstret öppet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ยังไม่ได้บันทึกการบันทึกเสียงนี้ เลือก %1$@ เพื่อลองอีกครั้ง %2$@ เพื่อลบการบันทึก หรือ %3$@ เพื่อเปิดหน้าต่างไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu kayıt kaydedilmedi. %1$@ tekrar dener, %2$@ siler, %3$@ ise pencereyi açık tutar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Цей запис не збережено. «%1$@» повторює спробу, «%2$@» видаляє його, а «%3$@» залишає вікно відкритим."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یہ ریکارڈنگ محفوظ نہیں۔ %1$@ دوبارہ کوشش کرتا ہے، %2$@ اسے حذف کرتا ہے، اور %3$@ ونڈو کھلی رکھتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bản ghi âm này chưa được lưu. %1$@ thử lại, %2$@ xóa bản ghi, và %3$@ giữ cửa sổ mở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此录音尚未存储。“%1$@”会重试，“%2$@”会将其删除，“%3$@”会保持窗口打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "這段錄音尚未儲存。「%1$@」會再試一次，「%2$@」會將它刪除，「%3$@」則會讓視窗保持打開。"
          }
        }
      }
    },
