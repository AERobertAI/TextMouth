          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "В ней запись книги «%1$@»: %2$@; в самой записи: %3$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Містить запис про «%1$@»: %2$@; у записі: %3$@."
