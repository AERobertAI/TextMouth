    "feedFolderNaming.parentMissingMessage" : {
      "comment" : "Why Subscribe could not make the feed's folder: the folder chosen to hold it was removed from the library.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يعد المجلد المختار لاحتواء مجلد الموجز في المكتبة. اختر مجلدًا آخر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ফিডের ফোল্ডার রাখার জন্য বেছে নেওয়া ফোল্ডার আর লাইব্রেরিতে নেই। অন্য একটি বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Ordner, der den Ordner des Feeds aufnehmen sollte, ist nicht mehr in der Bibliothek. Wähle einen anderen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The folder chosen to hold the feed's folder is no longer in the library. Choose another one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La carpeta elegida para contener la carpeta del canal ya no está en la biblioteca. Elige otra."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پوشه‌ای که برای نگه‌داری پوشه‌ی فید انتخاب شده بود دیگر در کتابخانه نیست. پوشه دیگری انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le dossier choisi pour contenir le dossier du flux n’est plus dans la bibliothèque. Choisissez-en un autre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "התיקייה שנבחרה להכיל את תיקיית הערוץ כבר אינה בספרייה. בחר תיקייה אחרת."
