        }
      }
    },
    "How a BRF or BRL file writes each braille cell. Most files use North American Braille ASCII." : {
      "comment" : "The hint of the braille file characters pop-up in the Braille tab of Settings. BRF and BRL are braille file formats, and North American Braille ASCII is the name of a braille character code.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wie eine BRF- oder BRL-Datei jede Braillezelle schreibt. Die meisten Dateien verwenden North American Braille ASCII."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cómo escribe un archivo BRF o BRL cada celda braille. La mayoría de los archivos usa North American Braille ASCII."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Comment un fichier BRF ou BRL écrit chaque cellule braille. La plupart des fichiers utilisent le braille ASCII nord-américain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Come un file BRF o BRL scrive ogni cella braille. La maggior parte dei file usa North American Braille ASCII."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Como um arquivo BRF ou BRL grava cada célula braille. A maioria dos arquivos usa North American Braille ASCII."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Как файл BRF или BRL записывает каждую ячейку Брайля. Большинство файлов используют North American Braille ASCII."
          }
        }
      }
    },
    "How fast the voice speaks in the file. It starts at the book's speed." : {
      "comment" : "The hint of the Speed slider in the Export dialog's spoken audio options.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wie schnell die Stimme in der Datei spricht. Sie beginnt mit der Geschwindigkeit des Buchs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con qué rapidez habla la voz en el archivo. Empieza con la velocidad del libro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vitesse de la voix dans le fichier. Elle part de la vitesse du livre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quanto veloce parla la voce nel file. Parte dalla velocità del libro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A rapidez com que a voz fala no arquivo. Começa na velocidade do livro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Как быстро голос говорит в файле. Начальное значение — скорость книги."
          }
        }
      }
    },
    "How high the voice sounds in the file. It starts at the book's pitch." : {
      "comment" : "The hint of the Pitch slider in the Export dialog's spoken audio options.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wie hoch die Stimme in der Datei klingt. Sie beginnt mit der Tonhöhe des Buchs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Qué tan aguda suena la voz en el archivo. Empieza con el tono del libro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hauteur de la voix dans le fichier. Elle part de la hauteur du livre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quanto acuta suona la voce nel file. Parte dal tono del libro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quão aguda a voz soa no arquivo. Começa no tom do livro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Насколько высоким звучит голос в файле. Начальное значение — высота тона книги."
          }
        }
      }
    },
    "How long media commands are blocked after a Bluetooth device disconnects. Raise it if playback resumes after removing headphones." : {
      "comment" : "Explanation under the Bluetooth disconnect delay slider in the Miscellaneous settings.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wie lange Medienbefehle blockiert werden, nachdem ein Bluetooth-Gerät getrennt wurde. Erhöhe den Wert, wenn die Wiedergabe nach dem Abnehmen der Kopfhörer fortgesetzt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cuánto tiempo se bloquean las órdenes multimedia después de que se desconecta un dispositivo Bluetooth. Auméntalo si la reproducción se reanuda al quitarte los audífonos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Durée pendant laquelle les commandes multimédias sont bloquées après la déconnexion d’un appareil Bluetooth. Augmentez-la si la lecture reprend après le retrait des écouteurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Per quanto tempo i comandi multimediali restano bloccati dopo la disconnessione di un dispositivo Bluetooth. Aumentalo se la riproduzione riprende dopo aver tolto le cuffie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Por quanto tempo os comandos de mídia ficam bloqueados depois que um dispositivo Bluetooth se desconecta. Aumente se a reprodução continuar ao remover os fones."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Как долго медиакоманды блокируются после отключения устройства Bluetooth. Увеличьте значение, если воспроизведение возобновляется после снятия наушников."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Як довго медіакоманди блокуються після відключення пристрою Bluetooth. Збільшіть значення, якщо відтворення поновлюється після зняття навушників."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "断开 Bluetooth 设备后阻止媒体命令的时长。如果移除耳机后仍会恢复播放，请调大此值。"
          }
        }
      }
    },
