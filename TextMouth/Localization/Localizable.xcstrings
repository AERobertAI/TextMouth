            "value" : "TextMouth'un hazır ayarlarını geri getirir, eklediklerinizi kaldırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Повертає готові пресети TextMouth, вилучаючи додані вами."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth کے پہلے سے بنے پری سیٹس واپس لاتا ہے، اور آپ کے شامل کردہ ہٹا دیتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Khôi phục các giá trị đặt sẵn mặc định của TextMouth, gỡ những giá trị bạn đã thêm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "恢复 TextMouth 自带的预设，并移除你添加的预设。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "恢復 TextMouth 內建的預設組合，並移除你加入的組合。"
          }
        }
      }
    },
