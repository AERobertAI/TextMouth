    "sync.folderAlreadyThere" : {
      "comment" : "Shown when Set Up Sync finds a folder named TextMouth Sync already there. Join Sync Folder is a button. TextMouth Sync is the folder's name and is not translated.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يوجد بالفعل مجلد باسم TextMouth Sync. لاستخدامه، اختر «الانضمام إلى مجلد المزامنة»."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth Sync নামে একটি ফোল্ডার আগে থেকেই আছে। এটি ব্যবহার করতে “সিঙ্ক ফোল্ডারে যোগ দিন” বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Ordner namens TextMouth Sync ist bereits vorhanden. Um ihn zu verwenden, wähle „Synchronisierungsordner beitreten“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A folder named TextMouth Sync is already there. To use it, choose Join Sync Folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ya hay una carpeta llamada TextMouth Sync. Para usarla, elige Unirse a la carpeta de sincronización."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پوشه‌ای به نام TextMouth Sync از قبل وجود دارد. برای استفاده از آن، «پیوستن به پوشهٔ همگام‌سازی» را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un dossier nommé TextMouth Sync existe déjà. Pour l’utiliser, choisissez Rejoindre le dossier de synchronisation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כבר קיימת תיקייה בשם TextMouth Sync. כדי להשתמש בה, בחר ב-“הצטרף לתיקיית סנכרון”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth Sync नाम का फ़ोल्डर पहले से मौजूद है। इसे उपयोग करने के लिए “सिंक फ़ोल्डर से जुड़ें” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Folder bernama TextMouth Sync sudah ada. Untuk menggunakannya, pilih Gabung ke Folder Sinkronisasi."
          }
        },
        "it" : {
          "stringUnit" : {
