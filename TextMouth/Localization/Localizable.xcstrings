        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Расшифровка изменилась с тех пор, как это было показано. Снова откройте «Исправить расшифровку», чтобы увидеть изменения."
          }
        }
      }
    },
    "The transcript file found beside the new copy's audio replaces the existing copy's transcript." : {
      "comment" : "Part of the question asked about a duplicate audiobook: the transcript file found beside the new copy's audio takes the place of the library copy's transcript.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Transkriptdatei neben dem Audio der neuen Kopie ersetzt das Transkript der vorhandenen Kopie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El archivo de transcripción que se encontró junto al audio de la copia nueva reemplaza la transcripción de la copia existente."
          }
        },
        "fr" : {
          "stringUnit" : {
