    },
    "This Mac can't run the speech model that transcription uses." : {
      "comment" : "Error shown when transcription is tried on a Mac whose hardware cannot run the speech model.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieser Mac kann das Sprachmodell, das die Transkription verwendet, nicht ausführen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta Mac no puede ejecutar el modelo de voz que usa la transcripción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce Mac ne peut pas exécuter le modèle vocal que la transcription utilise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo Mac non può eseguire il modello vocale usato dalla trascrizione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este Mac não consegue executar o modelo de fala usado na transcrição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Этот Mac не может запустить модель распознавания речи, которую использует расшифровка."
          }
        }
      }
    },
    "This Mac doesn't allow TextMouth to use the microphone: a device management profile or Screen Time restricts it." : {
      "comment" : "Error in the Record window when something other than the user, a device management profile or Screen Time, keeps TextMouth from using the microphone.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieser Mac erlaubt TextMouth nicht, das Mikrofon zu verwenden: Ein Geräteverwaltungsprofil oder die Bildschirmzeit schränkt es ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta Mac no permite que TextMouth use el micrófono: un perfil de administración de dispositivos o Tiempo en pantalla lo restringe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce Mac n’autorise pas TextMouth à utiliser le microphone : un profil de gestion des appareils ou Temps d’écran le restreint."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo Mac non consente a TextMouth di usare il microfono: lo limita un profilo di gestione dei dispositivi oppure Tempo di utilizzo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este Mac não permite que o TextMouth use o microfone: um perfil de gerenciamento de dispositivos ou o Tempo de Uso o restringe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Этот Mac не разрешает TextMouth использовать микрофон: доступ ограничивает профиль управления устройством или «Экранное время»."
          }
        }
      }
    },
    "This Mac doesn't know the library's identity, so it can't restore it." : {
      "comment" : "A sentence of why the library can't open: this Mac has no record of the library's identity, so the identity file can't be restored from it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieser Mac kennt die Identität der Bibliothek nicht und kann sie daher nicht wiederherstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta Mac no conoce la identidad de la biblioteca, así que no puede restaurarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce Mac ne connaît pas l’identité de la bibliothèque et ne peut donc pas la restaurer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo Mac non conosce l’identità della libreria, quindi non può ripristinarla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este Mac não conhece a identidade da biblioteca, então não pode restaurá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Этот Mac не знает идентификатор библиотеки, поэтому не может его восстановить."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Цей Mac не знає ідентичності бібліотеки, тому не може її відновити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "这台 Mac 不知道资料库的标识，因此无法恢复它。"
          }
        }
      }
    },
    "This Mac is offline, so %@ can't be refreshed. Connect to the internet and try again." : {
      "comment" : "Why a feed could not be refreshed: this Mac has no internet. %@ is the feed's title or server.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieser Mac ist offline, daher kann %@ nicht aktualisiert werden. Stelle eine Internetverbindung her und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta Mac no tiene conexión, así que no se puede actualizar %@. Conéctate a internet e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce Mac est hors ligne, donc %@ ne peut pas être actualisé. Connectez-vous à Internet et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo Mac è offline, quindi %@ non può essere aggiornato. Connettiti a internet e riprova."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este Mac está off-line, então %@ não pode ser atualizado. Conecte-se à internet e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Этот Mac не в сети, поэтому %@ нельзя обновить. Подключитесь к интернету и повторите попытку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Цей Mac не підключений до інтернету, тому %@ не можна оновити. Підключіться до інтернету й спробуйте знову."
          }
        }
      }
    },
    "This Mac is offline, so the book can't be downloaded from %@." : {
      "comment" : "First sentence of why a book can't be downloaded: the Mac is offline. %@ is the cloud service's name, or \"the cloud service\" when it is unknown.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieser Mac ist offline, daher kann das Buch nicht von %@ heruntergeladen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta Mac no tiene conexión, así que el libro no se puede descargar desde %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce Mac est hors ligne ; le livre ne peut donc pas être téléchargé depuis %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo Mac è offline, quindi il libro non può essere scaricato tramite %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este Mac está offline, então o livro não pode ser baixado de %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Этот Mac не в сети, поэтому книгу нельзя загрузить (%@)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Цей Mac не в мережі, тому книгу не можна завантажити (джерело: %@)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "这台 Mac 处于离线状态，因此无法从 %@ 下载这本图书。"
          }
        }
      }
    },
    "This Mac is offline, so the directory can't be searched. Connect to the internet and try again." : {
      "comment" : "Why a podcast search failed: this Mac has no internet.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieser Mac ist offline, daher kann das Verzeichnis nicht durchsucht werden. Stelle eine Internetverbindung her und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta Mac no tiene conexión, así que no se puede buscar en el directorio. Conéctate a internet e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce Mac est hors ligne, donc l’annuaire ne peut pas être interrogé. Connectez-vous à Internet et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo Mac è offline, quindi non è possibile cercare nella directory. Connettiti a internet e riprova."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este Mac está off-line, então não é possível buscar no diretório. Conecte-se à internet e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Этот Mac не в сети, поэтому в каталоге нельзя искать. Подключитесь к интернету и повторите попытку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Цей Mac не підключений до інтернету, тому здійснити пошук у каталозі неможливо. Підключіться до інтернету й спробуйте знову."
          }
        }
      }
    },
    "This Mac is offline, so “%@” can't be downloaded. Connect to the internet and try again." : {
      "comment" : "Why a feed item's download failed: this Mac has no internet. %@ is the item's title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieser Mac ist offline, daher kann „%@“ nicht heruntergeladen werden. Stelle eine Internetverbindung her und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta Mac no tiene conexión, así que no se puede descargar “%@”. Conéctate a internet e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce Mac est hors ligne, donc « %@ » ne peut pas être téléchargé. Connectez-vous à Internet et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo Mac è offline, quindi “%@” non può essere scaricato. Connettiti a internet e riprova."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este Mac está off-line, então “%@” não pode ser baixado. Conecte-se à internet e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Этот Mac не в сети, поэтому «%@» нельзя загрузить. Подключитесь к интернету и повторите попытку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Цей Mac не підключений до інтернету, тому «%@» не можна завантажити. Підключіться до інтернету й спробуйте знову."
          }
        }
      }
    },
    "This Mac no longer has the chosen table, “%@”; choose another." : {
      "comment" : "Under the pop-ups in the Braille tab of Settings: the chosen braille table of this Mac is gone. %@ is the table's stored name, \"mac:\" and its file name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieser Mac hat die gewählte Tabelle „%@“ nicht mehr; wähle eine andere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta Mac ya no tiene la tabla elegida, «%@»; elige otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce Mac n’a plus la table choisie, « %@ » ; choisissez-en une autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo Mac non ha più la tabella scelta, “%@”; scegline un’altra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este Mac não tem mais a tabela escolhida, “%@”; escolha outra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "На этом Mac больше нет выбранной таблицы «%@»; выберите другую."
          }
        }
      }
    },
    "This Mac's braille table “%@” changed from liblouis %@ to %@ since the book was read, so TextMouth keeps the book's text as it was." : {
      "comment" : "Why a book is not read with its braille table again: the table changed. %1$@ is the table's name as macOS gives it, %2$@ the liblouis version the book was read with, and %3$@ the version now.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Brailletabelle „%1$@“ dieses Mac hat sich seit dem Lesen des Buchs von liblouis %2$@ auf %3$@ geändert, daher behält TextMouth den Text des Buchs, wie er war."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This Mac's braille table “%1$@” changed from liblouis %2$@ to %3$@ since the book was read, so TextMouth keeps the book's text as it was."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La tabla de braille «%1$@» de esta Mac cambió de liblouis %2$@ a %3$@ desde que se leyó el libro, así que TextMouth conserva el texto del libro tal como estaba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La table braille « %1$@ » de ce Mac est passée de liblouis %2$@ à %3$@ depuis la lecture du livre, donc TextMouth garde le texte du livre tel qu’il était."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La tabella braille “%1$@” di questo Mac è cambiata da liblouis %2$@ a %3$@ dopo la lettura del libro, quindi TextMouth conserva il testo del libro com’era."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A tabela braille “%1$@” deste Mac mudou de liblouis %2$@ para %3$@ desde que o livro foi lido, então o TextMouth mantém o texto do livro como estava."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Таблица Брайля этого Mac «%1$@» изменилась с liblouis %2$@ на %3$@ после чтения книги, поэтому TextMouth сохраняет текст книги прежним."
          }
        }
      }
    },
    "This Mac's braille table “%@” may have changed since liblouis %@ read the book, so TextMouth keeps the book's text as it was." : {
      "comment" : "Why a book is not read with its braille table again: the table may have changed. %1$@ is the table's name as macOS gives it and %2$@ the liblouis version the book was read with.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Brailletabelle „%1$@“ dieses Mac hat sich möglicherweise geändert, seit liblouis %2$@ das Buch gelesen hat, daher behält TextMouth den Text des Buchs, wie er war."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This Mac's braille table “%1$@” may have changed since liblouis %2$@ read the book, so TextMouth keeps the book's text as it was."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La tabla de braille «%1$@» de esta Mac puede haber cambiado desde que liblouis %2$@ leyó el libro, así que TextMouth conserva el texto del libro tal como estaba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La table braille « %1$@ » de ce Mac a peut-être changé depuis que liblouis %2$@ a lu le livre, donc TextMouth garde le texte du livre tel qu’il était."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La tabella braille “%1$@” di questo Mac potrebbe essere cambiata dopo che liblouis %2$@ ha letto il libro, quindi TextMouth conserva il testo del libro com’era."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A tabela braille “%1$@” deste Mac pode ter mudado desde que o liblouis %2$@ leu o livro, então o TextMouth mantém o texto do livro como estava."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Таблица Брайля этого Mac «%1$@», возможно, изменилась после того, как liblouis %2$@ прочитал книгу, поэтому TextMouth сохраняет текст книги прежним."
          }
        }
      }
    },
