        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Папка з назвою TextMouth Sync уже існує. Щоб її використати, виберіть «Приєднатися до папки синхронізації»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth Sync نام کا فولڈر پہلے سے موجود ہے۔ اسے استعمال کرنے کے لیے “سنک فولڈر میں شامل ہوں” منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đã có một thư mục tên TextMouth Sync. Để dùng nó, hãy chọn Tham gia thư mục đồng bộ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此处已有名为 TextMouth Sync 的文件夹。要使用它，请选取“加入同步文件夹”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "這裡已有名為 TextMouth Sync 的檔案夾。若要使用，請選擇「加入同步檔案夾」。"
          }
        }
      }
    },
    "sync.iCloudDriveFull" : {
      "comment" : "Shown when Set Up Sync or Join Sync Folder fails because iCloud Drive has no room left.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مساحة iCloud Drive ممتلئة. حرّر بعض المساحة في iCloud Drive ثم حاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive ভরে গেছে। iCloud Drive-এ কিছু জায়গা খালি করে আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive ist voll. Gib in iCloud Drive etwas Speicher frei und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive is full. Free some space in iCloud Drive, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive está lleno. Libera espacio en iCloud Drive y vuelve a intentarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud Drive پر است. کمی فضا در iCloud Drive آزاد کنید و دوباره تلاش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
