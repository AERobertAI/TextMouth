    "Writes chapter markers and markers beside the audio, in an Audacity label file of the same name." : {
      "comment" : "Hint of the Also write the markers as Audacity labels checkbox. Audacity is the name of an audio editing program.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يكتب علامات الفصل والعلامات بجانب الصوت، في ملف تسميات Audacity بالاسم نفسه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Schreibt Kapitelmarken und Marker neben das Audio, in eine Audacity-Label-Datei mit demselben Namen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escribe las marcas de capítulo y las marcas junto al audio, en un archivo de etiquetas de Audacity con el mismo nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Écrit les marqueurs de chapitre et les marqueurs à côté de l’audio, dans un fichier d’étiquettes Audacity du même nom."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "अध्याय मार्कर और मार्कर को ऑडियो के पास उसी नाम की Audacity लेबल फ़ाइल में लिखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menulis penanda bab dan penanda di samping audio, dalam file label Audacity dengan nama yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scrive marcatori di capitolo e marcatori accanto all’audio, in un file di etichette di Audacity con lo stesso nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "チャプタマーカーとマーカーを、オーディオの横に、同じ名前の Audacity ラベルファイルとして書き出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
