        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bản chép lời kéo dài đến %1$@, quá cuối âm thanh tại %2$@, nên nó dành cho âm thanh khác."
          }
        },
        "zh-Hans" : {
