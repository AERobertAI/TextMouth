    "speechService.voiceDidNotStartAnnouncement" : {
      "comment" : "Announcement when the voice did not start a passage, even on fresh synthesizers, so speech paused there. Play is the name of a button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "توقف النطق مؤقتًا: لم يبدأ الصوت. اضغط على “تشغيل” للمحاولة مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "স্পিচ বিরতিতে: ভয়েস শুরু হয়নি। আবার চেষ্টা করতে “চালান” চাপুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sprachausgabe pausiert: Die Stimme hat nicht begonnen. Drücke „Wiedergeben“, um es erneut zu versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speech paused: the voice did not start. Press Play to try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lectura en pausa: la voz no arrancó. Pulsa Reproducir para intentarlo de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "گفتار موقتاً متوقف شد: صدا شروع نشد. برای تلاش دوباره «پخش» را فشار دهید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voix en pause : la voix n’a pas démarré. Appuyez sur Lire pour réessayer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הדיבור הושהה: הקול לא התחיל. לחץ על “נגן” כדי לנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "स्पीच पॉज़ हुई: आवाज़ शुरू नहीं हुई। फिर से प्रयास करने के लिए “चलाएँ” दबाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ucapan dijeda: suara tidak mulai. Tekan Putar untuk mencoba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lettura in pausa: la voce non è partita. Premi Riproduci per riprovare."
          }
