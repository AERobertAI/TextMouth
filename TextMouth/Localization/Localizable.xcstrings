    "speechExport.noHeadings" : {
      "comment" : "Shown in the Export dialog's spoken audio options in place of the From and To pop-ups when the book has no headings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ليس لهذا الكتاب عناوين رئيسية، لذا يُصدَّر كله."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই বইয়ে কোনো হেডিং নেই, তাই পুরোটাই রপ্তানি হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieses Buch hat keine Überschriften, daher wird alles exportiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This book has no headings, so all of it is exported."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este libro no tiene encabezados, así que se exporta completo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "این کتاب سرفصل ندارد، بنابراین همه آن صادر می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce livre n’a pas d’en-têtes, donc il est exporté en entier."
