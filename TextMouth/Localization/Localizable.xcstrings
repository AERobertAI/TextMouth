          }
        }
      }
    },
    "The book is open in a reader. Close it, then save again." : {
      "comment" : "Said when saving the edited audio is refused because a reader has the book open and plays the file the save would replace.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "الكتاب مفتوح في القارئ. أغلقه، ثم احفظ مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Buch ist in einer Leseansicht geöffnet. Schließe sie und sichere dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El libro está abierto en un lector. Ciérralo y guarda de nuevo."
