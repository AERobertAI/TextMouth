          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texte non mis à jour : la transcription modifiée de %@ ajoute des mots à un chapitre sans parole, où ils ne peuvent pas être conservés. Retirez-les et enregistrez à nouveau ; le livre garde son ancien texte d’ici là."
          }
        },
        "he" : {
          "stringUnit" : {
