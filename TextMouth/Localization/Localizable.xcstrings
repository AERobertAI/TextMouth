    "endOfBook.playOnAFinishedBookCaption" : {
      "comment" : "Caption under the When book ends picker in Settings, Playback. %1$@ and %2$@ are the names of two of the picker's choices, as the picker shows them (Stop, and Stop, and Play Starts Over); Play is the reader's Play button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عند اختيار “%1$@”، يُعلن “تشغيل” في كتاب منتهٍ أنه منتهٍ؛ وعند اختيار “%2$@”، يبدؤه من البداية مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” বেছে নেওয়া থাকলে, শেষ হওয়া বইয়ে “চালান” জানায় যে বইটি শেষ হয়েছে; “%2$@” বেছে নেওয়া থাকলে, “চালান” বইটি শুরু থেকে আবার চালায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bei „%1$@“ sagt „Wiedergeben“ bei einem beendeten Buch, dass es beendet ist; bei „%2$@“ startet „Wiedergeben“ es von vorn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With \"%@\", Play on a finished book says it is finished; with \"%@\", Play starts it again from the beginning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con “%1$@”, Reproducir en un libro terminado avisa que ya está terminado; con “%2$@”, Reproducir lo vuelve a empezar desde el principio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "با «%1$@»، «پخش» روی کتاب تمام‌شده می‌گوید که تمام شده است؛ با «%2$@»، «پخش» آن را دوباره از ابتدا شروع می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Avec « %1$@ », Lire sur un livre terminé indique qu’il est terminé ; avec « %2$@ », Lire le reprend depuis le début."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "כשנבחר “%1$@”, “נגן” על ספר שהושלם אומר שהוא הושלם; כשנבחר “%2$@”, “נגן” מתחיל אותו מחדש מההתחלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” के साथ, पूरी हो चुकी पुस्तक पर “चलाएँ” बताता है कि वह पूरी हो चुकी है; “%2$@” के साथ, “चलाएँ” उसे शुरुआत से फिर शुरू करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dengan “%1$@”, Putar pada buku yang sudah selesai menyatakan buku itu selesai; dengan “%2$@”, Putar memulainya lagi dari awal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con “%1$@”, Riproduci su un libro terminato dice che è terminato; con “%2$@”, Riproduci lo fa ripartire dall’inizio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%1$@」の場合、読了したブックで「再生」すると読了と伝えます。「%2$@」の場合、「再生」すると最初からもう一度再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@”을(를) 선택하면 완료한 책에서 재생할 때 완료되었다고 알려 주고, “%2$@”을(를) 선택하면 처음부터 다시 재생합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Met “%1$@” zegt Speel af op een voltooid boek dat het voltooid is; met “%2$@” begint Speel af het opnieuw vanaf het begin."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Przy „%1$@” Odtwórz na ukończonej książce informuje, że jest ukończona; przy „%2$@” Odtwórz zaczyna ją od początku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Com “%1$@”, Reproduzir em um livro concluído diz que ele está concluído; com “%2$@”, Reproduzir o inicia de novo desde o começo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Если выбрано «%1$@», «Воспроизвести» для завершённой книги сообщает, что она завершена; если «%2$@» — начинает её заново с начала."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Med ”%1$@” säger ”Spela upp” på en avslutad bok att den är avslutad; med ”%2$@” startar ”Spela upp” den igen från början."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เมื่อเลือก “%1$@” การเล่นหนังสือที่อ่านจบแล้วจะบอกว่าอ่านจบแล้ว เมื่อเลือก “%2$@” การเล่นจะเริ่มใหม่จากจุดเริ่มต้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” seçiliyken bitmiş bir kitapta Oynat kitabın bittiğini söyler; “%2$@” seçiliyken Oynat kitabı baştan başlatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Якщо вибрано «%1$@», «Відтворити» для завершеної книги повідомляє, що вона завершена; якщо вибрано «%2$@», «Відтворити» починає її знову з початку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” منتخب ہونے پر، مکمل کتاب پر “چلائیں” بتاتا ہے کہ وہ مکمل ہو چکی ہے؛ “%2$@” منتخب ہونے پر، “چلائیں” اسے شروع سے دوبارہ شروع کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nếu chọn “%1$@”, khi nhấn nút Phát trên một sách đã đọc xong, TextMouth sẽ báo là sách đã xong; nếu chọn “%2$@”, nút Phát sẽ bắt đầu lại sách từ đầu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "选取“%1$@”时，对已读完的图书按“播放”会说明它已读完；选取“%2$@”时，“播放”会从头重新开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選擇「%1$@」時，在已完成的書上按「播放」會告知它已完成；選擇「%2$@」時，「播放」會從頭開始。"
          }
        }
      }
    },
