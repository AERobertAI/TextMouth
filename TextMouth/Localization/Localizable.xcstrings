          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile rimuovere questo elemento dalla libreria, quindi resta al suo interno:"
          }
        }
      }
    },
    "This moves all data from %@ back to the default location, %@." : {
      "comment" : "Message of the question asked before moving the library back to the default location. %1$@ is the current folder's path; %2$@ is the default folder's path.",
      "localizations" : {
