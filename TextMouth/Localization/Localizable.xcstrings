{
  "sourceLanguage" : "en",
  "strings" : {
    "addToLibrary.buttonHint" : {
      "comment" : "VoiceOver hint of the Add to Library toolbar button. Names the five choices the sheet offers, in the order the sheet lists them.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يفتح ورقة لفتح كتاب، أو استيراد مجلد، أو إنشاء كتاب من نص، أو تسجيل صوت، أو إضافة موجز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "বই খুলতে, ফোল্ডার আমদানি করতে, টেক্সট থেকে বই বানাতে, অডিও রেকর্ড করতে বা ফিড যোগ করতে একটি শিট খোলে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffnet ein Sheet, um ein Buch zu öffnen, einen Ordner zu importieren, ein Buch aus Text zu erstellen, Audio aufzunehmen oder einen Feed hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens a sheet to open a book, import a folder, make a book from text, record audio, or add a feed"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre una hoja para abrir un libro, importar una carpeta, crear un libro a partir de texto, grabar audio o agregar un canal"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "برگه‌ای باز می‌کند تا کتابی باز کنید، پوشه‌ای وارد کنید، از متن کتاب بسازید، صدا ضبط کنید یا فیدی اضافه کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ouvre une feuille pour ouvrir un livre, importer un dossier, créer un livre à partir d’un texte, faire un enregistrement audio ou ajouter un flux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "פותח גיליון לפתיחת ספר, לייבוא תיקייה, ליצירת ספר מטקסט, להקלטת שמע או להוספת ערוץ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "एक शीट खोलता है, जिससे पुस्तक खोली जा सकती है, फ़ोल्डर आयात किया जा सकता है, टेक्स्ट से पुस्तक बनाई जा सकती है, ऑडियो रिकॉर्ड किया जा सकता है, या फ़ीड जोड़ा जा सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membuka lembar untuk membuka buku, mengimpor folder, membuat buku dari teks, merekam audio, atau menambahkan feed."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apre un foglio per aprire un libro, importare una cartella, creare un libro dal testo, registrare audio o aggiungere un feed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブックを開く、フォルダを読み込む、テキストからブックを作成する、オーディオを録音する、フィードを追加する、のいずれかを選ぶシートを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "책 열기, 폴더 가져오기, 텍스트로 책 만들기, 오디오 녹음, 피드 추가를 위한 시트를 엽니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Opent een blad om een boek te openen, een map te importeren, een boek van tekst te maken, audio op te nemen of een feed toe te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Otwiera arkusz, w którym można otworzyć książkę, zaimportować folder, utworzyć książkę z tekstu, nagrać dźwięk lub dodać kanał."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre uma folha para abrir um livro, importar uma pasta, criar um livro a partir de texto, gravar áudio ou adicionar um feed."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Открывает лист, где можно открыть книгу, импортировать папку, создать книгу из текста, записать аудио или добавить ленту."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öppnar ett ark där du kan öppna en bok, importera en mapp, skapa en bok av text, spela in ljud eller lägga till ett flöde."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เปิดชีตเพื่อเปิดหนังสือ นำเข้าโฟลเดอร์ สร้างหนังสือจากข้อความ บันทึกเสียง หรือเพิ่มฟีด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bir kitap açmak, klasör içe aktarmak, metinden kitap yapmak, ses kaydetmek veya besleme eklemek için bir açılır sayfa açar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відкриває аркуш, щоб відкрити книгу, імпортувати папку, створити книгу з тексту, записати аудіо або додати стрічку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ایک شیٹ کھولتا ہے جس سے کتاب کھولی جا سکتی ہے، فولڈر درآمد کیا جا سکتا ہے، متن سے کتاب بنائی جا سکتی ہے، آڈیو ریکارڈ کی جا سکتی ہے، یا فیڈ شامل کی جا سکتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mở hộp thoại để mở sách, nhập thư mục, tạo sách từ văn bản, ghi âm hoặc thêm nguồn cấp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "打开表单，以打开图书、导入文件夹、用文本制作图书、录制音频或添加订阅源。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "打開一個工作表，可打開書籍、輸入檔案夾、從文字製作書籍、錄製音訊，或加入訂閱源。"
          }
        }
      }
    },
    "addToLibrary.summary.importFolder" : {
      "comment" : "One-line summary and VoiceOver hint of the Import Folder choice of the Add to Library sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يستورد مجلدًا يحوي كتاب DAISY أو مقاطع صوتية ككتاب واحد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "DAISY বই বা অডিও ট্র্যাক থাকা একটি ফোল্ডারকে একটি বই হিসেবে আমদানি করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Importiert einen Ordner mit einem DAISY-Buch oder Audiotracks als ein Buch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imports a folder holding a DAISY book or audio tracks as one book."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Importa como un solo libro una carpeta con un libro DAISY o pistas de audio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "پوشه‌ای را که کتاب DAISY یا تراک‌های صوتی دارد به‌صورت یک کتاب وارد می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Importe comme un seul livre un dossier contenant un livre DAISY ou des pistes audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מייבא תיקייה שמכילה ספר DAISY או רצועות שמע כספר אחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "DAISY पुस्तक या ऑडियो ट्रैक वाले फ़ोल्डर को एक पुस्तक के रूप में आयात करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mengimpor folder berisi buku DAISY atau trek audio sebagai satu buku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Importa come un solo libro una cartella con un libro DAISY o tracce audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "DAISY ブックまたはオーディオトラックを含むフォルダを、1冊のブックとして読み込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "DAISY 책 또는 오디오 트랙이 들어 있는 폴더를 책 한 권으로 가져옵니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Importeert een map met een DAISY-boek of audiotracks als één boek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Importuje folder z książką DAISY lub ścieżkami audio jako jedną książkę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Importa uma pasta com um livro DAISY ou faixas de áudio como um único livro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Импортирует папку с книгой DAISY или с аудиодорожками как одну книгу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Importerar en mapp med en DAISY-bok eller ljudspår som en enda bok."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "นำเข้าโฟลเดอร์ที่มีหนังสือ DAISY หรือแทร็กเสียงเป็นหนังสือหนึ่งเล่ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bir DAISY kitabı veya ses parçaları içeren klasörü tek kitap olarak içe aktarır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Імпортує папку з книгою DAISY або аудіодоріжками як одну книгу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "DAISY کتاب یا آڈیو ٹریکس والے فولڈر کو ایک کتاب کے طور پر درآمد کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nhập một thư mục chứa sách DAISY hoặc các bản âm thanh thành một sách."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "将包含 DAISY 图书或音轨的文件夹作为一本图书导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "將包含 DAISY 書籍或音軌的檔案夾輸入為一本書。"
          }
        }
      }
    },
    "addToLibrary.summary.newFromText" : {
      "comment" : "One-line summary and VoiceOver hint of the New from Text choice of the Add to Library sheet.",
