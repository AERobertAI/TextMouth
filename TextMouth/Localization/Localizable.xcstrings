    "audioEdit.undoLimit.editedInPlace" : {
      "comment" : "Said when Undo can't reach edits already saved, and the hint of a dimmed Undo in the audio editor: the book keeps no original audio.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يُحتفظ بصوت أصلي لهذا الكتاب، لذا لا يمكن التراجع عن التعديلات المحفوظة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই বইয়ের জন্য মূল অডিও রাখা হয়নি, তাই সংরক্ষিত সম্পাদনা পূর্বাবস্থায় ফেরানো যায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Für dieses Buch wird kein Originalaudio aufbewahrt, daher können gesicherte Bearbeitungen nicht widerrufen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No original audio is kept for this book, so saved edits can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se conserva audio original de este libro, así que las ediciones guardadas no se pueden deshacer."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "برای این کتاب صدای اصلی نگه داشته نمی‌شود، پس ویرایش‌های ذخیره شده را نمی‌توان واگرد کرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucun audio original n’est conservé pour ce livre, donc les modifications enregistrées ne peuvent pas être annulées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא נשמר שמע מקורי עבור הספר הזה, ולכן אי אפשר לבטל עריכות שנשמרו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस पुस्तक का कोई मूल ऑडियो नहीं रखा गया है, इसलिए सहेजे गए संपादन पूर्ववत नहीं किए जा सकते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Audio asli buku ini tidak disimpan, sehingga edit yang sudah tersimpan tidak dapat diurungkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Per questo libro non viene conservato alcun audio originale, quindi le modifiche salvate non si possono annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このブックには元のオーディオが保持されていないため、保存済みの編集は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 책의 원본 오디오가 보관되어 있지 않으므로, 저장된 편집은 취소할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Er wordt geen origineel van de audio bewaard voor dit boek, dus bewaarde bewerkingen kunnen niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dla tej książki nie zachowano oryginalnego dźwięku, więc zachowanych edycji nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nenhum áudio original é mantido para este livro, então as edições salvas não podem ser desfeitas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Для этой книги не хранится исходное аудио, поэтому сохранённые правки нельзя отменить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Inget originalljud behålls för den här boken, så sparade redigeringar kan inte ångras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไม่ได้เก็บเสียงต้นฉบับของหนังสือเล่มนี้ จึงเลิกทำการแก้ไขที่บันทึกแล้วไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bu kitap için orijinal ses saklanmıyor, bu yüzden kaydedilen düzenlemeler geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Оригінальне аудіо для цієї книги не зберігається, тому збережені правки скасувати не можна."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اس کتاب کا کوئی اصل آڈیو نہیں رکھا گیا، اس لیے محفوظ شدہ ترامیم کالعدم نہیں کی جا سکتیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sách này không giữ bản âm thanh gốc nào, nên không thể hoàn tác các chỉnh sửa đã lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此图书没有保留原始音频，因此已存储的编辑无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "這本書沒有保留原始音訊，因此已儲存的編輯無法還原。"
          }
        }
      }
    },
    "audioEdit.undoLimit.nothingToUndo" : {
      "comment" : "Said when Undo is asked for and there is no edit to undo, and the hint of a dimmed Undo in the audio editor.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا شيء للتراجع عنه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "পূর্বাবস্থায় ফেরানোর কিছু নেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es gibt nichts zu widerrufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There's nothing to undo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay nada que deshacer."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "چیزی برای واگرد نیست."
          }
        },
        "fr" : {
