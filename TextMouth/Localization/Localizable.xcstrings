    "adding it to the library" : {
      "comment" : "What a feed download is doing once its file has come: it is being imported as a book. Follows the download's progress line after a comma. Lower case, without a full stop."
    },
    "adding it to the library folder" : {
      "comment" : "What an import was doing with a file when it stopped, as a phrase that follows the name of a book in the import overlay (\"“Moby Dick.epub”, adding it to the library folder\") and, capitalized by the app, starts a failure (\"Adding it to the library folder failed: ...\"). Starts with a lowercase letter and has no full stop."
    },
    "all %lld files" : {
      "comment" : "End of the transcription progress bar's spoken value once every audio file is transcribed, after \"100 percent, \". %lld is the number of files.",
      "localizations" : {
        "en" : {
