    "libraryComparison.changesOnly.bookmarks" : {
      "comment" : "Part of a list in Use This Library's account of which copy is newer. %lld is how many bookmarks only this copy has, a count.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
