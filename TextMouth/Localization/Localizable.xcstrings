    "phoneSettings.shareLogsHint" : {
      "comment" : "Hint of the Share Logs button in iPhone Settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يشارك السجلات الأخيرة كملف نصي. لا تحتوي على نص أي كتاب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "সাম্প্রতিক লগ একটি টেক্সট ফাইল হিসেবে শেয়ার করে। এতে বইয়ের কোনো টেক্সট থাকে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Teilt aktuelle Protokolle als Textdatei. Sie enthalten keinen Buchtext."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shares recent logs as a text file. They hold no book text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Comparte los registros recientes como un archivo de texto. No contienen texto de libros."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "گزارش‌های اخیر را به‌صورت فایل متنی به اشتراک می‌گذارد. متن کتاب در آن‌ها نیست."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Partage les journaux récents sous forme de fichier texte. Ils ne contiennent aucun texte de livre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "משתף יומנים אחרונים כקובץ טקסט. הם לא כוללים טקסט של ספרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "हाल के लॉग को टेक्स्ट फ़ाइल के रूप में साझा करता है। इनमें पुस्तक का टेक्स्ट नहीं होता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Membagikan log terbaru sebagai file teks. Isinya tidak memuat teks buku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Condivide i registri recenti come file di testo. Non contengono testo dei libri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "最近のログをテキストファイルとして共有します。ブックのテキストは含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "최근 로그를 텍스트 파일로 공유합니다. 책 텍스트는 포함되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deelt recente logboeken als tekstbestand. Ze bevatten geen boektekst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Udostępnia ostatnie dzienniki jako plik tekstowy. Nie zawierają tekstu książek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Compartilha os registros recentes como arquivo de texto. Eles não contêm texto de livros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Делится недавними журналами как текстовым файлом. Текста книг в них нет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Delar de senaste loggarna som en textfil. De innehåller ingen boktext."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "แชร์บันทึกการทำงานล่าสุดเป็นไฟล์ข้อความ บันทึกไม่มีข้อความของหนังสือ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Son günlükleri bir metin dosyası olarak paylaşır. Kitap metni içermezler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ділиться нещодавніми журналами як текстовим файлом. Вони не містять тексту книг."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "حالیہ لاگز کو ٹیکسٹ فائل کے طور پر شیئر کرتا ہے۔ ان میں کتاب کا متن شامل نہیں ہوتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chia sẻ nhật ký gần đây dưới dạng tệp văn bản. Nhật ký không chứa văn bản của sách."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "将近期日志共享为文本文件。其中不含图书文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "將最近的記錄分享為文字檔案。其中不含書籍文字。"
          }
        }
      }
    },
