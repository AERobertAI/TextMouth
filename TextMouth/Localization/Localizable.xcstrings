            "value" : "Deine Bearbeitungen am Transkript werden ebenfalls gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tus ediciones de la transcripción también se eliminan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Anche le tue modifiche alla trascrizione vengono eliminate."
          }
        }
      }
    },
    "Your edits to the transcript are replaced too." : {
      "comment" : "Sentence of the question asked before a transcript from a file replaces the book's, when the user had edited it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deine Bearbeitungen am Transkript werden ebenfalls ersetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tus ediciones de la transcripción también se reemplazan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Anche le tue modifiche alla trascrizione vengono sostituite."
          }
        }
      }
    },
    "Your library (%@) will upload to %@ in the background." : {
      "comment" : "First sentence of what moving the library into a cloud folder means. %1$@ is the library's size, such as \"5.5 GB\"; %2$@ is the cloud service's name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your library (%1$@) will upload to %2$@ in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tu biblioteca (%1$@) se subirá a %2$@ en segundo plano."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La tua libreria (%@) verrà caricata su %@ in background."
          }
        }
      }
    },
    "Your library is empty. Add to Library adds a book." : {
      "comment" : "The only row of an empty library. \"Add to Library\" is the name of the button that adds a book, so keep it the same as that button's label.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
