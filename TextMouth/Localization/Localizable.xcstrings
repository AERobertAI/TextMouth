      }
    },
    "The book's navigation does not match its audio; get a fresh copy and import it again." : {
      "comment" : "Last sentence of an import failure: a section of a segmented audiobook does not fit the audio file it names, so the book's navigation (its manifest or headings) does not match its audio.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يتطابق تنقل الكتاب مع صوته، فاحصل على نسخة جديدة واستوردها مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
