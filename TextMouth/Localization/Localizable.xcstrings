        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "İki basış, aralarında %1$@ var. Çift basma sayılması için süreyi %2$@ üzerine ayarlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Два натискання з інтервалом %1$@. Встановіть час понад %2$@, щоб зарахувати їх як подвійне натискання."
          }
        },
        "ur" : {
          "stringUnit" : {
