        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„Text bearbeiten“ wurde für %@ beendet, weil eine neue Kopie das Buch ersetzt hat."
          }
        },
        "en" : {
          "stringUnit" : {
