        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không thể hoàn tất bản ghi âm đúng cách. Phần đã ghi được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
