    "sync.status.folderMissing" : {
      "comment" : "The Sync status when the TextMouth Sync folder cannot be found. %@ names the device (\"this Mac\" or \"this iPhone\"), whose library is unchanged. TextMouth Sync is the folder's name and is not translated.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يجد TextMouth مجلد TextMouth Sync في iCloud Drive. ربما نُقل أو حُذف، أو ربما سُجّل الخروج من iCloud Drive. مكتبتك (%@) كما كانت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth iCloud Drive-এ TextMouth Sync ফোল্ডার খুঁজে পাচ্ছে না। এটি সরানো বা মুছে ফেলা হয়ে থাকতে পারে, অথবা iCloud Drive থেকে সাইন আউট হয়ে থাকতে পারে। %@-এ আপনার লাইব্রেরি আগের মতোই আছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth findet den Ordner TextMouth Sync in iCloud Drive nicht. Er wurde vielleicht verschoben oder gelöscht, oder iCloud Drive ist abgemeldet. Deine Bibliothek (%@) ist unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth can't find the TextMouth Sync folder in iCloud Drive. It may have been moved or deleted, or iCloud Drive signed out. Your library on %@ is as it was."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no encuentra la carpeta TextMouth Sync en iCloud Drive. Puede que se haya movido o eliminado, o que se haya cerrado la sesión de iCloud Drive. Tu biblioteca en %@ sigue como estaba."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth پوشهٔ TextMouth Sync را در iCloud Drive پیدا نمی‌کند. ممکن است جابه‌جا یا حذف شده باشد، یا از iCloud Drive خارج شده باشید. کتابخانهٔ شما در %@ همان‌طور که بود مانده است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ne trouve pas le dossier TextMouth Sync dans iCloud Drive. Il a peut-être été déplacé ou supprimé, ou la session iCloud Drive est fermée. Votre bibliothèque sur %@ est restée telle quelle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth לא מוצא את התיקייה TextMouth Sync ב-iCloud Drive. ייתכן שהועברה או נמחקה, או שנותק החשבון מ-iCloud Drive. הספרייה שלך ב-%@ ללא שינוי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth को iCloud Drive में TextMouth Sync फ़ोल्डर नहीं मिल रहा। हो सकता है उसे हटा या मिटा दिया गया हो, या iCloud Drive से साइन आउट हो गया हो। %@ पर आपकी लाइब्रेरी जैसी थी वैसी ही है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tidak menemukan folder TextMouth Sync di iCloud Drive. Folder itu mungkin dipindahkan atau dihapus, atau Anda sudah keluar dari iCloud Drive. Pustaka Anda di %@ tetap seperti semula."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non trova la cartella TextMouth Sync in iCloud Drive. Potrebbe essere stata spostata o eliminata, oppure iCloud Drive potrebbe essere disconnesso. La tua libreria su %@ è rimasta com’era."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth が iCloud Drive 内の TextMouth Sync フォルダを見つけられません。移動または削除されたか、iCloud Drive からサインアウトしている可能性があります。%@ のライブラリは変わっていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 iCloud Drive에서 TextMouth Sync 폴더를 찾을 수 없습니다. 폴더가 이동되었거나 삭제되었거나 iCloud Drive에서 로그아웃되었을 수 있습니다. %@의 보관함은 그대로입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kan de map TextMouth Sync niet vinden in iCloud Drive. Misschien is die verplaatst of verwijderd, of is iCloud Drive afgemeld. Je bibliotheek op %@ is ongewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth nie może znaleźć folderu TextMouth Sync w iCloud Drive. Mógł zostać przeniesiony lub usunięty albo mogło nastąpić wylogowanie z iCloud Drive. Twoja biblioteka (%@) pozostaje bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não encontra a pasta TextMouth Sync no iCloud Drive. Ela pode ter sido movida ou apagada, ou o iCloud Drive pode estar sem login. Sua biblioteca (%@) continua como estava."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не находит папку TextMouth Sync в iCloud Drive. Возможно, её переместили или удалили, либо выполнен выход из iCloud Drive. Ваша библиотека (%@) осталась без изменений."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth hittar inte mappen TextMouth Sync i iCloud Drive. Den kan ha flyttats eller raderats, eller så är du utloggad från iCloud Drive. Ditt bibliotek på %@ är oförändrat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ไม่พบโฟลเดอร์ TextMouth Sync ใน iCloud Drive โฟลเดอร์อาจถูกย้ายหรือลบ หรือออกจากระบบ iCloud Drive อยู่ ไลบรารีของคุณบน %@ ยังเหมือนเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth, iCloud Drive içinde TextMouth Sync klasörünü bulamıyor. Taşınmış ya da silinmiş olabilir veya iCloud Drive oturumu kapatılmış olabilir. %@ üzerindeki kitaplığınız olduğu gibi duruyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не знаходить папку TextMouth Sync в iCloud Drive. Можливо, її переміщено чи видалено, або виконано вихід з iCloud Drive. Ваша бібліотека (%@) залишилася без змін."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth کو iCloud Drive میں TextMouth Sync فولڈر نہیں مل رہا۔ ہو سکتا ہے اسے منتقل یا حذف کر دیا گیا ہو، یا iCloud Drive سے سائن آؤٹ ہو گیا ہو۔ %@ پر آپ کی لائبریری جیسی تھی ویسی ہی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth không tìm thấy thư mục TextMouth Sync trong iCloud Drive. Có thể nó đã bị di chuyển hoặc xóa, hoặc iCloud Drive đã đăng xuất. Thư viện của bạn trên %@ vẫn như cũ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 在 iCloud 云盘中找不到 TextMouth Sync 文件夹。它可能已被移动或删除，或者 iCloud 云盘已退出登录。你在 %@ 上的资料库保持原样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 在 iCloud Drive 中找不到 TextMouth Sync 檔案夾。它可能已被移動或刪除，或 iCloud Drive 已登出。你在 %@ 上的書庫維持原樣。"
          }
        }
      }
    },
    "sync.status.heldRemovals" : {
      "comment" : "The Sync status when TextMouth held back removing many books at once because it looked like a mistake. The first %@ is a phrase counting books (\"42 books\"), and the second names the device (\"this Mac\" or \"this iPhone\"), whose library the person should check. Sync Now is the name of a command.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "منع TextMouth إزالة %@ لأنها بدت خطأً. تحقق من المكتبة (%@) ثم اختر المزامنة الآن."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ভুল মনে হওয়ায় TextMouth %@ সরানো স্থগিত রেখেছে। %@-এ লাইব্রেরি দেখে নিন, তারপর এখনই সিঙ্ক করুন বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth hat das Entfernen von %@ zurückgehalten, weil es wie ein Fehler aussah. Prüfe die Bibliothek (%@) und wähle dann „Jetzt synchronisieren“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth held back removing %@, since it looked like a mistake. Check the library on %@, then choose Sync Now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth detuvo la eliminación de %@ porque parecía un error. Revisa tu biblioteca en %@ y luego elige Sincronizar ahora."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth حذف %@ را متوقف کرد، چون به نظر اشتباه می‌آمد. کتابخانهٔ خود در %@ را بررسی کنید و سپس «همگام‌سازی اکنون» را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth a suspendu la suppression de %@, car cela ressemblait à une erreur. Vérifiez la bibliothèque sur %@, puis choisissez Synchroniser maintenant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth עצר את הסרת %@ כי זה נראה כמו טעות. בדוק את הספרייה ב-%@ ואז בחר ״סנכרן עכשיו״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ने %@ हटाना रोक दिया, क्योंकि यह गलती जैसा लगा। %@ पर लाइब्रेरी जाँचें, फिर “अभी सिंक करें” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth menahan penghapusan %@ karena tampak seperti kesalahan. Periksa pustaka di %@, lalu pilih Sinkronkan Sekarang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ha trattenuto la rimozione di %@ perché sembrava un errore. Controlla la libreria su %@, poi scegli Sincronizza ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "間違いのように見えたため、TextMouth は%@の削除を保留しました。%@ のライブラリを確認してから、「今すぐ同期」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "실수로 보여서 TextMouth가 %@ 제거를 보류했습니다. %@의 보관함을 확인한 다음 ‘지금 동기화’를 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth heeft het verwijderen van %@ tegengehouden, omdat het op een vergissing leek. Controleer de bibliotheek op %@ en kies daarna Synchroniseer nu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth wstrzymał usuwanie: %@, ponieważ wyglądało to na pomyłkę. Sprawdź bibliotekę (%@), a potem wybierz Synchronizuj teraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth segurou a remoção de %@, pois parecia um engano. Confira a biblioteca (%@) e escolha Sincronizar agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth приостановил удаление: %@, так как это похоже на ошибку. Проверьте библиотеку (%@), затем выберите «Синхронизировать сейчас»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth höll tillbaka borttagningen av %@, eftersom det såg ut som ett misstag. Kontrollera biblioteket på %@ och välj sedan Synkronisera nu."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ระงับการลบ %@ ไว้ เพราะดูเหมือนเป็นความผิดพลาด ตรวจสอบไลบรารีบน %@ แล้วเลือก “ซิงค์ตอนนี้”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth, hata gibi göründüğü için %@ kaldırma işlemini tuttu. %@ üzerindeki kitaplığı kontrol edin, ardından Şimdi Eşzamanla’yı seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth призупинив видалення: %@, бо це схоже на помилку. Перевірте бібліотеку (%@), а потім виберіть «Синхронізувати зараз»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth نے %@ ہٹانا روک دیا، کیونکہ یہ غلطی لگ رہی تھی۔ %@ پر لائبریری دیکھیں، پھر «ابھی سنک کریں» چنیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth đã giữ lại việc xóa %@ vì có vẻ là nhầm lẫn. Hãy kiểm tra thư viện trên %@, rồi chọn Đồng bộ ngay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 认为这像是误操作，已暂缓移除%@。请检查 %@ 上的资料库，然后选择“立即同步”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 認為這像是誤操作，已暫緩移除%@。請檢查 %@ 上的書庫，然後選擇「立即同步」。"
          }
        }
      }
    },
    "sync.status.laterVersion" : {
      "comment" : "The Sync status when a newer TextMouth made the sync folder, so this one cannot use it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أنشأ إصدار أحدث من TextMouth مجلد المزامنة هذا. حدّث TextMouth لاستخدامه."
