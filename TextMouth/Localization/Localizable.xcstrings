            "value" : "場所、ブックマーク、文字起こし（ある場合）は残り、もう一度ダウンロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "위치, 북마크, 대본이 있으면 그대로 유지되며, 다시 다운로드할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hun leesposities, bladwijzers en transcripties, als die er zijn, blijven bewaard en ze kunnen opnieuw worden gedownload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pozycje czytania, zakładki i transkrypcje, jeśli istnieją, zostają zachowane, a pobrane pliki można pobrać ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Suas posições, marcadores e transcrições, se tiverem, são mantidos, e eles podem ser baixados novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Позиции чтения, закладки и расшифровки, если они есть, сохраняются, и их можно загрузить снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deras platser, bokmärken och transkriptioner, om de har några, behålls, och de kan hämtas igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ตำแหน่ง ที่คั่นหน้า และข้อความถอดเสียง (ถ้ามี) ของรายการเหล่านั้นจะยังอยู่ และดาวน์โหลดใหม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yerleri, yer imleri ve varsa transkriptleri saklanır ve yeniden indirilebilirler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Їхні місця, закладки та транскрипції, якщо вони є, збережено, і їх можна завантажити знову."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ان کے مقامات، بک مارکس اور ٹرانسکرپٹ، اگر ہوں، برقرار رکھے جاتے ہیں، اور انہیں دوبارہ ڈاؤن لوڈ کیا جا سکتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vị trí, dấu trang và bản chép lời của chúng, nếu có, được giữ lại, và có thể tải về lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "它们的位置、书签和文字稿（如果有）都会保留，并且可以再次下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "它們的位置、書籤和逐字稿（如有）都會保留，且可以再次下載。"
          }
        }
      }
    },
