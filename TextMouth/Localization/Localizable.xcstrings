    "feedItemBookInfo.whyReadOnly.article" : {
      "comment" : "The line under the heading of an article's read-only Book Information sheet: why nothing can be changed, and the way out. %@ is the name of the Move to Library command.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تأتي تفاصيل المقالة من موجزها؛ %@ يحوّلها إلى كتاب يمكنك تحريره."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "নিবন্ধের বিবরণ ফিড থেকে আসে; %@ বেছে নিলে এটি সম্পাদনাযোগ্য বই হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Details eines Artikels stammen aus seinem Feed; mit %@ wird daraus ein Buch, das du bearbeiten kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An article's details come from its feed; %@ makes it a book you can edit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los detalles de un artículo provienen de su canal; %@ lo convierte en un libro que puedes editar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جزئیات مقاله از فید آن می‌آید؛ %@ آن را به کتابی قابل ویرایش تبدیل می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les détails d’un article viennent de son flux ; %@ en fait un livre que vous pouvez modifier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "פרטי הכתבה מגיעים מהערוץ שלה; “%@” הופך אותה לספר שאפשר לערוך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लेख का विवरण उसके फ़ीड से आता है; “%@” उसे ऐसी पुस्तक बना देता है जिसे आप संपादित कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Detail artikel berasal dari feed-nya; %@ menjadikannya buku yang dapat Anda edit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I dettagli di un articolo provengono dal suo feed; con %@ diventa un libro che puoi modificare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "記事の詳細はフィードから取得されます。「%@」を選択すると、編集できるブックになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "기사의 세부 정보는 피드에서 가져옵니다. %@을(를) 사용하면 편집할 수 있는 책이 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De gegevens van een artikel komen uit de feed; met %@ maak je er een boek van dat je kunt wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Szczegóły artykułu pochodzą z jego kanału; %@ tworzy z niego książkę, którą można edytować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Os detalhes de um artigo vêm do feed; %@ o transforma em um livro que você pode editar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сведения о статье берутся из её ленты; %@ превращает её в книгу, которую можно изменять."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uppgifterna om en artikel kommer från dess flöde; %@ gör den till en bok som du kan redigera."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "รายละเอียดของบทความมาจากฟีด คำสั่ง %@ จะทำให้บทความเป็นหนังสือที่คุณแก้ไขได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bir makalenin ayrıntıları beslemesinden gelir; %@ onu düzenleyebileceğiniz bir kitap yapar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відомості про статтю беруться з її стрічки; «%@» перетворює її на книгу, яку можна редагувати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مضمون کی تفصیلات اس کی فیڈ سے آتی ہیں؛ %@ اسے ایسی کتاب بنا دیتا ہے جس میں آپ ترمیم کر سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thông tin về bài viết đến từ nguồn cấp của nó; %@ biến nó thành sách bạn có thể sửa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文章的详细信息来自其订阅源；“%@”可将其变为可编辑的图书。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文章的詳細資料來自其訂閱源；「%@」會將它變成你可以編輯的書籍。"
          }
        }
      }
    },
