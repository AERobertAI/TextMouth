    "librarySearch.movedToMatchFoundAgain" : {
      "comment" : "Announcement when the book's text changed since the search and the reader moved to the nearest match.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تغيّر النص منذ البحث؛ تم الانتقال إلى أقرب مطابقة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "অনুসন্ধানের পর টেক্সট বদলে গেছে; নিকটতম মিলটিতে যাওয়া হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Text hat sich seit der Suche geändert; zum nächstgelegenen Treffer gesprungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The text changed since the search; moved to the nearest match."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El texto cambió desde la búsqueda; se pasó a la coincidencia más cercana."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "متن از زمان جست‌وجو تغییر کرده است؛ به نزدیک‌ترین تطابق رفت."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le texte a changé depuis la recherche ; déplacé à la correspondance la plus proche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "הטקסט השתנה מאז החיפוש; בוצע מעבר להתאמה הקרובה ביותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "खोज के बाद टेक्स्ट बदल गया; निकटतम मिलान पर ले जाया गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Teks berubah sejak pencarian; berpindah ke kecocokan terdekat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il testo è cambiato dopo la ricerca; spostato alla corrispondenza più vicina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "検索後にテキストが変更されたため、最も近い一致に移動しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "검색 이후 텍스트가 변경되어 가장 가까운 일치 항목으로 이동했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De tekst is gewijzigd sinds het zoeken; naar de dichtstbijzijnde treffer gegaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tekst zmienił się od czasu wyszukiwania; przejście do najbliższego trafienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O texto mudou desde a busca; movido para a correspondência mais próxima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Текст изменился после поиска; выполнен переход к ближайшему совпадению."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Texten har ändrats sedan sökningen; gick till närmaste träff."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ข้อความเปลี่ยนไปตั้งแต่ค้นหา จึงไปที่รายการที่ตรงกันที่ใกล้ที่สุดแทน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Metin aramadan sonra değişti; en yakın eşleşmeye gidildi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Текст змінився після пошуку; перехід до найближчого збігу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تلاش کے بعد متن تبدیل ہو گیا؛ قریب ترین مماثلت پر منتقل ہو گئے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Văn bản đã thay đổi kể từ lần tìm kiếm; đã chuyển đến kết quả khớp gần nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文本自搜索后已更改；已移到最近的匹配项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "文字在搜尋後有所更改；已移到最接近的符合項目。"
          }
        }
      }
    },
