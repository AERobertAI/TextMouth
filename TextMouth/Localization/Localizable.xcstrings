        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "图书在这段时间内一直未打开时，从此设备移除其下载内容。图书仍保留在 iCloud Drive 中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "書籍在這段時間內一直未打開時，從此裝置移除其下載項目。書籍仍保留在 iCloud Drive 中。"
