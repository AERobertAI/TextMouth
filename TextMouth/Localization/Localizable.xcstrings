                  "state" : "machine_translated",
                  "value" : "Non è stato possibile leggere %@ capitoli su %lld"
                }
              }
            }
          }
        }
      }
    },
    "%@ on this book" : {
      "comment" : "Line of the import overlay: how long the book under way has taken. %@ is the time in words, such as \"1 minute, 5 seconds\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ en este libro"
