          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "комбінація команди меню — це одне натискання клавіші з Command або Control"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مینو کمانڈ کا شارٹ کٹ کمانڈ یا کنٹرول کے ساتھ کسی کلید کا ایک بار دبانا ہوتا ہے"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "phím tắt của một lệnh menu là một lần nhấn một phím cùng với Command hoặc Control"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "菜单命令的快捷键只能是与 Command 或 Control 同时按下的一个键"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選單指令的快速鍵必須是搭配 Command 或 Control 的單次按鍵"
          }
        }
      }
    },
    "shortcutRefusal.reason.editsText" : {
