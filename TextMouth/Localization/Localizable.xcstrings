    "pronunciationLexicon.exportHint" : {
      "comment" : "VoiceOver hint of the Export Rules button in Settings, Text, Substitutions: which rules are saved and which are left out.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحفظ قواعد النص العادي المفعّلة لديك؛ وتُستبعد قواعد التعبيرات النمطية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "আপনার চালু থাকা সাধারণ টেক্সট নিয়মগুলো সংরক্ষণ করে; রেগুলার এক্সপ্রেশন নিয়ম বাদ দেওয়া হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sichert deine aktivierten Klartextregeln; Regeln mit regulären Ausdrücken werden ausgelassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves your plain text rules that are on; regular expression rules are left out"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Guarda tus reglas de texto simple que están activadas; las reglas de expresión regular se dejan fuera"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "قاعده‌های متن ساده روشن شما را ذخیره می‌کند؛ قاعده‌های عبارت منظم کنار گذاشته می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Enregistre vos règles en texte brut qui sont activées ; les règles à expression régulière sont omises."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "שומר את כללי הטקסט הרגיל שפועלים; כללי ביטויים רגולריים מושמטים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आपके चालू सादे टेक्स्ट नियम सहेजता है; रेगुलर एक्सप्रेशन नियम छोड़ दिए जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Menyimpan aturan teks biasa Anda yang aktif; aturan ekspresi reguler dikecualikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Salva le tue regole di testo semplice attive; le regole con espressioni regolari vengono escluse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オンのプレーンテキストのルールを保存します。正規表現のルールは除外されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "켜져 있는 일반 텍스트 규칙을 저장하며, 정규 표현식 규칙은 제외됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bewaart je gewone tekstregels die aanstaan; regels met reguliere expressies worden weggelaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zachowuje włączone reguły zwykłego tekstu; reguły wyrażeń regularnych są pomijane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Salva suas regras de texto simples que estão ativadas; regras de expressão regular ficam de fora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сохраняет включённые правила обычного текста; правила с регулярными выражениями пропускаются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sparar dina vanliga textregler som är på; regler med reguljära uttryck utelämnas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "บันทึกกฎข้อความธรรมดาของคุณที่เปิดอยู่ กฎนิพจน์ทั่วไปจะไม่รวมไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Açık olan düz metin kurallarınızı kaydeder; düzenli ifade kuralları dışarıda bırakılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Зберігає ваші звичайні текстові правила, які увімкнено; правила з регулярними виразами пропускаються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آپ کے فعال سادہ متن کے اصول محفوظ کرتا ہے؛ ریگولر ایکسپریشن والے اصول چھوڑ دیے جاتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lưu các quy tắc văn bản thuần đang bật của bạn; các quy tắc biểu thức chính quy sẽ bị loại ra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "存储你已开启的纯文本规则；正则表达式规则会被略过。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "儲存你已開啟的純文字規則；正規表示式規則會被略過。"
          }
        }
      }
    },
