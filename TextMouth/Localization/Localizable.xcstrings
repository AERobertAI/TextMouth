    "The episode leaves the list for good, and its download, if any, is deleted." : {
      "comment" : "First sentence of the confirmation before an episode is deleted from its feed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Folge verschwindet für immer aus der Liste, und ihr Download, falls vorhanden, wird gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El episodio sale de la lista para siempre, y su descarga, si la tiene, se elimina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’épisode quitte la liste pour de bon, et son téléchargement, s’il y en a un, est supprimé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’episodio esce dall’elenco per sempre e il suo download, se c’è, viene eliminato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O episódio sai da lista de vez, e o download dele, se houver, é excluído."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Выпуск навсегда исчезает из списка, а его загрузка, если она есть, удаляется."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Епізод остаточно зникає зі списку, а його завантаження, якщо є, видаляється."
          }
        }
      }
    },
    "The episode leaves the list for good; the book it became in your library stays." : {
      "comment" : "First sentence of the confirmation before an episode that was moved into the library is deleted from its feed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Folge verschwindet für immer aus der Liste; das Buch, das daraus in deiner Bibliothek wurde, bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El episodio sale de la lista para siempre; el libro en que se convirtió en tu biblioteca se queda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’épisode quitte la liste pour de bon ; le livre qu’il est devenu dans votre bibliothèque reste."
