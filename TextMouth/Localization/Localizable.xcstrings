    "repeatedSymbolsSettingsView.explanation" : {
      "comment" : "Caption under the controls of Settings, Text, Repeated Symbols that explains what a run is and that only speech changes.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "السلسلة هي رمز واحد مكرر، بمفرده أو تفصل بينه مسافات مفردة، مثل * * * * أو ====. يعيد النطق كتابة السلاسل قبل القواعد أعلاه، بينما تحتفظ الشاشة وبرايل بكل رمز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ধারা হলো একটিই চিহ্নের পুনরাবৃত্তি, একা বা একক ফাঁকসহ, যেমন * * * * বা ====। উপরের নিয়মগুলোর আগে স্পিচ ধারা বদলে নেয়; স্ক্রিন ও ব্রেইল প্রতিটি চিহ্ন রাখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eine Reihe ist ein einzelnes Symbol, das wiederholt wird, allein oder mit einzelnen Leerzeichen, wie * * * * oder ====. Die Sprachausgabe schreibt Reihen vor den obigen Regeln um; der Bildschirm und Braille behalten jedes Symbol."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A run is one symbol repeated, alone or with single spaces, such as * * * * or ====. Speech rewrites runs before the rules above; the screen and braille keep every symbol."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una serie es un símbolo repetido, solo o con espacios sencillos, como * * * * o ====. La voz reescribe las series antes de aplicar las reglas anteriores; la pantalla y el braille conservan todos los símbolos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "دنباله یعنی یک نماد تکرارشده، تنها یا با فاصله‌های تکی، مانند * * * * یا ====. گفتار دنباله‌ها را پیش از قاعده‌های بالا بازنویسی می‌کند؛ صفحه‌نمایش و بریل هر نماد را نگه می‌دارند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une séquence est un même symbole répété, seul ou séparé par des espaces simples, comme * * * * ou ====. La voix réécrit les séquences avant les règles ci-dessus ; l’écran et le braille gardent chaque symbole."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "רצף הוא סמל אחד שחוזר, לבדו או עם רווחים בודדים, כמו * * * * או ====. הדיבור מנסח מחדש רצפים לפני הכללים שלמעלה; המסך והברייל שומרים כל סמל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "क्रम एक ही प्रतीक की पुनरावृत्ति है, अकेले या इकहरे स्पेस के साथ, जैसे * * * * या ====। बोलते समय क्रमों को ऊपर के नियमों से पहले दोबारा लिखा जाता है; स्क्रीन और ब्रेल हर प्रतीक रखते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rangkaian adalah satu simbol yang diulang, sendirian atau dengan spasi tunggal, seperti * * * * atau ====. Ucapan menulis ulang rangkaian sebelum aturan di atas; layar dan braille tetap menampilkan setiap simbol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una sequenza è un simbolo ripetuto, da solo o con spazi singoli, come * * * * o ====. La voce riscrive le sequenze prima delle regole qui sopra; lo schermo e il braille mantengono ogni simbolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "連続とは、* * * * や ==== のように、同じ記号が単独で、または1つずつの空白を挟んで繰り返されたものです。読み上げでは、上のルールより先に連続が書き換えられます。画面と点字では、すべての記号がそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "반복 구간은 * * * * 또는 ====처럼 하나의 기호가 혼자 또는 한 칸씩 띄어 반복되는 부분입니다. 음성은 위의 규칙보다 먼저 반복 구간을 고쳐 읽으며, 화면과 점자에는 모든 기호가 그대로 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Een reeks is één symbool dat wordt herhaald, alleen of met enkele spaties, zoals * * * * of ====. De spraak herschrijft reeksen vóór de bovenstaande regels; het scherm en braille behouden elk symbool."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Serię tworzy jeden powtarzany symbol, sam lub z pojedynczymi spacjami, na przykład * * * * lub ====. Mowa zmienia serie przed regułami powyżej; ekran i braille zachowują każdy symbol."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uma sequência é um símbolo repetido, sozinho ou com espaços simples, como * * * * ou ====. A fala reescreve as sequências antes das regras acima; a tela e o braille mantêm todos os símbolos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Серия — это один повторяющийся символ, отдельно или через одиночные пробелы, например * * * * или ====. Озвучивание переписывает серии до применения правил выше; на экране и в Брайле остаётся каждый символ."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En följd är en symbol som upprepas, ensam eller med enstaka blanksteg, till exempel * * * * eller ====. Uppläsningen skriver om följder före reglerna ovan; skärmen och punktskriften behåller varje symbol."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "สัญลักษณ์ซ้ำคือสัญลักษณ์เดียวที่เขียนซ้ำ ไม่ว่าจะติดกันหรือคั่นด้วยช่องว่างเดี่ยว เช่น * * * * หรือ ==== การอ่านออกเสียงจะเขียนสัญลักษณ์ซ้ำใหม่ก่อนใช้กฎด้านบน ส่วนหน้าจอและอักษรเบรลล์จะคงสัญลักษณ์ทุกตัวไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dizi, tek başına ya da tek boşluklarla tekrarlanan tek bir simgedir, örneğin * * * * veya ====. Konuşma, dizileri yukarıdaki kurallardan önce yeniden yazar; ekran ve braille her simgeyi korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Послідовність — це один символ, що повторюється окремо або через одинарні пробіли, наприклад * * * * чи ====. Озвучення переписує послідовності до застосування правил, наведених вище; екран і брайль зберігають кожен символ."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تسلسل ایک ہی علامت کا بار بار آنا ہے، اکیلی یا اکہری جگہوں کے ساتھ، جیسے * * * * یا ====۔ اسپیچ اوپر کے اصولوں سے پہلے تسلسل کو دوبارہ لکھتی ہے؛ اسکرین اور بریل ہر علامت برقرار رکھتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chuỗi là một ký hiệu lặp lại, đứng liền nhau hoặc cách nhau bằng một dấu cách, chẳng hạn * * * * hoặc ====. Giọng đọc viết lại các chuỗi trước khi áp dụng các quy tắc ở trên; màn hình và braille giữ nguyên mọi ký hiệu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "连续符号是指单独或以单个空格间隔重复出现的同一个符号，例如 * * * * 或 ====。朗读会先于上方的规则改写连续符号；屏幕和盲文会保留每个符号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "連續符號是指重複的同一個符號，單獨出現或以單一空格隔開，例如 * * * * 或 ====。朗讀會在上方的規則之前改寫連續符號；螢幕和點字則保留每個符號。"
          }
        }
      }
    },
