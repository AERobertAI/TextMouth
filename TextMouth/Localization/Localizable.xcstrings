    "Speech paused: the voice did not start. Press Play to try again." : {
      "comment" : "Announcement when the voice did not start a passage, even on fresh synthesizers, so speech paused there. Play is the name of a button.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sprachausgabe pausiert: Die Stimme hat nicht begonnen. Drücke „Wiedergeben“, um es erneut zu versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lectura en pausa: la voz no arrancó. Pulsa Reproducir para intentarlo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voix en pause : la voix n’a pas démarré. Appuyez sur Lire pour réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lettura in pausa: la voce non è partita. Premi Riproduci per riprovare."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fala pausada: a voz não começou. Pressione Reproduzir para tentar de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Речь приостановлена: голос не запустился. Нажмите «Воспроизвести», чтобы попробовать снова."
          }
        }
      }
    },
    "Speech stopped at character %@ of %@ in the chapter." : {
      "comment" : "A line of the speech refusal report. %1$@ is the character offset where speech stopped and %2$@ the chapter's length in characters, each written without digit grouping like the speech log's offsets.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Sprachausgabe stoppte bei Zeichen %1$@ von %2$@ im Kapitel."
          }
        },
        "en" : {
