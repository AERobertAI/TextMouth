        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudieron guardar algunos cambios"
          }
        }
      }
    },
    "Some Files Not Imported" : {
      "comment" : "Title of the library's alert as a ZIP batch that added at least one book ends having left some files out: a file failed or the batch was cancelled. Title case.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Algunos archivos no se importaron"
          }
