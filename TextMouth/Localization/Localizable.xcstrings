        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اسے اس آلے کے کی چین میں رکھتا ہے، تاکہ TextMouth اس کتاب کے لیے دوبارہ نہ پوچھے۔"
