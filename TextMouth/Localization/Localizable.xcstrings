          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kan geen bestanden met kopieerbeveiliging openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth nie otwiera plików chronionych przed kopiowaniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
