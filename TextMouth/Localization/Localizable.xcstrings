          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hai pulito questa trascrizione il %@. Trascrivere di nuovo sostituisce la pulizia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "この文字起こしは%@に整理されています。もう一度文字起こしすると、整理した内容が置き換えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
