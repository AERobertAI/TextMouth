    "readerOgg.beingConverted" : {
      "comment" : "What Play says while the book's Ogg audio is being converted to AAC.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يجري تحويل صوت هذا الكتاب من Ogg إلى AAC. سيُشغَّل عندما ينتهي ذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "এই বইয়ের অডিও Ogg থেকে AAC-তে রূপান্তর করা হচ্ছে। শেষ হলে এটি চলবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Audio dieses Buchs wird gerade von Ogg in AAC umgewandelt. Es wird wiedergegeben, wenn das fertig ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This book's audio is being converted from Ogg to AAC. It plays when that ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El audio de este libro se está convirtiendo de Ogg a AAC. Se reproducirá cuando termine."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "صدای این کتاب در حال تبدیل از Ogg به AAC است. پس از پایان آن پخش می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
