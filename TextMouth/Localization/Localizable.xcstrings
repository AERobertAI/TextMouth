        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "פעולה זו מעבירה את כל הנתונים מהתיקייה %1$@ בחזרה למיקום ברירת המחדל, %2$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
