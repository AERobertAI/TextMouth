    "refusedFormatAdvice.wordPerfect" : {
      "comment" : "Advice after the refusal of a WordPerfect document, which no part of macOS reads. LibreOffice is a program's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "احفظ مستندات WordPerfect كملفات Word أو HTML في برنامج يقرؤها، مثل LibreOffice، ثم استوردها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "WordPerfect নথি পড়তে পারে এমন কোনো প্রোগ্রামে, যেমন LibreOffice-এ, সেগুলো Word বা HTML ফাইল হিসেবে সংরক্ষণ করুন, তারপর সেগুলো আমদানি করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sichere WordPerfect-Dokumente in einem Programm, das sie lesen kann, etwa LibreOffice, als Word- oder HTML-Dateien und importiere diese dann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save WordPerfect documents as Word or HTML files in a program that reads them, such as LibreOffice, then import those."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Guarda los documentos de WordPerfect como archivos de Word o HTML en un programa que los lea, como LibreOffice, y luego impórtalos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سندهای WordPerfect را در برنامه‌ای که آن‌ها را می‌خواند، مانند LibreOffice، به‌صورت فایل Word یا HTML ذخیره کنید، سپس آن‌ها را وارد کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Enregistrez les documents WordPerfect en fichiers Word ou HTML dans un programme qui les lit, comme LibreOffice, puis importez-les."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "שמור מסמכי WordPerfect כקבצי Word או HTML בתוכנה שקוראת אותם, כמו LibreOffice, ואז ייבא אותם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "WordPerfect दस्तावेज़ों को उन्हें पढ़ने वाले किसी प्रोग्राम (जैसे LibreOffice) में Word या HTML फ़ाइलों के रूप में सहेजें, फिर उन्हें आयात करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Simpan dokumen WordPerfect sebagai file Word atau HTML di program yang dapat membacanya, seperti LibreOffice, lalu impor file tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Salva i documenti WordPerfect come file Word o HTML in un programma che li legga, come LibreOffice, poi importali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "WordPerfect の書類を、LibreOffice など読み取れるプログラムで Word または HTML ファイルとして保存してから、読み込んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "WordPerfect 문서를 LibreOffice처럼 이 문서를 읽을 수 있는 프로그램에서 Word 또는 HTML 파일로 저장한 다음 가져오십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bewaar WordPerfect-documenten als Word- of HTML-bestanden in een programma dat ze kan lezen, zoals LibreOffice, en importeer die dan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zachowaj dokumenty WordPerfect jako pliki Word lub HTML w programie, który je odczytuje, takim jak LibreOffice, a potem zaimportuj je."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Salve os documentos do WordPerfect como arquivos do Word ou HTML em um programa que os leia, como o LibreOffice, e depois importe-os."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сохраните документы WordPerfect как файлы Word или HTML в программе, которая их читает, например в LibreOffice, и импортируйте их."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Spara WordPerfect-dokument som Word- eller HTML-filer i ett program som kan läsa dem, till exempel LibreOffice, och importera sedan filerna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "บันทึกเอกสาร WordPerfect เป็นไฟล์ Word หรือ HTML ในโปรแกรมที่อ่านได้ เช่น LibreOffice แล้วนำเข้าไฟล์เหล่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "WordPerfect belgelerini, onları okuyan bir programda, örneğin LibreOffice'te Word veya HTML dosyası olarak kaydedin, sonra bunları içe aktarın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Збережіть документи WordPerfect як файли Word або HTML у програмі, що їх читає, наприклад LibreOffice, а потім імпортуйте їх."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "WordPerfect دستاویزات کو LibreOffice جیسے کسی ایسے پروگرام میں جو انہیں پڑھ سکے، Word یا HTML فائلوں کے طور پر محفوظ کریں، پھر انہیں درآمد کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hãy lưu tài liệu WordPerfect thành tệp Word hoặc HTML trong một chương trình đọc được chúng, như LibreOffice, rồi nhập các tệp đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "请在能读取 WordPerfect 文档的程序（如 LibreOffice）中将其存储为 Word 或 HTML 文件，然后导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "請在能讀取 WordPerfect 文件的程式（例如 LibreOffice）中，將其儲存為 Word 或 HTML 檔案，然後輸入這些檔案。"
          }
        }
      }
    },
