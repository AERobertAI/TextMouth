    "feed.alreadyBeingAdded" : {
      "comment" : "What VoiceOver says when Cancel Download comes too late: the download's book is already being imported. %@ is the title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تتم إضافة “%@” إلى المكتبة بالفعل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” ইতিমধ্যে লাইব্রেরিতে যোগ করা হচ্ছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%@“ wird bereits zur Bibliothek hinzugefügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is already being added to the library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” ya se está agregando a la biblioteca."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%@» همین حالا به کتابخانه افزوده می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "« %@ » est déjà en cours d’ajout à la bibliothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” כבר בתהליך הוספה לספרייה."
          }
        },
        "hi" : {
          "stringUnit" : {
