    "ffmpegImport.soundNotDecoded" : {
      "comment" : "Why a file was not imported: its sound is in a codec TextMouth does not decode. %@ is the file's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يستطيع TextMouth تحويل صوت “%@”: فهو بنوع صوتي لا يقرؤه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth “%@”-এর সাউন্ড রূপান্তর করতে পারে না: এটি এমন ধরনের অডিও, যা TextMouth পড়ে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kann den Ton von „%@“ nicht umwandeln: Er liegt in einem Audioformat vor, das TextMouth nicht liest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TextMouth can't convert the sound of “%@”: it is in a kind of audio it does not read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth no puede convertir el sonido de “%@”: está en un tipo de audio que no lee."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth نمی‌تواند صدای «%@» را تبدیل کند: صدا از نوعی است که آن را نمی‌خواند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth ne peut pas convertir le son de « %@ » : il ne sait pas lire ce type d’audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth לא יכול להמיר את השמע של “%@”: זהו סוג שמע ש-TextMouth אינו קורא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth “%@” की ध्वनि नहीं बदल सकता: वह ऐसे ऑडियो प्रकार में है जिसे वह नहीं पढ़ता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth tidak dapat mengonversi suara “%@”: suaranya berjenis audio yang tidak dapat dibaca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth non può convertire l’audio di “%@”: è in un tipo di audio che non legge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth は「%@」の音声を変換できません。対応していない種類のオーディオです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth가 “%@”의 사운드를 변환할 수 없습니다. 지원하지 않는 종류의 오디오입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kan het geluid van “%@” niet converteren: het is een soort audio dat TextMouth niet leest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth nie może przekonwertować dźwięku „%@”: to rodzaj dźwięku, którego nie odczytuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O TextMouth não consegue converter o som de “%@”: ele está em um tipo de áudio que o app não lê."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не может преобразовать звук «%@»: он в формате, который TextMouth не читает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth kan inte konvertera ljudet i ”%@”: det är av en typ som TextMouth inte läser."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth แปลงเสียงของ “%@” ไม่ได้: เป็นเสียงชนิดที่ TextMouth ไม่อ่าน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth “%@” dosyasının sesini dönüştüremiyor: okumadığı bir ses türünde."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth не може перетворити звук файлу «%@»: це вид аудіо, який він не читає."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth “%@” کی آواز تبدیل نہیں کر سکتا: یہ ایسے آڈیو میں ہے جسے وہ نہیں پڑھتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth không chuyển đổi được âm thanh của “%@”: nó thuộc loại âm thanh mà TextMouth không đọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 无法转换“%@”的声音：它属于 TextMouth 无法读取的一种音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth 無法轉換「%@」的聲音：它屬於 TextMouth 無法讀取的音訊類型。"
          }
        }
      }
    },
