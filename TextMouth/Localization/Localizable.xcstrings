        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TextMouth stoppade %1$@ eftersom %2$@, och försöker inte igen förrän TextMouth har stängts och öppnats på nytt."
          }
        },
        "th" : {
          "stringUnit" : {
