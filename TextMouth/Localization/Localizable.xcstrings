    },
    "The language of the braille code the book is written in." : {
      "comment" : "The hint of the language pop-up in the Export dialog's braille options.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Sprache des Braille-Codes, in dem das Buch geschrieben ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El idioma del código braille en el que está escrito el libro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La langue du code braille dans lequel le livre est écrit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La lingua del codice braille in cui è scritto il libro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
