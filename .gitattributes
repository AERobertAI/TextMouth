# Issue files merge by their parts: the header field by field, the description as git
# would, and each comment whole (`issuelib.py merge-driver`, which `make
# issues-merge-driver` defines once in the repository's config). Where it is not
# defined, git merges them as text, with conflict markers (Issues/README.md).
/Issues/*.md merge=issuefile
# The folder's README is plain text, merged as git merges any.
/Issues/README.md merge

# String Catalogs merge by key, language, and plural form (`l10n.py merge-driver`, which `make
# l10n-merge-driver` defines once in the repository's config). Where it is not defined, git merges them
# as text, and two branches that add neighbouring strings conflict.
*.xcstrings merge=xcstrings

# The converted files' globs, one per line (`Scripts/l10n/sync-paths.txt`), merge by union: two branches that each add
# lines keep both sides' lines, with no conflict and no `git config` (git's built-in driver).
/Scripts/l10n/sync-paths.txt merge=union
