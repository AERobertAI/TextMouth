<!-- The iOS app's Info.plist, merged by GENERATE_INFOPLIST_FILE with the keys
     Xcode writes from the INFOPLIST_KEY_ settings in project.yml. Only keys
     with no such setting belong here: Xcode ignores an INFOPLIST_KEY_ setting
     it does not know, and which side wins on a key in both is not documented.
     It is outside TextMouth/, so that the target does not copy it in as a
     resource. IOSInfoPlistTests holds it to these rules, since neither
     make typecheck-ios nor any other check tonight can read a plist. -->
<dict>
	<!-- The book goes on with the screen locked: without this key iOS suspends the
	     app when it leaves the foreground, and speech and audio stop. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- One scene at a time, also on an iPad: one PhoneSession cannot serve two
	     windows. No configurations: the app delegate names the scene's classes
	     in code. Xcode's generated manifest, which this replaces, allows several
	     scenes (the engineering review's F27). -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
