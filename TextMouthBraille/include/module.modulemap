// The Clang module the app imports the braille helper's line protocol by:
// `private import TextMouthBrailleProtocol`, in BrailleEmphasis.swift, the
// only Swift file that does. Its one header is the protocol's single
// definition, which the helper's translation (TextMouthBrailleLibrary.c)
// includes too (see that header).
module TextMouthBrailleProtocol {
    header "TextMouthBrailleProtocol.h"
    export *
}

// The braille translation's interface (DR34), which only the iPhone's code
// imports (BrailleTranslator, under #if os(iOS)): the iPhone app links the
// library (TextMouthBrailleLibrary_iOS and liblouis_iOS in project.yml) and
// calls it in its own process, while the Mac app links neither, since its
// helper program runs the same code.
module TextMouthBrailleLibrary {
    header "TextMouthBrailleLibrary.h"
    export *
}
