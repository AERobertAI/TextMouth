{
  "notes": [
    "A term marked ordinary is a command or an adjective that is also an everyday word (Close, Open, Done, Play, Next, Add, Delete, ...). It is found only as a whole label (Close, Open...) or in a title-case phrase (Close Window, Open %@ in TextMouth), which is how a menu item or a button is written, so a sentence such as close to the end is not a use of Close. Nouns (Library, Bookmark, Chapter) are found anywhere, in any case.",
    "A term is never found inside a do-not-translate name: Windows-1252 is the name Windows, not the term Window."
  ],
  "doNotTranslate": [
    "TextMouth", "VoiceOver", "EPUB", "DAISY", "MP3", "M4B", "M4A", "AAC", "Opus", "Ogg", "WavPack", "iCloud", "Mac", "macOS",
    "iPhone", "AirPods", "Bluetooth", "Apple", "Finder", "Kindle", "MOBI", "OPML", "JSON", "XML", "HTML", "PDF", "DOCX", "ZIP",
    "CBZ", "Markdown", "SSML", "WebVTT", "CUE", "OPF", "DTBook", "BRF", "PEF", "liblouis", "ASCII", "Unicode", "UTF-8", "PNG",
    "JPEG", "Windows"
  ],
  "terms": [
    {"term": "Library", "translations": {"es": {"text": "Biblioteca", "match": ["bibliotec"]}}},
    {"term": "Reading List", "translations": {"es": {"text": "Lista de lectura"}}},
    {"term": "Bookmark", "translations": {"es": {"text": "Marcador"}}},
    {"term": "Sleep Timer", "note": "Stops the speech after a time or at the end of a heading or book", "translations": {"es": {"text": "Temporizador de apagado", "check": true, "note": "Apple's Spanish for this is not certain: apagado, reposo, and suspensión are all used"}}},
    {"term": "Timer", "translations": {"es": {"text": "Temporizador"}}},
    {"term": "Feed", "note": "A podcast or news feed the app subscribes to", "translations": {"es": {"text": "Canal", "check": true, "note": "Apple Podcasts says programa for a show; Canal names the feed itself"}}},
    {"term": "Podcast", "translations": {"es": {"text": "Podcast", "check": true, "note": "Apple writes Podcasts; the RAE prefers pódcast"}}},
    {"term": "Episode", "translations": {"es": {"text": "Episodio"}}},
    {"term": "Heading", "note": "A heading in a book; VoiceOver says encabezado", "translations": {"es": {"text": "Encabezado"}}},
    {"term": "Chapter", "translations": {"es": {"text": "Capítulo"}}},
    {"term": "Voice", "note": "A speech voice", "translations": {"es": {"text": "Voz", "match": ["voz", "voces"]}}},
    {"term": "Speed", "translations": {"es": {"text": "Velocidad"}}},
    {"term": "Pitch", "translations": {"es": {"text": "Tono"}}},
    {"term": "Volume", "translations": {"es": {"text": "Volumen"}}},
    {"term": "Import", "ordinary": true, "translations": {"es": {"text": "Importar", "match": ["import"]}}},
    {"term": "Export", "ordinary": true, "translations": {"es": {"text": "Exportar", "match": ["export"]}}},
    {"term": "Book", "translations": {"es": {"text": "Libro"}}},
    {"term": "Audiobook", "translations": {"es": {"text": "Audiolibro"}}},
    {"term": "Folder", "translations": {"es": {"text": "Carpeta"}}},
    {"term": "File", "translations": {"es": {"text": "Archivo"}}},
    {"term": "Transcript", "translations": {"es": {"text": "Transcripción", "match": ["transcripci"]}}},
    {"term": "Transcribe", "translations": {"es": {"text": "Transcribir", "match": ["transcrib", "transcripci"]}}},
    {"term": "Download", "ordinary": true, "translations": {"es": {"text": "Descargar", "match": ["descarg"]}}},
    {"term": "Delete", "ordinary": true, "note": "Erases for good; Remove only takes something off a list", "translations": {"es": {"text": "Eliminar", "match": ["elimin", "borr"]}}},
    {"term": "Remove", "ordinary": true, "note": "Takes something off a list without erasing it", "translations": {"es": {"text": "Quitar", "check": true, "match": ["quit"]}}},
    {"term": "Cancel", "ordinary": true, "translations": {"es": {"text": "Cancelar", "match": ["cancel"]}}},
    {"term": "Close", "ordinary": true, "translations": {"es": {"text": "Cerrar", "match": ["cerr", "cierr"]}}},
    {"term": "Save", "ordinary": true, "translations": {"es": {"text": "Guardar", "match": ["guard"]}}},
    {"term": "Done", "ordinary": true, "note": "The button that finishes a sheet", "translations": {"es": {"text": "OK", "check": true, "note": "Apple's Spanish shows OK on the iPhone and in Mac sheets (Latin American iOS also says Listo); Hecho is a word-for-word copy"}}},
    {"term": "this Mac", "note": "This computer, as a Mac names itself", "translations": {"es": {"text": "esta Mac", "check": true, "match": ["esta mac", "este mac"], "note": "Gender rule: Apple's Spanish says este Mac in Spain and esta Mac in Latin America (Acerca de esta Mac). The Spanish here is Latin American (tú, Agregar), so every wave writes esta Mac; a native speaker decides, and the other Spanish may later get este Mac"}}},
    {"term": "Edit", "ordinary": true, "translations": {"es": {"text": "Editar", "match": ["edit"]}}},
    {"term": "Add", "ordinary": true, "translations": {"es": {"text": "Agregar", "check": true, "match": ["agreg", "añad", "anad"], "note": "Spain's Apple interface says Añadir; Agregar is understood everywhere"}}},
    {"term": "Open", "ordinary": true, "translations": {"es": {"text": "Abrir", "match": ["abr"]}}},
    {"term": "Search", "ordinary": true, "translations": {"es": {"text": "Buscar", "match": ["busc", "búsqueda"]}}},
    {"term": "Settings", "translations": {"es": {"text": "Ajustes", "check": true, "note": "macOS in Spain says Ajustes del Sistema, and the review believes macOS in Latin America says Configuración del Sistema (about 75 percent sure); neither is confirmed, so Ajustes stays until a native speaker decides"}}},
    {"term": "Play", "ordinary": true, "translations": {"es": {"text": "Reproducir", "match": ["reproduc"]}}},
    {"term": "Pause", "ordinary": true, "translations": {"es": {"text": "Pausar", "match": ["paus"]}}},
    {"term": "Stop", "ordinary": true, "translations": {"es": {"text": "Detener", "match": ["deten", "detien"]}}},
    {"term": "Resume", "ordinary": true, "translations": {"es": {"text": "Reanudar", "match": ["reanud"]}}},
    {"term": "Skip Forward", "translations": {"es": {"text": "Avanzar", "match": ["avanz", "adelant"]}}},
    {"term": "Skip Backward", "translations": {"es": {"text": "Retroceder", "match": ["retroced", "retroces", "atrás", "atras"]}}},
    {"term": "Next", "ordinary": true, "translations": {"es": {"text": "Siguiente", "match": ["siguiente"]}}},
    {"term": "Previous", "ordinary": true, "translations": {"es": {"text": "Anterior"}}},
    {"term": "Playback", "translations": {"es": {"text": "Reproducción", "match": ["reproducci"]}}},
    {"term": "Recording", "translations": {"es": {"text": "Grabación", "match": ["grabaci", "grabad"]}}},
    {"term": "Record", "ordinary": true, "translations": {"es": {"text": "Grabar", "match": ["grab"]}}},
    {"term": "Language", "translations": {"es": {"text": "Idioma"}}},
    {"term": "Title", "translations": {"es": {"text": "Título"}}},
    {"term": "Author", "translations": {"es": {"text": "Autor", "match": ["autor", "autora"]}}},
    {"term": "Duration", "translations": {"es": {"text": "Duración", "match": ["duraci"]}}},
    {"term": "Format", "translations": {"es": {"text": "Formato"}}},
    {"term": "Name", "translations": {"es": {"text": "Nombre"}}},
    {"term": "Page", "translations": {"es": {"text": "Página", "match": ["pagina"]}}},
    {"term": "Index", "note": "The search index the app builds for a library or a book, not a table of contents",
     "translations": {"es": {"text": "Índice de búsqueda", "check": true, "match": ["indice de busqueda", "indices de busqueda"],
       "note": "Table of Contents is Índice, so this one says what it is for; a native speaker may prefer another word"}}},
    {"term": "Table of Contents", "translations": {"es": {"text": "Índice"}}},
    {"term": "Window", "translations": {"es": {"text": "Ventana"}}},
    {"term": "Menu", "translations": {"es": {"text": "Menú"}}},
    {"term": "Reader", "note": "The window or view in which a book is read", "translations": {"es": {"text": "Lector"}}},
    {"term": "Reading", "translations": {"es": {"text": "Lectura", "match": ["lectura", "leyendo", "leer"]}}},
    {"term": "Copy", "ordinary": true, "translations": {"es": {"text": "Copiar", "match": ["copi"]}}},
    {"term": "Move", "ordinary": true, "translations": {"es": {"text": "Mover", "match": ["mov", "muev"]}}},
    {"term": "Rename", "ordinary": true, "translations": {"es": {"text": "Renombrar", "match": ["renombr", "cambiar el nombre", "cambia el nombre"]}}},
    {"term": "Try Again", "translations": {"es": {"text": "Reintentar", "check": true, "match": ["reintent", "intentar de nuevo", "intenta de nuevo"]}}},
    {"term": "Pronunciation", "translations": {"es": {"text": "Pronunciación", "match": ["pronunciaci"]}}},
    {"term": "Marker", "note": "A mark at a place in audio, not a bookmark", "translations": {"es": {"text": "Marca", "check": true}}},
    {"term": "Cursor", "translations": {"es": {"text": "Cursor"}}},
    {"term": "Braille", "translations": {"es": {"text": "braille", "match": ["braille"]}}},
    {"term": "Default", "ordinary": true, "translations": {"es": {"text": "Predeterminado", "match": ["predeterminad"]}}},
    {"term": "Version", "translations": {"es": {"text": "Versión", "match": ["version"]}}},
    {"term": "Location", "translations": {"es": {"text": "Ubicación", "match": ["ubicaci"]}}},
    {"term": "Keyboard Shortcut", "translations": {"es": {"text": "Atajo de teclado", "check": true, "match": ["atajo"], "note": "macOS may say Funciones rápidas de teclado for shortcuts (the review is about 60 percent sure); unconfirmed, so a native speaker decides"}}},
    {"term": "Accessibility", "translations": {"es": {"text": "Accesibilidad"}}},
    {"term": "Subscribe", "ordinary": true, "translations": {"es": {"text": "Suscribirse", "match": ["suscrib", "suscrip"]}}},
    {"term": "Share", "ordinary": true, "translations": {"es": {"text": "Compartir", "match": ["comparti"]}}}
  ]
}
