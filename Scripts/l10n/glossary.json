    {"term": "Reading List", "translations": {"es": {"text": "Lista de lectura"}}},
    {"term": "Bookmark", "translations": {"es": {"text": "Marcador"}}},
    {"term": "Sleep Timer", "note": "Stops the speech after a time or at the end of a heading or book", "translations": {"es": {"text": "Temporizador de apagado", "check": true, "note": "Apple's Spanish for this is not certain: apagado, reposo, and suspensión are all used"}}},
    {"term": "Timer", "translations": {"es": {"text": "Temporizador"}}},
    {"term": "Feed", "note": "A podcast or news feed the app subscribes to", "translations": {"es": {"text": "Canal", "check": true, "note": "Apple Podcasts says programa for a show; Canal names the feed itself"}}},
