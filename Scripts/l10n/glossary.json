{
  "notes": [
    "A term marked ordinary is a command or an adjective that is also an everyday word (Close, Open, Done, Play, Next, Add, Delete, ...). It is found only as a whole label (Close, Open...) or in a title-case phrase (Close Window, Open %@ in TextMouth), which is how a menu item or a button is written, so a sentence such as close to the end is not a use of Close. Nouns (Library, Bookmark, Chapter) are found anywhere, in any case.",
    "A term is never found inside a do-not-translate name: Windows-1252 is the name Windows, not the term Window."
  ],
  "doNotTranslate": [
    "TextMouth", "VoiceOver", "EPUB", "DAISY", "MP3", "M4B", "M4A", "AAC", "Opus", "Ogg", "WavPack", "iCloud", "Mac", "macOS",
    "iPhone", "AirPods", "Bluetooth", "Apple", "Finder", "Kindle", "MOBI", "OPML", "JSON", "XML", "HTML", "PDF", "DOCX", "ZIP",
    "CBZ", "Markdown", "SSML", "WebVTT", "CUE", "OPF", "DTBook", "BRF", "PEF", "liblouis", "ASCII", "Unicode", "UTF-8", "PNG",
    "JPEG", "Windows"
  ],
  "terms": [
    {"term": "Library", "translations": {"es": {"text": "Biblioteca", "match": ["bibliotec"]}, "it": {"text": "Libreria", "check": true, "match": ["librer"]}}},
    {"term": "Reading List", "translations": {"es": {"text": "Lista de lectura"}, "it": {"text": "Elenco di lettura", "check": true, "match": ["elenco di lettura", "elenco di lettura"]}}},
    {"term": "Bookmark", "translations": {"es": {"text": "Marcador"}, "it": {"text": "Segnalibro", "check": true, "match": ["segnalibr"]}}},
    {"term": "Sleep Timer", "note": "Stops the speech after a time or at the end of a heading or book", "translations": {"es": {"text": "Temporizador de apagado", "check": true, "note": "Apple's Spanish for this is not certain: apagado, reposo, and suspensión are all used"}, "it": {"text": "Timer di spegnimento", "check": true, "match": ["timer di spegnimento", "spegnimento"], "note": "Apple's Italian may say Timer di stop or Timer di sospensione"}}},
    {"term": "Timer", "translations": {"es": {"text": "Temporizador"}, "it": {"text": "Timer", "check": true}}},
    {"term": "Feed", "note": "A podcast or news feed the app subscribes to", "translations": {"es": {"text": "Canal", "check": true, "note": "Apple Podcasts says programa for a show; Canal names the feed itself"}, "it": {"text": "Feed", "check": true}}},
    {"term": "Podcast", "translations": {"es": {"text": "Podcast", "check": true, "note": "Apple writes Podcasts; the RAE prefers pódcast"}, "it": {"text": "Podcast", "check": true}}},
    {"term": "Episode", "translations": {"es": {"text": "Episodio"}, "it": {"text": "Episodio", "check": true, "match": ["episod"]}}},
    {"term": "Heading", "note": "A heading in a book; VoiceOver says encabezado", "translations": {"es": {"text": "Encabezado"}, "it": {"text": "Intestazione", "check": true, "match": ["intestazion"], "note": "VoiceOver says intestazione; Titolo is the Title column"}}},
    {"term": "Chapter", "translations": {"es": {"text": "Capítulo"}, "it": {"text": "Capitolo", "check": true, "match": ["capitol"]}}},
    {"term": "Voice", "note": "A speech voice", "translations": {"es": {"text": "Voz", "match": ["voz", "voces"]}, "it": {"text": "Voce", "check": true, "match": ["voce", "voci"]}}},
    {"term": "Speed", "translations": {"es": {"text": "Velocidad"}, "it": {"text": "Velocità", "check": true, "match": ["velocit"]}}},
    {"term": "Pitch", "translations": {"es": {"text": "Tono"}, "it": {"text": "Tono", "check": true, "match": ["tono", "toni"]}}},
    {"term": "Volume", "translations": {"es": {"text": "Volumen"}, "it": {"text": "Volume", "check": true}}},
    {"term": "Import", "ordinary": true, "translations": {"es": {"text": "Importar", "match": ["import"]}, "it": {"text": "Importa", "check": true, "match": ["import"]}}},
    {"term": "Export", "ordinary": true, "translations": {"es": {"text": "Exportar", "match": ["export"]}, "it": {"text": "Esporta", "check": true, "match": ["esport"]}}},
    {"term": "Book", "note": "The book itself; as the Book menu or the Book title of a column it is the same word. A comic book archive is an archivo de cómic", "translations": {"es": {"text": "Libro", "match": ["libro", "comic"]}, "it": {"text": "Libro", "check": true, "match": ["libro", "libri", "fumett"]}}},
    {"term": "Audiobook", "translations": {"es": {"text": "Audiolibro"}, "it": {"text": "Audiolibro", "check": true, "match": ["audiolibr"]}}},
    {"term": "Folder", "translations": {"es": {"text": "Carpeta"}, "it": {"text": "Cartella", "check": true, "match": ["cartell"]}}},
    {"term": "File", "translations": {"es": {"text": "Archivo"}, "it": {"text": "File", "check": true}}},
    {"term": "Transcript", "translations": {"es": {"text": "Transcripción", "match": ["transcripci"]}, "it": {"text": "Trascrizione", "check": true, "match": ["trascrizion"]}}},
    {"term": "Transcribe", "translations": {"es": {"text": "Transcribir", "match": ["transcrib", "transcripci"]}, "it": {"text": "Trascrivi", "check": true, "match": ["trascriv", "trascrizion"]}}},
    {"term": "Download", "ordinary": true, "translations": {"es": {"text": "Descargar", "match": ["descarg"]}, "it": {"text": "Scarica", "check": true, "match": ["scaric"]}}},
    {"term": "Delete", "ordinary": true, "note": "Erases for good; Remove only takes something off a list", "translations": {"es": {"text": "Eliminar", "match": ["elimin", "borr"]}, "it": {"text": "Elimina", "check": true, "match": ["elimin", "cancell"]}}},
    {"term": "Remove", "ordinary": true, "note": "Takes something off a list without erasing it", "translations": {"es": {"text": "Quitar", "check": true, "match": ["quit", "elimin"]}, "it": {"text": "Rimuovi", "check": true, "match": ["rimuov", "rimoss", "rimozion", "elimin"]}}},
    {"term": "Cancel", "ordinary": true, "translations": {"es": {"text": "Cancelar", "match": ["cancel"]}, "it": {"text": "Annulla", "check": true, "match": ["annull"]}}},
    {"term": "Close", "ordinary": true, "translations": {"es": {"text": "Cerrar", "match": ["cerr", "cierr"]}, "it": {"text": "Chiudi", "check": true, "match": ["chiud", "chius"]}}},
    {"term": "Save", "ordinary": true, "translations": {"es": {"text": "Guardar", "match": ["guard"]}, "it": {"text": "Salva", "check": true, "match": ["salv"]}}},
    {"term": "Done", "ordinary": true, "note": "The button that finishes a sheet", "translations": {"es": {"text": "OK", "check": true, "match": ["ok", "listo"], "note": "Apple's Spanish shows OK on the iPhone and in Mac sheets (Latin American iOS also says Listo); Hecho is a word-for-word copy"}, "it": {"text": "Fine", "check": true, "match": ["fine", "ok"], "note": "Apple's Italian says Fine"}}},
    {"term": "this Mac", "note": "This computer, as a Mac names itself", "translations": {"es": {"text": "esta Mac", "check": true, "match": ["esta mac", "este mac"], "note": "Gender rule: Apple's Spanish says este Mac in Spain and esta Mac in Latin America (Acerca de esta Mac). The Spanish here is Latin American (tú, Agregar), so every wave writes esta Mac; a native speaker decides, and the other Spanish may later get este Mac"}, "it": {"text": "questo Mac", "check": true, "match": ["questo mac", "questo computer"]}}},
    {"term": "Edit", "ordinary": true, "translations": {"es": {"text": "Editar", "match": ["edit", "edic"]}, "it": {"text": "Modifica", "check": true, "match": ["modific"]}}},
    {"term": "Add", "ordinary": true, "translations": {"es": {"text": "Agregar", "check": true, "match": ["agreg", "añad", "anad"], "note": "Spain's Apple interface says Añadir; Agregar is understood everywhere"}, "it": {"text": "Aggiungi", "check": true, "match": ["aggiung", "aggiunt"]}}},
    {"term": "Open", "ordinary": true, "translations": {"es": {"text": "Abrir", "match": ["abr"]}, "it": {"text": "Apri", "check": true, "match": ["apri", "apre", "aprir"]}}},
    {"term": "Search", "ordinary": true, "translations": {"es": {"text": "Buscar", "match": ["busc", "búsqueda"]}, "it": {"text": "Cerca", "check": true, "match": ["cerc", "ricerc"]}}},
    {"term": "Settings", "translations": {"es": {"text": "Ajustes", "check": true, "note": "macOS in Spain says Ajustes del Sistema, and the review believes macOS in Latin America says Configuración del Sistema (about 75 percent sure); neither is confirmed, so Ajustes stays until a native speaker decides"}, "it": {"text": "Impostazioni", "check": true, "match": ["impostazion"]}}},
    {"term": "Play", "ordinary": true, "translations": {"es": {"text": "Reproducir", "match": ["reproduc"]}, "it": {"text": "Riproduci", "check": true, "match": ["riprodu"]}}},
    {"term": "Pause", "ordinary": true, "translations": {"es": {"text": "Pausar", "match": ["paus"], "note": "The key named Pause shares the key Pause, so a keyboard shortcut reads Pausar; splitting the key would let it say Pausa"}, "it": {"text": "Metti in pausa", "check": true, "match": ["pausa"], "note": "Apple's Italian says Pausa on the button and Metti in pausa in a menu"}}},
    {"term": "Stop", "ordinary": true, "translations": {"es": {"text": "Detener", "match": ["deten", "detien", "dejar de"]}, "it": {"text": "Interrompi", "check": true, "match": ["interromp", "interrott", "ferma"], "note": "Alternatives: Ferma, Stop"}}},
    {"term": "Resume", "ordinary": true, "translations": {"es": {"text": "Reanudar", "match": ["reanud"]}, "it": {"text": "Riprendi", "check": true, "match": ["riprend", "ripres"]}}},
    {"term": "Skip Forward", "translations": {"es": {"text": "Avanzar", "match": ["avanz", "adelant"]}, "it": {"text": "Salta avanti", "check": true, "match": ["avanti", "avanz"]}}},
    {"term": "Skip Backward", "translations": {"es": {"text": "Retroceder", "match": ["retroced", "retroces", "atrás", "atras"]}, "it": {"text": "Salta indietro", "check": true, "match": ["indietro"]}}},
    {"term": "Next", "ordinary": true, "translations": {"es": {"text": "Siguiente", "match": ["siguiente"]}, "it": {"text": "Successivo", "check": true, "match": ["successiv"]}}},
    {"term": "Previous", "ordinary": true, "translations": {"es": {"text": "Anterior"}, "it": {"text": "Precedente", "check": true, "match": ["precedent"]}}},
    {"term": "Playback", "translations": {"es": {"text": "Reproducción", "match": ["reproducci"]}, "it": {"text": "Riproduzione", "check": true, "match": ["riproduzion"]}}},
    {"term": "Recording", "translations": {"es": {"text": "Grabación", "match": ["grabaci", "grabad", "grabando", "graba"]}, "it": {"text": "Registrazione", "check": true, "match": ["registrazion", "registrat"]}}},
    {"term": "Record", "ordinary": true, "translations": {"es": {"text": "Grabar", "match": ["grab"]}, "it": {"text": "Registra", "check": true, "match": ["registr"]}}},
    {"term": "Language", "translations": {"es": {"text": "Idioma"}, "it": {"text": "Lingua", "check": true, "match": ["lingua", "lingue"]}}},
    {"term": "Title", "translations": {"es": {"text": "Título"}, "it": {"text": "Titolo", "check": true, "match": ["titol"]}}},
    {"term": "Author", "translations": {"es": {"text": "Autor", "match": ["autor", "autora"]}, "it": {"text": "Autore", "check": true, "match": ["autor"]}}},
    {"term": "Duration", "translations": {"es": {"text": "Duración", "match": ["duraci"]}, "it": {"text": "Durata", "check": true, "match": ["durat"]}}},
    {"term": "Format", "translations": {"es": {"text": "Formato", "match": ["formato", "format"]}, "it": {"text": "Formato", "check": true, "match": ["format"]}}},
    {"term": "Name", "ordinary": true, "note": "Ordinary: a text that says a page or a file names something (a verb) is not a use of the label Name", "translations": {"es": {"text": "Nombre"}, "it": {"text": "Nome", "check": true, "match": ["nome", "nomi"]}}},
    {"term": "Page", "translations": {"es": {"text": "Página", "match": ["pagina", "pages"]}, "it": {"text": "Pagina", "check": true, "match": ["pagin"]}}},
    {"term": "Index", "note": "The search index the app builds for a library or a book, not a table of contents. The library index (library.json, the file that lists the books) is the índice de la biblioteca, and a book's reading index its índice de lectura; every Spanish index is some índice", "translations": {"es": {"text": "Índice de búsqueda", "check": true, "match": ["indice"], "note": "Table of Contents is Índice, so this one says what it is for; a native speaker may prefer another word"}, "it": {"text": "Indice di ricerca", "check": true, "match": ["indice di ricerca", "indici di ricerca", "indicizz"], "note": "The search index; Indice alone is the table of contents"}}},
    {"term": "Table of Contents", "translations": {"es": {"text": "Índice"}, "it": {"text": "Indice", "check": true, "match": ["indice"]}}},
    {"term": "Window", "translations": {"es": {"text": "Ventana"}, "it": {"text": "Finestra", "check": true, "match": ["finestr"]}}},
    {"term": "Menu", "translations": {"es": {"text": "Menú"}, "it": {"text": "Menu", "check": true}}},
    {"term": "Reader", "note": "The window or view in which a book is read", "translations": {"es": {"text": "Lector"}, "it": {"text": "Lettore", "check": true, "match": ["lettore"]}}},
    {"term": "Reading", "translations": {"es": {"text": "Lectura", "match": ["lectura", "leyendo", "leer"]}, "it": {"text": "Lettura", "check": true, "match": ["lettura", "leggere", "leggend", "legge"]}}},
    {"term": "Copy", "ordinary": true, "translations": {"es": {"text": "Copiar", "match": ["copi"]}, "it": {"text": "Copia", "check": true, "match": ["copi"]}}},
    {"term": "Move", "ordinary": true, "translations": {"es": {"text": "Mover", "match": ["mov", "muev"]}, "it": {"text": "Sposta", "check": true, "match": ["spost"]}}},
    {"term": "Rename", "ordinary": true, "translations": {"es": {"text": "Renombrar", "match": ["renombr", "cambiar el nombre", "cambia el nombre"]}, "it": {"text": "Rinomina", "check": true, "match": ["rinomin"]}}},
    {"term": "Try Again", "ordinary": true, "note": "Retry is the same control with another English name: Reintentar for both. A sentence that says to try again later is not a use of the label", "translations": {"es": {"text": "Reintentar", "check": true, "match": ["reintent", "intentar de nuevo", "intenta de nuevo", "inténtalo", "vuelve a intentar"]}, "it": {"text": "Riprova", "check": true, "match": ["riprov"]}}},
    {"term": "Pronunciation", "translations": {"es": {"text": "Pronunciación", "match": ["pronunciaci"]}, "it": {"text": "Pronuncia", "check": true, "match": ["pronunc"]}}},
    {"term": "Marker", "note": "A mark at a place in audio, not a bookmark", "translations": {"es": {"text": "Marca", "check": true}, "it": {"text": "Marcatore", "check": true, "match": ["marcator", "indicator"], "note": "Logic uses Marcatore; Indicatore is the alternative"}}},
    {"term": "Cursor", "translations": {"es": {"text": "Cursor"}, "it": {"text": "Cursore", "check": true, "match": ["cursor"]}}},
    {"term": "Braille", "translations": {"es": {"text": "braille", "match": ["braille"]}, "it": {"text": "braille", "check": true}}},
    {"term": "Default", "ordinary": true, "translations": {"es": {"text": "Predeterminado", "match": ["predeterminad"]}, "it": {"text": "Predefinito", "check": true, "match": ["predefinit"]}}},
    {"term": "Version", "translations": {"es": {"text": "Versión", "match": ["version"]}, "it": {"text": "Versione", "check": true, "match": ["version"]}}},
    {"term": "Location", "translations": {"es": {"text": "Ubicación", "match": ["ubicaci"]}, "it": {"text": "Posizione", "check": true, "match": ["posizion"]}}},
    {"term": "Keyboard Shortcut", "translations": {"es": {"text": "Atajo de teclado", "check": true, "match": ["atajo"], "note": "macOS may say Funciones rápidas de teclado for shortcuts (the review is about 60 percent sure); unconfirmed, so a native speaker decides"}, "it": {"text": "Scorciatoia da tastiera", "check": true, "match": ["scorciatoi"]}}},
    {"term": "Accessibility", "translations": {"es": {"text": "Accesibilidad"}, "it": {"text": "Accessibilità", "check": true, "match": ["accessibilit"]}}},
    {"term": "Subscribe", "ordinary": true, "translations": {"es": {"text": "Suscribirse", "match": ["suscrib", "suscrip"]}, "it": {"text": "Iscriviti", "check": true, "match": ["iscriv", "iscrizion", "iscritt"], "note": "Apple Podcasts says Segui; Iscriviti names the feed subscription"}}},
    {"term": "Share", "ordinary": true, "translations": {"es": {"text": "Compartir", "match": ["comparti"]}, "it": {"text": "Condividi", "check": true, "match": ["condivid", "condivis"]}}},
    {"term": "Punch In", "ordinary": true, "note": "Records new audio over the audio editor selection. The pro audio word is not used: one name for the control", "translations": {"es": {"text": "Grabar encima", "match": ["grabar encima", "grabando sobre"]}, "it": {"text": "Registra sopra", "check": true, "match": ["registra sopra", "registrare sopra", "sovrascri"], "note": "Records new audio over the selection"}}},
    {"term": "Clear Selection", "note": "The audio editor shortcut action that removes the selection (a selection is never erased: Borrar would say it is)", "translations": {"es": {"text": "Quitar selección", "match": ["quitar seleccion"]}, "it": {"text": "Deseleziona", "check": true, "match": ["deselezion", "annulla la selezione", "annulla selezione"], "note": "Not Cancella: a selection is never erased"}}},
    {"term": "Speak", "ordinary": true, "note": "The Speak commands (Speak Selection, Speak Info) read aloud; Apple's iOS says Leer selección. Say (the Where Am I settings) stays Decir", "translations": {"es": {"text": "Leer", "check": true, "match": ["leer", "lee"]}, "it": {"text": "Leggi", "check": true, "match": ["legg"], "note": "Apple's iOS says Pronuncia selezione; Leggi avoids the clash with Pronuncia (Pronunciation)"}}},
    {"term": "Return", "ordinary": true, "note": "The key. Apple's Latin American keyboards say Retorno; Spain says Intro, which here is the keypad Enter key", "translations": {"es": {"text": "Retorno", "check": true, "match": ["retorno"]}, "it": {"text": "Invio", "check": true, "match": ["invio"]}}},
    {"term": "Enter", "ordinary": true, "note": "The keypad Enter key (the key Return is Retorno)", "translations": {"es": {"text": "Intro", "check": true, "match": ["intro"]}, "it": {"text": "Enter", "check": true, "match": ["enter"], "note": "The keypad key"}}},
    {"term": "Decibel", "note": "Latin American Apple often writes decibeles; the RAE's decibelio fits both and the one form the tools need", "translations": {"es": {"text": "decibelio", "check": true, "match": ["decibel"]}, "it": {"text": "decibel", "check": true}}},
    {"term": "System Settings", "note": "macOS's own app in Spain; the review believes Latin American macOS says Configuración del Sistema (about 75 percent sure). Every sentence uses one wording", "translations": {"es": {"text": "Ajustes del Sistema", "check": true, "match": ["ajustes del sistema"]}, "it": {"text": "Impostazioni di Sistema", "check": true, "match": ["impostazioni di sistema"]}}},
    {"term": "Where Am I", "note": "The command that says the reading position; every sentence that names it must write it this way", "translations": {"es": {"text": "¿Dónde estoy?", "match": ["donde estoy"]}, "it": {"text": "Dove sono?", "check": true, "match": ["dove sono"]}}},
    {"term": "Replace Existing", "note": "The duplicate question's button that replaces the copy in the library", "translations": {"es": {"text": "Reemplazar el existente", "match": ["reemplazar el existente"]}, "it": {"text": "Sostituisci l’esistente", "check": true, "match": ["sostituisci l", "sostituire l"]}}},
    {"term": "Move to Library", "note": "Turns a feed item into a book of the library", "translations": {"es": {"text": "Mover a la biblioteca", "match": ["mover a la biblioteca"]}, "it": {"text": "Sposta nella libreria", "check": true, "match": ["sposta nella libreria", "spostare nella libreria"]}}},
    {"term": "Add to Reading List", "note": "Names the command everywhere, menu and sentences", "translations": {"es": {"text": "Agregar a la lista de lectura", "match": ["agregar a la lista de lectura"]}, "it": {"text": "Aggiungi all’elenco di lettura", "check": true, "match": ["elenco di lettura"]}}},
    {"term": "Add to Library", "note": "Names the command everywhere, menu and sentences", "translations": {"es": {"text": "Agregar a la biblioteca", "match": ["agregar a la biblioteca"]}, "it": {"text": "Aggiungi alla libreria", "check": true, "match": ["alla libreria"]}}},
    {"term": "Put Back", "ordinary": true, "note": "The Finder's command that takes an item out of the Trash back to where it was; Spain's Finder says it so, and Latin America's is unconfirmed", "translations": {"es": {"text": "Volver a colocar", "check": true, "match": ["volver a colocar"]}, "it": {"text": "Rimetti a posto", "check": true, "match": ["rimetti", "rimettere", "rimess"], "note": "Apple's Finder"}}},
    {"term": "Trash", "note": "The Finder's Trash", "translations": {"es": {"text": "Papelera", "match": ["papelera"]}, "it": {"text": "Cestino", "check": true, "match": ["cestin"]}}},
    {"term": "Sheet", "ordinary": true, "note": "A sheet that slides over a window; VoiceOver says hoja", "translations": {"es": {"text": "hoja", "match": ["hoja"]}, "it": {"text": "foglio", "check": true, "match": ["foglio", "fogli"], "note": "VoiceOver Italian: foglio (not sure)"}}},
    {"term": "Unsubscribe", "ordinary": true, "note": "Resubscribe is Volver a suscribirse; the state is Sin suscripción", "translations": {"es": {"text": "Cancelar suscripción", "match": ["cancelar la suscripcion", "cancelar suscripcion", "cancelaste la suscripcion", "sin suscripcion", "suscripcion cancelada"]}, "it": {"text": "Annulla l’iscrizione", "check": true, "match": ["annulla l", "annullare l", "annullato l", "disiscri"], "note": "Alternatives: Disiscriviti, Non seguire più"}}},
    {"term": "Refresh", "ordinary": true, "note": "Checks the feeds for new items", "translations": {"es": {"text": "Actualizar", "match": ["actualiz"]}, "it": {"text": "Aggiorna", "check": true, "match": ["aggiorn"]}}},
    {"term": "Redo Text Extraction", "note": "Reads every book's text again", "translations": {"es": {"text": "Repetir extracción de texto", "match": ["repetir extraccion", "repetir la extraccion"]}, "it": {"text": "Ripeti l’estrazione del testo", "check": true, "match": ["estrazione del testo", "estrarre il testo"]}}}
  ]
}
