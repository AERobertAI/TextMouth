  "strings": {
    "%lld minutes": {
      "comment": "A plural string in English, and in French (which has no plural string at all, so no .stringsdict file) a plain text equal to the key: Foundation answers a key that French's .strings lacks from English's plurals, so the entry must stay.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {"stringUnit": {"state": "translated", "value": "%lld minute"}},
              "other": {"stringUnit": {"state": "translated", "value": "%lld minutes"}}
            }
          }
        },
        "fr": {"stringUnit": {"state": "translated", "value": "%lld minutes"}}
      }
    },
    "Open": {
      "comment": "Equal to its key in French and held by no English table: the entry can go.",
      "localizations": {
        "fr": {"stringUnit": {"state": "translated", "value": "Open"}}
      }
    },
    "Close": {
      "comment": "A text that differs from its key, so that French's table is not empty.",
      "localizations": {
        "fr": {"stringUnit": {"state": "translated", "value": "Fermer"}}
      }
    }
  },
  "version": "1.0"
