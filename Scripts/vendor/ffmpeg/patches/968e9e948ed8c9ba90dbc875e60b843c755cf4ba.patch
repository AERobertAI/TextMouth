From 968e9e948ed8c9ba90dbc875e60b843c755cf4ba Mon Sep 17 00:00:00 2001
From: Michael Niedermayer <michael@niedermayer.cc>
Date: Tue, 3 Nov 2026 02:15:31 +0100
Subject: [PATCH] avcodec/apedec: reject legacy frames with more than 73728
 samples

Excessive memory allocation (peak RSS 2.58 GB from a 52 byte file)
Replicated through UnModified FFmpeg with ASAN

Fixes: out of memory
Fixes: 2cNjGsVIMOVX
Fixes: AISLE-2026-0150-00053

Found-by: Joshua Rogers (AISLE)
Signed-off-by: Michael Niedermayer <michael@niedermayer.cc>
---
 libavcodec/apedec.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/libavcodec/apedec.c b/libavcodec/apedec.c
index 9a184f98072be..466c3c2001c14 100644
--- a/libavcodec/apedec.c
+++ b/libavcodec/apedec.c
@@ -1598,7 +1598,8 @@ static int ape_decode_frame(AVCodecContext *avctx, AVFrame *frame,
                 skip_bits_long(&s->gb, offset);
         }
 
-        if (!nblocks || nblocks > INT_MAX / 2 / sizeof(*s->decoded_buffer) - 8) {
+        if (!nblocks || nblocks > INT_MAX / 2 / sizeof(*s->decoded_buffer) - 8 ||
+            (s->fileversion < 3930 && nblocks > 73728)) {
             av_log(avctx, AV_LOG_ERROR, "Invalid sample count: %"PRIu32".\n",
                    nblocks);
             return AVERROR_INVALIDDATA;
