  <level1 id="ch1">
   <pagenum id="p1" page="normal">1</pagenum>
   <h1>The Seawall</h1>
   <p>At low tide the harbour wall<pagenum id="p2" page="normal">2</pagenum>stood dry above the slipway.</p>
   <p>Nets hang over the rail to dry before the tide turns.</p>
   <pagenum id="p4" page="normal"/>
   <p>The last boat is in by dusk.</p>
  </level1>
  <level1 id="ch2">
   <h1>The Lamp Room</h1>
   <p>A single lamp burns above the door all night.</p>
   <pagenum id="p5" page="normal">5</pagenum>
  </level1>
